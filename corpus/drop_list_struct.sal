struct F
    name: String
    k: Int
    w: Float

fn total(n: Int) -> Int ! alloc
    xs = list_new[F]()
    i = 0
    while i < n
        _a = list_push(&mut xs, F(int_to_str(i), i, 1.5))
        i = i + 1
    fk = list_get(&xs, 2).k
    gk = list_get(&xs, 2).k
    _b = list_set(&mut xs, 0, F("zz", 40, 2.0))
    h = list_get(&xs, 0)
    fk + gk + h.k + str_len(h.name) + list_len(&xs)

fn main() -> Int ! alloc
    total(5)
