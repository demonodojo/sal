# Corpus: programa pensado para --instrument (OOB).
# Indexación `xs[i]` no parsea (los corchetes son type-args).
# Se usa una llamada `index` que el runtime instrumentado deberá comprobar.

fn index(xs: &List[Int], i: Int) -> Int
    0

fn empty_list() -> List[Int] ! alloc
    List.new[Int]()

fn main() -> Int ! alloc
    xs = empty_list()
    index(&xs, 99)
