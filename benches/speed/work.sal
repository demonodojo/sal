# Carga CPU: bucles anidados con mezcla entera (misma lógica que benches/speed/work.rs).
# Medición: ./benches/runtime.sh

fn mix(acc: Int, x: Int) -> Int
    t = acc + x
    t = t * 1664525 + 1013904223
    if t < 0
        0 - t
    else
        t

fn work(outer: Int, inner: Int) -> Int
    acc = 0
    i = 0
    while i < outer
        j = 0
        while j < inner
            acc = mix(acc, i + j)
            j = j + 1
        i = i + 1
    acc

fn main() -> Int
    work(6000, 6000)
