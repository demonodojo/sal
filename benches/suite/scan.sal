# Recorrer una cadena por bytes con str_char: cuenta vocales de un texto grande.
# Misma carga que benches/suite/scan.rs (N debe coincidir).

fn main() -> Int ! alloc
    s = d""
    i = 0
    while i < 200000
        s = s + "the quick brown fox jumps "
        i = i + 1
    count = 0
    rep = 0
    while rep < 5
        i = 0
        n = s.len()
        while i < n
            c = s.char(i)
            if c == 97 || c == 101 || c == 105 || c == 111 || c == 117
                count = count + 1
            i = i + 1
        rep = rep + 1
    # `% 251` needs every bit of `count`: with `& 255` LLVM keeps only the low byte and
    # narrows the vector counter, which hides the cost of the loop.
    count % 251
