# Quicksort in situ sobre List[Int] con get/set (índices comprobados).
# Misma carga que benches/suite/sort.rs (N debe coincidir).

fn quicksort(xs: &mut List[Int], lo: Int, hi: Int) -> Unit
    if lo < hi
        p = xs.get((lo + hi) / 2)
        i = lo
        j = hi
        while i <= j
            while xs.get(i) < p
                i = i + 1
            while xs.get(j) > p
                j = j - 1
            if i <= j
                t = xs.get(i)
                xs.set(i, xs.get(j))
                xs.set(j, t)
                i = i + 1
                j = j - 1
        quicksort(xs, lo, j)
        quicksort(xs, i, hi)

fn main() -> Int ! alloc
    n = 2000000
    xs = List.new[Int]()
    s = 12345
    i = 0
    while i < n
        s = (s * 1103515245 + 12345) & 2147483647
        xs.push(s)
        i = i + 1
    quicksort(&mut xs, 0, n - 1)
    ok = 1
    i = 1
    while i < n
        if xs.get(i - 1) > xs.get(i)
            ok = 0
        i = i + 1
    (xs.get(n / 2) + ok) & 255
