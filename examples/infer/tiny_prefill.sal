# Prefill benchmark: 4-layer tiny sosomodel (128 hidden, 8 tokens) on CPU.
# Weights: `cargo run --bin som2salt` → target/infer_salt/tiny/*.salt

fn decoder_layer(h: Tensor[F32, 8, 128] on cpu, attn_norm: Tensor[F32, 128] on cpu, wq: Tensor[F32, 128, 128] on cpu, wk: Tensor[F32, 128, 128] on cpu, wv: Tensor[F32, 128, 128] on cpu, wo: Tensor[F32, 128, 128] on cpu, ffn_norm: Tensor[F32, 128] on cpu, w_up: Tensor[F32, 256, 128] on cpu, w_down: Tensor[F32, 128, 256] on cpu) -> Tensor[F32, 8, 128] on cpu
    let residual = h
    let q = matmul(residual, wq)
    let k = matmul(residual, wk)
    let v = matmul(residual, wv)
    let q1 = rope(q, 0)
    let k1 = rope(k, 0)
    let q4 = reshape(q1, 8, 4, 32)
    let k4 = reshape(k1, 8, 4, 32)
    let v4 = reshape(v, 8, 4, 32)
    let a4 = attention(q4, k4, v4, true)
    let a = reshape(a4, 8, 128)
    let x1 = matmul(a, wo)
    let x2 = x1 + residual
    let up = matmul(x2, transpose(w_up))
    let up2 = silu(up)
    let x4 = matmul(up2, transpose(w_down))
    x4 + residual

fn main() -> Int ! io, alloc
    let p = d"target/infer_salt/tiny/"
    let h0 = load[Tensor[F32, 8, 128] on cpu](p + d"bench_input.salt")
    let t0 = now_ns()
    let h1 = decoder_layer(h0, load[Tensor[F32, 128] on cpu](p + d"L00_attn_norm.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L00_attn_q.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L00_attn_k.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L00_attn_v.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L00_attn_output.salt"), load[Tensor[F32, 128] on cpu](p + d"L00_ffn_norm.salt"), load[Tensor[F32, 256, 128] on cpu](p + d"L00_ffn_up.salt"), load[Tensor[F32, 128, 256] on cpu](p + d"L00_ffn_down.salt"))
    let h2 = decoder_layer(h1, load[Tensor[F32, 128] on cpu](p + d"L01_attn_norm.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L01_attn_q.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L01_attn_k.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L01_attn_v.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L01_attn_output.salt"), load[Tensor[F32, 128] on cpu](p + d"L01_ffn_norm.salt"), load[Tensor[F32, 256, 128] on cpu](p + d"L01_ffn_up.salt"), load[Tensor[F32, 128, 256] on cpu](p + d"L01_ffn_down.salt"))
    let h3 = decoder_layer(h2, load[Tensor[F32, 128] on cpu](p + d"L02_attn_norm.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L02_attn_q.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L02_attn_k.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L02_attn_v.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L02_attn_output.salt"), load[Tensor[F32, 128] on cpu](p + d"L02_ffn_norm.salt"), load[Tensor[F32, 256, 128] on cpu](p + d"L02_ffn_up.salt"), load[Tensor[F32, 128, 256] on cpu](p + d"L02_ffn_down.salt"))
    let _h4 = decoder_layer(h3, load[Tensor[F32, 128] on cpu](p + d"L03_attn_norm.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L03_attn_q.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L03_attn_k.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L03_attn_v.salt"), load[Tensor[F32, 128, 128] on cpu](p + d"L03_attn_output.salt"), load[Tensor[F32, 128] on cpu](p + d"L03_ffn_norm.salt"), load[Tensor[F32, 256, 128] on cpu](p + d"L03_ffn_up.salt"), load[Tensor[F32, 128, 256] on cpu](p + d"L03_ffn_down.salt"))
    let t1 = now_ns()
    let dt = t1 - t0
    let _w = print_str(d"sal_bench prefill_seq=8 prefill_layers=4 prefill_ns=" + int_to_str(dt) + d"\n")
    0
