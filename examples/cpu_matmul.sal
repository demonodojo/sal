# CPU 2×2 matmul smoke (same operands as tests/support/matmul_test.c).
# Product of [[1,2],[3,4]] × I is [[1,2],[3,4]]: the element nearest to 3 is the third (exit 2).
fn main() -> Int ! alloc
    let a = tensor[[1.0, 2.0], [3.0, 4.0]]
    let b = tensor[[1.0, 0.0], [0.0, 1.0]]
    c = matmul(a, b)
    d = c - 3.0
    argmax(-(d * d), 4)
