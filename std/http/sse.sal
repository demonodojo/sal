import "../text/strutil.sal"

struct Sse
    block: String

static Sse.new(block: String) -> Sse
    Sse(block)

method Sse.has_data(&self) -> Int ! alloc
    if self.block.contains(d"data:") != 0
        1
    else
        0

method Sse.is_done(&self) -> Int ! alloc
    if self.block.contains(d"[DONE]") != 0
        1
    else
        0

method Sse.payload(&self) -> String ! alloc
    sse_data_payload_go(&self.block)

method Sse.tool_index(&self) -> Int ! alloc
    sse_accum_tool_index_go(&self.block)

fn sse_data_payload_go(block: &String) -> String ! alloc
    idx = block.index_of(d"data:")
    if idx < 0
        d""
    else
        start = sse_data_start(block, idx + 5)
        end = block.index_from(d"\n", start)
        if end < 0
            block.slice(start, block.len())
        else
            block.slice(start, end)

fn sse_data_start(block: &String, start: Int) -> Int ! alloc
    if start >= block.len()
        start
    else
        if block.char(start) == 32
            start + 1
        else
            start

fn sse_accum_tool_index_go(block: &String) -> Int ! alloc
    idx = block.index_of(d"\"index\":")
    if idx < 0
        -1
    else
        rest = block.slice(idx + 8, block.len())
        rest.to_int()

@deprecated("use Sse.new(block).has_data()")
fn sse_has_data(block: &String) -> Int ! alloc
    Sse.new(block).has_data()

@deprecated("use Sse.new(block).is_done()")
fn sse_is_done(block: &String) -> Int ! alloc
    Sse.new(block).is_done()

@deprecated("use Sse.new(block).payload()")
fn sse_data_payload(block: &String) -> String ! alloc
    sse_data_payload_go(block)

@deprecated("use Sse.new(block).tool_index()")
fn sse_accum_tool_index(block: &String) -> Int ! alloc
    sse_accum_tool_index_go(block)
