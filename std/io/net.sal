import "abi.sal"
import "util.sal"

fn tcp_listen(port: Int) -> Int ! io
    syscall(NR_TCP_LISTEN, port, 0, 0, 0, 0, 0)

fn tcp_accept(fd: Int, ms: Int) -> Int ! io
    syscall(NR_TCP_ACCEPT, fd, ms, 0, 0, 0, 0)

fn sockaddr_loopback(port: Int) -> Int ! alloc
    sa = Bytes.new(SOCKADDR_SIZE)
    sap = sa.ptr()
    b = Bytes.view_mem(sap, SOCKADDR_SIZE)
    b.set_u8(0, 127)
    b.set_u8(1, 0)
    b.set_u8(2, 0)
    b.set_u8(3, 1)
    b.set_u8(4, u32_b0(port))
    b.set_u8(5, u32_b1(port))
    b.set_u8(6, 0)
    b.set_u8(7, 0)
    sap

fn tcp_connect_loopback(port: Int, timeout_ms: Int) -> Int ! io, alloc
    sa = sockaddr_loopback(port)
    syscall(NR_TCP_CONNECT, sa, timeout_ms, 0, 0, 0, 0)

fn dns_resolve_ptr(host_ptr: Int, host_len: Int, out_ptr: Int) -> Int ! io
    syscall(NR_DNS_RESOLVE, host_ptr, host_len, out_ptr, 0, 0, 0)

fn dns_resolve_host(host: &String) -> Int ! io, alloc
    b = Bytes.new(4)
    hb = Bytes.new(host.len() + 1)
    hb.write_str(0, host)
    rc = dns_resolve_ptr(hb.ptr(), host.len(), b.ptr())
    if rc < 0
        rc
    else
        ip4_from_bytes(&b)

fn ip4_from_bytes(b: &Bytes) -> Int ! alloc
    a0 = b.get_u8(0)
    a1 = b.get_u8(1)
    a2 = b.get_u8(2)
    a3 = b.get_u8(3)
    a0 + (a1 << 8) + (a2 << 16) + (a3 << 24)

fn sockaddr_from_ip4(ip4: Int, port: Int) -> Int ! alloc
    sa = Bytes.new(SOCKADDR_SIZE)
    sap = sa.ptr()
    v = Bytes.view_mem(sap, SOCKADDR_SIZE)
    v.set_u8(0, u32_b0(ip4))
    v.set_u8(1, u32_b1(ip4))
    v.set_u8(2, u32_b2(ip4))
    v.set_u8(3, u32_b3(ip4))
    v.set_u8(4, u32_b0(port))
    v.set_u8(5, u32_b1(port))
    v.set_u8(6, 0)
    v.set_u8(7, 0)
    sap

fn tcp_connect_ip4(ip4: Int, port: Int, timeout_ms: Int) -> Int ! io, alloc
    sa = sockaddr_from_ip4(ip4, port)
    syscall(NR_TCP_CONNECT, sa, timeout_ms, 0, 0, 0, 0)

fn tcp_connect_host(host: &String, port: Int, timeout_ms: Int) -> Int ! io, alloc
    ip4 = dns_resolve_host(host)
    if ip4 < 0
        ip4
    else
        tcp_connect_ip4(ip4, port, timeout_ms)
