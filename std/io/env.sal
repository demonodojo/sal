import "abi.sal"
import "fs.sal"

fn getenv(name: String) -> String ! io, alloc
    b = path_to_buf(name)
    out = bytes_new(4096)
    rc = syscall(nr_getenv(), bytes_ptr(b), str_len(name), bytes_ptr(out), 4096, 0, 0)
    if rc <= 0
        d""
    else
        bytes_to_str(bytes_view(out, 0, rc))
