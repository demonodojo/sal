# Preludio sal — superficie que el parser de arranque acepta hoy.
#
# Items: `fn`, `import`, `struct`, `enum`.
# Las primitivas de tensor (`matmul`, `softmax`, `map`, `reduce`, `reshape`,
# `transpose`, `relu`, `load`, `print`) las resuelve el runtime del compilador.
# Aquí se documentan firmas parseables; los cuerpos son stubs de identidad
# o reenvío, no la implementación real.

# --- Option / Result / List ---
# List se materializa en el runtime (`list_new` / `list_push` / `list_len` / `list_get`).

enum Option[T]
    None
    Some(T)

enum Result[T, E]
    Ok(T)
    Err(E)

fn list_new() -> List[Int] ! alloc
    list_new()

fn list_push(xs: List[Int], x: Int) -> List[Int]
    list_push(xs, x)

fn list_len(xs: List[Int]) -> Int
    list_len(xs)

fn list_get(xs: List[Int], i: Int) -> Int
    list_get(xs, i)

fn dict_new() -> Dict[String, Int] ! alloc
    dict_new()

fn dict_put(d: Dict[String, Int], k: String, v: Int) -> Dict[String, Int]
    dict_put(d, k, v)

fn dict_get(d: Dict[String, Int], k: String) -> Option[Int]
    dict_get(d, k)

# --- Operaciones de tensor ---

fn map(t: Tensor[F32, ?, 4] on p) -> Tensor[F32, ?, 4] on p
    t

fn reduce(t: Tensor[F32, ?, 4] on p) -> Tensor[F32, 4] on p
    t

fn matmul(a: Tensor[F32, ?, 4] on p, b: Tensor[F32, 4, 4] on p) -> Tensor[F32, ?, 4] on p
    a

fn softmax(t: Tensor[F32, ?, 4] on p) -> Tensor[F32, ?, 4] on p
    t

fn reshape(t: Tensor[F32, 2, 2] on p) -> Tensor[F32, 4, 1] on p
    t

fn transpose(t: Tensor[F32, 2, 4] on p) -> Tensor[F32, 4, 2] on p
    t

fn relu(t: Tensor[F32, ?, 4] on p) -> Tensor[F32, ?, 4] on p
    t

fn silu(t: Tensor[F32, ?, 4] on p) -> Tensor[F32, ?, 4] on p
    t

fn rms_norm(x: Tensor[F32, ?, 4] on p, w: Tensor[F32, ?, 4] on p) -> Tensor[F32, ?, 4] on p
    x

fn rope(x: Tensor[F32, ?, 4] on p, pos: Int) -> Tensor[F32, ?, 4] on p
    x

fn attention(q: Tensor[F32, ?, 2, 2] on p, k: Tensor[F32, ?, 1, 2] on p, v: Tensor[F32, ?, 1, 2] on p, causal: Bool) -> Tensor[F32, ?, 2, 2] on p
    q

fn qmatmul(a: Tensor[F32, ?, 4] on p, w: Tensor[I8, 4, 4] on p, scale: Tensor[F32, ?] on p, group: Int) -> Tensor[F32, ?, 4] on p
    a

fn tensor_append(cache: Tensor[F32, ?] on p, row: Tensor[F32, ?] on p) -> Tensor[F32, ?] on p
    cache

fn argmax(t: Tensor[F32, ?] on p, axis: Int) -> Int
    0

# Forma deseada del plan: load[F32, 4, 4]("w.salt") — no parsea (dims no son tipos).
# Forma aceptada hoy: load[Tensor[F32, 4, 4] on cpu](path)

fn load_weights(path: String) -> Tensor[F32, 4, 4] on cpu ! io, alloc
    load[Tensor[F32, 4, 4] on cpu](path)

fn print_line(s: String) -> Int ! io
    print(s)

# Opaque i64 string handles in selfhost vectors (zero-cost at runtime).
fn str_from_int(x: Int) -> String
    str_from_int(x)

fn str_as_int(s: String) -> Int
    str_as_int(s)

fn str_to_f64_bits(s: String) -> Int
    str_to_f64_bits(s)

fn f64_bits_to_str(bits: Int) -> String ! alloc
    f64_bits_to_str(bits)

fn now_ns() -> Int
    now_ns()

fn str_bytes(s: String) -> Tensor[I8, ?] on cpu ! alloc
    str_bytes(s)
