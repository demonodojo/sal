import lexer
import patch

struct Spec
    mode: Int
    argc: Int
    method: String
    ty: String
    tyn: Int

struct BracketInfo
    ok: Int
    end_after: Int
    type_n: Int

struct ScanArgs
    ok: Int
    rparen: Int
    ncommas: Int
    first: Int
    any: Int

struct ParsedCall
    rparen: Int
    open: Int
    ncommas: Int
    first: Int
    any: Int
    ty_lo: Int
    ty_hi: Int
    ty_n: Int

fn spec_none() -> Spec ! alloc
    Spec(0, 0, d"", d"", 0)

fn spec_ok(s: &Spec) -> Int
    if s.mode == 0
        0
    else
        1

fn call_invalid() -> ParsedCall
    ParsedCall(-1, 0, 0, -1, 0, -1, -1, 0)

fn call_ok(c: ParsedCall) -> Int
    if c.rparen < 0
        0
    else
        1

fn off_skip() -> Off ! alloc
    Off(d"", d"", -1, -1, 0, d"")

CODE_METHOD = "Style/Method"

fn is_ws(c: Int) -> Int
    match c
        32 => 1
        10 => 1
        13 => 1
        9 => 1
        _ => 0

fn is_digit(c: Int) -> Int
    if c >= 48 && c <= 57
        1
    else
        0

fn is_ident_char(c: Int) -> Int
    if is_ident_start(c) == 1
        1
    else
        is_digit(c)

fn arg_count(ncommas: Int, any: Int) -> Int
    if ncommas == 0
        if any == 0
            0
        else
            1
    else
        ncommas + 1

fn spec_inst(method: String, argc: Int) -> Spec ! alloc
    Spec(1, argc, method, d"", 0)

fn spec_static(ty: String, method: String, tyn: Int, argc: Int) -> Spec ! alloc
    Spec(2, argc, method, ty, tyn)

fn method_of(name: &String) -> Spec ! alloc
    match name
        "str_len" => spec_inst(d"len", 1)
        "strdup" => spec_inst(d"dup", 1)
        "str_eq" => spec_inst(d"eq", 2)
        "str_contains" => spec_inst(d"contains", 2)
        "str_slice" => spec_inst(d"slice", 3)
        "str_char" => spec_inst(d"char", 2)
        "str_hash" => spec_inst(d"hash", 2)
        "str_skip" => spec_inst(d"skip", 4)
        "str_as_int" => spec_inst(d"to_int", 1)
        "str_index_of" => spec_inst(d"index_of", 2)
        "str_index_from" => spec_inst(d"index_from", 3)
        "list_len" => spec_inst(d"len", 1)
        "list_push" => spec_inst(d"push", 2)
        "list_get" => spec_inst(d"get", 2)
        "list_set" => spec_inst(d"set", 3)
        "list_pop" => spec_inst(d"pop", 1)
        "dict_get" => spec_inst(d"get", 2)
        "dict_put" => spec_inst(d"put", 3)
        "dict_has" => spec_inst(d"has", 2)
        "dict_len" => spec_inst(d"len", 1)
        "dict_remove" => spec_inst(d"remove", 2)
        "dict_keys" => spec_inst(d"keys", 1)
        "dict_values" => spec_inst(d"values", 1)
        "bytes_len" => spec_inst(d"len", 1)
        "bytes_get_u8" => spec_inst(d"get_u8", 2)
        "bytes_get_u16" => spec_inst(d"get_u16", 2)
        "bytes_get_u32" => spec_inst(d"get_u32", 2)
        "bytes_get_i64" => spec_inst(d"get_i64", 2)
        "bytes_set_u8" => spec_inst(d"set_u8", 3)
        "bytes_set_u16" => spec_inst(d"set_u16", 3)
        "bytes_set_u32" => spec_inst(d"set_u32", 3)
        "bytes_set_i64" => spec_inst(d"set_i64", 3)
        "bytes_fill" => spec_inst(d"fill", 4)
        "bytes_copy" => spec_inst(d"copy", 5)
        "bytes_ptr" => spec_inst(d"ptr", 1)
        "bytes_to_str" => spec_inst(d"to_str", 1)
        "str_bytes_copy" => spec_inst(d"write_str", 3)
        "bytes_view_mem" => spec_static(d"Bytes", d"view_mem", 0, 2)
        "int_to_str" => spec_inst(d"to_str", 1)
        "int_to_float" => spec_inst(d"to_float", 1)
        "float_to_int" => spec_inst(d"to_int", 1)
        "f64_bits_to_str" => spec_inst(d"to_str", 1)
        "float_sqrt" => spec_inst(d"sqrt", 1)
        "float_abs" => spec_inst(d"abs", 1)
        "float_floor" => spec_inst(d"floor", 1)
        "float_ceil" => spec_inst(d"ceil", 1)
        "float_sin" => spec_inst(d"sin", 1)
        "float_cos" => spec_inst(d"cos", 1)
        "float_exp" => spec_inst(d"exp", 1)
        "float_log" => spec_inst(d"log", 1)
        "float_pow" => spec_inst(d"pow", 2)
        "list_new" => spec_static(d"List", d"new", 1, 0)
        "dict_new" => spec_static(d"Dict", d"new", 2, 0)
        "bytes_new" => spec_static(d"Bytes", d"new", 0, 1)
        "char_to_str" => spec_static(d"String", d"from_char", 0, 1)
        _ => spec_none()

fn after_comment(src: &String, hash_i: Int, n: Int) -> Int ! alloc
    j = src.skip(hash_i + 1, 4, 0)
    if j < n && src.char(j) == 10
        j + 1
    else
        j

fn string_end(src: &String, quote_i: Int, n: Int) -> Int ! alloc
    end = src.skip(quote_i + 1, 7, 0)
    if end < n && src.char(end) == 34
        end + 1
    else
        n

fn is_dstring_at(src: &String, i: Int, n: Int) -> Int ! alloc
    if i + 1 >= n
        0
    elsif src.char(i) != 100
        0
    elsif src.char(i + 1) != 34
        0
    elsif i > 0
        if is_ident_char(src.char(i - 1)) == 1
            0
        else
            1
    else
        1

fn skip_ws_cmt(src: &String, i: Int, n: Int) -> Int ! alloc
    j = i
    go = 1
    while go == 1
        if j >= n
            go = 0
        else
            c = src.char(j)
            if is_ws(c) == 1
                j = j + 1
            elsif c == 35
                j = after_comment(src, j, n)
            else
                go = 0
    j

fn scan_closer(src: &String, i: Int, n: Int, open_c: Int, close_c: Int) -> Int ! alloc
    j = i
    depth = 0
    found = 0 - 1
    go = 1
    while go == 1
        if j >= n
            go = 0
        else
            c = src.char(j)
            if c == 35
                j = after_comment(src, j, n)
            elsif c == 34
                j = string_end(src, j, n)
            elsif is_dstring_at(src, j, n) == 1
                j = string_end(src, j + 1, n)
            elsif c == open_c
                depth = depth + 1
                j = j + 1
            elsif c == close_c
                depth = depth - 1
                if depth == 0
                    found = j
                    go = 0
                elsif depth < 0
                    go = 0
                else
                    j = j + 1
            else
                j = j + 1
    found

# [end_after, nargs], or 0 when the brackets do not close.
fn bracket_info(src: &String, open_i: Int, n: Int) -> BracketInfo ! alloc
    j = open_i
    depth = 0
    ncommas = 0
    any = 0
    end_after = 0 - 1
    go = 1
    while go == 1
        if j >= n
            go = 0
        else
            c = src.char(j)
            if c == 35
                j = after_comment(src, j, n)
            elsif c == 34
                j = string_end(src, j, n)
                any = 1
            elsif is_dstring_at(src, j, n) == 1
                j = string_end(src, j + 1, n)
                any = 1
            elsif c == 91
                if depth >= 1
                    any = 1
                depth = depth + 1
                j = j + 1
            elsif c == 93
                depth = depth - 1
                if depth == 0
                    end_after = j + 1
                    go = 0
                elsif depth < 0
                    go = 0
                else
                    any = 1
                    j = j + 1
            elsif c == 44
                if depth == 1
                    ncommas = ncommas + 1
                else
                    any = 1
                j = j + 1
            elsif is_ws(c) == 1
                j = j + 1
            else
                any = 1
                j = j + 1
    if end_after < 0
        BracketInfo(0, 0, 0)
    else
        BracketInfo(1, end_after, arg_count(ncommas, any))

# [rparen, ncommas, first_comma, any], or 0.
fn scan_args(src: &String, open_i: Int, n: Int) -> ScanArgs ! alloc
    j = open_i
    depth_p = 0
    depth_b = 0
    ncommas = 0
    first = 0 - 1
    any = 0
    rparen = 0 - 1
    go = 1
    while go == 1
        if j >= n
            go = 0
        else
            c = src.char(j)
            if c == 35
                j = after_comment(src, j, n)
            elsif c == 34
                j = string_end(src, j, n)
                any = 1
            elsif is_dstring_at(src, j, n) == 1
                j = string_end(src, j + 1, n)
                any = 1
            elsif c == 40
                if depth_p >= 1
                    any = 1
                depth_p = depth_p + 1
                j = j + 1
            elsif c == 41
                depth_p = depth_p - 1
                if depth_p == 0
                    rparen = j
                    go = 0
                elsif depth_p < 0
                    go = 0
                else
                    any = 1
                    j = j + 1
            elsif c == 91
                depth_b = depth_b + 1
                any = 1
                j = j + 1
            elsif c == 93
                if depth_b > 0
                    depth_b = depth_b - 1
                any = 1
                j = j + 1
            elsif c == 44
                if depth_p == 1 && depth_b == 0
                    if first < 0
                        first = j
                    ncommas = ncommas + 1
                else
                    any = 1
                j = j + 1
            elsif is_ws(c) == 1
                j = j + 1
            else
                any = 1
                j = j + 1
    if rparen < 0
        ScanArgs(0, 0, 0, 0, 0)
    else
        ScanArgs(1, rparen, ncommas, first, any)

# [rparen, open, ncommas, first, any, type_lo, type_hi, type_n]
fn parse_call(src: &String, name_end: Int, n: Int) -> ParsedCall ! alloc
    i = skip_ws_cmt(src, name_end, n)
    type_lo = 0 - 1
    type_hi = 0 - 1
    type_n = 0
    if i < n
        if src.char(i) == 91
            info = bracket_info(src, i, n)
            if info.ok == 0
                return call_invalid()
            type_lo = i
            type_hi = info.end_after
            type_n = info.type_n
            i = skip_ws_cmt(src, type_hi, n)
    if i >= n
        return call_invalid()
    if src.char(i) != 40
        return call_invalid()
    args = scan_args(src, i, n)
    if args.ok == 0
        return call_invalid()
    ParsedCall(args.rparen, i, args.ncommas, args.first, args.any, type_lo, type_hi, type_n)

fn call_argc(c: ParsedCall) -> Int ! alloc
    arg_count(c.ncommas, c.any)

fn call_matches(spec: &Spec, call: ParsedCall) -> Int ! alloc
    if spec.mode == 1
        if call.ty_n != 0
            0
        elsif call_argc(call) != spec.argc
            0
        else
            1
    elsif call.ty_n != spec.tyn
        0
    elsif call_argc(call) != spec.argc
        0
    else
        1

fn plain_end(s: &String, i: Int, n: Int) -> Int ! alloc
    j = i
    go = 1
    while go == 1
        if j >= n
            go = 0
        else
            c = s.char(j)
            if c == 35
                go = 0
            elsif c == 34
                go = 0
            elsif is_dstring_at(s, j, n) == 1
                go = 0
            else
                j = j + 1
    j

fn strip_comments(s: &String) -> String ! alloc
    n = s.len()
    acc = d""
    i = 0
    while i < n
        c = s.char(i)
        if c == 35
            i = after_comment(s, i, n)
        elsif c == 34
            j = string_end(s, i, n)
            piece = s.slice(i, j)
            acc = acc + piece
            i = j
        elsif is_dstring_at(s, i, n) == 1
            j = string_end(s, i + 1, n)
            piece = s.slice(i, j)
            acc = acc + piece
            i = j
        else
            j = plain_end(s, i, n)
            piece = s.slice(i, j)
            acc = acc + piece
            i = j
    acc

fn trim_left_at(s: &String, n: Int) -> Int ! alloc
    a = 0
    go = 1
    while go == 1
        if a >= n
            go = 0
        elsif is_ws(s.char(a)) == 1
            a = a + 1
        else
            go = 0
    a

fn trim_right_at(s: &String, n: Int, lo: Int) -> Int ! alloc
    b = n
    go = 1
    while go == 1
        if b <= lo
            go = 0
        elsif is_ws(s.char(b - 1)) == 1
            b = b - 1
        else
            go = 0
    b

fn trim_copy(s: &String) -> String ! alloc
    n = s.len()
    a = trim_left_at(s, n)
    if a >= n
        d""
    else
        b = trim_right_at(s, n, a)
        s.slice(a, b)

fn clean_span(src: &String, start: Int, end: Int) -> String ! alloc
    if start >= end
        d""
    else
        raw = src.slice(start, end)
        trim_copy(&strip_comments(&raw))

fn skip_spaces(s: &String, i: Int, n: Int) -> Int ! alloc
    j = i
    go = 1
    while go == 1
        if j >= n
            go = 0
        elsif is_ws(s.char(j)) == 1
            j = j + 1
        else
            go = 0
    j

fn parse_atom(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    else
        c = s.char(i)
        if c == 40
            cl = scan_closer(s, i, n, 40, 41)
            if cl < 0
                0 - 1
            else
                cl + 1
        elsif c == 34
            string_end(s, i, n)
        elsif is_dstring_at(s, i, n) == 1
            string_end(s, i + 1, n)
        elsif is_digit(c) == 1
            j = s.skip(i, 3, 0)
            if j < n && s.char(j) == 46
                if j + 1 < n
                    if is_digit(s.char(j + 1)) == 1
                        0 - 1
                    else
                        j
                else
                    0 - 1
            else
                j
        elsif is_ident_start(c) == 1
            s.skip(i, 2, 0)
        else
            0 - 1

fn parse_postfix(s: &String, i: Int, n: Int) -> Int ! alloc
    j = skip_spaces(s, i, n)
    if j >= n
        j
    else
        c = s.char(j)
        if c == 46
            k = skip_spaces(s, j + 1, n)
            if k >= n
                j
            elsif is_ident_start(s.char(k)) == 0
                j
            else
                parse_postfix(s, s.skip(k, 2, 0), n)
        elsif c == 40
            cl = scan_closer(s, j, n, 40, 41)
            if cl < 0
                j
            else
                parse_postfix(s, cl + 1, n)
        elsif c == 91
            cl = scan_closer(s, j, n, 91, 93)
            if cl < 0
                j
            else
                k = skip_spaces(s, cl + 1, n)
                if k >= n
                    j
                elsif s.char(k) != 40
                    j
                else
                    cl2 = scan_closer(s, k, n, 40, 41)
                    if cl2 < 0
                        j
                    else
                        parse_postfix(s, cl2 + 1, n)
        else
            j

fn needs_paren(s: &String) -> Int ! alloc
    n = s.len()
    if n == 0
        1
    elsif is_digit(s.char(0)) == 1
        # `77.to_str()` does not parse: the literal takes the dot.
        1
    else
        pos = parse_atom(s, 0, n)
        if pos < 0
            1
        else
            pos2 = parse_postfix(s, pos, n)
            if pos2 == n
                0
            else
                1

fn wrap_paren(s: &String) -> String ! alloc
    "(" + s + ")"

fn join_method(recv: &String, method: &String, rest: &String) -> String ! alloc
    recv + "." + method + "(" + rest + ")"

fn build_inst(src: &String, spec: &Spec, call: ParsedCall) -> String ! alloc
    open = call.open
    first = call.first
    rp = call.rparen
    recv_end = rp
    if first >= 0
        recv_end = first
    recv = clean_span(src, open + 1, recv_end)
    if recv.len() == 0
        d""
    else
        rest = d""
        if first >= 0
            rest = clean_span(src, first + 1, rp)
        if needs_paren(&recv) == 1
            join_method(&wrap_paren(&recv), &spec.method, &rest)
        else
            join_method(&recv, &spec.method, &rest)

fn build_static(src: &String, spec: &Spec, call: ParsedCall) -> String ! alloc
    open = call.open
    rp = call.rparen
    inside = clean_span(src, open + 1, rp)
    types = d""
    if call.ty_lo >= 0
        types = src.slice(call.ty_lo, call.ty_hi)
    a = spec.ty + "."
    a = a + spec.method
    a = a + types
    a = a + "("
    a = a + inside
    a + ")"

fn build_fix(src: &String, spec: &Spec, call: ParsedCall) -> String ! alloc
    if spec.mode == 1
        build_inst(src, spec, call)
    else
        build_static(src, spec, call)

fn method_msg(name: &String, spec: &Spec) -> String ! alloc
    if spec.mode == 2
        "use " + spec.ty + "." + spec.method + " instead of " + name
    else
        "use ." + spec.method + "() instead of " + name

fn preceded_by_dot(src: &String, start: Int) -> Int ! alloc
    i = start - 1
    go = 1
    dot = 0
    while go == 1
        if i < 0
            go = 0
        else
            c = src.char(i)
            match c
                32 =>
                    i = i - 1
                9 =>
                    i = i - 1
                46 =>
                    dot = 1
                    go = 0
                _ =>
                    go = 0
    dot

fn prev_is_fn(src: &String, lex: &Lex, i: Int) -> Int ! alloc
    j = i - 1
    go = 1
    while go == 1
        if j < 0
            go = 0
        else
            k = lex.kind(j)
            if k == TK_NL
                j = j - 1
            elsif k == TK_INDENT
                j = j - 1
            elsif k == TK_DEDENT
                j = j - 1
            else
                go = 0
    if j < 0
        0
    elsif lex.kind(j) != TK_IDENT
        0
    else
        lex.text(src, j).eq("fn")

fn consider(src: &String, lex: &Lex, n: Int, i: Int) -> Off ! alloc
    if lex.kind(i) != TK_IDENT
        return off_skip()
    if preceded_by_dot(src, lex.start(i)) == 1
        return off_skip()
    if prev_is_fn(src, lex, i) == 1
        return off_skip()
    name = lex.text(src, i)
    spec = method_of(&name)
    if spec_ok(&spec) == 0
        return off_skip()
    call = parse_call(src, lex.end(i), src.len())
    if call_ok(call) == 0
        return off_skip()
    if call_matches(&spec, call) == 0
        return off_skip()
    fix = build_fix(src, &spec, call)
    if fix.len() == 0
        return off_skip()
    msg = method_msg(&name, &spec)
    off_new(CODE_METHOD, msg, lex.start(i), call.rparen + 1, 1, fix)

fn cop_method(src: &String, lex: &Lex, offs: &mut List[Off]) -> Int ! alloc
    cop_method_go(src, lex, offs, 0, lex.len())

fn cop_method_go(src: &String, lex: &Lex, offs: &mut List[Off], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        off = consider(src, lex, n, i)
        if off.start < 0
            cop_method_go(src, lex, offs, i + 1, n)
        else
            offs.push(off)
            cop_method_go(src, lex, offs, i + 1, n)
