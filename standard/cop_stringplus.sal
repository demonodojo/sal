import lexer
import patch
import util

fn CODE_PLUS() -> String ! alloc
    d"Style/StringPlus"

struct ScanR
    ok: Int
    ci: Int
    rp: Int

struct TwoArgs
    ok: Int
    ce: Int
    a1s: Int
    a1e: Int
    a2s: Int
    a2e: Int

struct StrCall
    ok: Int
    start: Int
    end: Int
    a1s: Int
    a1e: Int
    a2s: Int
    a2e: Int
    fk: Int

struct ChainFix
    ok: Int
    start: Int
    end: Int
    fix: String

fn is_str_fun(name: &String) -> Int ! alloc
    if name.eq("str_concat") == 1
        1
    elsif name.eq("str_append") == 1
        2
    else
        0

fn prev_non_nl(lex: &Lex, i: Int) -> Int ! alloc
    if i <= 0
        0 - 1
    elsif lex.kind(i - 1) == TK_NL()
        prev_non_nl(lex, i - 1)
    else
        i - 1

fn next_non_nl(lex: &Lex, n: Int, i: Int) -> Int ! alloc
    if i >= n
        n
    elsif lex.kind(i) == TK_NL()
        next_non_nl(lex, n, i + 1)
    else
        i

fn join_plus(parts: &List[String]) -> String ! alloc
    join_plus_go(parts, 0, parts.len(), d"")

fn join_plus_go(parts: &List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = parts.get(i)
        if i == 0
            join_plus_go(parts, i + 1, n, piece.clone())
        else
            join_plus_go(parts, i + 1, n, (acc + " + " + piece))

fn scan_paren(lex: &Lex, n: Int, i: Int, depth: Int, ci: Int) -> ScanR ! alloc
    if i >= n
        ScanR(0, 0, 0)
    else
        k = lex.kind(i)
        if k == TK_LPAREN()
            scan_paren(lex, n, i + 1, depth + 1, ci)
        elsif k == TK_RPAREN()
            d2 = depth - 1
            if d2 == 0
                ScanR(1, ci, i)
            else
                scan_paren(lex, n, i + 1, d2, ci)
        elsif k == TK_COMMA()
            if depth == 1
                scan_paren(lex, n, i + 1, depth, i)
            else
                scan_paren(lex, n, i + 1, depth, ci)
        else
            scan_paren(lex, n, i + 1, depth, ci)

fn parse_two_args(lex: &Lex, n: Int, lp: Int) -> TwoArgs ! alloc
    i = next_non_nl(lex, n, lp + 1)
    if i >= n
        TwoArgs(0, 0, 0, 0, 0, 0)
    else
        a1s = lex.start(i)
        st = scan_paren(lex, n, i, 1, 0 - 1)
        if st.ok == 0
            TwoArgs(0, 0, 0, 0, 0, 0)
        elsif st.ci < 0
            TwoArgs(0, 0, 0, 0, 0, 0)
        else
            a1e = lex.end(prev_non_nl(lex, st.ci))
            a2i = next_non_nl(lex, n, st.ci + 1)
            a2s = lex.start(a2i)
            a2e = lex.end(prev_non_nl(lex, st.rp))
            ce = lex.end(st.rp)
            TwoArgs(1, ce, a1s, a1e, a2s, a2e)

fn parse_call_at(src: &String, lex: &Lex, n: Int, i: Int) -> StrCall ! alloc
    if i >= n
        StrCall(0, 0, 0, 0, 0, 0, 0, 0)
    elsif lex.kind(i) != TK_IDENT()
        StrCall(0, 0, 0, 0, 0, 0, 0, 0)
    else
        name = lex.text(src, i)
        fk = is_str_fun(&name)
        if fk == 0
            StrCall(0, 0, 0, 0, 0, 0, 0, 0)
        else
            j = skip_nl(lex, n, i + 1)
            if j >= n
                StrCall(0, 0, 0, 0, 0, 0, 0, 0)
            elsif lex.kind(j) != TK_LPAREN()
                StrCall(0, 0, 0, 0, 0, 0, 0, 0)
            else
                parsed = parse_two_args(lex, n, j)
                if parsed.ok == 0
                    StrCall(0, 0, 0, 0, 0, 0, 0, 0)
                else
                    StrCall(1, lex.start(i), parsed.ce, parsed.a1s, parsed.a1e, parsed.a2s, parsed.a2e, fk)

fn build_call_fix(src: &String, call: StrCall) -> String ! alloc
    a = src.slice(call.a1s, call.a1e)
    b = src.slice(call.a2s, call.a2e)
    parts = List.new[String]()
    parts.push(a)
    parts.push(b)
    join_plus(&parts)

fn try_assign_chain(src: &String, lex: &Lex, n: Int, i: Int) -> ChainFix ! alloc
    if i >= n
        ChainFix(0, 0, 0, d"")
    elsif lex.kind(i) != TK_IDENT()
        ChainFix(0, 0, 0, d"")
    else
        var = lex.text(src, i)
        j = skip_nl(lex, n, i + 1)
        if j >= n
            ChainFix(0, 0, 0, d"")
        elsif lex.kind(j) != TK_EQ()
            ChainFix(0, 0, 0, d"")
        else
            k = skip_nl(lex, n, j + 1)
            call = parse_call_at(src, lex, n, k)
            if call.ok == 0
                ChainFix(0, 0, 0, d"")
            else
                parts = List.new[String]()
                a = src.slice(call.a1s, call.a1e)
                b = src.slice(call.a2s, call.a2e)
                parts.push(a)
                parts.push(b)
                end_i = call.end
                ti = tok_index_at_or_after(lex, n, end_i, 0)
                end_i = chain_append_lines(src, lex, n, ti, &var, &mut parts, end_i)
                rhs = join_plus(&parts)
                fix = var + " = " + rhs
                ChainFix(1, lex.start(i), end_i, fix)

fn tok_index_at_or_after(lex: &Lex, n: Int, byte_pos: Int, i: Int) -> Int ! alloc
    if i >= n
        n
    elsif lex.start(i) >= byte_pos
        i
    else
        tok_index_at_or_after(lex, n, byte_pos, i + 1)

fn chain_append_lines(src: &String, lex: &Lex, n: Int, i: Int, var: &String, parts: &mut List[String], end_byte: Int) -> Int ! alloc
    i2 = skip_nl(lex, n, i)
    if i2 >= n
        end_byte
    elsif lex.kind(i2) == TK_DEDENT()
        end_byte
    elsif lex.kind(i2) != TK_IDENT()
        end_byte
    else
        name = lex.text(src, i2)
        if name.eq(var) == 0
            end_byte
        else
            j = skip_nl(lex, n, i2 + 1)
            if j >= n
                end_byte
            elsif lex.kind(j) != TK_EQ()
                end_byte
            else
                k = skip_nl(lex, n, j + 1)
                call = parse_call_at(src, lex, n, k)
                if call.ok == 0
                    end_byte
                elsif call.fk != 2
                    end_byte
                else
                    a = src.slice(call.a1s, call.a1e)
                    b = src.slice(call.a2s, call.a2e)
                    if a.eq(var) == 0
                        end_byte
                    else
                        parts.push(b)
                        end2 = call.end
                        ti = tok_index_at_or_after(lex, n, end2, 0)
                        chain_append_lines(src, lex, n, ti, var, parts, end2)

fn cop_stringplus(src: &String, lex: &Lex, offs: &mut List[Off]) -> Int ! alloc
    n = lex.len()
    cop_plus_assign_go(src, lex, offs, 0, n)
    cop_plus_call_go(src, lex, offs, 0, n)

fn cop_plus_assign_go(src: &String, lex: &Lex, offs: &mut List[Off], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ch = try_assign_chain(src, lex, n, i)
        if ch.ok == 1
            msg = d"use + instead of str_concat/str_append"
            o = off_new(CODE_PLUS(), msg, ch.start, ch.end, 1, ch.fix)
            _p = offs.push(o)
            next_i = tok_index_at_or_after(lex, n, ch.end, 0)
            cop_plus_assign_go(src, lex, offs, next_i, n)
        else
            cop_plus_assign_go(src, lex, offs, i + 1, n)

fn inside_any_off(offs: &List[Off], start: Int, end: Int) -> Int ! alloc
    inside_off_go(offs, 0, offs.len(), start, end)

fn inside_off_go(offs: &List[Off], i: Int, n: Int, start: Int, end: Int) -> Int ! alloc
    if i >= n
        0
    else
        o = offs.get(i)
        s0 = o.start
        s1 = o.end
        if start >= s0
            if end <= s1
                1
            else
                inside_off_go(offs, i + 1, n, start, end)
        else
            inside_off_go(offs, i + 1, n, start, end)

fn cop_plus_call_go(src: &String, lex: &Lex, offs: &mut List[Off], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        call = parse_call_at(src, lex, n, i)
        if call.ok == 0
            cop_plus_call_go(src, lex, offs, i + 1, n)
        elsif inside_any_off(offs, call.start, call.end) == 1
            cop_plus_call_go(src, lex, offs, call.end, n)
        else
            fix = build_call_fix(src, call)
            msg = d"use + instead of str_concat/str_append"
            o = off_new(CODE_PLUS(), msg, call.start, call.end, 1, fix)
            _p = offs.push(o)
            cop_plus_call_go(src, lex, offs, call.end, n)
