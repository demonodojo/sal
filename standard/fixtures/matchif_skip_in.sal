fn f(n: Int, m: Int) -> Int
    if n == 1
        10
    elsif m == 2
        20
    else
        0

fn one(n: Int) -> Int
    if n == 1
        x = 2
        x + 1
    else
        0

fn early(n: Int) -> Int
    if n == 1
        return 10
    elsif n == 2
        return 20
    else
        return 0

fn early_one(n: Int) -> Int
    if n == 1
        x = 2
        return x
    elsif n == 2
        20
    else
        0

fn nested(n: Int, m: Int) -> Int
    if n == 1
        if m == 1
            10
        else
            20
    elsif n == 2
        30
    else
        0

fn nested_branch(n: Int, m: Int) -> Int
    if n == 1
        10
    elsif n == 2
        if m == 1
            20
        else
            30
    else
        0

fn early_elsif(n: Int) -> Int
    if n == 1
        10
    elsif n == 2
        return 20
    else
        0

fn early_else(n: Int) -> Int
    if n == 1
        10
    elsif n == 2
        20
    else
        return 0

fn nested_else(n: Int, m: Int) -> Int
    if n == 1
        10
    elsif n == 2
        20
    else
        x = m
        if x == 1
            30
        else
            40

fn main() -> Int
    f(1, 2)
fn combined(q: String) -> Int ! alloc
    if q.eq("a") + q.eq("b") > 0
        1
    elsif q.eq("c") + q.eq("d") > 0
        2
    else
        0
fn final_block(n: Int) -> Int
    if n == 1
        1
    elsif n == 2
        2
    else
        x = n + 1
        x

fn assigned(n: Int) -> Int
    value = if n == 1
        10
    elsif n == 2
        20
    else
        0
    value
