import lexer
import patch
import util

fn CODE_UNUSED() -> String ! alloc
    d"Style/UnusedBinding"

fn cop_unusedbinding(src: String, lex: Lex, offs: List[Off]) -> Int ! alloc
    n = lex.len()
    cop_unused_go(src, lex, offs, 0, n)

fn cop_unused_go(src: String, lex: Lex, offs: List[Off], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif ub_offense_at(src, lex, n, i) == 1
        start = ub_name_start(src, lex.start(i))
        end = lex.start(i + 2)
        msg = d"unused binding: write the call as a statement"
        fix = d""
        o = off_new(CODE_UNUSED(), msg, start, end, 1, fix)
        offs.push(o)
        cop_unused_go(src, lex, offs, i + 1, n)
    else
        cop_unused_go(src, lex, offs, i + 1, n)

fn ub_name_start(src: String, pos: Int) -> Int ! alloc
    if pos > 0
        if src.char(pos - 1) == 95
            pos - 1
        else
            pos
    else
        pos

fn ub_offense_at(src: String, lex: Lex, n: Int, i: Int) -> Int ! alloc
    if lex.kind(i) != TK_IDENT()
        0
    elsif ub_stmt_start(lex, i) == 0
        0
    elsif i + 3 >= n
        0
    elsif lex.kind(i + 1) != TK_EQ()
        0
    else
        p = ub_rhs_lparen(lex, n, i + 2)
        if p < 0
            0
        else
            ub_call_stmt_unused(src, lex, n, i, p)

fn ub_rhs_lparen(lex: Lex, n: Int, j: Int) -> Int ! alloc
    if j >= n
        0 - 1
    elsif lex.kind(j) != TK_IDENT()
        0 - 1
    elsif j + 1 >= n
        0 - 1
    elsif lex.kind(j + 1) == TK_LPAREN()
        j + 1
    else
        ub_rhs_lparen(lex, n, j + 1)

fn ub_call_stmt_unused(src: String, lex: Lex, n: Int, i: Int, p: Int) -> Int ! alloc
    close = ub_matching_rparen(lex, n, p, 0)
    if close < 0
        0
    elsif ub_last_in_block(lex, n, close + 1) == 1
        0
    else
        name = lex.text(src, i)
        lo = ub_item_start(src, lex, i)
        hi = ub_item_end(src, lex, n, i + 1)
        if ub_reads(src, lex, lo, hi, i, name) == 1
            0
        else
            1

fn ub_matching_rparen(lex: Lex, n: Int, j: Int, depth: Int) -> Int ! alloc
    if j >= n
        0 - 1
    else
        k = lex.kind(j)
        if k == TK_LPAREN()
            ub_matching_rparen(lex, n, j + 1, depth + 1)
        elsif k == TK_RPAREN()
            if depth == 1
                j
            else
                ub_matching_rparen(lex, n, j + 1, depth - 1)
        else
            ub_matching_rparen(lex, n, j + 1, depth)

fn ub_last_in_block(lex: Lex, n: Int, j: Int) -> Int ! alloc
    k = skip_nl(lex, n, j)
    if k >= n
        1
    elsif lex.kind(k) == TK_DEDENT()
        1
    else
        0

fn ub_stmt_start(lex: Lex, i: Int) -> Int ! alloc
    if i == 0
        1
    else
        k = lex.kind(i - 1)
        if k == TK_NL()
            1
        elsif k == TK_INDENT()
            1
        elsif k == TK_DEDENT()
            1
        else
            0

fn ub_is_item_kw(src: String, lex: Lex, i: Int) -> Int ! alloc
    if lex.kind(i) != TK_IDENT()
        0
    else
        w = lex.text(src, i)
        if w.eq("fn") + w.eq("method") + w.eq("static") + w.eq("init") == 0
            0
        else
            ub_line_start(src, lex.start(i))

fn ub_line_start(src: String, pos: Int) -> Int ! alloc
    if pos == 0
        1
    elsif src.char(pos - 1) == 10
        1
    else
        0

fn ub_item_start(src: String, lex: Lex, i: Int) -> Int ! alloc
    if i <= 0
        0
    elsif ub_is_item_kw(src, lex, i) == 1
        i
    else
        ub_item_start(src, lex, i - 1)

fn ub_item_end(src: String, lex: Lex, n: Int, j: Int) -> Int ! alloc
    if j >= n
        n
    elsif ub_is_item_kw(src, lex, j) == 1
        j
    else
        ub_item_end(src, lex, n, j + 1)

fn ub_reads(src: String, lex: Lex, lo: Int, hi: Int, skip: Int, name: String) -> Int ! alloc
    if lo >= hi
        0
    elsif lo == skip
        ub_reads(src, lex, lo + 1, hi, skip, name)
    else
        k = lex.kind(lo)
        if k == TK_IDENT()
            if lex.text(src, lo).eq(name) == 1
                1
            else
                ub_reads(src, lex, lo + 1, hi, skip, name)
        elsif k == TK_DSTRING()
            ub_reads_str(src, lex, lo, hi, skip, name)
        elsif k == TK_STRING()
            ub_reads_str(src, lex, lo, hi, skip, name)
        else
            ub_reads(src, lex, lo + 1, hi, skip, name)

fn ub_reads_str(src: String, lex: Lex, lo: Int, hi: Int, skip: Int, name: String) -> Int ! alloc
    if lex.text(src, lo).contains(name) == 1
        1
    else
        ub_reads(src, lex, lo + 1, hi, skip, name)
