import lexer
import patch
import cop_dupstring
import cop_elsif
import cop_matchif
import cop_and
import cop_stringplus
import cop_plusliteral
import cop_unusedbinding
import cop_method
import cop_stdapi
import cop_constfn

struct CopsResult
    status: Int
    offs: List[Off]

struct LineCol
    line: Int
    col: Int

struct FixArgs
    limited: Int
    lo: Int
    hi: Int
    bad: Int

fn run_lex(src: &String) -> Lex ! alloc
    lex(src)

fn run_all_cops(src: &String) -> CopsResult ! alloc
    lx = run_lex(src)
    offs = List.new[Off]()
    if lx.status != LEX_OK()
        CopsResult(lx.status, offs)
    else
        cop_dupstring(src, &lx, &offs)
        cop_elsif(src, &lx, &offs)
        cop_matchif(src, &lx, &offs)
        cop_and(src, &lx, &offs)
        cop_stringplus(src, &lx, &offs)
        cop_plusliteral(src, &lx, &offs)
        cop_unusedbinding(src, &lx, &offs)
        cop_method(src, &lx, &offs)
        cop_stdapi(src, &lx, &offs)
        cop_constfn(src, &lx, &offs)
        CopsResult(LEX_OK(), offs)

fn byte_line_col(src: &String, pos: Int, i: Int, line: Int, col: Int) -> LineCol ! alloc
    if i >= pos
        LineCol(line, col)
    else
        c = src.char(i)
        if c == 10
            byte_line_col(src, pos, i + 1, line + 1, 1)
        else
            byte_line_col(src, pos, i + 1, line, col + 1)

fn format_off(path: &String, src: &String, o: &Off) -> String ! alloc
    start = o.start
    lc = byte_line_col(src, start, 0, 1, 1)
    path + ":" + lc.line.to_str() + ":" + lc.col.to_str() + ": " + o.code + ": " + o.msg

fn json_escape(s: &String) -> String ! alloc
    json_escape_go(s, 0, s.len(), d"")

fn json_escape_go(s: &String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = json_escape_byte(s.char(i))
        json_escape_go(s, i + 1, n, (acc + piece))

fn json_escape_byte(c: Int) -> String ! alloc
    if c == 34
        d"\\\""
    elsif c == 92
        d"\\\\"
    elsif c == 10
        d"\\n"
    elsif c == 13
        d"\\r"
    elsif c == 9
        d"\\t"
    elsif c < 32
        json_u(c)
    else
        String.from_char(c)

fn hex_digit(n: Int) -> String ! alloc
    if n < 10
        String.from_char(48 + n)
    else
        String.from_char(87 + n)

fn json_u(c: Int) -> String ! alloc
    hi = c / 16
    lo = c - hi * 16
    "\\u00" + hex_digit(hi) + hex_digit(lo)

fn json_fix(o: &Off) -> String ! alloc
    if o.has_fix() == 0
        d"null"
    else
        "\"" + json_escape(&o.fix) + "\""

fn format_off_json(src: &String, o: &Off) -> String ! alloc
    start = o.start
    endb = o.end
    lc = byte_line_col(src, start, 0, 1, 1)
    "{\"code\":\"" + json_escape(&o.code) + "\",\"message\":\"" + json_escape(&o.msg) + "\",\"span\":{\"start\":" + start.to_str() + ",\"end\":" + endb.to_str() + ",\"line\":" + lc.line.to_str() + ",\"col\":" + lc.col.to_str() + "},\"fix\":" + json_fix(o) + "}"

fn print_offs_json(src: &String, offs: &List[Off]) -> Int ! io, alloc
    print_offs_json_go(src, offs, 0, offs.len())

fn print_offs_json_go(src: &String, offs: &List[Off], i: Int, n: Int) -> Int ! io, alloc
    if i >= n
        0
    else
        o = offs.get(i)
        line = format_off_json(src, &o)
        eprint_str(line + "\n")
        print_offs_json_go(src, offs, i + 1, n)

fn print_offs(path: &String, src: &String, offs: &List[Off]) -> Int ! io, alloc
    print_offs_go(path, src, offs, 0, offs.len())

fn print_offs_go(path: &String, src: &String, offs: &List[Off], i: Int, n: Int) -> Int ! io, alloc
    if i >= n
        0
    else
        o = offs.get(i)
        line = format_off(path, src, &o)
        eprint_str(line + "\n")
        print_offs_go(path, src, offs, i + 1, n)

fn fix_to_point(src: &String, pass: Int, max_pass: Int) -> String ! alloc
    ranged = fix_to_point_span(src, pass, max_pass, 0, 0, 0)
    ranged.text

fn fix_to_point_span(src: &String, pass: Int, max_pass: Int, lo: Int, hi: Int, limited: Int) -> RangedText ! alloc
    if pass >= max_pass
        RangedText(src.dup(), lo, hi)
    else
        pack = run_all_cops(src)
        if pack.status != LEX_OK()
            RangedText(src.dup(), lo, hi)
        elsif limited == 0
            next = apply_all_fixes(src.dup(), &pack.offs)
            if src.eq(next) == 1
                RangedText(src.dup(), lo, hi)
            else
                fix_to_point_span(&next, pass + 1, max_pass, lo, hi, 0)
        else
            ranged = apply_ranged_fixes(src.dup(), &pack.offs, lo, hi)
            lo2 = ranged.lo
            hi2 = ranged.hi
            next = ranged.text
            if src.eq(next) == 1
                RangedText(next, lo2, hi2)
            else
                fix_to_point_span(&next, pass + 1, max_pass, lo2, hi2, 1)

fn run_check(path: &String, src: &String, as_json: Int) -> Int ! io, alloc
    pack = run_all_cops(src)
    if pack.status != LEX_OK()
        eprint_str(d"lex error\n")
        2
    else
        n = pack.offs.len()
        if n == 0
            0
        elsif as_json == 1
            print_offs_json(src, &pack.offs)
            1
        else
            print_offs(path, src, &pack.offs)
            1

fn wants_json() -> Int ! alloc
    flag = argv(3)
    val = argv(4)
    if flag.eq("--error-format") == 1 && val.eq("json") == 1
        1
    else
        0

fn parse_nonneg(s: &String) -> Int ! alloc
    parse_nonneg_go(s, 0, s.len(), 0, 0)

fn parse_nonneg_go(s: &String, i: Int, n: Int, acc: Int, ok: Int) -> Int ! alloc
    if i >= n
        if ok == 1
            acc
        else
            0 - 1
    else
        c = s.char(i)
        if c < 48
            0 - 1
        elsif c > 57
            0 - 1
        else
            parse_nonneg_go(s, i + 1, n, acc * 10 + (c - 48), 1)

fn parse_fix_args() -> FixArgs ! alloc
    flag = argv(3)
    if flag.eq("") == 1
        FixArgs(0, 0, 0, 0)
    else
        parse_fix_args_flag(&flag)

fn parse_fix_args_flag(flag: &String) -> FixArgs ! alloc
    if flag.eq("--start") == 1
        parse_fix_range()
    else
        FixArgs(0, 0, 0, 1)

fn parse_fix_range() -> FixArgs ! alloc
    lo = parse_nonneg(&argv(4))
    endf = argv(5)
    hi = parse_nonneg(&argv(6))
    extra = argv(7)
    if extra.eq("") == 0
        FixArgs(0, 0, 0, 1)
    elsif endf.eq("--end") == 0
        FixArgs(0, 0, 0, 1)
    elsif lo < 0
        FixArgs(0, 0, 0, 1)
    elsif hi < 0
        FixArgs(0, 0, 0, 1)
    elsif hi < lo
        FixArgs(0, 0, 0, 1)
    else
        FixArgs(1, lo, hi, 0)

fn clamp_max(x: Int, n: Int) -> Int
    if x > n
        n
    else
        x

fn fixed_source(src: &String, args: FixArgs) -> String ! alloc
    if args.limited == 0
        fix_to_point(src, 0, 16)
    else
        n = src.len()
        lo = clamp_max(args.lo, n)
        hi = clamp_max(args.hi, n)
        ranged = fix_to_point_span(src, 0, 16, lo, hi, 1)
        ranged.text

fn report_fixed(path: &String, src: &String) -> Int ! io, alloc
    pack = run_all_cops(src)
    if pack.status != LEX_OK()
        2
    else
        n = pack.offs.len()
        if n == 0
            0
        else
            print_offs(path, src, &pack.offs)
            1

fn run_fix(path: &String, src: &String) -> Int ! io, alloc
    args = parse_fix_args()
    if args.bad == 1
        eprint_str(d"usage: fix FILE [--start N --end M]\n")
        2
    else
        run_fix_checked(path, src, args)

fn run_fix_checked(path: &String, src: &String, args: FixArgs) -> Int ! io, alloc
    pack = run_all_cops(src)
    if pack.status != LEX_OK()
        eprint_str(d"lex error\n")
        2
    else
        fixed = fixed_source(src, args)
        write_file(path, fixed)
        report_fixed(path, &fixed)

fn main() -> Int ! io, alloc
    cmd = argv(1)
    path = argv(2)
    src = read_file(path)
    if cmd.eq("check") == 1
        run_check(&path, &src, wants_json())
    else
        main_fix_or_usage(&cmd, &path, &src)

fn main_fix_or_usage(cmd: &String, path: &String, src: &String) -> Int ! io, alloc
    if cmd.eq("fix") == 1
        run_fix(path, src)
    else
        eprint_str(d"usage: check|fix FILE\n")
        2
