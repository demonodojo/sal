import lexer
import patch
import cop_dupstring
import cop_elsif
import cop_stringplus
import cop_plusliteral

fn run_lex(src: Int) -> Int ! alloc
    lex(src)

fn run_all_cops(src: Int) -> Int ! alloc
    lr = run_lex(src)
    st = lex_result_status(lr)
    if st != LEX_OK()
        pack = vec_new()
        _s = vec_push(pack, st)
        _o = vec_push(pack, vec_new())
        pack
    else
        toks = lex_result_tokens(lr)
        a = cop_dupstring(src, toks)
        b = cop_elsif(src, toks)
        c = cop_stringplus(src, toks)
        d = cop_plusliteral(src, toks)
        ab = merge_off_lists(a, b)
        abc = merge_off_lists(ab, c)
        offs = merge_off_lists(abc, d)
        pack = vec_new()
        _s = vec_push(pack, LEX_OK())
        _o = vec_push(pack, offs)
        pack

fn cops_pack_status(p: Int) -> Int ! alloc
    vec_get(p, 0)

fn cops_pack_offs(p: Int) -> Int ! alloc
    vec_get(p, 1)

fn byte_line_col(src: Int, pos: Int, i: Int, line: Int, col: Int) -> Int ! alloc
    if i >= pos
        pack = vec_new()
        _a = vec_push(pack, line)
        _b = vec_push(pack, col)
        pack
    else
        c = str_char(src, i)
        if c == 10
            byte_line_col(src, pos, i + 1, line + 1, 1)
        else
            byte_line_col(src, pos, i + 1, line, col + 1)

fn lc_line(p: Int) -> Int ! alloc
    vec_get(p, 0)

fn lc_col(p: Int) -> Int ! alloc
    vec_get(p, 1)

fn format_off(path: Int, src: Int, o: Int) -> Int ! alloc
    start = off_start(o)
    lc = byte_line_col(src, start, 0, 1, 1)
    ln = int_to_str(lc_line(lc))
    cl = int_to_str(lc_col(lc))
    acc = str_concat(path, strdup(":"))
    acc = str_append(acc, ln)
    acc = str_append(acc, strdup(":"))
    acc = str_append(acc, cl)
    acc = str_append(acc, strdup(": "))
    acc = str_append(acc, off_code(o))
    acc = str_append(acc, strdup(": "))
    str_append(acc, off_msg(o))

fn json_escape(s: Int) -> Int ! alloc
    json_escape_go(s, 0, str_len(s), strdup(""))

fn json_escape_go(s: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        piece = json_escape_byte(str_char(s, i))
        acc2 = str_append(acc, piece)
        json_escape_go(s, i + 1, n, acc2)

fn json_escape_byte(c: Int) -> Int ! alloc
    if c == 34
        strdup("\\\"")
    elsif c == 92
        strdup("\\\\")
    elsif c == 10
        strdup("\\n")
    elsif c == 13
        strdup("\\r")
    elsif c == 9
        strdup("\\t")
    elsif c < 32
        json_u(c)
    else
        char_to_str(c)

fn hex_digit(n: Int) -> Int ! alloc
    if n < 10
        char_to_str(48 + n)
    else
        char_to_str(87 + n)

fn json_u(c: Int) -> Int ! alloc
    hi = c / 16
    lo = c - hi * 16
    acc = strdup("\\u00")
    acc2 = str_append(acc, hex_digit(hi))
    str_append(acc2, hex_digit(lo))

fn json_fix(fix: Int) -> Int ! alloc
    if fix == 0
        strdup("null")
    else
        acc = strdup("\"")
        acc2 = str_append(acc, json_escape(fix))
        str_append(acc2, strdup("\""))

fn format_off_json(src: Int, o: Int) -> Int ! alloc
    start = off_start(o)
    endb = off_end(o)
    lc = byte_line_col(src, start, 0, 1, 1)
    acc = strdup("{{\"code\":\"")
    acc = str_append(acc, json_escape(off_code(o)))
    acc = str_append(acc, strdup("\",\"message\":\""))
    acc = str_append(acc, json_escape(off_msg(o)))
    acc = str_append(acc, strdup("\",\"span\":{{\"start\":"))
    acc = str_append(acc, int_to_str(start))
    acc = str_append(acc, strdup(",\"end\":"))
    acc = str_append(acc, int_to_str(endb))
    acc = str_append(acc, strdup(",\"line\":"))
    acc = str_append(acc, int_to_str(lc_line(lc)))
    acc = str_append(acc, strdup(",\"col\":"))
    acc = str_append(acc, int_to_str(lc_col(lc)))
    acc = str_append(acc, strdup("}},\"fix\":"))
    acc = str_append(acc, json_fix(off_fix(o)))
    str_append(acc, strdup("}}"))

fn print_offs_json(src: Int, offs: Int) -> Int ! io, alloc
    print_offs_json_go(src, offs, 0, vec_len(offs))

fn print_offs_json_go(src: Int, offs: Int, i: Int, n: Int) -> Int ! io, alloc
    if i >= n
        0
    else
        o = vec_get(offs, i)
        line = format_off_json(src, o)
        msg = str_concat(line, strdup("\n"))
        _e = eprint_str(msg)
        print_offs_json_go(src, offs, i + 1, n)

fn print_offs(path: Int, src: Int, offs: Int) -> Int ! io, alloc
    print_offs_go(path, src, offs, 0, vec_len(offs))

fn print_offs_go(path: Int, src: Int, offs: Int, i: Int, n: Int) -> Int ! io, alloc
    if i >= n
        0
    else
        o = vec_get(offs, i)
        line = format_off(path, src, o)
        msg = str_concat(line, strdup("\n"))
        _e = eprint_str(msg)
        print_offs_go(path, src, offs, i + 1, n)

fn count_offs(offs: Int) -> Int ! alloc
    vec_len(offs)

fn fix_to_point(src: Int, pass: Int, max_pass: Int) -> Int ! alloc
    if pass >= max_pass
        src
    else
        pack = run_all_cops(src)
        if cops_pack_status(pack) != LEX_OK()
            src
        else
            offs = cops_pack_offs(pack)
            best = pick_best_fix(offs)
            if best < 0
                src
            else
                o = vec_get(offs, best)
                s0 = off_start(o)
                s1 = off_end(o)
                fix = off_fix(o)
                next = patch_one(src, s0, s1, fix)
                if str_eq(src, next) == 1
                    src
                else
                    fix_to_point(next, pass + 1, max_pass)

fn run_check(path: Int, src: Int, as_json: Int) -> Int ! io, alloc
    pack = run_all_cops(src)
    if cops_pack_status(pack) != LEX_OK()
        _e = eprint_str(strdup("lex error\n"))
        2
    else
        offs = cops_pack_offs(pack)
        n = count_offs(offs)
        if n == 0
            0
        elsif as_json == 1
            _p = print_offs_json(src, offs)
            1
        else
            _p = print_offs(path, src, offs)
            1

fn wants_json() -> Int ! alloc
    flag = argv(3)
    val = argv(4)
    if str_eq(flag, "--error-format") == 1
        if str_eq(val, "json") == 1
            1
        else
            0
    else
        0

fn run_fix(path: Int, src: Int) -> Int ! io, alloc
    pack = run_all_cops(src)
    if cops_pack_status(pack) != LEX_OK()
        _e = eprint_str(strdup("lex error\n"))
        2
    else
        fixed = fix_to_point(src, 0, 16)
        _wr = write_file(path, fixed)
        pack2 = run_all_cops(fixed)
        if cops_pack_status(pack2) != LEX_OK()
            2
        else
            offs2 = cops_pack_offs(pack2)
            n = count_offs(offs2)
            if n == 0
                0
            else
                _p = print_offs(path, fixed, offs2)
                1

fn main() -> Int ! io, alloc
    cmd = argv(1)
    path = argv(2)
    src = read_file(path)
    if str_eq(cmd, "check") == 1
        run_check(path, src, wants_json())
    elsif str_eq(cmd, "fix") == 1
        run_fix(path, src)
    else
        _e = eprint_str(strdup("usage: check|fix FILE\n"))
        2
