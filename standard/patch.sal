# Offense records and source patching.

struct Off
    code: String
    msg: String
    start: Int
    end: Int
    has_fix: Int
    fix: String

struct RangedText
    text: String
    lo: Int
    hi: Int

method Off.has_fix(&self) -> Int
    if self.has_fix == 1
        1
    else
        0

method Off.overlaps(&self, lo: Int, hi: Int) -> Int
    if self.start < hi && self.end > lo
        1
    else
        0

fn off_new(code: String, msg: String, start: Int, end: Int, has_fix: Int, fix: String) -> Off ! alloc
    Off(code, msg, start, end, has_fix, fix)

fn patch_one(src: &String, start: Int, end: Int, repl: &String) -> String ! alloc
    left = src.slice(0, start)
    right = src.slice(end, src.len())
    left + repl + right

fn pick_best_fix(offs: &List[Off]) -> Int ! alloc
    n = offs.len()
    pick_best_go(offs, 0, n, 0 - 1, 0, 0)

fn pick_best_go(offs: &List[Off], i: Int, n: Int, best: Int, best_len: Int, best_start: Int) -> Int ! alloc
    if i >= n
        best
    else
        o = offs.get(i)
        if o.has_fix() == 0
            pick_best_go(offs, i + 1, n, best, best_len, best_start)
        else
            s0 = o.start
            s1 = o.end
            ln = s1 - s0
            if best < 0
                pick_best_go(offs, i + 1, n, i, ln, s0)
            elsif ln < best_len
                pick_best_go(offs, i + 1, n, i, ln, s0)
            elsif ln == best_len
                if s0 > best_start
                    pick_best_go(offs, i + 1, n, i, ln, s0)
                else
                    pick_best_go(offs, i + 1, n, best, best_len, best_start)
            else
                pick_best_go(offs, i + 1, n, best, best_len, best_start)

# Apply every non-overlapping fix in one pass, rightmost first, so spans stay valid.
fn apply_all_fixes(src: String, offs: &List[Off]) -> String ! alloc
    idxs = fix_indices(offs)
    if idxs.len() == 0
        src
    else
        ordered = sort_idxs(offs, idxs, 0)
        chosen = greedy_take(offs, &ordered)
        right = sort_idxs(offs, chosen, 1)
        nright = right.len()
        apply_right(src, offs, &right, 0, nright)

fn fix_indices(offs: &List[Off]) -> List[Int] ! alloc
    v = List.new[Int]()
    fix_indices_go(offs, v, 0, offs.len())

fn fix_indices_go(offs: &List[Off], v: List[Int], i: Int, n: Int) -> List[Int] ! alloc
    if i >= n
        v
    elsif offs.get(i).has_fix() == 1
        v.push(i)
        fix_indices_go(offs, v, i + 1, n)
    else
        fix_indices_go(offs, v, i + 1, n)

fn sort_idxs(offs: &List[Off], idxs: List[Int], mode: Int) -> List[Int] ! alloc
    n = idxs.len()
    sort_idxs_go(offs, idxs, mode, 1, n)

fn sort_idxs_go(offs: &List[Off], idxs: List[Int], mode: Int, i: Int, n: Int) -> List[Int] ! alloc
    if i >= n
        idxs
    else
        idxs2 = bubble_idx(offs, idxs, mode, i)
        sort_idxs_go(offs, idxs2, mode, i + 1, n)

fn bubble_idx(offs: &List[Off], idxs: List[Int], mode: Int, i: Int) -> List[Int] ! alloc
    if i == 0
        idxs
    else
        cur = idxs.get(i)
        prev = idxs.get(i - 1)
        if idx_before(offs, cur, prev, mode) == 1
            idxs.set(i, prev)
            idxs.set(i - 1, cur)
            bubble_idx(offs, idxs, mode, i - 1)
        else
            idxs

fn idx_before(offs: &List[Off], ia: Int, ib: Int, mode: Int) -> Int ! alloc
    a = offs.get(ia)
    b = offs.get(ib)
    if mode == 0
        ea = a.end
        eb = b.end
        if ea < eb
            1
        elsif ea > eb
            0
        elsif a.start > b.start
            1
        else
            0
    elsif a.start > b.start
        1
    else
        0

fn greedy_take(offs: &List[Off], sorted: &List[Int]) -> List[Int] ! alloc
    out = List.new[Int]()
    st = List.new[Int]()
    st.push(0 - 1)
    _a = greedy_take_go(offs, sorted, &mut out, &mut st, 0, sorted.len())
    out

fn greedy_take_go(offs: &List[Off], sorted: &List[Int], out: &mut List[Int], st: &mut List[Int], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ix = sorted.get(i)
        o = offs.get(ix)
        s = o.start
        if s >= st.get(0)
            out.push(ix)
            st.set(0, o.end)
            greedy_take_go(offs, sorted, out, st, i + 1, n)
        else
            greedy_take_go(offs, sorted, out, st, i + 1, n)

fn apply_right(src: String, offs: &List[Off], idxs: &List[Int], i: Int, n: Int) -> String ! alloc
    if i >= n
        src
    else
        o = offs.get(idxs.get(i))
        next = patch_one(&src, o.start, o.end, &o.fix)
        apply_right(next.clone(), offs, idxs, i + 1, n)

# Apply fixes whose span overlaps [lo, hi). The returned span is that range after the edits.
fn apply_ranged_fixes(src: String, offs: &List[Off], lo: Int, hi: Int) -> RangedText ! alloc
    idxs = fix_indices_in_range(offs, lo, hi)
    if idxs.len() == 0
        RangedText(src, lo, hi)
    else
        ordered = sort_idxs(offs, idxs, 0)
        chosen = greedy_take(offs, &ordered)
        right = sort_idxs(offs, chosen.clone(), 1)
        nright = right.len()
        text = apply_right(src, offs, &right, 0, nright)
        RangedText(text, map_edge(offs, &chosen, lo, 0), map_edge(offs, &chosen, hi, 1))

fn fix_indices_in_range(offs: &List[Off], lo: Int, hi: Int) -> List[Int] ! alloc
    v = List.new[Int]()
    _a = fix_indices_in_range_go(offs, &mut v, lo, hi, 0, offs.len())
    v

fn fix_indices_in_range_go(offs: &List[Off], v: &mut List[Int], lo: Int, hi: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        o = offs.get(i)
        if o.has_fix() == 0
            fix_indices_in_range_go(offs, v, lo, hi, i + 1, n)
        elsif o.overlaps(lo, hi) == 0
            fix_indices_in_range_go(offs, v, lo, hi, i + 1, n)
        else
            v.push(i)
            fix_indices_in_range_go(offs, v, lo, hi, i + 1, n)

fn shift_before(offs: &List[Off], chosen: &List[Int], pos: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        o = offs.get(chosen.get(i))
        if o.end <= pos
            delta = o.fix.len() - (o.end - o.start)
            shift_before(offs, chosen, pos, i + 1, n, acc + delta)
        else
            shift_before(offs, chosen, pos, i + 1, n, acc)

fn strict_cover(offs: &List[Off], chosen: &List[Int], pos: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    else
        ix = chosen.get(i)
        o = offs.get(ix)
        if o.start < pos && o.end > pos
            ix
        else
            strict_cover(offs, chosen, pos, i + 1, n)

fn map_edge(offs: &List[Off], chosen: &List[Int], pos: Int, as_end: Int) -> Int ! alloc
    ix = strict_cover(offs, chosen, pos, 0, chosen.len())
    if ix < 0
        pos + shift_before(offs, chosen, pos, 0, chosen.len(), 0)
    else
        map_covered(offs, chosen, ix, as_end)

fn map_covered(offs: &List[Off], chosen: &List[Int], ix: Int, as_end: Int) -> Int ! alloc
    o = offs.get(ix)
    base = o.start + shift_before(offs, chosen, o.start, 0, chosen.len(), 0)
    if as_end == 1
        base + o.fix.len()
    else
        base
