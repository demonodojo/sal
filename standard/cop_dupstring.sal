import lexer
import patch
import util

fn CODE_DUP() -> String ! alloc
    d"Style/DupString"

fn cop_dupstring(src: &String, lex: &Lex, offs: &List[Off]) -> Int ! alloc
    n = lex.len()
    cop_dup_go(src, lex, offs, 0, n)

fn cop_dup_go(src: &String, lex: &Lex, offs: &List[Off], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif lex.kind(i) == TK_IDENT()
        name = lex.text(src, i)
        if name.eq("strdup") == 1
            j = skip_nl(lex, n, i + 1)
            if j < n
                if lex.kind(j) == TK_LPAREN()
                    j2 = skip_nl(lex, n, j + 1)
                    if j2 < n
                        if lex.kind(j2) == TK_STRING()
                            j3 = skip_nl(lex, n, j2 + 1)
                            if j3 < n
                                if lex.kind(j3) == TK_RPAREN()
                                    start = lex.start(i)
                                    end = lex.end(j3)
                                    lit = src.slice(lex.start(j2), lex.end(j2))
                                    fix = "d" + lit
                                    msg = d"use d\"…\" instead of strdup(\"…\")"
                                    o = off_new(CODE_DUP(), msg, start, end, 1, fix)
                                    _p = offs.push(o)
                                    cop_dup_go(src, lex, offs, j3 + 1, n)
                                else
                                    cop_dup_go(src, lex, offs, i + 1, n)
                            else
                                cop_dup_go(src, lex, offs, i + 1, n)
                        else
                            cop_dup_go(src, lex, offs, i + 1, n)
                    else
                        cop_dup_go(src, lex, offs, i + 1, n)
                else
                    cop_dup_go(src, lex, offs, i + 1, n)
            else
                cop_dup_go(src, lex, offs, i + 1, n)
        else
            cop_dup_go(src, lex, offs, i + 1, n)
    else
        cop_dup_go(src, lex, offs, i + 1, n)
