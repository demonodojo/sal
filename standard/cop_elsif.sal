import lexer
import patch
import util

fn CODE_ELSIF() -> String ! alloc
    d"Style/Elsif"

fn skip_to_indent(lex: &Lex, n: Int, i: Int) -> Int ! alloc
    if i >= n
        i
    elsif lex.kind(i) == TK_INDENT()
        i
    else
        skip_to_indent(lex, n, i + 1)

fn consume_suite(lex: &Lex, n: Int, i: Int) -> Int ! alloc
    if i >= n
        i
    elsif lex.kind(i) != TK_INDENT()
        i
    else
        consume_suite_go(lex, n, i, 0)

fn consume_suite_go(lex: &Lex, n: Int, i: Int, depth: Int) -> Int ! alloc
    if i >= n
        i
    else
        k = lex.kind(i)
        if k == TK_INDENT()
            consume_suite_go(lex, n, i + 1, depth + 1)
        elsif k == TK_DEDENT()
            d2 = depth - 1
            if d2 == 0
                i + 1
            else
                consume_suite_go(lex, n, i + 1, d2)
        else
            consume_suite_go(lex, n, i + 1, depth)

fn consume_elsif_list(lex: &Lex, n: Int, i: Int) -> Int ! alloc
    if i >= n
        i
    elsif lex.kind(i) == TK_ELSIF()
        j = skip_to_indent(lex, n, i + 1)
        j2 = consume_suite(lex, n, j)
        consume_elsif_list(lex, n, j2)
    else
        i

fn consume_if(lex: &Lex, n: Int, if_i: Int) -> Int ! alloc
    j = skip_to_indent(lex, n, if_i + 1)
    j2 = consume_suite(lex, n, j)
    j3 = consume_elsif_list(lex, n, j2)
    if j3 >= n
        j3
    elsif lex.kind(j3) == TK_ELSE()
        j4 = skip_nl(lex, n, j3 + 1)
        consume_suite(lex, n, j4)
    else
        j3

fn only_nl_between(lex: &Lex, n: Int, a: Int, b: Int) -> Int ! alloc
    if a >= b
        1
    else
        k = lex.kind(a)
        if k == TK_NL()
            only_nl_between(lex, n, a + 1, b)
        elsif k == TK_INDENT()
            if a + 1 == b
                1
            else
                0
        else
            0

fn find_first_nl(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        n
    elsif s.char(i) == 10
        i
    else
        find_first_nl(s, i + 1, n)

fn drop_first_line(s: &String) -> String ! alloc
    n = s.len()
    nl = find_first_nl(s, 0, n)
    if nl >= n
        d""
    else
        s.slice(nl + 1, n)

fn unindent_line(s: &String, spaces: Int) -> String ! alloc
    n = s.len()
    if n < spaces
        s
    else
        ok = count_spaces_match(s, 0, spaces, 1)
        if ok == 1
            s.slice(spaces, n)
        else
            s

fn count_spaces_match(s: &String, i: Int, left: Int, ok: Int) -> Int ! alloc
    if ok == 0
        0
    elsif left == 0
        1
    elsif s.char(i) == 32
        count_spaces_match(s, i + 1, left - 1, 1)
    else
        0

fn unindent_text(s: &String, spaces: Int) -> String ! alloc
    unindent_go(s, 0, s.len(), spaces, d"")

fn unindent_go(s: &String, i: Int, n: Int, spaces: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        nl = find_first_nl(s, i, n)
        if nl >= n
            acc + unindent_line(&s.slice(i, n), spaces)
        else
            body = s.slice(i, nl)
            body2 = unindent_line(&body, spaces)
            acc2 = acc + body2 + "\n"
            unindent_go(s, nl + 1, n, spaces, acc2)

fn trim_nl_suffix(lex: &Lex, j: Int) -> Int ! alloc
    if j <= 0
        0
    elsif lex.kind(j - 1) == TK_NL()
        trim_nl_suffix(lex, j - 1)
    else
        j

fn cond_text_from_if(src: &String, lex: &Lex, n: Int, if_i: Int) -> String ! alloc
    j = skip_to_indent(lex, n, if_i + 1)
    j2 = trim_nl_suffix(lex, j)
    if j2 <= if_i + 1
        d""
    else
        start = lex.start(if_i + 1)
        end = lex.start(j2)
        src.slice(start, end)

fn find_line_start(src: &String, i: Int) -> Int ! alloc
    if i < 0
        0
    elsif src.char(i) == 10
        i + 1
    else
        find_line_start(src, i - 1)

fn line_leading(src: &String, pos: Int) -> String ! alloc
    ls = find_line_start(src, pos - 1)
    src.slice(ls, pos)

fn slice_has_comment(src: &String, start: Int, end: Int) -> Int ! alloc
    piece = src.slice(start, end)
    if piece.contains(d"#") == 1
        1
    else
        0

fn build_elsif_fix(src: &String, lex: &Lex, else_i: Int, if_i: Int, if_end: Int) -> String ! alloc
    else_start = lex.start(else_i)
    if_start = lex.start(if_i)
    if_end_byte = lex.end(if_end - 1)
    cond = cond_text_from_if(src, lex, lex.len(), if_i)
    inner = src.slice(if_start, if_end_byte)
    rest = drop_first_line(&inner)
    body = unindent_text(&rest, 4)
    lead = line_leading(src, else_start)
    head = lead + "elsif " + cond + "\n"
    head + body

fn cop_elsif(src: &String, lex: &Lex, offs: &List[Off]) -> Int ! alloc
    n = lex.len()
    cop_elsif_go(src, lex, offs, 0, n)

fn cop_elsif_go(src: &String, lex: &Lex, offs: &List[Off], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif lex.kind(i) == TK_ELSE()
        j = skip_nl(lex, n, i + 1)
        if j < n
            if lex.kind(j) == TK_INDENT()
                j2 = skip_nl(lex, n, j + 1)
                if j2 < n
                    if lex.kind(j2) == TK_IF()
                        ok_gap = only_nl_between(lex, n, j + 1, j2)
                        if ok_gap == 1
                            if_end = consume_if(lex, n, j2)
                            else_start = lex.start(i)
                            if_start = lex.start(j2)
                            patch_start = find_line_start(src, else_start - 1)
                            if slice_has_comment(src, lex.end(i), if_start) == 1
                                msg = d"else/if could be elsif; comment in between blocks auto-fix"
                                o = off_new(CODE_ELSIF(), msg, patch_start, lex.end(if_end - 1), 0, d"")
                                _p = offs.push(o)
                                cop_elsif_go(src, lex, offs, if_end, n)
                            else
                                fix = build_elsif_fix(src, lex, i, j2, if_end)
                                msg = d"use elsif instead of else/if"
                                o = off_new(CODE_ELSIF(), msg, patch_start, lex.end(if_end - 1), 1, fix)
                                _p = offs.push(o)
                                cop_elsif_go(src, lex, offs, if_end, n)
                        else
                            cop_elsif_go(src, lex, offs, i + 1, n)
                    else
                        cop_elsif_go(src, lex, offs, i + 1, n)
                else
                    cop_elsif_go(src, lex, offs, i + 1, n)
            else
                cop_elsif_go(src, lex, offs, i + 1, n)
        else
            cop_elsif_go(src, lex, offs, i + 1, n)
    else
        cop_elsif_go(src, lex, offs, i + 1, n)
