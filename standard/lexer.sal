# Lexer for standard: tokens carry byte spans into the original source.

struct Lex
    status: Int
    kinds: List[Int]
    starts: List[Int]
    ends: List[Int]

fn TK_EOF() -> Int
    0

fn TK_NL() -> Int
    1

fn TK_INDENT() -> Int
    2

fn TK_DEDENT() -> Int
    3

fn TK_IDENT() -> Int
    4

fn TK_STRING() -> Int
    5

fn TK_DSTRING() -> Int
    6

fn TK_LPAREN() -> Int
    7

fn TK_RPAREN() -> Int
    8

fn TK_IF() -> Int
    9

fn TK_ELSIF() -> Int
    10

fn TK_ELSE() -> Int
    11

fn TK_EQ() -> Int
    12

fn TK_COMMA() -> Int
    13

fn TK_PLUS() -> Int
    14

fn LEX_OK() -> Int
    0

fn LEX_ERR_TAB() -> Int
    2

fn LEX_ERR_STRING() -> Int
    2

method Lex.len() -> Int ! alloc
    self.kinds.len()

method Lex.kind(i: Int) -> Int ! alloc
    self.kinds.get(i)

method Lex.start(i: Int) -> Int ! alloc
    self.starts.get(i)

method Lex.end(i: Int) -> Int ! alloc
    self.ends.get(i)

method Lex.text(src: String, i: Int) -> String ! alloc
    src.slice(self.start(i), self.end(i))

method Lex.push(kind: Int, start: Int, end: Int) -> Int ! alloc
    self.kinds.push(kind)
    self.starts.push(start)
    _c = self.ends.push(end)
    0

fn lex_empty() -> Lex ! alloc
    Lex(LEX_OK(), List.new[Int](), List.new[Int](), List.new[Int]())

fn kw_kind(text: String) -> Int ! alloc
    if text.eq("if") == 1
        TK_IF()
    elsif text.eq("elsif") == 1
        TK_ELSIF()
    elsif text.eq("else") == 1
        TK_ELSE()
    else
        TK_IDENT()

fn indent_stack_new() -> List[Int] ! alloc
    st = List.new[Int]()
    st.push(0)
    st

fn indent_top_at(st: List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = st.get(i)
        if v < 0
            indent_top_at(st, i - 1)
        else
            v

fn indent_top(st: List[Int]) -> Int ! alloc
    n = st.len()
    indent_top_at(st, n - 1)

fn indent_push(st: List[Int], col: Int) -> Int ! alloc
    _p = st.push(col)
    0

fn indent_tombstone_at(st: List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = st.get(i)
        if v < 0
            indent_tombstone_at(st, i - 1)
        else
            _p = st.set(i, 0 - 1)
            0

fn indent_pop(st: List[Int]) -> Int ! alloc
    n = st.len()
    indent_tombstone_at(st, n - 1)

fn skip_line_comment(src: String, i: Int, n: Int) -> Int ! alloc
    _n = n
    src.skip(i, 4, 0)

fn count_spaces_or_tab(src: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        c = src.char(i)
        if c == 32
            1 + count_spaces_or_tab(src, i + 1, n)
        elsif c == 9
            0 - 1
        else
            0

fn string_close_end(src: String, open_quote: Int, n: Int) -> Int ! alloc
    end = src.skip(open_quote + 1, 7, 0)
    if end >= n
        0 - 1
    elsif src.char(end) == 34
        end + 1
    else
        0 - 1

fn dedent_to_col(out: Lex, st: List[Int], col: Int, pos: Int) -> Int ! alloc
    top = indent_top(st)
    if col < top
        indent_pop(st)
        out.push(TK_DEDENT(), pos, pos)
        dedent_to_col(out, st, col, pos)
    else
        0

fn lex_fail(err: List[Int]) -> Int ! alloc
    _s = err.set(0, 1)
    0

fn lex_emit_string(src: String, i: Int, n: Int, out: Lex, st: List[Int], kind: Int, err: List[Int]) -> Int ! alloc
    if kind == TK_DSTRING()
        end = string_close_end(src, i + 1, n)
        if end < 0
            lex_fail(err)
        else
            out.push(kind, i, end)
            lex_go(src, end, n, out, st, 0, err)
    else
        end = string_close_end(src, i, n)
        if end < 0
            lex_fail(err)
        else
            out.push(kind, i, end)
            lex_go(src, end, n, out, st, 0, err)

fn lex_go(src: String, i: Int, n: Int, out: Lex, st: List[Int], at_start: Int, err: List[Int]) -> Int ! alloc
    if err.get(0) == 1
        0
    elsif i >= n
        _d = dedent_to_col(out, st, 0, i)
        out.push(TK_EOF(), i, i)
        0
    else
        c = src.char(i)
        if c == 35
            j = skip_line_comment(src, i + 1, n)
            lex_go(src, j, n, out, st, at_start, err)
        elsif at_start == 1
            sp = count_spaces_or_tab(src, i, n)
            if sp < 0
                lex_fail(err)
            else
                j = i + sp
                if j >= n
                    lex_go(src, j, n, out, st, 1, err)
                else
                    cj = src.char(j)
                    if cj == 10
                        lex_go(src, j + 1, n, out, st, 1, err)
                    elsif cj == 35
                        j2 = skip_line_comment(src, j + 1, n)
                        lex_go(src, j2, n, out, st, 1, err)
                    else
                        top = indent_top(st)
                        if sp > top
                            indent_push(st, sp)
                            out.push(TK_INDENT(), i, j)
                            lex_go(src, j, n, out, st, 0, err)
                        else
                            _d = dedent_to_col(out, st, sp, i)
                            lex_go(src, j, n, out, st, 0, err)
        elsif c == 10
            out.push(TK_NL(), i, i + 1)
            lex_go(src, i + 1, n, out, st, 1, err)
        elsif c == 9
            lex_fail(err)
        elsif c == 34
            lex_emit_string(src, i, n, out, st, TK_STRING(), err)
        elsif c == 40
            out.push(TK_LPAREN(), i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 41
            out.push(TK_RPAREN(), i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 61
            out.push(TK_EQ(), i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 44
            out.push(TK_COMMA(), i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 43
            out.push(TK_PLUS(), i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif is_ident_start(c) == 1
            end = src.skip(i, 2, 0)
            text = src.slice(i, end)
            if text.eq("d") == 1
                if end < n
                    if src.char(end) == 34
                        lex_emit_string(src, end - 1, n, out, st, TK_DSTRING(), err)
                    else
                        kind = kw_kind(text)
                        out.push(kind, i, end)
                        lex_go(src, end, n, out, st, 0, err)
                else
                    kind = kw_kind(text)
                    out.push(kind, i, end)
                    lex_go(src, end, n, out, st, 0, err)
            else
                kind = kw_kind(text)
                out.push(kind, i, end)
                lex_go(src, end, n, out, st, 0, err)
        else
            j = src.skip(i, 8, 0)
            if j == i
                lex_go(src, i + 1, n, out, st, 0, err)
            else
                lex_go(src, j, n, out, st, 0, err)
        0

fn is_ident_start(c: Int) -> Int
    if c >= 65
        if c <= 90
            1
        elsif c >= 97
            if c <= 122
                1
            else
                0
        else
            0
    elsif c == 95
        1
    else
        0

fn lex(src: String) -> Lex ! alloc
    out = lex_empty()
    st = indent_stack_new()
    err = List.new[Int]()
    err.push(0)
    n = src.len()
    lex_go(src, 0, n, out, st, 1, err)
    if err.get(0) == 1
        Lex(LEX_ERR_TAB(), List.new[Int](), List.new[Int](), List.new[Int]())
    else
        Lex(LEX_OK(), out.kinds, out.starts, out.ends)
