# Lexer for standard: tokens carry byte spans into the original source.

struct Lex
    status: Int
    kinds: List[Int]
    starts: List[Int]
    ends: List[Int]

TK_EOF = 0

TK_NL = 1

TK_INDENT = 2

TK_DEDENT = 3

TK_IDENT = 4

TK_STRING = 5

TK_DSTRING = 6

TK_FSTRING = 15

TK_RSTRING = 16

TK_LPAREN = 7

TK_RPAREN = 8

TK_IF = 9

TK_ELSIF = 10

TK_ELSE = 11

TK_EQ = 12

TK_COMMA = 13

TK_PLUS = 14

LEX_OK = 0

LEX_ERR_TAB = 2

LEX_ERR_STRING = 2

method Lex.len(&self) -> Int ! alloc
    self.kinds.len()

method Lex.kind(&self, i: Int) -> Int ! alloc
    self.kinds.get(i)

method Lex.start(&self, i: Int) -> Int ! alloc
    self.starts.get(i)

method Lex.end(&self, i: Int) -> Int ! alloc
    self.ends.get(i)

method Lex.text(&self, src: &String, i: Int) -> String ! alloc
    src.slice(self.start(i), self.end(i))

method Lex.push(&mut self, kind: Int, start: Int, end: Int) -> Int ! alloc
    self.kinds.push(kind)
    self.starts.push(start)
    _c = self.ends.push(end)
    0

fn lex_empty() -> Lex ! alloc
    Lex(LEX_OK, List.new[Int](), List.new[Int](), List.new[Int]())

fn kw_kind(text: &String) -> Int ! alloc
    match text
        "if" => TK_IF
        "elsif" => TK_ELSIF
        "else" => TK_ELSE
        _ => TK_IDENT

fn indent_stack_new() -> List[Int] ! alloc
    st = List.new[Int]()
    st.push(0)
    st

fn indent_top_at(st: &List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = st.get(i)
        if v < 0
            indent_top_at(st, i - 1)
        else
            v

fn indent_top(st: &List[Int]) -> Int ! alloc
    n = st.len()
    indent_top_at(st, n - 1)

fn indent_push(st: &mut List[Int], col: Int) -> Int ! alloc
    _p = st.push(col)
    0

fn indent_tombstone_at(st: &mut List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = st.get(i)
        if v < 0
            indent_tombstone_at(st, i - 1)
        else
            _p = st.set(i, 0 - 1)
            0

fn indent_pop(st: &mut List[Int]) -> Int ! alloc
    n = st.len()
    indent_tombstone_at(st, n - 1)

fn skip_line_comment(src: &String, i: Int, n: Int) -> Int ! alloc
    _n = n
    src.skip(i, 4, 0)

fn count_spaces_or_tab(src: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        c = src.char(i)
        match c
            32 => 1 + count_spaces_or_tab(src, i + 1, n)
            9 => 0 - 1
            _ => 0

fn string_close_end(src: &String, open_quote: Int, n: Int) -> Int ! alloc
    end = src.skip(open_quote + 1, 7, 0)
    if end >= n
        0 - 1
    elsif src.char(end) == 34
        end + 1
    else
        0 - 1

fn dedent_to_col(out: &mut Lex, st: &mut List[Int], col: Int, pos: Int) -> Int ! alloc
    top = indent_top(st)
    if col < top
        indent_pop(st)
        out.push(TK_DEDENT, pos, pos)
        dedent_to_col(out, st, col, pos)
    else
        0

fn lex_fail(err: &mut List[Int]) -> Int ! alloc
    _s = err.set(0, 1)
    0

fn lex_emit_string(src: &String, i: Int, n: Int, out: &mut Lex, st: &mut List[Int], kind: Int, err: &mut List[Int]) -> Int ! alloc
    if kind == TK_DSTRING
        end = string_close_end(src, i + 1, n)
        if end < 0
            lex_fail(err)
        else
            out.push(kind, i, end)
            lex_go(src, end, n, out, st, 0, err)
    elsif kind == TK_FSTRING
        end = string_close_end(src, i + 1, n)
        if end < 0
            lex_fail(err)
        else
            out.push(kind, i, end)
            lex_go(src, end, n, out, st, 0, err)
    elsif kind == TK_RSTRING
        end = string_close_end(src, i + 1, n)
        if end < 0
            lex_fail(err)
        else
            out.push(kind, i, end)
            lex_go(src, end, n, out, st, 0, err)
    else
        end = string_close_end(src, i, n)
        if end < 0
            lex_fail(err)
        else
            out.push(kind, i, end)
            lex_go(src, end, n, out, st, 0, err)

fn lex_go(src: &String, i: Int, n: Int, out: &mut Lex, st: &mut List[Int], at_start: Int, err: &mut List[Int]) -> Int ! alloc
    if err.get(0) == 1
        0
    elsif i >= n
        _d = dedent_to_col(out, st, 0, i)
        out.push(TK_EOF, i, i)
        0
    else
        c = src.char(i)
        if c == 35
            j = skip_line_comment(src, i + 1, n)
            lex_go(src, j, n, out, st, at_start, err)
        elsif at_start == 1
            sp = count_spaces_or_tab(src, i, n)
            if sp < 0
                lex_fail(err)
            else
                j = i + sp
                if j >= n
                    lex_go(src, j, n, out, st, 1, err)
                else
                    cj = src.char(j)
                    if cj == 10
                        lex_go(src, j + 1, n, out, st, 1, err)
                    elsif cj == 35
                        j2 = skip_line_comment(src, j + 1, n)
                        lex_go(src, j2, n, out, st, 1, err)
                    else
                        top = indent_top(st)
                        if sp > top
                            indent_push(st, sp)
                            out.push(TK_INDENT, i, j)
                            lex_go(src, j, n, out, st, 0, err)
                        else
                            _d = dedent_to_col(out, st, sp, i)
                            lex_go(src, j, n, out, st, 0, err)
        elsif c == 10
            out.push(TK_NL, i, i + 1)
            lex_go(src, i + 1, n, out, st, 1, err)
        elsif c == 9
            lex_fail(err)
        elsif c == 34
            lex_emit_string(src, i, n, out, st, TK_STRING, err)
        elsif c == 40
            out.push(TK_LPAREN, i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 41
            out.push(TK_RPAREN, i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 61
            out.push(TK_EQ, i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 44
            out.push(TK_COMMA, i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif c == 43
            out.push(TK_PLUS, i, i + 1)
            lex_go(src, i + 1, n, out, st, 0, err)
        elsif is_ident_start(c) == 1
            end = src.skip(i, 2, 0)
            text = src.slice(i, end)
            if text.eq("d") == 1
                if end < n && src.char(end) == 34
                    lex_emit_string(src, end - 1, n, out, st, TK_DSTRING, err)
                else
                    kind = kw_kind(&text)
                    out.push(kind, i, end)
                    lex_go(src, end, n, out, st, 0, err)
            elsif text.eq("f") == 1
                if end < n && src.char(end) == 34
                    lex_emit_string(src, end - 1, n, out, st, TK_FSTRING, err)
                else
                    kind = kw_kind(&text)
                    out.push(kind, i, end)
                    lex_go(src, end, n, out, st, 0, err)
            elsif text.eq("r") == 1
                if end < n && src.char(end) == 34
                    lex_emit_string(src, end - 1, n, out, st, TK_RSTRING, err)
                else
                    kind = kw_kind(&text)
                    out.push(kind, i, end)
                    lex_go(src, end, n, out, st, 0, err)
            else
                kind = kw_kind(&text)
                out.push(kind, i, end)
                lex_go(src, end, n, out, st, 0, err)
        else
            j = src.skip(i, 8, 0)
            if j == i
                lex_go(src, i + 1, n, out, st, 0, err)
            else
                lex_go(src, j, n, out, st, 0, err)
        0

fn is_ident_start(c: Int) -> Int
    if c >= 65
        if c <= 90
            1
        elsif c >= 97
            if c <= 122
                1
            else
                0
        else
            0
    elsif c == 95
        1
    else
        0

fn lex(src: &String) -> Lex ! alloc
    out = lex_empty()
    st = indent_stack_new()
    err = List.new[Int]()
    err.push(0)
    n = src.len()
    lex_go(src, 0, n, &mut out, &mut st, 1, &mut err)
    if err.get(0) == 1
        Lex(LEX_ERR_TAB, List.new[Int](), List.new[Int](), List.new[Int]())
    else
        Lex(LEX_OK, out.kinds, out.starts, out.ends)
