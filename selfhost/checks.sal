# Semantic passes in the bootstrap's order: types, effects, ownership, devices.
import result
import infer
import effects
import attrs
import ownership
import device

# Ok(0), or Err(message) for the first violation in `prog`.
fn check_program(prog: Int) -> Int ! alloc
    check_program_with(prog, 0)

# `progs`: every program of the module graph (0 when single-file).
fn check_program_with(prog: Int, progs: Int) -> Int ! alloc
    ty = infer_program(prog)
    if result_is_err(ty) == 1
        ty
    else
        at = check_attrs(prog)
        if result_is_err(at) == 1
            at
        else
            fx = check_effects_with(prog, progs)
            if result_is_err(fx) == 1
                fx
            else
                own = check_ownership(prog)
                if result_is_err(own) == 1
                    own
                else
                    check_devices(prog)
