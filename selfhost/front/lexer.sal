# Lexer: tokens, indentation, and source scan.

fn TK_EOF() -> Int
    0

fn TK_NL() -> Int
    1

fn TK_INDENT() -> Int
    2

fn TK_DEDENT() -> Int
    3

fn TK_IDENT() -> Int
    4

fn TK_INT() -> Int
    5

fn TK_FLOAT() -> Int
    6

fn TK_STRING() -> Int
    7

fn TK_FN() -> Int
    8

fn TK_ON() -> Int
    9

fn TK_TO() -> Int
    10

fn TK_ARROW() -> Int
    11

fn TK_BANG() -> Int
    12

fn TK_LPAREN() -> Int
    13

fn TK_RPAREN() -> Int
    14

fn TK_LBRACK() -> Int
    15

fn TK_RBRACK() -> Int
    16

fn TK_COMMA() -> Int
    17

fn TK_COLON() -> Int
    18

fn TK_EQ() -> Int
    19

fn TK_PLUS() -> Int
    20

fn TK_MINUS() -> Int
    21

fn TK_STAR() -> Int
    22

fn TK_SLASH() -> Int
    23

fn TK_EQEQ() -> Int
    24

fn TK_NE() -> Int
    25

fn TK_LT() -> Int
    26

fn TK_LE() -> Int
    27

fn TK_GT() -> Int
    28

fn TK_GE() -> Int
    29

fn TK_IF() -> Int
    30

fn TK_ELSIF() -> Int
    35

fn TK_ELSE() -> Int
    31

fn TK_WHILE() -> Int
    32

fn TK_IMPORT() -> Int
    33

fn TK_DOT() -> Int
    34

fn TK_DSTRING() -> Int
    36

fn TK_FSTRING() -> Int
    59

fn TK_RSTRING() -> Int
    60

fn TK_STRUCT() -> Int
    37

fn TK_AT() -> Int
    38

fn TK_RETURN() -> Int
    39

fn TK_LET() -> Int
    40

fn TK_MATCH() -> Int
    41

fn TK_TRY() -> Int
    42

fn TK_TRUE() -> Int
    43

fn TK_FALSE() -> Int
    44

fn TK_ENUM() -> Int
    45

fn TK_FRAME() -> Int
    46

fn TK_KERNEL() -> Int
    47

fn TK_IN() -> Int
    48

fn TK_PERCENT() -> Int
    49

fn TK_AMP() -> Int
    50

fn TK_PIPE() -> Int
    51

fn TK_CARET() -> Int
    52

fn TK_SHL() -> Int
    53

fn TK_SHR() -> Int
    54

fn TK_FATARROW() -> Int
    55

fn TK_BREAK() -> Int
    56

fn TK_ANDAND() -> Int
    57

fn TK_OROR() -> Int
    58

fn TK_TICK() -> Int
    61

fn is_digit(c: Int) -> Int
    if c < 48
        0
    elsif c > 57
        0
    else
        1

fn is_alpha(c: Int) -> Int
    if c >= 65
        if c <= 90
            1
        elsif c >= 97
            if c <= 122
                1
            else
                0
        else
            0
    else
        0

fn is_ident_start(c: Int) -> Int
    if is_alpha(c) == 1 || c == 95
        1
    else
        0

fn is_ident_char(c: Int) -> Int
    if is_ident_start(c) == 1
        1
    else
        is_digit(c)

# Tokens as parallel lists: `kinds[i]`, `texts[i]`, `ivals[i]` describe token `i`.
struct Toks
    kinds: List[Int]
    texts: List[String]
    ivals: List[Int]
    # Byte offset of each token in the preprocessed source (see `lex_go`). `cur` is the offset the
    # lexer is at; it stays owned by this struct and is released when the caller drops `Toks`.
    offs: List[Int]
    cur: List[Int]

fn toks_new() -> Toks ! alloc
    cur = List.new[Int]()
    cur.push(0)
    Toks(List.new[Int](), List.new[String](), List.new[Int](), List.new[Int](), cur)

# Appends a token; the text is copied, so the caller keeps its own.
fn tok_push(out: &mut Toks, kind: Int, text: &String, ival: Int) -> Int ! alloc
    out.kinds.push(kind)
    out.texts.push(text.dup())
    out.ivals.push(ival)
    _d = out.offs.push(out.cur.get(0))
    0

fn kw_kind(text: &String) -> Int ! alloc
    match text
        "fn" => TK_FN()
        "on" => TK_ON()
        "to" => TK_TO()
        "if" => TK_IF()
        "elsif" => TK_ELSIF()
        "else" => TK_ELSE()
        "while" => TK_WHILE()
        "import" => TK_IMPORT()
        "struct" => TK_STRUCT()
        "return" => TK_RETURN()
        "let" => TK_LET()
        "match" => TK_MATCH()
        "try" => TK_TRY()
        "true" => TK_TRUE()
        "false" => TK_FALSE()
        "enum" => TK_ENUM()
        "frame" => TK_FRAME()
        "kernel" => TK_KERNEL()
        "in" => TK_IN()
        "break" => TK_BREAK()
        _ => TK_IDENT()

fn indent_stack_new() -> List[Int] ! alloc
    v = List.new[Int]()
    v.push(0 - 2)
    v.push(0)
    v

fn group_depth(st: &List[Int]) -> Int ! alloc
    v = st.get(0)
    0 - v - 2

fn group_set(st: &mut List[Int], d: Int) -> Int ! alloc
    _p = st.set(0, 0 - d - 2)
    0

fn group_enter(st: &mut List[Int]) -> Int ! alloc
    group_set(st, group_depth(st) + 1)

fn group_leave(st: &mut List[Int]) -> Int ! alloc
    d = group_depth(st)
    if d > 0
        group_set(st, d - 1)
    else
        0

fn indent_top_at(st: &List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = st.get(i)
        if v < 0
            indent_top_at(st, i - 1)
        else
            v

fn indent_top(st: &List[Int]) -> Int ! alloc
    n = st.len()
    indent_top_at(st, n - 1)

fn indent_push(st: &mut List[Int], col: Int) -> Int ! alloc
    _p = st.push(col)
    0

fn indent_tombstone_at(st: &mut List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = st.get(i)
        if v < 0
            indent_tombstone_at(st, i - 1)
        else
            _p = st.set(i, 0 - 1)
            0

fn indent_pop(st: &mut List[Int]) -> Int ! alloc
    n = st.len()
    _t = indent_tombstone_at(st, n - 1)
    0

fn count_live_indent(st: &List[Int], i: Int, acc: Int) -> Int ! alloc
    n = st.len()
    if i >= n
        acc
    else
        v = st.get(i)
        if v < 0
            count_live_indent(st, i + 1, acc)
        else
            count_live_indent(st, i + 1, acc + 1)

fn skip_line_comment(src: &String, i: Int, n: Int) -> Int ! alloc
    _n = n
    src.skip(i, 4, 0)

fn count_spaces(src: &String, i: Int, n: Int, acc: Int) -> Int ! alloc
    _n = n
    _a = acc
    end = src.skip(i, 1, 0)
    end - i

fn read_ident(src: &String, i: Int, n: Int) -> Int ! alloc
    _n = n
    src.skip(i, 2, 0)

fn read_digits(src: &String, i: Int, n: Int) -> Int ! alloc
    _n = n
    src.skip(i, 3, 0)

fn read_number(src: &String, i: Int, n: Int) -> Int ! alloc
    end = read_digits(src, i, n)
    if end < n && src.char(end) == 46
        read_digits(src, end + 1, n)
    else
        end

fn slice_has_dot(src: &String, i: Int, end: Int) -> Int ! alloc
    if i >= end
        0
    elsif src.char(i) == 46
        1
    else
        slice_has_dot(src, i + 1, end)

fn push_number_tok(out: &mut Toks, src: &String, i: Int, end: Int, neg: Int) -> Int ! alloc
    if slice_has_dot(src, i, end) == 1
        txt = src.slice(i, end)
        if neg == 1
            ntxt = "-" + txt
            free(txt)
            bits = str_to_f64_bits(&ntxt)
            _p = tok_push(out, TK_FLOAT(), &ntxt, bits)
            free(ntxt)
            _q = 0
        else
            bits = str_to_f64_bits(&txt)
            _p = tok_push(out, TK_FLOAT(), &txt, bits)
    else
        ival = parse_int_digits(src, i, end, 0)
        if neg == 1
            ival = 0 - ival
            _p = tok_push(out, TK_INT(), &"", ival)
        else
            _p = tok_push(out, TK_INT(), &"", ival)
    0

fn parse_int_digits(src: &String, i: Int, end: Int, acc: Int) -> Int ! alloc
    if i >= end
        acc
    else
        c = src.char(i)
        parse_int_digits(src, i + 1, end, acc * 10 + (c - 48))

fn unescape_char(e: Int) -> Int ! alloc
    match e
        110 => 10
        116 => 9
        114 => 13
        _ => e

fn read_string_chars(src: &String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = src.char(i)
        if c == 34
            acc
        elsif c == 92
            if i + 1 >= n
                acc
            else
                e = src.char(i + 1)
                ch = unescape_char(e)
                piece = String.from_char(ch)
                read_string_chars(src, i + 2, n, acc + piece)
        else
            piece = String.from_char(c)
            read_string_chars(src, i + 1, n, acc + piece)

fn string_end(src: &String, i: Int, n: Int) -> Int ! alloc
    _n = n
    src.skip(i, 7, 0)

# `##{` in an f-string becomes the literal `#{`.
fn f_unescape_hash_lit(s: &String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = s.char(i)
        if c == 35 && i + 1 < n && s.char(i + 1) == 35
            if i + 2 < n && s.char(i + 2) == 123
                acc2 = acc + "#" + String.from_char(123)
                f_unescape_hash_lit(s, i + 3, n, acc2)
            else
                piece = String.from_char(35)
                acc2 = acc + piece
                free(piece)
                f_unescape_hash_lit(s, i + 1, n, acc2)
        else
            piece = String.from_char(c)
            acc2 = acc + piece
            free(piece)
            f_unescape_hash_lit(s, i + 1, n, acc2)

fn dedent_to_col(out: &mut Toks, st: &mut List[Int], col: Int) -> Int ! alloc
    top = indent_top(st)
    if col < top
        indent_pop(st)
        tok_push(out, TK_DEDENT(), &"", 0)
        dedent_to_col(out, st, col)
    else
        0

# Every step records its offset first, so a token pushed by a step starts at that offset.
fn lex_go(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], at_start: Int) -> Int ! alloc
    out.cur.set(0, i)
    lex_step(src, i, n, out, st, at_start)

fn lex_step(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], at_start: Int) -> Int ! alloc
    if i >= n
        dedent_to_col(out, st, 0)
        _p = tok_push(out, TK_EOF(), &"", 0)
        0
    else
        c = src.char(i)
        if c == 35
            j = skip_line_comment(src, i + 1, n)
            lex_go(src, j, n, out, st, at_start)
        elsif at_start == 1
            sp = count_spaces(src, i, n, 0)
            j = i + sp
            if j < n
                cj = src.char(j)
                if cj == 9
                    sp = sp + 4
                    j = j + 1
                else
                    sp = sp
            else
                sp = sp
            if j >= n
                lex_go(src, j, n, out, st, 1)
            else
                cj = src.char(j)
                if cj == 10
                    lex_go(src, j + 1, n, out, st, 1)
                elsif cj == 35
                    j2 = skip_line_comment(src, j + 1, n)
                    if j2 < n
                        c3 = src.char(j2)
                        if c3 == 10
                            lex_go(src, j2 + 1, n, out, st, 1)
                        else
                            lex_go(src, j2, n, out, st, 1)
                    else
                        lex_go(src, j2, n, out, st, 1)
                else
                    top = indent_top(st)
                    if sp > top
                        _p = indent_push(st, sp)
                        _p = tok_push(out, TK_INDENT(), &"", 0)
                        lex_go(src, j, n, out, st, 0)
                    else
                        dedent_to_col(out, st, sp)
                        lex_go(src, j, n, out, st, 0)
        elsif c == 10
            _p = tok_push(out, TK_NL(), &"", 0)
            if group_depth(st) > 0
                lex_go(src, i + 1, n, out, st, 0)
            else
                lex_go(src, i + 1, n, out, st, 1)
        else
            j = src.skip(i, 8, 0)
            if j == i
                lex_tok(src, i, n, out, st)
            else
                lex_go(src, j, n, out, st, 0)

fn lex_tok(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int]) -> Int ! alloc
    c = src.char(i)
    if c == 45 && i + 1 < n
        c2 = src.char(i + 1)
        if c2 == 62
            tok_push(out, TK_ARROW(), &"", 0)
            lex_go(src, i + 2, n, out, st, 0)
        else
            lex_tok_rest(src, i, n, out, st, c)
    else
        lex_tok_rest(src, i, n, out, st, c)

fn lex_tok_rest(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], c: Int) -> Int ! alloc
    if c == 40
        _p = tok_push(out, TK_LPAREN(), &"", 0)
        _g = group_enter(st)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 41
        _p = tok_push(out, TK_RPAREN(), &"", 0)
        _g = group_leave(st)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 91
        _p = tok_push(out, TK_LBRACK(), &"", 0)
        _g = group_enter(st)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 93
        _p = tok_push(out, TK_RBRACK(), &"", 0)
        _g = group_leave(st)
        lex_go(src, i + 1, n, out, st, 0)
    else
        lex_tok_rest2(src, i, n, out, st, c)

fn lex_tok_rest2(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], c: Int) -> Int ! alloc
    if c == 44
        _p = tok_push(out, TK_COMMA(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 58
        _p = tok_push(out, TK_COLON(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 61
        if i + 1 < n
            if src.char(i + 1) == 62
                lex_simple(src, i, n, out, st, TK_FATARROW(), 2)
            else
                lex_pair(src, i, n, out, st, 61, TK_EQ(), TK_EQEQ())
        else
            lex_simple(src, i, n, out, st, TK_EQ(), 1)
    else
        lex_tok_rest3(src, i, n, out, st, c)

fn lex_tok_rest3(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], c: Int) -> Int ! alloc
    if c == 33
        if i + 1 < n
            c2 = src.char(i + 1)
            if c2 == 61
                _p = tok_push(out, TK_NE(), &"", 0)
                lex_go(src, i + 2, n, out, st, 0)
            else
                _p = tok_push(out, TK_BANG(), &"", 0)
                lex_go(src, i + 1, n, out, st, 0)
        else
            _p = tok_push(out, TK_BANG(), &"", 0)
            lex_go(src, i + 1, n, out, st, 0)
    elsif c == 60
        if i + 1 < n
            if src.char(i + 1) == 60
                lex_simple(src, i, n, out, st, TK_SHL(), 2)
            else
                lex_pair(src, i, n, out, st, 61, TK_LT(), TK_LE())
        else
            lex_simple(src, i, n, out, st, TK_LT(), 1)
    else
        lex_tok_rest4(src, i, n, out, st, c)

fn lex_tok_rest4(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], c: Int) -> Int ! alloc
    if c == 62
        if i + 1 < n
            if src.char(i + 1) == 62
                lex_simple(src, i, n, out, st, TK_SHR(), 2)
            else
                lex_pair(src, i, n, out, st, 61, TK_GT(), TK_GE())
        else
            lex_simple(src, i, n, out, st, TK_GT(), 1)
    elsif c == 43
        _p = tok_push(out, TK_PLUS(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 42
        _p = tok_push(out, TK_STAR(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 47
        _p = tok_push(out, TK_SLASH(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    else
        lex_tok_rest5(src, i, n, out, st, c)

fn lex_simple(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], kind: Int, width: Int) -> Int ! alloc
    tok_push(out, kind, &"", 0)
    lex_go(src, i + width, n, out, st, 0)

# Operator that is `kind1` alone or `kind2` when followed by `next`.
fn lex_pair(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], next: Int, kind1: Int, kind2: Int) -> Int ! alloc
    if i + 1 < n
        if src.char(i + 1) == next
            lex_simple(src, i, n, out, st, kind2, 2)
        else
            lex_simple(src, i, n, out, st, kind1, 1)
    else
        lex_simple(src, i, n, out, st, kind1, 1)

# `##{` is literal; `#{name}` needs an identifier. Anything else is invalid (0).
fn f_interp_ok(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    else
        c = s.char(i)
        if c == 35
            if i + 1 < n
                if s.char(i + 1) == 35
                    if i + 2 < n && s.char(i + 2) == 123
                        f_interp_ok(s, i + 3, n)
                    else
                        f_interp_ok(s, i + 2, n)
                elsif s.char(i + 1) == 123
                    f_interp_name(s, i + 2, n)
                else
                    f_interp_ok(s, i + 1, n)
            else
                f_interp_ok(s, i + 1, n)
        else
            f_interp_ok(s, i + 1, n)

# 1 when the text has `#{name}` (not `##{`).
fn f_has_interp(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        c = s.char(i)
        if c == 35 && i + 1 < n
            if s.char(i + 1) == 35
                if i + 2 < n && s.char(i + 2) == 123
                    f_has_interp(s, i + 3, n)
                else
                    f_has_interp(s, i + 2, n)
            elsif s.char(i + 1) == 123
                1
            else
                f_has_interp(s, i + 1, n)
        else
            f_has_interp(s, i + 1, n)

fn f_interp_name(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif is_ident_start(s.char(i)) == 0
        0
    else
        f_interp_name_rest(s, i + 1, n)

fn f_interp_name_rest(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        c = s.char(i)
        if c == 125
            f_interp_ok(s, i + 1, n)
        elsif is_ident_char(c) == 1
            f_interp_name_rest(s, i + 1, n)
        else
            0

fn lex_quoted(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], kind: Int) -> Int ! alloc
    raw = ""
    raw2 = read_string_chars(src, i + 1, n, raw)
    end = string_end(src, i + 1, n)
    nraw = raw2.len()
    empty = ""
    if kind == TK_FSTRING()
        bad = 1 - f_interp_ok(&raw2, 0, nraw)
        # ival: 1 invalid, 2 interpolated (text stays raw), 0 plain f-string.
        ival = if bad == 1
            1
        elsif f_has_interp(&raw2, 0, nraw) == 1
            2
        else
            0
        if ival == 2
            _p = tok_push(out, kind, &raw2, ival)
        else
            un = f_unescape_hash_lit(&raw2, 0, nraw, empty)
            _p = tok_push(out, kind, &un, ival)
    else
        _p = tok_push(out, kind, &raw2, 0)
    j = end
    if end < n
        j = end + 1
    else
        j = end
    lex_go(src, j, n, out, st, 0)

fn lex_tok_rest5(src: &String, i: Int, n: Int, out: &mut Toks, st: &mut List[Int], c: Int) -> Int ! alloc
    if c == 34
        lex_quoted(src, i, n, out, st, TK_STRING())
    elsif is_digit(c) == 1
        end = read_number(src, i, n)
        push_number_tok(out, src, i, end, 0)
        lex_go(src, end, n, out, st, 0)
    elsif c == 45
        lex_simple(src, i, n, out, st, TK_MINUS(), 1)
    elsif c == 46
        _p = tok_push(out, TK_DOT(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 37
        lex_simple(src, i, n, out, st, TK_PERCENT(), 1)
    elsif c == 38
        lex_pair(src, i, n, out, st, 38, TK_AMP(), TK_ANDAND())
    elsif c == 124
        lex_pair(src, i, n, out, st, 124, TK_PIPE(), TK_OROR())
    elsif c == 94
        lex_simple(src, i, n, out, st, TK_CARET(), 1)
    elsif c == 64
        _p = tok_push(out, TK_AT(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 39
        _p = tok_push(out, TK_TICK(), &"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif is_ident_start(c) == 1
        end = read_ident(src, i, n)
        text = src.slice(i, end)
        if text.eq("d") == 1
            if end < n && src.char(end) == 34
                free(text)
                lex_quoted(src, end, n, out, st, TK_DSTRING())
            else
                kind = kw_kind(&text)
                _p = tok_push(out, kind, &text, 0)
                lex_go(src, end, n, out, st, 0)
        elsif text.eq("f") == 1
            if end < n && src.char(end) == 34
                free(text)
                lex_quoted(src, end, n, out, st, TK_FSTRING())
            else
                kind = kw_kind(&text)
                _p = tok_push(out, kind, &text, 0)
                lex_go(src, end, n, out, st, 0)
        elsif text.eq("r") == 1
            if end < n && src.char(end) == 34
                free(text)
                lex_quoted(src, end, n, out, st, TK_RSTRING())
            else
                kind = kw_kind(&text)
                _p = tok_push(out, kind, &text, 0)
                lex_go(src, end, n, out, st, 0)
        else
            kind = kw_kind(&text)
            _p = tok_push(out, kind, &text, 0)
            lex_go(src, end, n, out, st, 0)
    else
        lex_go(src, i + 1, n, out, st, 0)

fn lex(src: &String) -> Toks ! alloc
    out = toks_new()
    st = indent_stack_new()
    lex_go(src, 0, src.len(), &mut out, &mut st, 1)
    list_free(st)
    out

fn preprocess_scan(src: &String, i: Int, n: Int, limit: Int) -> Int ! alloc
    if i >= n
        n
    else
        src.skip(i, 5, limit)

fn preprocess_scan_str(src: &String, i: Int, n: Int, limit: Int) -> Int ! alloc
    if i >= n
        n
    else
        src.skip(i, 6, limit)

fn preprocess_go(src: &String, i: Int, n: Int, acc: String, in_str: Int) -> String ! alloc
    if i >= n
        acc
    elsif in_str == 1
        j = preprocess_scan_str(src, i, n, 256)
        if j >= n
            piece = src.slice(i, n)
            acc + piece
        elsif src.char(j) == 34
            piece = src.slice(i, j + 1)
            acc2 = acc + piece
            preprocess_go(src, j + 1, n, acc2, 0)
        else
            piece = src.slice(i, j)
            acc2 = acc + piece
            preprocess_go(src, j, n, acc2, 1)
    else
        j = preprocess_scan(src, i, n, 256)
        if j > i
            piece = src.slice(i, j)
            acc2 = acc + piece
            preprocess_go(src, j, n, acc2, 0)
        else
            c = src.char(i)
            if c == 34
                piece = String.from_char(c)
                acc2 = acc + piece
                preprocess_go(src, i + 1, n, acc2, 1)
            elsif c == 63 && preprocess_qdyn_ok(src, i) == 1
                acc2 = acc + "QDYN"
                preprocess_go(src, i + 1, n, acc2, 0)
            else
                piece = String.from_char(c)
                acc2 = acc + piece
                preprocess_go(src, i + 1, n, acc2, 0)

fn preprocess_qdyn_ok(src: &String, i: Int) -> Int ! alloc
    if i == 0
        1
    else
        prev = src.char(i - 1)
        1 - is_ident_char(prev)

fn preprocess(src: &String) -> String ! alloc
    n = src.len()
    acc = ""
    with_prelude_enums(preprocess_go(src, 0, n, acc, 0))

# `Option` / `Result` are part of the language: append the standard enums when
# a program uses them without declaring them.
fn with_prelude_enums(src: String) -> String ! alloc
    r = if src.contains("Result[") == 1 && src.contains("enum Result") == 0
        "\nenum Result[T, E]\n    Ok(T)\n    Err(E)\n"
    else
        ""
    o = if src.contains("Option[") == 1 && src.contains("enum Option") == 0
        "\nenum Option[T]\n    None\n    Some(T)\n"
    else
        ""
    if r.len() + o.len() == 0
        src
    else
        src + "\n" + r + o

fn find_char(s: &String, ch: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif s.char(i) == ch
        i
    else
        find_char(s, ch, i + 1, n)
