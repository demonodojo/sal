# Parser. Lists and operators grow to the left; 1 - 2 - 3 is (1 - 2) - 3.
import "../pkg/result.sal"
import lexer
import "../ast/tast.sal"
import loops
import "../sem/methods.sal"
import "../sem/protocols.sal"

# Parser state: the token lists plus `st = [index, has_err, group depth, last statement id]` and `msg = [error text]`.
# The lists are shared by every copy of the struct, so `list_set` on them is the mutation.
struct Parser
    kinds: List[Int]
    texts: List[String]
    ivals: List[Int]
    st: List[Int]
    msg: List[String]
    # Slot 0: the message of the `@deprecated("…")` read for the item being parsed ("" when none).
    dep: List[String]
    # Byte offset of each token (`Toks.offs`): the position of a call is its callee's name token.
    offs: List[Int]
    # Byte offset of each identifier written in a type text, in parse order (see `TFn.tyat`); a
    # synthetic type (`self`, a default `Int`) records 0.
    tyat: List[Int]

fn parser_new(toks: &Toks) -> Parser ! alloc
    st = List.new[Int]()
    st.push(0)
    _b = list_push(&st, 0)
    _c = list_push(&st, 0)
    _n = list_push(&st, 0)
    _o = list_push(&st, 0)
    msg = list_new[String]()
    _d = list_push(&msg, "")
    dep = list_new[String]()
    _e = list_push(&dep, "")
    Parser(toks.kinds, toks.texts, toks.ivals, st, msg, dep, toks.offs, list_new[Int]())

# The local `Parser` is dropped at the end of its scope, which releases these
# lists. Freeing them here as well is a double free.
fn parser_free(pr: &Parser) -> Int ! alloc
    0

fn p_set_err(pr: &Parser, msg: String) -> Int ! alloc
    _a = list_set(pr.st, 1, 1)
    _b = list_set(pr.msg, 0, msg)
    0

fn p_has_err(pr: &Parser) -> Int ! alloc
    list_get(&pr.st, 1)

fn p_err_msg(pr: &Parser) -> String ! alloc
    list_get(&pr.msg, 0)

# A fresh statement id (never 0, which stands for a statement a pass creates).
fn p_next_id(pr: &Parser) -> Int ! alloc
    n = list_get(&pr.st, 3) + 1
    _s = list_set(pr.st, 3, n)
    n

fn p_idx(pr: &Parser) -> Int ! alloc
    list_get(&pr.st, 0)

fn p_set_idx(pr: &Parser, i: Int) -> Int ! alloc
    _s = list_set(pr.st, 0, i)
    0

# A token is its index; past the end every token reads as end of file.
fn tok_kind(pr: &Parser, t: Int) -> Int ! alloc
    if t >= list_len(&pr.kinds)
        TK_EOF()
    else
        list_get(&pr.kinds, t)

fn tok_text(pr: &Parser, t: Int) -> String ! alloc
    if t >= list_len(&pr.texts)
        ""
    else
        list_get(&pr.texts, t)

fn tok_ival(pr: &Parser, t: Int) -> Int ! alloc
    if t >= list_len(&pr.ivals)
        0
    else
        list_get(&pr.ivals, t)

# The byte offset of the token just before the cursor: the name of a call whose `(` is next.
fn call_pos(pr: &Parser) -> Int ! alloc
    i = p_idx(pr) - 1
    if i < 0
        0
    else
        list_get(&pr.offs, i)

fn p_peek(pr: &Parser) -> Int ! alloc
    p_idx(pr)

fn p_advance(pr: &Parser) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_EOF()
        t
    else
        _s = p_set_idx(pr, t + 1)
        t

fn p_skip_nls(pr: &Parser) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_NL()
        _a = p_advance(pr)
        p_skip_nls(pr)
    else
        0

fn p_group(pr: &Parser) -> Int ! alloc
    list_get(&pr.st, 2)

fn p_set_group(pr: &Parser, d: Int) -> Int ! alloc
    _s = list_set(pr.st, 2, d)
    0

fn p_enter_group(pr: &Parser) -> Int ! alloc
    p_set_group(pr, p_group(pr) + 1)

fn p_leave_group(pr: &Parser) -> Int ! alloc
    d = p_group(pr)
    if d > 0
        p_set_group(pr, d - 1)
    else
        0

fn p_skip_group_nls(pr: &Parser) -> Int ! alloc
    if p_group(pr) > 0
        p_skip_nls(pr)
    else
        0

fn p_accept(pr: &Parser, k: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) == k
        _a = p_advance(pr)
        1
    else
        0

fn at_block_end(pr: &Parser) -> Int ! alloc
    k = tok_kind(pr, p_peek(pr))
    if k == TK_DEDENT()
        1
    elsif k == TK_EOF()
        1
    elsif k == TK_FN()
        1
    elsif k == TK_ELSE()
        1
    elsif k == TK_ELSIF()
        1
    else
        0

# ---- type text / expr parsing ----
fn parse_type_text_go(pr: &Parser, depth: Int, acc: String) -> String ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_EOF()
        acc
    elsif depth != 0
        parse_type_text_cont(pr, depth, acc, t, k)
    elsif k == TK_NL()
        acc
    elsif k == TK_BANG()
        acc
    elsif k == TK_INDENT()
        acc
    elsif k == TK_DEDENT()
        acc
    elsif k == TK_EQ()
        acc
    elsif k == TK_COMMA()
        acc
    elsif k == TK_RPAREN()
        acc
    else
        parse_type_text_cont(pr, depth, acc, t, k)

# `borrow` / `take` after a parameter type are its mode, not part of the type text.
fn parse_type_text_ident(pr: &Parser, depth: Int, acc: String, t: Int) -> String ! alloc
    tx = tok_text(pr, t)
    if depth == 0
        if type_text_is_mode(&tx) == 1
            acc
        else
            parse_type_text_word(pr, depth, acc, &tx)
    else
        parse_type_text_word(pr, depth, acc, &tx)

fn type_text_is_mode(tx: &String) -> Int ! alloc
    if str_eq(tx, "borrow") == 1
        1
    elsif str_eq(tx, "keep") == 1
        1
    else
        str_eq(tx, "take")

# `alias.Nombre` in a type: the qualifier and the name stay together (`one.Pt`).
fn parse_type_text_dot(pr: &Parser, depth: Int, acc: String) -> String ! alloc
    _a = p_advance(pr)
    t = p_peek(pr)
    if tok_kind(pr, t) != TK_IDENT()
        acc
    else
        tx = tok_text(pr, t)
        # The name after a qualifier is placed at the qualifier, as the bootstrap reports it.
        _r = list_push(&pr.tyat, list_get(&pr.offs, p_idx(pr) - 2))
        _b = p_advance(pr)
        base = if str_len(acc) > 0
            str_slice(acc, 0, str_len(acc) - 1)
        else
            ""
        parse_type_text_go(pr, depth, (base + "." + tx + " "))

# The offsets recorded since `start`, as "o1,o2,...": the types of one item.
fn tyat_since(pr: &Parser, start: Int) -> String ! alloc
    tyat_join(&pr.tyat, start, list_len(&pr.tyat), "")

fn tyat_join(src: &List[Int], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        tyat_join(src, i + 1, n, (acc + int_to_str(list_get(src, i)) + ","))

# The offset of the token at the cursor, recorded for a word of a type text. A word that is followed
# by `.` is a qualifier: it is not recorded (the name after the dot is).
fn tyat_note_here(pr: &Parser) -> Int ! alloc
    _n = list_push(&pr.tyat, list_get(&pr.offs, p_idx(pr)))
    0

fn parse_type_text_word(pr: &Parser, depth: Int, acc: String, tx: &String) -> String ! alloc
    if tok_kind(pr, p_peek(pr) + 1) != TK_DOT()
        _r = tyat_note_here(pr)
    _a = p_advance(pr)
    acc2 = acc + tx
    sp = " "
    acc3 = acc2 + sp
    free(sp)
    parse_type_text_go(pr, depth, acc3)

fn parse_type_text_cont(pr: &Parser, depth: Int, acc: String, t: Int, k: Int) -> String ! alloc
    if k == TK_NL()
        _a = p_advance(pr)
        parse_type_text_go(pr, depth, acc)
    elsif k == TK_IDENT()
        parse_type_text_ident(pr, depth, acc, t)
    elsif k == TK_DOT()
        parse_type_text_dot(pr, depth, acc)
    elsif k == TK_ON()
        _r = tyat_note_here(pr)
        _a = p_advance(pr)
        piece = "on "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_TO()
        _r = tyat_note_here(pr)
        _a = p_advance(pr)
        piece = "to "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_FN()
        _r = tyat_note_here(pr)
        _a = p_advance(pr)
        piece = "fn "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_INT()
        _a = p_advance(pr)
        vs = int_to_str(tok_ival(pr, t))
        acc2 = acc + vs
        free(vs)
        sp = " "
        acc3 = acc2 + sp
        free(sp)
        parse_type_text_go(pr, depth, acc3)
    elsif k == TK_LBRACK()
        _a = p_advance(pr)
        piece = "["
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth + 1, acc2)
    elsif k == TK_RBRACK()
        _a = p_advance(pr)
        piece = "]"
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth - 1, acc2)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        piece = ","
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_AMP()
        _a = p_advance(pr)
        piece = "&"
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_TICK()
        parse_type_text_tick(pr, depth, acc)
    else
        acc

# `'a` in a type: the tick and the name stay one word, and the name is not a type to resolve.
fn parse_type_text_tick(pr: &Parser, depth: Int, acc: String) -> String ! alloc
    _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) != TK_IDENT()
        acc
    else
        tx = tok_text(pr, nt)
        _b = p_advance(pr)
        piece = "'" + tx + " "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)

fn parse_type_text(pr: &Parser) -> String ! alloc
    acc = ""
    r = parse_type_text_go(pr, 0, acc)
    if str_len(r) == 0
        free(r)
        "Int"
    else
        r

fn binop_prec(k: Int) -> Int
    if k == TK_OROR()
        1
    elsif k == TK_ANDAND()
        2
    elsif k == TK_EQEQ()
        3
    elsif k == TK_NE()
        3
    elsif k == TK_LT()
        3
    elsif k == TK_LE()
        3
    elsif k == TK_GT()
        3
    elsif k == TK_GE()
        3
    elsif k == TK_PIPE()
        4
    elsif k == TK_CARET()
        5
    elsif k == TK_AMP()
        6
    elsif k == TK_SHL()
        7
    elsif k == TK_SHR()
        7
    elsif k == TK_PLUS()
        8
    elsif k == TK_MINUS()
        8
    elsif k == TK_STAR()
        9
    elsif k == TK_SLASH()
        9
    elsif k == TK_PERCENT()
        9
    else
        0

fn binop_name(k: Int) -> String ! alloc
    if k == TK_EQEQ()
        "eq"
    elsif k == TK_NE()
        "ne"
    elsif k == TK_LT()
        "lt"
    elsif k == TK_LE()
        "le"
    elsif k == TK_GT()
        "gt"
    elsif k == TK_GE()
        "ge"
    elsif k == TK_PIPE()
        "bor"
    elsif k == TK_CARET()
        "bxor"
    elsif k == TK_AMP()
        "band"
    elsif k == TK_SHL()
        "shl"
    elsif k == TK_SHR()
        "shr"
    elsif k == TK_PLUS()
        "add"
    elsif k == TK_MINUS()
        "sub"
    elsif k == TK_STAR()
        "mul"
    elsif k == TK_SLASH()
        "div"
    elsif k == TK_PERCENT()
        "mod"
    elsif k == TK_ANDAND()
        "and"
    elsif k == TK_OROR()
        "or"
    else
        "add"

# expr -> "try" expr | lambda
# The text of token `t`, copied: the token lists are freed with the parser.
fn tok_own(pr: &Parser, t: Int) -> String ! alloc
    strdup(tok_text(pr, t))

fn empty_block() -> TBlock ! alloc
    TBlock(list_new[TStmt](), XNone)

fn expr_is_none(e: &Expr) -> Int ! alloc
    match e
        XNone => 1
        _ => 0

# The name of an identifier expression, empty for any other.
fn ident_of(e: &Expr) -> String ! alloc
    match e
        XIdent(s) => strdup(s)
        _ => ""

# 1 identifier, 3 field access, 0 anything else: what `lvalue = expr` can assign to.
fn assign_kind(e: &Expr) -> Int ! alloc
    match e
        XIdent(s) => 1
        XField(b, f) => 3
        _ => 0

fn parse_expr(pr: &Parser) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_TRY()
        _a = p_advance(pr)
        XTry(parse_expr(pr))
    else
        parse_lambda(pr)

# lambda -> cmp "=>" expr | cmp
fn parse_lambda(pr: &Parser) -> Expr ! alloc
    left = parse_binary(pr, 0)
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_FATARROW()
        _a = p_advance(pr)
        nm = ident_of(&left)
        if str_len(nm) > 0
            XLambda(nm, parse_expr(pr))
        else
            _e = p_set_err(pr, "parse error: lambda parameter must be an identifier")
            left
    else
        left

# unary -> "-" unary | "!" unary | "to" place unary | postfix
fn parse_unary(pr: &Parser) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_MINUS()
        _a = p_advance(pr)
        XUnary("neg", parse_unary(pr))
    elsif k == TK_BANG()
        _a = p_advance(pr)
        XUnary("not", parse_unary(pr))
    elsif k == TK_TO()
        _a = p_advance(pr)
        pl = p_advance(pr)
        place = or_place(&tok_own(pr, pl), &"cpu")
        inner = parse_unary(pr)
        XTo(place, inner)
    elsif k == TK_AMP()
        parse_unary_ref(pr)
    elsif k == TK_STAR()
        _a = p_advance(pr)
        XUnary("deref", parse_unary(pr))
    else
        parse_postfix(pr)

# `&x` or `&mut x`. `mut` is only the word after `&`, not a keyword.
fn parse_unary_ref(pr: &Parser) -> Expr ! alloc
    _a = p_advance(pr)
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_IDENT()
        if str_eq(tok_text(pr, t), "mut") == 1
            _b = p_advance(pr)
            XUnary("refmut", parse_unary(pr))
        else
            XUnary("ref", parse_unary(pr))
    else
        XUnary("ref", parse_unary(pr))

fn qualified_name(q: &String, fld: &String) -> String ! alloc
    if str_len(q) == 0
        ""
    else
        q + "." + fld

fn call_name_from_expr(e: &Expr) -> String ! alloc
    match e
        XIdent(s) => strdup(s)
        XField(base, fld) => qualified_name(&ident_of(&base), &fld)
        _ => ""

fn parse_postfix_go(pr: &Parser, e: Expr) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_DOT()
        _d = p_advance(pr)
        if tok_kind(pr, p_peek(pr)) == TK_IDENT()
            t = p_advance(pr)
            parse_postfix_member(pr, e, &tok_own(pr, t))
        else
            e
    elsif tok_kind(pr, p_peek(pr)) == TK_LPAREN()
        nm = call_name_from_expr(&e)
        if str_len(nm) > 0
            xp = call_pos(pr)
            _a = p_advance(pr)
            _g = p_enter_group(pr)
            args = parse_arg_list(pr, list_new[Expr]())
            _h = p_leave_group(pr)
            parse_postfix_go(pr, XCall(nm, args, "", xp))
        else
            e
    else
        e

# After `e.name`: a method call (with optional type arguments, `List.new[Int]()`) or a field.
fn parse_postfix_member(pr: &Parser, e: Expr, fld: &String) -> Expr ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        text = parse_type_text_go(pr, 1, "")
        parse_method_call(pr, e, fld, &trim_closing_bracket(&text))
    elsif tok_kind(pr, p_peek(pr)) == TK_LPAREN()
        parse_method_call(pr, e, fld, &"")
    else
        parse_postfix_go(pr, XField(e, fld.dup()))

# `base.fld(args)`. On a bare identifier it is `base.fld` as a qualified call (a module member, a
# static call `T.new(..)` or a method of the local `base`: `methods.sal` tells them apart); on any
# other receiver it is `.fld` with the receiver as first argument.
fn parse_method_call(pr: &Parser, base: Expr, fld: &String, targs: &String) -> Expr ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_LPAREN()
        _e = p_set_err(pr, "parse error: expected ( after the type arguments")
        base
    else
        # A dotted call is placed at its `(`, as the bootstrap reports it.
        xp = list_get(&pr.offs, p_idx(pr))
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        args = list_new[Expr]()
        nm = parse_method_target(base, fld, &args)
        args = parse_arg_list(pr, args)
        _h = p_leave_group(pr)
        parse_postfix_go(pr, XCall(nm, args, targs + "@" + int_to_str(p_note_dot(pr)), xp))

# Counts a dotted call or a method definition (see `prepare_methods`); returns a fresh id for the call.
fn p_note_dot(pr: &Parser) -> Int ! alloc
    _a = list_set(pr.st, 4, list_get(&pr.st, 4) + 1)
    p_next_id(pr)

# The call name for `base.fld`; a receiver that is not a bare identifier goes first in `args`.
fn parse_method_target(base: Expr, fld: &String, args: &List[Expr]) -> String ! alloc
    match base
        XIdent(q) => qualified_name(&strdup(q), fld)
        _ => parse_method_target_expr(base, fld, args)

fn parse_method_target_expr(base: Expr, fld: &String, args: &List[Expr]) -> String ! alloc
    _a = list_push(args, base)
    "." + fld

fn parse_postfix(pr: &Parser) -> Expr ! alloc
    parse_postfix_go(pr, parse_primary(pr))

fn parse_binary(pr: &Parser, min_prec: Int) -> Expr ! alloc
    left = parse_unary(pr)
    parse_binary_loop(pr, min_prec, left)

fn parse_binary_loop(pr: &Parser, min_prec: Int, left: Expr) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    t = p_peek(pr)
    k = tok_kind(pr, t)
    prec = binop_prec(k)
    if prec == 0
        left
    elsif prec < min_prec
        left
    else
        _a = p_advance(pr)
        op = binop_name(k)
        right = parse_binary(pr, prec + 1)
        nleft = XBin(op, left, right)
        parse_binary_loop(pr, min_prec, nleft)

fn parse_arg_list(pr: &Parser, args: List[Expr]) -> List[Expr] ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        _a = p_accept(pr, TK_RPAREN())
        args
    else
        e = parse_expr(pr)
        _b = list_push(&args, e)
        _t = p_skip_group_nls(pr)
        if p_accept(pr, TK_COMMA()) == 1
            parse_arg_list(pr, args)
        else
            _u = p_skip_group_nls(pr)
            _c = p_accept(pr, TK_RPAREN())
            args

fn skip_brackets(pr: &Parser, depth: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_EOF()
        0
    else
        t = p_advance(pr)
        k = tok_kind(pr, t)
        d2 = skip_brackets_depth(depth, k)
        if d2 <= 0
            0
        else
            skip_brackets(pr, d2)

fn skip_brackets_depth(depth: Int, k: Int) -> Int ! alloc
    if k == TK_LBRACK()
        depth + 1
    elsif k == TK_RBRACK()
        depth - 1
    else
        depth

fn parse_tensor_rows(pr: &Parser, nrows: Int, ncols: Int, data: List[String]) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        _e = p_enter_group(pr)
        rowc = parse_tensor_cells(pr, 0, &data)
        _b = p_accept(pr, TK_RBRACK())
        _l = p_leave_group(pr)
        _n = p_skip_group_nls(pr)
        _c = p_accept(pr, TK_COMMA())
        nc = ncols
        if ncols == 0
            nc = rowc
        else
            nc = ncols
        parse_tensor_rows(pr, nrows + 1, nc, data)
    else
        XTensor(nrows, ncols, data)

fn parse_tensor_cells(pr: &Parser, rowc: Int, data: &List[String]) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_RBRACK()
        rowc
    elsif k == TK_EOF()
        rowc
    elsif k == TK_FLOAT()
        _d = list_push(data, tok_own(pr, p_peek(pr)))
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc + 1, data)
    elsif k == TK_INT()
        _d = list_push(data, int_to_str(tok_ival(pr, p_peek(pr))))
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc + 1, data)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc, data)
    else
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc, data)

fn or_place(place: &String, fallback: &String) -> String ! alloc
    if str_len(place) == 0
        fallback.dup()
    else
        place.dup()

fn parse_primary(pr: &Parser) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_INT()
        _a = p_advance(pr)
        XInt(tok_ival(pr, t))
    elsif k == TK_FLOAT()
        _a = p_advance(pr)
        XFloat(tok_ival(pr, t), tok_own(pr, t))
    elsif k == TK_STRING()
        _a = p_advance(pr)
        XStr(tok_own(pr, t))
    elsif k == TK_FSTRING()
        _a = p_advance(pr)
        if tok_ival(pr, t) == 1
            _e = p_set_err(pr, "parse error: invalid string interpolation")
        else
            _e = 0
        fstring_literal_expr(pr, t)
    elsif k == TK_DSTRING()
        _a = p_advance(pr)
        args = list_new[Expr]()
        _b = list_push(&args, XStr(tok_own(pr, t)))
        XCall("strdup", args, "", 0)
    elsif k == TK_RSTRING()
        _e = p_set_err(pr, "parse error: regex literal is only allowed in a match pattern")
        XNone
    elsif k == TK_IF()
        parse_if(pr)
    elsif k == TK_WHILE()
        parse_while(pr)
    elsif k == TK_TRUE()
        _a = p_advance(pr)
        XBool(1)
    elsif k == TK_FALSE()
        _a = p_advance(pr)
        XBool(0)
    elsif k == TK_MATCH()
        parse_match(pr)
    elsif k == TK_ON()
        parse_on(pr)
    elsif k == TK_IDENT()
        parse_ident_primary(pr)
    elsif k == TK_FN()
        parse_ident_primary(pr)
    elsif k == TK_LPAREN()
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        e = parse_expr(pr)
        _n = p_skip_group_nls(pr)
        if p_accept(pr, TK_RPAREN()) == 0
            _x = p_set_err(pr, "parse error: expected )")
        else
            _x = 0
        _h = p_leave_group(pr)
        e
    else
        _a = p_advance(pr)
        XInt(0)

# `on place [kernel [idx in type]]` and its block.
fn parse_on(pr: &Parser) -> Expr ! alloc
    _a = p_advance(pr)
    pl = p_advance(pr)
    place = or_place(&tok_own(pr, pl), &"pp")
    is_kernel = 0
    has_index = 0
    if p_accept(pr, TK_KERNEL()) == 1
        is_kernel = 1
        if tok_kind(pr, p_peek(pr)) == TK_IDENT()
            has_index = 1
            _ki = skip_kernel_index(pr)
        else
            has_index = 0
    else
        is_kernel = 0
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    body = parse_block_after_indent(pr)
    XOn(place, body, is_kernel, has_index)

fn parse_elsif_arms(pr: &Parser, arms: List[TElsif]) -> List[TElsif] ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_ELSIF()
        _a = p_advance(pr)
        cond = parse_expr(pr)
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        _d = p_skip_nls(pr)
        _g = list_push(&arms, TElsif(cond, body))
        parse_elsif_arms(pr, arms)
    else
        arms

fn parse_if(pr: &Parser) -> Expr ! alloc
    _a = p_advance(pr)
    cond = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    then_b = parse_block_after_indent(pr)
    _d = p_skip_nls(pr)
    arms = parse_elsif_arms(pr, list_new[TElsif]())
    if tok_kind(pr, p_peek(pr)) == TK_ELSE()
        _e = p_advance(pr)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_INDENT())
        else_b = parse_block_after_indent(pr)
        XIf(cond, then_b, else_b, 1, arms)
    else
        XIf(cond, then_b, empty_block(), 0, arms)

# `f"a#{x}b"` becomes `"a" + x + "b"` (the chain starts with a literal).
fn fstring_literal_expr(pr: &Parser, t: Int) -> Expr ! alloc
    if tok_ival(pr, t) == 2
        raw = tok_text(pr, t)
        interp_chain(&raw, 0, str_len(raw), &"", XNone)
    else
        XStr(tok_own(pr, t))

# `left` is the chain so far (`XNone` before the first piece); `lit` the pending text.
fn interp_chain(raw: &String, i: Int, n: Int, lit: &String, left: Expr) -> Expr ! alloc
    if i >= n
        interp_flush(left, lit)
    else
        c = str_char(raw, i)
        if c == 35
            if i + 1 < n
                if str_char(raw, i + 1) == 35
                    if i + 2 < n
                        if str_char(raw, i + 2) == 123
                            interp_chain(raw, i + 3, n, &(lit + "#" + char_to_str(123)), left)
                        else
                            interp_chain(raw, i + 2, n, &(lit + char_to_str(35)), left)
                    else
                        interp_chain(raw, i + 2, n, &(lit + char_to_str(35)), left)
                elsif str_char(raw, i + 1) == 123
                    close = find_char(raw, 125, i + 2, n)
                    name = str_slice(raw, i + 2, close)
                    l1 = interp_flush(left, lit)
                    interp_chain(raw, close + 1, n, &"", XBin("add", l1, XIdent(name)))
                else
                    interp_chain(raw, i + 1, n, &(lit + char_to_str(35)), left)
            else
                interp_chain(raw, i + 1, n, &(lit + char_to_str(35)), left)
        else
            interp_chain(raw, i + 1, n, &(lit + char_to_str(c)), left)

# Append the pending literal to the chain; an empty one adds nothing.
fn interp_flush(left: Expr, lit: &String) -> Expr ! alloc
    if expr_is_none(&left) == 1
        XStr(lit.dup())
    elsif str_len(lit) == 0
        left
    else
        XBin("add", left, XStr(lit.dup()))

# pattern -> "_" | INT | IDENT "." IDENT "(" patterns ")" | IDENT "(" patterns ")" | IDENT
fn parse_pattern(pr: &Parser) -> TPat ! alloc
    t = p_advance(pr)
    k = tok_kind(pr, t)
    if k == TK_INT()
        TPat(2, tok_ival(pr, t), "", "", list_new[TPat]())
    elsif k == TK_STRING()
        TPat(4, 0, tok_own(pr, t), "", list_new[TPat]())
    elsif k == TK_RSTRING()
        TPat(5, 0, tok_own(pr, t), "", list_new[TPat]())
    elsif k == TK_DSTRING()
        _e = p_set_err(pr, "parse error: expected pattern")
        TPat(0, 0, "", "", list_new[TPat]())
    elsif k == TK_FSTRING()
        _e = p_set_err(pr, "parse error: expected pattern")
        TPat(0, 0, "", "", list_new[TPat]())
    elsif k == TK_IDENT()
        nm = tok_own(pr, t)
        if str_eq(nm, "_") == 1
            TPat(0, 0, "", "", list_new[TPat]())
        elsif tok_kind(pr, p_peek(pr)) == TK_DOT()
            _d = p_advance(pr)
            vt = p_advance(pr)
            args = parse_pattern_args(pr)
            TPat(3, 0, tok_own(pr, vt), nm, args)
        elsif tok_kind(pr, p_peek(pr)) == TK_LPAREN()
            args = parse_pattern_args(pr)
            TPat(3, 0, nm, "", args)
        else
            TPat(1, 0, nm, "", list_new[TPat]())
    else
        _e = p_set_err(pr, "parse error: expected pattern")
        TPat(0, 0, "", "", list_new[TPat]())

fn parse_pattern_args(pr: &Parser) -> List[TPat] ! alloc
    args = list_new[TPat]()
    if p_accept(pr, TK_LPAREN()) == 1
        _g = p_enter_group(pr)
        _l = parse_pattern_list(pr, &args)
        _h = p_leave_group(pr)
        args
    else
        args

fn parse_pattern_list(pr: &Parser, args: &List[TPat]) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        p_accept(pr, TK_RPAREN())
    else
        _a = list_push(args, parse_pattern(pr))
        _t = p_skip_group_nls(pr)
        if p_accept(pr, TK_COMMA()) == 1
            parse_pattern_list(pr, args)
        else
            p_accept(pr, TK_RPAREN())

fn parse_match_arms(pr: &Parser, arms: List[TArm]) -> List[TArm] ! alloc
    _s = p_skip_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_DEDENT()
        _a = p_advance(pr)
        arms
    elsif tok_kind(pr, p_peek(pr)) == TK_EOF()
        arms
    else
        pat = parse_pattern(pr)
        _b = p_accept(pr, TK_FATARROW())
        if tok_kind(pr, p_peek(pr)) == TK_NL()
            _nl = p_advance(pr)
            _sk = p_skip_nls(pr)
            if tok_kind(pr, p_peek(pr)) == TK_INDENT()
                _in = p_advance(pr)
                suite = parse_block_after_indent(pr)
                _e = list_push(&arms, TArm(pat, XNone, suite, 1))
            else
                _err = p_set_err(pr, "parse error: expected indented match arm body")
                _e = list_push(&arms, TArm(pat, XNone, empty_block(), 0))
        else
            body = parse_expr(pr)
            _e = list_push(&arms, TArm(pat, body, empty_block(), 0))
        if p_has_err(pr) == 1
            arms
        else
            parse_match_arms(pr, arms)

fn parse_match(pr: &Parser) -> Expr ! alloc
    _a = p_advance(pr)
    scrut = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    arms = parse_match_arms(pr, list_new[TArm]())
    XMatch(scrut, arms)

# kernel index list: IDENT ("," IDENT)* "in" type
fn skip_kernel_index(pr: &Parser) -> Int ! alloc
    k = tok_kind(pr, p_peek(pr))
    if k == TK_IDENT()
        _a = p_advance(pr)
        skip_kernel_index(pr)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        skip_kernel_index(pr)
    elsif k == TK_IN()
        _a = p_advance(pr)
        mark = list_len(&pr.tyat)
        _t = parse_type_text(pr)
        _d = tyat_drop_to(pr, mark)
        0
    else
        0

fn parse_while(pr: &Parser) -> Expr ! alloc
    _a = p_advance(pr)
    cond = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    body = parse_block_after_indent(pr)
    XWhile(cond, body)

fn or_fn_name(name: &String) -> String ! alloc
    if str_len(name) == 0
        "fn"
    else
        name.dup()

fn parse_ident_primary(pr: &Parser) -> Expr ! alloc
    t = p_advance(pr)
    name = or_fn_name(&tok_own(pr, t))
    if str_eq(name, "tensor") == 1
        if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
            _a = p_advance(pr)
            _g = p_enter_group(pr)
            _n = p_skip_group_nls(pr)
            if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
                te = parse_tensor_rows(pr, 0, 0, list_new[String]())
                _n2 = p_skip_group_nls(pr)
                _b = p_accept(pr, TK_RBRACK())
                _h = p_leave_group(pr)
                te
            else
                _b = p_accept(pr, TK_RBRACK())
                _h = p_leave_group(pr)
                XTensor(0, 0, list_new[String]())
        else
            parse_ident_or_call(pr, &name)
    else
        parse_ident_or_call(pr, &name)

fn parse_ident_or_call(pr: &Parser, name: &String) -> Expr ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        text = parse_type_text_go(pr, 1, "")
        parse_call_with_type_args(pr, name, &trim_closing_bracket(&text))
    else
        parse_call_with_type_args(pr, name, &"")

# The accumulated type text ends with the `]` that closed the argument list.
fn trim_closing_bracket(text: &String) -> String ! alloc
    n = str_len(text)
    if n > 0
        if str_char(text, n - 1) == 93
            str_slice(text, 0, n - 1)
        else
            text.dup()
    else
        text.dup()

fn parse_call_with_type_args(pr: &Parser, name: &String, targs: &String) -> Expr ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_LPAREN()
        xp = call_pos(pr)
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        args = parse_arg_list(pr, list_new[Expr]())
        _h = p_leave_group(pr)
        XCall(name.dup(), args, targs.dup(), xp)
    else
        XIdent(name.dup())

fn parse_block_after_indent(pr: &Parser) -> TBlock ! alloc
    _a = p_skip_nls(pr)
    parse_block_go(pr, list_new[TStmt]())

fn parse_return_value(pr: &Parser) -> Expr ! alloc
    if at_block_end(pr) == 1
        XNone
    elsif tok_kind(pr, p_peek(pr)) == TK_NL()
        XNone
    else
        parse_expr(pr)

# A statement of `kind` with a fresh id (see `TStmt`).
fn mk_stmt(pr: &Parser, kind: Int, name: String, expr: Expr) -> TStmt ! alloc
    TStmt(kind, name, expr, "", 0, XNone, 0, 0, p_next_id(pr))

fn parse_block_go(pr: &Parser, stmts: List[TStmt]) -> TBlock ! alloc
    _a = p_skip_nls(pr)
    if at_block_end(pr) == 1
        _b = p_accept(pr, TK_DEDENT())
        TBlock(stmts, XNone)
    elsif tok_kind(pr, p_peek(pr)) == TK_RETURN()
        _r = p_advance(pr)
        rex = parse_return_value(pr)
        _d = list_push(&stmts, mk_stmt(pr, 2, "", rex))
        _e = p_skip_nls(pr)
        parse_block_go(pr, stmts)
    elsif tok_kind(pr, p_peek(pr)) == TK_BREAK()
        _r = p_advance(pr)
        _d = list_push(&stmts, mk_stmt(pr, 4, "", XNone))
        _e = p_skip_nls(pr)
        parse_block_go(pr, stmts)
    elsif tok_kind(pr, p_peek(pr)) == TK_LET()
        parse_let(pr, stmts, 0)
    elsif tok_kind(pr, p_peek(pr)) == TK_AT()
        flags = parse_stmt_attrs(pr, 0)
        if flags < 0
            TBlock(stmts, XNone)
        elsif tok_kind(pr, p_peek(pr)) != TK_LET()
            _e = p_set_err(pr, "parse error: @frozen and @stack apply to let only")
            TBlock(stmts, XNone)
        else
            parse_let(pr, stmts, flags)
    else
        parse_block_expr(pr, stmts)

# `@frozen` (1) and `@stack` (2) before a `let`; -1 on error.
fn parse_stmt_attrs(pr: &Parser, flags: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_AT()
        flags
    else
        _at = p_accept(pr, TK_AT())
        nt = p_peek(pr)
        if tok_kind(pr, nt) != TK_IDENT()
            _e = p_set_err(pr, "parse error: expected attribute name")
            -1
        else
            nt = p_advance(pr)
            name = tok_text(pr, nt)
            if str_eq(name, "frozen") == 1
                _s = p_skip_nls(pr)
                parse_stmt_attrs(pr, flags | 1)
            elsif str_eq(name, "stack") == 1
                _s = p_skip_nls(pr)
                parse_stmt_attrs(pr, flags | 2)
            else
                _e = p_set_err(pr, "parse error: unknown attribute")
                -1

# Forgets the offsets recorded since `mark` (a type text the parser reads and discards).
fn tyat_drop_to(pr: &Parser, mark: Int) -> Int ! alloc
    if list_len(&pr.tyat) <= mark
        0
    else
        _p = list_pop(pr.tyat)
        tyat_drop_to(pr, mark)

# The type text after `:`, empty when omitted.
fn parse_opt_type(pr: &Parser) -> String ! alloc
    if p_accept(pr, TK_COLON()) == 1
        parse_type_text(pr)
    else
        ""

fn parse_let(pr: &Parser, stmts: List[TStmt], flags: Int) -> TBlock ! alloc
    _l = p_advance(pr)
    nt = p_advance(pr)
    nm = tok_own(pr, nt)
    ty = parse_opt_type(pr)
    _q = p_accept(pr, TK_EQ())
    ex = parse_expr(pr)
    st = TStmt(1, nm, ex, ty, 1, XNone, flags & 1, (flags & 2) / 2, p_next_id(pr))
    _d = list_push(&stmts, st)
    _e = p_skip_nls(pr)
    parse_block_go(pr, stmts)

fn parse_block_expr(pr: &Parser, stmts: List[TStmt]) -> TBlock ! alloc
    ex = parse_expr(pr)
    if p_accept(pr, TK_EQ()) == 1
        parse_assign_stmt(pr, stmts, ex)
    else
        parse_block_expr_tail(pr, stmts, ex)

# `lvalue = expr`: the lvalue is an identifier or a chain of fields.
fn parse_assign_stmt(pr: &Parser, stmts: List[TStmt], target: Expr) -> TBlock ! alloc
    value = parse_expr(pr)
    ak = assign_kind(&target)
    if ak == 1
        _d = list_push(&stmts, mk_stmt(pr, 1, ident_of(&target), value))
    elsif ak == 3
        st = TStmt(3, "", value, "", 0, target, 0, 0, p_next_id(pr))
        _d = list_push(&stmts, st)
    else
        _e = p_set_err(pr, "parse error: invalid assignment target")
    _n = p_skip_nls(pr)
    parse_block_go(pr, stmts)

fn parse_block_expr_tail(pr: &Parser, stmts: List[TStmt], ex: Expr) -> TBlock ! alloc
    _a = p_skip_nls(pr)
    if at_block_end(pr) == 1
        _c = p_accept(pr, TK_DEDENT())
        TBlock(stmts, ex)
    else
        _d = list_push(&stmts, mk_stmt(pr, 0, "", ex))
        parse_block_go(pr, stmts)

# Effect names after `!` set their flag in `fx` (see `fx_list_new`).
fn fx_list_new() -> List[Int] ! alloc
    fx = list_new[Int]()
    _a = list_push(&fx, 0)
    _b = list_push(&fx, 0)
    _c = list_push(&fx, 0)
    _d = list_push(&fx, 0)
    _e = list_push(&fx, 0)
    fx

fn parse_effects(pr: &Parser, fx: &List[Int]) -> Int ! alloc
    if p_accept(pr, TK_BANG()) == 0
        0
    else
        parse_effects_go(pr, fx)

fn parse_effects_go(pr: &Parser, fx: &List[Int]) -> Int ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_IDENT()
        _a = p_advance(pr)
        _m = mark_effect(fx, &tok_text(pr, t))
        parse_effects_go(pr, fx)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_effects_go(pr, fx)
    else
        0

fn mark_effect(fx: &List[Int], name: &String) -> Int ! alloc
    slot = effect_slot(name)
    if slot < 0
        0
    else
        _s = list_set(fx, slot, 1)
        0

fn effect_slot(name: &String) -> Int ! alloc
    if str_eq(name, "io") == 1
        0
    elsif str_eq(name, "alloc") == 1
        1
    elsif str_eq(name, "panic") == 1
        2
    elsif str_eq(name, "gpu") == 1
        3
    elsif str_eq(name, "tpu") == 1
        4
    else
        -1

fn or_arg_name(pn: &String) -> String ! alloc
    if str_len(pn) == 0
        "argx"
    else
        pn.dup()

fn parse_param_ty(pr: &Parser) -> String ! alloc
    if p_accept(pr, TK_COLON()) == 1
        parse_type_text(pr)
    else
        _s = list_push(&pr.tyat, 0)
        "Int"

# Explicit `borrow` (1) / `take` (2) after a parameter type, 0 when absent.
fn parse_param_mode(pr: &Parser) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_IDENT()
        if str_eq(tok_text(pr, t), "borrow") == 1
            _a = p_advance(pr)
            1
        elsif str_eq(tok_text(pr, t), "take") == 1
            _b = p_advance(pr)
            2
        elsif str_eq(tok_text(pr, t), "keep") == 1
            _k = p_advance(pr)
            3
        else
            0
    else
        0

fn parse_params(pr: &Parser, params: List[TParam]) -> List[TParam] ! alloc
    _s = p_skip_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        params
    else
        pn_t = p_advance(pr)
        pn = or_arg_name(&tok_own(pr, pn_t))
        ty = parse_param_ty(pr)
        mode = parse_param_mode(pr)
        _a = list_push(&params, TParam(pn, ty, mode))
        if p_accept(pr, TK_COMMA()) == 1
            parse_params(pr, params)
        else
            _t = p_skip_nls(pr)
            params

fn parse_struct_fields(pr: &Parser, fields: List[TField]) -> List[TField] ! alloc
    _s = p_skip_nls(pr)
    if at_block_end(pr) == 1
        fields
    elsif tok_kind(pr, p_peek(pr)) == TK_IDENT()
        pn_t = p_advance(pr)
        pn = or_arg_name(&tok_own(pr, pn_t))
        ty = parse_param_ty(pr)
        _a = list_push(&fields, TField(pn, ty))
        parse_struct_fields(pr, fields)
    else
        _e = p_set_err(pr, "parse error: expected struct field")
        fields

# The bits of the attributes in front of an item: 1 @no_heap, 2 @layout(c), 4 @deprecated("…"), 8 @arena.
# The message of @deprecated goes to `pr.dep`; -1 is an error (already set).
fn parse_item_attrs(pr: &Parser, bits: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_AT()
        bits
    else
        b = parse_item_attr_one(pr)
        if b < 0
            -1
        elsif item_attr_has(bits, b) == 1
            _e = p_set_err(pr, "parse error: repeated attribute")
            -1
        else
            _n = p_skip_nls(pr)
            parse_item_attrs(pr, bits + b)

fn item_attr_has(bits: Int, b: Int) -> Int ! alloc
    if (bits / b) % 2 == 1
        1
    else
        0

fn parse_item_attr_one(pr: &Parser) -> Int ! alloc
    _at = p_accept(pr, TK_AT())
    nt = p_peek(pr)
    if tok_kind(pr, nt) != TK_IDENT()
        _e = p_set_err(pr, "parse error: expected attribute name")
        -1
    else
        nt = p_advance(pr)
        name = tok_text(pr, nt)
        if str_eq(name, "no_heap") == 1
            1
        elsif str_eq(name, "layout") == 1
            if p_accept(pr, TK_LPAREN()) == 0
                _e = p_set_err(pr, "parse error: expected ( after @layout")
                -1
            else
                nt2 = p_peek(pr)
                if tok_kind(pr, nt2) != TK_IDENT()
                    _e = p_set_err(pr, "parse error: expected c in @layout(c)")
                    -1
                else
                    nt2 = p_advance(pr)
                    arg = tok_text(pr, nt2)
                    if p_accept(pr, TK_RPAREN()) == 0
                        _e = p_set_err(pr, "parse error: expected ) after @layout(c)")
                        -1
                    elsif str_eq(arg, "c") == 0
                        _e = p_set_err(pr, "parse error: only @layout(c) is supported")
                        -1
                    else
                        2
        elsif str_eq(name, "deprecated") == 1
            parse_deprecated_arg(pr)
        elsif str_eq(name, "arena") == 1
            8
        elsif str_eq(name, "shared") == 1
            _e = p_set_err(pr, "parse error: attribute @shared is not in this version")
            -1
        else
            _e = p_set_err(pr, "parse error: unknown attribute")
            -1

# `("message")` after @deprecated; the message is kept as "d:" + message (see `TFn.deprecated`).
fn parse_deprecated_arg(pr: &Parser) -> Int ! alloc
    if p_accept(pr, TK_LPAREN()) == 0
        _e = p_set_err(pr, "parse error: expected (\"message\") after @deprecated")
        -1
    else
        nt = p_peek(pr)
        if tok_kind(pr, nt) != TK_STRING()
            _e = p_set_err(pr, "parse error: @deprecated takes a string message")
            -1
        else
            text = tok_text(pr, nt)
            _p = p_advance(pr)
            if p_accept(pr, TK_RPAREN()) == 0
                _e = p_set_err(pr, "parse error: expected ) after @deprecated message")
                -1
            else
                _s = list_set(pr.dep, 0, "d:" + text)
                4

# type_params -> "[" IDENT ("," IDENT)* "]" | empty; returns the names.
fn parse_type_params(pr: &Parser) -> List[String] ! alloc
    ps = list_new[String]()
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        parse_type_params_go(pr, ps)
    else
        ps

fn parse_type_params_go(pr: &Parser, ps: List[String]) -> List[String] ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_IDENT()
        _a = p_advance(pr)
        _b = list_push(&ps, tok_own(pr, t))
        parse_type_params_go(pr, ps)
    elsif k == TK_TICK()
        parse_type_param_tick(pr, ps)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_type_params_go(pr, ps)
    elsif k == TK_RBRACK()
        _a = p_advance(pr)
        ps
    else
        ps

# Copies the names of `xs` that are lifetimes (`tick` 1: they start with `'`) or type parameters
# (`tick` 0) into `out`, in order.
fn split_tick_names(xs: &List[String], i: Int, n: Int, tick: Int, out: &List[String]) -> Int ! alloc
    if i >= n
        0
    else
        x = xs.get(i)
        is_lt = if x.len() > 0 && x.char(0) == 39
            1
        else
            0
        if is_lt == tick
            _p = out.push(x.dup())
        else
            _q = 0
        split_tick_names(xs, i + 1, n, tick, out)

fn parse_type_param_tick(pr: &Parser, ps: List[String]) -> List[String] ! alloc
    _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) != TK_IDENT()
        ps
    else
        _b = p_advance(pr)
        name = "'" + tok_own(pr, nt)
        _c = list_push(&ps, name)
        parse_type_params_go(pr, ps)

fn parse_variant_fields(pr: &Parser, fields: &List[String]) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        p_advance(pr)
    else
        _b = list_push(fields, strdup(parse_type_text(pr)))
        if p_accept(pr, TK_COMMA()) == 1
            parse_variant_fields(pr, fields)
        else
            p_accept(pr, TK_RPAREN())

fn parse_enum_variants(pr: &Parser, vs: List[TVariant]) -> List[TVariant] ! alloc
    _s = p_skip_nls(pr)
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_IDENT()
        _a = p_advance(pr)
        fields = list_new[String]()
        if tok_kind(pr, p_peek(pr)) == TK_LPAREN()
            _b = p_advance(pr)
            _c = parse_variant_fields(pr, &fields)
        else
            _c = 0
        _d = list_push(&vs, TVariant(tok_own(pr, t), fields))
        parse_enum_variants(pr, vs)
    else
        vs

fn parse_enum(pr: &Parser) -> TEnum ! alloc
    start = list_len(&pr.tyat)
    _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) == TK_IDENT()
        _b = p_advance(pr)
        params = parse_type_params(pr)
        impls = parse_impl_clause(pr)
        if list_len(&params) > 0
            if list_len(&impls) > 0
                _e = p_set_err(pr, "parse error: generic enum cannot declare protocol impl")
        _c = p_skip_nls(pr)
        _d = p_accept(pr, TK_INDENT())
        vs = parse_enum_variants(pr, list_new[TVariant]())
        _e = p_accept(pr, TK_DEDENT())
        TEnum(tok_own(pr, nt), vs, params, impls, "", tyat_since(pr, start))
    else
        _e = p_set_err(pr, "parse error: expected enum name")
        TEnum("_bad", list_new[TVariant](), list_new[String](), list_new[String](), "", "")

fn parse_struct(pr: &Parser, layout_c: Int) -> TStruct ! alloc
    start = list_len(&pr.tyat)
    is_frame = 0
    if tok_kind(pr, p_peek(pr)) == TK_STRUCT()
        _a = p_accept(pr, TK_STRUCT())
    elsif tok_kind(pr, p_peek(pr)) == TK_FRAME()
        _a = p_advance(pr)
        is_frame = 1
    else
        _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) == TK_IDENT()
        nt = p_advance(pr)
        name = or_fn_name(&tok_own(pr, nt))
        if str_eq(name, "any") == 1
            _e = p_set_err(pr, "parse error: struct name `any` is reserved")
        declared = parse_type_params(pr)
        sparams = list_new[String]()
        lifetimes = list_new[String]()
        _tp = split_tick_names(&declared, 0, list_len(&declared), 0, &sparams)
        _lt = split_tick_names(&declared, 0, list_len(&declared), 1, &lifetimes)
        impls = parse_impl_clause(pr)
        if list_len(&sparams) > 0
            if list_len(&impls) > 0
                _e = p_set_err(pr, "parse error: generic struct cannot declare protocol impl")
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        fields = parse_struct_fields(pr, list_new[TField]())
        if tok_kind(pr, p_peek(pr)) == TK_DEDENT()
            _d = p_accept(pr, TK_DEDENT())
        else
            _d = 0
        TStruct(name, fields, layout_c, sparams, is_frame, impls, "", tyat_since(pr, start), lifetimes)
    else
        _e = p_set_err(pr, "parse error: expected struct name")
        TStruct("_bad", list_new[TField](), 0, list_new[String](), 0, list_new[String](), "", "", list_new[String]())

fn parse_impl_clause(pr: &Parser) -> List[String] ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_IDENT()
        list_new[String]()
    elsif str_eq(tok_text(pr, p_peek(pr)), "impl") == 0
        list_new[String]()
    else
        _a = p_advance(pr)
        parse_impl_list(pr, list_new[String]())

fn parse_impl_list(pr: &Parser, out: List[String]) -> List[String] ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_IDENT()
        out
    else
        nt = p_advance(pr)
        _p = list_push(&out, tok_own(pr, nt))
        if p_accept(pr, TK_COMMA()) == 1
            parse_impl_list(pr, out)
        else
            out

fn parse_protocol(pr: &Parser) -> TProtocol ! alloc
    _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) != TK_IDENT()
        _e = p_set_err(pr, "parse error: expected protocol name")
        TProtocol("_bad", list_new[TProtocolMethod]())
    else
        _b = p_advance(pr)
        name = tok_own(pr, nt)
        _c = p_skip_nls(pr)
        _d = p_accept(pr, TK_INDENT())
        methods = parse_protocol_methods(pr, list_new[TProtocolMethod]())
        _e = p_accept(pr, TK_DEDENT())
        TProtocol(name, methods)

fn parse_protocol_methods(pr: &Parser, out: List[TProtocolMethod]) -> List[TProtocolMethod] ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_DEDENT()
        out
    elsif tok_kind(pr, p_peek(pr)) != TK_IDENT()
        out
    elsif str_eq(tok_text(pr, p_peek(pr)), "method") == 0
        out
    else
        _m = list_push(&out, parse_protocol_method_sig(pr))
        _n = p_skip_nls(pr)
        parse_protocol_methods(pr, out)

fn parse_protocol_method_sig(pr: &Parser) -> TProtocolMethod ! alloc
    _k = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) != TK_IDENT()
        _e = p_set_err(pr, "parse error: expected method name in protocol")
        TProtocolMethod("_bad", list_new[TParam](), "", fx_list_new(), 0)
    else
        _n = p_advance(pr)
        mname = tok_own(pr, nt)
        _b = p_accept(pr, TK_LPAREN())
        self_mode = parse_protocol_self(pr)
        params = parse_params(pr, list_new[TParam]())
        _r = p_accept(pr, TK_RPAREN())
        ret = parse_fn_ret(pr)
        fx = fx_list_new()
        _e = parse_effects(pr, &fx)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_NL())
        TProtocolMethod(mname, params, ret, fx, self_mode)

# Consumes optional `self` / `self take` / `self borrow`; protocol `params` exclude `self` (mirror bootstrap).
fn parse_protocol_self(pr: &Parser) -> Int ! alloc
    _s = p_skip_nls(pr)
    t = p_peek(pr)
    if tok_kind(pr, t) != TK_IDENT()
        0
    elsif str_eq(tok_text(pr, t), "self") == 0
        0
    elsif parse_self_follows(pr, t + 1) == 0
        _e = p_set_err(pr, "parse error: `self` in a protocol method: write `self`, `self take` or `self borrow`")
        0
    else
        _a = p_advance(pr)
        mode = parse_param_mode(pr)
        _c = p_accept(pr, TK_COMMA())
        mode

# The return type text after `->`; empty (and an error) when there is none.
fn parse_fn_ret(pr: &Parser) -> String ! alloc
    if p_accept(pr, TK_ARROW()) == 1
        parse_type_text(pr)
    else
        _e = p_set_err(pr, "parse error: expected -> after parameters")
        ""

fn parse_fn(pr: &Parser, no_heap: Int) -> TFn ! alloc
    start = list_len(&pr.tyat)
    _a = p_accept(pr, TK_FN())
    nt = p_peek(pr)
    if tok_kind(pr, nt) == TK_IDENT()
        nt = p_advance(pr)
        name = or_fn_name(&tok_own(pr, nt))
        tparams = parse_type_params(pr)
        _b = p_accept(pr, TK_LPAREN())
        params = parse_params(pr, list_new[TParam]())
        _n = p_skip_nls(pr)
        _c = p_accept(pr, TK_RPAREN())
        ret = parse_fn_ret(pr)
        fx = fx_list_new()
        _e = parse_effects(pr, &fx)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        TFn(name, params, body, ret, no_heap, 0, fx, tparams, "", 0, "", tyat_since(pr, start))
    else
        _e = p_set_err(pr, "parse error: expected function name")
        TFn("_bad", list_new[TParam](), empty_block(), "", 0, 0, fx_list_new(), list_new[String](), "", 0, "", "")

# 1 `method`, 2 `static`, 3 `init` when the next token starts such an item and an identifier follows.
fn parse_method_kw(pr: &Parser) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(pr, t + 1) != TK_IDENT()
        0
    elsif str_eq(tok_text(pr, t), "method") == 1
        1
    elsif str_eq(tok_text(pr, t), "static") == 1
        2
    elsif str_eq(tok_text(pr, t), "init") == 1
        3
    else
        0

fn method_bad() -> TFn ! alloc
    TFn("_bad", list_new[TParam](), empty_block(), "", 0, 0, fx_list_new(), list_new[String](), "", 0, "", "")

# `method T.name(self, params) -> R`, `static T.name(params) -> R` and `init T(params) ! fx`: a function
# `T__name` (`T__new` for `init`, which returns a `T`); a method takes `self: T` first.
fn parse_method_item(pr: &Parser, mk: Int) -> TFn ! alloc
    _k = p_advance(pr)
    _n = p_note_dot(pr)
    rt = p_advance(pr)
    recv = tok_own(pr, rt)
    if mk == 3
        parse_method_sig(pr, mk, &recv, &"new", list_new[String]())
    elsif p_accept(pr, TK_DOT()) == 0
        _e = p_set_err(pr, "parse error: expected . after the receiver type")
        method_bad()
    elsif tok_kind(pr, p_peek(pr)) != TK_IDENT()
        _e = p_set_err(pr, "parse error: expected method name")
        method_bad()
    else
        nt = p_advance(pr)
        name = tok_own(pr, nt)
        tparams = parse_type_params(pr)
        if list_len(&tparams) > 0
            _e = p_set_err(pr, "parse error: a method takes no type parameters")
            method_bad()
        else
            parse_method_sig(pr, mk, &recv, &name, tparams)

fn parse_method_sig(pr: &Parser, mk: Int, recv: &String, name: &String, tparams: List[String]) -> TFn ! alloc
    start = list_len(&pr.tyat)
    _b = p_accept(pr, TK_LPAREN())
    params = list_new[TParam]()
    _s = parse_self_param(pr, mk, recv, &params)
    params = parse_params(pr, params)
    _n = p_skip_nls(pr)
    _c = p_accept(pr, TK_RPAREN())
    ret = parse_method_ret(pr, mk, recv)
    fx = fx_list_new()
    _e = parse_effects(pr, &fx)
    _f = p_skip_nls(pr)
    _g = p_accept(pr, TK_INDENT())
    body = parse_block_after_indent(pr)
    TFn(recv + "__" + name, params, body, ret, 0, 0, fx, tparams, recv.dup(), mk, "", tyat_since(pr, start))

fn parse_method_ret(pr: &Parser, mk: Int, recv: &String) -> String ! alloc
    if mk == 3
        _s = list_push(&pr.tyat, 0)
        strdup(recv)
    else
        parse_fn_ret(pr)

# A method always takes `self: T` first; the source only spells it to set the mode: `self`, `self take`
# or `self borrow` (then a comma, or the end of the list).
fn parse_self_param(pr: &Parser, mk: Int, recv: &String, params: &List[TParam]) -> Int ! alloc
    if mk != 1
        0
    else
        _s = p_skip_nls(pr)
        t = p_peek(pr)
        if tok_kind(pr, t) == TK_AMP()
            parse_self_ref(pr, recv, params)
        elsif tok_kind(pr, t) != TK_IDENT()
            parse_self_push(pr, params, recv, 0)
        elsif str_eq(tok_text(pr, t), "self") == 0
            parse_self_push(pr, params, recv, 0)
        elsif parse_self_follows(pr, t + 1) == 0
            _e = p_set_err(pr, "parse error: `self` is implicit in a method: write `self`, `self take` or `self borrow`")
            0
        else
            _a = p_advance(pr)
            mode = parse_param_mode(pr)
            _c = p_accept(pr, TK_COMMA())
            parse_self_push(pr, params, recv, mode)

# `&self` / `&mut self`: the type carries the reference and the mode is borrow.
fn parse_self_ref(pr: &Parser, recv: &String, params: &List[TParam]) -> Int ! alloc
    _a = p_advance(pr)
    t = p_peek(pr)
    mut = 0
    if tok_kind(pr, t) == TK_IDENT()
        if str_eq(tok_text(pr, t), "mut") == 1
            _b = p_advance(pr)
            mut = 1
    t2 = p_peek(pr)
    if tok_kind(pr, t2) != TK_IDENT()
        _e = p_set_err(pr, "parse error: expected self after &")
        0
    elsif str_eq(tok_text(pr, t2), "self") == 0
        _e = p_set_err(pr, "parse error: expected self after &")
        0
    else
        _c = p_advance(pr)
        _d = p_accept(pr, TK_COMMA())
        ty = if mut == 1
            "&mut " + recv + " "
        else
            "&" + recv + " "
        parse_self_push_ty(pr, params, ty, 1)

fn parse_self_push(pr: &Parser, params: &List[TParam], recv: &String, mode: Int) -> Int ! alloc
    parse_self_push_ty(pr, params, (recv + " "), mode)

fn parse_self_push_ty(pr: &Parser, params: &List[TParam], ty: String, mode: Int) -> Int ! alloc
    _s = list_push(&pr.tyat, 0)
    _p = list_push(params, TParam("self", ty, mode))
    0

fn parse_self_follows(pr: &Parser, t: Int) -> Int ! alloc
    k = tok_kind(pr, t)
    if k == TK_COMMA()
        1
    elsif k == TK_RPAREN()
        1
    elsif k == TK_IDENT()
        if str_eq(tok_text(pr, t), "take") == 1
            1
        elsif str_eq(tok_text(pr, t), "borrow") == 1
            1
        elsif str_eq(tok_text(pr, t), "keep") == 1
            1
        else
            0
    else
        0

fn parse_import_path_dots(pr: &Parser, path: &String) -> String ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_DOT()
        _d = p_advance(pr)
        if tok_kind(pr, p_peek(pr)) == TK_IDENT()
            t = p_peek(pr)
            _t = p_advance(pr)
            seg = tok_text(pr, t)
            npath = path + "." + seg
            parse_import_path_dots(pr, &npath)
        else
            path.dup()
    else
        path.dup()

# The alias after `as`, empty when there is none.
fn parse_optional_import_as(pr: &Parser) -> String ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_IDENT()
        if str_eq(tok_text(pr, p_peek(pr)), "as") == 1
            _a = p_advance(pr)
            if tok_kind(pr, p_peek(pr)) == TK_IDENT()
                t = p_advance(pr)
                tok_own(pr, t)
            else
                _e = p_set_err(pr, "parse error: expected import alias name")
                ""
        else
            ""
    else
        ""

fn parse_import_path(pr: &Parser) -> String ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_STRING()
        name = tok_own(pr, t)
        _a = p_advance(pr)
        name
    elsif k == TK_IDENT()
        path = tok_own(pr, t)
        _b = p_advance(pr)
        parse_import_path_dots(pr, &path)
    else
        _e = p_set_err(pr, "parse error: expected identifier")
        ""

# What the items of a program are collected into.
struct Items
    fns: List[TFn]
    structs: List[TStruct]
    enums: List[TEnum]
    protocols: List[TProtocol]
    imports: List[String]
    aliases: List[String]
    consts: List[TConst]

# The item after its attributes (`bits`, see `parse_item_attrs`): @no_heap goes to fn and method,
# @layout(c) to struct, @deprecated to fn, method, struct and enum.
fn parse_attributed_item(pr: &Parser, it: &Items, bits: Int) -> Int ! alloc
    dep = take_dep(pr)
    nh = item_attr_has(bits, 1)
    lay = item_attr_has(bits, 2)
    ar = item_attr_has(bits, 8)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_FN()
        if lay == 1
            attr_not_here(pr)
        else
            _c = list_push(&it.fns, fn_with_attrs(&parse_fn(pr, nh), nh, &dep, ar))
            parse_program_go(pr, it)
    elsif k == TK_STRUCT()
        if nh + ar > 0
            attr_not_here(pr)
        else
            _s = list_push(&it.structs, struct_with_dep(&parse_struct(pr, lay), &dep))
            parse_program_go(pr, it)
    elsif k == TK_ENUM()
        if nh + lay + ar > 0
            attr_not_here(pr)
        else
            _s = list_push(&it.enums, enum_with_dep(&parse_enum(pr), &dep))
            parse_program_go(pr, it)
    elsif k == TK_IDENT()
        if str_eq(tok_text(pr, p_peek(pr)), "protocol") == 1
            if nh + lay + ar > 0
                attr_not_here(pr)
            else
                _p = list_push(&it.protocols, parse_protocol(pr))
                parse_program_go(pr, it)
        elsif parse_method_kw(pr) > 0
            if lay == 1
                attr_not_here(pr)
            else
                _m = list_push(&it.fns, fn_with_attrs(&parse_method_item(pr, parse_method_kw(pr)), nh, &dep, ar))
                parse_program_go(pr, it)
        elsif looks_like_const(pr) == 1
            if nh + lay + ar > 0
                attr_not_here(pr)
            else
                _c = list_push(&it.consts, parse_const_item(pr, &dep))
                if p_has_err(pr) == 0
                    parse_program_go(pr, it)
                else
                    0
        else
            attr_not_here(pr)
    else
        attr_not_here(pr)

# The item with its attributes: `nh` is @no_heap, `dep` the "d:" message ("" when none).
fn fn_with_attrs(f: &TFn, nh: Int, dep: &String, ar: Int) -> TFn ! alloc
    TFn(f.name, f.params, f.body, f.ret, nh, ar, f.fx, f.tparams, f.recv, f.mkind, dep.dup(), f.tyat)

fn struct_with_dep(s: &TStruct, dep: &String) -> TStruct ! alloc
    TStruct(s.name, s.fields, s.layout_c, s.tparams, s.is_frame, s.protocols, dep.dup(), s.tyat, s.lifetimes)

fn enum_with_dep(e: &TEnum, dep: &String) -> TEnum ! alloc
    TEnum(e.name, e.variants, e.tparams, e.protocols, dep.dup(), e.tyat)

fn attr_not_here(pr: &Parser) -> Int ! alloc
    _e = p_set_err(pr, "parse error: attribute not allowed on this item")
    0

fn take_dep(pr: &Parser) -> String ! alloc
    text = list_get(&pr.dep, 0)
    _s = list_set(pr.dep, 0, "")
    text

fn parse_program_go(pr: &Parser, it: &Items) -> Int ! alloc
    _a = p_skip_nls(pr)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_EOF()
        0
    elsif k == TK_AT()
        bits = parse_item_attrs(pr, 0)
        _n = p_skip_nls(pr)
        if bits < 0
            0
        else
            parse_attributed_item(pr, it, bits)
    elsif k == TK_IMPORT()
        _i = p_advance(pr)
        path = parse_import_path(pr)
        alias = parse_optional_import_as(pr)
        _b = list_push(&it.imports, strdup(path))
        _c = list_push(&it.aliases, strdup(alias))
        parse_program_go(pr, it)
    elsif k == TK_STRUCT()
        _s = list_push(&it.structs, parse_struct(pr, 0))
        parse_program_go(pr, it)
    elsif k == TK_FRAME()
        _s = list_push(&it.structs, parse_struct(pr, 0))
        parse_program_go(pr, it)
    elsif k == TK_ENUM()
        _s = list_push(&it.enums, parse_enum(pr))
        parse_program_go(pr, it)
    elsif k == TK_IDENT()
        if str_eq(tok_text(pr, p_peek(pr)), "protocol") == 1
            _p = list_push(&it.protocols, parse_protocol(pr))
            parse_program_go(pr, it)
        elsif str_eq(tok_text(pr, p_peek(pr)), "struct") == 1
            _s = list_push(&it.structs, parse_struct(pr, 0))
            parse_program_go(pr, it)
        elsif parse_method_kw(pr) > 0
            _m = list_push(&it.fns, parse_method_item(pr, parse_method_kw(pr)))
            parse_program_go(pr, it)
        elsif looks_like_const(pr) == 1
            _c = list_push(&it.consts, parse_const_item(pr, &""))
            if p_has_err(pr) == 0
                parse_program_go(pr, it)
            else
                0
        else
            _d = p_advance(pr)
            parse_program_go(pr, it)
    elsif k == TK_FN()
        _c = list_push(&it.fns, parse_fn(pr, 0))
        parse_program_go(pr, it)
    else
        _d = p_advance(pr)
        parse_program_go(pr, it)

fn toks_has_code(pr: &Parser, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        k = tok_kind(pr, i)
        if k == TK_EOF()
            toks_has_code(pr, i + 1, n)
        elsif k == TK_NL()
            toks_has_code(pr, i + 1, n)
        elsif k == TK_INDENT()
            toks_has_code(pr, i + 1, n)
        elsif k == TK_DEDENT()
            toks_has_code(pr, i + 1, n)
        else
            1

# The message in `errs` ("" when empty). The caller's list is dropped with its scope.
fn errs_take(errs: &List[String]) -> String ! alloc
    if list_len(errs) == 0
        ""
    else
        strdup(list_get(errs, 0))

# The parsed program. A parse error leaves its message in `errs` (empty otherwise) and the
# program is then whatever was read before it. `break` is rewritten away (see `loops.sal`) and
# methods resolved (see `methods.sal`).
fn parse_program(src: &String, errs: &List[String]) -> TProgram ! alloc
    flags = list_new[Int]()
    _f = list_push(&flags, 0)
    parse_program_post(parse_program_raw(src, errs, &flags), src, errs, &flags)

# Like `parse_program`, but the dotted calls stay for `methods_resolve_graph`, which resolves them
# with the items of every module in view. `out` gets the dotted-call count of the program.
fn parse_program_deferred(src: &String, errs: &List[String], out: &List[Int]) -> TProgram ! alloc
    flags = list_new[Int]()
    _f = list_push(&flags, 0)
    parse_program_deferred_post(parse_program_raw(src, errs, &flags), src, errs, &flags, out)

fn parse_program_deferred_post(tp: TProgram, src: &String, errs: &List[String], flags: &List[Int], out: &List[Int]) -> TProgram ! alloc
    ndots = list_get(flags, 0)
    _o = list_push(out, ndots)
    if list_len(errs) > 0
        tp
    elsif str_contains(src, "break") == 1
        parse_program_check(desugar_break(tp, errs), errs, ndots)
    else
        parse_program_check(tp, errs, ndots)

fn parse_program_check(tp: TProgram, errs: &List[String], ndots: Int) -> TProgram ! alloc
    if list_len(errs) > 0
        tp
    else
        _c = methods_check_defs(&tp, errs)
        if list_len(errs) == 0
            if list_len(&tp.protocols) + protocol_impl_count(&tp) > 0
                _p = check_program_protocols(&tp, errs)
        tp

fn protocol_impl_count(tp: &TProgram) -> Int ! alloc
    protocol_impl_structs(&tp.structs, 0, list_len(&tp.structs), 0)

fn protocol_impl_structs(sts: &List[TStruct], i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        st = list_get(sts, i)
        acc2 = acc + list_len(&st.protocols)
        protocol_impl_structs(sts, i + 1, n, acc2)

fn parse_program_post(tp: TProgram, src: &String, errs: &List[String], flags: &List[Int]) -> TProgram ! alloc
    ndots = list_get(flags, 0)
    if list_len(errs) > 0
        tp
    elsif str_contains(src, "break") == 1
        parse_program_methods(desugar_break(tp, errs), errs, ndots)
    else
        parse_program_methods(tp, errs, ndots)

fn parse_program_methods(tp: TProgram, errs: &List[String], ndots: Int) -> TProgram ! alloc
    if list_len(errs) > 0
        tp
    else
        if list_len(&tp.protocols) + protocol_impl_count(&tp) > 0
            _p = check_program_protocols(&tp, errs)
        if list_len(errs) > 0
            tp
        elsif ndots > 0
            prepare_methods(tp, ndots, errs)
        else
            tp

fn parse_program_raw(src: &String, errs: &List[String], flags: &List[Int]) -> TProgram ! alloc
    pr = parser_new(&lex(src))
    it = Items(list_new[TFn](), list_new[TStruct](), list_new[TEnum](), list_new[TProtocol](), list_new[String](), list_new[String](), list_new[TConst]())
    _a = p_skip_nls(&pr)
    _b = parse_program_go(&pr, &it)
    msg = parse_program_error(&pr, list_len(&it.fns), list_len(&it.structs), list_len(&it.enums), list_len(&it.consts), src)
    _n = list_set(flags, 0, list_get(&pr.st, 4))
    _f = parser_free(&pr)
    if str_len(msg) > 0
        _e = list_push(errs, msg)
        TProgram(it.fns, it.imports, it.structs, it.aliases, it.enums, it.protocols, it.consts)
    else
        TProgram(it.fns, it.imports, it.structs, it.aliases, it.enums, it.protocols, it.consts)

# An identifier at item position followed by `=` or `:`.
fn looks_like_const(pr: &Parser) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(pr, t) != TK_IDENT()
        0
    else
        k = tok_kind(pr, t + 1)
        if k == TK_EQ()
            1
        elsif k == TK_COLON()
            1
        else
            0

fn is_const_name(s: &String) -> Int ! alloc
    n = str_len(s)
    if n == 0
        0
    else
        c0 = str_char(s, 0)
        if c0 < 65
            0
        elsif c0 > 90
            0
        else
            is_const_rest(s, 1, n)

fn is_const_rest(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    else
        c = str_char(s, i)
        if c >= 65
            if c <= 90
                is_const_rest(s, i + 1, n)
            elsif c == 95
                is_const_rest(s, i + 1, n)
            else
                0
        elsif c >= 48
            if c <= 57
                is_const_rest(s, i + 1, n)
            elsif c == 95
                is_const_rest(s, i + 1, n)
            else
                0
        elsif c == 95
            is_const_rest(s, i + 1, n)
        else
            0

fn parse_const_item(pr: &Parser, dep: &String) -> TConst ! alloc
    t = p_advance(pr)
    name = tok_own(pr, t)
    if is_const_name(&name) == 0
        _e = p_set_err(pr, "parse error: a module constant's name is uppercase")
        TConst(name, "", XNone, dep.dup())
    else
        ty = ""
        if tok_kind(pr, p_peek(pr)) == TK_COLON()
            _c = p_advance(pr)
            ty = parse_type_text(pr)
        else
            ty = ""
        if tok_kind(pr, p_peek(pr)) != TK_EQ()
            _e = p_set_err(pr, "parse error: expected =")
            TConst(name, ty, XNone, dep.dup())
        else
            _q = p_advance(pr)
            TConst(name, ty, parse_expr(pr), dep.dup())

# The error text of the parse, empty when it went well.
fn parse_program_error(pr: &Parser, nfns: Int, nstructs: Int, nenums: Int, nconsts: Int, src: &String) -> String ! alloc
    if p_has_err(pr) == 1
        strdup(p_err_msg(pr))
    elsif nfns > 0
        ""
    elsif nstructs > 0
        ""
    elsif nenums > 0
        ""
    elsif nconsts > 0
        ""
    elsif toks_has_code(pr, 0, list_len(&pr.kinds)) == 1
        "parse error: expected fn"
    elsif str_len(src) == 0
        "parse error: empty source"
    else
        "parse error: no functions"
