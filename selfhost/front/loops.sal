# `break`: leaves the innermost `while`. Mirror of `src/loops.rs`.
#
# `break` is a statement of a loop body, or of an `if` / `elsif` / `else` block nested in it. The
# pass runs right after the parse and rewrites it with a flag, so no later pass sees a `break`:
#
#   while cond                     __brk1 = 0
#       a                          while __brk1 == 0
#       if c                           if cond
#           break         ==>              a
#       b                                  if c
#                                              __brk1 = 1
#                                          if __brk1 == 0
#                                              b
#                                      else
#                                          __brk1 = 1
#
# The flag is tested before `cond`, so a `break` never evaluates `cond` again. A `break` outside a
# loop, or somewhere other than a statement of a loop body (or of its `if` blocks), or followed by
# more code in its block, is an error.
#
# `cx = [next flag number, broke (result of the last lp_block), failed]`; `errs` takes the first message.
import "../ast/tast.sal"

fn lp_fail(errs: List[String], cx: List[Int], msg: String) -> Int ! alloc
    if cx.get(2) == 1
        0
    else
        cx.set(2, 1)
        _b = errs.push(msg)
        0

fn lp_empty() -> TBlock ! alloc
    TBlock(List.new[TStmt](), XNone)

fn lp_none(e: Expr) -> Int ! alloc
    match e
        XNone => 1
        _ => 0

fn lp_flag_clear(flag: String) -> Expr ! alloc
    XBin("eq", XIdent(flag.dup()), XInt(0))

fn lp_set_flag(flag: String, v: Int) -> TStmt ! alloc
    TStmt(1, flag.dup(), XInt(v), "", 0, XNone, 0, 0, 0)

fn lp_expr_stmt(e: Expr) -> TStmt ! alloc
    TStmt(0, "", e, "", 0, XNone, 0, 0, 0)

fn lp_if_stmt(cond: Expr, then_b: TBlock, else_b: TBlock, has_else: Int) -> TStmt ! alloc
    lp_expr_stmt(XIf(cond, then_b, else_b, has_else, List.new[TElsif]()))

# A statement `if` has no value: the tail of a branch becomes a statement.
fn lp_unit(b: TBlock) -> TBlock ! alloc
    if lp_none(b.tail) == 1
        b
    else
        b.stmts.push(lp_expr_stmt(b.tail))
        TBlock(b.stmts, XNone)

# ---- blocks and statements ----

# Rewrites `b`, whose enclosing loop (if any) uses `flag` ("" when none). Leaves in `cx[1]` whether a
# `break` of that loop can run inside it.
fn lp_block(b: TBlock, flag: String, cx: List[Int], errs: List[String]) -> TBlock ! alloc
    out = List.new[TStmt]()
    tl = List.new[Expr]()
    tl.push(b.tail)
    br = lp_stmts(b.stmts, 0, b.stmts.len(), flag, cx, errs, out, tl)
    if br == 1
        _s = cx.set(1, 1)
        TBlock(out, tl.get(0))
    else
        tail = lp_tail(tl.get(0), out, cx, errs)
        _s = cx.set(1, 0)
        TBlock(out, tail)

# The tail of a block: a `while` there may need its flag declared before it.
fn lp_tail(e: Expr, out: List[TStmt], cx: List[Int], errs: List[String]) -> Expr ! alloc
    match e
        XWhile(c, body) => lp_while(c, body, out, cx, errs)
        _ => lp_expr(e, cx, errs)

# Returns whether a `break` of the enclosing loop ran (1) in the block's statements.
fn lp_stmts(stmts: List[TStmt], i: Int, n: Int, flag: String, cx: List[Int], errs: List[String], out: List[TStmt], tl: List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        code = lp_stmt(stmts.get(i), flag, cx, errs, out)
        if code == 0
            lp_stmts(stmts, i + 1, n, flag, cx, errs, out, tl)
        else
            lp_after(stmts, i + 1, n, flag, code, cx, errs, out, tl)

# What follows a statement that may break (code 1: an `if`) or is a `break` (code 2).
fn lp_after(stmts: List[TStmt], i: Int, n: Int, flag: String, code: Int, cx: List[Int], errs: List[String], out: List[TStmt], tl: List[Expr]) -> Int ! alloc
    tail = tl.get(0)
    if code == 2 && (i < n || lp_none(tail) == 0)
        _a = lp_fail(errs, cx, "unreachable code after `break`")
    if code == 2 || i >= n && lp_none(tail) == 1
        1
    else
        lp_guard(stmts, i, n, flag, cx, errs, out, tl)

# `if flag == 0` around the rest of the block: it runs only if the `if` before it did not break.
fn lp_guard(stmts: List[TStmt], i: Int, n: Int, flag: String, cx: List[Int], errs: List[String], out: List[TStmt], tl: List[Expr]) -> Int ! alloc
    rest = List.new[TStmt]()
    lp_copy_stmts(stmts, i, n, rest)
    tail = tl.get(0)
    lp_push_tail(rest, tail)
    tl.set(0, XNone)
    rb = lp_block(TBlock(rest, XNone), flag, cx, errs)
    _p = out.push(lp_if_stmt(lp_flag_clear(flag), rb, lp_empty(), 0))
    1

fn lp_copy_stmts(stmts: List[TStmt], i: Int, n: Int, out: List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(stmts.get(i))
        lp_copy_stmts(stmts, i + 1, n, out)

fn lp_push_tail(out: List[TStmt], tail: Expr) -> Int ! alloc
    if lp_none(tail) == 1
        0
    else
        _a = out.push(lp_expr_stmt(tail))
        0

# Rewrites one statement into `out`. Returns 1 when it may run a `break` of the enclosing loop (an
# `if`), 2 for a bare `break`, 0 otherwise.
fn lp_stmt(st: TStmt, flag: String, cx: List[Int], errs: List[String], out: List[TStmt]) -> Int ! alloc
    if st.kind == 4
        if flag.len() == 0
            _e = lp_fail(errs, cx, "`break` has to be a statement of a `while` body (or of an `if` block inside it)")
            0
        else
            _p = out.push(lp_set_flag(flag, 1))
            2
    elsif st.kind == 0
        lp_expr_statement(st, flag, cx, errs, out)
    else
        _p = out.push(TStmt(st.kind, st.name, lp_expr(st.expr, cx, errs), st.ty, st.is_let, lp_expr(st.target, cx, errs), st.frozen, st.stack, st.id))
        0

fn lp_expr_statement(st: TStmt, flag: String, cx: List[Int], errs: List[String], out: List[TStmt]) -> Int ! alloc
    match st.expr
        XWhile(c, body) => lp_push_loop(st, lp_while(c, body, out, cx, errs), out)
        XIf(cond, then_b, else_b, has_else, elsifs) => lp_push_if(st, lp_if(cond, then_b, else_b, has_else, elsifs, flag, cx, errs), out, cx)
        _ => lp_push_plain(st, lp_expr(st.expr, cx, errs), out)

fn lp_push_loop(st: TStmt, e: Expr, out: List[TStmt]) -> Int ! alloc
    _p = out.push(TStmt(0, st.name, e, st.ty, st.is_let, st.target, st.frozen, st.stack, st.id))
    0

fn lp_push_plain(st: TStmt, e: Expr, out: List[TStmt]) -> Int ! alloc
    _p = out.push(TStmt(0, st.name, e, st.ty, st.is_let, st.target, st.frozen, st.stack, st.id))
    0

# `cx[1]` holds whether the `if` may break (set by `lp_if`).
fn lp_push_if(st: TStmt, e: Expr, out: List[TStmt], cx: List[Int]) -> Int ! alloc
    out.push(TStmt(0, st.name, e, st.ty, st.is_let, st.target, st.frozen, st.stack, st.id))
    cx.get(1)

# ---- loops ----

# `let flag = 0` (pushed to `out`) + `while flag == 0 { if cond { body } else { flag = 1 } }` when the
# body breaks; the loop itself otherwise.
fn lp_while(cond: Expr, body: TBlock, out: List[TStmt], cx: List[Int], errs: List[String]) -> Expr ! alloc
    c2 = lp_expr(cond, cx, errs)
    n = cx.get(0) + 1
    cx.set(0, n)
    f = "__brk" + n.to_str()
    # The tail of a loop body is discarded: make it a statement.
    b2 = lp_block(lp_unit(body), f, cx, errs)
    if cx.get(1) == 1
        out.push(TStmt(1, f.dup(), XInt(0), "", 1, XNone, 0, 0, 0))
        stop = TBlock(lp_one(lp_set_flag(f, 1)), XNone)
        guarded = TBlock(lp_one(lp_if_stmt(c2, b2, stop, 1)), XNone)
        XWhile(lp_flag_clear(f), guarded)
    else
        XWhile(c2, b2)

fn lp_one(st: TStmt) -> List[TStmt] ! alloc
    xs = List.new[TStmt]()
    xs.push(st)
    xs

# ---- `if` ----

# Rewrites the branches of an `if`; `cx[1]` is left at whether one of them may break.
fn lp_if(cond: Expr, then_b: TBlock, else_b: TBlock, has_else: Int, elsifs: List[TElsif], flag: String, cx: List[Int], errs: List[String]) -> Expr ! alloc
    c2 = lp_expr(cond, cx, errs)
    t2 = lp_block(then_b, flag, cx, errs)
    b1 = cx.get(1)
    arms = List.new[TElsif]()
    b2 = lp_elsifs(elsifs, 0, elsifs.len(), flag, cx, errs, arms)
    if has_else == 1
        e2 = lp_block(else_b, flag, cx, errs)
        b3 = cx.get(1)
        lp_if_done(c2, t2, e2, 1, arms, b1 | b2 | b3, cx)
    else
        lp_if_done(c2, t2, else_b, 0, arms, b1 | b2, cx)

# `lp_if` drops `then_b` on the way out (it is a local the callee only borrows). The
# value returned here has to own a different copy of that block.
fn lp_if_done(cond: Expr, then_b: TBlock, else_b: TBlock, has_else: Int, arms: List[TElsif], broke: Int, cx: List[Int]) -> Expr ! alloc
    cx.set(1, broke)
    tb = tc_block(then_b)
    if broke == 1
        XIf(cond, lp_unit(tb), lp_unit(else_b), has_else, lp_unit_arms(arms, 0, arms.len(), List.new[TElsif]()))
    else
        XIf(cond, tb, else_b, has_else, arms)

fn lp_unit_arms(arms: List[TElsif], i: Int, n: Int, out: List[TElsif]) -> List[TElsif] ! alloc
    if i >= n
        out
    else
        a = arms.get(i)
        out.push(TElsif(a.cond, lp_unit(a.body)))
        lp_unit_arms(arms, i + 1, n, out)

# Appends the rewritten arms to `out`; returns whether one may break.
fn lp_elsifs(xs: List[TElsif], i: Int, n: Int, flag: String, cx: List[Int], errs: List[String], out: List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        c2 = lp_expr(a.cond, cx, errs)
        b2 = lp_block(a.body, flag, cx, errs)
        here = cx.get(1)
        out.push(TElsif(c2, b2))
        here | lp_elsifs(xs, i + 1, n, flag, cx, errs, out)

# ---- expressions ----

# Walks an expression for loops nested in it. A `break` in here is never valid: the blocks start with
# no enclosing loop.
fn lp_expr(e: Expr, cx: List[Int], errs: List[String]) -> Expr ! alloc
    match e
        XBin(op, l, r) => XBin(op, lp_expr(l, cx, errs), lp_expr(r, cx, errs))
        XCall(name, args, targs, xp) => XCall(name, lp_exprs(args, 0, args.len(), List.new[Expr](), cx, errs), targs, xp)
        XTo(place, inner) => XTo(place, lp_expr(inner, cx, errs))
        XOn(place, body, kern, idx) => XOn(place, lp_block(body, "", cx, errs), kern, idx)
        XIf(cond, then_b, else_b, has_else, elsifs) => lp_if(cond, then_b, else_b, has_else, elsifs, "", cx, errs)
        XWhile(cond, body) => lp_while_value(cond, body, cx, errs)
        XField(base, field) => XField(lp_expr(base, cx, errs), field)
        XLambda(param, body) => XLambda(param, lp_expr(body, cx, errs))
        XUnary(op, inner) => XUnary(op, lp_expr(inner, cx, errs))
        XTry(inner) => XTry(lp_expr(inner, cx, errs))
        XMatch(scrut, arms) => XMatch(lp_expr(scrut, cx, errs), lp_arms(arms, 0, arms.len(), List.new[TArm](), cx, errs))
        XNone => XNone
        XInt(v) => XInt(v)
        XFloat(bits, txt) => XFloat(bits, txt)
        XStr(s) => XStr(s)
        XIdent(s) => XIdent(s)
        XTensor(nr, nc, data) => XTensor(nr, nc, data)
        XBool(v) => XBool(v)

# A `while` somewhere that is neither a statement nor a block tail: no place for its flag.
fn lp_while_value(cond: Expr, body: TBlock, cx: List[Int], errs: List[String]) -> Expr ! alloc
    scratch = List.new[TStmt]()
    w = lp_while(cond, body, scratch, cx, errs)
    if scratch.len() > 0
        lp_fail(errs, cx, "`break` has to be a statement of a `while` body (or of an `if` block inside it)")
        w
    else
        w

fn lp_exprs(xs: List[Expr], i: Int, n: Int, out: List[Expr], cx: List[Int], errs: List[String]) -> List[Expr] ! alloc
    if i >= n
        out
    else
        out.push(lp_expr(xs.get(i), cx, errs))
        lp_exprs(xs, i + 1, n, out, cx, errs)

fn lp_arms(xs: List[TArm], i: Int, n: Int, out: List[TArm], cx: List[Int], errs: List[String]) -> List[TArm] ! alloc
    if i >= n
        out
    else
        a = xs.get(i)
        body2 = if a.has_suite == 1
            XNone
        else
            lp_expr(a.body, cx, errs)
        su2 = if a.has_suite == 1
            lp_block(a.suite, "", cx, errs)
        else
            a.suite
        out.push(TArm(a.pat, body2, su2, a.has_suite))
        lp_arms(xs, i + 1, n, out, cx, errs)

# ---- program ----

# The program with every `break` rewritten; the first error goes to `errs`.
fn desugar_break(tp: TProgram, errs: List[String]) -> TProgram ! alloc
    fns = List.new[TFn]()
    lp_fns(tp.fns, 0, tp.fns.len(), fns, errs)
    TProgram(fns, tp.imports, tp.structs, tp.aliases, tp.enums, tp.protocols, tp.consts)

fn lp_fns(xs: List[TFn], i: Int, n: Int, out: List[TFn], errs: List[String]) -> Int ! alloc
    if i >= n
        0
    else
        f = xs.get(i)
        cx = List.new[Int]()
        cx.push(0)
        cx.push(0)
        cx.push(0)
        body = lp_block(f.body, "", cx, errs)
        out.push(TFn(f.name, f.params, body, f.ret, f.no_heap, f.arena, f.fx, f.tparams, f.recv, f.mkind, f.deprecated, f.tyat))
        lp_fns(xs, i + 1, n, out, errs)
