# Builtin calls lowered to C. The tensor path is cir.sal.
import cenv
import cir
import "../ir/tensorops.sal"

fn emit_c_builtin(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "str_as_int" => arg_at(args, 0)
        "str_to_f64_bits" =>
            a0 = arg_at(args, 0)
            "sal_str_to_f64_bits((const char *)(uintptr_t)" + a0 + ")"
        "str_from_int" => arg_at(args, 0)
        "map_new" => "((int64_t)(uintptr_t)sal_map_new())"
        "map_get" =>
            a0 = arg_at(args, 0)
            a1 = arg_at(args, 1)
            "sal_map_get((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ")"
        "map_put" =>
            a0 = arg_at(args, 0)
            a1 = arg_at(args, 1)
            a2 = arg_at(args, 2)
            "sal_map_put((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ", " + a2 + ")"
        "ir_text" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_ir_text((void *)(uintptr_t)" + a0 + "))"
        "lex_src" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_lex_src((const char *)(uintptr_t)" + a0 + "))"
        _ => emit_c_builtin_skip(fname, args, stmts)

fn emit_c_builtin_skip(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "str_skip" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            c = arg_at(args, 2)
            d = arg_at(args, 3)
            "sal_str_skip((const char*)(uintptr_t)" + a + "," + b + "," + c + "," + d + ")"
        "str_hash" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_str_hash((const char*)(uintptr_t)" + a + "," + b + ")"
        _ => emit_c_builtin_rest(fname, args, stmts)

fn emit_c_builtin_rest(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "vec_new" => "((int64_t)(uintptr_t)sal_vec_new())"
        "argv" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_argv(" + a0 + "))"
        "read_file" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_read_file((const char *)(uintptr_t)" + a0 + "))"
        "strdup" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_strdup((const char *)(uintptr_t)" + a0 + "))"
        "tmp_path" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_tmp_path((const char *)(uintptr_t)" + a0 + "))"
        "int_to_str" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_int_to_str(" + a0 + "))"
        "char_to_str" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_char_to_str(" + a0 + "))"
        _ => emit_c_builtin2(fname, args, stmts)

fn emit_c_builtin2(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "str_concat_n" =>
            "((int64_t)(uintptr_t)sal_str_concat_n(" + args.len().to_str() + ",(const char*[]){" + c_str_parts(args, 0, "") + "}))"
        "str_append_n" =>
            a = arg_at(args, 0)
            n = args.len() - 1
            "((int64_t)(uintptr_t)sal_str_append_n((char*)(uintptr_t)" + a + "," + n.to_str() + ",(const char*[]){" + c_str_parts(args, 1, "") + "}))"
        "str_append" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "((int64_t)(uintptr_t)sal_str_append((char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
        "str_concat" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "((int64_t)(uintptr_t)sal_str_concat((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
        "desc_copy" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_desc_copy((const char*)(uintptr_t)" + a + "," + b + ")"
        "str_slice" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            c = arg_at(args, 2)
            "((int64_t)(uintptr_t)sal_str_slice((const char*)(uintptr_t)" + a + "," + b + "," + c + "))"
        "free" =>
            a0 = arg_at(args, 0)
            line = "  sal_free((void*)(uintptr_t)" + a0 + ");\n"
            vec_push(stmts, line.to_int())
            "0"
        "clang" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_clang((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "clang_obj" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_clang_obj((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "link_objs" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_link_objs((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "realpath" =>
            a = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_realpath((const char*)(uintptr_t)" + a + "))"
        "path_readable" =>
            a = arg_at(args, 0)
            "sal_path_readable((const char*)(uintptr_t)" + a + ")"
        _ => emit_c_builtin3(fname, args, stmts)

fn emit_c_builtin3(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "gated_print_str" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_gated_print_str(" + a + ",(const char*)(uintptr_t)" + b + ")"
        "write_file" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_write_file((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "str_eq" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_str_eq((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "str_contains" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_str_contains((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "str_index_of" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_str_index_of((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        "str_index_from" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            c = arg_at(args, 2)
            "sal_str_index_from((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "," + c + ")"
        "str_len" =>
            a = arg_at(args, 0)
            "sal_str_len((const char*)(uintptr_t)" + a + ")"
        _ => emit_c_builtin4(fname, args, stmts)

fn emit_c_builtin4(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "str_char" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_str_char((const char*)(uintptr_t)" + a + "," + b + ")"
        "vec_push" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_vec_push((void*)(uintptr_t)" + a + "," + b + ")"
        "vec_get" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_vec_get((void*)(uintptr_t)" + a + "," + b + ")"
        "vec_set" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            c = arg_at(args, 2)
            "sal_vec_set((void*)(uintptr_t)" + a + "," + b + "," + c + ")"
        "vec_len" =>
            a = arg_at(args, 0)
            "sal_vec_len((void*)(uintptr_t)" + a + ")"
        _ => emit_c_builtin5(fname, args, stmts)

fn emit_c_builtin5(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    match fname
        "vec_free" =>
            a0 = arg_at(args, 0)
            line = "  sal_vec_free((void*)(uintptr_t)" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "list_free" =>
            a0 = arg_at(args, 0)
            line = "  sal_list_free((void*)(uintptr_t)" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "enum_free" =>
            a0 = arg_at(args, 0)
            line = "  sal_enum_free(" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "enum_free_shell" =>
            a0 = arg_at(args, 0)
            line = "  sal_enum_free_shell(" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "list_free_shell" =>
            a0 = arg_at(args, 0)
            line = "  sal_list_free_shell((void*)(uintptr_t)" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "enum_set" => "sal_enum_set(" + arg_at(args, 0) + ", " + arg_at(args, 1) + ", " + arg_at(args, 2) + ")"
        "str_share" => "((int64_t)(uintptr_t)sal_str_share((const char*)(uintptr_t)" + arg_at(args, 0) + "))"
        "list_push_share" => "((int64_t)(uintptr_t)sal_list_push_share((void*)(uintptr_t)" + arg_at(args, 0) + ", " + arg_at(args, 1) + "))"
        "enum_owns" => "sal_enum_owns(" + arg_at(args, 0) + ", " + arg_at(args, 1) + ")"
        "enum_box_id" => "sal_enum_box_id(" + arg_at(args, 0) + ")"
        "list_box_id" => "sal_list_box_id((void *)(uintptr_t)" + arg_at(args, 0) + ")"
        "dict_free" =>
            a0 = arg_at(args, 0)
            line = "  sal_dict_free((void*)(uintptr_t)" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "bytes_free" =>
            a0 = arg_at(args, 0)
            line = "  sal_bytes_free((void*)(uintptr_t)" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "tensor_free" =>
            a0 = arg_at(args, 0)
            line = "  sal_tensor_free(" + a0 + ");\n"
            _p = vec_push(stmts, line)
            "0"
        "not" =>
            a0 = arg_at(args, 0)
            "sal_not(" + a0 + ")"
        "print_str" =>
            a0 = arg_at(args, 0)
            "sal_print_str((const char*)(uintptr_t)" + a0 + ")"
        "eprint_str" =>
            a0 = arg_at(args, 0)
            "sal_eprint_str((const char*)(uintptr_t)" + a0 + ")"
        "print" =>
            a0 = arg_at(args, 0)
            "sal_print_i64(" + a0 + ")"
        "getenv" =>
            a0 = arg_at(args, 0)
            "((int64_t)(uintptr_t)sal_getenv((const char*)(uintptr_t)" + a0 + "))"
        "mkdir_p" =>
            a0 = arg_at(args, 0)
            "sal_mkdir_p((const char*)(uintptr_t)" + a0 + ")"
        "select_str" =>
            c = arg_at(args, 0)
            a = arg_at(args, 1)
            b = arg_at(args, 2)
            "((int64_t)(uintptr_t)sal_select_str(" + c + ",(char*)(uintptr_t)" + a + ",(char*)(uintptr_t)" + b + "))"
        "place_matmul_ai_sum" =>
            a0 = arg_at(args, 0)
            "sal_place_matmul_ai_sum(" + a0 + ")"
        "place_launches" =>
            a0 = arg_at(args, 0)
            "sal_place_launches(" + a0 + ")"
        "image_new" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "((int64_t)(uintptr_t)sal_image_new(" + a + "," + b + "))"
        "write_png" =>
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            c = arg_at(args, 2)
            d = arg_at(args, 3)
            "sal_write_png((const char*)(uintptr_t)" + a + "," + b + "," + c + ",(void*)(uintptr_t)" + d + ")"
        _ => emit_c_runtime_call(fname, args, stmts)

# Any other builtin is the runtime function `sal_<name>`. Values are all
# int64 (pointers included), which matches the x86-64 calling convention, so a
# block-scope unprototyped declaration is enough.
fn emit_c_runtime_call(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    if cir_is_stub(&("sal_" + fname).slice(0, 4 + fname.len())) == 1
        "0"
    elsif fname.eq("syscall") == 1
        emit_c_syscall(args, stmts)
    elsif fname.eq("bytes_get_u8") == 1
        emit_c_bytes_get(args, 1)
    elsif fname.eq("bytes_get_u16") == 1
        emit_c_bytes_get(args, 2)
    elsif fname.eq("bytes_get_u32") == 1
        emit_c_bytes_get(args, 4)
    elsif fname.eq("bytes_get_i64") == 1
        emit_c_bytes_get(args, 8)
    elsif fname.eq("bytes_set_u8") == 1
        emit_c_bytes_set(args, 1)
    elsif fname.eq("bytes_set_u16") == 1
        emit_c_bytes_set(args, 2)
    elsif fname.eq("bytes_set_u32") == 1
        emit_c_bytes_set(args, 4)
    elsif fname.eq("bytes_set_i64") == 1
        emit_c_bytes_set(args, 8)
    else
        emit_c_plain_runtime_call(fname, args, stmts)

fn emit_c_syscall(args: &List[String], stmts: Int) -> String ! alloc
    vec_push(stmts, "  extern int64_t sal_os_syscall();\n".to_int())
    padded = args.clone()
    pad_args(&mut padded, 7)
    acc = "sal_os_syscall("
    acc = join_commas(&padded, 0, padded.len(), acc)
    acc + ")"

# The clone builtins are `sal_<T>_clone_val` (`runtime_call_name` in src/ir.rs), not `sal_<name>`.
fn emit_c_runtime_name(fname: &String) -> String ! alloc
    if fname.eq("list_clone") == 1
        "sal_list_clone_val"
    elsif fname.eq("dict_clone") == 1
        "sal_dict_clone_val"
    elsif fname.eq("bytes_clone") == 1
        "sal_bytes_clone_val"
    elsif fname.eq("enum_copy") == 1
        "sal_enum_copy"
    else
        "sal_" + fname

fn emit_c_plain_runtime_call(fname: &String, args: &List[String], stmts: Int) -> String ! alloc
    rname = emit_c_runtime_name(fname)
    vec_push(stmts, ("  extern int64_t " + rname + "();\n").to_int())
    acc = "((int64_t)" + rname + "("
    acc = join_commas(args, 0, args.len(), acc)
    acc + "))"

# `(const char*)(uintptr_t)a, …` for the parts of a string chain, from `args[i]` on.
fn c_str_parts(args: &List[String], i: Int, acc: String) -> String ! alloc
    if i >= args.len()
        acc
    else
        sep = if acc.len() == 0
            ""
        else
            ","
        c_str_parts(args, i + 1, acc + sep + "(const char*)(uintptr_t)" + args.get(i).clone())
