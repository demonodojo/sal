# IR → C for functions that touch tensors.
import "../ast/tast.sal"
import "../ast/tir.sal"
import cenv
import lit_pool
import "../ir/tensorops.sal"
import "../pkg/qualify.sal"

# ---- IR -> C (functions that touch tensors) ----
# Context: [literals, user, locals, consts, floats, strs, lines, quirk_out, quirk_n, uid, is_main,
# fills, first literal id]. `literals` are the string literals this function asked for, in order;
# `cir_commit_lits` declares them in the pool once the function is done.
fn cc_new(pool: &LitPool, user: Int, is_main: Int) -> Int ! alloc
    c = vec_new()
    vec_push(c, vec_new())
    vec_push(c, user)
    _c = vec_push(c, vec_new())
    vec_push(c, map_new())
    vec_push(c, map_new())
    vec_push(c, map_new())
    vec_push(c, vec_new())
    vec_push(c, 0)
    vec_push(c, 0)
    vec_push(c, 0)
    vec_push(c, is_main)
    vec_push(c, map_new())
    vec_push(c, pool.nid)
    c

fn cc_line(cc: Int, s: &String) -> Int ! alloc
    kept = s.dup()
    vec_push(vec_get(cc, 6), str_as_int(&kept))

fn cc_uid(cc: Int) -> Int ! alloc
    n = vec_get(cc, 9) + 1
    vec_set(cc, 9, n)
    n

fn cir_is_num(s: &String) -> Int ! alloc
    if s.len() == 0
        0
    else
        c = s.char(0)
        if c >= 48
            if c <= 57
                1
            else
                0
        elsif c == 45
            if s.len() > 1
                1
            else
                0
        else
            0

# C expression of the literal `s` in this function. The name is the pool's next free
# `sal_lit_N` after the ones this function already asked for, so `cir_commit_lits` declares
# it under that same name.
fn cir_lit(cc: Int, s: &String) -> String ! alloc
    lits = vec_get(cc, 0)
    idx = cir_lit_find(lits, s, 0, vec_len(lits))
    if idx >= 0
        lit_ref(&cir_lit_sym(cc, idx))
    else
        vec_push(lits, str_as_int(&s.dup()))
        lit_ref(&cir_lit_sym(cc, vec_len(lits) - 1))

fn cir_lit_sym(cc: Int, idx: Int) -> String ! alloc
    "sal_lit_" + (vec_get(cc, 12) + idx + 1).to_str()

fn cir_lit_find(lits: Int, s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_eq(vec_get(lits, i), str_as_int(s)) == 1
        i
    else
        cir_lit_find(lits, s, i + 1, n)

# Declares the literals of `cc` in the pool and frees their copies.
fn cir_commit_lits(cc: Int, pool: &mut LitPool) -> Int ! alloc
    lits = vec_get(cc, 0)
    cir_commit_lits_go(lits, pool, 0, vec_len(lits))

fn cir_commit_lits_go(lits: Int, pool: &mut LitPool, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        s = str_from_int(vec_get(lits, i))
        pool.declare(&s)
        if s.len() > 0
            _f = free(s)
        cir_commit_lits_go(lits, pool, i + 1, n)

# An IR operand as a C int64 expression.
fn cir_op(cc: Int, a: Int) -> String ! alloc
    s = str_from_int(a)
    if s.len() == 0
        "0"
    elsif s.char(0) == 34
        inner = s.slice(1, s.len() - 1)
        cir_lit(cc, &inner)
    elsif cir_is_num(&s) == 1
        s + "LL"
    elsif names_has(vec_get(cc, 2), a, 0, vec_len(vec_get(cc, 2))) == 1
        s.dup()
    else
        "0"

fn cir_ops(cc: Int, args: Int, i: Int, n: Int, out: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(cir_op(cc, vec_get(args, i)))
        cir_ops(cc, args, i + 1, n, out)

# Static value of an operand when it is a literal or a known constant.
fn cir_const(cc: Int, a: Int) -> Int ! alloc
    s = str_from_int(a)
    if cir_is_num(&s) == 1
        ts_dim(&s)
    else
        map_get(vec_get(cc, 3), a)

fn cir_decl(cc: Int, name: &String) -> Int ! alloc
    cc_line(cc, &("  extern int64_t R_" + cir_cname(name) + "() __asm__(\"" + name + "\");\n"))

# A C identifier for a symbol name (`drop.Parser` -> `drop_Parser`).
fn cir_cname(name: &String) -> String ! alloc
    str_replace_chr(name, 46, &"_")

# Calls the runtime function `name` (symbol aliased to R_<name> so it never
# clashes with the prototypes in the prelude).
fn cir_rt(cc: Int, name: &String, ops: &List[String]) -> String ! alloc
    cir_decl(cc, name)
    acc = "R_" + cir_cname(name) + "("
    # A string chain passes its parts as a count and an array (`sal_str_concat_n(n, parts)`,
    # `sal_str_append_n(acc, n, parts)`); the IR lists them as plain arguments.
    match name
        "sal_str_concat_n" => acc + cir_str_parts(ops, 0) + ")"
        "sal_str_append_n" => acc + ops.get(0).clone() + ", " + cir_str_parts(ops, 1) + ")"
        _ => join_commas(ops, 0, ops.len(), acc) + ")"

# `<n>LL, (const char*[]){…}` for the operands from `ops[from]` on (64-bit count: `R_*` has no
# prototype).
fn cir_str_parts(ops: &List[String], from: Int) -> String ! alloc
    (ops.len() - from).to_str() + "LL, (const char*[]){" + cir_str_casts(ops, from, "") + "}"

fn cir_str_casts(ops: &List[String], i: Int, acc: String) -> String ! alloc
    if i >= ops.len()
        acc
    else
        sep = if acc.len() == 0
            ""
        else
            ", "
        cir_str_casts(ops, i + 1, acc + sep + "(const char*)(uintptr_t)" + ops.get(i).clone())

fn cir_set(cc: Int, dest: Int, rhs: &String) -> Int ! alloc
    cc_line(cc, &("  " + str_from_int(dest) + " = " + rhs + ";\n"))

# Tensor buffers: a 16-byte header holds the element count before the data.
fn cir_tn_alloc(n: &String) -> String ! alloc
    "((int64_t)(uintptr_t)sal_tn_alloc(" + n + "))"

# A handle for an operand text that outlives the typed IR (0 for the empty text).
fn ih(s: &String) -> Int ! alloc
    if s.len() == 0
        0
    else
        s.dup().to_int()

fn ih_vec(xs: &List[String], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        vec_push(out, ih(&xs.get(i)))
        ih_vec(xs, i + 1, n, out)

fn cir_call(cc: Int, inst: &Inst) -> Int ! alloc
    dest = ih(&inst.dest)
    fname = inst.s1.clone()
    args = ih_vec(&inst.strs, 0, inst.strs.len(), vec_new())
    ops = List.new[String]()
    cir_ops(cc, args, 0, vec_len(args), &mut ops)
    if inst.n1 == 0
        if cir_is_list_glue_call(&fname) == 1
            cir_list_glue_call(cc, &fname, args)
        else
            cir_call_free(cc, &fname, &ops)
    elsif cir_shaped_call(&fname, inst.n2) == 1
        cir_shaped(cc, &inst.dest, &fname, &ops, inst.n2)
    else
        cir_call_dest(cc, dest, &fname, args, &ops)

# Calls that carry a tensor shape (`ir_call_shaped`): the shape handle is non-zero.
fn cir_shaped_call(fname: &String, shape: Int) -> Int ! alloc
    if shape == 0
        0
    elsif fname.eq("sal_softmax_axis_f32") == 1
        1
    elsif fname.eq("sal_reduce") == 1
        1
    elsif fname.eq("sal_relu") == 1
        1
    else
        0

fn cir_shaped(cc: Int, dest: &String, fname: &String, ops: &List[String], shape: Int) -> Int ! alloc
    match fname
        "sal_softmax_axis_f32" => cir_softmax_axis(cc, dest, ops, shape)
        "sal_relu" => cir_relu(cc, dest, ops, shape)
        _ => cir_reduce(cc, dest, ops, shape)

# `relu` of a buffer whose shape is not known at compile time panics, as the bootstrap does.
fn cir_relu(cc: Int, dest: &String, ops: &List[String], shape: Int) -> Int ! alloc
    input = cir_arg(ops, 0)
    if vec_get(shape, 0) < 0
        cc_line(cc, &"  { extern void sal_panic(const char *); sal_panic(\"tensor op needs a shape known at compile time\"); }\n")
        cir_set(cc, dest.to_int(), &"0")
    else
        n = "sal_tn_len(" + input + ")"
        cc_line(cc, &("  " + dest + " = " + cir_tn_alloc(&n) + ";\n"))
        vv = cir_vec3(dest, &input, &n)
        _b = cc_line(cc, &("  " + cir_call_expr(cc, &"sal_relu_f32", &vv) + ";\n"))
        0

# `softmax` over the last axis of a matrix, in place: the kernel takes (rows, row length). Unknown
# shapes are one row of the whole buffer (the bootstrap leaves them to the length of the input).
fn cir_softmax_axis(cc: Int, dest: &String, ops: &List[String], shape: Int) -> Int ! alloc
    input = cir_arg(ops, 0)
    rows = vec_get(shape, 0)
    cols = vec_get(shape, 1)
    cc_line(cc, &"  extern void sal_softmax_axis_f32(float *, int64_t, int64_t);\n")
    if rows < 0
        _y = cc_line(cc, &("  sal_softmax_axis_f32((float *)(uintptr_t)" + input + ", 1, sal_tn_len(" + input + "));\n"))
    else
        _y = cc_line(cc, &("  sal_softmax_axis_f32((float *)(uintptr_t)" + input + ", " + int_to_str(rows) + ", " + int_to_str(cols) + ");\n"))
    cir_set(cc, dest.to_int(), &input)

# `reduce` of a matrix along an axis (`(outer, axis_len, inner)` as the bootstrap computes it);
# the result is a fresh buffer of `outer * inner` floats. A shape or axis that does not fit is taken as
# the whole buffer (one row).
fn cir_reduce(cc: Int, dest: &String, ops: &List[String], shape: Int) -> Int ! alloc
    input = cir_arg(ops, 0)
    rows = vec_get(shape, 0)
    cols = vec_get(shape, 1)
    axis = vec_get(shape, 2)
    outer = 1
    alen = sal_tn_len_text(&input)
    inner = 1
    if rows < 0
        _z = 0
    elsif axis == 0 - 1
        alen = int_to_str(rows * cols)
    elsif axis == 0
        alen = int_to_str(rows)
        inner = cols
    elsif axis == 1
        outer = rows
        alen = int_to_str(cols)
    else
        _z = 0
    cc_line(cc, &"  extern void sal_reduce_strided_f32(const float *, float *, int64_t, int64_t, int64_t);\n")
    cc_line(cc, &("  " + dest + " = (int64_t)(uintptr_t)sal_tn_alloc(" + int_to_str(outer * inner) + ");\n"))
    cc_line(cc, &("  sal_reduce_strided_f32((const float *)(uintptr_t)" + input + ", (float *)(uintptr_t)" + dest + ", " + int_to_str(outer) + ", " + alen + ", " + int_to_str(inner) + ");\n"))

fn sal_tn_len_text(input: &String) -> String ! alloc
    "sal_tn_len(" + input + ")"

# `sal_list_set_drop(l, drop.elem.T)` and `sal_list_set_clone(l, clone.T)`: the second operand
# names a glue function, not a value. It goes as a function pointer of the type the runtime
# takes, and the symbol is declared before use (its definition comes later in the file).
fn cir_is_list_glue_call(fname: &String) -> Int ! alloc
    if str_eq(fname, "sal_list_set_drop") + str_eq(fname, "sal_list_set_clone") > 0
        1
    else
        0

fn cir_list_glue_call(cc: Int, fname: &String, args: Int) -> Int ! alloc
    ops = List.new[String]()
    ops.push(cir_op(cc, vec_get(args, 0)))
    cast = if str_eq(fname, "sal_list_set_clone") == 1
        "(int64_t (*)(int64_t))"
    else
        "(void (*)(int64_t))"
    ops.push(cast + cir_glue_symbol(cc, &str_from_int(vec_get(args, 1))))
    cc_line(cc, &("  " + cir_rt(cc, fname, &ops) + ";\n"))

# A glue symbol (`drop.<T>`, `drop.elem.<T>`, `clone.<T>`, `sal_list_free_elem`) as C: declared
# with its asm label, so the reference resolves to the definition emitted later.
fn cir_glue_symbol(cc: Int, name: &String) -> String ! alloc
    cir_decl(cc, name)
    "R_" + cir_cname(name)

fn cir_call_free(cc: Int, fname: &String, ops: &List[String]) -> Int ! alloc
    cc_line(cc, &("  " + cir_call_expr(cc, fname, ops) + ";\n"))

fn cir_call_expr(cc: Int, fname: &String, ops: &List[String]) -> String ! alloc
    if names_has(vec_get(cc, 1), fname.to_int(), 0, vec_len(vec_get(cc, 1))) == 1
        acc = mangled(fname) + "("
        join_commas(ops, 0, ops.len(), acc) + ")"
    else
        cir_rt(cc, fname, ops)

fn cir_arg(ops: &List[String], i: Int) -> String ! alloc
    arg_at(ops, i)

fn cir_call_dest(cc: Int, dest: Int, fname: &String, args: Int, ops: &List[String]) -> Int ! alloc
    str_from_int(dest)
    if names_has(vec_get(cc, 1), fname.to_int(), 0, vec_len(vec_get(cc, 1))) == 1
        cir_set(cc, dest, &cir_call_expr(cc, fname, ops))
        _b = map_put(vec_get(cc, 5), dest, 0)
        0
    elsif fname.eq("sal_matmul_f32") == 1
        cir_matmul(cc, dest, args, ops)
    elsif fname.eq("sal_rope") == 1
        argv = List.new[String]()
        argv.push(cir_arg(ops, 0))
        argv.push(cir_arg(ops, 1))
        argv.push(cir_arg(ops, 2))
        argv.push(cir_arg(ops, 3))
        _b = cc_line(cc, &("  " + cir_rt(cc, &"sal_rope_f32", &argv) + ";\n"))
        cir_set(cc, dest, &cir_arg(ops, 0))
    else
        cir_call_dest2(cc, dest, fname, args, ops)

fn cir_call_dest2(cc: Int, dest: Int, fname: &String, args: Int, ops: &List[String]) -> Int ! alloc
    d = str_from_int(dest)
    if fname.eq("sal_silu") == 1
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, &("  " + d + " = " + cir_tn_alloc(&n) + ";\n"))
        vv = cir_vec3(&d, &cir_arg(ops, 0), &n)
        _b = cc_line(cc, &("  " + cir_call_expr(cc, &"sal_silu_f32", &vv) + ";\n"))
        0
    elsif fname.eq("sal_relu") == 1
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, &("  " + d + " = " + cir_tn_alloc(&n) + ";\n"))
        vv = cir_vec3(&d, &cir_arg(ops, 0), &n)
        _b = cc_line(cc, &("  " + cir_call_expr(cc, &"sal_relu_f32", &vv) + ";\n"))
        0
    elsif fname.eq("sal_rms_norm") == 1
        # The epsilon is the bootstrap's literal (1e-5), passed as a double.
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, &("  " + d + " = " + cir_tn_alloc(&n) + ";\n"))
        _b = cc_line(cc, &"  extern void sal_rms_norm_f32(float *, const float *, const float *, int64_t, double);\n")
        _c = cc_line(cc, &("  sal_rms_norm_f32((float *)(uintptr_t)" + d + ", (const float *)(uintptr_t)" + cir_arg(ops, 0) + ", (const float *)(uintptr_t)" + cir_arg(ops, 1) + ", " + n + ", 1e-5);\n"))
        0
    elsif fname.eq("sal_transpose_f32") == 1
        n = "(" + cir_arg(ops, 1) + " * " + cir_arg(ops, 2) + ")"
        _a = cc_line(cc, &("  " + d + " = " + cir_tn_alloc(&n) + ";\n"))
        v4 = cir_vec3(&d, &cir_arg(ops, 0), &cir_arg(ops, 1))
        v4.push(cir_arg(ops, 2))
        _b = cc_line(cc, &("  " + cir_call_expr(cc, &"sal_transpose_f32", &v4) + ";\n"))
        0
    elsif fname.eq("sal_softmax") == 1
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        vv = cir_vec2(&cir_arg(ops, 0), &n)
        _a = cc_line(cc, &("  " + cir_call_expr(cc, &"sal_softmax_f32", &vv) + ";\n"))
        cir_set(cc, dest, &cir_arg(ops, 0))
    elsif fname.eq("sal_argmax") == 1
        vv = cir_vec2(&cir_arg(ops, 0), &cir_arg(ops, 1))
        cir_set(cc, dest, &cir_call_expr(cc, &"sal_argmax_axis_f32", &vv))
    elsif fname.eq("sal_attention_f32") == 1
        cir_attention(cc, dest, ops)
    elsif fname.eq("sal_load") == 1
        vv = cir_vec2(&cir_arg(ops, 0), &"(int64_t)&__n")
        _a = cc_line(cc, &("  { int64_t __n = 0; int64_t __b = " + cir_rt(cc, &"sal_load_f32", &vv) + "; " + d + " = (int64_t)(uintptr_t)sal_tn_from(__b, __n); }\n"))
        0
    elsif cir_is_stub(fname) == 1
        cir_set(cc, dest, &"0")
    elsif fname.eq("sal_tensor_free") == 1
        # A tensor handle points past the 16-byte header `sal_tn_alloc` puts before the data.
        h = cir_arg(ops, 0)
        cir_set(cc, dest, &("(" + h + " ? " + cir_rtc(cc, &"sal_tensor_free", &("(" + h + ") - 16")) + " : 0)"))
    elsif fname.eq("sal_print") == 1
        cir_print(cc, dest, args, ops)
    elsif fname.eq("sal_syscall") == 1
        vv = cir_pad7(ops)
        cir_set(cc, dest, &cir_rt(cc, &"sal_os_syscall", &vv))
    elsif fname.eq("sal_bytes_get_u8") == 1
        cir_set(cc, dest, &emit_c_bytes_get(ops, 1))
    elsif fname.eq("sal_bytes_get_u16") == 1
        cir_set(cc, dest, &emit_c_bytes_get(ops, 2))
    elsif fname.eq("sal_bytes_get_u32") == 1
        cir_set(cc, dest, &emit_c_bytes_get(ops, 4))
    elsif fname.eq("sal_bytes_get_i64") == 1
        cir_set(cc, dest, &emit_c_bytes_get(ops, 8))
    elsif fname.eq("sal_bytes_set_u8") == 1
        cir_set(cc, dest, &emit_c_bytes_set(ops, 1))
    elsif fname.eq("sal_bytes_set_u16") == 1
        cir_set(cc, dest, &emit_c_bytes_set(ops, 2))
    elsif fname.eq("sal_bytes_set_u32") == 1
        cir_set(cc, dest, &emit_c_bytes_set(ops, 4))
    elsif fname.eq("sal_bytes_set_i64") == 1
        cir_set(cc, dest, &emit_c_bytes_set(ops, 8))
    else
        cir_set(cc, dest, &("(int64_t)" + cir_rt(cc, fname, ops)))

fn cir_vec2(a: &String, b: &String) -> List[String] ! alloc
    v = List.new[String]()
    v.push(a.clone())
    v.push(b.clone())
    v

fn cir_vec3(a: &String, b: &String, c: &String) -> List[String] ! alloc
    v = cir_vec2(a, b)
    v.push(c.clone())
    v

fn cir_pad7(ops: &List[String]) -> List[String] ! alloc
    v = ops.clone()
    pad_args(&mut v, 7)
    v

# `print` as the bootstrap's backend: a literal or a known integer constant prints the integer,
# any other value is a String.
fn cir_print(cc: Int, dest: Int, args: Int, ops: &List[String]) -> Int ! alloc
    if vec_len(args) > 0
        a = vec_get(args, 0)
        s = str_from_int(a)
        if cir_is_num(&s) == 1 || map_get(vec_get(cc, 11), a) == 1
            cir_set(cc, dest, &("(int64_t)" + cir_rt(cc, &"sal_print_i64", ops)))
        else
            cir_set(cc, dest, &("(int64_t)" + cir_rt(cc, &"sal_print_str", ops)))
    else
        cir_set(cc, dest, &"0")

fn cir_matmul(cc: Int, dest: Int, args: Int, ops: &List[String]) -> Int ! alloc
    d = str_from_int(dest)
    m = cir_arg(ops, 2)
    k = cir_arg(ops, 3)
    n = cir_arg(ops, 4)
    cc_line(cc, &("  " + d + " = " + cir_tn_alloc(&("(" + m + ") * (" + n + ")")) + ";\n"))
    argv = List.new[String]()
    argv.push(cir_arg(ops, 0))
    argv.push(cir_arg(ops, 1))
    argv.push(d.clone())
    argv.push(m)
    argv.push(k)
    argv.push(n)
    cc_line(cc, &("  " + cir_rt(cc, &"sal_matmul_f32", &argv) + ";\n"))
    mv = cir_const(cc, vec_get(args, 2))
    nv = cir_const(cc, vec_get(args, 4))
    if mv > 0 && nv > 0 && mv * nv <= 16
        vec_set(cc, 7, dest)
        vec_set(cc, 8, mv * nv)
    else
        0

fn cir_attention(cc: Int, dest: Int, ops: &List[String]) -> Int ! alloc
    d = str_from_int(dest)
    n = "(" + cir_arg(ops, 3) + ") * (" + cir_arg(ops, 4) + ") * (" + cir_arg(ops, 6) + ")"
    cc_line(cc, &("  " + d + " = " + cir_tn_alloc(&n) + ";\n"))
    argv = List.new[String]()
    argv.push(d.clone())
    argv.push(cir_arg(ops, 0))
    argv.push(cir_arg(ops, 1))
    argv.push(cir_arg(ops, 2))
    argv.push(cir_arg(ops, 3))
    argv.push(cir_arg(ops, 4))
    argv.push(cir_arg(ops, 5))
    argv.push(cir_arg(ops, 6))
    argv.push(cir_arg(ops, 7))
    guard = "(" + cir_arg(ops, 0) + ") && (" + cir_arg(ops, 1) + ") && (" + cir_arg(ops, 2) + ")"
    cc_line(cc, &("  if (" + guard + ") " + cir_rt(cc, &"sal_attention_f32", &argv) + ";\n"))

fn cir_tbin(cc: Int, inst: &Inst) -> Int ! alloc
    dest = ih(&inst.dest)
    op = inst.s1.clone()
    d = inst.dest.clone()
    len = cir_op(cc, ih(&inst.s5))
    left = cir_op(cc, ih(&inst.s3))
    right = cir_op(cc, ih(&inst.s4))
    scalar = inst.n2
    sval = "0"
    rarg = right
    if scalar == 1
        sval = cir_float_text(cc, ih(&inst.s4))
        rarg = "0"
    code = cir_tbin_code(&op)
    is_cmp = cir_tbin_is_cmp(&op)
    elem_sz = select_str(is_cmp, "1", "4")
    cc_line(cc, &("  " + d + " = (int64_t)(uintptr_t)sal_tn_alloc_bytes(" + len + ", " + elem_sz + ");\n"))
    argv = List.new[String]()
    argv.push(int_to_str(code))
    argv.push(d.dup())
    argv.push(left)
    argv.push(rarg)
    argv.push(len)
    argv.push(int_to_str(scalar))
    argv.push(sval)
    fn_name = select_str(is_cmp, "sal_tensor_cmp_f32", "sal_tensor_bin_f32")
    cc_line(cc, &("  " + cir_rt_dbl(cc, &fn_name, &argv) + ";\n"))

# The scalar operand is a double; it goes through a typed prototype.
fn cir_rt_dbl(cc: Int, name: &String, ops: &List[String]) -> String ! alloc
    cc_line(cc, &("  extern void R_" + cir_cname(name) + "(int, void *, void *, void *, int64_t, int, double) __asm__(\"" + name + "\");\n"))
    "R_" + cir_cname(name) + "((int)" + arg_at(ops, 0) + ", (void *)(uintptr_t)" + arg_at(ops, 1) + ", (void *)(uintptr_t)" + arg_at(ops, 2) + ", (void *)(uintptr_t)" + arg_at(ops, 3) + ", " + arg_at(ops, 4) + ", " + arg_at(ops, 5) + ", " + arg_at(ops, 6) + ")"

fn cir_float_text(cc: Int, a: Int) -> String ! alloc
    t = map_get(vec_get(cc, 4), a)
    if t != 0
        str_from_int(t)
    else
        c = map_get(vec_get(cc, 3), a)
        int_to_str(c)

# `neg` over a tensor: the runtime kernel writes a fresh buffer of `len` floats.
fn cir_tun(cc: Int, inst: &Inst) -> Int ! alloc
    d = inst.dest.clone()
    input = cir_op(cc, ih(&inst.s3))
    len = cir_op(cc, ih(&inst.s5))
    cc_line(cc, &("  " + d + " = (int64_t)(uintptr_t)sal_tn_alloc(" + len + ");\n"))
    cc_line(cc, &"  extern void sal_tensor_neg_f32(float *, const float *, int64_t);\n")
    cc_line(cc, &("  sal_tensor_neg_f32((float *)(uintptr_t)" + d + ", (const float *)(uintptr_t)" + input + ", " + len + ");\n"))

fn cir_tbin_code(op: &String) -> Int ! alloc
    match op
        "add" => 0
        "sub" => 1
        "mul" => 2
        "div" => 3
        "eq" => 4
        "ne" => 5
        "lt" => 6
        "le" => 7
        "gt" => 8
        "ge" => 9
        _ => 0

fn cir_tbin_is_cmp(op: &String) -> Int ! alloc
    if cir_tbin_code(op) >= 4
        1
    else
        0

fn cir_insts(cc: Int, insts: &List[Inst], i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        cir_inst(cc, &insts.get(idx))
        idx = idx + 1
    0

fn cir_inst(cc: Int, inst: &Inst) -> Int ! alloc
    k = inst.kind
    dest = ih(&inst.dest)
    if k == II_CI()
        _m = map_put(vec_get(cc, 3), dest, inst.n1)
        _k = map_put(vec_get(cc, 11), dest, 1)
        cir_set(cc, dest, &inst.n1.to_str())
    elsif k == II_CS()
        _m = map_put(vec_get(cc, 5), dest, 1)
        cir_set(cc, dest, &cir_lit(cc, &inst.s1))
    elsif k == II_CF()
        _m = map_put(vec_get(cc, 4), dest, inst.s1.dup().to_int())
        cir_set(cc, dest, &("(int64_t)" + inst.n1.to_str() + "LL"))
    elsif k == II_BIN()
        cir_binary(cc, dest, &inst.s1, &cir_op(cc, ih(&inst.s2)), &cir_op(cc, ih(&inst.s3)))
    elsif k == II_CALL()
        cir_call(cc, inst)
    elsif k == II_TBIN()
        cir_tbin(cc, inst)
    elsif k == II_TUN()
        cir_tun(cc, inst)
    elsif k == II_REBIND()
        cir_set(cc, dest, &cir_op(cc, ih(&inst.s1)))
    elsif k == II_PLACE()
        cir_set(cc, dest, &("(int64_t)(uintptr_t)sal_tn_copy(" + cir_op(cc, ih(&inst.s1)) + ")"))
    elsif k == II_DROP()
        0
    elsif k == II_RET()
        cir_ret(cc, ih(&inst.s1))
    elsif k == II_IF()
        cir_if(cc, inst)
    elsif k == II_WHILE()
        cir_while(cc, inst)
    elsif k == II_AGG()
        cir_agg(cc, inst)
    elsif k == II_EXTRACT()
        cir_set(cc, dest, &("((int64_t *)(uintptr_t)(" + cir_op(cc, ih(&inst.s1)) + "))[" + inst.n1.to_str() + "]"))
    elsif k == II_EMAKE()
        cir_emake(cc, dest, inst)
    elsif k == II_EFIELD()
        cir_set(cc, dest, &cir_rtc(cc, &"sal_enum_field", &(cir_op(cc, ih(&inst.s1)) + ", " + inst.n1.to_str())))
    elsif k == II_ETAG()
        cir_set(cc, dest, &cir_rtc(cc, &"sal_enum_tag", &cir_op(cc, ih(&inst.s1))))
    elsif k == II_SWITCH()
        cir_switch(cc, dest, inst)
    elsif k == II_ANYBOX()
        cir_anybox(cc, dest, inst)
    elsif k == II_ANYCALL()
        cir_anycall(cc, dest, inst)
    else
        0

fn cir_anybox(cc: Int, dest: Int, inst: &Inst) -> Int ! alloc
    vt = "(int64_t)(uintptr_t)" + inst.s1
    pl = cir_op(cc, ih(&inst.s2))
    expr = "sal_any_box(" + vt + ", " + inst.n1.to_str() + ", " + pl + ")"
    cir_set(cc, dest, &expr)

fn cir_anycall(cc: Int, dest: Int, inst: &Inst) -> Int ! alloc
    recv = cir_op(cc, ih(&inst.s1))
    argc = inst.strs.len()
    args = ih_vec(&inst.strs, 0, argc, vec_new())
    ops = List.new[String]()
    cir_ops(cc, args, 0, vec_len(args), &mut ops)
    a0 = cir_arg(&ops, 0)
    a1 = cir_arg(&ops, 1)
    a2 = cir_arg(&ops, 2)
    a3 = cir_arg(&ops, 3)
    expr = "sal_any_call(" + recv + ", " + inst.n1.to_str() + ", " + argc.to_str() + ", " + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")"
    if dest == 0
        cc_line(cc, &("  " + expr + ";\n"))
    else
        cir_set(cc, dest, &expr)

fn cir_agg(cc: Int, inst: &Inst) -> Int ! alloc
    fields = ih_vec(&inst.strs, 0, inst.strs.len(), vec_new())
    ops = List.new[String]()
    cir_ops(cc, fields, 0, vec_len(fields), &mut ops)
    cir_set(cc, ih(&inst.dest), &emit_c_struct_ctor(&ops))

fn cir_ret(cc: Int, v: Int) -> Int ! alloc
    q = vec_get(cc, 7)
    val = cir_op(cc, v)
    if q != 0
        if vec_get(cc, 10) == 1
            out = str_from_int(q)
            val = "({ double __s = 0; float *__o = (float *)(uintptr_t)" + out + "; for (int __i = 0; __i < " + vec_get(cc, 8).to_str() + "; __i++) __s += __o[__i]; (int64_t)__s; })"
    if vec_get(cc, 10) == 1
        cc_line(cc, &("  return (int)(" + val + ");\n"))
    else
        cc_line(cc, &("  return " + val + ";\n"))

fn cir_if(cc: Int, inst: &Inst) -> Int ! alloc
    dest = ih(&inst.dest)
    cc_line(cc, &("  if (" + cir_op(cc, ih(&inst.s1)) + ") {\n"))
    cir_insts(cc, &inst.b1, 0, inst.b1.len())
    cir_if_assign(cc, dest, ih(&inst.s2))
    cir_carry_assign(cc, &inst.rows, 0, 1)
    cc_line(cc, &"  } else {\n")
    cir_insts(cc, &inst.b2, 0, inst.b2.len())
    cir_if_assign(cc, dest, ih(&inst.s3))
    cir_carry_assign(cc, &inst.rows, 0, 2)
    cc_line(cc, &"  }\n")

fn cir_if_assign(cc: Int, dest: Int, val: Int) -> Int ! alloc
    if dest == 0
        0
    elsif val == 0
        0
    else
        cir_set(cc, dest, &cir_op(cc, val))

# Carried values: `which` selects the then (1) or else (2) source slot.
fn cir_carry_assign(cc: Int, carried: &List[Inst], i: Int, which: Int) -> Int ! alloc
    idx = i
    n = carried.len()
    while idx < n
        c = carried.get(idx)
        if which == 1
            cir_set(cc, ih(&c.dest), &cir_op(cc, ih(&c.s1)))
        else
            cir_set(cc, ih(&c.dest), &cir_op(cc, ih(&c.s2)))
        idx = idx + 1
    0

fn cir_while(cc: Int, inst: &Inst) -> Int ! alloc
    cir_carry_assign(cc, &inst.rows, 0, 1)
    cc_line(cc, &"  while (1) {\n")
    cir_insts(cc, &inst.b1, 0, inst.b1.len())
    cc_line(cc, &("  if (!(" + cir_op(cc, ih(&inst.s1)) + ")) break;\n"))
    cir_insts(cc, &inst.b2, 0, inst.b2.len())
    cir_carry_assign(cc, &inst.rows, 0, 2)
    cc_line(cc, &"  }\n")

# ---- locals ----
fn cir_add_local(cc: Int, name: Int) -> Int ! alloc
    if name == 0
        0
    elsif names_has(vec_get(cc, 2), name, 0, vec_len(vec_get(cc, 2))) == 1
        0
    else
        vec_push(vec_get(cc, 2), name)

# A call to the runtime function `name` with the already rendered argument text.
fn cir_rtc(cc: Int, name: &String, args: &String) -> String ! alloc
    cir_decl(cc, name)
    "(int64_t)R_" + cir_cname(name) + "(" + args + ")"

# `EnumMake`: a payload-less first variant is 0, any other payload-less one its index + 1; a
# variant with a payload is a block `[tag, fields…]` (`sal_enum_new`), the tag carrying the owned
# mask in its high bits.
fn cir_emake(cc: Int, dest: Int, inst: &Inst) -> Int ! alloc
    n = inst.strs.len()
    base = if n == 0 && inst.n1 == 0
        0
    else
        inst.n1 + 1
    tag = base + inst.n2 * 256
    if n == 0
        cir_set(cc, dest, &tag.to_str())
    else
        cir_set(cc, dest, &cir_rtc(cc, &"sal_enum_new", &(tag.to_str() + ", " + n.to_str())))
        cir_emake_fields(cc, dest, inst, 0, n)

fn cir_emake_fields(cc: Int, dest: Int, inst: &Inst, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        args = str_from_int(dest) + ", " + i.to_str() + ", " + cir_op(cc, ih(&inst.strs.get(i)))
        cc_line(cc, &("  " + cir_rtc(cc, &"sal_enum_set", &args) + ";\n"))
        cir_emake_fields(cc, dest, inst, i + 1, n)

# `Switch`: the arms are `case <tag>:` blocks over `sal_enum_tag(scrut)`; the default is the
# `_` arm. Each branch leaves its value in `dest`.
fn cir_switch(cc: Int, dest: Int, inst: &Inst) -> Int ! alloc
    tagc = cir_rtc(cc, &"sal_enum_tag", &cir_op(cc, ih(&inst.s1)))
    cc_line(cc, &("  switch (" + tagc + ") {\n"))
    cir_switch_arms(cc, dest, &inst.rows, 0, inst.rows.len())
    cc_line(cc, &"  default: {\n")
    cir_insts(cc, &inst.b1, 0, inst.b1.len())
    cir_if_assign(cc, dest, ih(&inst.s2))
    cc_line(cc, &"  break;\n  }\n  }\n")

fn cir_switch_arms(cc: Int, dest: Int, arms: &List[Inst], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = arms.get(i)
        cc_line(cc, &("  case " + arm.n1.to_str() + ": {\n"))
        cir_insts(cc, &arm.b1, 0, arm.b1.len())
        cir_if_assign(cc, dest, ih(&arm.s1))
        cc_line(cc, &"  break;\n  }\n")
        cir_switch_arms(cc, dest, arms, i + 1, n)

fn cir_collect(cc: Int, insts: &List[Inst]) -> Int ! alloc
    idx = 0
    n = insts.len()
    while idx < n
        inst = insts.get(idx)
        k = inst.kind
        if k == II_IF()
            cir_add_local(cc, ih(&inst.dest))
            cir_collect(cc, &inst.b1)
            cir_collect(cc, &inst.b2)
            _d = cir_collect_carried(cc, &inst.rows)
        elsif k == II_WHILE()
            cir_collect(cc, &inst.b1)
            cir_collect(cc, &inst.b2)
            _g = cir_collect_carried(cc, &inst.rows)
        elsif k == II_SWITCH()
            cir_add_local(cc, ih(&inst.dest))
            cir_collect(cc, &inst.b1)
            cir_collect_arms(cc, &inst.rows, 0, inst.rows.len())
        elsif k == II_RET()
            _h = 0
        elsif k == II_DROP()
            _h = 0
        elsif k == II_CALL()
            if inst.n1 == 1
                _i = cir_add_local(cc, ih(&inst.dest))
        else
            _j = cir_add_local(cc, ih(&inst.dest))
        idx = idx + 1
    0

fn cir_collect_arms(cc: Int, arms: &List[Inst], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _c = cir_collect(cc, &arms.get(i).b1)
        cir_collect_arms(cc, arms, i + 1, n)

fn cir_collect_carried(cc: Int, carried: &List[Inst]) -> Int ! alloc
    idx = 0
    n = carried.len()
    while idx < n
        c = carried.get(idx)
        cir_add_local(cc, ih(&c.dest))
        idx = idx + 1
    0

fn cir_decl_locals(cc: Int, params: Int, acc: String) -> String ! alloc
    names = vec_get(cc, 2)
    idx = 0
    n = vec_len(names)
    out = acc
    while idx < n
        nm = vec_get(names, idx)
        if names_has(params, nm, 0, vec_len(params)) == 0
            out = out + "  int64_t " + str_from_int(nm) + " = 0;\n"
        idx = idx + 1
    out

# An IR function `[name, dim_params, insts, regions]` as C; params come from the AST fn.
fn cir_fn(f: &TFn, irf: &IrFn, user: Int, linkable: Int, allow_main: Int, pool: &mut LitPool) -> String ! alloc
    header = emit_c_fn_header(f, linkable, allow_main)
    if header.len() == 0
        ""
    else
        pnames = tparam_names(&f.params, 0, f.params.len(), vec_new())
        is_main = select_main(f, allow_main)
        cc = cc_new(pool, user, is_main)
        cir_seed_params(cc, pnames, 0, vec_len(pnames))
        cir_collect(cc, &irf.insts)
        cir_collect_lits(cc, &irf.lits)
        cir_literals(cc, &irf.lits, 0, irf.lits.len())
        cir_insts(cc, &irf.insts, 0, irf.insts.len())
        acc = cir_decl_locals(cc, pnames, header)
        lines = vec_get(cc, 6)
        acc = append_stmt_strings(acc, lines, 0, vec_len(lines))
        cir_commit_lits(cc, pool)
        acc + "  return 0;\n}\n\n"

# A glue function (`drop.<Struct>`, `drop.elem.<Struct>`) as C: one `v` parameter, symbol
# `drop.<...>` set by an asm label (the name is not a C identifier).
fn cir_glue(irf: &IrFn, user: Int, pool: &mut LitPool) -> String ! alloc
    c = "G_" + cir_cname(&irf.name)
    pnames = vec_new()
    _p = vec_push(pnames, str_as_int(&"v"))
    cc = cc_new(pool, user, 0)
    cir_seed_params(cc, pnames, 0, 1)
    cir_collect(cc, &irf.insts)
    cir_collect_lits(cc, &irf.lits)
    cir_literals(cc, &irf.lits, 0, irf.lits.len())
    cir_insts(cc, &irf.insts, 0, irf.insts.len())
    proto = "int64_t " + c + "(int64_t v) __asm__(\"" + irf.name + "\");\n"
    header = proto + "int64_t " + c + "(int64_t v) {\n"
    acc = cir_decl_locals(cc, pnames, header)
    lines = vec_get(cc, 6)
    acc = append_stmt_strings(acc, lines, 0, vec_len(lines))
    cir_commit_lits(cc, pool)
    acc + "  return 0;\n}\n\n"

fn select_main(f: &TFn, allow_main: Int) -> Int ! alloc
    if allow_main == 1
        f.name.eq("main")
    else
        0

fn cir_seed_params(cc: Int, pnames: Int, i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        cir_add_local(cc, vec_get(pnames, idx))
        idx = idx + 1
    0

# Scalar IR with `any` boxing or dispatch uses the same C backend as tensors.
fn cir_use_ir_path(insts: &List[Inst]) -> Int ! alloc
    1

fn cir_has_any_insts(insts: &List[Inst], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        inst = insts.get(i)
        k = inst.kind
        if k == II_ANYBOX()
            1
        elsif k == II_ANYCALL()
            1
        elsif k == II_IF()
            if cir_has_any_insts(&inst.b1, 0, inst.b1.len()) == 1
                1
            else
                cir_has_any_insts(&inst.b2, 0, inst.b2.len())
        elsif k == II_WHILE()
            if cir_has_any_insts(&inst.b1, 0, inst.b1.len()) == 1
                1
            else
                cir_has_any_insts(&inst.b2, 0, inst.b2.len())
        else
            cir_has_any_insts(insts, i + 1, n)

# A function goes through the IR path when it uses tensors.
fn cir_is_tensor_fn(insts: &List[Inst]) -> Int ! alloc
    idx = 0
    n = insts.len()
    found = 0
    while idx < n
        inst = insts.get(idx)
        k = inst.kind
        if k == II_TBIN()
            found = 1
        elsif k == II_TUN()
            found = 1
        elsif k == II_REBIND()
            found = 1
        elsif k == II_PLACE()
            found = 1
        elsif k == II_CALL()
            if cir_tensor_call(&inst.s1) == 1
                found = 1
        elsif k == II_IF()
            if cir_is_tensor_fn(&inst.b1) + cir_is_tensor_fn(&inst.b2) > 0
                found = 1
        elsif k == II_WHILE()
            if cir_is_tensor_fn(&inst.b1) + cir_is_tensor_fn(&inst.b2) > 0
                found = 1
        idx = idx + 1
    found

fn cir_tensor_call(f: &String) -> Int ! alloc
    match f
        "sal_load" => 1
        "sal_matmul_f32" => 1
        "sal_rope" => 1
        "sal_silu" => 1
        "sal_relu" => 1
        "sal_rms_norm" => 1
        "sal_softmax" => 1
        "sal_argmax" => 1
        "sal_transpose_f32" => 1
        "sal_attention_f32" => 1
        _ => 0

fn cir_collect_lits(cc: Int, lits: &List[Lit]) -> Int ! alloc
    idx = 0
    n = lits.len()
    while idx < n
        l = lits.get(idx)
        cir_add_local(cc, ih(&l.name))
        idx = idx + 1
    0

# Literal tensors are allocated up front, in source order.
fn cir_literals(cc: Int, lits: &List[Lit], i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        lit = lits.get(idx)
        acc = "  " + lit.name + " = (int64_t)(uintptr_t)sal_tn_alloc(" + lit.data.len().to_str() + ");\n"
        cc_line(cc, &acc)
        cir_lit_cells(cc, &lit.name, &lit.data, 0, lit.data.len())
        idx = idx + 1
    0

fn cir_lit_cells(cc: Int, name: &String, data: &List[String], i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        cc_line(cc, &("  ((float *)(uintptr_t)" + name + ")[" + idx.to_str() + "] = " + data.get(idx) + "f;\n"))
        idx = idx + 1
    0

# List/tensor ops the bootstrap backend leaves as no-ops (the value is 0).
fn cir_is_stub(f: &String) -> Int ! alloc
    match f
        "sal_index" => 1
        "sal_map" => 1
        "sal_relu" => 1
        "sal_where" => 1
        _ => 0

# Integer ops are C operators; `f`-prefixed ops (Float) go through `sal_fop`.
fn cir_binary(cc: Int, dest: Int, op: &String, l: &String, r: &String) -> Int ! alloc
    if op.eq("neg") == 1
        cir_set(cc, dest, &("(0 - " + l + ")"))
    elsif op.eq("not") == 1
        cir_set(cc, dest, &cir_rtc(cc, &"sal_not", l))
    elsif op.char(0) == 102
        cir_set(cc, dest, &("sal_fop(" + float_op_code(&op.slice(1, op.len())).to_str() + ", " + l + ", " + r + ")"))
    else
        cir_set(cc, dest, &("(" + l + " " + cmap_op(op) + " " + r + ")"))
