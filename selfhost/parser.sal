# Parser. Lists and operators grow to the left; 1 - 2 - 3 is (1 - 2) - 3.
import result
import lexer
import ast

fn parser_new(toks: Int) -> Int ! alloc
    pr = vec_new()
    _a = vec_push(pr, toks)
    _b = vec_push(pr, 0)
    _c = vec_push(pr, 0)
    _d = vec_push(pr, 0)
    _e = vec_push(pr, 0)
    pr

fn p_set_err(pr: Int, msg: String) -> Int ! alloc
    _a = vec_set(pr, 2, 1)
    _b = vec_set(pr, 3, str_as_int(msg))
    0

fn p_has_err(pr: Int) -> Int ! alloc
    vec_get(pr, 2)

fn p_err_msg(pr: Int) -> Int ! alloc
    vec_get(pr, 3)

fn p_idx(pr: Int) -> Int ! alloc
    vec_get(pr, 1)

fn p_set_idx(pr: Int, i: Int) -> Int ! alloc
    _s = vec_set(pr, 1, i)
    0

fn p_peek(pr: Int) -> Int ! alloc
    toks = vec_get(pr, 0)
    idx = vec_get(pr, 1)
    n = vec_len(toks)
    if idx >= n
        tok_new(TK_EOF(), d"", 0)
    else
        vec_get(toks, idx)

fn p_advance(pr: Int) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(t) == TK_EOF()
        t
    else
        _s = p_set_idx(pr, p_idx(pr) + 1)
        t

fn p_skip_nls(pr: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) == TK_NL()
        _a = p_advance(pr)
        p_skip_nls(pr)
    else
        0

fn p_group(pr: Int) -> Int ! alloc
    vec_get(pr, 4)

fn p_set_group(pr: Int, d: Int) -> Int ! alloc
    _s = vec_set(pr, 4, d)
    0

fn p_enter_group(pr: Int) -> Int ! alloc
    p_set_group(pr, p_group(pr) + 1)

fn p_leave_group(pr: Int) -> Int ! alloc
    d = p_group(pr)
    if d > 0
        p_set_group(pr, d - 1)
    else
        0

fn p_skip_group_nls(pr: Int) -> Int ! alloc
    if p_group(pr) > 0
        p_skip_nls(pr)
    else
        0

fn p_accept(pr: Int, k: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) == k
        _a = p_advance(pr)
        1
    else
        0

fn at_block_end(pr: Int) -> Int ! alloc
    k = tok_kind(p_peek(pr))
    if k == TK_DEDENT()
        1
    elsif k == TK_EOF()
        1
    elsif k == TK_FN()
        1
    elsif k == TK_ELSE()
        1
    elsif k == TK_ELSIF()
        1
    else
        0

# ---- type text / expr parsing ----
fn parse_type_text_go(pr: Int, depth: Int, acc: String) -> String ! alloc
    t = p_peek(pr)
    k = tok_kind(t)
    if k == TK_EOF()
        acc
    elsif depth != 0
        parse_type_text_cont(pr, depth, acc, t, k)
    elsif k == TK_NL()
        acc
    elsif k == TK_BANG()
        acc
    elsif k == TK_INDENT()
        acc
    elsif k == TK_DEDENT()
        acc
    elsif k == TK_EQ()
        acc
    elsif k == TK_COMMA()
        acc
    elsif k == TK_RPAREN()
        acc
    else
        parse_type_text_cont(pr, depth, acc, t, k)

fn parse_type_text_cont(pr: Int, depth: Int, acc: String, t: Int, k: Int) -> String ! alloc
    if k == TK_NL()
        _a = p_advance(pr)
        parse_type_text_go(pr, depth, acc)
    elsif k == TK_IDENT()
        tx = tok_text(t)
        _a = p_advance(pr)
        acc2 = acc + tx
        sp = d" "
        acc3 = acc2 + sp
        free(sp)
        parse_type_text_go(pr, depth, acc3)
    elsif k == TK_ON()
        _a = p_advance(pr)
        piece = d"on "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_TO()
        _a = p_advance(pr)
        piece = d"to "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_FN()
        _a = p_advance(pr)
        piece = d"fn "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_INT()
        _a = p_advance(pr)
        vs = int_to_str(tok_ival(t))
        acc2 = acc + vs
        free(vs)
        sp = d" "
        acc3 = acc2 + sp
        free(sp)
        parse_type_text_go(pr, depth, acc3)
    elsif k == TK_LBRACK()
        _a = p_advance(pr)
        piece = d"["
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth + 1, acc2)
    elsif k == TK_RBRACK()
        _a = p_advance(pr)
        piece = d"]"
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth - 1, acc2)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        piece = d","
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    else
        acc

fn parse_type_text(pr: Int) -> String ! alloc
    acc = d""
    r = parse_type_text_go(pr, 0, acc)
    if str_len(r) == 0
        free(r)
        d"Int"
    else
        r

fn binop_prec(k: Int) -> Int
    if k == TK_EQEQ()
        1
    elsif k == TK_NE()
        1
    elsif k == TK_LT()
        1
    elsif k == TK_LE()
        1
    elsif k == TK_GT()
        1
    elsif k == TK_GE()
        1
    elsif k == TK_PIPE()
        2
    elsif k == TK_CARET()
        3
    elsif k == TK_AMP()
        4
    elsif k == TK_SHL()
        5
    elsif k == TK_SHR()
        5
    elsif k == TK_PLUS()
        6
    elsif k == TK_MINUS()
        6
    elsif k == TK_STAR()
        7
    elsif k == TK_SLASH()
        7
    elsif k == TK_PERCENT()
        7
    else
        0

fn binop_name(k: Int) -> String ! alloc
    if k == TK_EQEQ()
        d"eq"
    elsif k == TK_NE()
        d"ne"
    elsif k == TK_LT()
        d"lt"
    elsif k == TK_LE()
        d"le"
    elsif k == TK_GT()
        d"gt"
    elsif k == TK_GE()
        d"ge"
    elsif k == TK_PIPE()
        d"bor"
    elsif k == TK_CARET()
        d"bxor"
    elsif k == TK_AMP()
        d"band"
    elsif k == TK_SHL()
        d"shl"
    elsif k == TK_SHR()
        d"shr"
    elsif k == TK_PLUS()
        d"add"
    elsif k == TK_MINUS()
        d"sub"
    elsif k == TK_STAR()
        d"mul"
    elsif k == TK_SLASH()
        d"div"
    elsif k == TK_PERCENT()
        d"mod"
    else
        d"add"

# expr -> "try" expr | lambda
fn parse_expr(pr: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_TRY()
        _a = p_advance(pr)
        ex_try(parse_expr(pr))
    else
        parse_lambda(pr)

# lambda -> cmp "=>" expr | cmp
fn parse_lambda(pr: Int) -> Int ! alloc
    left = parse_binary(pr, 0)
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_FATARROW()
        _a = p_advance(pr)
        if ex_kind(left) == EX_IDENT()
            ex_lambda(str_from_int(vec_get(left, 1)), parse_expr(pr))
        else
            _e = p_set_err(pr, d"parse error: lambda parameter must be an identifier")
            left
    else
        left

# unary -> "-" unary | "!" unary | "to" place unary | postfix
fn parse_unary(pr: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    k = tok_kind(p_peek(pr))
    if k == TK_MINUS()
        _a = p_advance(pr)
        ex_unary(d"neg", parse_unary(pr))
    elsif k == TK_BANG()
        _a = p_advance(pr)
        ex_unary(d"not", parse_unary(pr))
    elsif k == TK_TO()
        _a = p_advance(pr)
        pl = p_advance(pr)
        place = or_place(tok_text(pl), d"cpu")
        inner = parse_unary(pr)
        ex_to(place, inner)
    else
        parse_postfix(pr)

fn call_name_from_expr(e: Int) -> String ! alloc
    k = ex_kind(e)
    if k == EX_IDENT()
        str_from_int(vec_get(e, 1))
    elsif k == EX_FIELD()
        base = vec_get(e, 1)
        fld = str_from_int(vec_get(e, 2))
        if ex_kind(base) == EX_IDENT()
            qual = str_from_int(vec_get(base, 1))
            qual + "." + fld
        else
            d""
    else
        d""

fn parse_postfix_go(pr: Int, e: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_DOT()
        _d = p_advance(pr)
        if tok_kind(p_peek(pr)) == TK_IDENT()
            t = p_advance(pr)
            fld = tok_text(t)
            parse_postfix_go(pr, ex_field(e, fld))
        else
            e
    elsif tok_kind(p_peek(pr)) == TK_LPAREN()
        nm = call_name_from_expr(e)
        if str_len(nm) > 0
            _a = p_advance(pr)
            _g = p_enter_group(pr)
            args = vec_new()
            args2 = parse_arg_list(pr, args)
            _h = p_leave_group(pr)
            parse_postfix_go(pr, ex_call(nm, args2))
        else
            e
    else
        e

fn parse_postfix(pr: Int) -> Int ! alloc
    parse_postfix_go(pr, parse_primary(pr))

fn parse_binary(pr: Int, min_prec: Int) -> Int ! alloc
    left = parse_unary(pr)
    parse_binary_loop(pr, min_prec, left)

fn parse_binary_loop(pr: Int, min_prec: Int, left: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    t = p_peek(pr)
    k = tok_kind(t)
    prec = binop_prec(k)
    if prec == 0
        left
    elsif prec < min_prec
        left
    else
        _a = p_advance(pr)
        op = binop_name(k)
        right = parse_binary(pr, prec + 1)
        nleft = ex_binary(op, left, right)
        parse_binary_loop(pr, min_prec, nleft)

fn parse_arg_list(pr: Int, args: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_RPAREN()
        _a = p_accept(pr, TK_RPAREN())
        args
    else
        e = parse_expr(pr)
        _b = vec_push(args, e)
        _t = p_skip_group_nls(pr)
        if p_accept(pr, TK_COMMA()) == 1
            parse_arg_list(pr, args)
        else
            _u = p_skip_group_nls(pr)
            _c = p_accept(pr, TK_RPAREN())
            args

fn skip_brackets(pr: Int, depth: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) == TK_EOF()
        0
    else
        t = p_advance(pr)
        k = tok_kind(t)
        d2 = skip_brackets_depth(depth, k)
        if d2 <= 0
            0
        else
            skip_brackets(pr, d2)

fn skip_brackets_depth(depth: Int, k: Int) -> Int ! alloc
    if k == TK_LBRACK()
        depth + 1
    elsif k == TK_RBRACK()
        depth - 1
    else
        depth

fn parse_tensor_rows(pr: Int, nrows: Int, ncols: Int, data: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        _e = p_enter_group(pr)
        rowc = parse_tensor_cells(pr, 0, data)
        _b = p_accept(pr, TK_RBRACK())
        _l = p_leave_group(pr)
        _n = p_skip_group_nls(pr)
        _c = p_accept(pr, TK_COMMA())
        nc = ncols
        if ncols == 0
            nc = rowc
        else
            nc = ncols
        parse_tensor_rows(pr, nrows + 1, nc, data)
    else
        ex_tensor_data(nrows, ncols, data)

fn parse_tensor_cells(pr: Int, rowc: Int, data: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    k = tok_kind(p_peek(pr))
    if k == TK_RBRACK()
        rowc
    elsif k == TK_EOF()
        rowc
    elsif k == TK_FLOAT()
        _d = vec_push(data, str_as_int(tok_text(p_peek(pr))))
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc + 1, data)
    elsif k == TK_INT()
        _d = vec_push(data, str_as_int(int_to_str(tok_ival(p_peek(pr)))))
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc + 1, data)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc, data)
    else
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc, data)

fn or_place(place: String, fallback: String) -> String ! alloc
    if str_len(place) == 0
        fallback
    else
        place

fn parse_primary(pr: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    t = p_peek(pr)
    k = tok_kind(t)
    if k == TK_INT()
        _a = p_advance(pr)
        ex_int(tok_ival(t))
    elsif k == TK_FLOAT()
        _a = p_advance(pr)
        ex_float(tok_ival(t), tok_text(t))
    elsif k == TK_STRING()
        _a = p_advance(pr)
        if tok_ival(t) == 1
            _e = p_set_err(pr, d"parse error: invalid string interpolation")
        else
            _e = 0
        string_literal_expr(t)
    elsif k == TK_DSTRING()
        s = tok_text(t)
        _a = p_advance(pr)
        if tok_ival(t) == 1
            _e = p_set_err(pr, d"parse error: invalid string interpolation")
        else
            _e = 0
        args = vec_new()
        _b = vec_push(args, string_literal_expr(t))
        ex_call(d"strdup", args)
    elsif k == TK_IF()
        parse_if(pr)
    elsif k == TK_WHILE()
        parse_while(pr)
    elsif k == TK_TRUE()
        _a = p_advance(pr)
        ex_bool(1)
    elsif k == TK_FALSE()
        _a = p_advance(pr)
        ex_bool(0)
    elsif k == TK_MATCH()
        parse_match(pr)
    elsif k == TK_ON()
        _a = p_advance(pr)
        pl = p_advance(pr)
        place = or_place(tok_text(pl), d"pp")
        is_kernel = 0
        has_index = 0
        if p_accept(pr, TK_KERNEL()) == 1
            is_kernel = 1
            if tok_kind(p_peek(pr)) == TK_IDENT()
                has_index = 1
                _ki = skip_kernel_index(pr)
            else
                has_index = 0
        else
            is_kernel = 0
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        onx = ex_on(place, body)
        if is_kernel == 1
            _k = ex_on_set_kernel(onx, has_index)
        else
            _k = 0
        onx
    elsif k == TK_IDENT()
        parse_ident_primary(pr)
    elsif k == TK_FN()
        parse_ident_primary(pr)
    elsif k == TK_LPAREN()
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        e = parse_expr(pr)
        _n = p_skip_group_nls(pr)
        if p_accept(pr, TK_RPAREN()) == 0
            _x = p_set_err(pr, d"parse error: expected )")
        else
            _x = 0
        _h = p_leave_group(pr)
        e
    else
        _a = p_advance(pr)
        ex_int(0)

fn parse_elsif_arms(pr: Int, arms: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) == TK_ELSIF()
        _a = p_advance(pr)
        cond = parse_expr(pr)
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        _d = p_skip_nls(pr)
        arm = vec_new()
        _e = vec_push(arm, cond)
        _f = vec_push(arm, body)
        _g = vec_push(arms, arm)
        parse_elsif_arms(pr, arms)
    else
        arms

fn parse_if(pr: Int) -> Int ! alloc
    _a = p_advance(pr)
    cond = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    then_b = parse_block_after_indent(pr)
    _d = p_skip_nls(pr)
    arms = parse_elsif_arms(pr, vec_new())
    if tok_kind(p_peek(pr)) == TK_ELSE()
        _e = p_advance(pr)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_INDENT())
        else_b = parse_block_after_indent(pr)
        ex_if(cond, then_b, else_b, arms)
    else
        ex_if(cond, then_b, 0, arms)

# pattern -> "_" | INT | IDENT "." IDENT "(" patterns ")" | IDENT "(" patterns ")" | IDENT
# A string literal; `"a{x}b"` becomes the chain `"a" + x + "b"` (the chain
# starts with a literal so `+` concatenates and copies `x`).
fn string_literal_expr(t: Int) -> Int ! alloc
    if tok_ival(t) == 2
        raw = tok_text(t)
        interp_chain(raw, 0, str_len(raw), d"", 0)
    else
        ex_string(tok_text(t))

# `left` is the chain so far (0 before the first piece); `lit` the pending text.
fn interp_chain(raw: String, i: Int, n: Int, lit: String, left: Int) -> Int ! alloc
    if i >= n
        interp_flush(left, lit, 1)
    else
        c = str_char(raw, i)
        if c == 123
            if i + 1 < n
                if str_char(raw, i + 1) == 123
                    interp_chain(raw, i + 2, n, lit + char_to_str(123), left)
                else
                    close = find_char(raw, 125, i + 1, n)
                    name = str_slice(raw, i + 1, close)
                    l1 = interp_flush(left, lit, 0)
                    interp_chain(raw, close + 1, n, d"", ex_binary(d"add", l1, ex_ident(name)))
            else
                interp_chain(raw, i + 1, n, lit + char_to_str(c), left)
        elsif c == 125
            if i + 1 < n
                if str_char(raw, i + 1) == 125
                    interp_chain(raw, i + 2, n, lit + char_to_str(125), left)
                else
                    interp_chain(raw, i + 1, n, lit + char_to_str(c), left)
            else
                interp_chain(raw, i + 1, n, lit + char_to_str(c), left)
        else
            interp_chain(raw, i + 1, n, lit + char_to_str(c), left)

# Append the pending literal to the chain. `last`: end of the string, so an
# empty tail adds nothing.
fn interp_flush(left: Int, lit: String, last: Int) -> Int ! alloc
    if left == 0
        ex_string(lit)
    elsif str_len(lit) == 0
        left
    else
        ex_binary(d"add", left, ex_string(lit))

fn parse_pattern(pr: Int) -> Int ! alloc
    t = p_advance(pr)
    k = tok_kind(t)
    if k == TK_INT()
        pat_new(2, tok_ival(t), 0, 0)
    elsif k == TK_IDENT()
        nm = tok_text(t)
        if str_eq(nm, d"_") == 1
            pat_new(0, 0, 0, 0)
        elsif tok_kind(p_peek(pr)) == TK_DOT()
            _d = p_advance(pr)
            vt = p_advance(pr)
            args = parse_pattern_args(pr)
            pat_new(3, vec_get(vt, 1), str_as_int(nm), args)
        elsif tok_kind(p_peek(pr)) == TK_LPAREN()
            args = parse_pattern_args(pr)
            pat_new(3, str_as_int(nm), 0, args)
        else
            pat_new(1, str_as_int(nm), 0, 0)
    else
        _e = p_set_err(pr, d"parse error: expected pattern")
        pat_new(0, 0, 0, 0)

fn parse_pattern_args(pr: Int) -> Int ! alloc
    args = vec_new()
    if p_accept(pr, TK_LPAREN()) == 1
        _g = p_enter_group(pr)
        parse_pattern_list(pr, args)
        _h = p_leave_group(pr)
        args
    else
        args

fn parse_pattern_list(pr: Int, args: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_RPAREN()
        p_accept(pr, TK_RPAREN())
    else
        _a = vec_push(args, parse_pattern(pr))
        _t = p_skip_group_nls(pr)
        if p_accept(pr, TK_COMMA()) == 1
            parse_pattern_list(pr, args)
        else
            p_accept(pr, TK_RPAREN())

fn parse_match_arms(pr: Int, arms: Int) -> Int ! alloc
    _s = p_skip_nls(pr)
    if tok_kind(p_peek(pr)) == TK_DEDENT()
        _a = p_advance(pr)
        arms
    elsif tok_kind(p_peek(pr)) == TK_EOF()
        arms
    else
        pat = parse_pattern(pr)
        _b = p_accept(pr, TK_FATARROW())
        body = parse_expr(pr)
        arm = vec_new()
        _c = vec_push(arm, pat)
        _d = vec_push(arm, body)
        _e = vec_push(arms, arm)
        if p_has_err(pr) == 1
            arms
        else
            parse_match_arms(pr, arms)

fn parse_match(pr: Int) -> Int ! alloc
    _a = p_advance(pr)
    scrut = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    arms = parse_match_arms(pr, vec_new())
    ex_match(scrut, arms)

# kernel index list: IDENT ("," IDENT)* "in" type
fn skip_kernel_index(pr: Int) -> Int ! alloc
    k = tok_kind(p_peek(pr))
    if k == TK_IDENT()
        _a = p_advance(pr)
        skip_kernel_index(pr)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        skip_kernel_index(pr)
    elsif k == TK_IN()
        _a = p_advance(pr)
        parse_type_text(pr)
    else
        0

fn parse_while(pr: Int) -> Int ! alloc
    _a = p_advance(pr)
    cond = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    body = parse_block_after_indent(pr)
    ex_while(cond, body)

fn or_fn_name(name: String) -> String ! alloc
    if str_len(name) == 0
        d"fn"
    else
        name

fn parse_ident_primary(pr: Int) -> Int ! alloc
    t = p_advance(pr)
    name = or_fn_name(tok_text(t))
    if str_eq(name, "tensor") == 1
        if tok_kind(p_peek(pr)) == TK_LBRACK()
            _a = p_advance(pr)
            _g = p_enter_group(pr)
            _n = p_skip_group_nls(pr)
            if tok_kind(p_peek(pr)) == TK_LBRACK()
                te = parse_tensor_rows(pr, 0, 0, vec_new())
                _n = p_skip_group_nls(pr)
                _b = p_accept(pr, TK_RBRACK())
                _h = p_leave_group(pr)
                te
            else
                _b = p_accept(pr, TK_RBRACK())
                _h = p_leave_group(pr)
                ex_tensor(0, 0)
        else
            parse_ident_or_call(pr, name)
    else
        parse_ident_or_call(pr, name)

fn parse_ident_or_call(pr: Int, name: String) -> Int ! alloc
    if tok_kind(p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        text = parse_type_text_go(pr, 1, d"")
        parse_call_with_type_args(pr, name, str_as_int(trim_closing_bracket(text)))
    else
        parse_call_with_type_args(pr, name, 0)

# The accumulated type text ends with the `]` that closed the argument list.
fn trim_closing_bracket(text: String) -> String ! alloc
    n = str_len(text)
    if n > 0
        if str_char(text, n - 1) == 93
            str_slice(text, 0, n - 1)
        else
            text
    else
        text

fn parse_call_with_type_args(pr: Int, name: String, targs: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) == TK_LPAREN()
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        args = vec_new()
        args2 = parse_arg_list(pr, args)
        _h = p_leave_group(pr)
        call = ex_call(name, args2)
        _t = ex_call_set_type_args(call, targs)
        call
    else
        ex_ident(name)

fn parse_block_after_indent(pr: Int) -> Int ! alloc
    b = block_new()
    _a = p_skip_nls(pr)
    parse_block_go(pr, b)

fn parse_return_value(pr: Int) -> Int ! alloc
    if at_block_end(pr) == 1
        0
    elsif tok_kind(p_peek(pr)) == TK_NL()
        0
    else
        parse_expr(pr)

fn parse_block_go(pr: Int, b: Int) -> Int ! alloc
    _a = p_skip_nls(pr)
    if at_block_end(pr) == 1
        _b = p_accept(pr, TK_DEDENT())
        b
    elsif tok_kind(p_peek(pr)) == TK_RETURN()
        _r = p_advance(pr)
        rex = parse_return_value(pr)
        st = stmt_new(2, d"", rex)
        _d = vec_push(block_stmts(b), st)
        _e = p_skip_nls(pr)
        parse_block_go(pr, b)
    elsif tok_kind(p_peek(pr)) == TK_LET()
        parse_let(pr, b, 0)
    elsif tok_kind(p_peek(pr)) == TK_AT()
        flags = parse_stmt_attrs(pr, 0)
        if flags < 0
            b
        elsif tok_kind(p_peek(pr)) != TK_LET()
            _e = p_set_err(pr, d"parse error: @frozen and @stack apply to let only")
            b
        else
            parse_let(pr, b, flags)
    else
        parse_block_expr(pr, b)

# `@frozen` (1) and `@stack` (2) before a `let`; -1 on error.
fn parse_stmt_attrs(pr: Int, flags: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) != TK_AT()
        flags
    else
        _at = p_accept(pr, TK_AT())
        nt = p_peek(pr)
        if tok_kind(nt) != TK_IDENT()
            _e = p_set_err(pr, d"parse error: expected attribute name")
            -1
        else
            nt = p_advance(pr)
            name = tok_text(nt)
            if str_eq(name, d"frozen") == 1
                _s = p_skip_nls(pr)
                parse_stmt_attrs(pr, flags | 1)
            elsif str_eq(name, d"stack") == 1
                _s = p_skip_nls(pr)
                parse_stmt_attrs(pr, flags | 2)
            else
                _e = p_set_err(pr, d"parse error: unknown attribute")
                -1

fn parse_let(pr: Int, b: Int, flags: Int) -> Int ! alloc
    _l = p_advance(pr)
    nt = p_advance(pr)
    nm = tok_text(nt)
    ty = 0
    if p_accept(pr, TK_COLON()) == 1
        ty = str_as_int(parse_type_text(pr))
    else
        ty = 0
    _q = p_accept(pr, TK_EQ())
    ex = parse_expr(pr)
    st = stmt_let(nm, ty, ex)
    _at = stmt_set_attrs(st, flags & 1, (flags & 2) / 2)
    _d = vec_push(block_stmts(b), st)
    _e = p_skip_nls(pr)
    parse_block_go(pr, b)

fn parse_block_expr(pr: Int, b: Int) -> Int ! alloc
    ex = parse_expr(pr)
    if p_accept(pr, TK_EQ()) == 1
        parse_assign_stmt(pr, b, ex)
    else
        parse_block_expr_tail(pr, b, ex)

# `lvalue = expr`: the lvalue is an identifier or a chain of fields.
fn parse_assign_stmt(pr: Int, b: Int, target: Int) -> Int ! alloc
    value = parse_expr(pr)
    if ex_kind(target) == EX_IDENT()
        st = stmt_new(1, str_from_int(vec_get(target, 1)), value)
        _d = vec_push(block_stmts(b), st)
    elsif ex_kind(target) == EX_FIELD()
        st = stmt_field_assign(target, value)
        _d = vec_push(block_stmts(b), st)
    else
        _e = p_set_err(pr, d"parse error: invalid assignment target")
    _n = p_skip_nls(pr)
    parse_block_go(pr, b)

fn parse_block_expr_tail(pr: Int, b: Int, ex: Int) -> Int ! alloc
    _a = p_skip_nls(pr)
    if at_block_end(pr) == 1
        _b = block_set_tail(b, ex)
        _c = p_accept(pr, TK_DEDENT())
        b
    else
        st = stmt_new(0, d"", ex)
        _d = vec_push(block_stmts(b), st)
        parse_block_go(pr, b)

# Effect names after `!` set their flag in `fx` (see fx_flags_new).
fn parse_effects(pr: Int, fx: Int) -> Int ! alloc
    if p_accept(pr, TK_BANG()) == 0
        0
    else
        parse_effects_go(pr, fx)

fn parse_effects_go(pr: Int, fx: Int) -> Int ! alloc
    t = p_peek(pr)
    k = tok_kind(t)
    if k == TK_IDENT()
        _a = p_advance(pr)
        _m = mark_effect(fx, tok_text(t))
        parse_effects_go(pr, fx)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_effects_go(pr, fx)
    else
        0

fn mark_effect(fx: Int, name: String) -> Int ! alloc
    if str_eq(name, d"io") == 1
        vec_set(fx, 0, 1)
    elsif str_eq(name, d"alloc") == 1
        vec_set(fx, 1, 1)
    elsif str_eq(name, d"panic") == 1
        vec_set(fx, 2, 1)
    elsif str_eq(name, d"gpu") == 1
        vec_set(fx, 3, 1)
    elsif str_eq(name, d"tpu") == 1
        vec_set(fx, 4, 1)
    else
        0

fn or_arg_name(pn: String) -> String ! alloc
    if str_len(pn) == 0
        d"argx"
    else
        pn

fn parse_param_ty(pr: Int) -> String ! alloc
    if p_accept(pr, TK_COLON()) == 1
        parse_type_text(pr)
    else
        d"Int"

fn parse_params(pr: Int, params: Int) -> Int ! alloc
    _s = p_skip_nls(pr)
    if tok_kind(p_peek(pr)) == TK_RPAREN()
        params
    else
        pn_t = p_advance(pr)
        pn = or_arg_name(tok_text(pn_t))
        ty = parse_param_ty(pr)
        _a = vec_push(params, param_new(pn, ty))
        if p_accept(pr, TK_COMMA()) == 1
            parse_params(pr, params)
        else
            _t = p_skip_nls(pr)
            params

fn parse_struct_fields(pr: Int, fields: Int) -> Int ! alloc
    _s = p_skip_nls(pr)
    if at_block_end(pr) == 1
        fields
    elsif tok_kind(p_peek(pr)) == TK_IDENT()
        pn_t = p_advance(pr)
        pn = or_arg_name(tok_text(pn_t))
        ty = parse_param_ty(pr)
        _a = vec_push(fields, param_new(pn, ty))
        parse_struct_fields(pr, fields)
    else
        _e = p_set_err(pr, d"parse error: expected struct field")
        fields

# 0 = none, 1 = @no_heap, 2 = @layout(c), -1 = error
fn parse_item_attr_kind(pr: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) != TK_AT()
        0
    else
        _at = p_accept(pr, TK_AT())
        nt = p_peek(pr)
        if tok_kind(nt) != TK_IDENT()
            _e = p_set_err(pr, d"parse error: expected attribute name")
            -1
        else
            nt = p_advance(pr)
            name = tok_text(nt)
            if str_eq(name, d"no_heap") == 1
                1
            elsif str_eq(name, d"layout") == 1
                if p_accept(pr, TK_LPAREN()) == 0
                    _e = p_set_err(pr, d"parse error: expected ( after @layout")
                    -1
                else
                    nt2 = p_peek(pr)
                    if tok_kind(nt2) != TK_IDENT()
                        _e = p_set_err(pr, d"parse error: expected c in @layout(c)")
                        -1
                    else
                        nt2 = p_advance(pr)
                        arg = tok_text(nt2)
                        if p_accept(pr, TK_RPAREN()) == 0
                            _e = p_set_err(pr, d"parse error: expected ) after @layout(c)")
                            -1
                        elsif str_eq(arg, d"c") == 0
                            _e = p_set_err(pr, d"parse error: only @layout(c) is supported")
                            -1
                        else
                            2
            elsif str_eq(name, d"shared") == 1
                _e = p_set_err(pr, d"parse error: attribute @shared is not in this version")
                -1
            else
                _e = p_set_err(pr, d"parse error: unknown attribute")
                -1

# type_params -> "[" IDENT ("," IDENT)* "]" | empty; returns the names.
fn parse_type_params(pr: Int) -> Int ! alloc
    ps = vec_new()
    if tok_kind(p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        parse_type_params_go(pr, ps)
    else
        ps

fn parse_type_params_go(pr: Int, ps: Int) -> Int ! alloc
    t = p_peek(pr)
    k = tok_kind(t)
    if k == TK_IDENT()
        _a = p_advance(pr)
        _b = vec_push(ps, vec_get(t, 1))
        parse_type_params_go(pr, ps)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_type_params_go(pr, ps)
    elsif k == TK_RBRACK()
        _a = p_advance(pr)
        ps
    else
        ps

fn parse_variant_fields(pr: Int, fields: Int) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(p_peek(pr)) == TK_RPAREN()
        _a = p_advance(pr)
        fields
    else
        _b = vec_push(fields, str_as_int(parse_type_text(pr)))
        if p_accept(pr, TK_COMMA()) == 1
            parse_variant_fields(pr, fields)
        else
            _c = p_accept(pr, TK_RPAREN())
            fields

fn parse_enum_variants(pr: Int, vs: Int) -> Int ! alloc
    _s = p_skip_nls(pr)
    t = p_peek(pr)
    if tok_kind(t) == TK_IDENT()
        _a = p_advance(pr)
        fields = vec_new()
        if tok_kind(p_peek(pr)) == TK_LPAREN()
            _b = p_advance(pr)
            _c = parse_variant_fields(pr, fields)
        else
            _c = 0
        _d = vec_push(vs, variant_new(tok_text(t), fields))
        parse_enum_variants(pr, vs)
    else
        vs

fn parse_enum(pr: Int) -> Int ! alloc
    _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(nt) == TK_IDENT()
        _b = p_advance(pr)
        params = parse_type_params(pr)
        _c = p_skip_nls(pr)
        _d = p_accept(pr, TK_INDENT())
        vs = parse_enum_variants(pr, vec_new())
        _e = p_accept(pr, TK_DEDENT())
        enumdef_new(tok_text(nt), params, vs)
    else
        _e = p_set_err(pr, d"parse error: expected enum name")
        enumdef_new(d"_bad", vec_new(), vec_new())

fn parse_struct(pr: Int) -> Int ! alloc
    is_frame = 0
    if tok_kind(p_peek(pr)) == TK_STRUCT()
        _a = p_accept(pr, TK_STRUCT())
    elsif tok_kind(p_peek(pr)) == TK_FRAME()
        _a = p_advance(pr)
        is_frame = 1
    else
        _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(nt) == TK_IDENT()
        nt = p_advance(pr)
        name = or_fn_name(tok_text(nt))
        sparams = parse_type_params(pr)
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        fields = vec_new()
        fields = parse_struct_fields(pr, fields)
        if tok_kind(p_peek(pr)) == TK_DEDENT()
            _d = p_accept(pr, TK_DEDENT())
        else
            _d = 0
        sd = structdef_new(name, fields)
        _sp = structdef_set_params(sd, sparams)
        _sf = structdef_set_frame(sd, is_frame)
        sd
    else
        _e = p_set_err(pr, d"parse error: expected struct name")
        structdef_new(d"_bad", vec_new())

# Handle of the return type text after `->`, 0 when there is none.
fn parse_fn_ret(pr: Int) -> Int ! alloc
    if p_accept(pr, TK_ARROW()) == 1
        str_as_int(parse_type_text(pr))
    else
        _e = p_set_err(pr, d"parse error: expected -> after parameters")
        0

fn parse_fn(pr: Int) -> Int ! alloc
    _a = p_accept(pr, TK_FN())
    nt = p_peek(pr)
    if tok_kind(nt) == TK_IDENT()
        nt = p_advance(pr)
        name = or_fn_name(tok_text(nt))
        tparams = parse_type_params(pr)
        _b = p_accept(pr, TK_LPAREN())
        params = vec_new()
        params = parse_params(pr, params)
        _n = p_skip_nls(pr)
        _c = p_accept(pr, TK_RPAREN())
        ret = parse_fn_ret(pr)
        fx = fx_flags_new()
        _e = parse_effects(pr, fx)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        f = fndef_new(name, params, body)
        _fx = vec_set(f, 5, fx)
        _tp = vec_set(f, 6, tparams)
        _r = fndef_set_ret(f, ret)
        f
    else
        _e = p_set_err(pr, d"parse error: expected function name")
        fndef_new(d"_bad", vec_new(), block_new())

fn parse_import_path_dots(pr: Int, path: String) -> String ! alloc
    if tok_kind(p_peek(pr)) == TK_DOT()
        _d = p_advance(pr)
        if tok_kind(p_peek(pr)) == TK_IDENT()
            t = p_peek(pr)
            _t = p_advance(pr)
            seg = tok_text(t)
            npath = path + "." + seg
            parse_import_path_dots(pr, npath)
        else
            path
    else
        path

fn parse_optional_import_as(pr: Int) -> Int ! alloc
    if tok_kind(p_peek(pr)) == TK_IDENT()
        if str_eq(tok_text(p_peek(pr)), d"as") == 1
            _a = p_advance(pr)
            if tok_kind(p_peek(pr)) == TK_IDENT()
                t = p_advance(pr)
                str_as_int(tok_text(t))
            else
                _e = p_set_err(pr, d"parse error: expected import alias name")
                0
        else
            0
    else
        0

fn parse_import_path(pr: Int) -> String ! alloc
    t = p_peek(pr)
    k = tok_kind(t)
    if k == TK_STRING()
        name = tok_text(t)
        _a = p_advance(pr)
        name
    elsif k == TK_IDENT()
        path = tok_text(t)
        _b = p_advance(pr)
        parse_import_path_dots(pr, path)
    else
        _e = p_set_err(pr, d"parse error: expected identifier")
        d""

fn parse_program_go(pr: Int, prog: Int) -> Int ! alloc
    _a = p_skip_nls(pr)
    k = tok_kind(p_peek(pr))
    if k == TK_EOF()
        prog
    elsif k == TK_AT()
        ak = parse_item_attr_kind(pr)
        _n = p_skip_nls(pr)
        if ak == 1
            f = parse_fn(pr)
            _h = fndef_set_no_heap(f, 1)
            _c = vec_push(prog_fns(prog), f)
            parse_program_go(pr, prog)
        elsif ak == 2
            sd = parse_struct(pr)
            _h = structdef_set_layout_c(sd, 1)
            _s = vec_push(prog_structs(prog), sd)
            parse_program_go(pr, prog)
        else
            prog
    elsif k == TK_IMPORT()
        _i = p_advance(pr)
        path = parse_import_path(pr)
        alias = parse_optional_import_as(pr)
        _b = vec_push(prog_imports(prog), str_as_int(path))
        _c = vec_push(prog_import_aliases(prog), alias)
        parse_program_go(pr, prog)
    elsif k == TK_STRUCT()
        sd = parse_struct(pr)
        _s = vec_push(prog_structs(prog), sd)
        parse_program_go(pr, prog)
    elsif k == TK_FRAME()
        sd = parse_struct(pr)
        _s = vec_push(prog_structs(prog), sd)
        parse_program_go(pr, prog)
    elsif k == TK_ENUM()
        ed = parse_enum(pr)
        _s = vec_push(prog_enums(prog), ed)
        parse_program_go(pr, prog)
    elsif k == TK_IDENT()
        if str_eq(tok_text(p_peek(pr)), d"struct") == 1
            sd = parse_struct(pr)
            _s = vec_push(prog_structs(prog), sd)
            parse_program_go(pr, prog)
        else
            _d = p_advance(pr)
            parse_program_go(pr, prog)
    elsif k == TK_FN()
        f = parse_fn(pr)
        _c = vec_push(prog_fns(prog), f)
        parse_program_go(pr, prog)
    else
        _d = p_advance(pr)
        parse_program_go(pr, prog)

fn toks_has_code(toks: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        k = tok_kind(vec_get(toks, i))
        if k == TK_EOF()
            toks_has_code(toks, i + 1, n)
        elsif k == TK_NL()
            toks_has_code(toks, i + 1, n)
        elsif k == TK_INDENT()
            toks_has_code(toks, i + 1, n)
        elsif k == TK_DEDENT()
            toks_has_code(toks, i + 1, n)
        else
            1

fn parse_program(src: String) -> Int ! alloc
    toks = lex(src)
    pr = parser_new(toks)
    prog = prog_new()
    _a = p_skip_nls(pr)
    parse_program_go(pr, prog)
    if p_has_err(pr) == 1
        result_err(p_err_msg(pr))
    elsif vec_len(prog_fns(prog)) > 0
        result_ok(prog)
    elsif vec_len(prog_structs(prog)) > 0
        result_ok(prog)
    elsif vec_len(prog_enums(prog)) > 0
        result_ok(prog)
    elsif toks_has_code(toks, 0, vec_len(toks)) == 1
        result_err_str(d"parse error: expected fn")
    elsif str_len(src) == 0
        result_err_str(d"parse error: empty source")
    else
        result_err_str(d"parse error: no functions")
