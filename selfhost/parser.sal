# Parser. Lists and operators grow to the left; 1 - 2 - 3 is (1 - 2) - 3.
import result
import lexer
import tast

# Parser state: the token lists plus `st = [index, has_err, group depth, last statement id]` and `msg = [error text]`.
# The lists are shared by every copy of the struct, so `list_set` on them is the mutation.
struct Parser
    kinds: List[Int]
    texts: List[String]
    ivals: List[Int]
    st: List[Int]
    msg: List[String]

fn parser_new(toks: Toks) -> Parser ! alloc
    st = list_new[Int]()
    _a = list_push(st, 0)
    _b = list_push(st, 0)
    _c = list_push(st, 0)
    _n = list_push(st, 0)
    msg = list_new[String]()
    _d = list_push(msg, d"")
    Parser(toks.kinds, toks.texts, toks.ivals, st, msg)

# Releases the lists; the AST built from the tokens does not point into them.
fn parser_free(pr: Parser) -> Int ! alloc
    _a = list_free(pr.kinds)
    _b = list_free(pr.texts)
    _c = list_free(pr.ivals)
    _d = list_free(pr.st)
    _e = list_free(pr.msg)
    0

fn p_set_err(pr: Parser, msg: String) -> Int ! alloc
    _a = list_set(pr.st, 1, 1)
    _b = list_set(pr.msg, 0, msg)
    0

fn p_has_err(pr: Parser) -> Int ! alloc
    list_get(pr.st, 1)

fn p_err_msg(pr: Parser) -> String ! alloc
    list_get(pr.msg, 0)

# A fresh statement id (never 0, which stands for a statement a pass creates).
fn p_next_id(pr: Parser) -> Int ! alloc
    n = list_get(pr.st, 3) + 1
    _s = list_set(pr.st, 3, n)
    n

fn p_idx(pr: Parser) -> Int ! alloc
    list_get(pr.st, 0)

fn p_set_idx(pr: Parser, i: Int) -> Int ! alloc
    _s = list_set(pr.st, 0, i)
    0

# A token is its index; past the end every token reads as end of file.
fn tok_kind(pr: Parser, t: Int) -> Int ! alloc
    if t >= list_len(pr.kinds)
        TK_EOF()
    else
        list_get(pr.kinds, t)

fn tok_text(pr: Parser, t: Int) -> String ! alloc
    if t >= list_len(pr.texts)
        d""
    else
        list_get(pr.texts, t)

fn tok_ival(pr: Parser, t: Int) -> Int ! alloc
    if t >= list_len(pr.ivals)
        0
    else
        list_get(pr.ivals, t)

fn p_peek(pr: Parser) -> Int ! alloc
    p_idx(pr)

fn p_advance(pr: Parser) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_EOF()
        t
    else
        _s = p_set_idx(pr, t + 1)
        t

fn p_skip_nls(pr: Parser) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_NL()
        _a = p_advance(pr)
        p_skip_nls(pr)
    else
        0

fn p_group(pr: Parser) -> Int ! alloc
    list_get(pr.st, 2)

fn p_set_group(pr: Parser, d: Int) -> Int ! alloc
    _s = list_set(pr.st, 2, d)
    0

fn p_enter_group(pr: Parser) -> Int ! alloc
    p_set_group(pr, p_group(pr) + 1)

fn p_leave_group(pr: Parser) -> Int ! alloc
    d = p_group(pr)
    if d > 0
        p_set_group(pr, d - 1)
    else
        0

fn p_skip_group_nls(pr: Parser) -> Int ! alloc
    if p_group(pr) > 0
        p_skip_nls(pr)
    else
        0

fn p_accept(pr: Parser, k: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) == k
        _a = p_advance(pr)
        1
    else
        0

fn at_block_end(pr: Parser) -> Int ! alloc
    k = tok_kind(pr, p_peek(pr))
    if k == TK_DEDENT()
        1
    elsif k == TK_EOF()
        1
    elsif k == TK_FN()
        1
    elsif k == TK_ELSE()
        1
    elsif k == TK_ELSIF()
        1
    else
        0

# ---- type text / expr parsing ----
fn parse_type_text_go(pr: Parser, depth: Int, acc: String) -> String ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_EOF()
        acc
    elsif depth != 0
        parse_type_text_cont(pr, depth, acc, t, k)
    elsif k == TK_NL()
        acc
    elsif k == TK_BANG()
        acc
    elsif k == TK_INDENT()
        acc
    elsif k == TK_DEDENT()
        acc
    elsif k == TK_EQ()
        acc
    elsif k == TK_COMMA()
        acc
    elsif k == TK_RPAREN()
        acc
    else
        parse_type_text_cont(pr, depth, acc, t, k)

# `borrow` / `take` after a parameter type are its mode, not part of the type text.
fn parse_type_text_ident(pr: Parser, depth: Int, acc: String, t: Int) -> String ! alloc
    tx = tok_text(pr, t)
    if depth == 0
        if type_text_is_mode(tx) == 1
            acc
        else
            parse_type_text_word(pr, depth, acc, tx)
    else
        parse_type_text_word(pr, depth, acc, tx)

fn type_text_is_mode(tx: String) -> Int ! alloc
    if str_eq(tx, "borrow") == 1
        1
    else
        str_eq(tx, "take")

fn parse_type_text_word(pr: Parser, depth: Int, acc: String, tx: String) -> String ! alloc
    _a = p_advance(pr)
    acc2 = acc + tx
    sp = d" "
    acc3 = acc2 + sp
    free(sp)
    parse_type_text_go(pr, depth, acc3)

fn parse_type_text_cont(pr: Parser, depth: Int, acc: String, t: Int, k: Int) -> String ! alloc
    if k == TK_NL()
        _a = p_advance(pr)
        parse_type_text_go(pr, depth, acc)
    elsif k == TK_IDENT()
        parse_type_text_ident(pr, depth, acc, t)
    elsif k == TK_ON()
        _a = p_advance(pr)
        piece = d"on "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_TO()
        _a = p_advance(pr)
        piece = d"to "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_FN()
        _a = p_advance(pr)
        piece = d"fn "
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    elsif k == TK_INT()
        _a = p_advance(pr)
        vs = int_to_str(tok_ival(pr, t))
        acc2 = acc + vs
        free(vs)
        sp = d" "
        acc3 = acc2 + sp
        free(sp)
        parse_type_text_go(pr, depth, acc3)
    elsif k == TK_LBRACK()
        _a = p_advance(pr)
        piece = d"["
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth + 1, acc2)
    elsif k == TK_RBRACK()
        _a = p_advance(pr)
        piece = d"]"
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth - 1, acc2)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        piece = d","
        acc2 = acc + piece
        free(piece)
        parse_type_text_go(pr, depth, acc2)
    else
        acc

fn parse_type_text(pr: Parser) -> String ! alloc
    acc = d""
    r = parse_type_text_go(pr, 0, acc)
    if str_len(r) == 0
        free(r)
        d"Int"
    else
        r

fn binop_prec(k: Int) -> Int
    if k == TK_EQEQ()
        1
    elsif k == TK_NE()
        1
    elsif k == TK_LT()
        1
    elsif k == TK_LE()
        1
    elsif k == TK_GT()
        1
    elsif k == TK_GE()
        1
    elsif k == TK_PIPE()
        2
    elsif k == TK_CARET()
        3
    elsif k == TK_AMP()
        4
    elsif k == TK_SHL()
        5
    elsif k == TK_SHR()
        5
    elsif k == TK_PLUS()
        6
    elsif k == TK_MINUS()
        6
    elsif k == TK_STAR()
        7
    elsif k == TK_SLASH()
        7
    elsif k == TK_PERCENT()
        7
    else
        0

fn binop_name(k: Int) -> String ! alloc
    if k == TK_EQEQ()
        d"eq"
    elsif k == TK_NE()
        d"ne"
    elsif k == TK_LT()
        d"lt"
    elsif k == TK_LE()
        d"le"
    elsif k == TK_GT()
        d"gt"
    elsif k == TK_GE()
        d"ge"
    elsif k == TK_PIPE()
        d"bor"
    elsif k == TK_CARET()
        d"bxor"
    elsif k == TK_AMP()
        d"band"
    elsif k == TK_SHL()
        d"shl"
    elsif k == TK_SHR()
        d"shr"
    elsif k == TK_PLUS()
        d"add"
    elsif k == TK_MINUS()
        d"sub"
    elsif k == TK_STAR()
        d"mul"
    elsif k == TK_SLASH()
        d"div"
    elsif k == TK_PERCENT()
        d"mod"
    else
        d"add"

# expr -> "try" expr | lambda
# The text of token `t`, copied: the token lists are freed with the parser.
fn tok_own(pr: Parser, t: Int) -> String ! alloc
    strdup(tok_text(pr, t))

fn empty_block() -> TBlock ! alloc
    TBlock(list_new[TStmt](), XNone)

fn expr_is_none(e: Expr) -> Int ! alloc
    match e
        XNone => 1
        _ => 0

# The name of an identifier expression, empty for any other.
fn ident_of(e: Expr) -> String ! alloc
    match e
        XIdent(s) => strdup(s)
        _ => d""

# 1 identifier, 3 field access, 0 anything else: what `lvalue = expr` can assign to.
fn assign_kind(e: Expr) -> Int ! alloc
    match e
        XIdent(s) => 1
        XField(b, f) => 3
        _ => 0

fn parse_expr(pr: Parser) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_TRY()
        _a = p_advance(pr)
        XTry(parse_expr(pr))
    else
        parse_lambda(pr)

# lambda -> cmp "=>" expr | cmp
fn parse_lambda(pr: Parser) -> Expr ! alloc
    left = parse_binary(pr, 0)
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_FATARROW()
        _a = p_advance(pr)
        nm = ident_of(left)
        if str_len(nm) > 0
            XLambda(nm, parse_expr(pr))
        else
            _e = p_set_err(pr, d"parse error: lambda parameter must be an identifier")
            left
    else
        left

# unary -> "-" unary | "!" unary | "to" place unary | postfix
fn parse_unary(pr: Parser) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_MINUS()
        _a = p_advance(pr)
        XUnary(d"neg", parse_unary(pr))
    elsif k == TK_BANG()
        _a = p_advance(pr)
        XUnary(d"not", parse_unary(pr))
    elsif k == TK_TO()
        _a = p_advance(pr)
        pl = p_advance(pr)
        place = or_place(tok_own(pr, pl), d"cpu")
        inner = parse_unary(pr)
        XTo(place, inner)
    else
        parse_postfix(pr)

fn qualified_name(q: String, fld: String) -> String ! alloc
    if str_len(q) == 0
        d""
    else
        q + "." + fld

fn call_name_from_expr(e: Expr) -> String ! alloc
    match e
        XIdent(s) => strdup(s)
        XField(base, fld) => qualified_name(ident_of(base), fld)
        _ => d""

fn parse_postfix_go(pr: Parser, e: Expr) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_DOT()
        _d = p_advance(pr)
        if tok_kind(pr, p_peek(pr)) == TK_IDENT()
            t = p_advance(pr)
            parse_postfix_go(pr, XField(e, tok_own(pr, t)))
        else
            e
    elsif tok_kind(pr, p_peek(pr)) == TK_LPAREN()
        nm = call_name_from_expr(e)
        if str_len(nm) > 0
            _a = p_advance(pr)
            _g = p_enter_group(pr)
            args = parse_arg_list(pr, list_new[Expr]())
            _h = p_leave_group(pr)
            parse_postfix_go(pr, XCall(nm, args, d""))
        else
            e
    else
        e

fn parse_postfix(pr: Parser) -> Expr ! alloc
    parse_postfix_go(pr, parse_primary(pr))

fn parse_binary(pr: Parser, min_prec: Int) -> Expr ! alloc
    left = parse_unary(pr)
    parse_binary_loop(pr, min_prec, left)

fn parse_binary_loop(pr: Parser, min_prec: Int, left: Expr) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    t = p_peek(pr)
    k = tok_kind(pr, t)
    prec = binop_prec(k)
    if prec == 0
        left
    elsif prec < min_prec
        left
    else
        _a = p_advance(pr)
        op = binop_name(k)
        right = parse_binary(pr, prec + 1)
        nleft = XBin(op, left, right)
        parse_binary_loop(pr, min_prec, nleft)

fn parse_arg_list(pr: Parser, args: List[Expr]) -> List[Expr] ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        _a = p_accept(pr, TK_RPAREN())
        args
    else
        e = parse_expr(pr)
        _b = list_push(args, e)
        _t = p_skip_group_nls(pr)
        if p_accept(pr, TK_COMMA()) == 1
            parse_arg_list(pr, args)
        else
            _u = p_skip_group_nls(pr)
            _c = p_accept(pr, TK_RPAREN())
            args

fn skip_brackets(pr: Parser, depth: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_EOF()
        0
    else
        t = p_advance(pr)
        k = tok_kind(pr, t)
        d2 = skip_brackets_depth(depth, k)
        if d2 <= 0
            0
        else
            skip_brackets(pr, d2)

fn skip_brackets_depth(depth: Int, k: Int) -> Int ! alloc
    if k == TK_LBRACK()
        depth + 1
    elsif k == TK_RBRACK()
        depth - 1
    else
        depth

fn parse_tensor_rows(pr: Parser, nrows: Int, ncols: Int, data: List[String]) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        _e = p_enter_group(pr)
        rowc = parse_tensor_cells(pr, 0, data)
        _b = p_accept(pr, TK_RBRACK())
        _l = p_leave_group(pr)
        _n = p_skip_group_nls(pr)
        _c = p_accept(pr, TK_COMMA())
        nc = ncols
        if ncols == 0
            nc = rowc
        else
            nc = ncols
        parse_tensor_rows(pr, nrows + 1, nc, data)
    else
        XTensor(nrows, ncols, data)

fn parse_tensor_cells(pr: Parser, rowc: Int, data: List[String]) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_RBRACK()
        rowc
    elsif k == TK_EOF()
        rowc
    elsif k == TK_FLOAT()
        _d = list_push(data, tok_own(pr, p_peek(pr)))
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc + 1, data)
    elsif k == TK_INT()
        _d = list_push(data, int_to_str(tok_ival(pr, p_peek(pr))))
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc + 1, data)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc, data)
    else
        _a = p_advance(pr)
        parse_tensor_cells(pr, rowc, data)

fn or_place(place: String, fallback: String) -> String ! alloc
    if str_len(place) == 0
        fallback
    else
        place

fn parse_primary(pr: Parser) -> Expr ! alloc
    _s = p_skip_group_nls(pr)
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_INT()
        _a = p_advance(pr)
        XInt(tok_ival(pr, t))
    elsif k == TK_FLOAT()
        _a = p_advance(pr)
        XFloat(tok_ival(pr, t), tok_own(pr, t))
    elsif k == TK_STRING()
        _a = p_advance(pr)
        if tok_ival(pr, t) == 1
            _e = p_set_err(pr, d"parse error: invalid string interpolation")
        else
            _e = 0
        string_literal_expr(pr, t)
    elsif k == TK_DSTRING()
        _a = p_advance(pr)
        if tok_ival(pr, t) == 1
            _e = p_set_err(pr, d"parse error: invalid string interpolation")
        else
            _e = 0
        args = list_new[Expr]()
        _b = list_push(args, string_literal_expr(pr, t))
        XCall(d"strdup", args, d"")
    elsif k == TK_IF()
        parse_if(pr)
    elsif k == TK_WHILE()
        parse_while(pr)
    elsif k == TK_TRUE()
        _a = p_advance(pr)
        XBool(1)
    elsif k == TK_FALSE()
        _a = p_advance(pr)
        XBool(0)
    elsif k == TK_MATCH()
        parse_match(pr)
    elsif k == TK_ON()
        parse_on(pr)
    elsif k == TK_IDENT()
        parse_ident_primary(pr)
    elsif k == TK_FN()
        parse_ident_primary(pr)
    elsif k == TK_LPAREN()
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        e = parse_expr(pr)
        _n = p_skip_group_nls(pr)
        if p_accept(pr, TK_RPAREN()) == 0
            _x = p_set_err(pr, d"parse error: expected )")
        else
            _x = 0
        _h = p_leave_group(pr)
        e
    else
        _a = p_advance(pr)
        XInt(0)

# `on place [kernel [idx in type]]` and its block.
fn parse_on(pr: Parser) -> Expr ! alloc
    _a = p_advance(pr)
    pl = p_advance(pr)
    place = or_place(tok_own(pr, pl), d"pp")
    is_kernel = 0
    has_index = 0
    if p_accept(pr, TK_KERNEL()) == 1
        is_kernel = 1
        if tok_kind(pr, p_peek(pr)) == TK_IDENT()
            has_index = 1
            _ki = skip_kernel_index(pr)
        else
            has_index = 0
    else
        is_kernel = 0
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    body = parse_block_after_indent(pr)
    XOn(place, body, is_kernel, has_index)

fn parse_elsif_arms(pr: Parser, arms: List[TElsif]) -> List[TElsif] ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_ELSIF()
        _a = p_advance(pr)
        cond = parse_expr(pr)
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        _d = p_skip_nls(pr)
        _g = list_push(arms, TElsif(cond, body))
        parse_elsif_arms(pr, arms)
    else
        arms

fn parse_if(pr: Parser) -> Expr ! alloc
    _a = p_advance(pr)
    cond = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    then_b = parse_block_after_indent(pr)
    _d = p_skip_nls(pr)
    arms = parse_elsif_arms(pr, list_new[TElsif]())
    if tok_kind(pr, p_peek(pr)) == TK_ELSE()
        _e = p_advance(pr)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_INDENT())
        else_b = parse_block_after_indent(pr)
        XIf(cond, then_b, else_b, 1, arms)
    else
        XIf(cond, then_b, empty_block(), 0, arms)

# A string literal; `"a{x}b"` becomes the chain `"a" + x + "b"` (the chain
# starts with a literal so `+` concatenates and copies `x`).
fn string_literal_expr(pr: Parser, t: Int) -> Expr ! alloc
    if tok_ival(pr, t) == 2
        raw = tok_text(pr, t)
        interp_chain(raw, 0, str_len(raw), d"", XNone)
    else
        XStr(tok_own(pr, t))

# `left` is the chain so far (`XNone` before the first piece); `lit` the pending text.
fn interp_chain(raw: String, i: Int, n: Int, lit: String, left: Expr) -> Expr ! alloc
    if i >= n
        interp_flush(left, lit)
    else
        c = str_char(raw, i)
        if c == 123
            if i + 1 < n
                if str_char(raw, i + 1) == 123
                    interp_chain(raw, i + 2, n, lit + char_to_str(123), left)
                else
                    close = find_char(raw, 125, i + 1, n)
                    name = str_slice(raw, i + 1, close)
                    l1 = interp_flush(left, lit)
                    interp_chain(raw, close + 1, n, d"", XBin(d"add", l1, XIdent(name)))
            else
                interp_chain(raw, i + 1, n, lit + char_to_str(c), left)
        elsif c == 125
            if i + 1 < n
                if str_char(raw, i + 1) == 125
                    interp_chain(raw, i + 2, n, lit + char_to_str(125), left)
                else
                    interp_chain(raw, i + 1, n, lit + char_to_str(c), left)
            else
                interp_chain(raw, i + 1, n, lit + char_to_str(c), left)
        else
            interp_chain(raw, i + 1, n, lit + char_to_str(c), left)

# Append the pending literal to the chain; an empty one adds nothing.
fn interp_flush(left: Expr, lit: String) -> Expr ! alloc
    if expr_is_none(left) == 1
        XStr(lit)
    elsif str_len(lit) == 0
        left
    else
        XBin(d"add", left, XStr(lit))

# pattern -> "_" | INT | IDENT "." IDENT "(" patterns ")" | IDENT "(" patterns ")" | IDENT
fn parse_pattern(pr: Parser) -> TPat ! alloc
    t = p_advance(pr)
    k = tok_kind(pr, t)
    if k == TK_INT()
        TPat(2, tok_ival(pr, t), d"", d"", list_new[TPat]())
    elsif k == TK_IDENT()
        nm = tok_own(pr, t)
        if str_eq(nm, d"_") == 1
            TPat(0, 0, d"", d"", list_new[TPat]())
        elsif tok_kind(pr, p_peek(pr)) == TK_DOT()
            _d = p_advance(pr)
            vt = p_advance(pr)
            args = parse_pattern_args(pr)
            TPat(3, 0, tok_own(pr, vt), nm, args)
        elsif tok_kind(pr, p_peek(pr)) == TK_LPAREN()
            args = parse_pattern_args(pr)
            TPat(3, 0, nm, d"", args)
        else
            TPat(1, 0, nm, d"", list_new[TPat]())
    else
        _e = p_set_err(pr, d"parse error: expected pattern")
        TPat(0, 0, d"", d"", list_new[TPat]())

fn parse_pattern_args(pr: Parser) -> List[TPat] ! alloc
    args = list_new[TPat]()
    if p_accept(pr, TK_LPAREN()) == 1
        _g = p_enter_group(pr)
        _l = parse_pattern_list(pr, args)
        _h = p_leave_group(pr)
        args
    else
        args

fn parse_pattern_list(pr: Parser, args: List[TPat]) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        p_accept(pr, TK_RPAREN())
    else
        _a = list_push(args, parse_pattern(pr))
        _t = p_skip_group_nls(pr)
        if p_accept(pr, TK_COMMA()) == 1
            parse_pattern_list(pr, args)
        else
            p_accept(pr, TK_RPAREN())

fn parse_match_arms(pr: Parser, arms: List[TArm]) -> List[TArm] ! alloc
    _s = p_skip_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_DEDENT()
        _a = p_advance(pr)
        arms
    elsif tok_kind(pr, p_peek(pr)) == TK_EOF()
        arms
    else
        pat = parse_pattern(pr)
        _b = p_accept(pr, TK_FATARROW())
        body = parse_expr(pr)
        _e = list_push(arms, TArm(pat, body))
        if p_has_err(pr) == 1
            arms
        else
            parse_match_arms(pr, arms)

fn parse_match(pr: Parser) -> Expr ! alloc
    _a = p_advance(pr)
    scrut = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    arms = parse_match_arms(pr, list_new[TArm]())
    XMatch(scrut, arms)

# kernel index list: IDENT ("," IDENT)* "in" type
fn skip_kernel_index(pr: Parser) -> Int ! alloc
    k = tok_kind(pr, p_peek(pr))
    if k == TK_IDENT()
        _a = p_advance(pr)
        skip_kernel_index(pr)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        skip_kernel_index(pr)
    elsif k == TK_IN()
        _a = p_advance(pr)
        _t = parse_type_text(pr)
        0
    else
        0

fn parse_while(pr: Parser) -> Expr ! alloc
    _a = p_advance(pr)
    cond = parse_expr(pr)
    _b = p_skip_nls(pr)
    _c = p_accept(pr, TK_INDENT())
    body = parse_block_after_indent(pr)
    XWhile(cond, body)

fn or_fn_name(name: String) -> String ! alloc
    if str_len(name) == 0
        d"fn"
    else
        name

fn parse_ident_primary(pr: Parser) -> Expr ! alloc
    t = p_advance(pr)
    name = or_fn_name(tok_own(pr, t))
    if str_eq(name, "tensor") == 1
        if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
            _a = p_advance(pr)
            _g = p_enter_group(pr)
            _n = p_skip_group_nls(pr)
            if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
                te = parse_tensor_rows(pr, 0, 0, list_new[String]())
                _n2 = p_skip_group_nls(pr)
                _b = p_accept(pr, TK_RBRACK())
                _h = p_leave_group(pr)
                te
            else
                _b = p_accept(pr, TK_RBRACK())
                _h = p_leave_group(pr)
                XTensor(0, 0, list_new[String]())
        else
            parse_ident_or_call(pr, name)
    else
        parse_ident_or_call(pr, name)

fn parse_ident_or_call(pr: Parser, name: String) -> Expr ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        text = parse_type_text_go(pr, 1, d"")
        parse_call_with_type_args(pr, name, trim_closing_bracket(text))
    else
        parse_call_with_type_args(pr, name, d"")

# The accumulated type text ends with the `]` that closed the argument list.
fn trim_closing_bracket(text: String) -> String ! alloc
    n = str_len(text)
    if n > 0
        if str_char(text, n - 1) == 93
            str_slice(text, 0, n - 1)
        else
            text
    else
        text

fn parse_call_with_type_args(pr: Parser, name: String, targs: String) -> Expr ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_LPAREN()
        _a = p_advance(pr)
        _g = p_enter_group(pr)
        args = parse_arg_list(pr, list_new[Expr]())
        _h = p_leave_group(pr)
        XCall(name, args, targs)
    else
        XIdent(name)

fn parse_block_after_indent(pr: Parser) -> TBlock ! alloc
    _a = p_skip_nls(pr)
    parse_block_go(pr, list_new[TStmt]())

fn parse_return_value(pr: Parser) -> Expr ! alloc
    if at_block_end(pr) == 1
        XNone
    elsif tok_kind(pr, p_peek(pr)) == TK_NL()
        XNone
    else
        parse_expr(pr)

# A statement of `kind` with a fresh id (see `TStmt`).
fn mk_stmt(pr: Parser, kind: Int, name: String, expr: Expr) -> TStmt ! alloc
    TStmt(kind, name, expr, d"", 0, XNone, 0, 0, p_next_id(pr))

fn parse_block_go(pr: Parser, stmts: List[TStmt]) -> TBlock ! alloc
    _a = p_skip_nls(pr)
    if at_block_end(pr) == 1
        _b = p_accept(pr, TK_DEDENT())
        TBlock(stmts, XNone)
    elsif tok_kind(pr, p_peek(pr)) == TK_RETURN()
        _r = p_advance(pr)
        rex = parse_return_value(pr)
        _d = list_push(stmts, mk_stmt(pr, 2, d"", rex))
        _e = p_skip_nls(pr)
        parse_block_go(pr, stmts)
    elsif tok_kind(pr, p_peek(pr)) == TK_LET()
        parse_let(pr, stmts, 0)
    elsif tok_kind(pr, p_peek(pr)) == TK_AT()
        flags = parse_stmt_attrs(pr, 0)
        if flags < 0
            TBlock(stmts, XNone)
        elsif tok_kind(pr, p_peek(pr)) != TK_LET()
            _e = p_set_err(pr, d"parse error: @frozen and @stack apply to let only")
            TBlock(stmts, XNone)
        else
            parse_let(pr, stmts, flags)
    else
        parse_block_expr(pr, stmts)

# `@frozen` (1) and `@stack` (2) before a `let`; -1 on error.
fn parse_stmt_attrs(pr: Parser, flags: Int) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_AT()
        flags
    else
        _at = p_accept(pr, TK_AT())
        nt = p_peek(pr)
        if tok_kind(pr, nt) != TK_IDENT()
            _e = p_set_err(pr, d"parse error: expected attribute name")
            -1
        else
            nt = p_advance(pr)
            name = tok_text(pr, nt)
            if str_eq(name, d"frozen") == 1
                _s = p_skip_nls(pr)
                parse_stmt_attrs(pr, flags | 1)
            elsif str_eq(name, d"stack") == 1
                _s = p_skip_nls(pr)
                parse_stmt_attrs(pr, flags | 2)
            else
                _e = p_set_err(pr, d"parse error: unknown attribute")
                -1

# The type text after `:`, empty when omitted.
fn parse_opt_type(pr: Parser) -> String ! alloc
    if p_accept(pr, TK_COLON()) == 1
        parse_type_text(pr)
    else
        d""

fn parse_let(pr: Parser, stmts: List[TStmt], flags: Int) -> TBlock ! alloc
    _l = p_advance(pr)
    nt = p_advance(pr)
    nm = tok_own(pr, nt)
    ty = parse_opt_type(pr)
    _q = p_accept(pr, TK_EQ())
    ex = parse_expr(pr)
    st = TStmt(1, nm, ex, ty, 1, XNone, flags & 1, (flags & 2) / 2, p_next_id(pr))
    _d = list_push(stmts, st)
    _e = p_skip_nls(pr)
    parse_block_go(pr, stmts)

fn parse_block_expr(pr: Parser, stmts: List[TStmt]) -> TBlock ! alloc
    ex = parse_expr(pr)
    if p_accept(pr, TK_EQ()) == 1
        parse_assign_stmt(pr, stmts, ex)
    else
        parse_block_expr_tail(pr, stmts, ex)

# `lvalue = expr`: the lvalue is an identifier or a chain of fields.
fn parse_assign_stmt(pr: Parser, stmts: List[TStmt], target: Expr) -> TBlock ! alloc
    value = parse_expr(pr)
    ak = assign_kind(target)
    if ak == 1
        _d = list_push(stmts, mk_stmt(pr, 1, ident_of(target), value))
    elsif ak == 3
        st = TStmt(3, d"", value, d"", 0, target, 0, 0, p_next_id(pr))
        _d = list_push(stmts, st)
    else
        _e = p_set_err(pr, d"parse error: invalid assignment target")
    _n = p_skip_nls(pr)
    parse_block_go(pr, stmts)

fn parse_block_expr_tail(pr: Parser, stmts: List[TStmt], ex: Expr) -> TBlock ! alloc
    _a = p_skip_nls(pr)
    if at_block_end(pr) == 1
        _c = p_accept(pr, TK_DEDENT())
        TBlock(stmts, ex)
    else
        _d = list_push(stmts, mk_stmt(pr, 0, d"", ex))
        parse_block_go(pr, stmts)

# Effect names after `!` set their flag in `fx` (see `fx_list_new`).
fn fx_list_new() -> List[Int] ! alloc
    fx = list_new[Int]()
    _a = list_push(fx, 0)
    _b = list_push(fx, 0)
    _c = list_push(fx, 0)
    _d = list_push(fx, 0)
    _e = list_push(fx, 0)
    fx

fn parse_effects(pr: Parser, fx: List[Int]) -> Int ! alloc
    if p_accept(pr, TK_BANG()) == 0
        0
    else
        parse_effects_go(pr, fx)

fn parse_effects_go(pr: Parser, fx: List[Int]) -> Int ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_IDENT()
        _a = p_advance(pr)
        _m = mark_effect(fx, tok_text(pr, t))
        parse_effects_go(pr, fx)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_effects_go(pr, fx)
    else
        0

fn mark_effect(fx: List[Int], name: String) -> Int ! alloc
    slot = effect_slot(name)
    if slot < 0
        0
    else
        _s = list_set(fx, slot, 1)
        0

fn effect_slot(name: String) -> Int ! alloc
    if str_eq(name, d"io") == 1
        0
    elsif str_eq(name, d"alloc") == 1
        1
    elsif str_eq(name, d"panic") == 1
        2
    elsif str_eq(name, d"gpu") == 1
        3
    elsif str_eq(name, d"tpu") == 1
        4
    else
        -1

fn or_arg_name(pn: String) -> String ! alloc
    if str_len(pn) == 0
        d"argx"
    else
        pn

fn parse_param_ty(pr: Parser) -> String ! alloc
    if p_accept(pr, TK_COLON()) == 1
        parse_type_text(pr)
    else
        d"Int"

# Explicit `borrow` (1) / `take` (2) after a parameter type, 0 when absent.
fn parse_param_mode(pr: Parser) -> Int ! alloc
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_IDENT()
        if str_eq(tok_text(pr, t), "borrow") == 1
            _a = p_advance(pr)
            1
        elsif str_eq(tok_text(pr, t), "take") == 1
            _b = p_advance(pr)
            2
        else
            0
    else
        0

fn parse_params(pr: Parser, params: List[TParam]) -> List[TParam] ! alloc
    _s = p_skip_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        params
    else
        pn_t = p_advance(pr)
        pn = or_arg_name(tok_own(pr, pn_t))
        ty = parse_param_ty(pr)
        mode = parse_param_mode(pr)
        _a = list_push(params, TParam(pn, ty, mode))
        if p_accept(pr, TK_COMMA()) == 1
            parse_params(pr, params)
        else
            _t = p_skip_nls(pr)
            params

fn parse_struct_fields(pr: Parser, fields: List[TField]) -> List[TField] ! alloc
    _s = p_skip_nls(pr)
    if at_block_end(pr) == 1
        fields
    elsif tok_kind(pr, p_peek(pr)) == TK_IDENT()
        pn_t = p_advance(pr)
        pn = or_arg_name(tok_own(pr, pn_t))
        ty = parse_param_ty(pr)
        _a = list_push(fields, TField(pn, ty))
        parse_struct_fields(pr, fields)
    else
        _e = p_set_err(pr, d"parse error: expected struct field")
        fields

# 0 = none, 1 = @no_heap, 2 = @layout(c), -1 = error
fn parse_item_attr_kind(pr: Parser) -> Int ! alloc
    if tok_kind(pr, p_peek(pr)) != TK_AT()
        0
    else
        _at = p_accept(pr, TK_AT())
        nt = p_peek(pr)
        if tok_kind(pr, nt) != TK_IDENT()
            _e = p_set_err(pr, d"parse error: expected attribute name")
            -1
        else
            nt = p_advance(pr)
            name = tok_text(pr, nt)
            if str_eq(name, d"no_heap") == 1
                1
            elsif str_eq(name, d"layout") == 1
                if p_accept(pr, TK_LPAREN()) == 0
                    _e = p_set_err(pr, d"parse error: expected ( after @layout")
                    -1
                else
                    nt2 = p_peek(pr)
                    if tok_kind(pr, nt2) != TK_IDENT()
                        _e = p_set_err(pr, d"parse error: expected c in @layout(c)")
                        -1
                    else
                        nt2 = p_advance(pr)
                        arg = tok_text(pr, nt2)
                        if p_accept(pr, TK_RPAREN()) == 0
                            _e = p_set_err(pr, d"parse error: expected ) after @layout(c)")
                            -1
                        elsif str_eq(arg, d"c") == 0
                            _e = p_set_err(pr, d"parse error: only @layout(c) is supported")
                            -1
                        else
                            2
            elsif str_eq(name, d"shared") == 1
                _e = p_set_err(pr, d"parse error: attribute @shared is not in this version")
                -1
            else
                _e = p_set_err(pr, d"parse error: unknown attribute")
                -1

# type_params -> "[" IDENT ("," IDENT)* "]" | empty; returns the names.
fn parse_type_params(pr: Parser) -> List[String] ! alloc
    ps = list_new[String]()
    if tok_kind(pr, p_peek(pr)) == TK_LBRACK()
        _a = p_advance(pr)
        parse_type_params_go(pr, ps)
    else
        ps

fn parse_type_params_go(pr: Parser, ps: List[String]) -> List[String] ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_IDENT()
        _a = p_advance(pr)
        _b = list_push(ps, tok_own(pr, t))
        parse_type_params_go(pr, ps)
    elsif k == TK_COMMA()
        _a = p_advance(pr)
        parse_type_params_go(pr, ps)
    elsif k == TK_RBRACK()
        _a = p_advance(pr)
        ps
    else
        ps

fn parse_variant_fields(pr: Parser, fields: List[String]) -> Int ! alloc
    _s = p_skip_group_nls(pr)
    if tok_kind(pr, p_peek(pr)) == TK_RPAREN()
        p_advance(pr)
    else
        _b = list_push(fields, strdup(parse_type_text(pr)))
        if p_accept(pr, TK_COMMA()) == 1
            parse_variant_fields(pr, fields)
        else
            p_accept(pr, TK_RPAREN())

fn parse_enum_variants(pr: Parser, vs: List[TVariant]) -> List[TVariant] ! alloc
    _s = p_skip_nls(pr)
    t = p_peek(pr)
    if tok_kind(pr, t) == TK_IDENT()
        _a = p_advance(pr)
        fields = list_new[String]()
        if tok_kind(pr, p_peek(pr)) == TK_LPAREN()
            _b = p_advance(pr)
            _c = parse_variant_fields(pr, fields)
        else
            _c = 0
        _d = list_push(vs, TVariant(tok_own(pr, t), fields))
        parse_enum_variants(pr, vs)
    else
        vs

fn parse_enum(pr: Parser) -> TEnum ! alloc
    _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) == TK_IDENT()
        _b = p_advance(pr)
        params = parse_type_params(pr)
        _c = p_skip_nls(pr)
        _d = p_accept(pr, TK_INDENT())
        vs = parse_enum_variants(pr, list_new[TVariant]())
        _e = p_accept(pr, TK_DEDENT())
        TEnum(tok_own(pr, nt), vs, params)
    else
        _e = p_set_err(pr, d"parse error: expected enum name")
        TEnum(d"_bad", list_new[TVariant](), list_new[String]())

fn parse_struct(pr: Parser, layout_c: Int) -> TStruct ! alloc
    is_frame = 0
    if tok_kind(pr, p_peek(pr)) == TK_STRUCT()
        _a = p_accept(pr, TK_STRUCT())
    elsif tok_kind(pr, p_peek(pr)) == TK_FRAME()
        _a = p_advance(pr)
        is_frame = 1
    else
        _a = p_advance(pr)
    nt = p_peek(pr)
    if tok_kind(pr, nt) == TK_IDENT()
        nt = p_advance(pr)
        name = or_fn_name(tok_own(pr, nt))
        sparams = parse_type_params(pr)
        _b = p_skip_nls(pr)
        _c = p_accept(pr, TK_INDENT())
        fields = parse_struct_fields(pr, list_new[TField]())
        if tok_kind(pr, p_peek(pr)) == TK_DEDENT()
            _d = p_accept(pr, TK_DEDENT())
        else
            _d = 0
        TStruct(name, fields, layout_c, sparams, is_frame)
    else
        _e = p_set_err(pr, d"parse error: expected struct name")
        TStruct(d"_bad", list_new[TField](), 0, list_new[String](), 0)

# The return type text after `->`; empty (and an error) when there is none.
fn parse_fn_ret(pr: Parser) -> String ! alloc
    if p_accept(pr, TK_ARROW()) == 1
        parse_type_text(pr)
    else
        _e = p_set_err(pr, d"parse error: expected -> after parameters")
        d""

fn parse_fn(pr: Parser, no_heap: Int) -> TFn ! alloc
    _a = p_accept(pr, TK_FN())
    nt = p_peek(pr)
    if tok_kind(pr, nt) == TK_IDENT()
        nt = p_advance(pr)
        name = or_fn_name(tok_own(pr, nt))
        tparams = parse_type_params(pr)
        _b = p_accept(pr, TK_LPAREN())
        params = parse_params(pr, list_new[TParam]())
        _n = p_skip_nls(pr)
        _c = p_accept(pr, TK_RPAREN())
        ret = parse_fn_ret(pr)
        fx = fx_list_new()
        _e = parse_effects(pr, fx)
        _f = p_skip_nls(pr)
        _g = p_accept(pr, TK_INDENT())
        body = parse_block_after_indent(pr)
        TFn(name, params, body, ret, no_heap, fx, tparams)
    else
        _e = p_set_err(pr, d"parse error: expected function name")
        TFn(d"_bad", list_new[TParam](), empty_block(), d"", 0, fx_list_new(), list_new[String]())

fn parse_import_path_dots(pr: Parser, path: String) -> String ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_DOT()
        _d = p_advance(pr)
        if tok_kind(pr, p_peek(pr)) == TK_IDENT()
            t = p_peek(pr)
            _t = p_advance(pr)
            seg = tok_text(pr, t)
            npath = path + "." + seg
            parse_import_path_dots(pr, npath)
        else
            path
    else
        path

# The alias after `as`, empty when there is none.
fn parse_optional_import_as(pr: Parser) -> String ! alloc
    if tok_kind(pr, p_peek(pr)) == TK_IDENT()
        if str_eq(tok_text(pr, p_peek(pr)), d"as") == 1
            _a = p_advance(pr)
            if tok_kind(pr, p_peek(pr)) == TK_IDENT()
                t = p_advance(pr)
                tok_own(pr, t)
            else
                _e = p_set_err(pr, d"parse error: expected import alias name")
                d""
        else
            d""
    else
        d""

fn parse_import_path(pr: Parser) -> String ! alloc
    t = p_peek(pr)
    k = tok_kind(pr, t)
    if k == TK_STRING()
        name = tok_own(pr, t)
        _a = p_advance(pr)
        name
    elsif k == TK_IDENT()
        path = tok_own(pr, t)
        _b = p_advance(pr)
        parse_import_path_dots(pr, path)
    else
        _e = p_set_err(pr, d"parse error: expected identifier")
        d""

# What the items of a program are collected into.
struct Items
    fns: List[TFn]
    structs: List[TStruct]
    enums: List[TEnum]
    imports: List[String]
    aliases: List[String]

fn parse_program_go(pr: Parser, it: Items) -> Int ! alloc
    _a = p_skip_nls(pr)
    k = tok_kind(pr, p_peek(pr))
    if k == TK_EOF()
        0
    elsif k == TK_AT()
        ak = parse_item_attr_kind(pr)
        _n = p_skip_nls(pr)
        if ak == 1
            _c = list_push(it.fns, parse_fn(pr, 1))
            parse_program_go(pr, it)
        elsif ak == 2
            _s = list_push(it.structs, parse_struct(pr, 1))
            parse_program_go(pr, it)
        else
            0
    elsif k == TK_IMPORT()
        _i = p_advance(pr)
        path = parse_import_path(pr)
        alias = parse_optional_import_as(pr)
        _b = list_push(it.imports, strdup(path))
        _c = list_push(it.aliases, strdup(alias))
        parse_program_go(pr, it)
    elsif k == TK_STRUCT()
        _s = list_push(it.structs, parse_struct(pr, 0))
        parse_program_go(pr, it)
    elsif k == TK_FRAME()
        _s = list_push(it.structs, parse_struct(pr, 0))
        parse_program_go(pr, it)
    elsif k == TK_ENUM()
        _s = list_push(it.enums, parse_enum(pr))
        parse_program_go(pr, it)
    elsif k == TK_IDENT()
        if str_eq(tok_text(pr, p_peek(pr)), d"struct") == 1
            _s = list_push(it.structs, parse_struct(pr, 0))
            parse_program_go(pr, it)
        else
            _d = p_advance(pr)
            parse_program_go(pr, it)
    elsif k == TK_FN()
        _c = list_push(it.fns, parse_fn(pr, 0))
        parse_program_go(pr, it)
    else
        _d = p_advance(pr)
        parse_program_go(pr, it)

fn toks_has_code(pr: Parser, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        k = tok_kind(pr, i)
        if k == TK_EOF()
            toks_has_code(pr, i + 1, n)
        elsif k == TK_NL()
            toks_has_code(pr, i + 1, n)
        elsif k == TK_INDENT()
            toks_has_code(pr, i + 1, n)
        elsif k == TK_DEDENT()
            toks_has_code(pr, i + 1, n)
        else
            1

# The message in `errs` ("" when empty); releases the list.
fn errs_take(errs: List[String]) -> String ! alloc
    if list_len(errs) == 0
        _f = list_free(errs)
        d""
    else
        msg = strdup(list_get(errs, 0))
        _f = list_free(errs)
        msg

# The parsed program. A parse error leaves its message in `errs` (empty otherwise) and the
# program is then whatever was read before it.
fn parse_program(src: String, errs: List[String]) -> TProgram ! alloc
    pr = parser_new(lex(src))
    it = Items(list_new[TFn](), list_new[TStruct](), list_new[TEnum](), list_new[String](), list_new[String]())
    _a = p_skip_nls(pr)
    _b = parse_program_go(pr, it)
    msg = parse_program_error(pr, list_len(it.fns), list_len(it.structs), list_len(it.enums), src)
    _f = parser_free(pr)
    if str_len(msg) > 0
        _e = list_push(errs, msg)
        TProgram(it.fns, it.imports, it.structs, it.aliases, it.enums)
    else
        TProgram(it.fns, it.imports, it.structs, it.aliases, it.enums)

# The error text of the parse, empty when it went well.
fn parse_program_error(pr: Parser, nfns: Int, nstructs: Int, nenums: Int, src: String) -> String ! alloc
    if p_has_err(pr) == 1
        strdup(p_err_msg(pr))
    elsif nfns > 0
        d""
    elsif nstructs > 0
        d""
    elsif nenums > 0
        d""
    elsif toks_has_code(pr, 0, list_len(pr.kinds)) == 1
        d"parse error: expected fn"
    elsif str_len(src) == 0
        d"parse error: empty source"
    else
        d"parse error: no functions"
