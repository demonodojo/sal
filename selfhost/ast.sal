# AST constructors. Binary operators are left-associative in the parser that builds them.

fn EX_INT() -> Int
    0

fn EX_FLOAT() -> Int
    1

fn EX_STRING() -> Int
    2

fn EX_IDENT() -> Int
    3

fn EX_BINARY() -> Int
    4

fn EX_CALL() -> Int
    5

fn EX_TO() -> Int
    6

fn EX_ON() -> Int
    7

fn EX_TENSOR() -> Int
    8

fn EX_IF() -> Int
    9

fn EX_WHILE() -> Int
    10

fn EX_FIELD() -> Int
    11

# ---- AST ----
fn ex_int(v: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_INT())
    _b = vec_push(e, v)
    e

fn ex_float() -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_FLOAT())
    _b = vec_push(e, 0)
    e

fn ex_string(t: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_STRING())
    _b = vec_push(e, str_as_int(t))
    e

fn ex_ident(t: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_IDENT())
    _b = vec_push(e, str_as_int(t))
    e

fn ex_binary(op: String, left: Int, right: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_BINARY())
    _b = vec_push(e, str_as_int(op))
    _c = vec_push(e, left)
    _d = vec_push(e, right)
    e

fn ex_call(name: String, args: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_CALL())
    _b = vec_push(e, str_as_int(name))
    _c = vec_push(e, args)
    e

fn ex_field(base: Int, field: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_FIELD())
    _b = vec_push(e, base)
    _c = vec_push(e, str_as_int(field))
    e

fn structdef_new(name: String, fields: Int) -> Int ! alloc
    s = vec_new()
    _a = vec_push(s, str_as_int(name))
    _b = vec_push(s, fields)
    s

fn structdef_name(s: Int) -> Int ! alloc
    vec_get(s, 0)

fn structdef_fields(s: Int) -> Int ! alloc
    vec_get(s, 1)

fn structdef_field_count(s: Int) -> Int ! alloc
    vec_len(structdef_fields(s))

fn ex_to(place: String, inner: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TO())
    _b = vec_push(e, str_as_int(place))
    _c = vec_push(e, inner)
    e

fn ex_on(place: String, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_ON())
    _b = vec_push(e, str_as_int(place))
    _c = vec_push(e, body)
    e

fn ex_tensor(nrows: Int, ncols: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TENSOR())
    _b = vec_push(e, nrows)
    _c = vec_push(e, ncols)
    e

fn ex_if(cond: Int, then_b: Int, else_b: Int, arms: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_IF())
    _b = vec_push(e, cond)
    _c = vec_push(e, then_b)
    _d = vec_push(e, else_b)
    _e = vec_push(e, arms)
    e

fn ex_while(cond: Int, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_WHILE())
    _b = vec_push(e, cond)
    _c = vec_push(e, body)
    e

fn ex_kind(e: Int) -> Int ! alloc
    if e == 0
        0 - 1
    else
        vec_get(e, 0)

fn stmt_new(is_as: Int, name: String, expr: Int) -> Int ! alloc
    s = vec_new()
    _a = vec_push(s, is_as)
    _b = vec_push(s, str_as_int(name))
    _c = vec_push(s, expr)
    s

fn block_new() -> Int ! alloc
    b = vec_new()
    stmts = vec_new()
    _a = vec_push(b, stmts)
    _b = vec_push(b, 0)
    b

fn block_stmts(b: Int) -> Int ! alloc
    vec_get(b, 0)

fn block_tail(b: Int) -> Int ! alloc
    vec_get(b, 1)

fn block_set_tail(b: Int, t: Int) -> Int ! alloc
    _s = vec_set(b, 1, t)
    0

fn param_new(name: String, ty: String) -> Int ! alloc
    pr = vec_new()
    _a = vec_push(pr, str_as_int(name))
    _b = vec_push(pr, str_as_int(ty))
    pr

fn fndef_new(name: String, params: Int, body: Int) -> Int ! alloc
    f = vec_new()
    _a = vec_push(f, str_as_int(name))
    _b = vec_push(f, params)
    _c = vec_push(f, body)
    _d = vec_push(f, 0)
    f

# Handle of the declared return type text, 0 when the signature has none.
fn fndef_ret(f: Int) -> Int ! alloc
    if vec_len(f) > 3
        vec_get(f, 3)
    else
        0

fn fndef_set_ret(f: Int, ty: Int) -> Int ! alloc
    if vec_len(f) > 3
        _s = vec_set(f, 3, ty)
    else
        _s = vec_push(f, ty)
    0

fn prog_new() -> Int ! alloc
    pr = vec_new()
    fns = vec_new()
    imps = vec_new()
    structs = vec_new()
    _a = vec_push(pr, fns)
    _b = vec_push(pr, imps)
    _c = vec_push(pr, structs)
    pr

fn prog_fns(pr: Int) -> Int ! alloc
    vec_get(pr, 0)

fn prog_imports(pr: Int) -> Int ! alloc
    vec_get(pr, 1)

fn prog_structs(pr: Int) -> Int ! alloc
    vec_get(pr, 2)

# Local String typer, the mirror of the bootstrap's typed decision for `+`
# (src/string_expr.rs). A strenv is `[len, fnrets, structs, name, ty, ...]`:
# `fnrets` maps a user fn name to the handle of its return type text, `structs`
# is the program's struct list, and each binding carries the handle of its type
# text (0 when unknown). `+` concatenates when its left operand types as String;
# the right operand must be a String too (`str_from_int` bridges a handle).
# `env` 0 means no locals.

fn strenv_new() -> Int ! alloc
    v = vec_new()
    _p = vec_push(v, 0)
    _f = vec_push(v, 0)
    _s = vec_push(v, 0)
    v

fn strenv_set_globals(env: Int, fnrets: Int, structs: Int) -> Int ! alloc
    _f = vec_set(env, 1, fnrets)
    _s = vec_set(env, 2, structs)
    0

fn strenv_fnrets(env: Int) -> Int ! alloc
    vec_get(env, 1)

fn strenv_structs(env: Int) -> Int ! alloc
    vec_get(env, 2)

fn strenv_len(env: Int) -> Int ! alloc
    vec_get(env, 0)

fn strenv_set_len(env: Int, n: Int) -> Int ! alloc
    _s = vec_set(env, 0, n)
    0

fn strenv_bind(env: Int, name: Int, ty: Int) -> Int ! alloc
    if env == 0
        0
    else
        len = strenv_len(env)
        base = 3 + len * 2
        if base >= vec_len(env)
            _a = vec_push(env, name)
            _b = vec_push(env, ty)
            strenv_set_len(env, len + 1)
        else
            _a = vec_set(env, base, name)
            _b = vec_set(env, base + 1, ty)
            strenv_set_len(env, len + 1)

fn strenv_type_go(env: Int, name: Int, i: Int) -> Int ! alloc
    if i < 0
        0
    else
        base = 3 + i * 2
        if str_eq(vec_get(env, base), name) == 1
            vec_get(env, base + 1)
        else
            strenv_type_go(env, name, i - 1)

fn strenv_type(env: Int, name: Int) -> Int ! alloc
    if env == 0
        0
    else
        strenv_type_go(env, name, strenv_len(env) - 1)

fn strenv_has(env: Int, name: Int) -> Int ! alloc
    ty_handle_is_string(strenv_type(env, name))

fn ty_is_string(ty: String) -> Int ! alloc
    if str_eq(ty, "String") == 1
        1
    else
        str_eq(ty, "String ") == 1

fn ty_handle_is_string(ty: Int) -> Int ! alloc
    if ty == 0
        0
    else
        ty_is_string(str_from_int(ty))

fn ty_string() -> Int ! alloc
    str_as_int("String")

fn call_returns_string(name: Int) -> Int ! alloc
    if str_eq(name, "argv") == 1
        1
    elsif str_eq(name, "read_file") == 1
        1
    elsif str_eq(name, "str_concat") == 1
        1
    elsif str_eq(name, "str_append") == 1
        1
    elsif str_eq(name, "str_from_int") == 1
        1
    elsif str_eq(name, "realpath") == 1
        1
    else
        call_returns_string2(name)

fn call_returns_string2(name: Int) -> Int ! alloc
    if str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "int_to_str") == 1
        1
    elsif str_eq(name, "char_to_str") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    else
        call_returns_string3(name)

fn call_returns_string3(name: Int) -> Int ! alloc
    if str_eq(name, "select_str") == 1
        1
    elsif str_eq(name, "tmp_path") == 1
        1
    elsif str_eq(name, "exec_capture") == 1
        1
    elsif str_eq(name, "getenv") == 1
        1
    elsif str_eq(name, "ir_text") == 1
        1
    else
        0

# Builtins whose String result is a fresh heap temporary nobody else owns.
fn call_allocates_fresh_string(name: Int) -> Int ! alloc
    if str_eq(name, "int_to_str") == 1
        1
    elsif str_eq(name, "char_to_str") == 1
        1
    elsif str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    else
        str_eq(name, "read_file")

fn chars_eq(a: Int, b: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    elsif str_char(a, i) != str_char(b, i)
        0
    else
        chars_eq(a, b, i + 1, n)

# Type text `ty` names `name`; the parser leaves one trailing space after an
# identifier in type text ("Path "), so that form matches too.
fn ty_text_matches(ty: Int, name: Int) -> Int ! alloc
    if ty == 0
        0
    else
        nl = str_len(name)
        tl = str_len(ty)
        if tl == nl
            str_eq(ty, name)
        elsif tl == nl + 1
            if str_char(ty, nl) == 32
                chars_eq(ty, name, 0, nl)
            else
                0
        else
            0

fn struct_find_go(structs: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        sd = vec_get(structs, i)
        if ty_text_matches(name, structdef_name(sd)) == 1
            sd
        else
            struct_find_go(structs, name, i + 1, n)

fn struct_find(structs: Int, name: Int) -> Int ! alloc
    if structs == 0
        0
    elsif name == 0
        0
    else
        struct_find_go(structs, name, 0, vec_len(structs))

fn struct_field_type_go(fields: Int, field: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        fd = vec_get(fields, i)
        if str_eq(str_from_int(vec_get(fd, 0)), str_from_int(field)) == 1
            vec_get(fd, 1)
        else
            struct_field_type_go(fields, field, i + 1, n)

fn struct_field_type(structs: Int, sname: Int, field: Int) -> Int ! alloc
    sd = struct_find(structs, sname)
    if sd == 0
        0
    else
        fields = structdef_fields(sd)
        struct_field_type_go(fields, field, 0, vec_len(fields))

fn call_type(e: Int, env: Int) -> Int ! alloc
    name = vec_get(e, 1)
    if call_returns_string(name) == 1
        ty_string()
    elsif struct_find(strenv_structs(env), name) != 0
        name
    elsif strenv_fnrets(env) == 0
        0
    else
        map_get(strenv_fnrets(env), name)

fn block_tail_type(b: Int, env: Int) -> Int ! alloc
    if b == 0
        0
    else
        expr_type(block_tail(b), env)

# Type text handle of `e` under `env`, or 0 when unknown.
fn expr_type(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_STRING()
            ty_string()
        elsif k == EX_CALL()
            call_type(e, env)
        elsif k == EX_IDENT()
            strenv_type(env, vec_get(e, 1))
        elsif k == EX_BINARY()
            if str_eq(vec_get(e, 1), "add") == 1
                if expr_produces_string(vec_get(e, 2), env) == 1
                    ty_string()
                else
                    0
            else
                0
        elsif k == EX_FIELD()
            struct_field_type(strenv_structs(env), expr_type(vec_get(e, 1), env), vec_get(e, 2))
        elsif k == EX_IF()
            block_tail_type(vec_get(e, 2), env)
        else
            0

fn expr_produces_string(e: Int, env: Int) -> Int ! alloc
    ty_handle_is_string(expr_type(e, env))

fn binary_add_is_string_concat(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    elsif ex_kind(e) == EX_BINARY()
        if str_eq(vec_get(e, 1), "add") == 1
            expr_produces_string(vec_get(e, 2), env)
        else
            0
    else
        0

fn binary_add_uses_append(e: Int, env: Int) -> Int ! alloc
    if binary_add_is_string_concat(e, env) == 0
        0
    else
        binary_add_is_string_concat(vec_get(e, 2), env)

# Leftmost leaf of a `+` chain: `((a + b) + c)` -> `a`.
fn add_chain_leftmost(e: Int) -> Int ! alloc
    if ex_kind(e) == EX_BINARY()
        if str_eq(vec_get(e, 1), "add") == 1
            add_chain_leftmost(vec_get(e, 2))
        else
            e
    else
        e

# `name = name + ...` with a string chain starting at `name`.
fn assign_accumulates_string(name: Int, value: Int, env: Int) -> Int ! alloc
    if binary_add_is_string_concat(value, env) == 0
        0
    else
        leaf = add_chain_leftmost(value)
        if ex_kind(leaf) == EX_IDENT()
            str_eq(vec_get(leaf, 1), name)
        else
            0

# The right operand of a string `+` is a temporary this expression owns.
fn add_right_is_fresh_temp(right: Int, env: Int) -> Int ! alloc
    k = ex_kind(right)
    if k == EX_BINARY()
        binary_add_is_string_concat(right, env)
    elsif k == EX_CALL()
        call_allocates_fresh_string(vec_get(right, 1))
    else
        0

fn fnret_map_from_prog(prog: Int) -> Int ! alloc
    m = map_new()
    fns = prog_fns(prog)
    fnret_map_fill(m, fns, 0, vec_len(fns))
    m

fn fnret_map_fill(m: Int, fns: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = vec_get(fns, i)
        if fndef_ret(f) != 0
            _p = map_put(m, vec_get(f, 0), fndef_ret(f))
        else
            _p = 0
        fnret_map_fill(m, fns, i + 1, n)
