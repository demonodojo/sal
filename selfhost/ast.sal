import tshape
# AST constructors. Binary operators are left-associative in the parser that builds them.

fn EX_INT() -> Int
    0

fn EX_FLOAT() -> Int
    1

fn EX_STRING() -> Int
    2

fn EX_IDENT() -> Int
    3

fn EX_BINARY() -> Int
    4

fn EX_CALL() -> Int
    5

fn EX_TO() -> Int
    6

fn EX_ON() -> Int
    7

fn EX_TENSOR() -> Int
    8

fn EX_IF() -> Int
    9

fn EX_WHILE() -> Int
    10

fn EX_FIELD() -> Int
    11

fn EX_BOOL() -> Int
    12

fn EX_LAMBDA() -> Int
    13

fn EX_UNARY() -> Int
    14

fn EX_MATCH() -> Int
    15

fn EX_TRY() -> Int
    16

# ---- AST ----
fn ex_int(v: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_INT())
    _b = vec_push(e, v)
    e

fn ex_float(v: Int, txt: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_FLOAT())
    _b = vec_push(e, v)
    _c = vec_push(e, str_as_int(txt))
    e

fn ex_string(t: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_STRING())
    _b = vec_push(e, str_as_int(t))
    e

fn ex_ident(t: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_IDENT())
    _b = vec_push(e, str_as_int(t))
    e

fn ex_binary(op: String, left: Int, right: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_BINARY())
    _b = vec_push(e, str_as_int(op))
    _c = vec_push(e, left)
    _d = vec_push(e, right)
    e

fn ex_call(name: String, args: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_CALL())
    _b = vec_push(e, str_as_int(name))
    _c = vec_push(e, args)
    _d = vec_push(e, 0)
    e

# Text of the `[...]` type arguments of a call (without the closing bracket), 0 when none.
fn ex_call_type_args(e: Int) -> Int ! alloc
    if vec_len(e) > 3
        vec_get(e, 3)
    else
        0

fn ex_call_set_type_args(e: Int, text: Int) -> Int ! alloc
    _s = vec_set(e, 3, text)
    0

fn ex_field(base: Int, field: String) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_FIELD())
    _b = vec_push(e, base)
    _c = vec_push(e, str_as_int(field))
    e

fn structdef_new(name: String, fields: Int) -> Int ! alloc
    s = vec_new()
    _a = vec_push(s, str_as_int(name))
    _b = vec_push(s, fields)
    _c = vec_push(s, 0)
    _d = vec_push(s, vec_new())
    _e = vec_push(s, 0)
    s

# Type parameter names of a struct/frame, and whether it was declared `frame`.
fn structdef_params(s: Int) -> Int ! alloc
    vec_get(s, 3)

fn structdef_set_params(s: Int, ps: Int) -> Int ! alloc
    vec_set(s, 3, ps)

fn structdef_is_frame(s: Int) -> Int ! alloc
    vec_get(s, 4)

fn structdef_set_frame(s: Int, v: Int) -> Int ! alloc
    vec_set(s, 4, v)

fn structdef_set_layout_c(s: Int, v: Int) -> Int ! alloc
    if vec_len(s) > 2
        _x = vec_set(s, 2, v)
    else
        _x = vec_push(s, v)
    0

fn structdef_layout_c(s: Int) -> Int ! alloc
    vec_get(s, 2)

fn structdef_name(s: Int) -> Int ! alloc
    vec_get(s, 0)

fn structdef_fields(s: Int) -> Int ! alloc
    vec_get(s, 1)

fn structdef_field_count(s: Int) -> Int ! alloc
    vec_len(structdef_fields(s))

fn ex_to(place: String, inner: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TO())
    _b = vec_push(e, str_as_int(place))
    _c = vec_push(e, inner)
    e

fn ex_on(place: String, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_ON())
    _b = vec_push(e, str_as_int(place))
    _c = vec_push(e, body)
    _d = vec_push(e, 0)
    _e = vec_push(e, 0)
    e

# `on <place> kernel [i, j in shape]`: slot 3 = kernel flag, slot 4 = has an index list.
fn ex_on_set_kernel(e: Int, has_index: Int) -> Int ! alloc
    _a = vec_set(e, 3, 1)
    vec_set(e, 4, has_index)

fn ex_tensor(nrows: Int, ncols: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TENSOR())
    _b = vec_push(e, nrows)
    _c = vec_push(e, ncols)
    e

# Literal elements as source text, row-major (slot 3).
fn ex_tensor_data(nrows: Int, ncols: Int, data: Int) -> Int ! alloc
    e = ex_tensor(nrows, ncols)
    _d = vec_push(e, data)
    e

fn tensor_lit_data(e: Int) -> Int ! alloc
    if vec_len(e) > 3
        vec_get(e, 3)
    else
        vec_new()

fn ex_if(cond: Int, then_b: Int, else_b: Int, arms: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_IF())
    _b = vec_push(e, cond)
    _c = vec_push(e, then_b)
    _d = vec_push(e, else_b)
    _e = vec_push(e, arms)
    e

fn ex_while(cond: Int, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_WHILE())
    _b = vec_push(e, cond)
    _c = vec_push(e, body)
    e

fn ex_kind(e: Int) -> Int ! alloc
    if e == 0
        0 - 1
    else
        vec_get(e, 0)

fn ex_bool(v: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_BOOL())
    _b = vec_push(e, v)
    e

fn ex_lambda(param: String, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_LAMBDA())
    _b = vec_push(e, str_as_int(param))
    _c = vec_push(e, body)
    e

# op is "neg" or "not"
fn ex_unary(op: String, inner: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_UNARY())
    _b = vec_push(e, str_as_int(op))
    _c = vec_push(e, inner)
    e

fn ex_try(inner: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TRY())
    _b = vec_push(e, inner)
    e

# Match: arms are `[pattern, body]`; a pattern is `[kind, text, qual, args]` with
# kind 0 `_`, 1 ident, 2 int (text = value), 3 variant.
fn ex_match(scrut: Int, arms: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_MATCH())
    _b = vec_push(e, scrut)
    _c = vec_push(e, arms)
    e

fn pat_new(kind: Int, text: Int, qual: Int, args: Int) -> Int ! alloc
    p = vec_new()
    _a = vec_push(p, kind)
    _b = vec_push(p, text)
    _c = vec_push(p, qual)
    _d = vec_push(p, args)
    p

fn stmt_new(is_as: Int, name: String, expr: Int) -> Int ! alloc
    s = vec_new()
    _a = vec_push(s, is_as)
    _b = vec_push(s, str_as_int(name))
    _c = vec_push(s, expr)
    _d = vec_push(s, 0)
    _e = vec_push(s, 0)
    _f = vec_push(s, 0)
    _g = vec_push(s, 0)
    _h = vec_push(s, 0)
    s

# `@frozen` / `@stack` markers of a `let` (slots 6 and 7).
fn stmt_set_attrs(s: Int, frozen: Int, stack: Int) -> Int ! alloc
    _a = vec_set(s, 6, frozen)
    vec_set(s, 7, stack)

# `let name: ty = expr`; `ty` is a type text handle, 0 when omitted.
fn stmt_let(name: String, ty: Int, expr: Int) -> Int ! alloc
    s = stmt_new(1, name, expr)
    _a = vec_set(s, 3, ty)
    _b = vec_set(s, 4, 1)
    s

# `a.b = expr`: kind 3, `target` is the field expression.
fn stmt_field_assign(target: Int, expr: Int) -> Int ! alloc
    s = stmt_new(3, d"", expr)
    _a = vec_set(s, 5, target)
    s

fn block_new() -> Int ! alloc
    b = vec_new()
    stmts = vec_new()
    _a = vec_push(b, stmts)
    _b = vec_push(b, 0)
    b

fn block_stmts(b: Int) -> Int ! alloc
    vec_get(b, 0)

fn block_tail(b: Int) -> Int ! alloc
    vec_get(b, 1)

fn block_set_tail(b: Int, t: Int) -> Int ! alloc
    _s = vec_set(b, 1, t)
    0

fn param_new(name: String, ty: String) -> Int ! alloc
    pr = vec_new()
    _a = vec_push(pr, str_as_int(name))
    _b = vec_push(pr, str_as_int(ty))
    _c = vec_push(pr, 0)
    pr

# Ownership mode of a parameter: 0 inferred, 1 `borrow`, 2 `take`.
fn param_mode(pr: Int) -> Int ! alloc
    vec_get(pr, 2)

fn param_set_mode(pr: Int, mode: Int) -> Int ! alloc
    vec_set(pr, 2, mode)

fn fndef_new(name: String, params: Int, body: Int) -> Int ! alloc
    f = vec_new()
    _a = vec_push(f, str_as_int(name))
    _b = vec_push(f, params)
    _c = vec_push(f, body)
    _d = vec_push(f, 0)
    _e = vec_push(f, 0)
    _f = vec_push(f, fx_flags_new())
    _g = vec_push(f, vec_new())
    f

# Type parameter names of a fn.
fn fndef_type_params(f: Int) -> Int ! alloc
    vec_get(f, 6)

# Declared effects of a fn: flags `[io, alloc, panic, gpu, tpu]`, 1 when declared.
fn fx_flags_new() -> Int ! alloc
    v = vec_new()
    _a = vec_push(v, 0)
    _b = vec_push(v, 0)
    _c = vec_push(v, 0)
    _d = vec_push(v, 0)
    _e = vec_push(v, 0)
    v

fn fndef_effects(f: Int) -> Int ! alloc
    vec_get(f, 5)

fn fndef_set_no_heap(f: Int, v: Int) -> Int ! alloc
    if vec_len(f) > 4
        _x = vec_set(f, 4, v)
    else
        _x = vec_push(f, v)
    0

fn fndef_no_heap(f: Int) -> Int ! alloc
    vec_get(f, 4)

# Handle of the declared return type text, 0 when the signature has none.
fn fndef_ret(f: Int) -> Int ! alloc
    if vec_len(f) > 3
        vec_get(f, 3)
    else
        0

fn fndef_set_ret(f: Int, ty: Int) -> Int ! alloc
    if vec_len(f) > 3
        _s = vec_set(f, 3, ty)
    else
        _s = vec_push(f, ty)
    0

fn prog_new() -> Int ! alloc
    pr = vec_new()
    fns = vec_new()
    imps = vec_new()
    structs = vec_new()
    imp_aliases = vec_new()
    _a = vec_push(pr, fns)
    _b = vec_push(pr, imps)
    _c = vec_push(pr, structs)
    _d = vec_push(pr, imp_aliases)
    _e = vec_push(pr, vec_new())
    pr

# Enums: `[name, variants, type_params]`; a variant is `[name, field_type_texts]`.
fn prog_enums(pr: Int) -> Int ! alloc
    vec_get(pr, 4)

fn enumdef_new(name: String, params: Int, variants: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, str_as_int(name))
    _b = vec_push(e, variants)
    _c = vec_push(e, params)
    e

fn variant_new(name: String, fields: Int) -> Int ! alloc
    v = vec_new()
    _a = vec_push(v, str_as_int(name))
    _b = vec_push(v, fields)
    v

fn prog_fns(pr: Int) -> Int ! alloc
    vec_get(pr, 0)

fn prog_imports(pr: Int) -> Int ! alloc
    vec_get(pr, 1)

fn prog_structs(pr: Int) -> Int ! alloc
    vec_get(pr, 2)

fn prog_import_aliases(pr: Int) -> Int ! alloc
    if vec_len(pr) > 3
        vec_get(pr, 3)
    else
        0

fn prog_import_alias_at(pr: Int, i: Int) -> Int ! alloc
    al = prog_import_aliases(pr)
    if al == 0
        0
    elsif i >= vec_len(al)
        0
    else
        vec_get(al, i)

# Local String typer, the mirror of the bootstrap's typed decision for `+`
# (src/string_expr.rs). A strenv is `[len, fnrets, structs, name, ty, ...]`:
# `fnrets` maps a user fn name to the handle of its return type text, `structs`
# is the program's struct list, and each binding carries the handle of its type
# text (0 when unknown). `+` concatenates when its left operand types as String;
# the right operand must be a String too (`str_from_int` bridges a handle).
# `env` 0 means no locals.

fn strenv_new() -> Int ! alloc
    v = vec_new()
    _p = vec_push(v, 0)
    _f = vec_push(v, 0)
    _s = vec_push(v, 0)
    v

fn strenv_set_globals(env: Int, fnrets: Int, structs: Int) -> Int ! alloc
    _f = vec_set(env, 1, fnrets)
    _s = vec_set(env, 2, structs)
    0

fn strenv_fnrets(env: Int) -> Int ! alloc
    vec_get(env, 1)

fn strenv_structs(env: Int) -> Int ! alloc
    vec_get(env, 2)

fn strenv_len(env: Int) -> Int ! alloc
    vec_get(env, 0)

fn strenv_set_len(env: Int, n: Int) -> Int ! alloc
    _s = vec_set(env, 0, n)
    0

fn strenv_bind(env: Int, name: Int, ty: Int) -> Int ! alloc
    if env == 0
        0
    else
        len = strenv_len(env)
        base = 3 + len * 2
        if base >= vec_len(env)
            _a = vec_push(env, name)
            _b = vec_push(env, ty)
            strenv_set_len(env, len + 1)
        else
            _a = vec_set(env, base, name)
            _b = vec_set(env, base + 1, ty)
            strenv_set_len(env, len + 1)

fn strenv_type_go(env: Int, name: Int, i: Int) -> Int ! alloc
    if i < 0
        0
    else
        base = 3 + i * 2
        if str_eq(vec_get(env, base), name) == 1
            vec_get(env, base + 1)
        else
            strenv_type_go(env, name, i - 1)

fn strenv_type(env: Int, name: Int) -> Int ! alloc
    if env == 0
        0
    else
        strenv_type_go(env, name, strenv_len(env) - 1)

fn strenv_has_binding(env: Int, name: Int) -> Int ! alloc
    if strenv_type(env, name) != 0
        1
    else
        0

fn strenv_has(env: Int, name: Int) -> Int ! alloc
    ty_handle_is_string(strenv_type(env, name))

fn ty_is_string(ty: String) -> Int ! alloc
    if str_eq(ty, "String") == 1
        1
    else
        str_eq(ty, "String ") == 1

fn ty_handle_is_string(ty: Int) -> Int ! alloc
    if ty == 0
        0
    else
        ty_is_string(str_from_int(ty))

fn ty_string() -> Int ! alloc
    str_as_int("String")

fn ty_float() -> Int ! alloc
    str_as_int("Float")

fn ty_handle_is_float(t: Int) -> Int ! alloc
    if t == 0
        0
    else
        str_eq(ty_trim_go(str_from_int(t)), d"Float")

# `e` is a Float under `env`.
fn expr_is_float(e: Int, env: Int) -> Int ! alloc
    ty_handle_is_float(expr_type(e, env))

# IR name of a binary op: `fadd` for Float operands, `add` otherwise.
fn binary_ir_op(e: Int, env: Int) -> Int ! alloc
    if expr_is_float(vec_get(e, 2), env) + expr_is_float(vec_get(e, 3), env) > 0
        str_as_int("f" + str_from_int(vec_get(e, 1)))
    else
        vec_get(e, 1)

fn call_returns_string(name: Int) -> Int ! alloc
    if str_eq(name, "argv") == 1
        1
    elsif str_eq(name, "read_file") == 1
        1
    elsif str_eq(name, "str_concat") == 1
        1
    elsif str_eq(name, "str_append") == 1
        1
    elsif str_eq(name, "str_from_int") == 1
        1
    elsif str_eq(name, "realpath") == 1
        1
    else
        call_returns_string2(name)

fn call_returns_string2(name: Int) -> Int ! alloc
    if str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "int_to_str") == 1
        1
    elsif str_eq(name, "char_to_str") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    else
        call_returns_string3(name)

fn call_returns_string3(name: Int) -> Int ! alloc
    if str_eq(name, "select_str") == 1
        1
    elsif str_eq(name, "tmp_path") == 1
        1
    elsif str_eq(name, "exec_capture") == 1
        1
    elsif str_eq(name, "getenv") == 1
        1
    elsif str_eq(name, "ir_text") == 1
        1
    else
        0

# Builtins whose String result is a fresh heap temporary nobody else owns.
fn call_allocates_fresh_string(name: Int) -> Int ! alloc
    if str_eq(name, "int_to_str") == 1
        1
    elsif str_eq(name, "char_to_str") == 1
        1
    elsif str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    else
        str_eq(name, "read_file")

fn chars_eq(a: Int, b: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    elsif str_char(a, i) != str_char(b, i)
        0
    else
        chars_eq(a, b, i + 1, n)

# Type text `ty` names `name`; the parser leaves one trailing space after an
# identifier in type text ("Path "), so that form matches too.
fn ty_text_matches(ty: Int, name: Int) -> Int ! alloc
    if ty == 0
        0
    else
        nl = str_len(name)
        tl = str_len(ty)
        if tl == nl
            str_eq(ty, name)
        elsif tl == nl + 1
            if str_char(ty, nl) == 32
                chars_eq(ty, name, 0, nl)
            else
                0
        else
            0

fn struct_find_go(structs: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        sd = vec_get(structs, i)
        if ty_text_matches(name, structdef_name(sd)) == 1
            sd
        else
            struct_find_go(structs, name, i + 1, n)

fn struct_find(structs: Int, name: Int) -> Int ! alloc
    if structs == 0
        0
    elsif name == 0
        0
    else
        struct_find_go(structs, name, 0, vec_len(structs))

fn struct_field_type_go(fields: Int, field: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        fd = vec_get(fields, i)
        if str_eq(str_from_int(vec_get(fd, 0)), str_from_int(field)) == 1
            vec_get(fd, 1)
        else
            struct_field_type_go(fields, field, i + 1, n)

fn struct_field_type(structs: Int, sname: Int, field: Int) -> Int ! alloc
    sd = struct_find(structs, sname)
    if sd == 0
        0
    else
        fields = structdef_fields(sd)
        struct_field_type_go(fields, field, 0, vec_len(fields))

fn field_index_go(fields: Int, field: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(str_from_int(vec_get(vec_get(fields, i), 0)), str_from_int(field)) == 1
        i
    else
        field_index_go(fields, field, i + 1, n)

fn tensor_lit_type(e: Int) -> Int ! alloc
    str_as_int("Tensor[F32, " + int_to_str(vec_get(e, 1)) + ", " + int_to_str(vec_get(e, 2)) + "] on cpu")

fn call_type(e: Int, env: Int) -> Int ! alloc
    name = vec_get(e, 1)
    if call_returns_string(name) == 1
        ty_string()
    elsif str_eq(str_from_int(name), "int_to_float") == 1
        ty_float()
    elsif str_eq(str_from_int(name), "load") == 1
        ex_call_type_args(e)
    elsif str_eq(str_from_int(name), "matmul") == 1
        matmul_call_type(e, env)
    elsif struct_find(strenv_structs(env), name) != 0
        name
    elsif str_eq(str_from_int(name), "list_new") == 1
        list_new_type(e)
    elsif str_eq(str_from_int(name), "list_get") == 1
        list_elem_type(expr_type(vec_get(vec_get(e, 2), 0), env))
    elsif str_eq(str_from_int(name), "list_pop") == 1
        list_elem_type(expr_type(vec_get(vec_get(e, 2), 0), env))
    elsif str_eq(str_from_int(name), "dict_new") == 1
        dict_new_type(e)
    elsif str_eq(str_from_int(name), "dict_get") == 1
        dict_get_type(e, env)
    elsif strenv_fnrets(env) == 0
        0
    elsif map_get(strenv_fnrets(env), str_as_int("$g:" + str_from_int(name))) != 0
        gi = map_get(strenv_fnrets(env), str_as_int("$g:" + str_from_int(name))) - 1
        if gi < vec_len(vec_get(e, 2))
            expr_type(vec_get(vec_get(e, 2), gi), env)
        else
            0
    else
        map_get(strenv_fnrets(env), name)

# `list_new[T]()` has type `List[T]`; without a type argument it stays untyped.
fn list_new_type(e: Int) -> Int ! alloc
    ta = ex_call_type_args(e)
    if ta == 0
        0
    else
        str_as_int("List[" + str_from_int(ta) + "]")

# `dict_new[K, V]()` has type `Dict[K, V]`.
fn dict_new_type(e: Int) -> Int ! alloc
    ta = ex_call_type_args(e)
    if ta == 0
        0
    else
        str_as_int("Dict[" + str_from_int(ta) + "]")

# `dict_get(d, k)` has type `Option[V]`.
fn dict_get_type(e: Int, env: Int) -> Int ! alloc
    dt = expr_type(vec_get(vec_get(e, 2), 0), env)
    if dt == 0
        0
    else
        v = nth_type_arg(str_from_int(dt), 1)
        if v == 0
            0
        else
            str_as_int("Option[" + str_from_int(v) + "]")

# `i`-th top-level type argument of `Name[A, B]`, or 0. Nested brackets are kept whole.
fn nth_type_arg(t: String, i: Int) -> Int ! alloc
    open = ty_find_open(t, 0)
    if open < 0
        0
    else
        nth_type_arg_go(str_slice(t, open + 1, str_len(t) - 1), i, 0, 0, 0)

fn nth_type_arg_go(s: String, want: Int, pos: Int, start: Int, k: Int) -> Int ! alloc
    n = str_len(s)
    if pos >= n
        if k == want
            str_as_int(trim_spaces(str_slice(s, start, n)))
        else
            0
    else
        c = str_char(s, pos)
        if c == 91
            nth_type_arg_go(s, want, ty_skip_brackets(s, pos + 1, 1), start, k)
        elsif c == 44
            if k == want
                str_as_int(trim_spaces(str_slice(s, start, pos)))
            else
                nth_type_arg_go(s, want, pos + 1, pos + 1, k + 1)
        else
            nth_type_arg_go(s, want, pos + 1, start, k)

fn ty_find_open(t: String, i: Int) -> Int ! alloc
    if i >= str_len(t)
        0 - 1
    elsif str_char(t, i) == 91
        i
    else
        ty_find_open(t, i + 1)

# Position after the `]` that closes the bracket opened before `pos` (depth 1).
fn ty_skip_brackets(s: String, pos: Int, depth: Int) -> Int ! alloc
    if pos >= str_len(s)
        pos
    else
        c = str_char(s, pos)
        if c == 91
            ty_skip_brackets(s, pos + 1, depth + 1)
        elsif c == 93
            if depth == 1
                pos + 1
            else
                ty_skip_brackets(s, pos + 1, depth - 1)
        else
            ty_skip_brackets(s, pos + 1, depth)

fn trim_spaces(s: String) -> String ! alloc
    n = str_len(s)
    if n > 0
        if str_char(s, 0) == 32
            trim_spaces(str_slice(s, 1, n))
        elsif str_char(s, n - 1) == 32
            trim_spaces(str_slice(s, 0, n - 1))
        else
            s
    else
        s

# `T` of a `List[T]` type text, or 0.
fn list_elem_type(t: Int) -> Int ! alloc
    if t == 0
        0
    else
        s = str_from_int(t)
        n = str_len(s)
        if n < 7
            0
        elsif str_eq(str_slice(s, 0, 5), "List[") == 1
            str_as_int(str_slice(s, 5, n - 1))
        else
            0

fn matmul_call_type(e: Int, env: Int) -> Int ! alloc
    args = vec_get(e, 2)
    if vec_len(args) == 2
        tt_matmul_text(expr_type(vec_get(args, 0), env), expr_type(vec_get(args, 1), env))
    else
        0

fn block_tail_type(b: Int, env: Int) -> Int ! alloc
    if b == 0
        0
    else
        expr_type(block_tail(b), env)

# Type text handle of `e` under `env`, or 0 when unknown.
fn expr_type(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_STRING()
            ty_string()
        elsif k == EX_CALL()
            call_type(e, env)
        elsif k == EX_TENSOR()
            tensor_lit_type(e)
        elsif k == EX_IDENT()
            strenv_type(env, vec_get(e, 1))
        elsif k == EX_FLOAT()
            ty_float()
        elsif k == EX_UNARY()
            if str_eq(vec_get(e, 1), "neg") == 1
                expr_type(vec_get(e, 2), env)
            else
                0
        elsif k == EX_BINARY()
            if str_eq(vec_get(e, 1), "add") == 1
                lt = expr_type(vec_get(e, 2), env)
                if ty_handle_is_string(lt) == 1
                    ty_string()
                elsif ty_handle_is_float(lt) == 1
                    ty_float()
                else
                    0
            elsif binary_arith_is_float(e, env) == 1
                ty_float()
            else
                0
        elsif k == EX_FIELD()
            struct_field_type(strenv_structs(env), expr_type(vec_get(e, 1), env), vec_get(e, 2))
        elsif k == EX_IF()
            block_tail_type(vec_get(e, 2), env)
        else
            0

# sub, mul or div with a Float operand.
fn binary_arith_is_float(e: Int, env: Int) -> Int ! alloc
    op = vec_get(e, 1)
    if str_eq(op, "sub") + str_eq(op, "mul") + str_eq(op, "div") == 0
        0
    elsif expr_is_float(vec_get(e, 2), env) == 1
        1
    elsif expr_is_float(vec_get(e, 3), env) == 1
        1
    else
        0

fn expr_produces_string(e: Int, env: Int) -> Int ! alloc
    ty_handle_is_string(expr_type(e, env))

fn binary_add_is_string_concat(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    elsif ex_kind(e) == EX_BINARY()
        if str_eq(vec_get(e, 1), "add") == 1
            expr_produces_string(vec_get(e, 2), env)
        else
            0
    else
        0

fn binary_add_uses_append(e: Int, env: Int) -> Int ! alloc
    if binary_add_is_string_concat(e, env) == 0
        0
    else
        binary_add_is_string_concat(vec_get(e, 2), env)

# Leftmost leaf of a `+` chain: `((a + b) + c)` -> `a`.
fn add_chain_leftmost(e: Int) -> Int ! alloc
    if ex_kind(e) == EX_BINARY()
        if str_eq(vec_get(e, 1), "add") == 1
            add_chain_leftmost(vec_get(e, 2))
        else
            e
    else
        e

# `name = name + ...` with a string chain starting at `name`.
fn assign_accumulates_string(name: Int, value: Int, env: Int) -> Int ! alloc
    if binary_add_is_string_concat(value, env) == 0
        0
    else
        leaf = add_chain_leftmost(value)
        if ex_kind(leaf) == EX_IDENT()
            str_eq(vec_get(leaf, 1), name)
        else
            0

# The right operand of a string `+` is a temporary this expression owns.
# A left operand that is a fresh-string call: the first `str_concat` of a chain copies
# from it and must release it.
fn add_left_is_fresh_call(left: Int) -> Int ! alloc
    if ex_kind(left) == EX_CALL()
        call_allocates_fresh_string(vec_get(left, 1))
    else
        0

fn add_right_is_fresh_temp(right: Int, env: Int) -> Int ! alloc
    k = ex_kind(right)
    if k == EX_BINARY()
        binary_add_is_string_concat(right, env)
    elsif k == EX_CALL()
        call_allocates_fresh_string(vec_get(right, 1))
    else
        0

fn fnret_map_from_prog(prog: Int) -> Int ! alloc
    m = map_new()
    fns = prog_fns(prog)
    fnret_map_fill(m, fns, 0, vec_len(fns))
    m

fn fnret_map_fill(m: Int, fns: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = vec_get(fns, i)
        gi = generic_ret_param(f)
        if gi >= 0
            # generic `-> T`: remember which argument carries the result type
            _g = map_put(m, str_as_int("$g:" + str_from_int(vec_get(f, 0))), gi + 1)
            _p = map_put(m, vec_get(f, 0), str_as_int(d"Unknown"))
        elsif fndef_ret(f) != 0
            _p = map_put(m, vec_get(f, 0), fndef_ret(f))
        else
            _p = 0
        fnret_map_fill(m, fns, i + 1, n)

# Index of the first param whose type is the bare type parameter `f` returns, or -1.
fn generic_ret_param(f: Int) -> Int ! alloc
    ret = fndef_ret(f)
    tps = fndef_type_params(f)
    if ret == 0
        0 - 1
    elsif vec_len(tps) == 0
        0 - 1
    elsif ty_in_names(ret, tps, 0, vec_len(tps)) == 0
        0 - 1
    else
        generic_ret_param_go(vec_get(f, 1), ret, 0, vec_len(vec_get(f, 1)))

fn ty_in_names(ty: Int, names: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif ty_text_matches(ty, vec_get(names, i)) == 1
        1
    else
        ty_in_names(ty, names, i + 1, n)

fn generic_ret_param_go(params: Int, ret: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif ty_text_matches(vec_get(vec_get(params, i), 1), ret) == 1
        i
    else
        generic_ret_param_go(params, ret, i + 1, n)

fn assign_accumulates(value: Int, name: Int) -> Int ! alloc
    if ex_kind(value) == EX_BINARY()
        if str_eq(vec_get(value, 1), "add") == 1
            leaf = add_chain_leftmost(value)
            if ex_kind(leaf) == EX_IDENT()
                str_eq(vec_get(leaf, 1), name)
            else
                0
        else
            0
    else
        0
