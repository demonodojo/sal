# AST constructors. Binary operators are left-associative in the parser that builds them.

fn EX_INT() -> Int
    0

fn EX_FLOAT() -> Int
    1

fn EX_STRING() -> Int
    2

fn EX_IDENT() -> Int
    3

fn EX_BINARY() -> Int
    4

fn EX_CALL() -> Int
    5

fn EX_TO() -> Int
    6

fn EX_ON() -> Int
    7

fn EX_TENSOR() -> Int
    8

fn EX_IF() -> Int
    9

fn EX_WHILE() -> Int
    10

# ---- AST ----
fn ex_int(v: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_INT())
    _b = vec_push(e, v)
    e

fn ex_float() -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_FLOAT())
    _b = vec_push(e, 0)
    e

fn ex_string(t: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_STRING())
    _b = vec_push(e, t)
    e

fn ex_ident(t: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_IDENT())
    _b = vec_push(e, t)
    e

fn ex_binary(op: Int, left: Int, right: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_BINARY())
    _b = vec_push(e, op)
    _c = vec_push(e, left)
    _d = vec_push(e, right)
    e

fn ex_call(name: Int, args: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_CALL())
    _b = vec_push(e, name)
    _c = vec_push(e, args)
    e

fn ex_to(place: Int, inner: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TO())
    _b = vec_push(e, place)
    _c = vec_push(e, inner)
    e

fn ex_on(place: Int, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_ON())
    _b = vec_push(e, place)
    _c = vec_push(e, body)
    e

fn ex_tensor(nrows: Int, ncols: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_TENSOR())
    _b = vec_push(e, nrows)
    _c = vec_push(e, ncols)
    e

fn ex_if(cond: Int, then_b: Int, else_b: Int, arms: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_IF())
    _b = vec_push(e, cond)
    _c = vec_push(e, then_b)
    _d = vec_push(e, else_b)
    _e = vec_push(e, arms)
    e

fn ex_while(cond: Int, body: Int) -> Int ! alloc
    e = vec_new()
    _a = vec_push(e, EX_WHILE())
    _b = vec_push(e, cond)
    _c = vec_push(e, body)
    e

fn ex_kind(e: Int) -> Int ! alloc
    if e == 0
        0 - 1
    else
        vec_get(e, 0)

fn stmt_new(is_as: Int, name: Int, expr: Int) -> Int ! alloc
    s = vec_new()
    _a = vec_push(s, is_as)
    _b = vec_push(s, name)
    _c = vec_push(s, expr)
    s

fn block_new() -> Int ! alloc
    b = vec_new()
    stmts = vec_new()
    _a = vec_push(b, stmts)
    _b = vec_push(b, 0)
    b

fn block_stmts(b: Int) -> Int ! alloc
    vec_get(b, 0)

fn block_tail(b: Int) -> Int ! alloc
    vec_get(b, 1)

fn block_set_tail(b: Int, t: Int) -> Int ! alloc
    _s = vec_set(b, 1, t)
    0

fn param_new(name: Int, ty: Int) -> Int ! alloc
    pr = vec_new()
    _a = vec_push(pr, name)
    _b = vec_push(pr, ty)
    pr

fn fndef_new(name: Int, params: Int, body: Int) -> Int ! alloc
    f = vec_new()
    _a = vec_push(f, name)
    _b = vec_push(f, params)
    _c = vec_push(f, body)
    f

fn prog_new() -> Int ! alloc
    pr = vec_new()
    fns = vec_new()
    imps = vec_new()
    _a = vec_push(pr, fns)
    _b = vec_push(pr, imps)
    pr

fn prog_fns(pr: Int) -> Int ! alloc
    vec_get(pr, 0)

fn prog_imports(pr: Int) -> Int ! alloc
    vec_get(pr, 1)

# Same string heuristic as the bootstrap (src/string_expr.rs). A name noted in
# `env` counts as String. The right operand of `+` need not be a string: the
# first `+` is str_concat and a later `+` whose left child is a string add is
# str_append. `env` is a strenv (0 means no locals).

fn strenv_new() -> Int ! alloc
    v = vec_new()
    _p = vec_push(v, 0)
    v

fn strenv_len(env: Int) -> Int ! alloc
    vec_get(env, 0)

fn strenv_set_len(env: Int, n: Int) -> Int ! alloc
    _s = vec_set(env, 0, n)
    0

fn strenv_bind(env: Int, name: Int, flag: Int) -> Int ! alloc
    if env == 0
        0
    else
        len = strenv_len(env)
        base = 1 + len * 2
        if base >= vec_len(env)
            _a = vec_push(env, name)
            _b = vec_push(env, flag)
            strenv_set_len(env, len + 1)
        else
            _a = vec_set(env, base, name)
            _b = vec_set(env, base + 1, flag)
            strenv_set_len(env, len + 1)

fn strenv_has_go(env: Int, name: Int, i: Int) -> Int ! alloc
    if i < 0
        0
    else
        base = 1 + i * 2
        if str_eq(vec_get(env, base), name) == 1
            vec_get(env, base + 1)
        else
            strenv_has_go(env, name, i - 1)

fn strenv_has(env: Int, name: Int) -> Int ! alloc
    if env == 0
        0
    else
        strenv_has_go(env, name, strenv_len(env) - 1)

fn ty_is_string(ty: Int) -> Int ! alloc
    if str_eq(ty, "String") == 1
        1
    else
        str_eq(ty, "String ") == 1

fn call_returns_string(name: Int) -> Int ! alloc
    if str_eq(name, "argv") == 1
        1
    else
        if str_eq(name, "read_file") == 1
            1
        else
            if str_eq(name, "str_concat") == 1
                1
            else
                if str_eq(name, "str_append") == 1
                    1
                else
                    call_returns_string2(name)

fn call_returns_string2(name: Int) -> Int ! alloc
    if str_eq(name, "str_slice") == 1
        1
    else
        if str_eq(name, "int_to_str") == 1
            1
        else
            if str_eq(name, "char_to_str") == 1
                1
            else
                if str_eq(name, "strdup") == 1
                    1
                else
                    call_returns_string3(name)

fn call_returns_string3(name: Int) -> Int ! alloc
    if str_eq(name, "select_str") == 1
        1
    else
        if str_eq(name, "tmp_path") == 1
            1
        else
            if str_eq(name, "exec_capture") == 1
                1
            else
                if str_eq(name, "getenv") == 1
                    1
                else
                    if str_eq(name, "ir_text") == 1
                        1
                    else
                        0

fn string_add_child(left: Int, right: Int, env: Int) -> Int ! alloc
    if expr_produces_string(left, env) == 1
        1
    else
        expr_produces_string(right, env)

fn expr_produces_string(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_STRING()
            1
        else
            if k == EX_CALL()
                call_returns_string(vec_get(e, 1))
            else
                if k == EX_IDENT()
                    strenv_has(env, vec_get(e, 1))
                else
                    if k == EX_BINARY()
                        if str_eq(vec_get(e, 1), "add") == 1
                            string_add_child(vec_get(e, 2), vec_get(e, 3), env)
                        else
                            0
                    else
                        0

fn binary_add_is_string_concat(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    else
        if ex_kind(e) == EX_BINARY()
            if str_eq(vec_get(e, 1), "add") == 1
                string_add_child(vec_get(e, 2), vec_get(e, 3), env)
            else
                0
        else
            0

fn binary_add_uses_append(e: Int, env: Int) -> Int ! alloc
    if binary_add_is_string_concat(e, env) == 0
        0
    else
        left = vec_get(e, 2)
        if ex_kind(left) == EX_BINARY()
            if str_eq(vec_get(left, 1), "add") == 1
                binary_add_is_string_concat(left, env)
            else
                0
        else
            0
