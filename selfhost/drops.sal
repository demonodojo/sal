# Scope-end release insertion for owned locals; the mirror of src/drops.rs. A local is dropped
# when it is bound once (let or first assignment) to a fresh heap value, never reassigned (except
# the in-place `x = x + ...`) and never escapes: it is only read by borrowing builtins and by `+`.
# Releases go at the end of the declaring block and before each `return` in its scope.
#
# The pass works on a typed fn (`tast.sal`). The program-wide tables it reads (`variants`: variant
# name to `[1 (has fields) or 2 (unit), per-field "may own heap memory" flags]` and
# `struct:Name` to a flat struct's per-field "is a String" flags; `ro`: fn name to its parameters'
# read-only flags) are still handle maps built by `fuse.sal`, so they are `Int` fields here.
import tast
import tytext
import tshape

# Name to number; a missing name reads 0.
struct NM
    names: List[String]
    vals: List[Int]

fn nm_new() -> NM ! alloc
    NM(list_new[String](), list_new[Int]())

fn nm_find(m: NM, name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_eq(list_get(m.names, i), name) == 1
        i
    else
        nm_find(m, name, i + 1, n)

fn nm_get(m: NM, name: String) -> Int ! alloc
    i = nm_find(m, name, 0, list_len(m.names))
    if i < 0
        0
    else
        list_get(m.vals, i)

fn nm_put(m: NM, name: String, v: Int) -> Int ! alloc
    i = nm_find(m, name, 0, list_len(m.names))
    if i < 0
        _a = list_push(m.names, strdup(name))
        _b = list_push(m.vals, v)
        0
    else
        _c = list_set(m.vals, i, v)
        0

fn nm_free(m: NM) -> Int ! alloc
    _a = list_free(m.names)
    list_free(m.vals)

# `esc` holds names that leave their scope, `defs` how often each is bound, `params` the
# parameters, `kinds` how a fresh local is released, `tainted` containers that received a value
# not known to be fresh, `soft` names that escape only at whole statements of their own loop
# depth, `born` the loop depth (+1) each name was bound at. `sites` pairs a statement id with a
# name it moves. `m_scrut`/`m_bound` record, per `match x`, the scrutinee and the owned names
# its patterns bind (comma separated). `cells`: 0 temp counter, 1 statement being walked (0 when
# none can clear a flag), 2 depth inside blocks the transform skips, 3 loop depth.
struct DC
    esc: NM
    defs: NM
    params: NM
    kinds: NM
    tainted: NM
    soft: NM
    box_shell: NM
    born: NM
    owned_enums: NM
    lists: NM
    copy_desc: NM
    live: List[String]
    site_ids: List[Int]
    site_names: List[String]
    m_scrut: List[String]
    m_bound: List[String]
    cells: List[Int]
    variants: Int
    ro: Int

fn dr_new(variants: Int, ro: Int, lists: NM) -> DC ! alloc
    cells = list_new[Int]()
    _a = list_push(cells, 0)
    _b = list_push(cells, 0)
    _c = list_push(cells, 0)
    _d = list_push(cells, 0)
    _e = list_push(cells, 0)
    DC(nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), lists, nm_new(), list_new[String](), list_new[Int](), list_new[String](), list_new[String](), list_new[String](), cells, variants, ro)

fn dr_free(c: DC) -> Int ! alloc
    _l = nm_free(c.lists)
    _k = nm_free(c.copy_desc)
    _a = nm_free(c.esc)
    _b = nm_free(c.defs)
    _c = nm_free(c.params)
    _d = nm_free(c.kinds)
    _e = nm_free(c.tainted)
    _f = nm_free(c.soft)
    _f2 = nm_free(c.box_shell)
    _g = nm_free(c.born)
    _g2 = nm_free(c.owned_enums)
    _h = list_free(c.live)
    _i = list_free(c.site_ids)
    _j = list_free(c.site_names)
    _k = list_free(c.m_scrut)
    _l = list_free(c.m_bound)
    _m = list_free(c.cells)
    0

fn dr_cell(c: DC, i: Int) -> Int ! alloc
    list_get(c.cells, i)

fn dr_set(c: DC, i: Int, v: Int) -> Int ! alloc
    _a = list_set(c.cells, i, v)
    0

fn dr_escape(c: DC, name: String) -> Int ! alloc
    nm_put(c.esc, name, 1)

fn dr_bind(c: DC, name: String) -> Int ! alloc
    if nm_get(c.born, name) == 0
        _d = nm_put(c.born, name, dr_cell(c, 3) + 1)
        nm_put(c.defs, name, nm_get(c.defs, name) + 1)
    else
        nm_put(c.defs, name, nm_get(c.defs, name) + 1)

# Records that statement `st` moves `name`.
fn dr_soft(c: DC, st: Int, name: String) -> Int ! alloc
    _s = nm_put(c.soft, name, 1)
    if dr_site_has(c, st, name, 0, list_len(c.site_ids)) == 1
        0
    else
        _a = list_push(c.site_ids, st)
        _b = list_push(c.site_names, strdup(name))
        0

fn dr_site_has(c: DC, st: Int, name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(c.site_ids, i) == st
        if str_eq(list_get(c.site_names, i), name) == 1
            1
        else
            dr_site_has(c, st, name, i + 1, n)
    else
        dr_site_has(c, st, name, i + 1, n)

# Hard or soft: the name leaves its scope somehow.
fn dr_escapes(c: DC, name: String) -> Int ! alloc
    if nm_get(c.esc, name) != 0
        1
    elsif nm_get(c.soft, name) != 0
        1
    else
        0

fn dr_truncate(c: DC, mark: Int) -> Int ! alloc
    if list_len(c.live) > mark
        _p = list_pop(c.live)
        dr_truncate(c, mark)
    else
        0

fn dr_next_tmp(c: DC) -> String ! alloc
    dr_next_tmp_p(c, "__ret")

# The next temporary name with prefix `p`; `__ret` and `__dis` share the counter.
fn dr_next_tmp_p(c: DC, p: String) -> String ! alloc
    n = dr_cell(c, 0) + 1
    _s = dr_set(c, 0, n)
    p + int_to_str(n)

# Trimmed type text equals `name`.
fn dr_tm(t: String, name: String) -> Int ! alloc
    if str_len(t) == 0
        0
    else
        str_eq(trim_spaces(t), name)


# ---- shapes of an expression ----
fn dx_ident(e: Expr) -> String ! alloc
    match e
        XIdent(s) => s
        _ => d""

fn dx_is_ident(e: Expr) -> Int ! alloc
    match e
        XIdent(s) => 1
        _ => 0

fn dx_is_call(e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => 1
        _ => 0

fn dx_is_none(e: Expr) -> Int ! alloc
    match e
        XNone => 1
        _ => 0

fn dx_is_while(e: Expr) -> Int ! alloc
    match e
        XWhile(cond, body) => 1
        _ => 0

fn dx_is_if(e: Expr) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => 1
        _ => 0

fn dx_is_string_operand(e: Expr) -> Int ! alloc
    match e
        XStr(s) => 1
        XCall(name, args, targs, xp) => dr_returns_fresh(name)
        _ => 0

# A `+` chain is a string concatenation when some operand is syntactically a string.
fn dx_add_is_string_chain(e: Expr) -> Int ! alloc
    match e
        XBin(op, l, r) => dx_chain_bin(op, l, r)
        _ => dx_is_string_operand(e)

fn dx_chain_bin(op: String, l: Expr, r: Expr) -> Int ! alloc
    if str_eq(op, "add") == 1
        if dx_add_is_string_chain(l) == 1
            1
        else
            dx_is_string_operand(r)
    else
        0

# A value certainly owned by whoever stores it: a literal, a fresh-string call or a string `+` chain.
fn dx_is_fresh_value(e: Expr) -> Int ! alloc
    match e
        XBin(op, l, r) => dx_add_is_string_chain(e)
        _ => dx_is_string_operand(e)

# A fresh temporary the hoist binds: a fresh value, or a call to a user fn the caller owns.
fn dx_is_fresh_temp_v(vm: Int, e: Expr) -> Int ! alloc
    match e
        XNone => 0
        XStr(s) => 0
        XCall(name, args, targs, xp) => dx_is_fresh_call_v(vm, e, name)
        _ => dx_is_fresh_value(e)

fn dx_is_fresh_call_v(vm: Int, e: Expr, name: String) -> Int ! alloc
    if dr_owned_name(vm, name) == 1
        1
    else
        dx_is_fresh_value(e)

# `list_new[T]()` with T Int, Float, Bool or String (or no type argument).
fn dx_copy_elem_args(targs: String) -> Int ! alloc
    if str_len(targs) == 0
        1
    elsif dr_tm(targs, "Int") == 1
        1
    elsif dr_tm(targs, "Float") == 1
        1
    elsif dr_tm(targs, "Bool") == 1
        1
    elsif dr_tm(targs, "String") == 1
        1
    else
        0

fn dx_find_comma(s: String, i: Int) -> Int ! alloc
    if i >= str_len(s)
        0 - 1
    elsif str_char(s, i) == 44
        i
    else
        dx_find_comma(s, i + 1)

fn dx_key_ok(k: String) -> Int ! alloc
    if dr_tm(k, "Int") == 1
        1
    elsif dr_tm(k, "String") == 1
        1
    else
        0

fn dx_val_ok(v: String) -> Int ! alloc
    if dr_tm(v, "Int") == 1
        1
    elsif dr_tm(v, "Float") == 1
        1
    elsif dr_tm(v, "Bool") == 1
        1
    elsif dr_tm(v, "String") == 1
        1
    else
        0

# `dict_new[K, V]()` with K Int or String and V Int, Float, Bool or String.
fn dx_dict_args(targs: String) -> Int ! alloc
    if str_len(targs) == 0
        0
    else
        comma = dx_find_comma(targs, 0)
        if comma < 0
            0
        elsif dx_key_ok(trim_spaces(str_slice(targs, 0, comma))) == 1
            dx_val_ok(trim_spaces(str_slice(targs, comma + 1, str_len(targs))))
        else
            0

# `dict_new[K, String]()`: the dict owns its values.
fn dx_dict_owns(targs: String) -> Int ! alloc
    comma = dx_find_comma(targs, 0)
    dr_tm(trim_spaces(str_slice(targs, comma + 1, str_len(targs))), "String")

# `list_new[String]()`: the list owns its elements.
fn dx_list_owns(targs: String) -> Int ! alloc
    if str_len(targs) == 0
        0
    else
        dr_tm(targs, "String")

fn dr_flat_rec(c: DC, name: String) -> Int ! alloc
    map_get(c.variants, str_as_int("struct:" + name))

# `list_push`, a struct ctor, … take the whole box; a user fn only scalarizes the fields.
fn dr_transfers_box(c: DC, name: String) -> Int ! alloc
    if str_eq(name, "list_push") + str_eq(name, "list_set") + str_eq(name, "dict_put") > 0
        1
    elsif dr_flat_rec(c, name) != 0
        1
    else
        0

# `list_new[S]()` of a flat struct: the list owns the element blocks and their strings.
fn dx_list_flat(c: DC, targs: String) -> Int ! alloc
    if str_len(targs) == 0
        0
    elsif dr_flat_rec(c, trim_spaces(targs)) == 0
        0
    else
        1

# `S(a, b, ..)` of a flat struct whose String fields are all fresh values.
fn dx_is_fresh_flat_ctor(c: DC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_flat_ctor(c, name, args)
        _ => 0

fn dx_flat_ctor(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    rec = dr_flat_rec(c, name)
    if rec == 0
        0
    elsif vec_len(rec) != list_len(args)
        0
    else
        dx_flat_args_fresh(c, rec, args, 0, list_len(args))

# Each field's class (`field_class_text` in fuse.sal): a String must be fresh, an enum field a
# variant constructor, a struct field a fresh struct constructor; scalars need nothing.
fn dx_flat_args_fresh(c: DC, rec: Int, args: List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    elsif dx_field_fresh(c, vec_get(rec, i), list_get(args, i)) == 1
        dx_flat_args_fresh(c, rec, args, i + 1, n)
    else
        0

fn dx_field_fresh(c: DC, code: Int, a: Expr) -> Int ! alloc
    if code == 1
        dx_is_fresh_value(a)
    elsif code == 2
        dx_is_fresh_variant(c, a)
    elsif code == 3
        dx_is_fresh_flat_ctor(c, a)
    else
        1

# Whether variant `name` has fields.
fn dr_variant_has_fields(c: DC, name: String) -> Int ! alloc
    rec = map_get(c.variants, str_as_int(name))
    if rec == 0
        0
    elsif vec_get(rec, 0) == 1
        1
    else
        0

# User fns whose `String` result the caller owns (`owned_return_fns` in src/drops.rs): the
# variant map holds `ownfn:<name>` for each of them.
fn dr_owned_name(vm: Int, name: String) -> Int ! alloc
    if map_get(vm, str_as_int("ownfn:" + name)) == 1
        1
    else
        0

fn owned_fns_put(m: Int, fns: List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        _o = if ty_is_string(f.ret) == 1
            if owned_fn_body(f) == 1
                map_put(m, str_as_int("ownfn:" + f.name), 1)
            else
                0
        else
            0
        owned_fns_put(m, fns, i + 1, n)

# The body is `return`ed fresh values only: every binding is fresh and bound once, no `if`,
# `match` or `while` sits at its top level, and so do the returns and the tail.
fn owned_fn_body(f: TFn) -> Int ! alloc
    locals = list_new[String]()
    if owned_scan(f.body.stmts, 0, list_len(f.body.stmts), locals) == 0
        0
    elsif owned_tail_ok(f.body.tail, locals, f.params) == 0
        0
    else
        owned_returns_ok(f.body.stmts, 0, list_len(f.body.stmts), locals, f.params)

fn owned_scan(stmts: List[TStmt], i: Int, n: Int, locals: List[String]) -> Int ! alloc
    if i >= n
        1
    else
        st = list_get(stmts, i)
        ok = owned_stmt(stmts, st, locals)
        if ok == 0
            0
        else
            owned_scan(stmts, i + 1, n, locals)

fn owned_stmt(stmts: List[TStmt], st: TStmt, locals: List[String]) -> Int ! alloc
    if st.kind == 2
        1
    elsif owned_branches(st.expr) == 1
        0
    elsif st.kind == 0
        1 - dx_is_while(st.expr)
    elsif st.kind == 1
        _b = owned_bind_local(stmts, st, locals)
        1
    else
        1

# A binding whose value is fresh and that is bound once is a local the return may hand out.
fn owned_bind_local(stmts: List[TStmt], st: TStmt, locals: List[String]) -> Int ! alloc
    if owned_fresh_builtin(st.expr) == 0
        0
    elsif owned_binds(stmts, 0, list_len(stmts), st.name) == 1
        _p = list_push(locals, strdup(st.name))
        1
    else
        0

fn owned_tail_ok(t: Expr, locals: List[String], params: List[TParam]) -> Int ! alloc
    match t
        XNone => 0
        _ => owned_return_ok(t, locals, params)

fn owned_returns_ok(stmts: List[TStmt], i: Int, n: Int, locals: List[String], params: List[TParam]) -> Int ! alloc
    if i >= n
        1
    else
        st = list_get(stmts, i)
        r = if st.kind == 2
            owned_return_ok(st.expr, locals, params)
        else
            1
        if r == 0
            0
        else
            owned_returns_ok(stmts, i + 1, n, locals, params)

fn owned_return_ok(v: Expr, locals: List[String], params: List[TParam]) -> Int ! alloc
    match v
        XNone => 1
        _ => if owned_branches(v) == 1
            0
        elsif owned_fresh_builtin(v) == 1
            1
        elsif owned_param_string_field(v, params) == 1
            1
        else
            owned_local(v, locals)

fn owned_param_string_field(v: Expr, params: List[TParam]) -> Int ! alloc
    match v
        XField(XIdent(name), field) => param_named(params, name, 0, list_len(params))
        _ => 0

fn param_named(params: List[TParam], name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(params, i).name, name) == 1
        1
    else
        param_named(params, name, i + 1, n)

fn owned_local(v: Expr, locals: List[String]) -> Int ! alloc
    match v
        XIdent(name) => dr_in_live(locals, name, 0, list_len(locals))
        _ => 0

# How often the statements bind `name` (a `let` or a first assignment).
fn owned_binds(stmts: List[TStmt], i: Int, n: Int, name: String) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        here = if st.kind == 1
            str_eq(st.name, name)
        else
            0
        here + owned_binds(stmts, i + 1, n, name)

# A builtin whose `String` result is fresh, without the user fns (`fresh_builtin` in src/drops.rs).
fn owned_fresh_builtin(e: Expr) -> Int ! alloc
    match e
        XStr(s) => 1
        XCall(name, args, targs, xp) => dr_returns_fresh(name)
        XBin(op, l, r) => dx_add_is_string_chain(e)
        _ => 0

fn owned_branches(e: Expr) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => 1
        XMatch(scrut, arms) => 1
        _ => 0

# How a fresh local is released: 0 none, 1 `free`, 2 `list_free`, 3 `bytes_free`, 4 `dict_free`,
# 5 `enum_free` (box of a variant with fields), 6 a list that owns its elements, 7 a dict that does.
fn dr_fresh_kind(c: DC, e: Expr) -> Int ! alloc
    match e
        XStr(s) => 1
        XCall(name, args, targs, xp) => dr_fresh_call(c, name, targs)
        XBin(op, l, r) => dr_fresh_bin(op, e)
        _ => 0

fn dr_fresh_bin(op: String, e: Expr) -> Int ! alloc
    if str_eq(op, "add") == 1
        dx_add_is_string_chain(e)
    else
        0

fn dr_fresh_call(c: DC, name: String, targs: String) -> Int ! alloc
    if dr_returns_fresh(name) == 1
        1
    elsif dr_owned_name(c.variants, name) == 1
        1
    elsif dr_variant_has_fields(c, name) == 1
        5
    elsif str_eq(name, "bytes_new") == 1
        3
    elsif str_eq(name, "list_new") == 1
        dr_fresh_list(c, targs)
    elsif str_eq(name, "dict_new") == 1
        dr_fresh_dict(targs)
    elsif str_eq(name, "dict_keys") + str_eq(name, "dict_values") == 1
        # A fresh list whose String elements are copies the list owns.
        6
    elsif str_eq(name, "dict_get") == 1
        5
    elsif str_eq(name, "bytes_view") + str_eq(name, "bytes_view_mem") == 1
        3
    else
        0

fn dr_fresh_list(c: DC, targs: String) -> Int ! alloc
    if dx_list_flat(c, targs) == 1
        6
    elsif dx_list_enum(c, targs) == 1
        6
    elsif dx_copy_elem_args(targs) == 1
        if dx_list_owns(targs) == 1
            6
        else
            2
    else
        0

fn dr_fresh_dict(targs: String) -> Int ! alloc
    if dx_dict_args(targs) == 1
        if dx_dict_owns(targs) == 1
            7
        else
            4
    else
        0

# `x = x + ...`: appends in place, not a new binding.
fn dr_is_accumulate(name: String, value: Expr) -> Int ! alloc
    match value
        XBin(op, l, r) => dr_accumulates(name, op, l)
        _ => 0

fn dr_accumulates(name: String, op: String, l: Expr) -> Int ! alloc
    if str_eq(op, "add") == 1
        str_eq(dx_leftmost(l), name)
    else
        0

# Identifier at the left end of a `+` chain, "" when it is not one.
fn dx_leftmost(e: Expr) -> String ! alloc
    match e
        XBin(op, l, r) => dx_leftmost_bin(op, l, e)
        XIdent(s) => s
        _ => d""

fn dx_leftmost_bin(op: String, l: Expr, e: Expr) -> String ! alloc
    if str_eq(op, "add") == 1
        dx_leftmost(l)
    else
        d""

# ---- escape facts ----
# `mov`: 1 read, 2 transfer box, 3 take fields only.
fn dr_arg(c: DC, a: Expr, mov: Int) -> Int ! alloc
    match a
        XNone => 0
        XIdent(n) => dr_arg_ident(c, n, mov)
        XField(base, field) => dr_arg_field(c, a, mov)
        _ => dr_expr(c, a)

# A field read in a moving position hands out a value that aliases its base: the base escapes.
fn dr_arg_field(c: DC, a: Expr, mov: Int) -> Int ! alloc
    root = dr_field_root(a)
    _e = if mov != 1
        if str_len(root) == 0
            0
        else
            dr_escape(c, root)
    else
        0
    dr_expr(c, a)

fn dr_field_root(e: Expr) -> String ! alloc
    match e
        XField(base, field) => dr_field_root(base)
        XIdent(name) => name
        _ => d""

fn dr_arg_ident(c: DC, n: String, mov: Int) -> Int ! alloc
    if mov != 1
        dr_arg_escape(c, n, mov)
    else
        0

fn dr_arg_escape(c: DC, name: String, mov: Int) -> Int ! alloc
    if dr_cell(c, 4) > 0
        _s = nm_put(c.soft, name, 0)
        dr_escape(c, name)
    elsif dr_cell(c, 1) == 0
        dr_escape(c, name)
    elsif nm_get(c.born, name) == dr_cell(c, 3) + 1
        dr_soft(c, dr_cell(c, 1), name)
        if mov == 3
            nm_put(c.box_shell, name, 1)
        else
            0
    else
        dr_escape(c, name)

# An `if` in a position `dr_xform_expr` rewrites: its branches are visited.
fn dr_top(c: DC, e: Expr, mov: Int) -> Int ! alloc
    if dx_is_if(e) == 1
        dr_walk_if(c, e)
    else
        dr_arg(c, e, mov)

fn dr_walk_if(c: DC, e: Expr) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_walk_if_parts(c, cond, then_b, else_b, has_else, elsifs)
        _ => 0

fn dr_walk_if_parts(c: DC, cond: Expr, then_b: TBlock, else_b: TBlock, has_else: Int, elsifs: List[TElsif]) -> Int ! alloc
    _a = dr_arg(c, cond, 1)
    _b = dr_block(c, then_b)
    _c = dr_if_arms(c, elsifs, 0, list_len(elsifs))
    if has_else == 1
        dr_block(c, else_b)
    else
        0

# Arguments of a call: bare identifiers are only read when the callee borrows them
# (`safe`) or its parameter at that position is read-only (`ro`, 0 when not a user fn).
fn dr_call_args(c: DC, callee: String, args: List[Expr], i: Int, n: Int, borrow: Int, ro: Int, hard: Int) -> Int ! alloc
    if i >= n
        0
    else
        reads = dr_ro_at(ro, i)
        mov = if borrow == 1
            1
        elsif reads == 1
            1
        elsif hard == 1
            2
        elsif dr_transfers_box(c, callee) == 1
            2
        else
            3
        _a = dr_arg(c, list_get(args, i), mov)
        dr_call_args(c, callee, args, i + 1, n, borrow, ro, hard)

fn dr_ro_at(ro: Int, i: Int) -> Int ! alloc
    if ro == 0
        0
    elsif i < vec_len(ro)
        vec_get(ro, i)
    else
        0

fn dr_pattern(c: DC, p: TPat) -> Int ! alloc
    if p.kind == 1
        dr_bind(c, p.name)
    elsif p.kind == 3
        dr_patterns(c, p.args, 0, list_len(p.args))
    else
        0

fn dr_patterns(c: DC, ps: List[TPat], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dr_pattern(c, list_get(ps, i))
        dr_patterns(c, ps, i + 1, n)

# Unknown variants stay conservative (owned).
fn dr_field_flag(rec: Int, i: Int) -> Int ! alloc
    if rec == 0
        1
    elsif i < vec_len(vec_get(rec, 1))
        vec_get(vec_get(rec, 1), i)
    else
        1

# Names bound by the variant patterns of `arms` over fields that may own memory, comma terminated.
fn dr_arms_bound(c: DC, arms: List[TArm], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        dr_arms_bound(c, arms, i + 1, n, dr_pat_bound(c, list_get(arms, i).pat, acc))

fn dr_pat_bound(c: DC, pat: TPat, acc: String) -> String ! alloc
    if pat.kind == 3
        rec = map_get(c.variants, str_as_int(pat.name))
        dr_pat_bound_go(c, rec, pat.args, 0, list_len(pat.args), acc)
    else
        acc

fn dr_pat_bound_go(c: DC, rec: Int, args: List[TPat], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        sub = list_get(args, i)
        if sub.kind == 1
            if dr_field_flag(rec, i) == 1
                dr_pat_bound_go(c, rec, args, i + 1, n, acc + sub.name + ",")
            else
                dr_pat_bound_go(c, rec, args, i + 1, n, acc)
        else
            dr_pat_bound_go(c, rec, args, i + 1, n, dr_pat_bound(c, sub, acc))

# A payload bound by a pattern aliases a field of the box; if that name escapes, the
# scrutinee's box can no longer be freed. Repeats until nothing changes.
fn dr_propagate(c: DC) -> Int ! alloc
    ch = dr_propagate_once(c, 0, list_len(c.m_scrut), 0)
    if ch > 0
        dr_propagate(c)
    else
        0

fn dr_propagate_once(c: DC, i: Int, n: Int, changed: Int) -> Int ! alloc
    if i >= n
        changed
    else
        scrut = list_get(c.m_scrut, i)
        if nm_get(c.esc, scrut) == 0
            if dr_any_escaped(c, list_get(c.m_bound, i), 0, 0) == 1
                _e = dr_escape(c, scrut)
                dr_propagate_once(c, i + 1, n, changed + 1)
            else
                dr_propagate_once(c, i + 1, n, changed)
        else
            dr_propagate_once(c, i + 1, n, changed)

# Whether some name of the comma-terminated list `s` escapes.
fn dr_any_escaped(c: DC, s: String, from: Int, i: Int) -> Int ! alloc
    if i >= str_len(s)
        0
    elsif str_char(s, i) == 44
        if dr_escapes(c, str_slice(s, from, i)) == 1
            1
        else
            dr_any_escaped(c, s, i + 1, i + 1)
    else
        dr_any_escaped(c, s, from, i + 1)

fn dr_binds_whole(c: DC, arms: List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        pat = list_get(arms, i).pat
        if pat.kind == 1
            if map_get(c.variants, str_as_int(pat.name)) == 0
                1
            else
                dr_binds_whole(c, arms, i + 1, n)
        else
            dr_binds_whole(c, arms, i + 1, n)

fn dr_match_arms(c: DC, arms: List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = dr_pattern(c, arm.pat)
        if arm.has_suite == 1
            _b = dr_block(c, arm.suite)
        else
            _b = dr_expr(c, arm.body)
        dr_match_arms(c, arms, i + 1, n)

fn dr_if_arms(c: DC, arms: List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = dr_arg(c, arm.cond, 1)
        _b = dr_block(c, arm.body)
        dr_if_arms(c, arms, i + 1, n)

fn dr_expr(c: DC, e: Expr) -> Int ! alloc
    match e
        XIdent(n) => dr_escape(c, n)
        XCall(name, args, targs, xp) => dr_call(c, name, args)
        XLambda(param, body) => dr_lambda(c, param, body)
        XBin(op, l, r) => dr_binary(c, l, r)
        XUnary(op, inner) => dr_arg(c, inner, 1)
        XOn(place, body, kern, idx) => dr_on(c, body)
        XTo(place, inner) => dr_arg(c, inner, 3)
        XField(base, field) => dr_arg(c, base, 1)
        XMatch(scrut, arms) => dr_match(c, scrut, arms)
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_if_nested(c, e)
        XWhile(cond, body) => dr_while(c, cond, body)
        XTry(inner) => dr_arg(c, inner, 3)
        _ => 0

fn dr_call(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    hard = dr_flat_rec(c, name)
    if hard != 0
        _h = dr_set(c, 4, dr_cell(c, 4) + 1)
    else
        _z = 0
    ro = map_get(c.ro, str_as_int(name))
    hflag = if hard != 0
        1
    else
        0
    _a = dr_call_args(c, name, args, 0, list_len(args), dr_borrows(name), ro, hflag)
    if hard != 0
        dr_set(c, 4, dr_cell(c, 4) - 1)
    else
        0

fn dr_lambda(c: DC, param: String, body: Expr) -> Int ! alloc
    _b = dr_bind(c, param)
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_expr(c, body)
    dr_set(c, 2, dr_cell(c, 2) - 1)

fn dr_binary(c: DC, l: Expr, r: Expr) -> Int ! alloc
    _l = dr_arg(c, l, 1)
    dr_arg(c, r, 1)

fn dr_on(c: DC, body: TBlock) -> Int ! alloc
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_block(c, body)
    dr_set(c, 2, dr_cell(c, 2) - 1)

fn dr_if_nested(c: DC, e: Expr) -> Int ! alloc
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_walk_if(c, e)
    dr_set(c, 2, dr_cell(c, 2) - 1)

fn dr_while(c: DC, cond: Expr, body: TBlock) -> Int ! alloc
    outer = dr_cell(c, 1)
    _n = dr_set(c, 1, 0)
    _a = dr_arg(c, cond, 1)
    _d = dr_set(c, 3, dr_cell(c, 3) + 1)
    _b = dr_block(c, body)
    _u = dr_set(c, 3, dr_cell(c, 3) - 1)
    dr_set(c, 1, outer)

fn dr_match(c: DC, scrut: Expr, arms: List[TArm]) -> Int ! alloc
    # Variant patterns only read the box; a bare binding aliases the whole value.
    if dx_is_ident(scrut) == 1
        _a = list_push(c.m_scrut, strdup(dx_ident(scrut)))
        _b = list_push(c.m_bound, dr_arms_bound(c, arms, 0, list_len(arms), d""))
        0
    else
        0
    if dr_binds_whole(c, arms, 0, list_len(arms)) == 1
        _s = dr_arg(c, scrut, 3)
        0
    else
        _s = dr_arg(c, scrut, 1)
        0
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_match_arms(c, arms, 0, list_len(arms))
    dr_set(c, 2, dr_cell(c, 2) - 1)

# `list_push`, `list_set` and `dict_put` return an alias of their container.
fn dr_is_alias_call(name: String) -> Int ! alloc
    if str_eq(name, "list_push") == 1
        1
    elsif str_eq(name, "list_set") == 1
        1
    elsif str_eq(name, "dict_put") == 1
        1
    else
        0

fn dr_taint_unless_flat(c: DC, name: String, v: Expr) -> Int ! alloc
    if dx_is_fresh_flat_ctor(c, v) == 1
        0
    elsif dx_is_fresh_variant(c, v) == 1
        0
    else
        nm_put(c.tainted, name, 1)

# A variant constructor call `V(..)` builds a new box, and a unit variant `V` is a tag: both
# are fresh values for a list to own (see `is_fresh_variant_ctor` in src/drops.rs).
fn dx_is_fresh_variant(c: DC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dr_variant_has_fields(c, name)
        XIdent(name) => dx_unit_variant(c, name)
        _ => 0

fn dx_unit_variant(c: DC, name: String) -> Int ! alloc
    rec = map_get(c.variants, str_as_int(name))
    if rec == 0
        0
    elsif vec_get(rec, 0) == 2
        1
    else
        0

# `list_new[E]()` of an enum type: the list owns the boxes stored in it.
fn dx_list_enum(c: DC, targs: String) -> Int ! alloc
    t = trim_spaces(targs)
    if str_len(t) == 0
        0
    elsif map_get(c.variants, str_as_int("enum:" + t)) != 0
        1
    else
        0

# `list_get(xs, i)` of an enum list bound to a local: a deep copy of the box, fresh whoever
# owns `xs` (kind 5, `enum_free`).
# `list_get(xs, i)` and `list_pop(xs)` of an owned list bound to a local: a fresh value of the
# list's element kind (5 `enum_free` for an enum box, 1 `free` for a string); 0 otherwise.
fn dx_elem_release(c: DC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_elem_release_call(c, name, args)
        _ => 0

fn dx_elem_release_call(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    if str_eq(name, "list_get") + str_eq(name, "list_pop") == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(first) == 0
            0
        elsif nm_get(c.defs, dx_ident(first)) != 1
            0
        else
            nm_get(c.owned_enums, dx_ident(first))

# An enum list the pass releases (kind 6) is built as `list_new_owned[E]()`: the lowering
# stores the element descriptor `E` and the list frees its boxes. Other enum lists keep
# `list_new` (their elements are borrowed). Remembers the owned locals (`dx_list_get_enum`).
fn dr_own_enum_list(c: DC, name: String, cand: Int, e: Expr) -> Expr ! alloc
    match e
        XCall(fname, args, targs, xp) => dr_own_call(c, name, cand, fname, args, targs, xp, e)
        _ => e

fn dr_own_call(c: DC, name: String, cand: Int, fname: String, args: List[Expr], targs: String, xp: Int, e: Expr) -> Expr ! alloc
    if cand != 6
        e
    elsif str_eq(fname, "list_new") == 0
        e
    elsif dx_list_enum(c, targs) == 1
        _n = nm_put(c.owned_enums, name, 5)
        XCall(d"list_new_owned", args, targs, xp)
    elsif dx_list_flat(c, targs) == 1
        nm_put(c.owned_enums, name, 8)
        XCall(d"list_new_owned", args, targs, xp)
    elsif dx_list_string(targs) == 1
        _s = nm_put(c.owned_enums, name, 1)
        XCall(d"list_new_owned", args, targs, xp)
    else
        e

# `list_new[String]()`: the list owns its strings.
fn dx_list_string(targs: String) -> Int ! alloc
    str_eq(trim_spaces(targs), "String")


# `list_push(xs, v)` as a statement (or bound to a `_name`) discards the
# returned alias of `xs`, so `xs` is only borrowed there. Returns 1 when handled.
fn dr_push_stmt(c: DC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dr_push_call(c, name, args)
        _ => 0

fn dr_push_call(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    if dr_is_alias_call(name) == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(first) == 1
            _t = dr_push_taint(c, dx_ident(first), args)
            _r = dr_args_from(c, args, 1, list_len(args))
            1
        elsif dr_push_stmt(c, first) == 0
            _a = dr_expr(c, first)
            _r = dr_args_from(c, args, 1, list_len(args))
            1
        else
            _r = dr_args_from(c, args, 1, list_len(args))
            1

fn dr_push_taint(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    if list_len(args) >= 2
        last = list_get(args, list_len(args) - 1)
        if dx_is_fresh_value(last) == 0
            dr_taint_unless_flat(c, name, last)
        else
            0
    else
        0

fn dr_args_from(c: DC, args: List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dr_arg(c, list_get(args, i), 2)
        dr_args_from(c, args, i + 1, n)

# Statements whose escapes a transform step can follow up with a flag clear.
fn dr_stmt(c: DC, st: TStmt) -> Int ! alloc
    outer = dr_cell(c, 1)
    if dr_cell(c, 2) == 0
        _s = dr_set(c, 1, st.id)
        0
    else
        _s = dr_set(c, 1, 0)
        0
    r = dr_stmt_go(c, st)
    _t = dr_set(c, 1, outer)
    r

fn dr_stmt_go(c: DC, st: TStmt) -> Int ! alloc
    if st.kind == 1
        dr_stmt_bind(c, st)
    elsif st.kind == 2
        dr_arg(c, st.expr, 3)
    elsif st.kind == 3
        _a = dr_expr(c, st.target)
        dr_top(c, st.expr, 3)
    else
        dr_stmt_expr(c, st.expr)

fn dr_stmt_expr(c: DC, ex: Expr) -> Int ! alloc
    if dr_push_stmt(c, ex) == 1
        0
    elsif dx_is_if(ex) == 1
        dr_walk_if(c, ex)
    else
        dr_expr(c, ex)

fn dr_stmt_bind(c: DC, st: TStmt) -> Int ! alloc
    if st.is_let == 1
        _b = dr_bind(c, st.name)
        dr_top(c, st.expr, 3)
    elsif dr_is_accumulate(st.name, st.expr) == 0
        _b = dr_bind(c, st.name)
        dr_stmt_assign(c, st)
    else
        dr_stmt_assign(c, st)

fn dr_stmt_assign(c: DC, st: TStmt) -> Int ! alloc
    if str_char(st.name, 0) == 95
        if dr_push_stmt(c, st.expr) == 1
            0
        else
            dr_top(c, st.expr, 3)
    else
        dr_top(c, st.expr, 3)

fn dr_stmts(c: DC, stmts: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dr_stmt(c, list_get(stmts, i))
        dr_stmts(c, stmts, i + 1, n)

fn dr_block(c: DC, b: TBlock) -> Int ! alloc
    _a = dr_stmts(c, b.stmts, 0, list_len(b.stmts))
    outer = dr_cell(c, 1)
    _n = dr_set(c, 1, 0)
    r = dr_top(c, b.tail, 3)
    _t = dr_set(c, 1, outer)
    r

# ---- transform ----
fn dr_candidate(c: DC, name: String, ty: String, init: Expr) -> Int ! alloc
    er = dx_elem_release(c, init)
    sd = if er == 0
        dx_struct_copy(c, init)
    elsif er == 8
        dx_owned_struct_desc(c, init)
    else
        0
    _r = if sd != 0
        nm_put(c.copy_desc, name, sd)
    else
        0
    kind = if er != 0
        er
    elsif sd != 0
        8
    else
        dr_fresh_kind(c, init)
    if kind == 0
        0
    elsif str_len(ty) != 0
        if kind != 1
            0
        elsif ty_is_string(ty) == 0
            0
        else
            dr_candidate_go(c, name, kind)
    else
        dr_candidate_go(c, name, kind)

fn dr_candidate_go(c: DC, name: String, kind: Int) -> Int ! alloc
    if dr_kind_owned(kind) == 1
        if nm_get(c.tainted, name) != 0
            0
        else
            dr_candidate_go2(c, name, kind)
    else
        dr_candidate_go2(c, name, kind)

# `list_get(xs, i)` of a list whose element struct a copy can release: the descriptor handle
# (`struct:` release, kind 8), 0 otherwise.
# `list_get` of a struct list the local does not own: a copy (`list_pop` only moves out of owned lists).
fn dx_struct_copy(c: DC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_copy_get(c, name, args)
        _ => 0

fn dx_copy_get(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    if name.eq("list_get") == 0
        0
    else
        dx_struct_copy_call(c, name, args)

fn dx_struct_copy_call(c: DC, name: String, args: List[Expr]) -> Int ! alloc
    if name.eq("list_get") + name.eq("list_pop") == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(first) == 0
            0
        else
            s = nm_get(c.lists, dx_ident(first))
            if s == 0
                0
            else
                map_get(c.variants, str_as_int("desc:" + str_from_int(s)))

# `list_get`/`list_pop` of an owned struct list: the element is a box the local releases
# with `struct_free` under the list's element descriptor.
fn dx_owned_struct_desc(c: DC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_struct_copy_call(c, name, args)
        _ => 0

# Kinds whose container owns its elements.
fn dr_kind_owned(kind: Int) -> Int ! alloc
    if kind == 6
        1
    elsif kind == 7
        1
    else
        0

fn dr_candidate_go2(c: DC, name: String, kind: Int) -> Int ! alloc
    if nm_get(c.params, name) != 0
        0
    elsif nm_get(c.defs, name) != 1
        0
    elsif nm_get(c.esc, name) != 0
        if nm_get(c.box_shell, name) != 0
            kind
        else
            0
    else
        kind

fn dr_empty_block() -> TBlock ! alloc
    TBlock(list_new[TStmt](), XNone)

fn dr_plain(e: Expr) -> TStmt ! alloc
    TStmt(0, d"", e, d"", 0, XNone, 0, 0, 0)

fn dr_free_fn(kind: Int) -> String ! alloc
    if kind == 9
        d"struct_free_box"
    elsif kind == 8
        d"struct_free"
    elsif kind == 2
        d"list_free"
    elsif kind == 6
        d"list_free"
    elsif kind == 7
        d"dict_free"
    elsif kind == 3
        d"bytes_free"
    elsif kind == 4
        d"dict_free"
    elsif kind == 5
        d"enum_free"
    else
        d"free"

fn dr_free_stmt(c: DC, name: String) -> TStmt ! alloc
    args = list_new[Expr]()
    _a = list_push(args, XIdent(strdup(name)))
    k = nm_get(c.kinds, name)
    if k == 8
        _d = list_push(args, XStr(strdup(str_from_int(nm_get(c.copy_desc, name)))))
    else
        _e = 0
    dr_plain(XCall(strdup(dr_free_fn(k)), args, d"", 0))

# The release of a live local, guarded by its flag when a statement may have moved it.
fn dr_release_stmt(c: DC, name: String) -> TStmt ! alloc
    free = dr_free_stmt(c, name)
    if nm_get(c.soft, name) == 0
        free
    else
        stmts = list_new[TStmt]()
        _a = list_push(stmts, free)
        flag = XIdent("__live_" + name)
        one = XInt(1)
        cond = XBin(d"eq", flag, one)
        else_b = if nm_get(c.kinds, name) == 8
            if nm_get(c.box_shell, name) != 0
                dr_box_shell_else(name)
            else
                dr_empty_block()
        else
            dr_empty_block()
        has_else = if nm_get(c.kinds, name) == 8
            if nm_get(c.box_shell, name) != 0
                1
            else
                0
        else
            0
        dr_plain(XIf(cond, TBlock(stmts, XNone), else_b, has_else, list_new[TElsif]()))

fn dr_box_shell_else(name: String) -> TBlock ! alloc
    stmts = list_new[TStmt]()
    args = list_new[Expr]()
    _a = list_push(args, XIdent(strdup(name)))
    _b = list_push(stmts, dr_plain(XCall(d"struct_free_box", args, d"", 0)))
    TBlock(stmts, XNone)

fn dr_flag_init(name: String) -> TStmt ! alloc
    TStmt(1, "__live_" + name, XInt(1), d"", 1, XNone, 0, 0, 0)

fn dr_flag_clear(name: String) -> TStmt ! alloc
    TStmt(1, "__live_" + name, XInt(0), d"", 0, XNone, 0, 0, 0)

fn dr_in_live(live: List[String], name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(live, i), name) == 1
        1
    else
        dr_in_live(live, name, i + 1, n)

# Clears the flag of every flagged live local the statement `st` moved.
fn dr_clear_moved(c: DC, st: Int, out: List[TStmt]) -> Int ! alloc
    dr_clear_go(c, st, out, 0, list_len(c.site_ids))

fn dr_clear_go(c: DC, st: Int, out: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(c.site_ids, i) != st
        dr_clear_go(c, st, out, i + 1, n)
    else
        name = list_get(c.site_names, i)
        if nm_get(c.soft, name) != 0
            if dr_in_live(c.live, name, 0, list_len(c.live)) == 1
                _p = list_push(out, dr_flag_clear(name))
                dr_clear_go(c, st, out, i + 1, n)
            else
                dr_clear_go(c, st, out, i + 1, n)
        else
            dr_clear_go(c, st, out, i + 1, n)

# Releases live[from..] in reverse order.
fn dr_push_frees(c: DC, out: List[TStmt], from: Int, i: Int) -> Int ! alloc
    if i < from
        0
    else
        _p = list_push(out, dr_release_stmt(c, list_get(c.live, i)))
        dr_push_frees(c, out, from, i - 1)

fn dr_xform_if_arms(c: DC, arms: List[TElsif], i: Int, n: Int, out: List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _p = list_push(out, TElsif(tc_expr(arm.cond), dr_xform_block(c, arm.body)))
        dr_xform_if_arms(c, arms, i + 1, n, out)

fn dr_xform_expr(c: DC, e: Expr) -> Expr ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_xform_if(c, cond, then_b, else_b, has_else, elsifs)
        XWhile(cond, body) => XWhile(tc_expr(cond), dr_xform_block(c, body))
        _ => tc_expr(e)

fn dr_xform_if(c: DC, cond: Expr, then_b: TBlock, else_b: TBlock, has_else: Int, elsifs: List[TElsif]) -> Expr ! alloc
    tb = dr_xform_block(c, then_b)
    arms = list_new[TElsif]()
    _a = dr_xform_if_arms(c, elsifs, 0, list_len(elsifs), arms)
    eb = if has_else == 1
        dr_xform_block(c, else_b)
    else
        dr_empty_block()
    XIf(tc_expr(cond), tc_block(tb), tc_block(eb), has_else, tc_elsifs(arms))

# Returns 1 when a `return` ended the statement list.
fn dr_xform_stmts(c: DC, stmts: List[TStmt], i: Int, n: Int, out: List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        if st.kind == 2
            _r = dr_xform_return(c, st, out)
            1
        else
            _s = dr_xform_stmt(c, st, out)
            dr_xform_stmts(c, stmts, i + 1, n, out)

fn dr_xform_stmt(c: DC, st: TStmt, out: List[TStmt]) -> Int ! alloc
    if st.kind == 1
        dr_xform_bind(c, st, out)
    elsif st.kind == 0
        _d = dr_discard(c, st.expr, out)
        if _d == 0
            _p = list_push(out, dr_plain(dr_xform_expr(c, st.expr)))
            0
        else
            0
        dr_clear_moved(c, st.id, out)
    else
        _p = list_push(out, tc_stmt(st))
        dr_clear_moved(c, st.id, out)

# A fresh value discarded as a statement is bound to a `__dis` temporary and released there
# (the same rule as the bootstrap's `discard_kind`). Returns 1 when it was handled.
fn dr_discard(c: DC, e: Expr, out: List[TStmt]) -> Int ! alloc
    k = dr_discard_kind(c, e)
    if k == 0
        0
    else
        sd = if k == 8
            dx_owned_struct_desc(c, e)
        else
            0
        tmp = dr_next_tmp_p(c, "__dis")
        init = dr_xform_expr(c, e)
        _l = list_push(out, TStmt(1, strdup(tmp), init, d"", 1, XNone, 0, 0, 0))
        _f = list_push(out, dr_discard_free(tmp, k, sd))
        1

fn dr_discard_kind(c: DC, e: Expr) -> Int ! alloc
    er = dx_elem_release(c, e)
    if er != 0
        er
    elsif dx_struct_copy(c, e) != 0
        8
    else
        dr_fresh_kind(c, e)

fn dr_discard_free(name: String, k: Int, sd: Int) -> TStmt ! alloc
    args = list_new[Expr]()
    _a = list_push(args, XIdent(strdup(name)))
    if k == 8
        _d = list_push(args, XStr(strdup(str_from_int(sd))))
    else
        _e = 0
    dr_plain(XCall(strdup(dr_free_fn(k)), args, d"", 0))

fn dr_xform_bind(c: DC, st: TStmt, out: List[TStmt]) -> Int ! alloc
    cand = dr_bind_candidate(c, st)
    init = dr_own_enum_list(c, st.name, cand, st.expr)
    _p = list_push(out, TStmt(st.kind, strdup(st.name), dr_xform_expr(c, init), strdup(st.ty), st.is_let, tc_expr(st.target), st.frozen, st.stack, st.id))
    _m = dr_clear_moved(c, st.id, out)
    if cand != 0
        _k = nm_put(c.kinds, st.name, cand)
        if nm_get(c.soft, st.name) != 0
            _fi = list_push(out, dr_flag_init(st.name))
            _lv = list_push(c.live, strdup(st.name))
            0
        else
            _lv = list_push(c.live, strdup(st.name))
            0
    else
        0

fn dr_bind_candidate(c: DC, st: TStmt) -> Int ! alloc
    if st.is_let == 1
        dr_candidate(c, st.name, st.ty, st.expr)
    elsif dr_is_accumulate(st.name, st.expr) == 0
        dr_candidate(c, st.name, d"", st.expr)
    else
        0

fn dr_xform_return(c: DC, st: TStmt, out: List[TStmt]) -> Int ! alloc
    if list_len(c.live) == 0
        _p = list_push(out, tc_stmt(st))
        0
    else
        rv = dr_return_value(c, st.expr, out)
        _m = dr_clear_moved(c, st.id, out)
        _f = dr_push_frees(c, out, 0, list_len(c.live) - 1)
        _r = list_push(out, TStmt(2, d"", rv, d"", 0, XNone, 0, 0, 0))
        0

# Binds a returned value ahead of the releases; the expression to return.
fn dr_return_value(c: DC, v: Expr, out: List[TStmt]) -> Expr ! alloc
    match v
        XNone => XNone
        _ => dr_return_tmp(c, v, out)

fn dr_return_tmp(c: DC, v: Expr, out: List[TStmt]) -> Expr ! alloc
    tmp = dr_next_tmp(c)
    _l = list_push(out, TStmt(1, strdup(tmp), tc_expr(v), d"", 1, XNone, 0, 0, 0))
    XIdent(tmp)

fn dr_xform_block(c: DC, b: TBlock) -> TBlock ! alloc
    mark = list_len(c.live)
    out = list_new[TStmt]()
    diverged = dr_xform_stmts(c, b.stmts, 0, list_len(b.stmts), out)
    # Statements after a `return` stay as they were.
    if diverged == 1
        _rest = dr_copy_after_return(b.stmts, out, 0, list_len(b.stmts))
        _t = dr_truncate(c, mark)
        TBlock(out, dr_xform_expr(c, b.tail))
    else
        tail = dr_xform_expr(c, b.tail)
        if list_len(c.live) > mark
            t2 = dr_finish_block(c, out, tail, mark)
            _t = dr_truncate(c, mark)
            TBlock(out, t2)
        else
            _t = dr_truncate(c, mark)
            TBlock(out, tail)

# Appends the releases of this block's own locals; returns the new tail.
fn dr_finish_block(c: DC, out: List[TStmt], tail: Expr, mark: Int) -> Expr ! alloc
    last = list_len(c.live) - 1
    if dx_is_none(tail) == 1
        _f = dr_push_frees(c, out, mark, last)
        XNone
    elsif dx_is_while(tail) == 1
        _w = list_push(out, dr_plain(tail))
        _f = dr_push_frees(c, out, mark, last)
        XNone
    else
        tmp = dr_next_tmp(c)
        _l = list_push(out, TStmt(1, strdup(tmp), tail, d"", 1, XNone, 0, 0, 0))
        _f = dr_push_frees(c, out, mark, last)
        XIdent(tmp)

# Copies the statements after the first `return` verbatim.
fn dr_copy_after_return(stmts: List[TStmt], out: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(stmts, i).kind == 2
        dr_copy_rest(stmts, out, i + 1, n)
    else
        dr_copy_after_return(stmts, out, i + 1, n)

fn dr_copy_rest(stmts: List[TStmt], out: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = list_push(out, tc_stmt(list_get(stmts, i)))
        dr_copy_rest(stmts, out, i + 1, n)

fn dr_seed_params(c: DC, params: List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = list_get(params, i).name
        _a = dr_bind(c, nm)
        _b = nm_put(c.params, nm, 1)
        dr_seed_params(c, params, i + 1, n)

# Escape facts of a fn body under the read-only assumptions `ro`.
fn dr_facts(params: List[TParam], body: TBlock, variants: Int, ro: Int, lists: NM) -> DC ! alloc
    c = dr_new(variants, ro, lists)
    _s = dr_seed_params(c, params, 0, list_len(params))
    _w = dr_block(c, body)
    _p = dr_propagate(c)
    c

# Per fn, per parameter: 1 when the fn only reads it. Optimistic fixpoint, as `drops.rs`.
fn dr_read_only_t(tp: TProgram, variants: Int) -> Int ! alloc
    ro = map_new()
    _i = dr_ro_init(ro, tp.fns, 0, list_len(tp.fns))
    _l = dr_ro_loop(ro, tp.fns, variants)
    ro

fn dr_ro_init(ro: Int, fns: List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        flags = vec_new()
        _a = dr_ro_ones(flags, list_len(f.params))
        _b = map_put(ro, str_as_int(strdup(f.name)), flags)
        dr_ro_init(ro, fns, i + 1, n)

fn dr_ro_ones(flags: Int, n: Int) -> Int ! alloc
    if n == 0
        0
    else
        _a = vec_push(flags, 1)
        dr_ro_ones(flags, n - 1)

fn dr_ro_loop(ro: Int, fns: List[TFn], variants: Int) -> Int ! alloc
    if dr_ro_pass(ro, fns, variants, 0, list_len(fns), 0) == 1
        dr_ro_loop(ro, fns, variants)
    else
        0

# One sweep; returns 1 when some parameter lost its read-only flag.
fn dr_ro_pass(ro: Int, fns: List[TFn], variants: Int, i: Int, n: Int, changed: Int) -> Int ! alloc
    if i >= n
        changed
    else
        f = list_get(fns, i)
        c = dr_facts(f.params, f.body, variants, ro, nm_new())
        flags = map_get(ro, str_as_int(f.name))
        ch = dr_ro_params(c, flags, f.params, 0, list_len(f.params))
        _f = dr_free(c)
        any = if ch == 1
            1
        else
            changed
        dr_ro_pass(ro, fns, variants, i + 1, n, any)

fn dr_ro_params(c: DC, flags: Int, params: List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ch = if vec_get(flags, i) == 1
            if dr_escapes(c, list_get(params, i).name) == 1
                _s = vec_set(flags, i, 0)
                1
            else
                0
        else
            0
        rest = dr_ro_params(c, flags, params, i + 1, n)
        if ch == 1
            1
        else
            rest

# ---- temporaries ----
# A fresh string passed to a builtin that only reads it is bound to a local ahead of the
# statement, so the scope-end release frees it. `h` holds the counter.
# The hoisting state: `k` the temporary counter, `lists` the struct of each local list (`dr_lists_of`).
struct HC
    k: List[Int]
    lists: NM
    vm: Int

fn dr_hoist_args(h: HC, args: List[Expr], i: Int, n: Int, reads: Int, out: List[TStmt], res: List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        a = dr_hoist_expr(h, list_get(args, i), out)
        if reads == 1
            if dx_is_fresh_temp_v(h.vm, a) == 1
                k = list_get(h.k, 0) + 1
                _s = list_set(h.k, 0, k)
                name = "__tmp" + int_to_str(k)
                _l = list_push(out, TStmt(1, strdup(name), a, d"", 1, XNone, 0, 0, 0 - k))
                _p = list_push(res, XIdent(strdup(name)))
                dr_hoist_args(h, args, i + 1, n, reads, out, res)
            else
                _p = list_push(res, a)
                dr_hoist_args(h, args, i + 1, n, reads, out, res)
        else
            _p = list_push(res, a)
            dr_hoist_args(h, args, i + 1, n, reads, out, res)

fn dr_hoist_arms(h: HC, arms: List[TElsif], i: Int, n: Int, out: List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _p = list_push(out, TElsif(tc_expr(arm.cond), dr_hoist_block(h, arm.body)))
        dr_hoist_arms(h, arms, i + 1, n, out)

fn dr_hoist_expr(h: HC, e: Expr, out: List[TStmt]) -> Expr ! alloc
    match e
        XCall(name, args, targs, xp) => dr_hoist_call(h, name, args, targs, out)
        XBin(op, l, r) => dr_hoist_bin(h, op, l, r, out)
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_hoist_if(h, cond, then_b, else_b, has_else, elsifs)
        XWhile(cond, body) => XWhile(tc_expr(cond), dr_hoist_block(h, body))
        XMatch(scrut, arms) => dr_hoist_match(h, scrut, arms, out)
        XField(base, field) => dr_hoist_field(h, base, field, out)
        _ => tc_expr(e)

# `match list_get(xs, i) { … }`: the element read is bound to a local first (`Hoist` in src/drops.rs).
fn dr_hoist_match(h: HC, scrut: Expr, arms: List[TArm], out: List[TStmt]) -> Expr ! alloc
    ns = dr_hoist_expr(h, scrut, out)
    s2 = if dr_is_elem_read(ns) == 1
        k = list_get(h.k, 0) + 1
        _s = list_set(h.k, 0, k)
        name = "__tmp" + int_to_str(k)
        _l = list_push(out, TStmt(1, strdup(name), ns, d"", 1, XNone, 0, 0, 0 - k))
        XIdent(strdup(name))
    else
        tc_expr(ns)
    XMatch(s2, tc_arms(arms))

# `list_get(xs, i).f` of a list whose element struct a copy can release: the copy is bound to a
# temporary ahead of the statement (`Hoist` in src/drops.rs).
fn dr_hoist_field(h: HC, base: Expr, field: String, out: List[TStmt]) -> Expr ! alloc
    nb = dr_hoist_expr(h, base, out)
    if dr_elem_list_known(h, nb) == 0
        XField(nb, strdup(field))
    else
        k = list_get(h.k, 0) + 1
        _s = list_set(h.k, 0, k)
        name = "__tmp" + int_to_str(k)
        _l = list_push(out, TStmt(1, strdup(name), nb, d"", 1, XNone, 0, 0, 0 - k))
        XField(XIdent(strdup(name)), strdup(field))

fn dr_elem_list_known(h: HC, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dr_elem_list_call(h, name, args)
        _ => 0

fn dr_elem_list_call(h: HC, name: String, args: List[Expr]) -> Int ! alloc
    if dr_is_elem_read(XCall(name, args, d"", 0)) == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(first) == 0
            0
        elsif nm_get(h.lists, dx_ident(first)) == 0
            0
        else
            1

# The struct of each local list of a fn: its parameters `List[S]` and its `xs = list_new[S]()`
# (`list_elem_structs` in src/drops.rs). Maps the local's name to the struct's name.
fn dr_lists_of(params: List[TParam], body: TBlock, variants: Int) -> NM ! alloc
    m = nm_new()
    _a = dr_lists_params(m, params, 0, list_len(params), variants)
    _b = dr_lists_stmts(m, body.stmts, 0, list_len(body.stmts), variants)
    m

fn dr_lists_params(m: NM, params: List[TParam], i: Int, n: Int, variants: Int) -> Int ! alloc
    if i >= n
        0
    else
        p = list_get(params, i)
        s = dr_list_elem(p.ty, variants)
        _x = if str_len(s) == 0
            0
        else
            nm_put(m, p.name, str_as_int(s))
        dr_lists_params(m, params, i + 1, n, variants)

# The element struct of the list type text `List[S]` ("" when not a list of an ownable struct).
fn dr_list_elem(ty: String, variants: Int) -> String ! alloc
    t = trim_type_piece(ty)
    if str_eq(ty_base(t), "List") == 0
        d""
    else
        dr_struct_of(dr_ty_arg0(t), variants)

# The first type argument of a type text (`S` of `List[S]`), "" when there is none.
fn dr_ty_arg0(t: String) -> String ! alloc
    h = nth_type_arg(t, 0)
    if h == 0
        d""
    else
        str_from_int(h)

# The struct `t` when a copy of it can be released ("" otherwise).
fn dr_struct_of(txt: String, variants: Int) -> String ! alloc
    t = trim_type_piece(txt)
    if map_get(variants, str_as_int("desc:" + t)) == 0
        d""
    else
        t

fn dr_lists_stmts(m: NM, stmts: List[TStmt], i: Int, n: Int, variants: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        _a = dr_lists_stmt(m, st, variants)
        dr_lists_stmts(m, stmts, i + 1, n, variants)

fn dr_lists_stmt(m: NM, st: TStmt, variants: Int) -> Int ! alloc
    if st.kind == 1
        dr_lists_bind(m, st.name, st.expr, variants)
    elsif st.kind == 0
        dr_lists_expr(m, st.expr, variants)
    else
        0

fn dr_lists_bind(m: NM, name: String, e: Expr, variants: Int) -> Int ! alloc
    match e
        XCall(fname, args, targs, xp) => dr_lists_new(m, name, fname, targs, variants)
        _ => 0

fn dr_lists_new(m: NM, name: String, fname: String, targs: String, variants: Int) -> Int ! alloc
    if str_eq(fname, "list_new") == 0
        0
    else
        s = dr_struct_of(targs, variants)
        if str_len(s) == 0
            0
        else
            nm_put(m, name, str_as_int(s))

# A `while` body is scanned too (as `Stmt::While` is in src/drops.rs).
fn dr_lists_expr(m: NM, e: Expr, variants: Int) -> Int ! alloc
    match e
        XWhile(cond, body) => dr_lists_block(m, body, variants)
        _ => 0

fn dr_lists_block(m: NM, b: TBlock, variants: Int) -> Int ! alloc
    dr_lists_stmts(m, b.stmts, 0, list_len(b.stmts), variants)

fn dr_is_elem_read(e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => str_eq(name, "list_get") + str_eq(name, "list_pop")
        _ => 0

fn dr_hoist_call(h: HC, name: String, args: List[Expr], targs: String, out: List[TStmt]) -> Expr ! alloc
    res = list_new[Expr]()
    _a = dr_hoist_args(h, args, 0, list_len(args), dr_reads_string_arg(name), out, res)
    XCall(strdup(name), res, strdup(targs), 0)

fn dr_hoist_bin(h: HC, op: String, l: Expr, r: Expr, out: List[TStmt]) -> Expr ! alloc
    nl = dr_hoist_expr(h, l, out)
    nr = dr_hoist_expr(h, r, out)
    XBin(strdup(op), nl, nr)

fn dr_hoist_if(h: HC, cond: Expr, then_b: TBlock, else_b: TBlock, has_else: Int, elsifs: List[TElsif]) -> Expr ! alloc
    tb = dr_hoist_block(h, then_b)
    eb = if has_else == 1
        dr_hoist_block(h, else_b)
    else
        dr_empty_block()
    arms = list_new[TElsif]()
    _a = dr_hoist_arms(h, elsifs, 0, list_len(elsifs), arms)
    XIf(tc_expr(cond), tc_block(tb), tc_block(eb), has_else, tc_elsifs(arms))

fn dr_hoist_stmts(h: HC, stmts: List[TStmt], i: Int, n: Int, out: List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        ne = dr_hoist_expr(h, st.expr, out)
        _p = list_push(out, TStmt(st.kind, strdup(st.name), ne, strdup(st.ty), st.is_let, tc_expr(st.target), st.frozen, st.stack, st.id))
        dr_hoist_stmts(h, stmts, i + 1, n, out)

fn dr_hoist_block(h: HC, b: TBlock) -> TBlock ! alloc
    out = list_new[TStmt]()
    _a = dr_hoist_stmts(h, b.stmts, 0, list_len(b.stmts), out)
    tail = dr_hoist_expr(h, b.tail, out)
    TBlock(out, tail)

# `view` 1 → `tv_block` for IR/lowering (strings outlive the fn); 0 → owned `tc_block` for emit C.
fn drops_body_go(f: TFn, denv: Int, view: Int) -> TBlock ! alloc
    body = tc_block(f.body)
    h = HC(list_new[Int](), dr_lists_of(f.params, body, vec_get(denv, 0)), vec_get(denv, 0))
    _h = list_push(h.k, 0)
    hoisted = dr_hoist_block(h, body)
    c = dr_facts(f.params, hoisted, vec_get(denv, 0), vec_get(denv, 2), h.lists)
    res = dr_xform_block(c, hoisted)
    _a = dr_free(c)
    _g = list_free(h.k)
    if view == 1
        tv_block(res)
    else
        owned = tc_block(res)
        _w = tp_free_drop_work(body, hoisted, res)
        owned

# View copy for `fuse.sal` / IR (`tv_block`); `body`/`hoisted`/`res` from the pass are left allocated.
fn drops_body_t(f: TFn, denv: Int) -> TBlock ! alloc
    drops_body_go(f, denv, 1)

# Owned copy for `emit.sal` AST→C; work buffers are released before return.
fn drops_body_tc(f: TFn, denv: Int) -> TBlock ! alloc
    drops_body_go(f, denv, 0)

# ---- legacy handle helpers (callers in fuse.sal and emit.sal) ----
# Builtins whose String arguments are only read.
fn dr_borrows(name: String) -> Int ! alloc
    if str_eq(name, "str_len") == 1
        1
    elsif str_eq(name, "dict_keys") + str_eq(name, "dict_values") + str_eq(name, "dict_len") + str_eq(name, "dict_remove") == 1
        1
    elsif str_eq(name, "str_eq") == 1
        1
