# Handle→typed bridge: `region_new` and `estimate_peak` still build a region as a handle;
# `ti_region` turns it into the `Region` that `Cx.regions` keeps.
import "../ir/ir.sal"
import tast

fn ti_s(h: Int) -> String ! alloc
    tt_str(h).dup()

fn ti_slot_s(v: Int, i: Int) -> String ! alloc
    ti_s(tt_slot(v, i))

# ---- regions ----
fn ti_ops(hs: Int, i: Int, n: Int, out: &mut List[FOp]) -> Int ! alloc
    if i >= n
        0
    else
        o = vec_get(hs, i)
        out.push(FOp(vec_get(o, 0), ti_slot_s(o, 1), ti_slot_s(o, 2), ti_slot_s(o, 3), ti_slot_s(o, 4), ti_slot_s(o, 5), vec_len(o)))
        ti_ops(hs, i + 1, n, out)

# `[place, ops, fused, has_peak, has_sym, peak, peak_sym]` → `Region`. The texts are copies.
fn ti_region(r: Int) -> Region ! alloc
    ops = List.new[FOp]()
    ti_ops(vec_get(r, 1), 0, vec_len(vec_get(r, 1)), &mut ops)
    Region(ti_slot_s(r, 0), vec_get(r, 2), vec_get(r, 3), vec_get(r, 4), vec_get(r, 5), ti_slot_s(r, 6), ops)

# ---- handle text helpers ----
# Slot `i` of a handle, 0 when the vec is shorter.
fn tt_slot(h: Int, i: Int) -> Int ! alloc
    if i < vec_len(h)
        vec_get(h, i)
    else
        0

fn tt_str(h: Int) -> String ! alloc
    if h == 0
        ""
    else
        str_from_int(h)
