# Textual tensor types: `Tensor[F32, 2, 3] on cpu`.
fn ty_trim_go(s: String) -> String ! alloc
    n = s.len()
    if n > 0
        if s.char(n - 1) == 32
            ty_trim_go(s.slice(0, n - 1))
        else
            s
    else
        s

# ---- tensor shapes ----
# `Tensor[F32, 2, 3] on cpu` -> parts ["F32", "2", "3"] (see `ts_split`).
fn tt_open(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        n
    elsif s.char(i) == 91
        i + 1
    else
        tt_open(s, i + 1, n)

fn tt_trim_left(s: String) -> String ! alloc
    if s.len() > 0 && s.char(0) == 32
        tt_trim_left(s.slice(1, s.len()))
    else
        s

fn tt_place_go(s: &String, i: Int, n: Int) -> String ! alloc
    if i < 0
        "cpu"
    elsif s.char(i) == 32
        s.slice(i + 1, n)
    elsif s.char(i) == 93
        "cpu"
    else
        tt_place_go(s, i - 1, n)

fn tt_dim_go(s: &String, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        tt_dim_go(s, i + 1, n, acc * 10 + s.char(i) - 48)

# ---- typed forms: type texts as `String`, shape parts as `List[String]` ----
# "" stands for an absent type and trims to "Unknown".
fn ts_trim(s: &String) -> String ! alloc
    if s.len() == 0
        "Unknown"
    else
        ty_trim_go(s.dup())

fn ts_parts(s: &String, i: Int, n: Int, from: Int, depth: Int, out: &List[String]) -> Int ! alloc
    if i >= n
        0
    else
        ch = s.char(i)
        if ch == 91
            ts_parts(s, i + 1, n, from, depth + 1, out)
        elsif ch == 93
            if depth == 0
                _p = out.push(ty_trim_go(tt_trim_left(s.slice(from, i))).dup())
                0
            else
                ts_parts(s, i + 1, n, from, depth - 1, out)
        elsif ch == 44
            if depth == 0
                _p = out.push(ty_trim_go(tt_trim_left(s.slice(from, i))).dup())
                ts_parts(s, i + 1, n, i + 1, depth, out)
            else
                ts_parts(s, i + 1, n, from, depth, out)
        else
            ts_parts(s, i + 1, n, from, depth, out)

# `Tensor[F32, 2, 3] on cpu` -> ["F32", "2", "3"].
fn ts_split(t: &String) -> List[String] ! alloc
    s = ts_trim(t)
    o = tt_open(&s, 0, s.len())
    out = List.new[String]()
    ts_parts(&s, o, s.len(), o, 0, &out)
    out

fn ts_place(t: &String) -> String ! alloc
    s = ts_trim(t)
    tt_place_go(&s, s.len() - 1, s.len())

fn ts_static(d: &String) -> Int ! alloc
    if d.len() == 0
        0
    elsif d.char(0) >= 48
        if d.char(0) <= 57
            1
        else
            0
    else
        0

fn ts_dim(d: &String) -> Int ! alloc
    tt_dim_go(d, 0, d.len(), 0)

fn ts_join(parts: &List[String], lo: Int, hi: Int, acc: String) -> String ! alloc
    if lo >= hi
        acc
    else
        ts_join(parts, lo + 1, hi, (acc + ", " + parts.get(lo)))

# Text `Tensor[F32, M, N] on cpu` of the `a @ b` result, or "" when a shape has no rank-2 literal form.
fn ts_matmul_text(ta: &String, tb: &String) -> String ! alloc
    pa = ts_split(ta)
    pb = ts_split(tb)
    if pa.len() < 3
        ""
    elsif pb.len() < 3
        ""
    else
        head = "Tensor[" + pa.get(0)
        mid = ts_join(&pa, 1, pa.len() - 1, head)
        mid + ", " + pb.get(pb.len() - 1) + "] on " + ts_place(ta)
