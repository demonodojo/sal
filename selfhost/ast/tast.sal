import thash

# Typed AST: what `parser.sal` builds and every pass reads, with `match` and struct fields.
# `tp_free*` returns the boxes and lists of a tree; its strings stay.
#
# `TFn.mkind`: 0 plain `fn`, 1 `method`, 2 `static`, 3 `init`; `recv` is the receiver type ("" for `fn`)
# and `name` the mangled `Recv__name` (`Recv__new` for an `init`).
# `XNone` stands for an absent expression (handle 0): a missing block tail, `else` or `let` type.

struct TParam
    name: String
    ty: String
    mode: Int

struct TField
    name: String
    ty: String

struct TProtocolMethod
    name: String
    params: List[TParam]
    ret: String
    fx: List[Int]
    self_mode: Int

struct TProtocol
    name: String
    methods: List[TProtocolMethod]

struct TStruct
    name: String
    fields: List[TField]
    layout_c: Int
    tparams: List[String]
    is_frame: Int
    protocols: List[String]
    # `@deprecated("…")` message; "" when the item has none.
    deprecated: String
    # Byte offsets of the identifiers of its field types, in order (see `TFn.tyat`).
    tyat: String
    # Lifetime parameters (`struct V['a]`), apart from `tparams`: a lifetime is not a type.
    lifetimes: List[String]

struct TVariant
    name: String
    fields: List[String]

struct TEnum
    name: String
    variants: List[TVariant]
    tparams: List[String]
    protocols: List[String]
    deprecated: String
    # Byte offsets of the identifiers of its variant field types, in order (see `TFn.tyat`).
    tyat: String

# A pattern: kind 0 `_`, 1 binding `name`, 2 integer `ival`, 3 variant, 4 string `"…"`, 5 regex `r"…"` (text in `name`).
struct TPat
    kind: Int
    ival: Int
    name: String
    qual: String
    args: List[TPat]

struct TArm
    pat: TPat
    body: Expr
    suite: TBlock
    has_suite: Int

# Match arm value: indented block tail or single expression.
fn tarm_value(arm: &TArm) -> Expr ! alloc
    if arm.has_suite == 1
        arm.suite.tail.clone()
    else
        arm.body.clone()

fn tarm_block(arm: &TArm) -> TBlock ! alloc
    if arm.has_suite == 1
        arm.suite.clone()
    else
        TBlock(List.new[TStmt](), arm.body.clone())

struct TElsif
    cond: Expr
    body: TBlock

struct TBlock
    stmts: List[TStmt]
    tail: Expr

# `kind` 0 expression, 1 binding or assignment (`is_let` tells them apart), 2 `return`, 3 field assignment.
# `id` names the statement across a pass (the handle it came from, 0 for one a pass creates).
struct TStmt
    kind: Int
    name: String
    expr: Expr
    ty: String
    is_let: Int
    target: Expr
    frozen: Int
    stack: Int
    id: Int

enum Expr
    XNone
    XInt(Int)
    XFloat(Int, String)
    XStr(String)
    XIdent(String)
    XBin(String, Expr, Expr)
    # The last field is the byte offset of the callee's name in the preprocessed source (0 when none).
    XCall(String, List[Expr], String, Int)
    XTo(String, Expr)
    XOn(String, TBlock, Int, Int)
    XTensor(Int, Int, List[String])
    XIf(Expr, TBlock, TBlock, Int, List[TElsif])
    XWhile(Expr, TBlock)
    XField(Expr, String)
    XBool(Int)
    XLambda(String, Expr)
    XUnary(String, Expr)
    XMatch(Expr, List[TArm])
    XTry(Expr)

struct TFn
    name: String
    params: List[TParam]
    body: TBlock
    ret: String
    no_heap: Int
    arena: Int
    fx: List[Int]
    tparams: List[String]
    recv: String
    mkind: Int
    deprecated: String
    # Byte offsets of the identifiers written in its types, comma-separated, in the order the parser
    # read them: the parameters (`self` first), the result, then the body. Qualifiers are not listed.
    tyat: String

struct TConst
    name: String
    ty: String
    expr: Expr
    deprecated: String

struct TProgram
    fns: List[TFn]
    imports: List[String]
    structs: List[TStruct]
    aliases: List[String]
    enums: List[TEnum]
    protocols: List[TProtocol]
    consts: List[TConst]

# ---- release ----
# The tree is owned by its holder: its glue releases it (SPEC «Liberación de locales»). A manual
# release here would free nodes that the holder still releases again.
fn tp_free_block(b: &TBlock) -> Int ! alloc
    0

fn tp_free_expr_list(xs: &List[Expr]) -> Int ! alloc
    0

fn tp_lseen_take(id: Int, lseen: &mut HT) -> Int ! alloc
    if id == 0
        0
    else
        key = id.to_str()
        if lseen.get(&key).len() > 0
            1
        else
            lseen.put(&key, &"1")
            0

# Empty shells for `list_set` before `list_free` on owned list elements (expr/stmt/pat already released).
fn tp_empty_block() -> TBlock ! alloc
    TBlock(List.new[TStmt](), XNone)

fn tp_pat_cleared() -> TPat ! alloc
    TPat(0, 0, "", "", List.new[TPat]())

# Takes a block so the caller's drop does not free it. The strings stay with the caller.
fn tp_keep_block(b: &TBlock) -> Int ! alloc
    tp_keep_expr(&b.tail)
    tp_keep_stmts(&b.stmts)
    0

fn tp_keep_expr(e: &Expr) -> Int ! alloc
    0

fn tp_keep_stmts(xs: &List[TStmt]) -> Int ! alloc
    0

# ---- deep copies ----
# A copy shares nothing with the original, so either can be released alone.
fn tc_exprs(xs: &List[Expr], i: Int, n: Int, out: &mut List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(tc_expr(&xs.get(i)))
        tc_exprs(xs, i + 1, n, out)

fn tc_list(xs: &List[Expr]) -> List[Expr] ! alloc
    out = List.new[Expr]()
    tc_exprs(xs, 0, xs.len(), &mut out)
    out

fn tc_strs(xs: &List[String]) -> List[String] ! alloc
    out = List.new[String]()
    tc_strs_go(xs, 0, xs.len(), &mut out)
    out

fn tc_strs_go(xs: &List[String], i: Int, n: Int, out: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(xs.get(i).dup())
        tc_strs_go(xs, i + 1, n, out)

fn tc_expr(e: &Expr) -> Expr ! alloc
    match e
        XNone => XNone
        XInt(v) => XInt(v)
        XFloat(bits, txt) => XFloat(bits, txt.dup())
        XStr(s) => XStr(s.dup())
        XIdent(s) => XIdent(s.dup())
        XBin(op, l, r) => XBin(op.dup(), tc_expr(&l), tc_expr(&r))
        XCall(name, args, targs, xp) => XCall(name.dup(), tc_list(&args), targs.dup(), xp)
        XTo(place, inner) => XTo(place.dup(), tc_expr(&inner))
        XOn(place, body, kern, idx) => XOn(place.dup(), tc_block(&body), kern, idx)
        XTensor(nr, nc, data) => XTensor(nr, nc, tc_strs(&data))
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(tc_expr(&cond), tc_block(&then_b), tc_block(&else_b), has_else, tc_elsifs(&elsifs))
        XWhile(cond, body) => XWhile(tc_expr(&cond), tc_block(&body))
        XField(base, field) => XField(tc_expr(&base), field.dup())
        XBool(v) => XBool(v)
        XLambda(param, body) => XLambda(param.dup(), tc_expr(&body))
        XUnary(op, inner) => XUnary(op.dup(), tc_expr(&inner))
        XMatch(scrut, arms) => XMatch(tc_expr(&scrut), tc_arms(&arms))
        XTry(inner) => XTry(tc_expr(&inner))

fn tc_elsifs(xs: &List[TElsif]) -> List[TElsif] ! alloc
    out = List.new[TElsif]()
    tc_elsifs_go(xs, 0, xs.len(), &mut out)
    out

fn tc_elsifs_go(xs: &List[TElsif], i: Int, n: Int, out: &mut List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        _a = out.push(TElsif(tc_expr(&a.cond), tc_block(&a.body)))
        tc_elsifs_go(xs, i + 1, n, out)

fn tc_arms(xs: &List[TArm]) -> List[TArm] ! alloc
    out = List.new[TArm]()
    tc_arms_go(xs, 0, xs.len(), &mut out)
    out

fn tc_arms_go(xs: &List[TArm], i: Int, n: Int, out: &mut List[TArm]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        _a = out.push(TArm(tc_pat(&a.pat), tc_expr(&a.body), tc_block(&a.suite), a.has_suite))
        tc_arms_go(xs, i + 1, n, out)

fn tc_pats(xs: &List[TPat]) -> List[TPat] ! alloc
    out = List.new[TPat]()
    tc_pats_go(xs, 0, xs.len(), &mut out)
    out

fn tc_pats_go(xs: &List[TPat], i: Int, n: Int, out: &mut List[TPat]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(tc_pat(&xs.get(i)))
        tc_pats_go(xs, i + 1, n, out)

fn tc_pat(p: &TPat) -> TPat ! alloc
    TPat(p.kind, p.ival, p.name.dup(), p.qual.dup(), tc_pats(&p.args))

fn tc_stmt(s: &TStmt) -> TStmt ! alloc
    TStmt(s.kind, s.name.dup(), tc_expr(&s.expr), s.ty.dup(), s.is_let, tc_expr(&s.target), s.frozen, s.stack, s.id)

fn tc_stmts(xs: &List[TStmt], i: Int, n: Int, out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(tc_stmt(&xs.get(i)))
        tc_stmts(xs, i + 1, n, out)

fn tc_block(b: &TBlock) -> TBlock ! alloc
    out = List.new[TStmt]()
    tc_stmts(&b.stmts, 0, b.stmts.len(), &mut out)
    TBlock(out, tc_expr(&b.tail))

# ---- view copies ----
# Like `tc_*`, but each string is a fresh handle via `strdup` then `str_from_int(str_as_int(…))`
# (not marked owned by the enum box), so `tp_free_block` on the view does not break IR text.
fn tv_s(s: &String) -> String ! alloc
    str_from_int(s.dup().to_int())

fn tv_exprs(xs: &List[Expr], i: Int, n: Int, out: &mut List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(tv_expr(&xs.get(i)))
        tv_exprs(xs, i + 1, n, out)

fn tv_list(xs: &List[Expr]) -> List[Expr] ! alloc
    out = List.new[Expr]()
    tv_exprs(xs, 0, xs.len(), &mut out)
    out

fn tv_expr(e: &Expr) -> Expr ! alloc
    match e
        XNone => XNone
        XInt(v) => XInt(v)
        XFloat(bits, txt) => XFloat(bits, tv_s(&txt))
        XStr(s) => XStr(tv_s(&s))
        XIdent(s) => XIdent(tv_s(&s))
        XBin(op, l, r) => XBin(tv_s(&op), tv_expr(&l), tv_expr(&r))
        XCall(name, args, targs, xp) => XCall(tv_s(&name), tv_list(&args), tv_s(&targs), xp)
        XTo(place, inner) => XTo(tv_s(&place), tv_expr(&inner))
        XOn(place, body, kern, idx) => XOn(tv_s(&place), tv_block(&body), kern, idx)
        XTensor(nr, nc, data) => XTensor(nr, nc, tc_strs(&data))
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(tv_expr(&cond), tv_block(&then_b), tv_block(&else_b), has_else, tv_elsifs(&elsifs))
        XWhile(cond, body) => XWhile(tv_expr(&cond), tv_block(&body))
        XField(base, field) => XField(tv_expr(&base), tv_s(&field))
        XBool(v) => XBool(v)
        XLambda(param, body) => XLambda(tv_s(&param), tv_expr(&body))
        XUnary(op, inner) => XUnary(tv_s(&op), tv_expr(&inner))
        XMatch(scrut, arms) => XMatch(tv_expr(&scrut), tv_arms(&arms))
        XTry(inner) => XTry(tv_expr(&inner))

fn tv_elsifs(xs: &List[TElsif]) -> List[TElsif] ! alloc
    out = List.new[TElsif]()
    tv_elsifs_go(xs, 0, xs.len(), &mut out)
    out

fn tv_elsifs_go(xs: &List[TElsif], i: Int, n: Int, out: &mut List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        _a = out.push(TElsif(tv_expr(&a.cond), tv_block(&a.body)))
        tv_elsifs_go(xs, i + 1, n, out)

fn tv_arms(xs: &List[TArm]) -> List[TArm] ! alloc
    out = List.new[TArm]()
    tv_arms_go(xs, 0, xs.len(), &mut out)
    out

fn tv_arms_go(xs: &List[TArm], i: Int, n: Int, out: &mut List[TArm]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        _a = out.push(TArm(tv_pat(&a.pat), tv_expr(&a.body), tv_block(&a.suite), a.has_suite))
        tv_arms_go(xs, i + 1, n, out)

fn tv_pats(xs: &List[TPat]) -> List[TPat] ! alloc
    out = List.new[TPat]()
    tv_pats_go(xs, 0, xs.len(), &mut out)
    out

fn tv_pats_go(xs: &List[TPat], i: Int, n: Int, out: &mut List[TPat]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(tv_pat(&xs.get(i)))
        tv_pats_go(xs, i + 1, n, out)

fn tv_pat(p: &TPat) -> TPat ! alloc
    TPat(p.kind, p.ival, tv_s(&p.name), tv_s(&p.qual), tv_pats(&p.args))

fn tv_stmt(s: &TStmt) -> TStmt ! alloc
    TStmt(s.kind, tv_s(&s.name), tv_expr(&s.expr), tv_s(&s.ty), s.is_let, tv_expr(&s.target), s.frozen, s.stack, s.id)

fn tv_stmts(xs: &List[TStmt], i: Int, n: Int, out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(tv_stmt(&xs.get(i)))
        tv_stmts(xs, i + 1, n, out)

fn tv_block(b: &TBlock) -> TBlock ! alloc
    out = List.new[TStmt]()
    tv_stmts(&b.stmts, 0, b.stmts.len(), &mut out)
    TBlock(out, tv_expr(&b.tail))
