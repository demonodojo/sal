# Local String/Float typer over the typed AST (`tast.sal`): the mirror of the handle typer in
# `ast.sal` (`expr_type`, `strenv_*`). A type is its text; "" means unknown. The environment
# keeps its own copies of every name and type, so freeing it never touches the AST.
import tast
import tytext
import tshape

struct TEnv
    names: List[String]
    tys: List[String]
    structs: List[TStruct]
    fn_names: List[String]
    fn_rets: List[String]
    g_names: List[String]
    g_idx: List[Int]

# ---- type text helpers ----
fn tt_is_string(ty0: &String) -> Int ! alloc
    ty = ty_deref(ty0)
    if ty.eq("String") == 1
        1
    else
        ty.eq("String ")

fn tt_is_float(ty: &String) -> Int ! alloc
    ty_deref(ty).eq("Float")

# `ty` names `name`; the parser leaves one trailing space after an identifier ("Path ").
fn tt_matches(ty: &String, name: &String) -> Int ! alloc
    if ty.len() == 0
        0
    else
        nl = name.len()
        tl = ty.len()
        if tl == nl
            ty.eq(name)
        elsif tl == nl + 1
            if ty.char(nl) == 32
                tt_chars_eq(ty, name, 0, nl)
            else
                0
        else
            0

fn tt_chars_eq(a: &String, b: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    elsif a.char(i) != b.char(i)
        0
    else
        tt_chars_eq(a, b, i + 1, n)

# `i`-th top-level type argument of `Name[A, B]`, "" when absent.
fn tt_arg(t: &String, i: Int) -> String ! alloc
    h = nth_type_arg(t, i)
    if h == 0
        ""
    else
        str_from_int(h)

# `T` of a `List[T]` type text, "" otherwise.
fn tt_list_elem(t0: &String) -> String ! alloc
    t = ty_deref(t0)
    if t.len() == 0
        ""
    else
        open = ty_find_open(&t, 0)
        if open < 0
            ""
        elsif trim_spaces(t.slice(0, open)).eq("List") == 1
            tt_arg(&t, 0)
        else
            ""

# ---- struct copies ----
# An owned copy of a struct definition (SPEC «Memoria»: an explicit `clone`). A table that owns
# structs owns its own copies: sharing the definitions of another program would let its glue
# release them while that program still uses them.
fn tstruct_copy(s: &TStruct) -> TStruct ! alloc
    TStruct(s.name.dup(), tfields_copy(&s.fields, 0, s.fields.len(), List.new[TField]()), s.layout_c, strs_copy(&s.tparams), s.is_frame, strs_copy(&s.protocols), s.deprecated.dup(), s.tyat.dup(), strs_copy(&s.lifetimes))

fn tstructs_copy(xs: &List[TStruct]) -> List[TStruct] ! alloc
    tstructs_copy_go(xs, 0, xs.len(), List.new[TStruct]())

fn tstructs_copy_go(xs: &List[TStruct], i: Int, n: Int, out: List[TStruct]) -> List[TStruct] ! alloc
    if i >= n
        out
    else
        _a = out.push(tstruct_copy(&xs.get(i)))
        tstructs_copy_go(xs, i + 1, n, out)

fn tfields_copy(xs: &List[TField], i: Int, n: Int, out: List[TField]) -> List[TField] ! alloc
    if i >= n
        out
    else
        f = xs.get(i)
        _a = out.push(TField(f.name.dup(), f.ty.dup()))
        tfields_copy(xs, i + 1, n, out)

fn strs_copy(xs: &List[String]) -> List[String] ! alloc
    out = List.new[String]()
    _a = list_clone_str(xs, 0, xs.len(), &mut out)
    out

# ---- environment ----
fn tenv_new(tp: &TProgram) -> TEnv ! alloc
    env = TEnv(List.new[String](), List.new[String](), tstructs_copy(&tp.structs), List.new[String](), List.new[String](), List.new[String](), List.new[Int]())
    tenv_fill(&mut env, &tp.fns, 0, tp.fns.len())
    env

# Empty environment for detaching a shared `TEnv` before a owning struct (e.g. `Cx`) goes out of scope.
fn tenv_empty() -> TEnv ! alloc
    TEnv(List.new[String](), List.new[String](), List.new[TStruct](), List.new[String](), List.new[String](), List.new[String](), List.new[Int]())

fn list_clone_str(xs: &List[String], i: Int, n: Int, out: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(xs.get(i).dup())
        list_clone_str(xs, i + 1, n, out)

fn list_clone_int(xs: &List[Int], i: Int, n: Int, out: &mut List[Int]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(xs.get(i))
        list_clone_int(xs, i + 1, n, out)

# Per-function copy of a module or graph environment (fn result types and struct list are shared).
fn tenv_clone(src: &TEnv) -> TEnv ! alloc
    names = List.new[String]()
    list_clone_str(&src.names, 0, src.names.len(), &mut names)
    tys = List.new[String]()
    list_clone_str(&src.tys, 0, src.tys.len(), &mut tys)
    fn_names = List.new[String]()
    list_clone_str(&src.fn_names, 0, src.fn_names.len(), &mut fn_names)
    fn_rets = List.new[String]()
    list_clone_str(&src.fn_rets, 0, src.fn_rets.len(), &mut fn_rets)
    g_names = List.new[String]()
    list_clone_str(&src.g_names, 0, src.g_names.len(), &mut g_names)
    g_idx = List.new[Int]()
    list_clone_int(&src.g_idx, 0, src.g_idx.len(), &mut g_idx)
    TEnv(names, tys, tstructs_copy(&src.structs), fn_names, fn_rets, g_names, g_idx)

# Index of the first param whose type is the bare type parameter `f` returns, or -1.
fn tt_generic_ret(f: &TFn) -> Int ! alloc
    if f.ret.len() == 0
        0 - 1
    elsif f.tparams.len() == 0
        0 - 1
    elsif tt_in_names(&f.ret, &f.tparams, 0, f.tparams.len()) == 0
        0 - 1
    else
        tt_generic_param(&f.params, &f.ret, 0, f.params.len())

fn tt_in_names(ty: &String, names: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif tt_matches(ty, &names.get(i)) == 1
        1
    else
        tt_in_names(ty, names, i + 1, n)

fn tt_generic_param(params: &List[TParam], ret: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif tt_matches(&params.get(i).ty, ret) == 1
        i
    else
        tt_generic_param(params, ret, i + 1, n)

fn tenv_fill(env: &mut TEnv, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = fns.get(i)
        gi = tt_generic_ret(&f)
        if gi >= 0
            tenv_put_generic(env, &f.name, gi + 1)
            _p = tenv_put_ret(env, &f.name, &"Unknown")
        elsif f.ret.len() != 0
            _p = tenv_put_ret(env, &f.name, &f.ret)
        else
            _p = 0
        tenv_fill(env, fns, i + 1, n)

fn tenv_put_ret(env: &mut TEnv, name: &String, ret: &String) -> Int ! alloc
    env.fn_names.push(name.dup())
    _b = env.fn_rets.push(ret.dup())
    0

fn tenv_put_generic(env: &mut TEnv, name: &String, idx: Int) -> Int ! alloc
    env.g_names.push(name.dup())
    _b = env.g_idx.push(idx)
    0

# Position of `name` in `names`, or -1; the first definition wins.
fn tt_index_of(names: &List[String], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif names.get(i).eq(name) == 1
        i
    else
        tt_index_of(names, name, i + 1, n)

# No-op: `drop.TEnv` already frees the lists when the owned env ends. Manual
# `list_free` here plus that glue is a double free (and must not `free_box` a borrow).
fn tenv_free(env: &TEnv) -> Int
    0

fn tenv_len(env: &TEnv) -> Int ! alloc
    env.names.len()

fn tenv_bind(env: &mut TEnv, name: &String, ty: &String) -> Int ! alloc
    env.names.push(name.dup())
    _b = env.tys.push(ty.dup())
    0

# Drops the bindings made since the environment had `mark` of them.
fn tenv_truncate(env: &mut TEnv, mark: Int) -> Int ! alloc
    if env.names.len() > mark
        env.names.pop()
        env.tys.pop()
        tenv_truncate(env, mark)
    else
        0

fn tenv_type_go(env: &TEnv, name: &String, i: Int) -> String ! alloc
    if i < 0
        ""
    elsif env.names.get(i).eq(name) == 1
        env.tys.get(i).clone()
    else
        tenv_type_go(env, name, i - 1)

fn tenv_type(env: &TEnv, name: &String) -> String ! alloc
    tenv_type_go(env, name, env.names.len() - 1)

# ---- structs ----
fn tt_struct_find_go(structs: &List[TStruct], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif tt_matches(name, &structs.get(i).name) == 1
        i
    else
        tt_struct_find_go(structs, name, i + 1, n)

# Index of the struct `name` spells, or -1.
fn tt_struct_find(structs: &List[TStruct], name: &String) -> Int ! alloc
    tt_struct_find_go(structs, name, 0, structs.len())

fn tt_field_type_go(fields: &List[TField], field: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    elsif fields.get(i).name.eq(field) == 1
        fields.get(i).ty.clone()
    else
        tt_field_type_go(fields, field, i + 1, n)

fn tt_field_type(structs: &List[TStruct], sname: &String, field: &String) -> String ! alloc
    si = tt_struct_find(structs, &ty_deref(sname))
    if si < 0
        ""
    else
        fields = structs.get(si).fields
        tt_field_type_go(&fields, field, 0, fields.len())

# ---- expressions ----
fn tt_call_returns_string(name: &String) -> Int ! alloc
    call_returns_string(name)

fn tt_matmul(env: &TEnv, args: &List[Expr]) -> String ! alloc
    if args.len() == 2
        a = texpr_type(env, &args.get(0))
        b = texpr_type(env, &args.get(1))
        ts_matmul_text(&a, &b)
    else
        ""

fn tt_dict_get(env: &TEnv, args: &List[Expr]) -> String ! alloc
    dt = ty_deref(&texpr_type(env, &args.get(0)))
    v = tt_arg(&dt, 1)
    if v.len() == 0
        ""
    else
        "Option" + "[" + v + "]"

fn tt_user_call(env: &TEnv, name: &String, args: &List[Expr]) -> String ! alloc
    g = tt_index_of(&env.g_names, name, 0, env.g_names.len())
    if g >= 0
        gi = env.g_idx.get(g) - 1
        if gi < args.len()
            texpr_type(env, &args.get(gi))
        else
            ""
    else
        r = tt_index_of(&env.fn_names, name, 0, env.fn_names.len())
        if r >= 0
            env.fn_rets.get(r).clone()
        else
            ""

fn tt_call_type(env: &TEnv, name: &String, args: &List[Expr], targs: &String) -> String ! alloc
    if tt_call_returns_string(name) == 1
        "String"
    elsif name.eq("int_to_float") == 1
        "Float"
    elsif name.eq("struct_clone") + name.eq("enum_copy") + name.eq("clone") == 1
        # A copy has the type of the value it copies; the copy of a `&T` is an owned `T`.
        ty_deref(&texpr_type(env, &args.get(0)))
    elsif tt_is_container_clone(name) == 1
        # `xs.clone()` of a List/Dict/Bytes, and `x.clone()` of a Copy scalar, keep their type.
        ty_deref(&texpr_type(env, &args.get(0)))
    elsif name.eq("load") == 1
        targs.dup()
    elsif name.eq("matmul") == 1
        tt_matmul(env, args)
    elsif tt_struct_find(&env.structs, name) >= 0
        name.dup()
    elsif name.eq("list_new") + name.eq("list_new_owned") == 1
        if targs.len() == 0
            ""
        else
            "List[" + targs + "]"
    elsif name.eq("list_get") == 1
        tt_list_elem(&texpr_type(env, &args.get(0)))
    elsif name.eq("list_pop") == 1
        tt_list_elem(&texpr_type(env, &args.get(0)))
    elsif name.eq("dict_new") == 1
        if targs.len() == 0
            ""
        else
            "Dict[" + targs + "]"
    elsif name.eq("dict_get") == 1
        tt_dict_get(env, args)
    else
        tt_user_call(env, name, args)

# The clone builtins of the containers and of the Copy scalars (`infer_typed_builtin` in
# selfhost/sem/infer.sal): their result has the type of the receiver.
fn tt_is_container_clone(name: &String) -> Int ! alloc
    if name.eq("list_clone") + name.eq("dict_clone") + name.eq("bytes_clone") > 0
        1
    elsif name.eq("clone_copy") == 1
        1
    else
        0

fn tt_block_tail_type(env: &TEnv, b: &TBlock) -> String ! alloc
    texpr_type(env, &b.tail)

# sub, mul or div with a Float operand.
fn tt_arith_is_float(env: &TEnv, op: &String, l: &Expr, r: &Expr) -> Int ! alloc
    if op.eq("sub") + op.eq("mul") + op.eq("div") == 0
        0
    elsif tt_is_float(&texpr_type(env, l)) == 1
        1
    else
        tt_is_float(&texpr_type(env, r))

fn tt_binary_type(env: &TEnv, op: &String, l: &Expr, r: &Expr) -> String ! alloc
    if op.eq("add") == 1
        lt = texpr_type(env, l)
        if tt_is_string(&lt) == 1
            "String"
        elsif tt_is_float(&lt) == 1
            "Float"
        else
            ""
    elsif op.eq("and") + op.eq("or") > 0
        "Bool"
    elsif tt_arith_is_float(env, op, l, r) == 1
        "Float"
    else
        ""

fn tt_unary_type(env: &TEnv, op: &String, inner: &Expr) -> String ! alloc
    if op.eq("neg") == 1
        texpr_type(env, inner)
    elsif op.eq("not") == 1
        ""
    else
        # `&x`, `&mut x`, `*x`: the C emitter erases references.
        ty_deref(&texpr_type(env, inner))

# Type text of `e` under `env`, "" when unknown.
fn texpr_type(env: &TEnv, e: &Expr) -> String ! alloc
    match e
        XStr(s) => "String"
        XFloat(bits, txt) => "Float"
        XCall(name, args, targs, xp) => tt_call_type(env, &name, &args, &targs)
        XTensor(nr, nc, data) => "Tensor[F32, " + nr.to_str() + ", " + nc.to_str() + "] on cpu"
        XIdent(name) => tenv_type(env, &name)
        XUnary(op, inner) => tt_unary_type(env, &op, &inner)
        XBin(op, l, r) => tt_binary_type(env, &op, &l, &r)
        XField(base, field) => tt_field_type(&env.structs, &texpr_type(env, &base), &field)
        XIf(cond, then_b, else_b, has_else, elsifs) => tt_block_tail_type(env, &then_b)
        _ => ""

fn texpr_is_string(env: &TEnv, e: &Expr) -> Int ! alloc
    tt_is_string(&texpr_type(env, e))

# `a + b` where the left operand types as String.
fn tbinary_is_string_concat(env: &TEnv, e: &Expr) -> Int ! alloc
    match e
        XBin(op, l, r) => tt_add_is_string(env, &op, &l)
        _ => 0

fn tt_add_is_string(env: &TEnv, op: &String, l: &Expr) -> Int ! alloc
    match op
        "add" => texpr_is_string(env, l)
        _ => 0

