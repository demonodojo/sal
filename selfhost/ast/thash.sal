# A string-to-string hash table over `List[String]`: open addressing, doubled when half full.
# A key is never empty; a missing key reads as "". `fill` is a one-element list so every copy of
# the table sees the same count (the struct itself is passed by value).
struct HT
    keys: List[String]
    vals: List[String]
    fill: List[Int]

fn ht_fill(xs: &mut List[String], n: Int) -> Int ! alloc
    if n == 0
        0
    else
        xs.push("")
        ht_fill(xs, n - 1)

static HT.new(cap: Int) -> HT ! alloc
    keys = List.new[String]()
    vals = List.new[String]()
    n = cap * 2 + 8
    ht_fill(&mut keys, n)
    ht_fill(&mut vals, n)
    fill = List.new[Int]()
    fill.push(0)
    HT(keys, vals, fill)

method HT.home(&self, key: &String) -> Int ! alloc
    x = key.hash(5381)
    y = if x < 0
        0 - x
    else
        x
    cap = self.keys.len()
    y - (y / cap) * cap

# Slot holding `key`, or the empty slot where it would go.
method HT.probe(&self, key: &String, i: Int) -> Int ! alloc
    k = self.keys.get(i)
    if k.len() == 0
        i
    elsif k.eq(key) == 1
        i
    else
        j = i + 1
        next = if j >= self.keys.len()
            0
        else
            j
        self.probe(key, next)

method HT.put(&mut self, key: &String, val: &String) -> Int ! alloc
    self.grow()
    i = self.probe(key, self.home(key))
    fresh = if self.keys.get(i).len() == 0
        1
    else
        0
    self.fill.set(0, self.fill.get(0) + fresh)
    self.keys.set(i, key.dup())
    self.vals.set(i, val.dup())
    0

# Doubles the slots and reinserts every entry once the table is half full.
method HT.grow(&mut self) -> Int ! alloc
    n = self.keys.len()
    if (self.fill.get(0) + 1) * 2 <= n
        0
    else
        ks = List.new[String]()
        vs = List.new[String]()
        self.take_all(0, n, &mut ks, &mut vs)
        ht_fill(&mut self.keys, n)
        ht_fill(&mut self.vals, n)
        self.fill.set(0, 0)
        self.reput(&ks, &vs, 0, ks.len())
        list_free(ks)
        list_free(vs)

method HT.take_all(&mut self, i: Int, n: Int, ks: &mut List[String], vs: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        k = self.keys.get(i)
        if k.len() > 0
            ks.push(k.dup())
            vs.push(self.vals.get(i).dup())
        self.keys.set(i, "")
        self.vals.set(i, "")
        self.take_all(i + 1, n, ks, vs)

method HT.reput(&mut self, ks: &List[String], vs: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        self.put(&ks.get(i), &vs.get(i))
        self.reput(ks, vs, i + 1, n)

method HT.get(&self, key: &String) -> String ! alloc
    i = self.probe(key, self.home(key))
    self.vals.get(i).clone()

method HT.free(&self) -> Int ! alloc
    list_free(self.keys)
    list_free(self.fill)
    list_free(self.vals)
