# Helpers over type text (`List[Int]`, `Map[String, Int]`) and builtin names, shared by the passes.

fn ty_is_string(ty: &String) -> Int ! alloc
    if ty.eq("String") == 1
        1
    else
        ty.eq("String ") == 1

fn call_returns_string(name: &String) -> Int ! alloc
    match name
        "argv" => 1
        "read_file" => 1
        "str_concat" => 1
        "str_from_int" => 1
        "realpath" => 1
        _ => call_returns_string2(name)

fn call_returns_string2(name: &String) -> Int ! alloc
    match name
        "str_slice" => 1
        "int_to_str" => 1
        "char_to_str" => 1
        "strdup" => 1
        "str_share" => 1
        _ => call_returns_string3(name)

fn call_returns_string3(name: &String) -> Int ! alloc
    match name
        "select_str" => 1
        "tmp_path" => 1
        "exec_capture" => 1
        "getenv" => 1
        "ir_text" => 1
        "bytes_to_str" => 1
        _ => 0

# Builtins whose String result is a fresh heap temporary nobody else owns.
fn call_allocates_fresh_string(name: &String) -> Int ! alloc
    match name
        "int_to_str" => 1
        "char_to_str" => 1
        "str_slice" => 1
        "strdup" => 1
        "f64_bits_to_str" => 1
        "bytes_to_str" => 1
        _ => name.eq("read_file")

# `i`-th top-level type argument of `Name[A, B]`, or 0. Nested brackets are kept whole.
fn nth_type_arg(t: &String, i: Int) -> Int ! alloc
    open = ty_find_open(t, 0)
    if open < 0
        0
    else
        nth_type_arg_go(&t.slice(open + 1, t.len() - 1), i, 0, 0, 0)

fn nth_type_arg_go(s: &String, want: Int, pos: Int, start: Int, k: Int) -> Int ! alloc
    n = s.len()
    if pos >= n
        if k == want
            trim_spaces(s.slice(start, n)).to_int()
        else
            0
    else
        c = s.char(pos)
        if c == 91
            nth_type_arg_go(s, want, ty_skip_brackets(s, pos + 1, 1), start, k)
        elsif c == 44
            if k == want
                trim_spaces(s.slice(start, pos)).to_int()
            else
                nth_type_arg_go(s, want, pos + 1, pos + 1, k + 1)
        else
            nth_type_arg_go(s, want, pos + 1, start, k)

fn ty_find_open(t: &String, i: Int) -> Int ! alloc
    if i >= t.len()
        0 - 1
    elsif t.char(i) == 91
        i
    else
        ty_find_open(t, i + 1)

# The base name of a type text (`List` of `List [Int ]`), spaces trimmed.
fn ty_base(t: &String) -> String ! alloc
    open = ty_find_open(t, 0)
    if open < 0
        trim_spaces(t.dup())
    else
        trim_spaces(t.slice(0, open))

# The type a reference points to (`&'a mut Items` gives `Items`); any other type is unchanged.
fn ty_deref(t: &String) -> String ! alloc
    n = t.len()
    i = ty_deref_skip(t, 0, n)
    trim_spaces(t.slice(i, n))

# `&mut T` / `&'a mut T`: an exclusive reference (not `&T`, not a plain type).
fn ty_is_mut_ref(t: &String) -> Int ! alloc
    n = t.len()
    if n > 0
        if t.char(0) == 38
            at = ty_deref_life(t, 1, n)
            if ty_deref_mut(t, at, n) > at
                1
            else
                0
        else
            0
    else
        0

# Past a leading `&`, its lifetime and `mut`, repeated for `&&T`.
fn ty_deref_skip(t: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    elsif t.char(i) != 38
        i
    else
        ty_deref_skip(t, ty_deref_mut(t, ty_deref_life(t, i + 1, n), n), n)

fn ty_deref_life(t: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    elsif t.char(i) != 39
        i
    else
        ty_deref_word(t, i + 1, n)

fn ty_deref_word(t: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    elsif t.char(i) == 32
        i + 1
    else
        ty_deref_word(t, i + 1, n)

fn ty_deref_mut(t: &String, i: Int, n: Int) -> Int ! alloc
    if i + 4 <= n
        if t.slice(i, i + 4).eq("mut ") == 1
            i + 4
        else
            i
    else
        i

# Position after the `]` that closes the bracket opened before `pos` (depth 1).
fn ty_skip_brackets(s: &String, pos: Int, depth: Int) -> Int ! alloc
    if pos >= s.len()
        pos
    else
        c = s.char(pos)
        if c == 91
            ty_skip_brackets(s, pos + 1, depth + 1)
        elsif c == 93
            if depth == 1
                pos + 1
            else
                ty_skip_brackets(s, pos + 1, depth - 1)
        else
            ty_skip_brackets(s, pos + 1, depth)

fn trim_spaces(s: String) -> String ! alloc
    n = s.len()
    if n > 0
        if s.char(0) == 32
            trim_spaces(s.slice(1, n))
        elsif s.char(n - 1) == 32
            trim_spaces(s.slice(0, n - 1))
        else
            s
    else
        s

fn ty_type_arg(t: &String, i: Int) -> String ! alloc
    h = nth_type_arg(t, i)
    if h == 0
        ""
    else
        trim_spaces(str_from_int(h))

# Protocol name inside `any[P]`, or "" when `t` is not `any[…]`.
fn ty_any_protocol(t: &String) -> String ! alloc
    if ty_base(t).eq("any") == 0
        ""
    else
        ty_type_arg(t, 0)

fn ty_nominal(t: &String) -> String ! alloc
    ty_base(t)

# A handle to a copy the IR owns: an IR name is read later, after the block it came from may be
# released. Literals are static and keep `str_as_int(&"...")`.
fn str_own(s: &String) -> Int ! alloc
    owned = s.dup()
    (&owned).to_int()
