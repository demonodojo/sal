# Result — same surface as std/prelude; encoded as Int vec [tag, payload]
# tag 0 = Ok(T), tag 1 = Err(E). Used on the emit/compile error path.
enum Result[T, E]
    Ok(T)
    Err(E)

fn result_ok(v: Int) -> Int ! alloc
    r = vec_new()
    _a = vec_push(r, 0)
    _b = vec_push(r, v)
    r

fn result_err(e: Int) -> Int ! alloc
    r = vec_new()
    _a = vec_push(r, 1)
    _b = vec_push(r, e)
    r

fn result_is_err(r: Int) -> Int ! alloc
    if vec_get(r, 0) == 1
        1
    else
        0

fn result_unwrap(r: Int) -> Int ! alloc
    vec_get(r, 1)

fn result_payload(r: Int) -> Int ! alloc
    vec_get(r, 1)

fn module_order_vec(x: Int) -> Int ! alloc
    if vec_len(x) == 2
        if vec_get(x, 0) == 0
            vec_get(x, 1)
        else
            x
    else
        x

fn result_format_err(r: Int) -> Int ! alloc
    msg = result_unwrap(r)
    acc = strdup("Err(")
    acc = str_append(acc, msg)
    acc = str_append(acc, strdup(")\n"))
    acc
