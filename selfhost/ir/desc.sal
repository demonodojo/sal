# Type descriptors (`list_desc` / `field_drop` in the bootstrap) shared by lowering and C.
import "../ast/tast.sal"
import "../ast/tytext.sal"
import "../ast/ttypes.sal"
import drops

# Runtime container kind: Int 0, Float 1, Bool 2, String 3.
fn scalar_kind_text(txt: &String, i: Int, j: Int) -> Int ! alloc
    t = trim_type_piece(&str_slice(txt, i, j))
    match t
        "Float" => 1
        "Bool" => 2
        "String" => 3
        _ => 0

fn shift_left_one(i: Int) -> Int ! alloc
    if i == 0
        1
    else
        2 * shift_left_one(i - 1)

# Descriptor of a type as an element of `list_new[T]()` (read by `sal_list_new_desc`; `list_desc`
# in src/ir.rs): `i` a Copy scalar or a borrowed value, `s` a String, `E` an enum box an owned
# list releases, `S(d..)` a struct whose fields are all describable (`desc_struct_text`).
fn desc_type_text(structs: &List[TStruct], enums: &List[TEnum], txt: &String, owned: Int) -> String ! alloc
    base = desc_base_text(structs, enums, txt, owned)
    if owned == 1
        "+" + base
    else
        base

# The descriptor without the ownership mark (see `desc_type_text`).
fn desc_base_text(structs: &List[TStruct], enums: &List[TEnum], txt: &String, owned: Int) -> String ! alloc
    t = trim_type_piece(txt)
    if t.eq("String") == 1
        "s"
    elsif owned == 0
        desc_struct_or_i(structs, enums, &t)
    elsif enum_named_t(enums, &t, 0, enums.len()) == 1
        "E"
    else
        desc_struct_or_i(structs, enums, &t)

# The struct descriptor of `t`, or "i" for anything else (a borrowed value).
fn desc_struct_or_i(structs: &List[TStruct], enums: &List[TEnum], t: &String) -> String ! alloc
    sd = desc_struct_text(structs, enums, t, 0)
    if sd.len() == 0
        "i"
    else
        sd


# The enum named `t` in `enums` (0 or 1).
fn enum_named_t(enums: &List[TEnum], t: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif enums.get(i).name.eq(t) == 1
        1
    else
        enum_named_t(enums, t, i + 1, n)

# Descriptor `S(..)` of the struct `name`, or "" when it is not a struct a list can own.
fn desc_struct_text(structs: &List[TStruct], enums: &List[TEnum], name: &String, depth: Int) -> String ! alloc
    si = tt_struct_find(structs, name)
    if depth > 16
        ""
    elsif si < 0
        ""
    else
        sd = list_get(structs, si)
        if list_len(&sd.tparams) > 0
            ""
        elsif list_len(&sd.fields) < 2
            ""
        else
            body = desc_fields_text(structs, enums, &sd.fields, 0, list_len(&sd.fields), depth + 1, "")
            if str_contains(body, "?") == 1
                ""
            else
                "S(" + body + ")"

fn desc_fields_text(structs: &List[TStruct], enums: &List[TEnum], fields: &List[TField], i: Int, n: Int, depth: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        f = desc_field_text(structs, enums, &list_get(fields, i).ty, depth)
        desc_fields_text(structs, enums, fields, i + 1, n, depth, (acc + f))

# One field: `i` a Copy scalar, `s` a String, `E` an enum box, `S(..)` a struct; "?" otherwise.
fn desc_field_text(structs: &List[TStruct], enums: &List[TEnum], ty: &String, depth: Int) -> String ! alloc
    t = trim_type_piece(ty)
    if t.eq("String") == 1
        "s"
    elsif t.eq("Int") == 1
        "i"
    elsif t.eq("Float") == 1
        "i"
    elsif t.eq("Bool") == 1
        "i"
    elsif enum_named_t(enums, &t, 0, enums.len()) == 1
        "E"
    else
        sd = desc_struct_text(structs, enums, &t, depth)
        if str_len(sd) == 0
            "?"
        else
            sd

# Ownership class of a struct field, for `struct:Name` in the drops table (`OWNABLE` in
# src/drops.rs): 0 a Copy scalar, 1 a String, 2 an enum box, 3 a struct box.
fn field_class_text(enums: &List[TEnum], ty: &String) -> Int ! alloc
    t = trim_type_piece(ty)
    if str_eq(t, "String") == 1
        1
    elsif str_eq(t, "Int") == 1
        0
    elsif str_eq(t, "Float") == 1
        0
    elsif str_eq(t, "Bool") == 1
        0
    elsif enum_named_t(enums, &t, 0, list_len(enums)) == 1
        2
    else
        3

# ---- struct glue (`free_struct_strings`, `field_drop` in src/ir.rs) ----
# `g` says what the glue may release: bit 0 the structs held in fields, bit 1 the containers
# (`List` of flat values, `Bytes`, `Dict` of flat values). A field the glue releases is freed
# with the runtime function of its type; a one-field struct is transparent (the field is the value).

# The runtime release of a field of type `ty` under `g`, or "" when the glue leaves it alone.
# `tainted` is 1 when a non-fresh value was stored in a `List[String]` / `Dict[..., String]` field.
fn drop_field_fn(structs: &List[TStruct], enums: &List[TEnum], ty: &String, g: Int, depth: Int, tainted: Int) -> String ! alloc
    t = trim_type_piece(ty)
    base = ty_base(&t)
    if str_eq(t, "String") == 1
        "sal_free"
    elsif enum_named_t(enums, &t, 0, list_len(enums)) == 1
        "sal_enum_free"
    elsif g < 2
        drop_struct_fn(structs, enums, &t, g, depth)
    elsif str_eq(base, "Bytes") == 1
        "sal_bytes_free"
    elsif str_eq(base, "List") == 1
        elem = trim_spaces(tt_arg(&t, 0))
        if flat_value_text(&elem) == 1
            "sal_list_free"
        elsif str_eq(elem, "String") == 1
            if tainted == 1
                ""
            else
                "sal_list_free"
        elsif str_len(desc_struct_text(structs, enums, &elem, 0)) > 0
            if tainted == 1
                ""
            else
                "sal_list_free"
        else
            ""
    elsif str_eq(base, "Dict") == 1
        if dict_flat_text(&t) == 1
            "sal_dict_free"
        elsif dict_string_value_text(&t) == 1
            if tainted == 1
                ""
            else
                "sal_dict_free"
        else
            ""
    else
        drop_struct_fn(structs, enums, &t, g, depth)

# "struct" when the field is a struct the glue releases into (it holds a String or a container).
fn drop_struct_fn(structs: &List[TStruct], enums: &List[TEnum], t: &String, g: Int, depth: Int) -> String ! alloc
    si = tt_struct_find(structs, t)
    if g % 2 == 0
        ""
    elsif si < 0
        ""
    elsif depth >= 8
        ""
    elsif list_len(&list_get(structs, si).tparams) > 0
        ""
    elsif struct_has_heap_t(structs, enums, &list_get(structs, si), depth + 1, g) == 0
        ""
    else
        "struct"

# A Copy scalar type name (`Int`, `Float`, `Bool`).
fn flat_value_text(t: &String) -> Int ! alloc
    if str_eq(t, "Int") == 1
        1
    elsif str_eq(t, "Float") == 1
        1
    elsif str_eq(t, "Bool") == 1
        1
    else
        0

# `Dict[K, V]` with K Int or String and V a Copy scalar.
fn dict_flat_text(t: &String) -> Int ! alloc
    k = trim_spaces(tt_arg(t, 0))
    v = trim_spaces(tt_arg(t, 1))
    if str_eq(k, "Int") + str_eq(k, "String") == 0
        0
    else
        flat_value_text(&v)

# `Dict[K, String]` with K Int or String.
fn dict_string_value_text(t: &String) -> Int ! alloc
    k = trim_spaces(tt_arg(t, 0))
    v = trim_spaces(tt_arg(t, 1))
    if str_eq(k, "Int") + str_eq(k, "String") == 0
        0
    elsif str_eq(v, "String") == 1
        1
    else
        0

# Does the struct hold anything the glue releases, directly or in a nested struct?
fn struct_has_heap_t(structs: &List[TStruct], enums: &List[TEnum], sd: &TStruct, depth: Int, g: Int) -> Int ! alloc
    struct_has_heap_fields(structs, enums, &sd.fields, 0, list_len(&sd.fields), depth, g)

fn struct_has_heap_fields(structs: &List[TStruct], enums: &List[TEnum], fields: &List[TField], i: Int, n: Int, depth: Int, g: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_len(drop_field_fn(structs, enums, &list_get(fields, i).ty, g, depth, 0)) > 0
        1
    else
        struct_has_heap_fields(structs, enums, fields, i + 1, n, depth, g)
