# Scope-end release insertion for owned locals; the mirror of src/drops.rs. A local is dropped
# when it is bound once (let or first assignment) to a fresh heap value, never reassigned (except
# the in-place `x = x + ...`) and never escapes: it is only read by borrowing builtins and by `+`.
# Releases go at the end of the declaring block and before each `return` in its scope.
#
# The pass works on a typed fn (`tast.sal`). The program-wide tables it reads (`variants`: variant
# name to `[1 (has fields) or 2 (unit), per-field "may own heap memory" flags]` and
# `struct:Name` to a flat struct's per-field "is a String" flags; `ro`: fn name to its parameters'
# read-only flags) are still handle maps built by `fuse.sal`, so they are `Int` fields here.
import "../ast/tast.sal"
import "../ast/tytext.sal"
import "../ast/tshape.sal"

# Name to number; a missing name reads 0.
struct NM
    names: List[String]
    vals: List[Int]

fn nm_new() -> NM ! alloc
    NM(List.new[String](), List.new[Int]())

fn nm_find(m: &NM, name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif (&m.names).get(i).eq(name) == 1
        i
    else
        nm_find(m, name, i + 1, n)

fn nm_get(m: &NM, name: &String) -> Int ! alloc
    i = nm_find(m, name, 0, list_len(&m.names))
    if i < 0
        0
    else
        list_get(&m.vals, i)

fn nm_put(m: &mut NM, name: &String, v: Int) -> Int ! alloc
    i = nm_find(m, name, 0, list_len(&m.names))
    if i < 0
        _a = list_push(&mut m.names, strdup(name))
        _b = list_push(&mut m.vals, v)
        0
    else
        _c = list_set(m.vals, i, v)
        0

fn nm_free(m: &NM) -> Int ! alloc
    _a = list_free(m.names)
    list_free(m.vals)

# `esc` holds names that leave their scope, `defs` how often each is bound, `params` the
# parameters, `kinds` how a fresh local is released, `tainted` containers that received a value
# not known to be fresh, `soft` names that escape only at whole statements of their own loop
# depth, `born` the loop depth (+1) each name was bound at. `sites` pairs a statement id with a
# name it moves. `m_scrut`/`m_bound` record, per `match x`, the scrutinee and the owned names
# its patterns bind (comma separated). `cells`: 0 temp counter, 1 statement being walked (0 when
# none can clear a flag), 2 depth inside blocks the transform skips, 3 loop depth.
struct DC
    esc: NM
    # Handed out for real (returned whole, stored, or passed on). A Copy field is in `esc` but not here.
    took: NM
    defs: NM
    params: NM
    kinds: NM
    tainted: NM
    soft: NM
    box_shell: NM
    born: NM
    owned_enums: NM
    lists: NM
    copy_desc: NM
    # Per local, the release kind every one of its bindings shares (99 when they differ or one is
    # not fresh): a local bound more than once with one kind is released on reassignment.
    rbk: NM
    live: List[String]
    site_ids: List[Int]
    site_names: List[String]
    m_scrut: List[String]
    m_bound: List[String]
    cells: List[Int]
    variants: Int
    ro: Int
    ps: List[TParam]
    scalars: List[String]
    copy_ok: List[Int]

# An owned copy of the parameter list: the `TFn` it comes from keeps its own.
fn tparams_copy(xs: &List[TParam]) -> List[TParam] ! alloc
    tparams_copy_go(xs, 0, xs.len(), List.new[TParam]())

fn tparams_copy_go(xs: &List[TParam], i: Int, n: Int, out: List[TParam]) -> List[TParam] ! alloc
    if i >= n
        out
    else
        p = xs.get(i)
        _a = out.push(TParam(p.name.dup(), p.ty.dup(), p.mode))
        tparams_copy_go(xs, i + 1, n, out)

fn dr_new(variants: Int, ro: Int, lists: NM, ps: &List[TParam], scalars: List[String], copy_ok: List[Int]) -> DC ! alloc
    cells = list_new[Int]()
    _a = list_push(&mut cells, 0)
    _b = list_push(&mut cells, 0)
    _c = list_push(&mut cells, 0)
    _d = list_push(&mut cells, 0)
    _e = list_push(&mut cells, 0)
    _f = list_push(&mut cells, 0)
    _g = list_push(&mut cells, 0)
    _h = list_push(&mut cells, 0)
    DC(nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), nm_new(), lists, nm_new(), nm_new(), list_new[String](), list_new[Int](), list_new[String](), list_new[String](), list_new[String](), cells, variants, ro, tparams_copy(ps), scalars, copy_ok)

# The local `DC` is dropped at the end of its scope, which releases these lists.
# Freeing them here as well is a double free.
# A `DC` local is released by the glue of its struct (its `NM` fields included).

fn dr_cell(c: &DC, i: Int) -> Int ! alloc
    list_get(&c.cells, i)

fn dr_set(c: &mut DC, i: Int, v: Int) -> Int ! alloc
    _a = list_set(c.cells, i, v)
    0

fn dr_escape(c: &mut DC, name: &String) -> Int ! alloc
    nm_put(&mut c.esc, name, 1)

# The name was handed out, not merely read. A Copy field does not.
method DC.take(&mut self, name: &String) -> Int ! alloc
    nm_put(&mut self.took, name, 1)

# A block tail that is the parameter itself (`return t`) hands that value out.
method DC.take_tail(&mut self, e: &Expr) -> Int ! alloc
    match e
        XIdent(n) => self.take(&n)
        _ => 0

fn dr_bind(c: &mut DC, name: &String) -> Int ! alloc
    if nm_get(&c.born, name) == 0
        h133_0 = dr_cell(c, 3) + 1
        _d = nm_put(&mut c.born, name, h133_0)
        h135_1 = nm_get(&c.defs, name) + 1
        nm_put(&mut c.defs, name, h135_1)
    else
        h138_2 = nm_get(&c.defs, name) + 1
        nm_put(&mut c.defs, name, h138_2)

# Records that statement `st` moves `name`.
fn dr_soft(c: &mut DC, st: Int, name: &String) -> Int ! alloc
    _s = nm_put(&mut c.soft, name, 1)
    if dr_site_has(c, st, name, 0, list_len(&c.site_ids)) == 1
        0
    else
        _a = list_push(&mut c.site_ids, st)
        _b = list_push(&mut c.site_names, strdup(name))
        0

# A tail that moves `name` clears its flag before it runs, as a statement does: the tail is
# identified by `dr_tail_key` (cell 5).
fn dr_tail_site(c: &mut DC, name: &String) -> Int ! alloc
    t = dr_cell(c, 5)
    if t == 0
        0
    elsif dr_site_has(c, t, name, 0, list_len(&c.site_ids)) == 1
        0
    else
        _a = list_push(&mut c.site_ids, t)
        _b = list_push(&mut c.site_names, strdup(name))
        0

fn dr_site_has(c: &DC, st: Int, name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(&c.site_ids, i) == st
        if str_eq(list_get(&c.site_names, i), name) == 1
            1
        else
            dr_site_has(c, st, name, i + 1, n)
    else
        dr_site_has(c, st, name, i + 1, n)

# Hard or soft: the name leaves its scope somehow.
fn dr_escapes(c: &DC, name: &String) -> Int ! alloc
    if nm_get(&c.esc, name) != 0
        1
    elsif nm_get(&c.soft, name) != 0
        1
    else
        0

fn dr_truncate(c: &mut DC, mark: Int) -> Int ! alloc
    if list_len(&c.live) > mark
        _p = list_pop(c.live)
        dr_truncate(c, mark)
    else
        0

fn dr_next_tmp(c: &mut DC) -> String ! alloc
    dr_next_tmp_p(c, &"__ret")

# The next temporary name with prefix `p`; `__ret` and `__dis` share the counter.
fn dr_next_tmp_p(c: &mut DC, p: &String) -> String ! alloc
    n = dr_cell(c, 0) + 1
    _s = dr_set(c, 0, n)
    p + int_to_str(n)

# Trimmed type text equals `name`.
fn dr_tm(t: &String, name: &String) -> Int ! alloc
    if str_len(t) == 0
        0
    else
        str_eq(trim_spaces(t.dup()), name)


# ---- shapes of an expression ----
fn dx_ident(e: &Expr) -> String ! alloc
    match e
        XIdent(s) => s.dup()
        _ => ""

fn dx_is_ident(e: &Expr) -> Int ! alloc
    match e
        XIdent(s) => 1
        _ => 0

fn dx_is_call(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => 1
        _ => 0

fn dx_is_none(e: &Expr) -> Int ! alloc
    match e
        XNone => 1
        _ => 0

fn dx_is_while(e: &Expr) -> Int ! alloc
    match e
        XWhile(cond, body) => 1
        _ => 0

fn dx_is_if(e: &Expr) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => 1
        _ => 0

fn dx_is_string_operand(e: &Expr) -> Int ! alloc
    match e
        XStr(s) => 1
        XCall(name, args, targs, xp) => dr_returns_fresh(&name)
        _ => 0

# A `+` chain is a string concatenation when some operand is syntactically a string.
fn dx_add_is_string_chain(e: &Expr) -> Int ! alloc
    match e
        XBin(op, l, r) => dx_chain_bin(&op, &l, &r)
        _ => dx_is_string_operand(e)

fn dx_chain_bin(op: &String, l: &Expr, r: &Expr) -> Int ! alloc
    if dx_op_typed_string_add(op) == 1
        # Marked by `ir/stradd.sal`: the left operand types as String.
        1
    elsif str_eq(op, "add") == 1
        if dx_add_is_string_chain(l) == 1
            1
        else
            dx_is_string_operand(r)
    else
        0

# A value certainly owned by whoever stores it: a literal, a fresh-string call or a string `+` chain.
fn dx_is_fresh_value(e: &Expr) -> Int ! alloc
    match e
        XBin(op, l, r) => dx_add_is_string_chain(e)
        _ => dx_is_string_operand(e)

# A fresh temporary the hoist binds: a fresh value, or a call to a user fn the caller owns.
fn dx_is_fresh_temp_v(vm: Int, e: &Expr) -> Int ! alloc
    match e
        XNone => 0
        XStr(s) => 0
        XCall(name, args, targs, xp) => dx_is_fresh_call_v(vm, e, &name)
        _ => dx_is_fresh_value(e)

fn dx_is_fresh_call_v(vm: Int, e: &Expr, name: &String) -> Int ! alloc
    if dr_owned_name(vm, name) == 1
        1
    elsif dx_is_passthru_fresh(vm, e) == 1
        1
    else
        dx_is_fresh_value(e)

# `list_new[T]()` with T Int, Float, Bool or String (or no type argument).
fn dx_copy_elem_args(targs: &String) -> Int ! alloc
    if str_len(targs) == 0
        1
    elsif dr_tm(targs, &"Int") == 1
        1
    elsif dr_tm(targs, &"Float") == 1
        1
    elsif dr_tm(targs, &"Bool") == 1
        1
    elsif dr_tm(targs, &"String") == 1
        1
    elsif ty_find_open(targs, 0) < 0
        0
    else
        # A list of lists owns its inner lists: its elements carry `sal_list_free_elem`.
        ty_base(targs).eq("List")

# `list_new[S]()` with `S` a struct that has no descriptor: its elements are released by the glue
# of `S` (`list_glue_arg` in src/drops.rs).
fn dx_list_glue(c: &DC, targs: &String) -> Int ! alloc
    if targs.len() == 0
        0
    elsif map_get(c.variants, str_own(&("glue:" + trim_spaces(targs.dup())))) == 0
        0
    else
        1

fn dx_find_comma(s: &String, i: Int) -> Int ! alloc
    if i >= str_len(s)
        0 - 1
    elsif str_char(s, i) == 44
        i
    else
        dx_find_comma(s, i + 1)

fn dx_key_ok(k: &String) -> Int ! alloc
    if dr_tm(k, &"Int") == 1
        1
    elsif dr_tm(k, &"String") == 1
        1
    else
        0

fn dx_val_ok(v: &String) -> Int ! alloc
    if dr_tm(v, &"Int") == 1
        1
    elsif dr_tm(v, &"Float") == 1
        1
    elsif dr_tm(v, &"Bool") == 1
        1
    elsif dr_tm(v, &"String") == 1
        1
    else
        0

# `dict_new[K, V]()` with K Int or String and V Int, Float, Bool or String.
fn dx_dict_args(targs: &String) -> Int ! alloc
    if str_len(targs) == 0
        0
    else
        comma = dx_find_comma(targs, 0)
        if comma < 0
            0
        elsif dx_key_ok(&trim_spaces(str_slice(targs, 0, comma))) == 1
            dx_val_ok(&trim_spaces(str_slice(targs, comma + 1, str_len(targs))))
        else
            0

# `dict_new[K, String]()`: the dict owns its values.
fn dx_dict_owns(targs: &String) -> Int ! alloc
    comma = dx_find_comma(targs, 0)
    dr_tm(&trim_spaces(str_slice(targs, comma + 1, str_len(targs))), &"String")

# `list_new[String]()`: the list owns its elements.
fn dx_list_owns(targs: &String) -> Int ! alloc
    if str_len(targs) == 0
        0
    else
        dr_tm(targs, &"String")

fn dr_flat_rec(c: &DC, name: &String) -> Int ! alloc
    map_get(c.variants, str_own(&("struct:" + name)))

# `list_push`, a struct ctor, … take the whole box; a user fn only scalarizes the fields.
fn dr_transfers_box(c: &DC, name: &String) -> Int ! alloc
    if str_eq(name, "list_push") + str_eq(name, "list_set") + str_eq(name, "dict_put") > 0
        1
    elsif dr_flat_rec(c, name) != 0
        1
    else
        0

# `list_new[S]()` of a flat struct: the list owns the element blocks and their strings.
fn dx_list_flat(c: &DC, targs: &String) -> Int ! alloc
    if str_len(targs) == 0
        0
    elsif dr_flat_rec(c, &trim_spaces(targs.dup())) == 0
        0
    else
        1

# `S(a, b, ..)` of a flat struct whose String fields are all fresh values.
fn dx_is_fresh_flat_ctor(c: &DC, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_flat_ctor(c, &name, &args)
        _ => 0

fn dx_flat_ctor(c: &DC, name: &String, args: &List[Expr]) -> Int ! alloc
    rec = dr_flat_rec(c, name)
    if rec == 0
        0
    elsif vec_len(rec) != list_len(args)
        0
    else
        dx_flat_args_fresh(c, rec, args, 0, list_len(args))

# Each field's class (`field_class_text` in desc.sal): a String must be fresh, an enum field a
# variant constructor, a struct field a fresh struct constructor; scalars need nothing.
fn dx_flat_args_fresh(c: &DC, rec: Int, args: &List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    elsif dx_field_fresh(c, vec_get(rec, i), &list_get(args, i)) == 1
        dx_flat_args_fresh(c, rec, args, i + 1, n)
    else
        0

fn dx_field_fresh(c: &DC, code: Int, a: &Expr) -> Int ! alloc
    if code == 1
        dx_is_fresh_value(a)
    elsif code == 2
        dx_is_fresh_variant(c, a)
    elsif code == 3
        dx_is_fresh_flat_ctor(c, a)
    else
        1

# Whether variant `name` has fields.
fn dr_variant_has_fields(c: &DC, name: &String) -> Int ! alloc
    rec = map_get(c.variants, str_own(name))
    if rec == 0
        0
    elsif vec_get(rec, 0) == 1
        1
    else
        0

# User fns whose `String` result the caller owns (`owned_return_fns` in src/drops.rs): the
# variant map holds `ownfn:<name>` for each of them.
fn dr_owned_name(vm: Int, name: &String) -> Int ! alloc
    if map_get(vm, str_own(&("ownfn:" + name))) == 1
        1
    else
        0

fn owned_fns_put(m: Int, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        _o = if ty_is_string(&f.ret) == 1
            if owned_fn_body(&f) == 1
                map_put(m, str_own(&("ownfn:" + f.name)), 1)
            else
                0
        else
            0
        owned_fns_put(m, fns, i + 1, n)

# `pass:<fn>:<i>` for every by-value parameter `i` that `fn` returns as the value of a branch tail
# (`PASSTHRU_FNS` in src/drops.rs): given a fresh temporary, the result is that temporary.
fn passthru_put(m: Int, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = fns.get(i)
        passthru_params(m, &f, 0, f.params.len())
        passthru_put(m, fns, i + 1, n)

fn passthru_params(m: Int, f: &TFn, j: Int, n: Int) -> Int ! alloc
    if j >= n
        0
    else
        p = f.params.get(j)
        if dr_ty_is_ref(&p.ty) == 0 && tail_is_param(&f.body.tail, &p.name) == 1
            map_put(m, str_own(&("pass:" + f.name + ":" + j.to_str())), 1)
        passthru_params(m, f, j + 1, n)

# 1 when `e` is `name`, or an `if`/`match` whose value is `name` in some branch
# (`expr_value_is_param_tail`).
fn tail_is_param(e: &Expr, name: &String) -> Int ! alloc
    match e
        XIdent(nm) => nm.eq(name)
        XIf(cond, then_b, else_b, has_else, elsifs) => tail_if_returns(&then_b, &else_b, has_else, &elsifs, name)
        XMatch(scrut, arms) => tail_arms_return(&arms, name, 0, arms.len())
        _ => 0

fn tail_if_returns(then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif], name: &String) -> Int ! alloc
    if tail_is_param(&then_b.tail, name) == 1
        1
    elsif tail_elsifs_return(elsifs, name, 0, elsifs.len()) == 1
        1
    elsif has_else == 1
        tail_is_param(&else_b.tail, name)
    else
        0

fn tail_elsifs_return(elsifs: &List[TElsif], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif tail_is_param(&elsifs.get(i).body.tail, name) == 1
        1
    else
        tail_elsifs_return(elsifs, name, i + 1, n)

fn tail_arms_return(arms: &List[TArm], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif tail_is_param(&tarm_value(&arms.get(i)), name) == 1
        1
    else
        tail_arms_return(arms, name, i + 1, n)

# `same(<fresh temporary>)` with `same` a pass-through fn, or a call `note_passthru_calls`
# marked: the caller owns the result (`is_passthru_fresh` in src/drops.rs).
fn dx_is_passthru_fresh(vm: Int, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_passthru_call(vm, &name, &args, xp)
        _ => 0

fn dx_passthru_call(vm: Int, name: &String, args: &List[Expr], xp: Int) -> Int ! alloc
    if dx_passthru_arg(vm, name, args, 0, args.len()) == 1
        1
    elsif xp > 0
        map_get(vm, str_own(&("ptc:" + xp.to_str())))
    else
        0

fn dx_passthru_arg(vm: Int, name: &String, args: &List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif map_get(vm, str_own(&("pass:" + name + ":" + i.to_str()))) == 1 && dx_is_fresh_temp_v(vm, &args.get(i)) == 1
        1
    else
        dx_passthru_arg(vm, name, args, i + 1, n)

# The calls (and nested ones) to a pass-through fn whose by-value argument is a fresh local
# bound once: that local moves into the call, the result is its block (`note_passthru_calls`).
# The mark is `ptc:<position of the call>`.
fn note_passthru_body(vm: Int, b: &TBlock) -> Int ! alloc
    fresh = List.new[String]()
    passthru_fresh_locals(vm, &b.stmts, 0, b.stmts.len(), &mut fresh)
    note_passthru_stmts(vm, &b.stmts, 0, b.stmts.len(), &fresh)
    note_passthru_calls(vm, &b.tail, &fresh)

fn passthru_fresh_locals(vm: Int, stmts: &List[TStmt], i: Int, n: Int, out: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        st = stmts.get(i)
        if st.kind == 1 && passthru_fresh_init(vm, &st.expr) == 1 && owned_binds(stmts, 0, n, &st.name) == 1
            out.push(st.name.dup())
        passthru_fresh_locals(vm, stmts, i + 1, n, out)

# `is_fresh_value(init) || is_owned_call(init)`.
fn passthru_fresh_init(vm: Int, e: &Expr) -> Int ! alloc
    if dx_is_fresh_value(e) == 1
        1
    else
        match e
            XCall(name, args, targs, xp) => dr_owned_name(vm, &name)
            _ => 0

fn note_passthru_stmts(vm: Int, stmts: &List[TStmt], i: Int, n: Int, fresh: &List[String]) -> Int ! alloc
    if i >= n
        0
    else
        st = stmts.get(i)
        if st.kind == 1 || st.kind == 3
            note_passthru_calls(vm, &st.expr, fresh)
        note_passthru_stmts(vm, stmts, i + 1, n, fresh)

fn note_passthru_calls(vm: Int, e: &Expr, fresh: &List[String]) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => note_passthru_call(vm, &name, &args, xp, fresh)
        _ => 0

fn note_passthru_call(vm: Int, name: &String, args: &List[Expr], xp: Int, fresh: &List[String]) -> Int ! alloc
    if xp > 0 && note_passthru_hit(vm, name, args, fresh, 0, args.len()) == 1
        map_put(vm, str_own(&("ptc:" + xp.to_str())), 1)
    note_passthru_args(vm, args, fresh, 0, args.len())

fn note_passthru_hit(vm: Int, name: &String, args: &List[Expr], fresh: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif map_get(vm, str_own(&("pass:" + name + ":" + i.to_str()))) == 1 && note_passthru_fresh_arg(&args.get(i), fresh) == 1
        1
    else
        note_passthru_hit(vm, name, args, fresh, i + 1, n)

fn note_passthru_fresh_arg(a: &Expr, fresh: &List[String]) -> Int ! alloc
    match a
        XIdent(nm) => dr_in_live(fresh, &nm, 0, fresh.len())
        _ => 0

fn note_passthru_args(vm: Int, args: &List[Expr], fresh: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        note_passthru_calls(vm, &args.get(i), fresh)
        note_passthru_args(vm, args, fresh, i + 1, n)

# `retk:<name>` for every fn that returns a container by value: the caller owns and releases it
# (`user_call_kind` in src/drops.rs). The kind is 2 `List`, 3 `Bytes`, 4 `Dict`.
fn ret_kinds_put(m: Int, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        k = dr_ret_kind(&f.ret)
        _o = if k == 0
            0
        else
            map_put(m, str_own(&("retk:" + f.name)), k)
        ret_kinds_put(m, fns, i + 1, n)

fn dr_ret_kind(ret: &String) -> Int ! alloc
    t = ty_base(ret)
    if t.eq("Bytes") == 1
        3
    elsif t.eq("List") == 1
        2
    elsif t.eq("Dict") == 1
        4
    else
        0

# The body is `return`ed fresh values only: every binding is fresh and bound once, no `if`,
# `match` or `while` sits at its top level, and so do the returns and the tail.
fn owned_fn_body(f: &TFn) -> Int ! alloc
    locals = list_new[String]()
    if owned_scan(&f.body.stmts, 0, list_len(&f.body.stmts), &mut locals) == 0
        0
    elsif owned_tail_ok(&f.body.tail, &locals, &f.params) == 0
        0
    else
        owned_returns_ok(&f.body.stmts, 0, list_len(&f.body.stmts), &locals, &f.params)

fn owned_scan(stmts: &List[TStmt], i: Int, n: Int, locals: &mut List[String]) -> Int ! alloc
    if i >= n
        1
    else
        st = list_get(stmts, i)
        ok = owned_stmt(stmts, &st, locals)
        if ok == 0
            0
        else
            owned_scan(stmts, i + 1, n, locals)

fn owned_stmt(stmts: &List[TStmt], st: &TStmt, locals: &mut List[String]) -> Int ! alloc
    if st.kind == 2
        1
    elsif owned_branches(&st.expr) == 1
        0
    elsif st.kind == 0
        1 - dx_is_while(&st.expr)
    elsif st.kind == 1
        _b = owned_bind_local(stmts, st, locals)
        1
    else
        1

# A binding whose value is fresh and that is bound once is a local the return may hand out.
fn owned_bind_local(stmts: &List[TStmt], st: &TStmt, locals: &mut List[String]) -> Int ! alloc
    if owned_fresh_builtin(&st.expr) == 0
        0
    elsif owned_binds(stmts, 0, list_len(stmts), &st.name) == 1
        _p = list_push(locals, strdup(st.name))
        1
    else
        0

fn owned_tail_ok(t: &Expr, locals: &List[String], params: &List[TParam]) -> Int ! alloc
    match t
        XNone => 0
        _ => owned_return_ok(t, locals, params)

fn owned_returns_ok(stmts: &List[TStmt], i: Int, n: Int, locals: &List[String], params: &List[TParam]) -> Int ! alloc
    if i >= n
        1
    else
        st = list_get(stmts, i)
        r = if st.kind == 2
            owned_return_ok(&st.expr, locals, params)
        else
            1
        if r == 0
            0
        else
            owned_returns_ok(stmts, i + 1, n, locals, params)

fn owned_return_ok(v: &Expr, locals: &List[String], params: &List[TParam]) -> Int ! alloc
    match v
        XNone => 1
        XIf(cond, then_b, else_b, has_else, elsifs) => owned_if_ok(&then_b, &else_b, has_else, &elsifs, locals, params)
        XMatch(scrut, arms) => owned_arms_ok(&arms, 0, arms.len(), locals, params)
        _ => if owned_fresh_builtin(v) == 1
            1
        elsif owned_param_string_field(v, params) == 1
            1
        else
            owned_local(v, locals)

# Every branch hands out an owned String (`owned_string_expr` in src/drops.rs); an `if` needs
# its `else`.
fn owned_if_ok(then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif], locals: &List[String], params: &List[TParam]) -> Int ! alloc
    if has_else == 0
        0
    elsif owned_block_ok(then_b, locals, params) == 0
        0
    elsif owned_block_ok(else_b, locals, params) == 0
        0
    else
        owned_elsifs_ok(elsifs, 0, elsifs.len(), locals, params)

fn owned_block_ok(b: &TBlock, locals: &List[String], params: &List[TParam]) -> Int ! alloc
    if owned_returns_ok(&b.stmts, 0, b.stmts.len(), locals, params) == 0
        0
    else
        owned_tail_ok(&b.tail, locals, params)

fn owned_elsifs_ok(xs: &List[TElsif], i: Int, n: Int, locals: &List[String], params: &List[TParam]) -> Int ! alloc
    if i >= n
        1
    elsif owned_block_ok(&xs.get(i).body, locals, params) == 0
        0
    else
        owned_elsifs_ok(xs, i + 1, n, locals, params)

fn owned_arms_ok(arms: &List[TArm], i: Int, n: Int, locals: &List[String], params: &List[TParam]) -> Int ! alloc
    if i >= n
        1
    else
        a = arms.get(i)
        ok = if a.has_suite == 1
            owned_block_ok(&a.suite, locals, params)
        else
            owned_return_ok(&a.body, locals, params)
        if ok == 0
            0
        else
            owned_arms_ok(arms, i + 1, n, locals, params)

fn owned_param_string_field(v: &Expr, params: &List[TParam]) -> Int ! alloc
    match v
        XField(base, field) => owned_param_root(&base, params)
        _ => 0

# The base of `p.field` is the parameter `p`. A nested pattern does not bind here.
fn owned_param_root(base: &Expr, params: &List[TParam]) -> Int ! alloc
    match base
        XIdent(name) => param_named(params, &name, 0, params.len())
        _ => 0

fn param_named(params: &List[TParam], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(params, i).name, name) == 1
        1
    else
        param_named(params, name, i + 1, n)

fn owned_local(v: &Expr, locals: &List[String]) -> Int ! alloc
    match v
        XIdent(name) => dr_in_live(locals, &name, 0, list_len(locals))
        _ => 0

# How often the statements bind `name` (a `let` or a first assignment).
fn owned_binds(stmts: &List[TStmt], i: Int, n: Int, name: &String) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        here = if st.kind == 1
            str_eq(st.name, name)
        else
            0
        here + owned_binds(stmts, i + 1, n, name)

# A builtin whose `String` result is fresh, without the user fns (`fresh_builtin` in src/drops.rs).
fn owned_fresh_builtin(e: &Expr) -> Int ! alloc
    match e
        XStr(s) => 1
        XCall(name, args, targs, xp) => dr_returns_fresh(&name)
        XBin(op, l, r) => dx_add_is_string_chain(e)
        _ => 0

fn owned_branches(e: &Expr) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => 1
        XMatch(scrut, arms) => 1
        _ => 0

# How a fresh local is released: 0 none, 1 `free`, 2 `list_free`, 3 `bytes_free`, 4 `dict_free`,
# 5 `enum_free` (box of a variant with fields), 6 a list that owns its elements, 7 a dict that does.
fn dr_fresh_kind(c: &DC, e: &Expr) -> Int ! alloc
    match e
        XStr(s) => 1
        XTensor(nr, nc, data) => 10
        XCall(name, args, targs, xp) => dr_fresh_call(c, e, &name, &targs)
        XBin(op, l, r) => dr_fresh_bin(&op, e)
        _ => 0

fn dr_fresh_bin(op: &String, e: &Expr) -> Int ! alloc
    if str_eq(op, "add") + dx_op_typed_string_add(op) > 0
        dx_add_is_string_chain(e)
    else
        0

fn dr_fresh_call(c: &DC, e: &Expr, name: &String, targs: &String) -> Int ! alloc
    if dr_returns_fresh(name) == 1
        1
    elsif dr_owned_name(c.variants, name) == 1
        1
    elsif dx_is_passthru_fresh(c.variants, e) == 1
        1
    elsif dr_variant_has_fields(c, name) == 1
        5
    elsif str_eq(name, "bytes_new") == 1
        3
    elsif str_eq(name, "list_new") == 1
        dr_fresh_list(c, targs)
    elsif str_eq(name, "dict_new") == 1
        dr_fresh_dict(targs)
    elsif str_eq(name, "dict_keys") + str_eq(name, "dict_values") == 1
        # A fresh list whose String elements are copies the list owns.
        6
    elsif str_eq(name, "dict_get") == 1
        5
    elsif str_eq(name, "bytes_view") + str_eq(name, "bytes_view_mem") == 1
        3
    elsif name.eq("list_clone") == 1
        # `xs.clone()` is a fresh container that owns a copy of every element.
        2
    elsif name.eq("dict_clone") == 1
        4
    elsif name.eq("bytes_clone") == 1
        3
    else
        map_get(c.variants, str_own(&("retk:" + name)))

# The builtins `x.clone()` lowers to, one per type.
fn dr_is_clone(name: &String) -> Int ! alloc
    match name
        "struct_clone" => 1
        "enum_copy" => 1
        "list_clone" => 1
        "dict_clone" => 1
        "bytes_clone" => 1
        "clone_copy" => 1
        _ => 0

fn dr_fresh_list(c: &DC, targs: &String) -> Int ! alloc
    if dx_list_flat(c, targs) == 1
        6
    elsif dx_list_enum(c, targs) == 1
        6
    elsif dx_copy_elem_args(targs) == 1
        if dx_list_owns(targs) == 1
            6
        else
            2
    elsif dx_list_glue(c, targs) == 1
        2
    else
        0

fn dr_fresh_dict(targs: &String) -> Int ! alloc
    if dx_dict_args(targs) == 1
        if dx_dict_owns(targs) == 1
            7
        else
            4
    else
        0

# `x = x + ...` is the same binding (the `+` consumes `x`), unless `x` is a reference parameter:
# then it binds `x` to a new value (mirror of `is_accumulate`; the selfhost only knows the types
# of the parameters).
fn dr_acc(c: &DC, name: &String, value: &Expr) -> Int ! alloc
    if dr_named_param_is_ref(&c.ps, name, 0, c.ps.len()) == 1
        0
    else
        dr_is_accumulate(name, value)

fn dr_named_param_is_ref(ps: &List[TParam], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif ps.get(i).name.eq(name) == 1
        dr_ty_is_ref(&ps.get(i).ty)
    else
        dr_named_param_is_ref(ps, name, i + 1, n)

fn dr_ty_is_ref(ty: &String) -> Int ! alloc
    if ty.len() > 0
        ty.char(0) == 38
    else
        0

# `x = x + ...`: appends in place, not a new binding.
fn dr_is_accumulate(name: &String, value: &Expr) -> Int ! alloc
    match value
        XBin(op, l, r) => dr_accumulates(name, &op, &l)
        _ => 0

fn dr_accumulates(name: &String, op: &String, l: &Expr) -> Int ! alloc
    if str_eq(op, "add") + str_eq(op, "sadd") > 0
        str_eq(dx_leftmost(l), name)
    else
        0

# Identifier at the left end of a `+` chain, "" when it is not one.
fn dx_leftmost(e: &Expr) -> String ! alloc
    match e
        XBin(op, l, r) => dx_leftmost_bin(&op, &l, e)
        XIdent(s) => s.dup()
        _ => ""

# A `radd` (`ir/stradd.sal`) starts at a reference: no accumulator can start there.
fn dx_leftmost_bin(op: &String, l: &Expr, e: &Expr) -> String ! alloc
    if str_eq(op, "add") + str_eq(op, "sadd") > 0
        dx_leftmost(l)
    else
        ""

# A string `+` that `ir/stradd.sal` marked from the types of the lowering.
fn dx_op_typed_string_add(op: &String) -> Int ! alloc
    match op
        "sadd" => 1
        "radd" => 1
        _ => 0

# ---- escape facts ----
# `mov`: 1 read, 2 transfer box, 3 take fields only.
fn dr_arg(c: &mut DC, a: &Expr, mov: Int) -> Int ! alloc
    match a
        XNone => 0
        XIdent(n) => dr_arg_ident(c, &n, mov)
        XField(base, field) => dr_arg_field(c, a, mov)
        XUnary(op, inner) => dr_arg_unary(c, a, &op, &inner, mov)
        _ => dr_expr(c, a)

# `str_as_int(&s)` stores the handle of `s`: through the reference, `s` still escapes.
fn dr_arg_unary(c: &mut DC, a: &Expr, op: &String, inner: &Expr, mov: Int) -> Int ! alloc
    if mov != 2 && mov != 4
        dr_expr(c, a)
    elsif str_eq(op, "ref") + str_eq(op, "refmut") > 0
        dr_arg(c, inner, mov)
    else
        dr_expr(c, a)

# A field read in a moving position hands out a value that aliases its base: the base escapes
# so this function does not release it. It is not `take`: the caller clones only when the
# parameter ident itself is stored or returned. A Copy leaf (`return p.n`) is the same.
fn dr_arg_field(c: &mut DC, a: &Expr, mov: Int) -> Int ! alloc
    root = dr_field_root(a)
    if mov != 1
        if root.len() == 0
            0
        else
            dr_escape(c, &root)
    else
        0
    dr_expr(c, a)

# 1 when `a` is `param.field` and that field is Int, Float, or Bool.
# Type texts keep a trailing space (`"Int "`); the scalar map is keyed by the trimmed name.
fn dr_copy_field(c: &DC, a: &Expr) -> Int ! alloc
    if c.scalars.len() == 0
        0
    else
        match a
            XField(base, field) => dr_copy_field_base(c, &base, &field)
            _ => 0

fn dr_copy_field_base(c: &DC, base: &Expr, field: &String) -> Int ! alloc
    match base
        XIdent(name) => dr_copy_param_field(c, &name, field)
        _ => 0

fn dr_copy_param_field(c: &DC, name: &String, field: &String) -> Int ! alloc
    ty = dr_param_ty(&c.ps, name, 0, c.ps.len())
    if ty.len() == 0
        0
    else
        key = (trim_spaces(ty) + "." + field).dup()
        dr_copy_scan(&c.scalars, &c.copy_ok, &key, 0, c.scalars.len())

fn dr_copy_scan(keys: &List[String], oks: &List[Int], key: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif keys.get(i).eq(key) == 1
        oks.get(i)
    else
        dr_copy_scan(keys, oks, key, i + 1, n)

fn dr_param_ty(ps: &List[TParam], name: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    elsif ps.get(i).name.eq(name) == 1
        ps.get(i).ty.clone()
    else
        dr_param_ty(ps, name, i + 1, n)

fn dr_field_root(e: &Expr) -> String ! alloc
    match e
        XField(base, field) => dr_field_root(&base)
        XIdent(name) => name.dup()
        _ => ""

fn dr_arg_ident(c: &mut DC, n: &String, mov: Int) -> Int ! alloc
    if mov != 1
        dr_arg_escape(c, n, mov)
    else
        0

fn dr_arg_escape(c: &mut DC, name: &String, mov: Int) -> Int ! alloc
    if mov == 4
        # `str_as_int(&s)` stores the handle: `s` escapes and is never released, no flag
        # (the bootstrap's `escaped` rule for `str_as_int`).
        c.take(name)
        nm_put(&mut c.soft, name, 0)
        dr_escape(c, name)
    elsif dr_cell(c, 4) > 0
        c.take(name)
        nm_put(&mut c.soft, name, 0)
        dr_escape(c, name)
    elsif dr_cell(c, 1) == 0
        if dr_tail_moves(c, name) == 1
            # A plain call tail is a statement of its own for the moves it makes.
            c.take(name)
            dr_soft(c, dr_cell(c, 5), name)
            if mov == 3
                nm_put(&mut c.box_shell, name, 1)
            else
                0
        else
            c.take(name)
            _t = dr_tail_site(c, name)
            dr_escape(c, name)
    elsif nm_get(&c.born, name) == dr_cell(c, 3) + 1
        c.take(name)
        dr_soft(c, dr_cell(c, 1), name)
        if mov == 3
            nm_put(&mut c.box_shell, name, 1)
        else
            0
    else
        c.take(name)
        dr_escape(c, name)

# The walk is in a call tail (cell 7) outside an opaque region, and `name` was bound at this
# loop depth: the tail moves it behind its flag (`is_call_tail` in src/drops.rs).
fn dr_tail_moves(c: &DC, name: &String) -> Int ! alloc
    if dr_cell(c, 7) == 0
        0
    elsif dr_cell(c, 2) != 0
        0
    elsif nm_get(&c.born, name) == dr_cell(c, 3) + 1
        1
    else
        0

# A tail that is a call of a fn (not a struct or variant constructor, whose names start with an
# uppercase letter).
fn dr_is_call_tail(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) =>
            if name.len() == 0
                0
            elsif name.char(0) == 95
                1
            elsif name.char(0) < 97
                0
            elsif name.char(0) > 122
                0
            else
                1
        _ => 0

# An `if` in a position `dr_xform_expr` rewrites: its branches are visited.
fn dr_top(c: &mut DC, e: &Expr, mov: Int) -> Int ! alloc
    if dx_is_if(e) == 1
        dr_walk_if(c, e)
    else
        dr_arg(c, e, mov)

fn dr_walk_if(c: &mut DC, e: &Expr) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_walk_if_parts(c, &cond, &then_b, &else_b, has_else, &elsifs)
        _ => 0

fn dr_walk_if_parts(c: &mut DC, cond: &Expr, then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif]) -> Int ! alloc
    _a = dr_arg(c, cond, 1)
    _b = dr_block(c, then_b)
    _c = dr_if_arms(c, elsifs, 0, list_len(elsifs))
    if has_else == 1
        dr_block(c, else_b)
    else
        0

# Arguments of a call: bare identifiers are only read when the callee borrows them
# (`safe`) or its parameter at that position is read-only (`ro`, 0 when not a user fn).
fn dr_call_args(c: &mut DC, callee: &String, args: &List[Expr], i: Int, n: Int, borrow: Int, ro: Int, hard: Int) -> Int ! alloc
    if i >= n
        0
    else
        reads = dr_ro_at(ro, i)
        # `str_own(&s)` stores the string as a handle the IR reads later: the local escapes
        # (the bootstrap's `escaped` rule for `str_as_int`), so nothing releases it here.
        # `enum_set(e, i, v)`: borrow the box and the index; move `v` into the slot.
        mov = if str_eq(callee, "enum_set") == 1
            if i == 2
                2
            else
                1
        elsif str_eq(callee, "str_as_int") == 1
            4
        elsif dr_reads_key_arg(callee, i) == 1
            # `dict_put(d, k, v)` reads the key: the dict stores its own copy.
            1
        elsif borrow == 1
            1
        elsif reads == 1
            1
        elsif hard == 1
            2
        elsif dr_transfers_box(c, callee) == 1
            2
        else
            3
        _a = dr_arg(c, &list_get(args, i), mov)
        dr_call_args(c, callee, args, i + 1, n, borrow, ro, hard)

fn dr_ro_at(ro: Int, i: Int) -> Int ! alloc
    if ro == 0
        0
    elsif i < vec_len(ro)
        vec_get(ro, i)
    else
        0

fn dr_pattern(c: &mut DC, p: &TPat) -> Int ! alloc
    if p.kind == 1
        dr_bind(c, &p.name)
    elsif p.kind == 3
        dr_patterns(c, &p.args, 0, list_len(&p.args))
    else
        0

fn dr_patterns(c: &mut DC, ps: &List[TPat], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dr_pattern(c, &list_get(ps, i))
        dr_patterns(c, ps, i + 1, n)

# Unknown variants stay conservative (owned).
fn dr_field_flag(rec: Int, i: Int) -> Int ! alloc
    if rec == 0
        1
    elsif i < vec_len(vec_get(rec, 1))
        vec_get(vec_get(rec, 1), i)
    else
        1

# Names bound by the variant patterns of `arms` over fields that may own memory, comma terminated.
fn dr_arms_bound(c: &DC, arms: &List[TArm], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        dr_arms_bound(c, arms, i + 1, n, dr_pat_bound(c, &list_get(arms, i).pat, acc))

fn dr_pat_bound(c: &DC, pat: &TPat, acc: String) -> String ! alloc
    if pat.kind == 3
        rec = map_get(c.variants, str_own(&pat.name))
        dr_pat_bound_go(c, rec, &pat.args, 0, list_len(&pat.args), acc)
    else
        acc

fn dr_pat_bound_go(c: &DC, rec: Int, args: &List[TPat], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        sub = list_get(args, i)
        if sub.kind == 1
            if dr_field_flag(rec, i) == 1
                dr_pat_bound_go(c, rec, args, i + 1, n, (acc + sub.name + ","))
            else
                dr_pat_bound_go(c, rec, args, i + 1, n, acc)
        else
            dr_pat_bound_go(c, rec, args, i + 1, n, dr_pat_bound(c, &sub, acc))

# A payload bound by a pattern aliases a field of the box; if that name escapes, the
# scrutinee's box can no longer be freed. Repeats until nothing changes.
fn dr_propagate(c: &mut DC) -> Int ! alloc
    ch = dr_propagate_once(c, 0, list_len(&c.m_scrut), 0)
    if ch > 0
        dr_propagate(c)
    else
        0

fn dr_propagate_once(c: &mut DC, i: Int, n: Int, changed: Int) -> Int ! alloc
    if i >= n
        changed
    else
        scrut = c.m_scrut.get(i)
        if nm_get(&c.esc, &scrut) == 0
            if dr_any_escaped(c, &c.m_bound.get(i), 0, 0) == 1
                c.take(&scrut)
                dr_escape(c, &scrut)
                dr_propagate_once(c, i + 1, n, changed + 1)
            else
                dr_propagate_once(c, i + 1, n, changed)
        else
            dr_propagate_once(c, i + 1, n, changed)

# Whether some name of the comma-terminated list `s` escapes.
fn dr_any_escaped(c: &DC, s: &String, from: Int, i: Int) -> Int ! alloc
    if i >= str_len(s)
        0
    elsif str_char(s, i) == 44
        if dr_escapes(c, &str_slice(s, from, i)) == 1
            1
        else
            dr_any_escaped(c, s, i + 1, i + 1)
    else
        dr_any_escaped(c, s, from, i + 1)

fn dr_binds_whole(c: &DC, arms: &List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        pat = list_get(arms, i).pat
        if pat.kind == 1
            if map_get(c.variants, str_own(&pat.name)) == 0
                1
            else
                dr_binds_whole(c, arms, i + 1, n)
        else
            dr_binds_whole(c, arms, i + 1, n)

fn dr_match_arms(c: &mut DC, arms: &List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = dr_pattern(c, &arm.pat)
        if arm.has_suite == 1
            _b = dr_block(c, &arm.suite)
        else
            _b = dr_expr(c, &arm.body)
        dr_match_arms(c, arms, i + 1, n)

fn dr_if_arms(c: &mut DC, arms: &List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = dr_arg(c, &arm.cond, 1)
        _b = dr_block(c, &arm.body)
        dr_if_arms(c, arms, i + 1, n)

fn dr_ident_out(c: &mut DC, name: &String) -> Int ! alloc
    c.take(name)
    dr_escape(c, name)

fn dr_expr(c: &mut DC, e: &Expr) -> Int ! alloc
    match e
        XIdent(n) => dr_ident_out(c, &n)
        XCall(name, args, targs, xp) => dr_call(c, &name, &args)
        XLambda(param, body) => dr_lambda(c, &param, &body)
        XBin(op, l, r) => dr_binary(c, &l, &r)
        XUnary(op, inner) => dr_arg(c, &inner, 1)
        XOn(place, body, kern, idx) => dr_on(c, &body)
        XTo(place, inner) => dr_arg(c, &inner, 3)
        XField(base, field) => dr_arg(c, &base, 1)
        XMatch(scrut, arms) => dr_match(c, &scrut, &arms)
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_if_nested(c, e)
        XWhile(cond, body) => dr_while(c, &cond, &body)
        XTry(inner) => dr_arg(c, &inner, 3)
        _ => 0

fn dr_call(c: &mut DC, name: &String, args: &List[Expr]) -> Int ! alloc
    hard = dr_flat_rec(c, name)
    if hard != 0
        _h = dr_set(c, 4, dr_cell(c, 4) + 1)
    else
        _z = 0
    ro = map_get(c.ro, str_own(name))
    hflag = if hard != 0
        1
    else
        0
    _a = dr_call_args(c, name, args, 0, list_len(args), dr_borrows(name), ro, hflag)
    if hard != 0
        dr_set(c, 4, dr_cell(c, 4) - 1)
    else
        0

fn dr_lambda(c: &mut DC, param: &String, body: &Expr) -> Int ! alloc
    _b = dr_bind(c, param)
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_expr(c, body)
    dr_set(c, 2, dr_cell(c, 2) - 1)

fn dr_binary(c: &mut DC, l: &Expr, r: &Expr) -> Int ! alloc
    _l = dr_arg(c, l, 1)
    dr_arg(c, r, 1)

fn dr_on(c: &mut DC, body: &TBlock) -> Int ! alloc
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_block(c, body)
    dr_set(c, 2, dr_cell(c, 2) - 1)

fn dr_if_nested(c: &mut DC, e: &Expr) -> Int ! alloc
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_walk_if(c, e)
    dr_set(c, 2, dr_cell(c, 2) - 1)

fn dr_while(c: &mut DC, cond: &Expr, body: &TBlock) -> Int ! alloc
    outer = dr_cell(c, 1)
    _n = dr_set(c, 1, 0)
    _a = dr_arg(c, cond, 1)
    _d = dr_set(c, 3, dr_cell(c, 3) + 1)
    _b = dr_block(c, body)
    _u = dr_set(c, 3, dr_cell(c, 3) - 1)
    dr_set(c, 1, outer)

fn dr_match(c: &mut DC, scrut: &Expr, arms: &List[TArm]) -> Int ! alloc
    # Variant patterns only read the box; a bare binding aliases the whole value.
    if dx_is_ident(scrut) == 1
        _a = list_push(&mut c.m_scrut, strdup(dx_ident(scrut)))
        h996_3 = dr_arms_bound(c, arms, 0, list_len(arms), "")
        _b = list_push(&mut c.m_bound, h996_3)
        0
    else
        0
    if dr_binds_whole(c, arms, 0, list_len(arms)) == 1
        _s = dr_arg(c, scrut, 3)
        0
    else
        _s = dr_arg(c, scrut, 1)
        0
    _o = dr_set(c, 2, dr_cell(c, 2) + 1)
    _x = dr_match_arms(c, arms, 0, list_len(arms))
    dr_set(c, 2, dr_cell(c, 2) - 1)

# `list_push`, `list_set` and `dict_put` return an alias of their container.
fn dr_is_alias_call(name: &String) -> Int ! alloc
    if str_eq(name, "list_push") == 1
        1
    elsif str_eq(name, "list_set") == 1
        1
    elsif str_eq(name, "dict_put") == 1
        1
    else
        0

fn dr_taint_unless_flat(c: &mut DC, name: &String, v: &Expr) -> Int ! alloc
    if dx_is_fresh_flat_ctor(c, v) == 1
        0
    elsif dx_is_fresh_variant(c, v) == 1
        0
    elsif dx_is_desc_copy(v) == 1
        0
    else
        nm_put(&mut c.tainted, name, 1)

# `desc_copy` builds a value the destination owns.
fn dx_is_desc_copy(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => str_eq(name, "desc_copy")
        _ => 0

# A variant constructor call `V(..)` builds a new box, and a unit variant `V` is a tag: both
# are fresh values for a list to own (see `is_fresh_variant_ctor` in src/drops.rs).
fn dx_is_fresh_variant(c: &DC, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dr_variant_has_fields(c, &name)
        XIdent(name) => dx_unit_variant(c, &name)
        _ => 0

fn dx_unit_variant(c: &DC, name: &String) -> Int ! alloc
    rec = map_get(c.variants, str_own(name))
    if rec == 0
        0
    elsif vec_get(rec, 0) == 2
        1
    else
        0

# `list_new[E]()` of an enum type: the list owns the boxes stored in it.
fn dx_list_enum(c: &DC, targs: &String) -> Int ! alloc
    t = trim_spaces(targs.dup())
    if str_len(t) == 0
        0
    elsif map_get(c.variants, str_own(&("enum:" + t))) != 0
        1
    else
        0

# `list_get(xs, i)` of an enum list bound to a local: a deep copy of the box, fresh whoever
# owns `xs` (kind 5, `enum_free`).
# `list_get(xs, i)` and `list_pop(xs)` of an owned list bound to a local: a fresh value of the
# list's element kind (5 `enum_free` for an enum box, 1 `free` for a string); 0 otherwise.
fn dx_elem_release(c: &DC, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dx_elem_release_call(c, &name, &args)
        _ => 0

fn dx_elem_release_call(c: &DC, name: &String, args: &List[Expr]) -> Int ! alloc
    if str_eq(name, "list_pop") == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(&first) == 0
            0
        elsif nm_get(&c.defs, &dx_ident(&first)) != 1
            0
        else
            nm_get(&c.owned_enums, &dx_ident(&first))

# An enum list the pass releases (kind 6) is built as `list_new_owned[E]()`: the lowering
# stores the element descriptor `E` and the list frees its boxes. Other enum lists keep
# `list_new` (their elements are borrowed). Remembers the owned locals (`dx_list_get_enum`).
fn dr_own_enum_list(c: &mut DC, name: &String, cand: Int, e: Expr) -> Expr ! alloc
    match e
        XCall(fname, args, targs, xp) => dr_own_call(c, name, cand, fname, args, targs, xp)
        _ => e

fn dr_own_call(c: &mut DC, name: &String, cand: Int, fname: String, args: List[Expr], targs: String, xp: Int) -> Expr ! alloc
    if cand != 6
        XCall(fname, args, targs, xp)
    elsif str_eq(&fname, "list_new") == 0
        XCall(fname, args, targs, xp)
    elsif dx_list_enum(c, &targs) == 1
        _n = nm_put(&mut c.owned_enums, name, 5)
        XCall("list_new_owned", args, targs, xp)
    elsif dx_list_flat(c, &targs) == 1
        nm_put(&mut c.owned_enums, name, 8)
        XCall("list_new_owned", args, targs, xp)
    elsif dx_list_string(&targs) == 1
        _s = nm_put(&mut c.owned_enums, name, 1)
        XCall("list_new_owned", args, targs, xp)
    else
        XCall(fname, args, targs, xp)

# `list_new[String]()`: the list owns its strings.
fn dx_list_string(targs: &String) -> Int ! alloc
    str_eq(trim_spaces(targs.dup()), "String")


# `list_push(xs, v)` as a statement (or bound to a `_name`) discards the
# returned alias of `xs`, so `xs` is only borrowed there. Returns 1 when handled.
fn dr_push_stmt(c: &mut DC, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dr_push_call(c, &name, &args)
        _ => 0

fn dr_push_call(c: &mut DC, name: &String, args: &List[Expr]) -> Int ! alloc
    if dr_is_alias_call(name) == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(&first) == 1
            _t = dr_push_taint(c, &dx_ident(&first), args)
            _r = dr_args_from(c, name, args, 1, list_len(args))
            1
        elsif dr_push_stmt(c, &first) == 0
            _a = dr_expr(c, &first)
            _r = dr_args_from(c, name, args, 1, list_len(args))
            1
        else
            _r = dr_args_from(c, name, args, 1, list_len(args))
            1

fn dr_push_taint(c: &mut DC, name: &String, args: &List[Expr]) -> Int ! alloc
    if list_len(args) >= 2
        last = list_get(args, list_len(args) - 1)
        if dx_is_fresh_value(&last) == 1
            0
        elsif dr_owned_param(c, &last) == 1
            0
        else
            dr_taint_unless_flat(c, name, &last)
    else
        0

# A `String`, describable struct or enum parameter. The caller moved or copied it.
fn dr_owned_param(c: &DC, e: &Expr) -> Int ! alloc
    match e
        XIdent(name) =>
            if nm_get(&c.params, &name) == 0
                0
            else
                dr_owned_param_ty(c, &dr_param_ty(&c.ps, &name, 0, c.ps.len()))
        _ => 0

fn dr_owned_param_ty(c: &DC, ty: &String) -> Int ! alloc
    t = trim_spaces(ty.dup())
    if t.eq("String") == 1
        1
    elsif map_get(c.variants, ("struct:" + t).to_int()) != 0
        1
    elsif map_get(c.variants, ("enum:" + t).to_int()) != 0
        1
    else
        0

fn dr_args_from(c: &mut DC, callee: &String, args: &List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        # The key of `dict_put` is only read: the dict stores its own copy.
        mov = if dr_reads_key_arg(callee, i) == 1
            1
        else
            2
        dr_arg(c, &list_get(args, i), mov)
        dr_args_from(c, callee, args, i + 1, n)

# Statements whose escapes a transform step can follow up with a flag clear.
fn dr_stmt(c: &mut DC, st: &TStmt) -> Int ! alloc
    outer = dr_cell(c, 1)
    if dr_cell(c, 2) == 0
        _s = dr_set(c, 1, st.id)
        0
    else
        _s = dr_set(c, 1, 0)
        0
    r = dr_stmt_go(c, st)
    _t = dr_set(c, 1, outer)
    r

fn dr_stmt_go(c: &mut DC, st: &TStmt) -> Int ! alloc
    if st.kind == 1
        dr_stmt_bind(c, st)
    elsif st.kind == 2
        dr_arg(c, &st.expr, 3)
    elsif st.kind == 3
        _a = dr_expr(c, &st.target)
        dr_top(c, &st.expr, 3)
    else
        dr_stmt_expr(c, &st.expr)

fn dr_stmt_expr(c: &mut DC, ex: &Expr) -> Int ! alloc
    if dr_push_stmt(c, ex) == 1
        0
    elsif dx_is_if(ex) == 1
        dr_walk_if(c, ex)
    else
        dr_expr(c, ex)

fn dr_stmt_bind(c: &mut DC, st: &TStmt) -> Int ! alloc
    if st.is_let == 1
        _b = dr_bind(c, &st.name)
        _k = dr_rebind_note(c, &st.name, &st.expr)
        dr_top(c, &st.expr, 3)
    elsif dr_acc(c, &st.name, &st.expr) == 0
        _b = dr_bind(c, &st.name)
        _k = dr_rebind_note(c, &st.name, &st.expr)
        dr_stmt_assign(c, st)
    else
        dr_stmt_assign(c, st)

# Folds the release kind of one more binding of `name` into `rbk`.
fn dr_rebind_note(c: &mut DC, name: &String, e: &Expr) -> Int ! alloc
    k = dr_plain_kind(dr_fresh_kind(c, e))
    old = nm_get(&c.rbk, name)
    if k == 0
        nm_put(&mut c.rbk, name, 99)
    elsif old == 0
        nm_put(&mut c.rbk, name, k)
    elsif old != k
        nm_put(&mut c.rbk, name, 99)
    else
        0

# The release fn of a kind, without the "owns its elements" part: 1 `free`, 2 `list_free`,
# 3 `bytes_free`, 4 `dict_free`; 0 for the kinds a reassignment does not release.
fn dr_plain_kind(k: Int) -> Int
    if k == 6
        2
    elsif k == 7
        4
    elsif k > 4
        0
    else
        k

# Bound more than once, every time to a fresh value of one kind (`rebound_locals` in src/drops.rs).
fn dr_rebound(c: &DC, name: &String) -> Int ! alloc
    if nm_get(&c.defs, name) < 2
        0
    else
        k = nm_get(&c.rbk, name)
        if k == 0
            0
        elsif k == 99
            0
        else
            1

fn dr_stmt_assign(c: &mut DC, st: &TStmt) -> Int ! alloc
    if str_char(st.name, 0) == 95
        if dr_push_stmt(c, &st.expr) == 1
            0
        else
            dr_top(c, &st.expr, 3)
    else
        dr_top(c, &st.expr, 3)

fn dr_stmts(c: &mut DC, stmts: &List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dr_stmt(c, &list_get(stmts, i))
        dr_stmts(c, stmts, i + 1, n)

fn dr_block(c: &mut DC, b: &TBlock) -> Int ! alloc
    _a = dr_stmts(c, &b.stmts, 0, list_len(&b.stmts))
    outer = dr_cell(c, 1)
    _n = dr_set(c, 1, 0)
    tail_outer = dr_cell(c, 5)
    _i = dr_set(c, 5, dr_tail_key(&b.tail))
    call_outer = dr_cell(c, 7)
    _k = dr_set(c, 7, dr_is_call_tail(&b.tail))
    r = dr_top(c, &b.tail, 3)
    _l = dr_set(c, 7, call_outer)
    _j = dr_set(c, 5, tail_outer)
    _t = dr_set(c, 1, outer)
    r

# ---- transform ----
fn dr_candidate(c: &mut DC, name: &String, ty: &String, init: &Expr) -> Int ! alloc
    er = dx_elem_release(c, init)
    sd = if er == 0
        dx_struct_copy(c, init)
    elsif er == 8
        dx_owned_struct_desc(c, init)
    else
        0
    _r = if sd != 0
        nm_put(&mut c.copy_desc, name, sd)
    else
        0
    kind = if er != 0
        er
    elsif sd != 0
        8
    else
        dr_fresh_kind(c, init)
    if kind == 0
        0
    elsif str_len(ty) != 0
        if kind != 1
            0
        elsif ty_is_string(ty) == 0
            0
        else
            dr_candidate_go(c, name, kind)
    else
        dr_candidate_go(c, name, kind)

# SPEC «Memoria»: a value stored in a container was moved into it, so the container owns it.
# The taint of a non-fresh store only held while a store could alias (`facts.moved` in src/drops.rs).
fn dr_candidate_go(c: &DC, name: &String, kind: Int) -> Int ! alloc
    dr_candidate_go2(c, name, kind)

# `list_get(xs, i)` of a list whose element struct a copy can release: the descriptor handle
# (`struct:` release, kind 8), 0 otherwise.
# `list_get` of a struct list the local does not own: a copy (`list_pop` only moves out of owned lists).
fn dx_struct_copy(c: &DC, e: &Expr) -> Int ! alloc
    # `list_get` borrows. A released struct box is `list_pop` (see `dx_owned_struct_desc`) or the
    # fresh box of `x.clone()`.
    match e
        XCall(name, args, targs, xp) => dx_clone_desc(c, &name, &args)
        _ => 0

# `x.clone()` of a describable struct: the descriptor handle of the fresh box, 0 otherwise.
# The pass has no types: it knows the struct of a parameter and of an element of a struct list.
fn dx_clone_desc(c: &DC, name: &String, args: &List[Expr]) -> Int ! alloc
    if name.eq("struct_clone") == 0
        0
    elsif args.len() == 0
        0
    else
        match args.get(0)
            XIdent(p) => dx_param_desc(c, &p, 0, c.ps.len())
            XCall(n2, a2, t2, x2) =>
                if n2.eq("list_get") == 1
                    dx_struct_copy_call(c, &n2, &a2)
                else
                    0
            _ => 0

fn dx_param_desc(c: &DC, name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif c.ps.get(i).name.eq(name) == 0
        dx_param_desc(c, name, i + 1, n)
    else
        map_get(c.variants, str_own(&("desc:" + ty_deref(&c.ps.get(i).ty))))

fn dx_struct_copy_call(c: &DC, name: &String, args: &List[Expr]) -> Int ! alloc
    if name.eq("list_get") + name.eq("list_pop") == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(&first) == 0
            0
        else
            s = nm_get(&c.lists, &dx_ident(&first))
            if s == 0
                0
            else
                map_get(c.variants, str_own(&("desc:" + str_from_int(s))))

# `list_pop` of an owned struct list: the element is a box the local releases
# with `struct_free` under the list's element descriptor. `list_get` only borrows.
fn dx_owned_struct_desc(c: &DC, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) =>
            if str_eq(name, "list_pop") == 0
                0
            else
                dx_struct_copy_call(c, &name, &args)
        _ => 0

# Kinds whose container owns its elements.
fn dr_kind_owned(kind: Int) -> Int ! alloc
    if kind == 6
        1
    elsif kind == 7
        1
    else
        0

fn dr_candidate_go2(c: &DC, name: &String, kind: Int) -> Int ! alloc
    if nm_get(&c.params, name) != 0
        0
    elsif nm_get(&c.defs, name) == 0
        0
    elsif nm_get(&c.defs, name) > 1 && dr_rebound(c, name) == 0
        0
    elsif nm_get(&c.esc, name) != 0
        if nm_get(&c.box_shell, name) != 0
            kind
        else
            0
    else
        kind

fn dr_empty_block() -> TBlock ! alloc
    TBlock(list_new[TStmt](), XNone)

fn dr_plain(e: Expr) -> TStmt ! alloc
    TStmt(0, "", e, "", 0, XNone, 0, 0, 0)

fn dr_free_fn(kind: Int) -> String ! alloc
    if kind == 10
        "tensor_free"
    elsif kind == 9
        "struct_free_box"
    elsif kind == 8
        "struct_free"
    elsif kind == 2
        "list_free"
    elsif kind == 6
        "list_free"
    elsif kind == 7
        "dict_free"
    elsif kind == 3
        "bytes_free"
    elsif kind == 4
        "dict_free"
    elsif kind == 5
        "enum_free"
    else
        "free"

fn dr_free_stmt(c: &DC, name: &String) -> TStmt ! alloc
    args = list_new[Expr]()
    _a = list_push(&mut args, XIdent(strdup(name)))
    k = nm_get(&c.kinds, name)
    if k == 8
        _d = list_push(&mut args, XStr(strdup(str_from_int(nm_get(&c.copy_desc, name)))))
    else
        _e = 0
    dr_plain(XCall(strdup(dr_free_fn(k)), args, "", 0))

# The release of a live local, guarded by its flag when a statement may have moved it.
fn dr_release_stmt(c: &DC, name: &String) -> TStmt ! alloc
    free = dr_free_stmt(c, name)
    if nm_get(&c.soft, name) == 0
        free
    else
        stmts = list_new[TStmt]()
        _a = list_push(&mut stmts, free)
        flag = XIdent("__live_" + name)
        one = XInt(1)
        cond = XBin("eq", flag, one)
        else_b = if nm_get(&c.kinds, name) == 8
            if nm_get(&c.box_shell, name) != 0
                dr_box_shell_else(name)
            else
                dr_empty_block()
        else
            dr_empty_block()
        has_else = if nm_get(&c.kinds, name) == 8
            if nm_get(&c.box_shell, name) != 0
                1
            else
                0
        else
            0
        dr_plain(XIf(cond, TBlock(stmts, XNone), else_b, has_else, list_new[TElsif]()))

fn dr_box_shell_else(name: &String) -> TBlock ! alloc
    stmts = list_new[TStmt]()
    args = list_new[Expr]()
    _a = list_push(&mut args, XIdent(strdup(name)))
    _b = list_push(&mut stmts, dr_plain(XCall("struct_free_box", args, "", 0)))
    TBlock(stmts, XNone)

fn dr_flag_init(name: &String) -> TStmt ! alloc
    TStmt(1, "__live_" + name, XInt(1), "", 1, XNone, 0, 0, 0)

fn dr_flag_clear(name: &String) -> TStmt ! alloc
    TStmt(1, "__live_" + name, XInt(0), "", 0, XNone, 0, 0, 0)

fn dr_in_live(live: &List[String], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(live, i), name) == 1
        1
    else
        dr_in_live(live, name, i + 1, n)

# Clears the flag of every flagged live local the statement `st` moved.
fn dr_clear_moved(c: &DC, st: Int, out: &mut List[TStmt]) -> Int ! alloc
    dr_clear_go(c, st, out, 0, list_len(&c.site_ids))

fn dr_clear_go(c: &DC, st: Int, out: &mut List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(&c.site_ids, i) != st
        dr_clear_go(c, st, out, i + 1, n)
    else
        name = list_get(&c.site_names, i)
        if nm_get(&c.soft, &name) != 0
            if dr_in_live(&c.live, &name, 0, list_len(&c.live)) == 1
                _p = list_push(out, dr_flag_clear(&name))
                dr_clear_go(c, st, out, i + 1, n)
            else
                dr_clear_go(c, st, out, i + 1, n)
        else
            dr_clear_go(c, st, out, i + 1, n)

# Releases live[from..] in reverse order.
fn dr_push_frees(c: &DC, out: &mut List[TStmt], from: Int, i: Int) -> Int ! alloc
    if i < from
        0
    else
        _p = list_push(out, dr_release_stmt(c, &list_get(&c.live, i)))
        dr_push_frees(c, out, from, i - 1)

fn dr_xform_if_arms(c: &mut DC, arms: &mut List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(&mut arms, i)
        arm.body = dr_xform_block(c, &mut arm.body)
        dr_xform_if_arms(c, arms, i + 1, n)

fn dr_xform_expr(c: &mut DC, e: &Expr) -> Expr ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_xform_if(c, e, &mut then_b, &mut else_b, has_else, &mut elsifs)
        XWhile(cond, body) =>
            nb = dr_xform_block(c, &mut body)
            _b = enum_set(e, 1, nb)
            dr_ret(e)
        _ => dr_alias(e)

fn dr_xform_if(c: &mut DC, e: &Expr, then_b: &mut TBlock, else_b: &mut TBlock, has_else: Int, elsifs: &mut List[TElsif]) -> Expr ! alloc
    tb = dr_xform_block(c, then_b)
    _t = enum_set(e, 1, tb)
    if has_else == 1
        eb = dr_xform_block(c, else_b)
        _e = enum_set(e, 2, eb)
    _a = dr_xform_if_arms(c, elsifs, 0, list_len(elsifs))
    dr_ret(e)

# Returns 1 when a `return` ended the statement list.
fn dr_xform_stmts(c: &mut DC, stmts: &mut List[TStmt], i: Int, n: Int, out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        # The list keeps its own statement: mutating the copy would free the `Expr` the
        # element still points at. Take an owned copy before `st.expr = ne`.
        st = tc_stmt(&list_get(&mut stmts, i))
        if st.kind == 2
            _r = dr_xform_return(c, &st, out)
            1
        else
            _s = dr_xform_stmt(c, &mut st, out)
            dr_xform_stmts(c, stmts, i + 1, n, out)

fn dr_xform_stmt(c: &mut DC, st: &mut TStmt, out: &mut List[TStmt]) -> Int ! alloc
    if st.kind == 1
        dr_xform_bind(c, st, out)
    elsif st.kind == 0
        _d = dr_discard(c, &st.expr, out)
        if _d == 0
            ne = dr_xform_expr(c, &st.expr)
            if dr_moved(&st.expr, &ne) == 1
                st.expr = ne
            _p = dr_share_stmt(out, st)
            0
        else
            0
        dr_clear_moved(c, st.id, out)
    else
        ne = dr_xform_expr(c, &st.expr)
        if dr_moved(&st.expr, &ne) == 1
            st.expr = ne
        _p = dr_share_stmt(out, st)
        dr_clear_moved(c, st.id, out)

# A fresh value discarded as a statement is bound to a `__dis` temporary and released there
# (the same rule as the bootstrap's `discard_kind`). Returns 1 when it was handled.
fn dr_discard(c: &mut DC, e: &Expr, out: &mut List[TStmt]) -> Int ! alloc
    k = dr_discard_kind(c, e)
    if k == 0
        0
    else
        sd = if k == 8
            dx_owned_struct_desc(c, e)
        else
            0
        tmp = dr_next_tmp_p(c, &"__dis")
        init = dr_xform_expr(c, e)
        _l = list_push(out, TStmt(1, strdup(tmp), init, "", 1, XNone, 0, 0, 0))
        _f = list_push(out, dr_discard_free(&tmp, k, sd))
        1

fn dr_discard_kind(c: &DC, e: &Expr) -> Int ! alloc
    er = dx_elem_release(c, e)
    if er != 0
        er
    elsif dx_struct_copy(c, e) != 0
        8
    else
        dr_fresh_kind(c, e)

fn dr_discard_free(name: &String, k: Int, sd: Int) -> TStmt ! alloc
    args = list_new[Expr]()
    _a = list_push(&mut args, XIdent(strdup(name)))
    if k == 8
        _d = list_push(&mut args, XStr(strdup(str_from_int(sd))))
    else
        _e = 0
    dr_plain(XCall(strdup(dr_free_fn(k)), args, "", 0))

fn dr_xform_bind(c: &mut DC, st: &mut TStmt, out: &mut List[TStmt]) -> Int ! alloc
    cand = dr_bind_candidate(c, st)
    if dr_rebinds(c, &st.name, cand) == 1
        dr_rebind(c, st, out)
    else
        dr_xform_bind_new(c, st, cand, out)

# The binding replaces a live owned value of a rebound local.
fn dr_rebinds(c: &DC, name: &String, cand: Int) -> Int ! alloc
    if cand == 0
        0
    elsif dr_rebound(c, name) == 0
        0
    else
        dr_in_live(&c.live, name, 0, c.live.len())

# `name = value` over a live owned local: the new value is computed first (it may read the old
# one), then the old value is released, then the name takes the new one (`rebind` in src/drops.rs).
fn dr_rebind(c: &mut DC, st: &TStmt, out: &mut List[TStmt]) -> Int ! alloc
    tmp = dr_next_tmp_p(c, &"__new")
    init = dr_xform_expr(c, &st.expr)
    _l = out.push(TStmt(1, tmp.dup(), init, "", 1, XNone, 0, 0, 0))
    _m = dr_clear_moved(c, st.id, out)
    if nm_get(&c.esc, &st.name) == 0
        _r = out.push(dr_release_stmt(c, &st.name))
    _a = out.push(TStmt(1, st.name.dup(), XIdent(tmp.dup()), "", 0, XNone, 0, 0, 0))
    if nm_get(&c.soft, &st.name) != 0
        _f = out.push(TStmt(1, "__live_" + st.name, XInt(1), "", 0, XNone, 0, 0, 0))
    0

fn dr_xform_bind_new(c: &mut DC, st: &mut TStmt, cand: Int, out: &mut List[TStmt]) -> Int ! alloc
    init = dr_own_enum_list(c, &st.name, cand, st.expr.clone())
    ne = dr_xform_expr(c, &init)
    if dr_moved(&st.expr, &ne) == 1
        st.expr = ne
    _p = dr_share_stmt(out, st)
    _m = dr_clear_moved(c, st.id, out)
    if cand != 0
        _k = nm_put(&mut c.kinds, &st.name, cand)
        if nm_get(&c.soft, &st.name) != 0
            _fi = list_push(out, dr_flag_init(&st.name))
            _lv = list_push(&mut c.live, strdup(st.name))
            0
        else
            _lv = list_push(&mut c.live, strdup(st.name))
            0
    else
        0

fn dr_bind_candidate(c: &mut DC, st: &TStmt) -> Int ! alloc
    if st.is_let == 1
        dr_candidate(c, &st.name, &st.ty, &st.expr)
    elsif dr_acc(c, &st.name, &st.expr) == 0
        dr_candidate(c, &st.name, &"", &st.expr)
    else
        0

fn dr_xform_return(c: &mut DC, st: &TStmt, out: &mut List[TStmt]) -> Int ! alloc
    if list_len(&c.live) == 0
        _p = list_push(out, tc_stmt(st))
        0
    else
        rv = dr_return_value(c, st.expr.clone(), out)
        _m = dr_clear_moved(c, st.id, out)
        _f = dr_push_frees(c, out, 0, list_len(&c.live) - 1)
        _r = list_push(out, TStmt(2, "", rv, "", 0, XNone, 0, 0, 0))
        0

# Binds a returned value ahead of the releases; the expression to return.
fn dr_return_value(c: &mut DC, v: Expr, out: &mut List[TStmt]) -> Expr ! alloc
    match v
        XNone => XNone
        _ => dr_return_tmp(c, v, out)

fn dr_return_tmp(c: &mut DC, v: Expr, out: &mut List[TStmt]) -> Expr ! alloc
    tmp = dr_next_tmp(c)
    _l = list_push(out, TStmt(1, strdup(tmp), v, "", 1, XNone, 0, 0, 0))
    XIdent(tmp)

fn dr_xform_block(c: &mut DC, b: &mut TBlock) -> TBlock ! alloc
    mark = list_len(&c.live)
    out = list_new[TStmt]()
    _sd = dr_seed_live_params(c, &mut out)
    n_stmts = list_len(&b.stmts)
    diverged = dr_xform_stmts(c, &mut b.stmts, 0, n_stmts, &mut out)
    # Statements after a `return` stay as they were.
    if diverged == 1
        _rest = dr_copy_after_return(&b.stmts, &mut out, 0, list_len(&b.stmts))
        _t = dr_truncate(c, mark)
        tail = dr_xform_expr(c, &b.tail)
        _f = dr_free_stmts(&b.stmts)
        TBlock(out, tail)
    else
        _m = dr_clear_tail_moved(c, b, &mut out)
        tail = dr_xform_expr(c, &b.tail)
        _f = dr_free_stmts(&b.stmts)
        if list_len(&c.live) > mark
            t2 = dr_finish_block(c, &mut out, tail, mark)
            _t = dr_truncate(c, mark)
            TBlock(out, t2)
        else
            _t = dr_truncate(c, mark)
            TBlock(out, tail)

# The first block of a fn releases its by-value `String`, `List`, `Dict` and enum parameters at
# scope end unless it moved them; a parameter moved on some path sits behind its flag, set on
# entry (`owned_param_release` in src/drops.rs).
fn dr_seed_live_params(c: &mut DC, out: &mut List[TStmt]) -> Int ! alloc
    if dr_cell(c, 6) == 0
        0
    else
        _z = dr_set(c, 6, 0)
        dr_seed_param_go(c, out, 0, c.ps.len())

fn dr_seed_param_go(c: &mut DC, out: &mut List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        p = c.ps.get(i)
        _a = dr_seed_one_param(c, out, &p.name, &p.ty)
        dr_seed_param_go(c, out, i + 1, n)

fn dr_seed_one_param(c: &mut DC, out: &mut List[TStmt], name: &String, ty: &String) -> Int ! alloc
    k = dr_param_kind(c, ty)
    if k == 0
        0
    elsif nm_get(&c.defs, name) != 1
        0
    elsif nm_get(&c.esc, name) != 0 && nm_get(&c.soft, name) == 0 && nm_get(&c.box_shell, name) == 0
        0
    else
        _k = nm_put(&mut c.kinds, name, k)
        if nm_get(&c.soft, name) != 0
            _f = list_push(out, dr_flag_init(name))
        else
            _f = list_len(out)
        _l = list_push(&mut c.live, strdup(name))
        0

# The release of a by-value parameter of this type. Enum parameters are not released by the
# callee yet (subplan 07): the selfhost still passes aliases of an `Expr` to by-value
# parameters, which the callee would free.
fn dr_param_kind(c: &DC, ty: &String) -> Int ! alloc
    if dr_param_is_ref(ty) == 1
        0
    elsif ty_is_string(ty) == 1
        1
    else
        open = ty_find_open(ty, 0)
        if open < 0
            0
        else
            dr_param_generic_kind(trim_spaces(ty.slice(0, open)))

fn dr_param_generic_kind(head: String) -> Int ! alloc
    if head.eq("List") == 1
        2
    elsif head.eq("Dict") == 1
        4
    else
        0

# A tail with a box (not a unit tag, whose id is 0) clears the flags of the locals it moves.
# The key that identifies a block tail between the facts walk and the transform. The transform
# works on a copy of each statement (`tc_stmt`), so an `if` statement's branch tails are new
# boxes there: a call tail is keyed by its source position, which the copy keeps (negative and
# far from the statement ids, which are small). Any other tail keeps its box id (0 for a unit tag).
fn dr_tail_key(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) =>
            if xp > 0
                0 - 1000000000 - xp
            else
                enum_box_id(e)
        _ => enum_box_id(e)

fn dr_clear_tail_moved(c: &DC, b: &TBlock, out: &mut List[TStmt]) -> Int ! alloc
    t = dr_tail_key(&b.tail)
    if t == 0
        0
    else
        dr_clear_moved(c, t, out)

# Appends the releases of this block's own locals; returns the new tail.
fn dr_finish_block(c: &mut DC, out: &mut List[TStmt], tail: Expr, mark: Int) -> Expr ! alloc
    last = list_len(&c.live) - 1
    if dx_is_none(&tail) == 1
        _f = dr_push_frees(c, out, mark, last)
        XNone
    elsif dx_is_while(&tail) == 1
        _w = list_push(out, dr_plain(tail))
        _f = dr_push_frees(c, out, mark, last)
        XNone
    else
        tmp = dr_next_tmp(c)
        _l = list_push(out, TStmt(1, strdup(tmp), tail, "", 1, XNone, 0, 0, 0))
        _f = dr_push_frees(c, out, mark, last)
        XIdent(tmp)

# Copies the statements after the first `return` verbatim.
fn dr_copy_after_return(stmts: &List[TStmt], out: &mut List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(stmts, i).kind == 2
        dr_copy_rest(stmts, out, i + 1, n)
    else
        dr_copy_after_return(stmts, out, i + 1, n)

fn dr_copy_rest(stmts: &List[TStmt], out: &mut List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = dr_share_stmt(out, &list_get(stmts, i))
        dr_copy_rest(stmts, out, i + 1, n)

fn dr_seed_params(c: &mut DC, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = c.ps.get(i).name
        _a = dr_bind(c, &nm)
        _b = nm_put(&mut c.params, &nm, 1)
        dr_seed_params(c, i + 1, n)

# Escape facts of a fn body under the read-only assumptions `ro`.
fn dr_facts(params: &List[TParam], body: &TBlock, variants: Int, ro: Int, lists: NM, scalars: List[String], copy_ok: List[Int]) -> DC ! alloc
    c = dr_new(variants, ro, lists, params, scalars, copy_ok)
    n = c.ps.len()
    _s = dr_seed_params(&mut c, 0, n)
    _w = dr_block(&mut c, body)
    _t = c.take_tail(&body.tail)
    _p = dr_propagate(&mut c)
    c

# `[read-only, consumed]`. Read-only is 1 when the fn only reads that parameter.
# Consumed is 1 when the fn takes the parameter's data. A Copy field clears read-only
# (the fn must not release the struct) without setting consumed. Optimistic fixpoint, as `drops.rs`.
fn dr_read_only_t(tp: &TProgram, variants: Int, cons: &List[Int]) -> Int ! alloc
    ro = map_new()
    _i = dr_ro_init(ro, &tp.fns, 0, tp.fns.len())
    scalars = list_new[String]()
    oks = list_new[Int]()
    _s = dr_scalar_structs(&mut scalars, &mut oks, &tp.structs, 0, tp.structs.len())
    _l = dr_ro_loop(ro, cons, &tp.fns, variants, &scalars, &oks)
    _f = list_free(scalars)
    _o = list_free(oks)
    ro

fn dr_scalar_structs(m: &mut List[String], oks: &mut List[Int], structs: &List[TStruct], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        s = structs.get(i)
        _f = dr_scalar_sfields(m, oks, &s.name, &s.fields, 0, s.fields.len())
        dr_scalar_structs(m, oks, structs, i + 1, n)

# Copy fields, as `Type.field`. The key stays in the list: a map would keep a pointer the drop
# pass can free.
fn dr_scalar_sfields(m: &mut List[String], oks: &mut List[Int], sname: &String, fields: &List[TField], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = fields.get(i)
        ty = f.ty.clone()
        # The flag is part of the key. Gating the push on it dropped the entry in stage1;
        # storing the flag and looking up the `1:` key does not.
        ok = if str_len(ty) == 3
            if str_char(ty, 0) == 73
                if str_char(ty, 2) == 116
                    1
                else
                    0
            else
                0
        elsif str_len(ty) == 4
            if str_char(ty, 0) == 73
                if str_char(ty, 3) == 32
                    1
                else
                    0
            else
                0
        else
            dr_ty_scalar(&ty)
        key = (trim_spaces(sname.dup()) + "." + f.name).dup()
        _p = m.push(key)
        _q = oks.push(ok)
        dr_scalar_sfields(m, oks, sname, fields, i + 1, n)

# Type texts are the word or the word plus one trailing space (`"Int"` / `"Int "`).
fn dr_ty_scalar(ty: &String) -> Int ! alloc
    n = str_len(ty)
    if n == 4
        if str_char(ty, 0) == 73
            if str_char(ty, 1) == 110
                if str_char(ty, 2) == 116
                    if str_char(ty, 3) == 32
                        1
                    else
                        0
                else
                    0
            else
                0
        elsif str_char(ty, 0) == 66
            if str_char(ty, 1) == 111
                if str_char(ty, 2) == 111
                    if str_char(ty, 3) == 108
                        1
                    else
                        0
                else
                    0
            else
                0
        else
            0
    elsif n == 3
        if str_char(ty, 0) == 73
            if str_char(ty, 1) == 110
                if str_char(ty, 2) == 116
                    1
                else
                    0
            else
                0
        else
            0
    elsif n == 5
        dr_ty_scalar5(ty)
    elsif n == 6
        dr_ty_scalar6(ty)
    else
        0

# `"Bool "` or `"Float"`.
fn dr_ty_scalar5(ty: &String) -> Int ! alloc
    if str_char(ty, 0) == 66
        if str_char(ty, 4) == 32
            1
        else
            0
    elsif str_char(ty, 0) == 70
        1
    else
        0

# `"Float "`.
fn dr_ty_scalar6(ty: &String) -> Int ! alloc
    if str_char(ty, 0) == 70
        if str_char(ty, 5) == 32
            1
        else
            0
    else
        0

# One consumed-flag vec per fn, in source order. Indexed, not keyed by name: a string map
# kept a single slot when the key text was overwritten, so every fn shared one flag.
fn dr_took_map(m: Int, fns: &List[TFn], cons: &List[Int], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = map_put(m, str_own(&list_get(fns, i).name.dup()), list_get(cons, i))
        dr_took_map(m, fns, cons, i + 1, n)

fn dr_cons_list(fns: &List[TFn]) -> List[Int] ! alloc
    dr_cons_fill(list_new[Int](), fns, 0, fns.len())

fn dr_cons_fill(out: List[Int], fns: &List[TFn], i: Int, n: Int) -> List[Int] ! alloc
    if i >= n
        out
    else
        took = vec_new()
        _z = dr_ro_zeros(took, fns.get(i).params.len())
        _p = out.push(took)
        dr_cons_fill(out, fns, i + 1, n)

fn dr_ro_init(ro: Int, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = fns.get(i)
        flags = vec_new()
        _o = dr_ro_ref_flags(flags, &f.params, 0, f.params.len())
        nk = f.name.dup()
        map_put(ro, nk.to_int(), flags)
        dr_ro_init(ro, fns, i + 1, n)

# A by-value parameter is owned by the fn (SPEC «Memoria»): the caller gave it up, so it is
# never read-only. Only `&T` leaves the caller the release.
fn dr_ro_ref_flags(flags: Int, ps: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(flags, dr_param_caller_keeps(&ps.get(i).ty))
        dr_ro_ref_flags(flags, ps, i + 1, n)

# 1 when the caller keeps the release: a reference, or a type the callee does not release.
fn dr_param_caller_keeps(ty: &String) -> Int ! alloc
    if dr_param_is_ref(ty) == 1
        1
    elsif ty_is_string(ty) == 1
        0
    else
        open = ty_find_open(ty, 0)
        if open < 0
            1
        elsif dr_param_generic_kind(trim_spaces(ty.slice(0, open))) == 0
            1
        else
            0

fn dr_param_is_ref(ty: &String) -> Int ! alloc
    if ty.len() == 0
        1
    elsif ty.char(0) == 38
        1
    else
        0

fn dr_ro_zeros(flags: Int, n: Int) -> Int ! alloc
    if n == 0
        0
    else
        vec_push(flags, 0)
        dr_ro_zeros(flags, n - 1)

fn dr_ro_ones(flags: Int, n: Int) -> Int ! alloc
    if n == 0
        0
    else
        _a = vec_push(flags, 1)
        dr_ro_ones(flags, n - 1)

fn dr_oks_dup(src: &List[Int], i: Int, n: Int, dst: List[Int]) -> List[Int] ! alloc
    if i >= n
        dst
    else
        _p = dst.push(src.get(i))
        dr_oks_dup(src, i + 1, n, dst)

fn dr_list_dup(src: &List[String], i: Int, n: Int, dst: List[String]) -> List[String] ! alloc
    if i >= n
        dst
    else
        _p = dst.push(src.get(i).dup())
        dr_list_dup(src, i + 1, n, dst)

fn dr_ro_loop(ro: Int, cons: &List[Int], fns: &List[TFn], variants: Int, scalars: &List[String], oks: &List[Int]) -> Int ! alloc
    if dr_ro_pass(ro, cons, fns, variants, scalars, oks, 0, fns.len(), 0) == 1
        dr_ro_loop(ro, cons, fns, variants, scalars, oks)
    else
        0

# One sweep; returns 1 when some parameter lost its read-only flag or became consumed.
fn dr_ro_pass(ro: Int, cons: &List[Int], fns: &List[TFn], variants: Int, scalars: &List[String], oks: &List[Int], i: Int, n: Int, changed: Int) -> Int ! alloc
    if i >= n
        changed
    else
        f = fns.get(i)
        name = f.name.dup()
        mine = dr_list_dup(scalars, 0, scalars.len(), list_new[String]())
        mine_ok = dr_oks_dup(oks, 0, oks.len(), list_new[Int]())
        c = dr_facts(&f.params, &f.body, variants, ro, nm_new(), mine, mine_ok)
        key = name.to_int()
        flags = map_get(ro, key)
        took = cons.get(i)
        nps = c.ps.len()
        ch = dr_ro_params(&c, flags, &c.ps, 0, nps)
        tk = dr_cons_params(&c, took, &c.ps, 0, nps)
        _pp = dr_pin_params(&c.ps)
        any = if ch + tk > 0
            1
        else
            changed
        dr_ro_pass(ro, cons, fns, variants, scalars, oks, i + 1, n, any)

fn dr_ro_params(c: &DC, flags: Int, params: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ch = if vec_get(flags, i) == 1
            if dr_escapes(c, &list_get(params, i).name) == 1
                _s = vec_set(flags, i, 0)
                1
            else
                0
        else
            0
        rest = dr_ro_params(c, flags, params, i + 1, n)
        if ch == 1
            1
        else
            rest

# Sets a consumed flag the first time the parameter is in `c.took`. Returns 1 when one changed.
fn dr_cons_params(c: &DC, flags: Int, params: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ch = if vec_get(flags, i) == 1
            0
        elsif nm_get(&c.took, &params.get(i).name) == 1
            vec_set(flags, i, 1)
            1
        else
            0
        rest = dr_cons_params(c, flags, params, i + 1, n)
        if ch == 1
            1
        else
            rest

# The same box, handed back. A block tail that is the ident moves it for every later
# `match` arm; a borrow call does not, and the caller keeps the box.
# The same pointer, as an owned `Expr`. `*e` would move a non-Copy out of the reference.
# An owned copy of `e` (SPEC «Memoria»: an explicit `clone`). The list that used to carry an
# alias released the caller's expression with itself.
fn dr_alias(e: &Expr) -> Expr ! alloc
    tc_expr(e)

fn dr_ret(e: &Expr) -> Expr ! alloc
    dr_alias(e)

# 1 when `neu` is a different box. Two unit tags both report id 0.
fn dr_moved(old: &Expr, neu: &Expr) -> Int ! alloc
    ob = enum_box_id(old)
    nb = enum_box_id(neu)
    if ob == nb
        0
    else
        1

# A changed child is written into the box that already exists. The string stays put.
fn dr_set_expr(e: &Expr, i: Int, old: &Expr, neu: &Expr) -> Int ! alloc
    if dr_moved(old, neu) == 0
        0
    else
        enum_set(e, i, neu)

fn dr_set_arg(args: &mut List[Expr], i: Int, old: &Expr, neu: Expr) -> Int ! alloc
    if dr_moved(old, &neu) == 0
        0
    else
        _s = list_set(args, i, neu)
        0

# An owned copy of the statement (`clone`): the block it came from is borrowed and keeps its own.
fn dr_share_stmt(out: &mut List[TStmt], st: &TStmt) -> Int ! alloc
    _p = list_push(out, tc_stmt(st))
    0

# The block is borrowed: its owner releases it. Nothing to release here.
fn dr_free_stmts(xs: &List[TStmt]) -> Int ! alloc
    0

# Taking the field marks it moved, so the struct glue leaves it alone. The list vector
# was already released with `list_free_shell`; the expression is still in the returned block.
fn dr_pin_list(xs: &List[TStmt]) -> Int ! alloc
    0

fn dr_pin_expr(e: &Expr) -> Int ! alloc
    0

# `DC.ps` is the caller's parameter list, not a fresh one. Taking it here keeps the
# scope-end glue from `list_free`ing the `TFn` that still owns it.
fn dr_pin_params(xs: &List[TParam]) -> Int ! alloc
    0

# ---- temporaries ----
# A fresh string passed to a builtin that only reads it is bound to a local ahead of the
# statement, so the scope-end release frees it. `h` holds the counter.
# The hoisting state: `k` the temporary counter, `lists` the struct of each local list (`dr_lists_of`).
struct HC
    k: List[Int]
    lists: NM
    vm: Int

fn dr_hoist_args(h: &mut HC, args: &mut List[Expr], i: Int, n: Int, callee: &String, out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        old = list_get(args, i)
        a = dr_hoist_expr(h, &old, out)
        if dr_reads_string_arg(callee) + dr_reads_key_arg(callee, i) > 0
            if dx_is_fresh_temp_v(h.vm, &a) == 1
                k = list_get(&h.k, 0) + 1
                _s = list_set(h.k, 0, k)
                name = "__tmp" + int_to_str(k)
                _l = list_push(out, TStmt(1, strdup(name), a, "", 1, XNone, 0, 0, 0 - k))
                _r = list_set(args, i, XIdent(strdup(name)))
                dr_hoist_args(h, args, i + 1, n, callee, out)
            else
                _r = dr_set_arg(args, i, &old, a)
                dr_hoist_args(h, args, i + 1, n, callee, out)
        else
            _r = dr_set_arg(args, i, &old, a)
            dr_hoist_args(h, args, i + 1, n, callee, out)

fn dr_hoist_arms(h: &mut HC, arms: &mut List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(&mut arms, i)
        arm.body = dr_hoist_block(h, &mut arm.body)
        dr_hoist_arms(h, arms, i + 1, n)

# A place: local, field of a place, or deref of a place (`is_place` in src/drops.rs).
fn dr_is_place(e: &Expr) -> Int ! alloc
    match e
        XIdent(n) => 1
        XField(base, field) => dr_is_place(&base)
        XUnary(op, inner) =>
            if str_eq(op, "deref") == 1
                dr_is_place(&inner)
            else
                0
        _ => 0

# `&g()` / `&mut g()`: bind the non-place rvalue so scope-end / struct glue frees it (Rust).
fn dr_hoist_unary(h: &mut HC, e: &Expr, op: &String, inner: &Expr, out: &mut List[TStmt]) -> Expr ! alloc
    ni = dr_hoist_expr(h, inner, out)
    if str_eq(op, "ref") + str_eq(op, "refmut") > 0
        if dr_is_place(&ni) == 0
            k = list_get(&h.k, 0) + 1
            _s = list_set(h.k, 0, k)
            name = "__tmp" + int_to_str(k)
            _l = list_push(out, TStmt(1, strdup(name), ni, "", 1, XNone, 0, 0, 0 - k))
            bound = XIdent(strdup(name))
            _w = dr_set_expr(e, 1, inner, &bound)
            dr_ret(e)
        else
            _w = dr_set_expr(e, 1, inner, &ni)
            dr_ret(e)
    else
        _w = dr_set_expr(e, 1, inner, &ni)
        dr_ret(e)

fn dr_hoist_expr(h: &mut HC, e: &Expr, out: &mut List[TStmt]) -> Expr ! alloc
    match e
        XCall(name, args, targs, xp) => dr_hoist_call(h, e, &name, &mut args, out)
        XBin(op, l, r) => dr_hoist_bin(h, e, &l, &r, out)
        XUnary(op, inner) => dr_hoist_unary(h, e, &op, &inner, out)
        XIf(cond, then_b, else_b, has_else, elsifs) => dr_hoist_if(h, e, &cond, &mut then_b, &mut else_b, has_else, &mut elsifs, out)
        XWhile(cond, body) => dr_hoist_while(h, e, &mut body)
        XMatch(scrut, arms) => dr_hoist_match(h, e, &scrut, &mut arms, out)
        XField(base, field) => dr_hoist_field(h, e, &base, &field, out)
        _ => dr_alias(e)

# `match list_get(xs, i) { … }`: the element read is bound to a local first (`Hoist` in src/drops.rs).
fn dr_hoist_match(h: &mut HC, e: &Expr, scrut: &Expr, arms: &mut List[TArm], out: &mut List[TStmt]) -> Expr ! alloc
    ns = dr_hoist_expr(h, scrut, out)
    s2 = if dr_is_elem_read(&ns) + dr_is_dict_get(&ns) > 0
        k = list_get(&h.k, 0) + 1
        _s = list_set(h.k, 0, k)
        name = "__tmp" + int_to_str(k)
        _l = list_push(out, TStmt(1, strdup(name), ns, "", 1, XNone, 0, 0, 0 - k))
        XIdent(strdup(name))
    else
        ns
    _w = dr_set_expr(e, 0, scrut, &s2)
    # The arms are not hoisted: their temporaries belong to the arm scope, and the
    # bootstrap (`Hoist::expr` in `src/drops.rs`) does not descend into match arms.
    # Hoisting `&f(x)` from an arm to before the `switch` leaves pattern binders
    # out of scope and passes `0` for them to the callee.
    dr_ret(e)

# `list_get(xs, i).f` of a list whose element struct a copy can release: the copy is bound to a
# temporary ahead of the statement (`Hoist` in src/drops.rs).
fn dr_hoist_field(h: &mut HC, e: &Expr, base: &Expr, field: &String, out: &mut List[TStmt]) -> Expr ! alloc
    nb = dr_hoist_expr(h, base, out)
    if dr_elem_list_known(h, &nb) == 0
        _s = dr_set_expr(e, 0, base, &nb)
        dr_alias(e)
    else
        k = list_get(&h.k, 0) + 1
        _s = list_set(h.k, 0, k)
        name = "__tmp" + int_to_str(k)
        _l = list_push(out, TStmt(1, strdup(name), nb, "", 1, XNone, 0, 0, 0 - k))
        _f = enum_free_shell(e)
        XField(XIdent(strdup(name)), str_share(field))

fn dr_elem_list_known(h: &HC, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dr_elem_list_call(h, &name, &args)
        _ => 0

fn dr_elem_list_call(h: &HC, name: &String, args: &List[Expr]) -> Int ! alloc
    if dr_is_elem_read(&XCall(name.dup(), args.clone(), "", 0)) == 0
        0
    elsif list_len(args) == 0
        0
    else
        first = list_get(args, 0)
        if dx_is_ident(&first) == 0
            0
        elsif nm_get(&h.lists, &dx_ident(&first)) == 0
            0
        else
            1

# The struct of each local list of a fn: its parameters `List[S]` and its `xs = list_new[S]()`
# (`list_elem_structs` in src/drops.rs). Maps the local's name to the struct's name.
fn dr_lists_of(params: &List[TParam], body: &TBlock, variants: Int) -> NM ! alloc
    m = nm_new()
    _a = dr_lists_params(&mut m, params, 0, list_len(params), variants)
    _b = dr_lists_stmts(&mut m, &body.stmts, 0, list_len(&body.stmts), variants)
    m

fn dr_lists_params(m: &mut NM, params: &List[TParam], i: Int, n: Int, variants: Int) -> Int ! alloc
    if i >= n
        0
    else
        p = list_get(params, i)
        s = dr_list_elem(&p.ty, variants)
        _x = if str_len(s) == 0
            0
        else
            nm_put(m, &p.name, str_own(&s))
        dr_lists_params(m, params, i + 1, n, variants)

# The element struct of the list type text `List[S]` ("" when not a list of an ownable struct).
fn dr_list_elem(ty: &String, variants: Int) -> String ! alloc
    t = trim_type_piece(ty)
    if str_eq(ty_base(&t), "List") == 0
        ""
    else
        dr_struct_of(&dr_ty_arg0(&t), variants)

# The first type argument of a type text (`S` of `List[S]`), "" when there is none.
fn dr_ty_arg0(t: &String) -> String ! alloc
    h = nth_type_arg(t, 0)
    if h == 0
        ""
    else
        str_from_int(h)

# The struct `t` when a copy of it can be released ("" otherwise).
fn dr_struct_of(txt: &String, variants: Int) -> String ! alloc
    t = trim_type_piece(txt)
    if map_get(variants, str_own(&("desc:" + t))) == 0
        ""
    else
        t

fn dr_lists_stmts(m: &mut NM, stmts: &List[TStmt], i: Int, n: Int, variants: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        _a = dr_lists_stmt(m, &st, variants)
        dr_lists_stmts(m, stmts, i + 1, n, variants)

fn dr_lists_stmt(m: &mut NM, st: &TStmt, variants: Int) -> Int ! alloc
    if st.kind == 1
        dr_lists_bind(m, &st.name, &st.expr, variants)
    elsif st.kind == 0
        dr_lists_expr(m, &st.expr, variants)
    else
        0

fn dr_lists_bind(m: &mut NM, name: &String, e: &Expr, variants: Int) -> Int ! alloc
    match e
        XCall(fname, args, targs, xp) => dr_lists_new(m, name, &fname, &targs, variants)
        _ => 0

fn dr_lists_new(m: &mut NM, name: &String, fname: &String, targs: &String, variants: Int) -> Int ! alloc
    if str_eq(fname, "list_new") == 0
        0
    else
        s = dr_struct_of(targs, variants)
        if str_len(s) == 0
            0
        else
            nm_put(m, name, str_own(&s))

# A `while` body is scanned too (as `Stmt::While` is in src/drops.rs).
fn dr_lists_expr(m: &mut NM, e: &Expr, variants: Int) -> Int ! alloc
    match e
        XWhile(cond, body) => dr_lists_block(m, &body, variants)
        _ => 0

fn dr_lists_block(m: &mut NM, b: &TBlock, variants: Int) -> Int ! alloc
    dr_lists_stmts(m, &b.stmts, 0, list_len(&b.stmts), variants)

fn dr_is_elem_read(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => str_eq(name, "list_get") + str_eq(name, "list_pop")
        _ => 0

# `dict_get(..)`: the runtime hands out a fresh `Option` that owns a copy of the value.
fn dr_is_dict_get(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => str_eq(name, "dict_get")
        _ => 0

fn dr_hoist_call(h: &mut HC, e: &Expr, name: &String, args: &mut List[Expr], out: &mut List[TStmt]) -> Expr ! alloc
    _a = dr_hoist_args(h, args, 0, list_len(args), name, out)
    dr_ret(e)

fn dr_hoist_bin(h: &mut HC, e: &Expr, l: &Expr, r: &Expr, out: &mut List[TStmt]) -> Expr ! alloc
    nl = dr_hoist_expr(h, l, out)
    nr = dr_hoist_expr(h, r, out)
    _a = dr_set_expr(e, 1, l, &nl)
    _b = dr_set_expr(e, 2, r, &nr)
    dr_ret(e)

fn dr_hoist_while(h: &mut HC, e: &Expr, body: &mut TBlock) -> Expr ! alloc
    nb = dr_hoist_block(h, body)
    _b = enum_set(e, 1, nb)
    dr_ret(e)

fn dr_hoist_if(h: &mut HC, e: &Expr, cond: &Expr, then_b: &mut TBlock, else_b: &mut TBlock, has_else: Int, elsifs: &mut List[TElsif], out: &mut List[TStmt]) -> Expr ! alloc
    # The first condition runs once, ahead of the statement: its fresh temporaries are bound
    # like any call argument. `elsif` conditions run conditionally and stay as they are.
    before = list_len(out)
    nc = dr_hoist_expr(h, cond, out)
    # `dr_hoist_expr` hands back a copy: the condition is only replaced when a temporary was bound.
    if list_len(out) > before
        _c = dr_set_expr(e, 0, cond, &nc)
    tb = dr_hoist_block(h, then_b)
    _t = enum_set(e, 1, tb)
    if has_else == 1
        eb = dr_hoist_block(h, else_b)
        _e = enum_set(e, 2, eb)
    _a = dr_hoist_arms(h, elsifs, 0, list_len(elsifs))
    dr_ret(e)

fn dr_hoist_stmts(h: &mut HC, stmts: &mut List[TStmt], i: Int, n: Int, out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        # An owned copy: the list keeps the statement this one came from.
        st = tc_stmt(&list_get(&mut stmts, i))
        ne = dr_hoist_expr(h, &st.expr, out)
        if dr_moved(&st.expr, &ne) == 1
            st.expr = ne
        _p = dr_share_stmt(out, &st)
        dr_hoist_stmts(h, stmts, i + 1, n, out)

fn dr_hoist_block(h: &mut HC, b: &mut TBlock) -> TBlock ! alloc
    out = list_new[TStmt]()
    n_stmts = list_len(&b.stmts)
    _a = dr_hoist_stmts(h, &mut b.stmts, 0, n_stmts, &mut out)
    tail = dr_hoist_expr(h, &b.tail, &mut out)
    _f = dr_free_stmts(&b.stmts)
    TBlock(out, tail)

# `list_get` borrows. Copy the element only where it takes ownership (`desc_copy`).
fn br_text(m: &NM, name: &String) -> String ! alloc
    h = nm_get(m, name)
    if h == 0
        ""
    else
        str_from_int(h)

fn dr_elem_desc(targs: &String, variants: Int) -> String ! alloc
    t = trim_type_piece(targs)
    if str_eq(t, "String") == 1
        "s"
    elsif map_get(variants, str_own(&("enum:" + t))) != 0
        "E"
    elsif map_get(variants, str_own(&("desc:" + t))) != 0
        str_from_int(map_get(variants, str_own(&("desc:" + t))))
    else
        ""

fn dr_seed_elems(lists: &NM, variants: Int, elems: &mut NM, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        name = list_get(&lists.names, i)
        sn = str_from_int(list_get(&lists.vals, i))
        h = map_get(variants, str_own(&("desc:" + sn)))
        _p = if h == 0
            0
        else
            nm_put(elems, &name, h)
        dr_seed_elems(lists, variants, elems, i + 1, n)

fn dr_note_params(ps: &List[TParam], variants: Int, elems: &mut NM, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        p = list_get(ps, i)
        _a = if str_eq(ty_base(&p.ty), "List") == 0
            0
        else
            d = dr_elem_desc(&dr_ty_arg0(&p.ty), variants)
            if str_len(d) == 0
                0
            else
                nm_put(elems, &p.name, str_own(&strdup(d)))
        dr_note_params(ps, variants, elems, i + 1, n)

fn dr_note_list(name: &String, e: &Expr, variants: Int, elems: &mut NM) -> Int ! alloc
    match e
        XCall(fname, args, targs, xp) =>
            if str_eq(fname, "list_new") + str_eq(fname, "list_new_owned") == 0
                0
            else
                d = dr_elem_desc(&targs, variants)
                if str_len(d) == 0
                    0
                else
                    nm_put(elems, name, str_own(&strdup(d)))
        _ => 0

fn dr_list_sn(xs: &Expr, lists: &NM) -> String ! alloc
    match xs
        XIdent(name) => br_text(lists, &name)
        _ => ""

fn dr_borrow_sn(e: &Expr, variants: Int, lists: &NM, sns: &NM) -> String ! alloc
    match e
        XIdent(name) => br_text(sns, &name)
        XCall(name, args, targs, xp) =>
            if str_eq(name, "list_get") == 0
                ""
            elsif list_len(&args) == 0
                ""
            else
                dr_list_sn(&list_get(&args, 0), lists)
        XField(base, field) =>
            sn = dr_borrow_sn(&base, variants, lists, sns)
            if str_len(sn) == 0
                ""
            else
                h = map_get(variants, str_own(&("fs:" + sn + "." + field)))
                if h == 0
                    ""
                else
                    str_from_int(h)
        _ => ""

fn dr_borrow_desc(e: &Expr, variants: Int, elems: &NM, borrows: &NM, lists: &NM, sns: &NM, took: Int) -> String ! alloc
    match e
        XCall(name, args, targs, xp) => dr_borrow_call(&name, &args, variants, elems, borrows, lists, sns, took)
        XIdent(name) => br_text(borrows, &name)
        XField(base, field) =>
            sn = dr_borrow_sn(&base, variants, lists, sns)
            if str_len(sn) == 0
                ""
            else
                h = map_get(variants, str_own(&("fd:" + sn + "." + field)))
                if h == 0
                    ""
                else
                    str_from_int(h)
        _ => ""

fn dr_borrow_call(name: &String, args: &List[Expr], variants: Int, elems: &NM, borrows: &NM, lists: &NM, sns: &NM, took: Int) -> String ! alloc
    if str_eq(name, "list_get") == 1
        if list_len(args) == 0
            ""
        else
            dr_get_desc(&list_get(args, 0), elems)
    elsif map_get(variants, str_own(&("desc:" + name))) != 0
        if dr_ctor_pure(args, 0, list_len(args), variants, elems, borrows, lists, sns, took, 0) == 1
            str_from_int(map_get(variants, str_own(&("desc:" + name))))
        else
            ""
    elsif map_get(variants, str_own(&("rd:" + name))) != 0
        if dr_call_shares(name, args, 0, list_len(args), variants, elems, borrows, lists, sns, took) == 1
            str_from_int(map_get(variants, str_own(&("rd:" + name))))
        else
            ""
    else
        ""

# 1 when every argument is a borrowed field or a Copy literal, and at least one borrows heap.
fn dr_ctor_pure(args: &List[Expr], i: Int, n: Int, variants: Int, elems: &NM, borrows: &NM, lists: &NM, sns: &NM, took: Int, saw: Int) -> Int ! alloc
    if i >= n
        saw
    elsif dr_arg_shares(&list_get(args, i), variants, elems, borrows, lists, sns, took) == 0
        0
    else
        heap = if str_len(dr_borrow_desc(&list_get(args, i), variants, elems, borrows, lists, sns, took)) > 0
            1
        else
            saw
        dr_ctor_pure(args, i + 1, n, variants, elems, borrows, lists, sns, took, heap)

fn dr_arg_shares(a: &Expr, variants: Int, elems: &NM, borrows: &NM, lists: &NM, sns: &NM, took: Int) -> Int ! alloc
    if str_len(dr_borrow_desc(a, variants, elems, borrows, lists, sns, took)) > 0
        1
    else
        match a
            XField(base, field) =>
                if str_len(dr_borrow_sn(&base, variants, lists, sns)) > 0
                    1
                else
                    0
            XInt(v) => 1
            XFloat(bits, txt) => 1
            XBool(v) => 1
            _ => 0

# 1 when some argument is a borrow the callee does not store or return.
fn dr_call_shares(name: &String, args: &List[Expr], i: Int, n: Int, variants: Int, elems: &NM, borrows: &NM, lists: &NM, sns: &NM, took: Int) -> Int ! alloc
    if i >= n
        0
    elsif dr_took_at(took, name, i) == 1
        dr_call_shares(name, args, i + 1, n, variants, elems, borrows, lists, sns, took)
    elsif str_len(dr_borrow_desc(&list_get(args, i), variants, elems, borrows, lists, sns, took)) > 0
        1
    elsif str_len(dr_borrow_sn(&list_get(args, i), variants, lists, sns)) > 0
        1
    else
        dr_call_shares(name, args, i + 1, n, variants, elems, borrows, lists, sns, took)

fn dr_get_desc(xs: &Expr, elems: &NM) -> String ! alloc
    match xs
        XIdent(name) => br_text(elems, &name)
        _ => ""

fn dr_note_borrow(local: &String, e: &Expr, variants: Int, elems: &NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Int ! alloc
    d = dr_borrow_desc(e, variants, elems, borrows, lists, sns, took)
    if str_len(d) == 0
        _a = nm_put(borrows, local, 0)
        nm_put(sns, local, 0)
    else
        _a = nm_put(borrows, local, str_own(&strdup(d)))
        sn = dr_borrow_sn(e, variants, lists, sns)
        if str_len(sn) == 0
            nm_put(sns, local, 0)
        else
            nm_put(sns, local, str_own(&strdup(sn)))

fn dr_wrap_copy(e: &Expr, desc: &String) -> Expr ! alloc
    args = list_new[Expr]()
    _a = list_push(&mut args, XStr(strdup(desc)))
    _b = list_push_share(args, e)
    XCall("desc_copy", args, "", 0)

fn dr_took_at(took: Int, callee: &String, i: Int) -> Int ! alloc
    flags = map_get(took, str_own(callee))
    if flags == 0
        0
    elsif i >= vec_len(flags)
        0
    else
        vec_get(flags, i)

fn dr_arg_owns(callee: &String, i: Int, variants: Int, took: Int) -> Int ! alloc
    if str_eq(callee, "list_push") == 1
        if i == 1
            1
        else
            0
    elsif str_eq(callee, "list_set") == 1
        if i == 2
            1
        else
            0
    elsif str_eq(callee, "dict_put") == 1
        if i == 2
            1
        else
            0
    elsif str_eq(callee, "desc_copy") == 1
        0
    elsif dr_borrows(callee) == 1
        0
    elsif map_get(variants, str_own(&("struct:" + callee))) != 0
        0
    elsif map_get(variants, str_own(callee)) != 0
        1
    else
        dr_took_at(took, callee, i)

fn dr_claim_expr(e: &Expr, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Expr ! alloc
    if own == 0
        dr_claim_walk(e, own, variants, elems, borrows, lists, sns, took)
    else
        d = dr_borrow_desc(e, variants, elems, borrows, lists, sns, took)
        if str_len(d) == 0
            dr_claim_walk(e, own, variants, elems, borrows, lists, sns, took)
        else
            dr_wrap_copy(e, &d)

fn dr_claim_walk(e: &Expr, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Expr ! alloc
    match e
        XCall(name, args, targs, xp) =>
            n_args = list_len(&args)
            _a = dr_claim_args_in(&mut args, 0, n_args, &name, variants, elems, borrows, lists, sns, took)
            dr_ret(e)
        XBin(op, l, r) =>
            nl = dr_claim_expr(&l, 0, variants, elems, borrows, lists, sns, took)
            nr = dr_claim_expr(&r, 0, variants, elems, borrows, lists, sns, took)
            _a = dr_set_expr(e, 1, &l, &nl)
            _b = dr_set_expr(e, 2, &r, &nr)
            dr_ret(e)
        XUnary(op, x) =>
            nx = dr_claim_expr(&x, 0, variants, elems, borrows, lists, sns, took)
            _a = dr_set_expr(e, 1, &x, &nx)
            dr_ret(e)
        XField(base, field) =>
            nb = dr_claim_expr(&base, 0, variants, elems, borrows, lists, sns, took)
            _a = dr_set_expr(e, 0, &base, &nb)
            dr_ret(e)
        XIf(cond, then_b, else_b, has_else, elsifs) =>
            c2 = dr_claim_expr(&cond, 0, variants, elems, borrows, lists, sns, took)
            _c = dr_set_expr(e, 0, &cond, &c2)
            t2 = dr_claim_block(&mut then_b, own, variants, elems, borrows, lists, sns, took)
            _t = enum_set(e, 1, t2)
            if has_else == 1
                e2 = dr_claim_block(&mut else_b, own, variants, elems, borrows, lists, sns, took)
                _e = enum_set(e, 2, e2)
            n_elsifs = list_len(&elsifs)
            _a = dr_claim_elsifs_in(&mut elsifs, 0, n_elsifs, own, variants, elems, borrows, lists, sns, took)
            dr_ret(e)
        XWhile(cond, body) =>
            c2 = dr_claim_expr(&cond, 0, variants, elems, borrows, lists, sns, took)
            _c = dr_set_expr(e, 0, &cond, &c2)
            nb = dr_claim_block(&mut body, 0, variants, elems, borrows, lists, sns, took)
            _b = enum_set(e, 1, nb)
            dr_ret(e)
        XMatch(scrut, arms) =>
            s2 = dr_claim_expr(&scrut, 0, variants, elems, borrows, lists, sns, took)
            _s = dr_set_expr(e, 0, &scrut, &s2)
            n_arms = list_len(&arms)
            _a = dr_claim_arms_in(&mut arms, 0, n_arms, own, variants, elems, borrows, lists, sns, took)
            dr_ret(e)
        XTo(place, x) =>
            nx = dr_claim_expr(&x, 1, variants, elems, borrows, lists, sns, took)
            _a = dr_set_expr(e, 1, &x, &nx)
            dr_ret(e)
        XTry(x) =>
            nx = dr_claim_expr(&x, 1, variants, elems, borrows, lists, sns, took)
            _a = dr_set_expr(e, 0, &x, &nx)
            dr_ret(e)
        XLambda(p, body) =>
            nb = dr_claim_expr(&body, 1, variants, elems, borrows, lists, sns, took)
            _a = dr_set_expr(e, 1, &body, &nb)
            dr_ret(e)
        _ => dr_alias(e)

fn dr_claim_args_in(args: &mut List[Expr], i: Int, n: Int, callee: &String, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Int ! alloc
    if i >= n
        0
    else
        old = list_get(args, i)
        own = dr_arg_owns(callee, i, variants, took)
        own = dr_ctor_arg_own(own, callee, args, i, variants, elems, borrows, lists, sns, took)
        a = dr_claim_expr(&old, own, variants, elems, borrows, lists, sns, took)
        _s = dr_set_arg(args, i, &old, a)
        dr_claim_args_in(args, i + 1, n, callee, variants, elems, borrows, lists, sns, took)

fn dr_claim_elsifs_in(elsifs: &mut List[TElsif], i: Int, n: Int, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(&mut elsifs, i)
        c = dr_claim_expr(&a.cond, 0, variants, elems, borrows, lists, sns, took)
        if dr_moved(&a.cond, &c) == 1
            a.cond = c
        a.body = dr_claim_block(&mut a.body, own, variants, elems, borrows, lists, sns, took)
        dr_claim_elsifs_in(elsifs, i + 1, n, own, variants, elems, borrows, lists, sns, took)

fn dr_claim_arms_in(arms: &mut List[TArm], i: Int, n: Int, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(&mut arms, i)
        b = dr_claim_expr(&a.body, own, variants, elems, borrows, lists, sns, took)
        if dr_moved(&a.body, &b) == 1
            a.body = b
        if a.has_suite == 1
            a.suite = dr_claim_block(&mut a.suite, own, variants, elems, borrows, lists, sns, took)
        dr_claim_arms_in(arms, i + 1, n, own, variants, elems, borrows, lists, sns, took)

# A struct constructor of only borrowed fields shares them. Any other borrowed argument is copied.
fn dr_ctor_arg_own(own: Int, callee: &String, args: &List[Expr], i: Int, variants: Int, elems: &NM, borrows: &NM, lists: &NM, sns: &NM, took: Int) -> Int ! alloc
    if own == 1
        1
    elsif map_get(variants, str_own(&("struct:" + callee))) == 0
        0
    elsif dr_ctor_pure(args, 0, list_len(args), variants, elems, borrows, lists, sns, took, 0) == 1
        0
    elsif str_len(dr_borrow_desc(&list_get(args, i), variants, elems, borrows, lists, sns, took)) > 0
        1
    else
        0

fn dr_claim_args(args: &List[Expr], i: Int, n: Int, callee: &String, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int, out: &mut List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        own = dr_arg_owns(callee, i, variants, took)
        own = dr_ctor_arg_own(own, callee, args, i, variants, elems, borrows, lists, sns, took)
        a = dr_claim_expr(&list_get(args, i), own, variants, elems, borrows, lists, sns, took)
        _p = list_push(out, a)
        dr_claim_args(args, i + 1, n, callee, variants, elems, borrows, lists, sns, took, out)

fn dr_claim_elsifs(elsifs: &mut List[TElsif], i: Int, n: Int, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int, out: &mut List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(&mut elsifs, i)
        c = dr_claim_expr(&a.cond, 0, variants, elems, borrows, lists, sns, took)
        b = dr_claim_block(&mut a.body, own, variants, elems, borrows, lists, sns, took)
        _p = list_push(out, TElsif(c, b))
        dr_claim_elsifs(elsifs, i + 1, n, own, variants, elems, borrows, lists, sns, took, out)

fn dr_claim_arms(arms: &mut List[TArm], i: Int, n: Int, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int, out: &mut List[TArm]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(&mut arms, i)
        b = dr_claim_expr(&a.body, own, variants, elems, borrows, lists, sns, took)
        s = if a.has_suite == 1
            dr_claim_block(&mut a.suite, own, variants, elems, borrows, lists, sns, took)
        else
            a.suite.clone()
        _p = list_push(out, TArm(a.pat.clone(), b, s, a.has_suite))
        dr_claim_arms(arms, i + 1, n, own, variants, elems, borrows, lists, sns, took, out)

fn dr_claim_stmts(stmts: &mut List[TStmt], i: Int, n: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int, out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        # An owned copy: the list keeps the statement this one came from.
        st = tc_stmt(&list_get(&mut stmts, i))
        ne = dr_claim_stmt_expr(&st, variants, elems, borrows, lists, sns, took)
        if dr_moved(&st.expr, &ne) == 1
            st.expr = ne
        _p = dr_share_stmt(out, &st)
        dr_claim_stmts(stmts, i + 1, n, variants, elems, borrows, lists, sns, took, out)

fn dr_claim_stmt_expr(st: &TStmt, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> Expr ! alloc
    if st.kind == 2
        dr_claim_expr(&st.expr, 1, variants, elems, borrows, lists, sns, took)
    elsif st.kind == 1
        _n = dr_note_list(&st.name, &st.expr, variants, elems)
        ne = dr_claim_expr(&st.expr, 0, variants, elems, borrows, lists, sns, took)
        _b = dr_note_borrow(&st.name, &ne, variants, elems, borrows, lists, sns, took)
        ne
    elsif st.kind == 3
        dr_claim_expr(&st.expr, 1, variants, elems, borrows, lists, sns, took)
    else
        dr_claim_expr(&st.expr, 0, variants, elems, borrows, lists, sns, took)

fn dr_claim_block(b: &mut TBlock, own: Int, variants: Int, elems: &mut NM, borrows: &mut NM, lists: &NM, sns: &mut NM, took: Int) -> TBlock ! alloc
    out = list_new[TStmt]()
    n_stmts = list_len(&b.stmts)
    _a = dr_claim_stmts(&mut b.stmts, 0, n_stmts, variants, elems, borrows, lists, sns, took, &mut out)
    tail = dr_claim_expr(&b.tail, own, variants, elems, borrows, lists, sns, took)
    _f = dr_free_stmts(&b.stmts)
    TBlock(out, tail)

fn dr_claim_fn(f: &TFn, body: &mut TBlock, variants: Int, lists: &NM, took: Int) -> TBlock ! alloc
    elems = nm_new()
    borrows = nm_new()
    sns = nm_new()
    _s = dr_seed_elems(lists, variants, &mut elems, 0, list_len(&lists.names))
    _p = dr_note_params(&f.params, variants, &mut elems, 0, list_len(&f.params))
    dr_claim_block(body, 1, variants, &mut elems, &mut borrows, lists, &mut sns, took)

# One body, moved. Hoist, claim and xform reuse the nodes and drop the previous list vector.
fn drops_body(f: &mut TFn, denv: Int) -> TBlock ! alloc
    note_passthru_body(vec_get(denv, 0), &f.body)
    h = HC(list_new[Int](), dr_lists_of(&f.params, &f.body, vec_get(denv, 0)), vec_get(denv, 0))
    _h = list_push(&mut h.k, 0)
    hoisted = dr_hoist_block(&mut h, &mut f.body)
    claimed = dr_claim_fn(f, &mut hoisted, vec_get(denv, 0), &h.lists, vec_get(denv, 3))
    c = dr_facts(&f.params, &claimed, vec_get(denv, 0), vec_get(denv, 2), h.lists, list_new[String](), list_new[Int]())
    _sp = dr_set(&mut c, 6, 1)
    res = dr_xform_block(&mut c, &mut claimed)
    _pp = dr_pin_params(&c.ps)
    _ph = dr_pin_list(&hoisted.stmts)
    _pt = dr_pin_expr(&hoisted.tail)
    _pc = dr_pin_list(&claimed.stmts)
    _pe = dr_pin_expr(&claimed.tail)
    res

fn drops_body_t(f: &mut TFn, denv: Int) -> TBlock ! alloc
    drops_body(f, denv)

fn drops_body_tc(f: &mut TFn, denv: Int) -> TBlock ! alloc
    drops_body(f, denv)

# ---- legacy handle helpers (callers in fuse.sal and emit.sal) ----
# Builtins whose String arguments are only read.
fn dr_borrows(name: &String) -> Int ! alloc
    # `enum_set(e, i, v)` is not a whole-call borrow: it moves `v` (see `dr_call_args`).
    if str_eq(name, "str_share") + str_eq(name, "list_push_share") == 1
        1
    elsif dr_is_clone(name) == 1
        # `x.clone()` reads its receiver through `&self` (SPEC «Memoria»).
        1
    elsif str_eq(name, "str_len") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    elsif str_eq(name, "dict_keys") + str_eq(name, "dict_values") + str_eq(name, "dict_len") + str_eq(name, "dict_remove") == 1
        1
    elsif str_eq(name, "str_eq") == 1
        1
    elsif str_eq(name, "str_char") == 1
        1
    elsif str_eq(name, "str_contains") == 1
        1
    elsif str_eq(name, "str_index_of") == 1
        1
    elsif str_eq(name, "str_index_from") == 1
        1
    elsif str_eq(name, "str_skip") == 1
        1
    elsif str_eq(name, "str_hash") == 1
        1
    elsif str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "str_concat") == 1
        1
    elsif str_eq(name, "str_to_f64_bits") == 1
        1
    elsif str_eq(name, "print_str") == 1
        1
    elsif str_eq(name, "eprint_str") == 1
        1
    elsif str_eq(name, "write_file") == 1
        1
    elsif str_eq(name, "mkdir_p") == 1
        1
    elsif str_eq(name, "path_readable") == 1
        1
    elsif str_eq(name, "getenv") == 1
        1
    elsif str_eq(name, "map_get") == 1
        1
    elsif str_eq(name, "read_file") == 1
        1
    elsif str_eq(name, "list_len") == 1
        1
    elsif str_eq(name, "list_box_id") == 1
        1
    elsif str_eq(name, "list_get") == 1
        1
    elsif str_eq(name, "desc_copy") == 1
        1
    elsif str_eq(name, "list_pop") == 1
        1
    elsif str_eq(name, "dict_get") == 1
        1
    elsif str_eq(name, "dict_has") == 1
        1
    elsif str_eq(name, "enum_owns") == 1
        1
    elsif str_eq(name, "enum_box_id") == 1
        1
    elsif str_eq(name, "bytes_len") == 1
        1
    elsif str_eq(name, "bytes_get_u8") == 1
        1
    elsif str_eq(name, "bytes_get_u16") == 1
        1
    elsif str_eq(name, "bytes_get_u32") == 1
        1
    elsif str_eq(name, "bytes_get_i64") == 1
        1
    elsif str_eq(name, "bytes_set_u8") == 1
        1
    elsif str_eq(name, "bytes_set_u16") == 1
        1
    elsif str_eq(name, "bytes_set_u32") == 1
        1
    elsif str_eq(name, "bytes_set_i64") == 1
        1
    elsif str_eq(name, "bytes_fill") == 1
        1
    elsif str_eq(name, "bytes_fill_u32") == 1
        1
    elsif str_eq(name, "bytes_copy") == 1
        1
    elsif str_eq(name, "str_bytes_copy") == 1
        1
    elsif name.eq("bytes_to_str") == 1
        # `b.to_str()` copies the bytes into a new String: it only reads `b` (SPEC «Bytes»).
        1
    else
        0

# Builtins that return a fresh heap String nobody else owns.
fn dr_returns_fresh(name: &String) -> Int ! alloc
    if str_eq(name, "int_to_str") == 1
        1
    elsif str_eq(name, "char_to_str") == 1
        1
    elsif str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    elsif str_eq(name, "read_file") == 1
        1
    elsif str_eq(name, "str_concat") == 1
        1
    elsif name.eq("f64_bits_to_str") + name.eq("bytes_to_str") == 1
        # `Float.to_str` and `Bytes.to_str` build a new String too (SPEC «String», «Bytes»).
        1
    else
        0

# A field typed Int, Float or Bool cannot alias heap memory.
fn trim_type_piece(t: &String) -> String ! alloc
    n = str_len(t)
    if n > 0
        if str_char(t, n - 1) == 32
            trim_type_piece(&str_slice(t, 0, n - 1))
        else
            t.dup()
    else
        t.dup()

fn dr_field_owned_t(fty: &String) -> Int ! alloc
    t = trim_type_piece(fty)
    if str_len(t) == 0
        1
    elsif str_eq(t, "Int") == 1
        0
    elsif str_eq(t, "Float") == 1
        0
    elsif str_eq(t, "Bool") == 1
        0
    else
        1

# ---- temporaries ----
# A fresh string passed to a builtin that only reads it is bound to a local ahead of the
# statement, so the scope-end release frees it. `h` is `[counter]`.
# The key of `dict_put` / `dict_get` / `dict_has` / `dict_remove` is only read: the dict keeps its
# own copy (mirror of `reads_key_arg` in src/drops.rs).
fn dr_reads_key_arg(name: &String, i: Int) -> Int ! alloc
    if i != 1
        0
    else
        match name
            "dict_put" => 1
            "dict_get" => 1
            "dict_has" => 1
            "dict_remove" => 1
            _ => 0

fn dr_reads_string_arg(name: &String) -> Int ! alloc
    if str_eq(name, "str_len") == 1
        1
    elsif str_eq(name, "strdup") == 1
        1
    elsif str_eq(name, "str_eq") == 1
        1
    elsif str_eq(name, "str_char") == 1
        1
    elsif str_eq(name, "str_contains") == 1
        1
    elsif str_eq(name, "str_index_of") == 1
        1
    elsif str_eq(name, "str_index_from") == 1
        1
    elsif str_eq(name, "str_skip") == 1
        1
    elsif str_eq(name, "str_hash") == 1
        1
    elsif str_eq(name, "str_to_f64_bits") == 1
        1
    elsif str_eq(name, "print_str") == 1
        1
    elsif str_eq(name, "eprint_str") == 1
        1
    elsif str_eq(name, "write_file") == 1
        1
    elsif str_eq(name, "mkdir_p") == 1
        1
    elsif str_eq(name, "path_readable") == 1
        1
    elsif str_eq(name, "getenv") == 1
        1
    elsif str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "read_file") == 1
        1
    else
        0

fn dr_copy_vec(v: Int, i: Int, out: Int) -> Int ! alloc
    if i >= vec_len(v)
        out
    else
        _p = vec_push(out, vec_get(v, i))
        dr_copy_vec(v, i + 1, out)

