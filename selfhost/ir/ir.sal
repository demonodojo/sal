# IR values: instructions, binds, regions, and tensor shapes.
# lower_program lives in fuse.sal so fusion can read this module without an import cycle.
import "../front/lexer.sal"
import "../ast/tast.sal"
import "../ast/ttypes.sal"
import lam

fn II_CI() -> Int
    0

fn II_CS() -> Int
    1

fn II_BIN() -> Int
    2

fn II_CALL() -> Int
    3

fn II_PLACE() -> Int
    4

fn II_RET() -> Int
    5

fn II_DROP() -> Int
    6

fn II_IF() -> Int
    7

fn II_CF() -> Int
    8

fn II_TBIN() -> Int
    9

fn II_WHILE() -> Int
    10

fn II_AGG() -> Int
    11

fn II_EXTRACT() -> Int
    12

fn II_REBIND() -> Int
    13

fn II_EMAKE() -> Int
    14

fn II_EFIELD() -> Int
    15

fn II_SWITCH() -> Int
    16

fn II_TUN() -> Int
    17

fn II_ANYBOX() -> Int
    18

fn II_ANYCALL() -> Int
    19

fn II_ETAG() -> Int
    20

# Typed IR values (flat structs so `list_get` copies an element whole). Lived in tir.sal;
# they sit here so `ir_*` builders can return `Inst` without an import cycle with tir.
# `kind` is an `II_*` code. Slots by kind (handle slot in brackets):
#   CI dest n1=value | CS dest s1=text | BIN dest s1=op s2=left s3=right | CF dest n1=bits s1=text
#   TBIN dest s1=op n1=elem s2=place s3=left s4=right s5=len n2=scalar | CALL dest s1=func strs=args n1=has_dest
#   PLACE dest s1=from s2=to | RET s1=value | DROP s1=name
#   IF dest s1=cond b1=then b2=else s2=then_val s3=else_val rows=carried(dest,s1,s2)
#   WHILE b1=cond_insts s1=cond b2=body rows=carried(dest,s1,s2) | AGG dest s1=struct strs=fields
#   EXTRACT dest s1=base s2=struct n1=index | REBIND dest s1=src
#   EMAKE dest s1=enum n1=variant strs=payload n2=owned | EFIELD dest s1=value n1=index
#   SWITCH dest s1=scrut rows=arms(n1=tag, b1=body, s1=value) b1=default_body s2=default_val
struct Inst
    kind: Int
    dest: String
    s1: String
    s2: String
    s3: String
    s4: String
    s5: String
    n1: Int
    n2: Int
    n3: Int
    strs: List[String]
    b1: List[Inst]
    b2: List[Inst]
    rows: List[Inst]

# A fused op: `kind` is an `FO_*` code, `nslots` the length of the handle (a column op with 6 has a scalar).
struct FOp
    kind: Int
    a: String
    b: String
    c: String
    d: String
    scalar: String
    nslots: Int

struct Region
    place: String
    fused: Int
    has_peak: Int
    has_sym: Int
    peak: Int
    peak_sym: String
    ops: List[FOp]

# A tensor literal `[name, element texts]`.
struct Lit
    name: String
    data: List[String]

struct IrFn
    name: String
    dps: List[String]
    insts: List[Inst]
    regions: List[Region]
    lits: List[Lit]

# ---- Lower / IR ----
# Lowering state of one function. The counter and the accumulator name live in one-slot lists so a
# callee can update them; `bodies` is the stack of instruction bodies (the last one is the block
# being lowered). `dim_params` (the dynamic dimensions of tensor parameters), `regions` (the fused
# regions) and `literals` (the tensor literals) are one-slot lists too, so `lower_fn` takes them
# with `pop` and `cx` is still released whole: moving a field out would leave the rest of `cx`
# unreleased (`tests/lang/ownership/partial_move_ok.sal`, asan-xfail). `binds`, `bind_map`,
# `fn_map` and `variants` are still handle vecs/maps.
# `env` is the typed local environment (`ttypes.sal`), shared by every function of a program.
# The struct locals of an `if` branch are released when the branch ends (`block_struct_drops` in
# src/ir.rs); a `return` inside branches releases those of every open branch and of the fn body
# (`return_struct_drops`). For that: `md` the parameter modes and `fsum` the callee summary
# (`fr_summary`) of the drops env, `nparams` the parameters bound first in `env`, `fn_scope` the
# fn body, and the open branches that hold a `return`: `open` keeps a copy of each (it only
# grows: a struct taken back with `pop` would not be released), `open_idx` the ones still open
# and `open_len` the length of `env` when each one began.
struct Cx
    ctr: List[Int]
    bodies: List[List[Inst]]
    acc: List[Int]
    binds: Int
    fn_names: Int
    dim_params: List[List[String]]
    regions: List[List[Region]]
    bind_map: Int
    fn_map: Int
    literals: List[List[Lit]]
    variants: Int
    env: TEnv
    enums: List[TEnum]
    fns: List[TFn]
    protocols: List[TProtocol]
    lams: List[Lam]
    md: Int
    fsum: Int
    nparams: Int
    # 1 when a field overwrite keeps the old value (a module of the selfhost; see `lower_fn`).
    keep_old: Int
    # The fn being lowered (one slot): a rebinding of a struct local reads its moves and field
    # reads (`reassign_struct_drop`).
    fn_self: List[TFn]
    fn_scope: List[TBlock]
    open: List[TBlock]
    open_idx: List[Int]
    open_len: List[Int]

fn cx_new(fn_names: Int, fm: Int, env: TEnv, enums: &List[TEnum], fns: &List[TFn], protocols: &List[TProtocol]) -> Cx ! alloc
    ctr = list_new[Int]()
    _a = list_push(&mut ctr, 0)
    bodies = List.new[List[Inst]]()
    _b = bodies.push(List.new[Inst]())
    acc = list_new[Int]()
    _c = list_push(&mut acc, 0)
    vm = map_new()
    _m = variants_fill(vm, enums, 0, list_len(enums))
    dps = List.new[List[String]]()
    dps.push(List.new[String]())
    regions = List.new[List[Region]]()
    regions.push(List.new[Region]())
    lits = List.new[List[Lit]]()
    lits.push(List.new[Lit]())
    Cx(ctr, bodies, acc, vec_new(), fn_names, dps, regions, map_new(), fm, lits, vm, env, enums.clone(), fns.clone(), protocols.clone(), List.new[Lam](), 0, 0, 0, 0, List.new[TFn](), List.new[TBlock](), List.new[TBlock](), List.new[Int](), List.new[Int]())

# Variant name -> `[enum name, variant index, field count, tag]`; the first definition wins.
fn cx_variants(cx: &Cx) -> Int ! alloc
    cx.variants

fn variants_fill(m: Int, enums: &List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ed = list_get(enums, i)
        _k = map_put(m, str_own(&("enum:" + ed.name)), 1)
        _a = variants_fill_go(m, str_own(&ed.name), &ed.variants, 0, list_len(&ed.variants))
        variants_fill(m, enums, i + 1, n)

fn variants_fill_go(m: Int, ename: Int, vs: &List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = list_get(vs, i)
        nf = list_len(&v.fields)
        tag = if nf == 0
            if i == 0
                0
            else
                i + 1
        else
            i + 1
        key = str_own(&v.name)
        if map_get(m, key) == 0
            rec = vec_new()
            _a = vec_push(rec, ename)
            _b = vec_push(rec, i)
            _c = vec_push(rec, nf)
            _d = vec_push(rec, tag)
            _e = map_put(m, key, rec)
            variants_fill_go(m, ename, vs, i + 1, n)
        else
            variants_fill_go(m, ename, vs, i + 1, n)

fn cx_structs(cx: &Cx) -> List[TStruct] ! alloc
    cx.env.structs.clone()

# Name of the binding an `x = x + ...` chain accumulates into (0 when none).
fn cx_acc(cx: &Cx) -> Int ! alloc
    list_get(&cx.acc, 0)

fn cx_set_acc(cx: &mut Cx, name: Int) -> Int ! alloc
    _s = list_set(cx.acc, 0, name)
    0

fn fill_fn_map(m: Int, names: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = map_put(m, vec_get(names, i), 1)
        fill_fn_map(m, names, i + 1, n)

fn cx_bind_map(cx: &Cx) -> Int ! alloc
    cx.bind_map

fn cx_fn_map(cx: &Cx) -> Int ! alloc
    cx.fn_map

fn cx_counter(cx: &Cx) -> Int ! alloc
    list_get(&cx.ctr, 0)

fn cx_set_counter(cx: &mut Cx, v: Int) -> Int ! alloc
    _s = list_set(cx.ctr, 0, v)
    0

# The body being lowered (the top of the stack; `ir_push` appends to it).
fn cx_insts(cx: &mut Cx) -> &mut List[Inst] ! alloc
    n = cx.bodies.len()
    cx.bodies.get_mut(n - 1)

fn cx_dim_params(cx: &mut Cx) -> &mut List[String] ! alloc
    cx.dim_params.get_mut(0)

fn cx_regions(cx: &mut Cx) -> &mut List[Region] ! alloc
    cx.regions.get_mut(0)

fn cx_literals(cx: &mut Cx) -> &mut List[Lit] ! alloc
    cx.literals.get_mut(0)

# Nested body (an `if`/`while`/`switch` arm): the instructions pushed from here on go to it.
fn cx_begin_body(cx: &mut Cx) -> Int ! alloc
    _p = cx.bodies.push(List.new[Inst]())
    0

# Ends the nested body and moves its instructions to the caller.
fn cx_end_body(cx: &mut Cx) -> List[Inst] ! alloc
    cx.bodies.pop()

fn cx_binds(cx: &Cx) -> Int ! alloc
    cx.binds

fn cx_fn_names(cx: &Cx) -> Int ! alloc
    cx.fn_names

fn fresh(cx: &mut Cx) -> Int ! alloc
    n = cx_counter(cx) + 1
    _s = cx_set_counter(cx, n)
    pref = char_to_str(116)
    ns = int_to_str(n)
    r = pref + ns
    free(pref)
    free(ns)
    str_own(&r)

# Handle text → owned String (builders still take Int SSA/name handles from lowering).
fn ir_s(h: Int) -> String ! alloc
    if h == 0
        "".dup()
    else
        str_from_int(h).dup()

fn ir_no_insts() -> List[Inst] ! alloc
    List.new[Inst]()

fn ir_no_strs() -> List[String] ! alloc
    List.new[String]()

fn ir_strs_of(hs: Int) -> List[String] ! alloc
    out = List.new[String]()
    ir_strs_go(hs, 0, vec_len(hs), &mut out)
    out

fn ir_strs_go(hs: Int, i: Int, n: Int, out: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(ir_s(vec_get(hs, i)))
        ir_strs_go(hs, i + 1, n, out)

fn ir_mk(kind: Int, dest: String, s1: String, s2: String, s3: String, s4: String, s5: String, n1: Int, n2: Int, n3: Int, strs: List[String], b1: List[Inst], b2: List[Inst], rows: List[Inst]) -> Inst ! alloc
    Inst(kind, dest, s1, s2, s3, s4, s5, n1, n2, n3, strs, b1, b2, rows)

fn ir_ci(dest: Int, v: Int) -> Inst ! alloc
    ir_mk(II_CI(), ir_s(dest), "".dup(), "".dup(), "".dup(), "".dup(), "".dup(), v, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_cs(dest: Int, text: Int) -> Inst ! alloc
    ir_mk(II_CS(), ir_s(dest), ir_s(text), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_bin(dest: Int, op: Int, left: Int, right: Int) -> Inst ! alloc
    ir_mk(II_BIN(), ir_s(dest), ir_s(op), ir_s(left), ir_s(right), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_cf(dest: Int, bits: Int, txt: Int) -> Inst ! alloc
    ir_mk(II_CF(), ir_s(dest), ir_s(txt), "".dup(), "".dup(), "".dup(), "".dup(), bits, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_tbin(dest: Int, op: Int, elem: Int, place: Int, left: Int, right: Int, len: Int, scalar: Int) -> Inst ! alloc
    ir_mk(II_TBIN(), ir_s(dest), ir_s(op), ir_s(place), ir_s(left), ir_s(right), ir_s(len), elem, scalar, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

# `TensorUnary`: `op` (only `neg`) over the tensor `input`, `len` elements of `elem`.
fn ir_tun(dest: Int, op: Int, elem: Int, place: Int, input: Int, len: Int) -> Inst ! alloc
    ir_mk(II_TUN(), ir_s(dest), ir_s(op), ir_s(place), ir_s(input), "".dup(), ir_s(len), elem, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_agg(dest: Int, sname: Int, fields: Int) -> Inst ! alloc
    ir_mk(II_AGG(), ir_s(dest), ir_s(sname), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_strs_of(fields), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_extract(dest: Int, base: Int, sname: Int, idx: Int) -> Inst ! alloc
    ir_mk(II_EXTRACT(), ir_s(dest), ir_s(base), ir_s(sname), "".dup(), "".dup(), "".dup(), idx, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_emake(dest: Int, ename: Int, vidx: Int, payload: Int, owned: Int) -> Inst ! alloc
    ir_mk(II_EMAKE(), ir_s(dest), ir_s(ename), "".dup(), "".dup(), "".dup(), "".dup(), vidx, owned, 0, ir_strs_of(payload), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_efield(dest: Int, value: Int, idx: Int) -> Inst ! alloc
    ir_mk(II_EFIELD(), ir_s(dest), ir_s(value), "".dup(), "".dup(), "".dup(), "".dup(), idx, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

# `EnumTag`: the low tag byte of an enum value.
fn ir_etag(dest: Int, value: Int) -> Inst ! alloc
    ir_mk(II_ETAG(), ir_s(dest), ir_s(value), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

# A `Switch` arm: the tag, its body and the value it yields.
fn ir_arm(tag: Int, body: List[Inst], value: Int) -> Inst ! alloc
    ir_mk(0, "".dup(), ir_s(value), "".dup(), "".dup(), "".dup(), "".dup(), tag, 0, 0, ir_no_strs(), body, ir_no_insts(), ir_no_insts())

# A carried binding: `dest` takes `then_val`/`else_val` (or `incoming`/`updated` in a while).
fn ir_carry(dest: Int, a: Int, b: Int) -> Inst ! alloc
    ir_mk(0, ir_s(dest), ir_s(a), ir_s(b), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_switch(dest: Int, scrut: Int, arms: List[Inst], default_body: List[Inst], default_val: Int) -> Inst ! alloc
    ir_mk(II_SWITCH(), ir_s(dest), ir_s(scrut), ir_s(default_val), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), default_body, ir_no_insts(), arms)

fn ir_anybox(dest: Int, vtable: Int, payload: Int, drop_slot: Int) -> Inst ! alloc
    ir_mk(II_ANYBOX(), ir_s(dest), ir_s(vtable), ir_s(payload), "".dup(), "".dup(), "".dup(), drop_slot, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_anycall(dest: Int, receiver: Int, slot: Int, args: Int) -> Inst ! alloc
    ir_mk(II_ANYCALL(), ir_s(dest), ir_s(receiver), "".dup(), "".dup(), "".dup(), "".dup(), slot, 0, 0, ir_strs_of(args), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_call_free(arg: Int) -> Inst ! alloc
    ir_call_named(arg, str_as_int(&"sal_free"))

# A call of the runtime function `func` (a handle) on `arg`, for a release.
fn ir_call_named(arg: Int, func: Int) -> Inst ! alloc
    args = vec_new()
    _a = vec_push(args, arg)
    ir_call(0, func, args, 0)

fn ir_call(dest: Int, func: Int, args: Int, has_dest: Int) -> Inst ! alloc
    ir_mk(II_CALL(), ir_s(dest), ir_s(func), "".dup(), "".dup(), "".dup(), "".dup(), has_dest, 0, 0, ir_strs_of(args), ir_no_insts(), ir_no_insts(), ir_no_insts())

# A call whose tensor shape the C emitter needs (`shape` = vec [rows, cols, axis], -1 when unknown).
# The slot is not printed: the IR text is the bootstrap's. Shape travels in `n2`.
fn ir_call_shaped(dest: Int, func: Int, args: Int, has_dest: Int, shape: Int) -> Inst ! alloc
    ir_mk(II_CALL(), ir_s(dest), ir_s(func), "".dup(), "".dup(), "".dup(), "".dup(), has_dest, shape, 0, ir_strs_of(args), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_place(dest: Int, fr: Int, to_pl: Int) -> Inst ! alloc
    ir_mk(II_PLACE(), ir_s(dest), ir_s(fr), ir_s(to_pl), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_ret(val: Int) -> Inst ! alloc
    ir_mk(II_RET(), "".dup(), ir_s(val), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_drop(name: Int) -> Inst ! alloc
    ir_mk(II_DROP(), "".dup(), ir_s(name), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_rebind(dest: Int, src: Int) -> Inst ! alloc
    ir_mk(II_REBIND(), ir_s(dest), ir_s(src), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), ir_no_insts(), ir_no_insts(), ir_no_insts())

fn ir_if(dest: Int, cond: Int, then_body: List[Inst], else_body: List[Inst], then_val: Int, else_val: Int, carried: List[Inst]) -> Inst ! alloc
    ir_mk(II_IF(), ir_s(dest), ir_s(cond), ir_s(then_val), ir_s(else_val), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), then_body, else_body, carried)

fn ir_while(cond_insts: List[Inst], cond: Int, body: List[Inst], carried: List[Inst]) -> Inst ! alloc
    ir_mk(II_WHILE(), "".dup(), ir_s(cond), "".dup(), "".dup(), "".dup(), "".dup(), 0, 0, 0, ir_no_strs(), cond_insts, body, carried)

# Push a typed instruction onto the body being lowered.
fn ir_push(cx: &mut Cx, inst: Inst) -> Int ! alloc
    body = cx_insts(cx)
    _p = body.push(inst)
    0

fn bind_new(name: Int, ssa: Int) -> Int ! alloc
    b = vec_new()
    _a = vec_push(b, name)
    _b = vec_push(b, ssa)
    _c = vec_push(b, 0)
    _d = vec_push(b, 0)
    _e = vec_push(b, vec_new())
    _f = vec_push(b, vec_new())
    _g = vec_push(b, 4)
    _h = vec_push(b, str_as_int(&"cpu"))
    b

fn bind_place(b: Int) -> Int ! alloc
    vec_get(b, 7)

fn bind_set_place(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 7, v)
    0

fn bind_name(b: Int) -> Int ! alloc
    vec_get(b, 0)

fn bind_ssa(b: Int) -> Int ! alloc
    vec_get(b, 1)

fn bind_set_ssa(b: Int, s: Int) -> Int ! alloc
    _s = vec_set(b, 1, s)
    0

fn bind_is_tensor(b: Int) -> Int ! alloc
    vec_get(b, 2)

fn bind_set_tensor(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 2, v)
    0

fn bind_ndims(b: Int) -> Int ! alloc
    vec_get(b, 3)

fn bind_set_ndims(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 3, v)
    0

fn bind_dims(b: Int) -> Int ! alloc
    vec_get(b, 4)

fn bind_concrete(b: Int) -> Int ! alloc
    vec_get(b, 5)

fn bind_elem(b: Int) -> Int ! alloc
    vec_get(b, 6)

fn bind_set_elem(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 6, v)
    0

fn cx_find_at(binds: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(binds, i)
        if str_eq(bind_name(b), name) == 1
            b
        else
            cx_find_at(binds, name, i + 1, n)

fn cx_find(cx: &Cx, name: Int) -> Int ! alloc
    map_get(cx_bind_map(cx), name)

fn cx_lookup(cx: &Cx, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        name
    else
        bind_ssa(b)

fn cx_bind(cx: &Cx, name: Int, ssa: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        b = bind_new(name, ssa)
        _p = vec_push(cx_binds(cx), b)
        _q = map_put(cx_bind_map(cx), name, b)
        0
    else
        bind_set_ssa(b, ssa)

fn fn_names_has_at(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        fn_names_has_at(names, name, i + 1, n)

fn is_user_fn(cx: &Cx, name: Int) -> Int ! alloc
    if map_get(cx_fn_map(cx), name) == 0
        0
    else
        1

# List and dict operations always hit the runtime; prelude bodies are signatures only.
fn is_container_op(fname: Int) -> Int ! alloc
    if str_eq(fname, "list_new") == 1
        1
    elsif str_eq(fname, "list_push") == 1
        1
    elsif str_eq(fname, "list_len") == 1
        1
    elsif str_eq(fname, "list_get") == 1
        1
    elsif str_eq(fname, "dict_new") == 1
        1
    elsif str_eq(fname, "dict_put") == 1
        1
    elsif str_eq(fname, "dict_get") == 1
        1
    else
        0

fn runtime_name(cx: &Cx, fname: Int) -> Int ! alloc
    if str_eq(str_from_int(fname), "list_clone") == 1
        str_as_int(&"sal_list_clone_val")
    elsif str_eq(str_from_int(fname), "dict_clone") == 1
        str_as_int(&"sal_dict_clone_val")
    elsif str_eq(str_from_int(fname), "bytes_clone") == 1
        str_as_int(&"sal_bytes_clone_val")
    elsif str_eq(str_from_int(fname), "enum_copy") == 1
        str_as_int(&"sal_enum_copy")
    elsif is_container_op(fname) == 1
        str_own(&("sal_" + str_from_int(fname)))
    elsif is_user_fn(cx, fname) == 1
        fname
    elsif str_eq(str_from_int(fname), "matmul") == 1
        str_as_int(&"sal_matmul_f32")
    else
        pref = "sal_"
        str_own(&(pref + str_from_int(fname)))

fn ir_call_unary(cx: &mut Cx, rname: Int, src: Int) -> Int ! alloc
    out = fresh(cx)
    argv = vec_new()
    _a = vec_push(argv, src)
    _p = ir_push(cx, ir_call(out, rname, argv, 1))
    out

fn push_const_int(cx: &mut Cx, dest: Int, v: Int) -> Int ! alloc
    ir_push(cx, ir_ci(dest, v))

fn str_contains_tensor(ty: &String) -> Int ! alloc
    r = str_contains(ty, "Tensor")
    r

fn parse_tensor_type(ty: &String, b: Int) -> Int ! alloc
    _a = bind_set_tensor(b, 0)
    _b = bind_set_ndims(b, 0)
    _c = bind_set_elem(b, 4)
    if str_contains_tensor(ty) == 0
        0
    else
        _d = bind_set_tensor(b, 1)
        _pl = parse_tensor_place(ty, b)
        parse_tensor_dims(ty, b, 0, 0)

fn parse_tensor_place(ty: &String, b: Int) -> Int ! alloc
    if tensor_ty_on_place(ty, &"p") == 1
        bind_set_place(b, str_as_int(&"p"))
    elsif tensor_ty_on_place(ty, &"gpu") == 1
        bind_set_place(b, str_as_int(&"gpu"))
    elsif tensor_ty_on_place(ty, &"tpu") == 1
        bind_set_place(b, str_as_int(&"tpu"))
    else
        bind_set_place(b, str_as_int(&"cpu"))

fn tensor_ty_on_place(ty: &String, place: &String) -> Int ! alloc
    mid = "on "
    needle = mid + place
    free(mid)
    if str_contains(ty, needle) == 1
        1
    else
        sp = " on "
        needle2 = sp + place
        free(sp)
        r = str_contains(ty, needle2)
        free(needle2)
        r

fn clamp_rb(rb: Int, n: Int) -> Int ! alloc
    if rb < 0
        n
    else
        rb

fn parse_tensor_dims(ty: &String, b: Int, i: Int, first: Int) -> Int ! alloc
    n = str_len(ty)
    lb = find_char(ty, 91, 0, n)
    if lb < 0
        0
    else
        rb = clamp_rb(find_char(ty, 93, lb, n), n)
        inner = str_slice(ty, lb + 1, rb)
        _p = parse_dim_tokens(&inner, b, 0, str_len(inner), 1)
        0

fn skip_spaces(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    else
        c = str_char(s, i)
        if c == 32
            skip_spaces(s, i + 1, n)
        elsif c == 44
            skip_spaces(s, i + 1, n)
        else
            i

fn read_tok_end(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    else
        c = str_char(s, i)
        if c == 32
            i
        elsif c == 44
            i
        else
            read_tok_end(s, i + 1, n)

fn parse_dim_tokens(s: &String, b: Int, i: Int, n: Int, first: Int) -> Int ! alloc
    i2 = skip_spaces(s, i, n)
    if i2 >= n
        0
    else
        j = read_tok_end(s, i2, n)
        tok = str_slice(s, i2, j)
        if first == 1
            if str_eq(tok, "F16") == 1
                _e = bind_set_elem(b, 2)
            elsif str_eq(tok, "BF16") == 1
                _e = bind_set_elem(b, 2)
            elsif str_eq(tok, "I8") == 1
                _e = bind_set_elem(b, 1)
            else
                _e = 0
            free(tok)
            parse_dim_tokens(s, b, j, n, 0)
        else
            nd = bind_ndims(b)
            if nd >= 4
                free(tok)
                0
            else
                dims = bind_dims(b)
                conc = bind_concrete(b)
                if str_eq(tok, "QDYN") == 1
                    _p = vec_push(dims, 0 - 1)
                    _q = vec_push(conc, 0 - 1)
                elsif str_eq(tok, "?") == 1
                    _p = vec_push(dims, 0 - 1)
                    _q = vec_push(conc, 0 - 1)
                elsif is_digit(str_char(tok, 0)) == 1
                    v = parse_int_digits(&tok, 0, str_len(tok), 0)
                    _p = vec_push(dims, v)
                    _q = vec_push(conc, v)
                else
                    _p = vec_push(dims, 0 - 1)
                    _q = vec_push(conc, 0 - 1)
                _n = bind_set_ndims(b, nd + 1)
                free(tok)
                parse_dim_tokens(s, b, j, n, 0)

fn axis_idx(ndims: Int, take_row: Int) -> Int ! alloc
    if take_row == 1
        ndims - 2
    else
        ndims - 1

fn axis_len_from_dim(cx: &mut Cx, tname: Int, dims: Int, conc: Int, idx: Int) -> Int ! alloc
    if idx < vec_len(dims)
        dv = vec_get(dims, idx)
        if dv >= 0
            d = fresh(cx)
            _p = push_const_int(cx, d, dv)
            d
        else
            axis_len_from_conc(cx, tname, conc, idx)
    else
        axis_len_fallback(tname, 0)

fn axis_len_from_conc(cx: &mut Cx, tname: Int, conc: Int, idx: Int) -> Int ! alloc
    if idx < vec_len(conc)
        cv = vec_get(conc, idx)
        if cv >= 0
            d = fresh(cx)
            _p = push_const_int(cx, d, cv)
            d
        else
            axis_len_dim(tname, idx)
    else
        axis_len_dim(tname, idx)

fn axis_len(cx: &mut Cx, tname: Int, take_row: Int) -> Int ! alloc
    b = cx_find(cx, tname)
    if b == 0
        b = bind_for_ssa(cx, tname)
    else
        b = b
    if b == 0
        axis_len_fallback(tname, take_row)
    elsif bind_is_tensor(b) == 0
        axis_len_fallback(tname, take_row)
    elsif bind_ndims(b) < 2
        axis_len_fallback(tname, take_row)
    else
        idx = axis_idx(bind_ndims(b), take_row)
        dims = bind_dims(b)
        conc = bind_concrete(b)
        axis_len_from_dim(cx, tname, dims, conc, idx)

fn axis_len_fallback(tname: Int, take_row: Int) -> Int ! alloc
    idx = axis_idx(2, take_row)
    axis_len_dim(tname, idx)

fn axis_len_dim(tname: Int, idx: Int) -> Int ! alloc
    mid = "_d"
    is_ = int_to_str(idx)
    a = str_from_int(tname) + mid
    r = a + is_
    str_own(&r)

fn fused_op_clone(op: Int) -> Int ! alloc
    if op == 0
        0
    else
        o = vec_new()
        _c = fused_op_clone_go(op, o, 0, vec_len(op))
        o

fn fused_op_clone_go(op: Int, out: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(out, vec_get(op, i))
        fused_op_clone_go(op, out, i + 1, n)

fn fused_ops_clone(ops: Int) -> Int ! alloc
    if ops == 0
        vec_new()
    else
        out = vec_new()
        _c = fused_ops_clone_go(ops, out, 0, vec_len(ops))
        out

fn fused_ops_clone_go(ops: Int, out: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        op2 = fused_op_clone(op)
        _p = vec_push(out, op2)
        fused_ops_clone_go(ops, out, i + 1, n)

fn region_new(place: Int, ops: Int, fused: Int) -> Int ! alloc
    r = vec_new()
    _a = vec_push(r, place)
    _b = vec_push(r, ops)
    _c = vec_push(r, fused)
    _d = vec_push(r, 0)
    _e = vec_push(r, 0)
    _f = vec_push(r, 0)
    _g = vec_push(r, str_as_int(&""))
    r

fn dim_at(dims: Int, d: Int) -> Int ! alloc
    if d < 0
        0 - 1
    elsif d < vec_len(dims)
        vec_get(dims, d)
    else
        0 - 1

fn bind_for_ssa_at(binds: Int, ssa: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(binds, i)
        if str_eq(bind_ssa(b), ssa) == 1
            b
        else
            bind_for_ssa_at(binds, ssa, i + 1, n)

fn bind_for_ssa(cx: &Cx, ssa: Int) -> Int ! alloc
    bind_for_ssa_at(cx_binds(cx), ssa, 0, vec_len(cx_binds(cx)))

# A tensor registered under a key: the variable's own name, or the SSA value it
# holds when that value is itself a registered key (a param or a pseudo binding).
fn ident_is_tensor(cx: &Cx, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        0
    elsif bind_is_tensor(b) == 1
        1
    else
        c = cx_find(cx, bind_ssa(b))
        if c == 0
            ssa_key_is_tensor(cx, bind_ssa(b), 0, vec_len(cx_binds(cx)))
        elsif bind_is_tensor(c) == 1
            1
        else
            ssa_key_is_tensor(cx, bind_ssa(b), 0, vec_len(cx_binds(cx)))

fn ssa_key_is_tensor(cx: &Cx, key: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(cx_binds(cx), i)
        if str_eq(bind_name(b), key) == 1
            if bind_is_tensor(b) == 1
                1
            else
                ssa_key_is_tensor(cx, key, i + 1, n)
        else
            ssa_key_is_tensor(cx, key, i + 1, n)

fn expr_is_tensor(cx: &Cx, e: &Expr) -> Int ! alloc
    match e
        XIdent(name) => ident_is_tensor(cx, str_own(&name))
        XBin(op, l, r) => bin_is_tensor(cx, &l, &r)
        _ => 0

fn bin_is_tensor(cx: &Cx, l: &Expr, r: &Expr) -> Int ! alloc
    if expr_is_tensor(cx, l) == 1
        1
    else
        expr_is_tensor(cx, r)

# Tensor binding for an SSA value (or a variable name): the first tensor binding
# holding that value, as the bootstrap's tensor_info_for_ssa.
fn find_tensor_at(cx: &Cx, key: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(cx_binds(cx), i)
        if bind_is_tensor(b) == 1
            if str_eq(bind_ssa(b), key) == 1
                b
            else
                find_tensor_at(cx, key, i + 1, n)
        else
            find_tensor_at(cx, key, i + 1, n)

fn find_tensor(cx: &Cx, name: Int) -> Int ! alloc
    b = find_tensor_at(cx, name, 0, vec_len(cx_binds(cx)))
    if b != 0
        b
    else
        c = cx_find(cx, name)
        if c == 0
            0
        elsif bind_is_tensor(c) == 1
            c
        else
            0

fn register_tensor_ssa(cx: &Cx, ssa: Int, from: Int) -> Int ! alloc
    b = bind_new(ssa, ssa)
    _t = bind_set_tensor(b, 1)
    _e = bind_set_elem(b, bind_elem(from))
    _p = bind_set_place(b, bind_place(from))
    _n = bind_set_ndims(b, bind_ndims(from))
    dims = bind_dims(from)
    conc = bind_concrete(from)
    i = 0
    register_tensor_ssa_go(b, dims, conc, i, bind_ndims(from))
    _q = vec_push(cx_binds(cx), b)
    0

fn register_tensor_ssa_go(b: Int, dims: Int, conc: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        if i < vec_len(dims)
            _p = vec_push(bind_dims(b), vec_get(dims, i))
        if i < vec_len(conc)
            _q = vec_push(bind_concrete(b), vec_get(conc, i))
        register_tensor_ssa_go(b, dims, conc, i + 1, n)

fn tensor_len_ssa_name(tensor_ssa: Int) -> Int ! alloc
    mid = "_d0"
    a = str_from_int(tensor_ssa) + mid
    str_own(&a)

fn conc_product_go(conc: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        cv = vec_get(conc, i)
        if cv < 0
            0 - 1
        else
            conc_product_go(conc, i + 1, n, acc * cv)

fn tensor_row_len_from_bind(cx: &mut Cx, b: Int) -> Int ! alloc
    conc = bind_concrete(b)
    prod = conc_product_go(conc, 0, vec_len(conc), 1)
    if prod > 0
        d = fresh(cx)
        _p = push_const_int(cx, d, prod)
        d
    else
        axis_len(cx, bind_name(b), 1)

# The tensor bind of the row-length operand `e`: the identifier's own, else the one holding `ssa`.
fn row_len_bind(cx: &Cx, e: &Expr, ssa: Int) -> Int ! alloc
    match e
        XIdent(name) => row_len_ident_bind(cx, &name, ssa)
        _ => find_tensor(cx, ssa)

fn row_len_ident_bind(cx: &Cx, name: &String, ssa: Int) -> Int ! alloc
    b = cx_find(cx, str_own(name))
    if b == 0
        find_tensor(cx, ssa)
    elsif bind_is_tensor(b) == 0
        find_tensor(cx, ssa)
    else
        b

fn row_len_const_one(cx: &mut Cx) -> Int ! alloc
    d = fresh(cx)
    _p = push_const_int(cx, d, 1)
    d

fn tensor_row_len_for_expr(cx: &mut Cx, e: &Expr, ssa: Int) -> Int ! alloc
    match e
        XNone => row_len_const_one(cx)
        _ => row_len_for_some(cx, e, ssa)

fn row_len_for_some(cx: &mut Cx, e: &Expr, ssa: Int) -> Int ! alloc
    b = row_len_bind(cx, e, ssa)
    if b == 0
        row_len_unbound(cx, e, ssa)
    elsif bind_is_tensor(b) == 0
        row_len_const_one(cx)
    else
        tensor_row_len_from_bind(cx, b)

# No tensor bind: a binary looks at its left operand, anything else is a single row.
fn row_len_unbound(cx: &mut Cx, e: &Expr, ssa: Int) -> Int ! alloc
    match e
        XBin(op, l, r) => tensor_row_len_for_expr(cx, &l, ssa)
        _ => row_len_const_one(cx)

fn drop_name_for(inner: &Expr) -> Int ! alloc
    match inner
        XIdent(name) => str_own(&name)
        _ => str_as_int(&"tmp")

# The `else` of an `if` with `elsif` arms: each arm nests as an `if` in the else of the one before.
# The caller frees the returned block, so it must own its lists and exprs. Returning
# `else_b` or an arm body would free the AST the rest of lowering still walks.
fn elsifs_else_block(else_b: &TBlock, arms: &List[TElsif]) -> TBlock ! alloc
    n = list_len(arms)
    if n == 0
        tc_block(else_b)
    else
        elsifs_else_go(else_b, arms, n - 1)

fn elsifs_else_go(else_b: &TBlock, arms: &List[TElsif], i: Int) -> TBlock ! alloc
    arm = list_get(arms, i)
    nested = XIf(tc_expr(&arm.cond), tc_block(&arm.body), tc_block(else_b), 1, list_new[TElsif]())
    blk = TBlock(list_new[TStmt](), nested)
    if i == 0
        blk
    else
        elsifs_else_go(&blk, arms, i - 1)

fn lower_params(cx: &mut Cx, params: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(params, i)
        name = str_own(&pm.name)
        b = bind_new(name, name)
        _p = parse_tensor_type(&pm.ty, b)
        if bind_is_tensor(b) == 1
            _d = add_dim_params(cx, b, 0, bind_ndims(b))
        else
            _d = 0
        _q = vec_push(cx_binds(cx), b)
        _m = map_put(cx_bind_map(cx), name, b)
        _s = tenv_bind(&mut cx.env, &pm.name, &pm.ty)
        lower_params(cx, params, i + 1, n)

fn add_dim_params(cx: &mut Cx, b: Int, d: Int, nd: Int) -> Int ! alloc
    if d >= nd
        0
    else
        dims = bind_dims(b)
        dv = dim_at(dims, d)
        if dv < 0
            cx_dim_params(cx).push(str_from_int(bind_name(b)) + "_d" + d.to_str())
        else
            _p = 0
        add_dim_params(cx, b, d + 1, nd)

fn collect_fn_names(fns: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        f = vec_get(fns, i)
        _p = vec_push(out, vec_get(f, 0))
        collect_fn_names(fns, i + 1, n, out)

fn collect_fn_names_t(fns: &List[TFn], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, str_own(&list_get(fns, i).name))
        collect_fn_names_t(fns, i + 1, n, out)

fn merge_callable_names_go(extra: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        names
    else
        nm = vec_get(extra, i)
        if fn_names_has_at(names, nm, 0, vec_len(names)) == 1
            merge_callable_names_go(extra, i + 1, n, names)
        else
            _p = vec_push(names, nm)
            merge_callable_names_go(extra, i + 1, n, names)

fn merge_callable_names(extra: Int, names: Int) -> Int ! alloc
    merge_callable_names_go(extra, 0, vec_len(extra), names)
