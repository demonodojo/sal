# IR values: instructions, binds, regions, and tensor shapes.
# lower_program lives in fuse.sal so fusion can read this module without an import cycle.
import "../front/lexer.sal"
import "../ast/tast.sal"
import "../ast/ttypes.sal"
import lam

fn II_CI() -> Int
    0

fn II_CS() -> Int
    1

fn II_BIN() -> Int
    2

fn II_CALL() -> Int
    3

fn II_PLACE() -> Int
    4

fn II_RET() -> Int
    5

fn II_DROP() -> Int
    6

fn II_IF() -> Int
    7

fn II_CF() -> Int
    8

fn II_TBIN() -> Int
    9

fn II_WHILE() -> Int
    10

fn II_AGG() -> Int
    11

fn II_EXTRACT() -> Int
    12

fn II_REBIND() -> Int
    13

fn II_EMAKE() -> Int
    14

fn II_EFIELD() -> Int
    15

fn II_SWITCH() -> Int
    16

fn II_TUN() -> Int
    17

fn II_ANYBOX() -> Int
    18

fn II_ANYCALL() -> Int
    19

fn II_ETAG() -> Int
    20

# ---- Lower / IR ----
# Lowering state of one function. The counter, the instruction list and the accumulator name live in
# one-slot lists so a callee can update them; the rest are handle vecs/maps (the IR stays in handles).
# `env` is the typed local environment (`ttypes.sal`), shared by every function of a program.
struct Cx
    ctr: List[Int]
    insts: List[Int]
    acc: List[Int]
    binds: Int
    fn_names: Int
    dim_params: Int
    regions: Int
    bind_map: Int
    fn_map: Int
    literals: Int
    variants: Int
    env: TEnv
    enums: List[TEnum]
    fns: List[TFn]
    protocols: List[TProtocol]
    lams: List[Lam]

fn cx_new(fn_names: Int, fm: Int, env: TEnv, enums: &List[TEnum], fns: &List[TFn], protocols: &List[TProtocol]) -> Cx ! alloc
    ctr = list_new[Int]()
    _a = list_push(&ctr, 0)
    insts = list_new[Int]()
    _b = list_push(&insts, vec_new())
    acc = list_new[Int]()
    _c = list_push(&acc, 0)
    vm = map_new()
    _m = variants_fill(vm, enums, 0, list_len(enums))
    Cx(ctr, insts, acc, vec_new(), fn_names, vec_new(), vec_new(), map_new(), fm, vec_new(), vm, env, enums.clone(), fns.clone(), protocols.clone(), List.new[Lam]())

# `cx` is dropped at the end of its scope, which releases these lists.
# Freeing them here as well is a double free.
fn cx_free(cx: &Cx) -> Int ! alloc
    0

# Variant name -> `[enum name, variant index, field count, tag]`; the first definition wins.
fn cx_variants(cx: &Cx) -> Int ! alloc
    cx.variants

fn variants_fill(m: Int, enums: &List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ed = list_get(enums, i)
        _k = map_put(m, str_own(&("enum:" + ed.name)), 1)
        _a = variants_fill_go(m, str_own(&ed.name), &ed.variants, 0, list_len(&ed.variants))
        variants_fill(m, enums, i + 1, n)

fn variants_fill_go(m: Int, ename: Int, vs: &List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = list_get(vs, i)
        nf = list_len(&v.fields)
        tag = if nf == 0
            if i == 0
                0
            else
                i + 1
        else
            i + 1
        key = str_own(&v.name)
        if map_get(m, key) == 0
            rec = vec_new()
            _a = vec_push(rec, ename)
            _b = vec_push(rec, i)
            _c = vec_push(rec, nf)
            _d = vec_push(rec, tag)
            _e = map_put(m, key, rec)
            variants_fill_go(m, ename, vs, i + 1, n)
        else
            variants_fill_go(m, ename, vs, i + 1, n)

# Tensor literals `[ssa, element texts]` seen while lowering; the IR text has no
# instruction for them, the C backend needs the data.
fn cx_literals(cx: &Cx) -> Int ! alloc
    cx.literals

fn cx_structs(cx: &Cx) -> List[TStruct] ! alloc
    cx.env.structs

# Name of the binding an `x = x + ...` chain accumulates into (0 when none).
fn cx_acc(cx: &Cx) -> Int ! alloc
    list_get(&cx.acc, 0)

fn cx_set_acc(cx: &Cx, name: Int) -> Int ! alloc
    _s = list_set(cx.acc, 0, name)
    0

fn fill_fn_map(m: Int, names: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = map_put(m, vec_get(names, i), 1)
        fill_fn_map(m, names, i + 1, n)

fn cx_bind_map(cx: &Cx) -> Int ! alloc
    cx.bind_map

fn cx_fn_map(cx: &Cx) -> Int ! alloc
    cx.fn_map

fn cx_counter(cx: &Cx) -> Int ! alloc
    list_get(&cx.ctr, 0)

fn cx_set_counter(cx: &Cx, v: Int) -> Int ! alloc
    _s = list_set(cx.ctr, 0, v)
    0

fn cx_insts(cx: &Cx) -> Int ! alloc
    list_get(&cx.insts, 0)

fn cx_set_insts(cx: &Cx, v: Int) -> Int ! alloc
    _s = list_set(cx.insts, 0, v)
    0

fn cx_binds(cx: &Cx) -> Int ! alloc
    cx.binds

fn cx_fn_names(cx: &Cx) -> Int ! alloc
    cx.fn_names

fn cx_dim_params(cx: &Cx) -> Int ! alloc
    cx.dim_params

fn cx_regions(cx: &Cx) -> Int ! alloc
    cx.regions

fn fresh(cx: &Cx) -> Int ! alloc
    n = cx_counter(cx) + 1
    _s = cx_set_counter(cx, n)
    pref = char_to_str(116)
    ns = int_to_str(n)
    r = pref + ns
    free(pref)
    free(ns)
    str_own(&r)

fn ir_ci(dest: Int, v: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_CI())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, v)
    inst

fn ir_cs(dest: Int, text: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_CS())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, text)
    inst

fn ir_bin(dest: Int, op: Int, left: Int, right: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_BIN())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, op)
    _d = vec_push(inst, left)
    _e = vec_push(inst, right)
    inst

fn ir_cf(dest: Int, bits: Int, txt: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_CF())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, bits)
    _d = vec_push(inst, txt)
    inst

fn ir_tbin(dest: Int, op: Int, elem: Int, place: Int, left: Int, right: Int, len: Int, scalar: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_TBIN())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, op)
    _d = vec_push(inst, elem)
    _e = vec_push(inst, place)
    _f = vec_push(inst, left)
    _g = vec_push(inst, right)
    _h = vec_push(inst, len)
    _i = vec_push(inst, scalar)
    inst

# `TensorUnary`: `op` (only `neg`) over the tensor `input`, `len` elements of `elem`.
fn ir_tun(dest: Int, op: Int, elem: Int, place: Int, input: Int, len: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_TUN())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, op)
    _d = vec_push(inst, elem)
    _e = vec_push(inst, place)
    _f = vec_push(inst, input)
    _g = vec_push(inst, len)
    inst

fn ir_agg(dest: Int, sname: Int, fields: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_AGG())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, sname)
    _d = vec_push(inst, fields)
    inst

fn ir_extract(dest: Int, base: Int, sname: Int, idx: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_EXTRACT())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, base)
    _d = vec_push(inst, sname)
    _e = vec_push(inst, idx)
    inst

fn ir_emake(dest: Int, ename: Int, vidx: Int, payload: Int, owned: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_EMAKE())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, ename)
    _d = vec_push(inst, vidx)
    _e = vec_push(inst, payload)
    _f = vec_push(inst, owned)
    inst

fn ir_efield(dest: Int, value: Int, idx: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_EFIELD())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, value)
    _d = vec_push(inst, idx)
    inst

# `EnumTag`: the low tag byte of an enum value.
fn ir_etag(dest: Int, value: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_ETAG())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, value)
    inst

# `arms` are `[tag, body, value]`.
fn ir_switch(dest: Int, scrut: Int, arms: Int, default_body: Int, default_val: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_SWITCH())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, scrut)
    _d = vec_push(inst, arms)
    _e = vec_push(inst, default_body)
    _f = vec_push(inst, default_val)
    inst

fn ir_anybox(dest: Int, vtable: Int, payload: Int, drop_slot: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_ANYBOX())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, vtable)
    _d = vec_push(inst, payload)
    _e = vec_push(inst, drop_slot)
    inst

fn ir_anycall(dest: Int, receiver: Int, slot: Int, args: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_ANYCALL())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, receiver)
    _d = vec_push(inst, slot)
    _e = vec_push(inst, args)
    inst

fn ir_call_free(arg: Int) -> Int ! alloc
    ir_call_named(arg, str_as_int(&"sal_free"))

# A call of the runtime function `func` (a handle) on `arg`, for a release.
fn ir_call_named(arg: Int, func: Int) -> Int ! alloc
    args = vec_new()
    _a = vec_push(args, arg)
    ir_call(0, func, args, 0)

fn ir_call(dest: Int, func: Int, args: Int, has_dest: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_CALL())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, func)
    _d = vec_push(inst, args)
    _e = vec_push(inst, has_dest)
    inst

# A call whose tensor shape the C emitter needs (`shape` = vec [rows, cols, axis], -1 when unknown).
# The slot is not printed: the IR text is the bootstrap's.
fn ir_call_shaped(dest: Int, func: Int, args: Int, has_dest: Int, shape: Int) -> Int ! alloc
    inst = ir_call(dest, func, args, has_dest)
    _a = vec_push(inst, shape)
    inst

fn ir_place(dest: Int, fr: Int, to_pl: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_PLACE())
    _b = vec_push(inst, dest)
    _c = vec_push(inst, fr)
    _d = vec_push(inst, to_pl)
    inst

fn ir_ret(val: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_RET())
    _b = vec_push(inst, val)
    inst

fn ir_drop(name: Int) -> Int ! alloc
    inst = vec_new()
    _a = vec_push(inst, II_DROP())
    _b = vec_push(inst, name)
    inst

# A string the instruction keeps. Small integers (opcodes, lengths, tags) stay as they are.
# The IR keeps its own copy of the text: the copy is bound to a local that `str_as_int` hands
# to the IR (escapes), so no release frees it. A temporary here would be freed at the statement.
fn ir_text(p: Int) -> Int ! alloc
    if p < 4096
        p
    else
        copy = strdup(str_from_int(p))
        str_own(&copy)

fn ir_set_text(h: Int, i: Int) -> Int ! alloc
    if i >= vec_len(h)
        0
    else
        _s = vec_set(h, i, ir_text(vec_get(h, i)))
        0

fn ir_own_strvec(hs: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_strvec_go(hs, 0, vec_len(hs))

fn ir_own_strvec_go(hs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _s = ir_set_text(hs, i)
        ir_own_strvec_go(hs, i + 1, n)

fn ir_own_rows(hs: Int, nslots: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_rows_go(hs, nslots, 0, vec_len(hs))

fn ir_own_rows_go(hs: Int, nslots: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        row = vec_get(hs, i)
        _a = ir_own_row_slots(row, 0, nslots)
        ir_own_rows_go(hs, nslots, i + 1, n)

fn ir_own_row_slots(row: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _s = ir_set_text(row, i)
        ir_own_row_slots(row, i + 1, n)

# Switch arms are `[tag, body, value]`: the tag stays, the body is instructions, the value is text.
fn ir_own_arms(hs: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_arms_go(hs, 0, vec_len(hs))

fn ir_own_arms_go(hs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = vec_get(hs, i)
        _b = ir_own_insts(vec_get(a, 1))
        _v = ir_set_text(a, 2)
        ir_own_arms_go(hs, i + 1, n)

fn ir_own_ops(hs: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_ops_go(hs, 0, vec_len(hs))

fn ir_own_ops_go(hs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(hs, i)
        _a = ir_own_row_slots(op, 1, vec_len(op))
        ir_own_ops_go(hs, i + 1, n)

fn ir_own_insts(hs: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_insts_go(hs, 0, vec_len(hs))

fn ir_own_insts_go(hs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = ir_own_inst(vec_get(hs, i))
        ir_own_insts_go(hs, i + 1, n)

# Copies the text slots `ti_inst` reads. Integer slots (tags, lengths, elem codes) stay.
fn ir_own_inst(h: Int) -> Int ! alloc
    if h == 0
        0
    else
        ir_own_inst_go(h, vec_get(h, 0))

fn ir_own_inst_go(h: Int, k: Int) -> Int ! alloc
    if k == II_CI()
        ir_set_text(h, 1)
    elsif k == II_CS()
        _a = ir_set_text(h, 1)
        ir_set_text(h, 2)
    elsif k == II_BIN()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        _c = ir_set_text(h, 3)
        ir_set_text(h, 4)
    elsif k == II_CF()
        _a = ir_set_text(h, 1)
        ir_set_text(h, 3)
    elsif k == II_TBIN()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        _c = ir_set_text(h, 4)
        _d = ir_set_text(h, 5)
        _e = ir_set_text(h, 6)
        ir_set_text(h, 7)
    elsif k == II_TUN()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        _c = ir_set_text(h, 4)
        _d = ir_set_text(h, 5)
        ir_set_text(h, 6)
    elsif k == II_CALL()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_own_strvec(vec_get(h, 3))
    elsif k == II_PLACE()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_set_text(h, 3)
    elsif k == II_RET()
        ir_set_text(h, 1)
    elsif k == II_DROP()
        ir_set_text(h, 1)
    elsif k == II_IF()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        _c = ir_own_insts(vec_get(h, 3))
        _d = ir_own_insts(vec_get(h, 4))
        _e = ir_set_text(h, 5)
        _f = ir_set_text(h, 6)
        ir_own_rows(vec_get(h, 7), 3)
    elsif k == II_WHILE()
        _a = ir_own_insts(vec_get(h, 1))
        _b = ir_set_text(h, 2)
        _c = ir_own_insts(vec_get(h, 3))
        ir_own_rows(vec_get(h, 4), 3)
    elsif k == II_AGG()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_own_strvec(vec_get(h, 3))
    elsif k == II_EXTRACT()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_set_text(h, 3)
    elsif k == II_REBIND()
        _a = ir_set_text(h, 1)
        ir_set_text(h, 2)
    elsif k == II_EMAKE()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_own_strvec(vec_get(h, 4))
    elsif k == II_EFIELD()
        _a = ir_set_text(h, 1)
        ir_set_text(h, 2)
    elsif k == II_ETAG()
        _a = ir_set_text(h, 1)
        ir_set_text(h, 2)
    elsif k == II_SWITCH()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        _c = ir_own_arms(vec_get(h, 3))
        _d = ir_own_insts(vec_get(h, 4))
        ir_set_text(h, 5)
    elsif k == II_ANYBOX()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_set_text(h, 3)
    elsif k == II_ANYCALL()
        _a = ir_set_text(h, 1)
        _b = ir_set_text(h, 2)
        ir_own_strvec(vec_get(h, 4))
    else
        0

fn ir_own_regions(hs: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_regions_go(hs, 0, vec_len(hs))

fn ir_own_regions_go(hs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        r = vec_get(hs, i)
        _p = ir_set_text(r, 0)
        _o = ir_own_ops(vec_get(r, 1))
        _s = ir_set_text(r, 6)
        ir_own_regions_go(hs, i + 1, n)

fn ir_own_lits(hs: Int) -> Int ! alloc
    if hs == 0
        0
    else
        ir_own_lits_go(hs, 0, vec_len(hs))

fn ir_own_lits_go(hs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        lit = vec_get(hs, i)
        _n = ir_set_text(lit, 0)
        _d = ir_own_strvec(vec_get(lit, 1))
        ir_own_lits_go(hs, i + 1, n)

# `[name, dim params, insts, regions, literals]`. Each text slot becomes a copy.
fn ir_own_fn(f: Int) -> Int ! alloc
    _n = ir_set_text(f, 0)
    _d = ir_own_strvec(vec_get(f, 1))
    _i = ir_own_insts(vec_get(f, 2))
    _r = ir_own_regions(vec_get(f, 3))
    ir_own_lits(vec_get(f, 4))

fn ir_push(cx: &Cx, inst: Int) -> Int ! alloc
    _p = vec_push(cx_insts(cx), inst)
    0

fn bind_new(name: Int, ssa: Int) -> Int ! alloc
    b = vec_new()
    _a = vec_push(b, name)
    _b = vec_push(b, ssa)
    _c = vec_push(b, 0)
    _d = vec_push(b, 0)
    _e = vec_push(b, vec_new())
    _f = vec_push(b, vec_new())
    _g = vec_push(b, 4)
    _h = vec_push(b, str_as_int(&"cpu"))
    b

fn bind_place(b: Int) -> Int ! alloc
    vec_get(b, 7)

fn bind_set_place(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 7, v)
    0

fn bind_name(b: Int) -> Int ! alloc
    vec_get(b, 0)

fn bind_ssa(b: Int) -> Int ! alloc
    vec_get(b, 1)

fn bind_set_ssa(b: Int, s: Int) -> Int ! alloc
    _s = vec_set(b, 1, s)
    0

fn bind_is_tensor(b: Int) -> Int ! alloc
    vec_get(b, 2)

fn bind_set_tensor(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 2, v)
    0

fn bind_ndims(b: Int) -> Int ! alloc
    vec_get(b, 3)

fn bind_set_ndims(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 3, v)
    0

fn bind_dims(b: Int) -> Int ! alloc
    vec_get(b, 4)

fn bind_concrete(b: Int) -> Int ! alloc
    vec_get(b, 5)

fn bind_elem(b: Int) -> Int ! alloc
    vec_get(b, 6)

fn bind_set_elem(b: Int, v: Int) -> Int ! alloc
    _s = vec_set(b, 6, v)
    0

fn cx_find_at(binds: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(binds, i)
        if str_eq(bind_name(b), name) == 1
            b
        else
            cx_find_at(binds, name, i + 1, n)

fn cx_find(cx: &Cx, name: Int) -> Int ! alloc
    map_get(cx_bind_map(cx), name)

fn cx_lookup(cx: &Cx, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        name
    else
        bind_ssa(b)

fn cx_bind(cx: &Cx, name: Int, ssa: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        b = bind_new(name, ssa)
        _p = vec_push(cx_binds(cx), b)
        _q = map_put(cx_bind_map(cx), name, b)
        0
    else
        bind_set_ssa(b, ssa)

fn fn_names_has_at(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        fn_names_has_at(names, name, i + 1, n)

fn is_user_fn(cx: &Cx, name: Int) -> Int ! alloc
    if map_get(cx_fn_map(cx), name) == 0
        0
    else
        1

# List and dict operations always hit the runtime; prelude bodies are signatures only.
fn is_container_op(fname: Int) -> Int ! alloc
    if str_eq(fname, "list_new") == 1
        1
    elsif str_eq(fname, "list_push") == 1
        1
    elsif str_eq(fname, "list_len") == 1
        1
    elsif str_eq(fname, "list_get") == 1
        1
    elsif str_eq(fname, "dict_new") == 1
        1
    elsif str_eq(fname, "dict_put") == 1
        1
    elsif str_eq(fname, "dict_get") == 1
        1
    else
        0

fn runtime_name(cx: &Cx, fname: Int) -> Int ! alloc
    if str_eq(str_from_int(fname), "list_clone") == 1
        str_as_int(&"sal_list_clone_val")
    elsif str_eq(str_from_int(fname), "dict_clone") == 1
        str_as_int(&"sal_dict_clone_val")
    elsif str_eq(str_from_int(fname), "bytes_clone") == 1
        str_as_int(&"sal_bytes_clone_val")
    elsif str_eq(str_from_int(fname), "enum_copy") == 1
        str_as_int(&"sal_enum_copy")
    elsif is_container_op(fname) == 1
        str_own(&("sal_" + str_from_int(fname)))
    elsif is_user_fn(cx, fname) == 1
        fname
    elsif str_eq(str_from_int(fname), "matmul") == 1
        str_as_int(&"sal_matmul_f32")
    else
        pref = "sal_"
        str_own(&(pref + str_from_int(fname)))

fn ir_call_unary(cx: &Cx, rname: Int, src: Int) -> Int ! alloc
    out = fresh(cx)
    argv = vec_new()
    _a = vec_push(argv, src)
    _p = ir_push(cx, ir_call(out, rname, argv, 1))
    out

fn push_const_int(cx: &Cx, dest: Int, v: Int) -> Int ! alloc
    ir_push(cx, ir_ci(dest, v))

fn str_contains_tensor(ty: &String) -> Int ! alloc
    r = str_contains(ty, "Tensor")
    r

fn parse_tensor_type(ty: &String, b: Int) -> Int ! alloc
    _a = bind_set_tensor(b, 0)
    _b = bind_set_ndims(b, 0)
    _c = bind_set_elem(b, 4)
    if str_contains_tensor(ty) == 0
        0
    else
        _d = bind_set_tensor(b, 1)
        _pl = parse_tensor_place(ty, b)
        parse_tensor_dims(ty, b, 0, 0)

fn parse_tensor_place(ty: &String, b: Int) -> Int ! alloc
    if tensor_ty_on_place(ty, &"p") == 1
        bind_set_place(b, str_as_int(&"p"))
    elsif tensor_ty_on_place(ty, &"gpu") == 1
        bind_set_place(b, str_as_int(&"gpu"))
    elsif tensor_ty_on_place(ty, &"tpu") == 1
        bind_set_place(b, str_as_int(&"tpu"))
    else
        bind_set_place(b, str_as_int(&"cpu"))

fn tensor_ty_on_place(ty: &String, place: &String) -> Int ! alloc
    mid = "on "
    needle = mid + place
    free(mid)
    if str_contains(ty, needle) == 1
        1
    else
        sp = " on "
        needle2 = sp + place
        free(sp)
        r = str_contains(ty, needle2)
        free(needle2)
        r

fn clamp_rb(rb: Int, n: Int) -> Int ! alloc
    if rb < 0
        n
    else
        rb

fn parse_tensor_dims(ty: &String, b: Int, i: Int, first: Int) -> Int ! alloc
    n = str_len(ty)
    lb = find_char(ty, 91, 0, n)
    if lb < 0
        0
    else
        rb = clamp_rb(find_char(ty, 93, lb, n), n)
        inner = str_slice(ty, lb + 1, rb)
        _p = parse_dim_tokens(&inner, b, 0, str_len(inner), 1)
        0

fn skip_spaces(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    else
        c = str_char(s, i)
        if c == 32
            skip_spaces(s, i + 1, n)
        elsif c == 44
            skip_spaces(s, i + 1, n)
        else
            i

fn read_tok_end(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    else
        c = str_char(s, i)
        if c == 32
            i
        elsif c == 44
            i
        else
            read_tok_end(s, i + 1, n)

fn parse_dim_tokens(s: &String, b: Int, i: Int, n: Int, first: Int) -> Int ! alloc
    i2 = skip_spaces(s, i, n)
    if i2 >= n
        0
    else
        j = read_tok_end(s, i2, n)
        tok = str_slice(s, i2, j)
        if first == 1
            if str_eq(tok, "F16") == 1
                _e = bind_set_elem(b, 2)
            elsif str_eq(tok, "BF16") == 1
                _e = bind_set_elem(b, 2)
            elsif str_eq(tok, "I8") == 1
                _e = bind_set_elem(b, 1)
            else
                _e = 0
            free(tok)
            parse_dim_tokens(s, b, j, n, 0)
        else
            nd = bind_ndims(b)
            if nd >= 4
                free(tok)
                0
            else
                dims = bind_dims(b)
                conc = bind_concrete(b)
                if str_eq(tok, "QDYN") == 1
                    _p = vec_push(dims, 0 - 1)
                    _q = vec_push(conc, 0 - 1)
                elsif str_eq(tok, "?") == 1
                    _p = vec_push(dims, 0 - 1)
                    _q = vec_push(conc, 0 - 1)
                elsif is_digit(str_char(tok, 0)) == 1
                    v = parse_int_digits(&tok, 0, str_len(tok), 0)
                    _p = vec_push(dims, v)
                    _q = vec_push(conc, v)
                else
                    _p = vec_push(dims, 0 - 1)
                    _q = vec_push(conc, 0 - 1)
                _n = bind_set_ndims(b, nd + 1)
                free(tok)
                parse_dim_tokens(s, b, j, n, 0)

fn axis_idx(ndims: Int, take_row: Int) -> Int ! alloc
    if take_row == 1
        ndims - 2
    else
        ndims - 1

fn axis_len_from_dim(cx: &Cx, tname: Int, dims: Int, conc: Int, idx: Int) -> Int ! alloc
    if idx < vec_len(dims)
        dv = vec_get(dims, idx)
        if dv >= 0
            d = fresh(cx)
            _p = push_const_int(cx, d, dv)
            d
        else
            axis_len_from_conc(cx, tname, conc, idx)
    else
        axis_len_fallback(tname, 0)

fn axis_len_from_conc(cx: &Cx, tname: Int, conc: Int, idx: Int) -> Int ! alloc
    if idx < vec_len(conc)
        cv = vec_get(conc, idx)
        if cv >= 0
            d = fresh(cx)
            _p = push_const_int(cx, d, cv)
            d
        else
            axis_len_dim(tname, idx)
    else
        axis_len_dim(tname, idx)

fn axis_len(cx: &Cx, tname: Int, take_row: Int) -> Int ! alloc
    b = cx_find(cx, tname)
    if b == 0
        b = bind_for_ssa(cx, tname)
    else
        b = b
    if b == 0
        axis_len_fallback(tname, take_row)
    elsif bind_is_tensor(b) == 0
        axis_len_fallback(tname, take_row)
    elsif bind_ndims(b) < 2
        axis_len_fallback(tname, take_row)
    else
        idx = axis_idx(bind_ndims(b), take_row)
        dims = bind_dims(b)
        conc = bind_concrete(b)
        axis_len_from_dim(cx, tname, dims, conc, idx)

fn axis_len_fallback(tname: Int, take_row: Int) -> Int ! alloc
    idx = axis_idx(2, take_row)
    axis_len_dim(tname, idx)

fn axis_len_dim(tname: Int, idx: Int) -> Int ! alloc
    mid = "_d"
    is_ = int_to_str(idx)
    a = str_from_int(tname) + mid
    r = a + is_
    str_own(&r)

fn fused_op_clone(op: Int) -> Int ! alloc
    if op == 0
        0
    else
        o = vec_new()
        _c = fused_op_clone_go(op, o, 0, vec_len(op))
        o

fn fused_op_clone_go(op: Int, out: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(out, vec_get(op, i))
        fused_op_clone_go(op, out, i + 1, n)

fn fused_ops_clone(ops: Int) -> Int ! alloc
    if ops == 0
        vec_new()
    else
        out = vec_new()
        _c = fused_ops_clone_go(ops, out, 0, vec_len(ops))
        out

fn fused_ops_clone_go(ops: Int, out: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        op2 = fused_op_clone(op)
        _p = vec_push(out, op2)
        fused_ops_clone_go(ops, out, i + 1, n)

fn region_new(place: Int, ops: Int, fused: Int) -> Int ! alloc
    r = vec_new()
    _a = vec_push(r, place)
    _b = vec_push(r, ops)
    _c = vec_push(r, fused)
    _d = vec_push(r, 0)
    _e = vec_push(r, 0)
    _f = vec_push(r, 0)
    _g = vec_push(r, str_as_int(&""))
    r

fn dim_at(dims: Int, d: Int) -> Int ! alloc
    if d < 0
        0 - 1
    elsif d < vec_len(dims)
        vec_get(dims, d)
    else
        0 - 1

fn bind_for_ssa_at(binds: Int, ssa: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(binds, i)
        if str_eq(bind_ssa(b), ssa) == 1
            b
        else
            bind_for_ssa_at(binds, ssa, i + 1, n)

fn bind_for_ssa(cx: &Cx, ssa: Int) -> Int ! alloc
    bind_for_ssa_at(cx_binds(cx), ssa, 0, vec_len(cx_binds(cx)))

# A tensor registered under a key: the variable's own name, or the SSA value it
# holds when that value is itself a registered key (a param or a pseudo binding).
fn ident_is_tensor(cx: &Cx, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        0
    elsif bind_is_tensor(b) == 1
        1
    else
        c = cx_find(cx, bind_ssa(b))
        if c == 0
            ssa_key_is_tensor(cx, bind_ssa(b), 0, vec_len(cx_binds(cx)))
        elsif bind_is_tensor(c) == 1
            1
        else
            ssa_key_is_tensor(cx, bind_ssa(b), 0, vec_len(cx_binds(cx)))

fn ssa_key_is_tensor(cx: &Cx, key: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(cx_binds(cx), i)
        if str_eq(bind_name(b), key) == 1
            if bind_is_tensor(b) == 1
                1
            else
                ssa_key_is_tensor(cx, key, i + 1, n)
        else
            ssa_key_is_tensor(cx, key, i + 1, n)

fn expr_is_tensor(cx: &Cx, e: &Expr) -> Int ! alloc
    match e
        XIdent(name) => ident_is_tensor(cx, str_own(&name))
        XBin(op, l, r) => bin_is_tensor(cx, &l, &r)
        _ => 0

fn bin_is_tensor(cx: &Cx, l: &Expr, r: &Expr) -> Int ! alloc
    if expr_is_tensor(cx, l) == 1
        1
    else
        expr_is_tensor(cx, r)

# Tensor binding for an SSA value (or a variable name): the first tensor binding
# holding that value, as the bootstrap's tensor_info_for_ssa.
fn find_tensor_at(cx: &Cx, key: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(cx_binds(cx), i)
        if bind_is_tensor(b) == 1
            if str_eq(bind_ssa(b), key) == 1
                b
            else
                find_tensor_at(cx, key, i + 1, n)
        else
            find_tensor_at(cx, key, i + 1, n)

fn find_tensor(cx: &Cx, name: Int) -> Int ! alloc
    b = find_tensor_at(cx, name, 0, vec_len(cx_binds(cx)))
    if b != 0
        b
    else
        c = cx_find(cx, name)
        if c == 0
            0
        elsif bind_is_tensor(c) == 1
            c
        else
            0

fn register_tensor_ssa(cx: &Cx, ssa: Int, from: Int) -> Int ! alloc
    b = bind_new(ssa, ssa)
    _t = bind_set_tensor(b, 1)
    _e = bind_set_elem(b, bind_elem(from))
    _p = bind_set_place(b, bind_place(from))
    _n = bind_set_ndims(b, bind_ndims(from))
    dims = bind_dims(from)
    conc = bind_concrete(from)
    i = 0
    register_tensor_ssa_go(b, dims, conc, i, bind_ndims(from))
    _q = vec_push(cx_binds(cx), b)
    0

fn register_tensor_ssa_go(b: Int, dims: Int, conc: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        if i < vec_len(dims)
            _p = vec_push(bind_dims(b), vec_get(dims, i))
        if i < vec_len(conc)
            _q = vec_push(bind_concrete(b), vec_get(conc, i))
        register_tensor_ssa_go(b, dims, conc, i + 1, n)

fn tensor_len_ssa_name(tensor_ssa: Int) -> Int ! alloc
    mid = "_d0"
    a = str_from_int(tensor_ssa) + mid
    str_own(&a)

fn conc_product_go(conc: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        cv = vec_get(conc, i)
        if cv < 0
            0 - 1
        else
            conc_product_go(conc, i + 1, n, acc * cv)

fn tensor_row_len_from_bind(cx: &Cx, b: Int) -> Int ! alloc
    conc = bind_concrete(b)
    prod = conc_product_go(conc, 0, vec_len(conc), 1)
    if prod > 0
        d = fresh(cx)
        _p = push_const_int(cx, d, prod)
        d
    else
        axis_len(cx, bind_name(b), 1)

# The tensor bind of the row-length operand `e`: the identifier's own, else the one holding `ssa`.
fn row_len_bind(cx: &Cx, e: &Expr, ssa: Int) -> Int ! alloc
    match e
        XIdent(name) => row_len_ident_bind(cx, &name, ssa)
        _ => find_tensor(cx, ssa)

fn row_len_ident_bind(cx: &Cx, name: &String, ssa: Int) -> Int ! alloc
    b = cx_find(cx, str_own(name))
    if b == 0
        find_tensor(cx, ssa)
    elsif bind_is_tensor(b) == 0
        find_tensor(cx, ssa)
    else
        b

fn row_len_const_one(cx: &Cx) -> Int ! alloc
    d = fresh(cx)
    _p = push_const_int(cx, d, 1)
    d

fn tensor_row_len_for_expr(cx: &Cx, e: &Expr, ssa: Int) -> Int ! alloc
    match e
        XNone => row_len_const_one(cx)
        _ => row_len_for_some(cx, e, ssa)

fn row_len_for_some(cx: &Cx, e: &Expr, ssa: Int) -> Int ! alloc
    b = row_len_bind(cx, e, ssa)
    if b == 0
        row_len_unbound(cx, e, ssa)
    elsif bind_is_tensor(b) == 0
        row_len_const_one(cx)
    else
        tensor_row_len_from_bind(cx, b)

# No tensor bind: a binary looks at its left operand, anything else is a single row.
fn row_len_unbound(cx: &Cx, e: &Expr, ssa: Int) -> Int ! alloc
    match e
        XBin(op, l, r) => tensor_row_len_for_expr(cx, &l, ssa)
        _ => row_len_const_one(cx)

fn drop_name_for(inner: &Expr) -> Int ! alloc
    match inner
        XIdent(name) => str_own(&name)
        _ => str_as_int(&"tmp")

# The `else` of an `if` with `elsif` arms: each arm nests as an `if` in the else of the one before.
# The caller frees the returned block, so it must own its lists and exprs. Returning
# `else_b` or an arm body would free the AST the rest of lowering still walks.
fn elsifs_else_block(else_b: &TBlock, arms: &List[TElsif]) -> TBlock ! alloc
    n = list_len(arms)
    if n == 0
        tc_block(else_b)
    else
        elsifs_else_go(else_b, arms, n - 1)

fn elsifs_else_go(else_b: &TBlock, arms: &List[TElsif], i: Int) -> TBlock ! alloc
    arm = list_get(arms, i)
    nested = XIf(tc_expr(&arm.cond), tc_block(&arm.body), tc_block(else_b), 1, list_new[TElsif]())
    blk = TBlock(list_new[TStmt](), nested)
    if i == 0
        blk
    else
        elsifs_else_go(&blk, arms, i - 1)

fn lower_params(cx: &Cx, params: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(params, i)
        name = str_own(&pm.name)
        b = bind_new(name, name)
        _p = parse_tensor_type(&pm.ty, b)
        if bind_is_tensor(b) == 1
            _d = add_dim_params(cx, b, 0, bind_ndims(b))
        else
            _d = 0
        _q = vec_push(cx_binds(cx), b)
        _m = map_put(cx_bind_map(cx), name, b)
        _s = tenv_bind(&cx.env, &pm.name, &pm.ty)
        lower_params(cx, params, i + 1, n)

fn add_dim_params(cx: &Cx, b: Int, d: Int, nd: Int) -> Int ! alloc
    if d >= nd
        0
    else
        dims = bind_dims(b)
        dv = dim_at(dims, d)
        if dv < 0
            mid = "_d"
            ds = int_to_str(d)
            bn = str_from_int(bind_name(b))
            a = bn + mid
            nm = a + ds
            _p = vec_push(cx_dim_params(cx), str_own(&nm))
        else
            _p = 0
        add_dim_params(cx, b, d + 1, nd)

fn collect_fn_names(fns: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        f = vec_get(fns, i)
        _p = vec_push(out, vec_get(f, 0))
        collect_fn_names(fns, i + 1, n, out)

fn collect_fn_names_t(fns: &List[TFn], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, str_own(&list_get(fns, i).name))
        collect_fn_names_t(fns, i + 1, n, out)

fn merge_callable_names_go(extra: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        names
    else
        nm = vec_get(extra, i)
        if fn_names_has_at(names, nm, 0, vec_len(names)) == 1
            merge_callable_names_go(extra, i + 1, n, names)
        else
            _p = vec_push(names, nm)
            merge_callable_names_go(extra, i + 1, n, names)

fn merge_callable_names(extra: Int, names: Int) -> Int ! alloc
    merge_callable_names_go(extra, 0, vec_len(extra), names)
