# Shape-aware lowering of the tensor builtins, the mirror of the matching arms
# of lower_expr in src/ir.rs. Each op reads the shapes of its operands from the
# bindings, emits the same instructions, and registers the shape of its result.
import "../ast/tast.sal"
import ir

fn vec_copy(src: Int) -> Int ! alloc
    out = vec_new()
    _c = copy_into(src, out, 0, vec_len(src))
    out

fn copy_into(src: Int, dst: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        copy_into(src, dst, i + 1, n)

# Register the shape of SSA value `ssa`; dims use -1 for a dynamic axis.
fn reg_tensor(cx: &mut Cx, ssa: Int, elem: Int, place: Int, dims: Int, conc: Int) -> Int ! alloc
    b = bind_new(ssa, ssa)
    _t = bind_set_tensor(b, 1)
    _e = bind_set_elem(b, elem)
    _p = bind_set_place(b, place)
    _n = bind_set_ndims(b, vec_len(dims))
    _d = copy_into(dims, bind_dims(b), 0, vec_len(dims))
    _c = copy_into(conc, bind_concrete(b), 0, vec_len(conc))
    _q = vec_push(cx_binds(cx), b)
    0

# Same shape as `src`, for results that keep their operand's type.
fn reg_like(cx: &mut Cx, ssa: Int, src: Int) -> Int ! alloc
    if src == 0
        0
    else
        reg_tensor(cx, ssa, bind_elem(src), bind_place(src), vec_copy(bind_dims(src)), vec_copy(bind_concrete(src)))

# `ir_rebind` lives in ir.sal (returns `Inst`).

fn push_call(cx: &mut Cx, dest: Int, fname: &String, args: Int, has_dest: Int) -> Int ! alloc
    ir_push(cx, ir_call(dest, str_own(fname), args, has_dest))

fn const_dim(cx: &mut Cx, n: Int) -> Int ! alloc
    d = fresh(cx)
    _p = push_const_int(cx, d, n)
    d

fn int_text(n: Int) -> Int ! alloc
    str_own(&int_to_str(n))

# ---- matmul ----
fn matmul_lead_go(cx: &mut Cx, b: Int, name: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        next = axis_len_from_dim(cx, name, bind_dims(b), bind_concrete(b), i)
        r = fresh(cx)
        _p = ir_push(cx, ir_bin(r, str_as_int(&"mul"), acc, next))
        matmul_lead_go(cx, b, name, i + 1, n, r)

# Batch `m`: the product of every leading axis but the last two.
fn matmul_batch_m(cx: &mut Cx, lhs: Int) -> Int ! alloc
    b = find_tensor(cx, lhs)
    if b == 0
        const_dim(cx, 1)
    elsif bind_ndims(b) <= 2
        axis_len(cx, lhs, 1)
    else
        first = axis_len_from_dim(cx, lhs, bind_dims(b), bind_concrete(b), 0)
        matmul_lead_go(cx, b, lhs, 1, bind_ndims(b) - 2, first)

fn matmul_dims(cx: &mut Cx, lhs: Int, rhs: Int) -> Int ! alloc
    out = vec_new()
    _m = vec_push(out, matmul_batch_m(cx, lhs))
    _k = vec_push(out, axis_len(cx, lhs, 0))
    _n = vec_push(out, axis_len(cx, rhs, 0))
    out

fn matmul_out_conc(lb: Int, rb: Int, n: Int, out: Int) -> Int ! alloc
    last = bind_ndims(rb) - 1
    i = 0
    _c = copy_into(bind_concrete(lb), out, 0, n)
    if bind_ndims(rb) > 0
        dv = vec_get(bind_dims(rb), last)
        if dv >= 0
            vec_push(out, dv)
        else
            vec_push(out, vec_get(bind_concrete(rb), last))
    else
        0

# The dimension constants come before the result, as in the bootstrap's numbering.
fn lower_matmul_op(cx: &mut Cx, arg_names: Int) -> Int ! alloc
    lhs = vec_get(arg_names, 0)
    rhs = vec_get(arg_names, 1)
    mkn = matmul_dims(cx, lhs, rhs)
    d = fresh(cx)
    args = vec_new()
    _a = vec_push(args, lhs)
    _b = vec_push(args, rhs)
    _c = vec_push(args, vec_get(mkn, 0))
    _d = vec_push(args, vec_get(mkn, 1))
    _e = vec_push(args, vec_get(mkn, 2))
    lb = find_tensor(cx, lhs)
    fname = "sal_matmul_f32"
    if lb != 0
        if bind_elem(lb) == 2
            fname = "sal_matmul_f16"
        else
            fname = fname
    else
        fname = fname
    _p = push_call(cx, d, &fname, args, 1)
    rb = find_tensor(cx, rhs)
    _rg = lower_matmul_register(cx, d, lb, rb)
    d

fn lower_matmul_register(cx: &mut Cx, d: Int, lb: Int, rb: Int) -> Int ! alloc
    if lb != 0
        if rb != 0
            if bind_ndims(lb) >= 2
                if bind_ndims(rb) >= 2
                    nl = bind_ndims(lb) - 1
                    dims = vec_new()
                    _x = copy_into(bind_dims(lb), dims, 0, nl)
                    last = bind_ndims(rb) - 1
                    _y = vec_push(dims, vec_get(bind_dims(rb), last))
                    conc = vec_new()
                    _z = matmul_out_conc(lb, rb, nl, conc)
                    reg_tensor(cx, d, bind_elem(lb), bind_place(lb), dims, conc)
                else
                    0
            else
                0
        else
            0
    else
        0

fn lower_qmatmul_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    a = vec_get(arg_names, 0)
    w = vec_get(arg_names, 1)
    mkn = matmul_dims(cx, a, w)
    args = vec_new()
    _a = vec_push(args, a)
    _b = vec_push(args, w)
    _c = vec_push(args, vec_get(arg_names, 2))
    _d = vec_push(args, vec_get(arg_names, 3))
    _e = vec_push(args, vec_get(mkn, 0))
    _f = vec_push(args, vec_get(mkn, 1))
    _g = vec_push(args, vec_get(mkn, 2))
    push_call(cx, d, &"sal_qmatmul_f32", args, 1)

# ---- reshape / transpose / softmax ----
fn int_arg_push(a: &Expr, out: Int) -> Int ! alloc
    match a
        XInt(v) => vec_push(out, v)
        _ => 0

fn int_args(args: &List[Expr], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = int_arg_push(&list_get(args, i), out)
        int_args(args, i + 1, n, out)

fn lower_reshape_op(cx: &mut Cx, d: Int, args: &List[Expr], arg_names: Int) -> Int ! alloc
    src = vec_get(arg_names, 0)
    b = find_tensor(cx, src)
    if b != 0
        nd = int_args(args, 1, list_len(args), vec_new())
        if vec_len(nd) > 0
            _r = reg_tensor(cx, d, bind_elem(b), bind_place(b), nd, vec_copy(nd))
        else
            _r = reg_like(cx, d, b)
    else
        _r = 0
    ir_push(cx, ir_rebind(d, src))

# Extent of axis `i`: the dim when static, else the concrete length (-1 if unknown).
fn tdim(b: Int, i: Int) -> Int ! alloc
    dv = dim_at(bind_dims(b), i)
    if dv >= 0
        dv
    else
        dim_at(bind_concrete(b), i)

# A static rank-2 F32 tensor is really transposed into a new buffer.
fn transpose_is_copy(b: Int) -> Int ! alloc
    if b == 0
        0
    elsif bind_ndims(b) != 2
        0
    elsif bind_elem(b) != 4
        0
    elsif tdim(b, 0) < 0
        0
    elsif tdim(b, 1) < 0
        0
    else
        1

fn lower_transpose_copy(cx: &mut Cx, d: Int, src: Int, b: Int) -> Int ! alloc
    r = fresh(cx)
    _a = push_const_int(cx, r, tdim(b, 0))
    c = fresh(cx)
    _b = push_const_int(cx, c, tdim(b, 1))
    dims = vec_copy(bind_dims(b))
    _x = vec_set(dims, 0, dim_at(bind_dims(b), 1))
    _y = vec_set(dims, 1, dim_at(bind_dims(b), 0))
    conc = vec_copy(bind_concrete(b))
    _cx = vec_set(conc, 0, dim_at(bind_concrete(b), 1))
    _cy = vec_set(conc, 1, dim_at(bind_concrete(b), 0))
    _t = reg_tensor(cx, d, bind_elem(b), bind_place(b), dims, conc)
    args = vec_new()
    _p = vec_push(args, src)
    _q = vec_push(args, r)
    _w = vec_push(args, c)
    push_call(cx, d, &"sal_transpose_f32", args, 1)

fn lower_transpose_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    src = vec_get(arg_names, 0)
    b = find_tensor(cx, src)
    if transpose_is_copy(b) == 1
        lower_transpose_copy(cx, d, src, b)
    else
        lower_transpose_view(cx, d, src, b)

fn lower_transpose_view(cx: &mut Cx, d: Int, src: Int, b: Int) -> Int ! alloc
    if b != 0
        dims = vec_copy(bind_dims(b))
        n = vec_len(dims)
        if n >= 2
            a = vec_get(dims, n - 1)
            _x = vec_set(dims, n - 1, vec_get(dims, n - 2))
            _y = vec_set(dims, n - 2, a)
        else
            _x = 0
        _r = reg_tensor(cx, d, bind_elem(b), bind_place(b), dims, vec_copy(bind_concrete(b)))
    else
        _r = 0
    ir_push(cx, ir_rebind(d, src))

# softmax(x, axis) with a literal axis; the shape is registered either way.
fn lower_softmax_axis_op(cx: &mut Cx, d: Int, args: &List[Expr], arg_names: Int) -> Int ! alloc
    input = vec_get(arg_names, 0)
    b = find_tensor(cx, input)
    _r = reg_like(cx, d, b)
    softmax_axis_call(cx, d, input, b, &list_get(args, 1))

fn softmax_axis_call(cx: &mut Cx, d: Int, input: Int, b: Int, ax: &Expr) -> Int ! alloc
    match ax
        XInt(v) => softmax_axis_emit(cx, d, input, b, v)
        _ => 0

fn softmax_axis_emit(cx: &mut Cx, d: Int, input: Int, b: Int, axis: Int) -> Int ! alloc
    argv = vec_new()
    _a = vec_push(argv, input)
    _b = vec_push(argv, int_text(axis))
    shape = tensor_shape2(b, axis)
    _p = ir_push(cx, ir_call_shaped(d, str_as_int(&"sal_softmax_axis_f32"), argv, 1, shape))
    1

# The shape of a bind as `[rows, cols, axis]`; -1 for what is not a concrete matrix.
fn tensor_shape2(b: Int, axis: Int) -> Int ! alloc
    shp = vec_new()
    if b == 0
        _a = vec_push(shp, 0 - 1)
        _c = vec_push(shp, 0 - 1)
    else
        _a = vec_push(shp, conc_at(b, 0))
        _c = vec_push(shp, conc_at(b, 1))
    _d = vec_push(shp, axis)
    shp

# Concrete extent `i` of a bind (-1 when unknown or absent).
fn conc_at(b: Int, i: Int) -> Int ! alloc
    conc = bind_concrete(b)
    if bind_ndims(b) != 2
        0 - 1
    elsif i < vec_len(conc)
        vec_get(conc, i)
    else
        0 - 1

# `reduce(x, axis)` with a literal axis: the runtime reduces the rows or the columns of the matrix.
fn lower_reduce_op(cx: &mut Cx, d: Int, args: &List[Expr], arg_names: Int) -> Int ! alloc
    input = vec_get(arg_names, 0)
    b = find_tensor(cx, input)
    argv = vec_new()
    _a = vec_push(argv, input)
    _b = vec_push(argv, vec_get(arg_names, 1))
    shape = tensor_shape2(b, reduce_axis_of(&list_get(args, 1)))
    _p = ir_push(cx, ir_call_shaped(d, str_as_int(&"sal_reduce"), argv, 1, shape))
    1

# `relu(x)`: the runtime maps the buffer; a shape not known at compile time is a runtime panic.
fn lower_relu_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    input = vec_get(arg_names, 0)
    b = find_tensor(cx, input)
    argv = vec_new()
    _a = vec_push(argv, input)
    shape = tensor_shape2(b, 0 - 1)
    _p = ir_push(cx, ir_call_shaped(d, str_as_int(&"sal_relu"), argv, 1, shape))
    1

fn reduce_axis_of(ax: &Expr) -> Int ! alloc
    match ax
        XInt(v) => v
        _ => 0 - 2

# ---- attention / rope / silu ----
# An axis as the literal the runtime takes: the extent when known, else `name_d<i>`.
fn dim_lit_or_name(b: Int, name: Int, idx: Int, fallback: &String) -> Int ! alloc
    if idx >= bind_ndims(b)
        str_own(fallback)
    else
        dv = vec_get(bind_dims(b), idx)
        cv = vec_get(bind_concrete(b), idx)
        if dv >= 0
            int_text(dv)
        elsif cv >= 0
            int_text(cv)
        else
            axis_len_dim(name, idx)

fn lower_attention_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    q = vec_get(arg_names, 0)
    k = vec_get(arg_names, 1)
    qb = find_tensor(cx, q)
    kb = find_tensor(cx, k)
    seq = str_as_int(&"1")
    heads = str_as_int(&"1")
    hd = str_as_int(&"1")
    kvh = str_as_int(&"1")
    if qb != 0
        if bind_ndims(qb) >= 3
            seq = dim_lit_or_name(qb, q, 0, &"1")
            heads = dim_lit_or_name(qb, q, 1, &"1")
            hd = dim_lit_or_name(qb, q, 2, &"1")
        else
            seq = seq
    else
        seq = seq
    if kb != 0
        if bind_ndims(kb) >= 2
            kvh = dim_lit_or_name(kb, k, 1, &"1")
        else
            kvh = kvh
    else
        kvh = kvh
    args = vec_new()
    _a = vec_push(args, q)
    _b = vec_push(args, k)
    _c = vec_push(args, vec_get(arg_names, 2))
    _d = vec_push(args, seq)
    _e = vec_push(args, heads)
    _f = vec_push(args, kvh)
    _g = vec_push(args, hd)
    _h = vec_push(args, vec_get(arg_names, 3))
    _p = push_call(cx, d, &"sal_attention_f32", args, 1)
    reg_like(cx, d, qb)

fn lower_rope_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    input = vec_get(arg_names, 0)
    b = find_tensor(cx, input)
    seq = 0
    dim = 0
    if b == 0
        one = const_dim(cx, 1)
        seq = one
        dim = one
    elsif bind_ndims(b) >= 2
        seq = axis_len_from_dim(cx, input, bind_dims(b), bind_concrete(b), 0)
        dim = axis_len_from_dim(cx, input, bind_dims(b), bind_concrete(b), bind_ndims(b) - 1)
    else
        seq = const_dim(cx, 1)
        dim = const_dim(cx, 1)
    args = vec_new()
    _a = vec_push(args, input)
    _b = vec_push(args, seq)
    _c = vec_push(args, dim)
    _e = vec_push(args, vec_get(arg_names, 1))
    _p = push_call(cx, d, &"sal_rope", args, 1)
    reg_like(cx, d, b)

fn lower_silu_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    input = vec_get(arg_names, 0)
    args = vec_new()
    _a = vec_push(args, input)
    _p = push_call(cx, d, &"sal_silu", args, 1)
    reg_like(cx, d, find_tensor(cx, input))

# ---- tensor_append ----
fn dims_elems_or_one(b: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        dv = vec_get(bind_dims(b), i)
        cv = vec_get(bind_concrete(b), i)
        if dv >= 0
            dims_elems_or_one(b, i + 1, n, acc * dv)
        elsif cv >= 0
            dims_elems_or_one(b, i + 1, n, acc * cv)
        else
            0 - 1

fn lower_tensor_append_op(cx: &mut Cx, d: Int, arg_names: Int) -> Int ! alloc
    cache = vec_get(arg_names, 0)
    row = vec_get(arg_names, 1)
    rb = find_tensor(cx, row)
    total = 1
    rows_add = 1
    if rb != 0
        t = dims_elems_or_one(rb, 0, bind_ndims(rb), 1)
        if t >= 0
            total = t
        else
            total = 1
        if bind_ndims(rb) > 0
            if vec_get(bind_dims(rb), 0) >= 0
                rows_add = vec_get(bind_dims(rb), 0)
            else
                rows_add = 1
        else
            rows_add = 1
    else
        total = 1
    stride = total
    if rows_add > 0
        stride = total / rows_add
    else
        stride = total
    key = str_own(&(str_from_int(cache) + "_d0"))
    kb = cx_find(cx, key)
    seq = 0
    if kb != 0
        seq = bind_ssa(kb)
    else
        seq = const_dim(cx, 0)
        _k = cx_bind(cx, key, seq)
    args = vec_new()
    _a = vec_push(args, cache)
    _b = vec_push(args, seq)
    _c = vec_push(args, row)
    if rows_add > 1
        _d = vec_push(args, int_text(rows_add))
        _e = vec_push(args, int_text(stride))
        _p = push_call(cx, 0, &"sal_tensor_write_rows_f32", args, 0)
    else
        _e = vec_push(args, int_text(stride))
        _p = push_call(cx, 0, &"sal_tensor_write_row_f32", args, 0)
    new_seq = fresh(cx)
    ra = const_dim(cx, rows_add)
    _q = ir_push(cx, ir_bin(new_seq, str_as_int(&"add"), seq, ra))
    dkey = str_own(&(str_from_int(d) + "_d0"))
    _r = cx_bind(cx, dkey, new_seq)
    _s = cx_bind(cx, key, new_seq)
    reg_like(cx, d, find_tensor(cx, cache))

# ---- dispatch ----
# Lowers `fname(args)` when it is a shape-aware tensor builtin; returns 1 when handled.
fn lower_tensor_builtin(cx: &mut Cx, fname: &String, args: &List[Expr], arg_names: Int, d: Int) -> Int ! alloc
    n = vec_len(arg_names)
    if str_eq(fname, "reshape") == 1
        if n >= 2
            _p = lower_reshape_op(cx, d, args, arg_names)
            1
        else
            0
    elsif str_eq(fname, "transpose") == 1
        if n >= 1
            _p = lower_transpose_op(cx, d, arg_names)
            1
        else
            0
    elsif str_eq(fname, "softmax") == 1
        if n == 2
            lower_softmax_axis_op(cx, d, args, arg_names)
        else
            0
    elsif str_eq(fname, "relu") == 1
        if n == 1
            _p = lower_relu_op(cx, d, arg_names)
            1
        else
            0
    elsif str_eq(fname, "reduce") == 1
        if n == 2
            if reduce_axis_of(&list_get(args, 1)) == 0 - 2
                0
            else
                lower_reduce_op(cx, d, args, arg_names)
        else
            0
    elsif str_eq(fname, "attention") == 1
        if n == 4
            _p = lower_attention_op(cx, d, arg_names)
            1
        else
            0
    elsif str_eq(fname, "tensor_append") == 1
        if n == 2
            _p = lower_tensor_append_op(cx, d, arg_names)
            1
        else
            0
    elsif str_eq(fname, "rope") == 1
        if n == 2
            _p = lower_rope_op(cx, d, arg_names)
            1
        else
            0
    elsif str_eq(fname, "silu") == 1
        if n >= 1
            _p = lower_silu_op(cx, d, arg_names)
            1
        else
            0
    elsif str_eq(fname, "qmatmul") == 1
        if n == 4
            _p = lower_qmatmul_op(cx, d, arg_names)
            1
        else
            0
    else
        0
