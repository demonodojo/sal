# Field reads and the struct-field glue. `FRC` lives with its methods.
# The vec membership helpers are also what the while-assign walk in fuse.sal uses.
import "../ast/tast.sal"
import "../ast/tytext.sal"
import "../ast/ttypes.sal"
import drops
import desc
import ir

fn assigned_add(names: Int, name: Int) -> Int ! alloc
    if assigned_has(names, name, 0, vec_len(names)) == 0
        vec_push(names, name)
    else
        0

fn assigned_has(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        assigned_has(names, name, i + 1, n)

# ---- field reads (`field_reads` in src/ir.rs) ----
# `sv`: locals read whole through a field, a struct value (`q = w.p`); `hm`: locals whose
# List/Dict/Bytes field is handed on. Maps from the local's name to 1.
# The lists of the environment the walk needs, not the TEnv itself: a struct local's glue would
# release the flat lists of a TEnv it only borrows. `bparams` is a fresh list of dup'd names: the
# glue must not see the `TFn` being lowered, whose body is the same pointer the later `tc_block`
# still copies. `fsum` is the callee summary of the module graph (`fr_summary`), not the fns
# themselves: an `FRC` is made per fn and per `if` branch, and a copy of every fn each time
# would cost too much.
struct FRC
    structs: List[TStruct]
    enums: List[TEnum]
    names: List[String]
    tys: List[String]
    md: Int
    sv: Int
    hm: Int
    al: Int
    sm: Int
    ct: Int
    bparams: List[String]
    fsum: Int

fn fr_new(env: &TEnv, enums: &List[TEnum], md: Int, params: &List[TParam], fsum: Int) -> FRC ! alloc
    FRC(tstructs_copy(&env.structs), enums.clone(), env.names.clone(), env.tys.clone(), md, vec_new(), vec_new(), vec_new(), vec_new(), vec_new(), FRC.borrowed_params(params), fsum)

# Names of parameters whose mode is not take. Each name is dup'd, so freeing this list does not
# free the function the caller still owns.
static FRC.borrowed_params(params: &List[TParam]) -> List[String] ! alloc
    FRC.borrowed_params_go(params, 0, params.len(), List.new[String]())

static FRC.borrowed_params_go(params: &List[TParam], i: Int, n: Int, out: List[String]) -> List[String] ! alloc
    if i >= n
        out
    else
        p = params.get(i)
        if p.mode == 2
            FRC.borrowed_params_go(params, i + 1, n, out)
        else
            out.push(p.name.dup())
            FRC.borrowed_params_go(params, i + 1, n, out)

# A struct local the glue must not release (`list_alias_locals` in src/ir.rs): the result of
# `list_get(xs, i)` on a list whose struct is not describable (it hands out its boxes), or the
# result of a call that returns one of the caller's borrowed parameters.
method FRC.alias(&self, name: &String, e: &Expr) -> Int ! alloc
    match e
        XCall(fname, args, targs, xp) => self.alias_call(name, &fname, &args)
        _ => 0

method FRC.alias_call(&self, name: &String, fname: &String, args: &List[Expr]) -> Int ! alloc
    if self.returns_borrowed(args, &fr_returned_params(self.fsum, fname), 0) == 1
        fr_add(self.al, name)
    elsif fname.eq("list_get") == 1
        t = trim_type_piece(&self.type_of(name))
        si = tt_struct_find(&self.structs, &t)
        if si < 0
            0
        else
            fr_add(self.al, name)
    elsif fname.eq("struct_clone") == 1
        # The clone of a describable struct is a box the drops pass releases (`dx_struct_copy`);
        # the glue only releases the clone its `clone.<S>` built (`value_struct` in src/ir.rs).
        if desc_struct_text(&self.structs, &self.enums, &ty_deref(&self.type_of(name)), 0).len() == 0
            0
        else
            fr_add(self.al, name)
    elsif self.ctor_alias(fname, args) == 1
        fr_add(self.al, name)
    elsif self.call_shares(name, fname, args) == 1
        fr_add(self.al, name)
    else
        0

# `P(o.name, o.n)`: every argument is a borrowed field or a Copy literal.
method FRC.ctor_alias(&self, fname: &String, args: &List[Expr]) -> Int ! alloc
    if tt_struct_find(&self.structs, fname) < 0
        0
    else
        self.ctor_args(args, 0, args.len(), 0)

method FRC.ctor_args(&self, args: &List[Expr], i: Int, n: Int, saw: Int) -> Int ! alloc
    if i >= n
        saw
    elsif self.ctor_piece(&args.get(i)) == 0
        0
    else
        heap = if self.arg_is_alias(&args.get(i)) == 1
            1
        else
            saw
        self.ctor_args(args, i + 1, n, heap)

method FRC.ctor_piece(&self, a: &Expr) -> Int ! alloc
    match a
        XIdent(name) => self.arg_is_alias(a)
        XField(base, field) => self.arg_is_alias(&base)
        XInt(v) => 1
        XFloat(bits, txt) => 1
        XBool(v) => 1
        _ => 0

method FRC.arg_is_alias(&self, a: &Expr) -> Int ! alloc
    match a
        XIdent(name) => assigned_has(self.al, str_own(&name), 0, vec_len(self.al))
        XField(base, field) => self.arg_is_alias(&base)
        _ => 0

# The callee returns a struct built from an alias it does not store or return whole.
method FRC.call_shares(&self, local: &String, fname: &String, args: &List[Expr]) -> Int ! alloc
    t = trim_type_piece(&self.type_of(local))
    if tt_struct_find(&self.structs, &t) < 0
        0
    else
        self.call_shares_arg(fname, args, 0, args.len())

method FRC.call_shares_arg(&self, fname: &String, args: &List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif self.arg_is_alias(&args.get(i)) == 0
        self.call_shares_arg(fname, args, i + 1, n)
    elsif fr_keeps_param(self.fsum, fname, i) == 1
        self.call_shares_arg(fname, args, i + 1, n)
    else
        1

# What the field reads need of the callees, computed once per module graph (the callee may be
# imported; the first fn of a name wins): `r:<fn>:<i>` when `fn` returns parameter `i` as the
# value of some branch tail (`returns_param_map`), `k:<fn>:<i>` when its body uses parameter `i`
# whole, and `n:<fn>` its parameter count.
fn fr_summary(fns: &List[TFn]) -> Int ! alloc
    m = map_new()
    fr_summary_go(m, fns, 0, fns.len())
    m

fn fr_summary_go(m: Int, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = fns.get(i)
        if map_get(m, str_own(&("n:" + f.name))) == 0
            map_put(m, str_own(&("n:" + f.name)), f.params.len() + 1)
            fr_summary_params(m, &f, 0, f.params.len())
        fr_summary_go(m, fns, i + 1, n)

fn fr_summary_params(m: Int, f: &TFn, j: Int, n: Int) -> Int ! alloc
    if j >= n
        0
    else
        name = f.params.get(j).name.dup()
        if tail_is_param(&f.body.tail, &name) == 1
            map_put(m, str_own(&("r:" + f.name + ":" + j.to_str())), 1)
        if fr_block_uses(&f.body, &name) == 1
            map_put(m, str_own(&("k:" + f.name + ":" + j.to_str())), 1)
        fr_summary_params(m, f, j + 1, n)

# The parameter indices `fname` returns as the value of some branch tail (`returns_param_map`).
fn fr_returned_params(fsum: Int, fname: &String) -> List[Int] ! alloc
    out = List.new[Int]()
    fr_returned_go(fsum, fname, 0, map_get(fsum, str_own(&("n:" + fname))) - 1, &mut out)
    out

fn fr_returned_go(fsum: Int, fname: &String, i: Int, n: Int, out: &mut List[Int]) -> Int ! alloc
    if i >= n
        0
    else
        if map_get(fsum, str_own(&("r:" + fname + ":" + i.to_str()))) == 1
            out.push(i)
        fr_returned_go(fsum, fname, i + 1, n, out)

# 1 when the argument at one of `idx` is a borrowed parameter of the function being lowered, or a
# field read off a value (`call_aliases_borrowed_arg`).
method FRC.returns_borrowed(&self, args: &List[Expr], idx: &List[Int], i: Int) -> Int ! alloc
    if i >= idx.len()
        0
    elsif self.arg_borrowed(args, idx.get(i)) == 1
        1
    else
        self.returns_borrowed(args, idx, i + 1)

method FRC.arg_borrowed(&self, args: &List[Expr], i: Int) -> Int ! alloc
    if i >= args.len()
        0
    else
        self.arg_is_borrowed(&args.get(i))

method FRC.arg_is_borrowed(&self, a: &Expr) -> Int ! alloc
    match a
        XIdent(name) => self.param_borrowed(&name)
        XField(base, field) => 1
        _ => 0

# 1 when `name` is one of the borrowed parameters recorded in `bparams`.
method FRC.param_borrowed(&self, name: &String) -> Int ! alloc
    self.param_borrowed_at(name, 0, self.bparams.len())

method FRC.param_borrowed_at(&self, name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif self.bparams.get(i).eq(name) == 1
        1
    else
        self.param_borrowed_at(name, i + 1, n)

# The type text of the local `name` (`tenv_type`).
method FRC.type_of(&self, name: &String) -> String ! alloc
    self.type_at(name, self.names.len() - 1)

method FRC.type_at(&self, name: &String, i: Int) -> String ! alloc
    if i < 0
        ""
    elsif self.names.get(i).eq(name) == 1
        self.tys.get(i).clone()
    else
        self.type_at(name, i - 1)

# Adds the local `name` (a string handle) to the set `set` (a vec of handles) unless it is there.
fn fr_add(set: Int, name: &String) -> Int ! alloc
    if assigned_has(set, str_own(name), 0, vec_len(set)) == 0
        vec_push(set, str_own(name))
    else
        0

# 1 when `fname`'s parameter `index` is stored or returned as a whole, not only through a field.
fn fr_keeps_param(fsum: Int, fname: &String, index: Int) -> Int ! alloc
    map_get(fsum, str_own(&("k:" + fname + ":" + index.to_str())))

fn fr_block_uses(b: &TBlock, name: &String) -> Int ! alloc
    if fr_stmts_use(&b.stmts, name, 0, b.stmts.len()) == 1
        1
    else
        fr_expr_uses(&b.tail, name)

fn fr_stmts_use(stmts: &List[TStmt], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = stmts.get(i)
        hit = if st.kind == 3
            if fr_expr_uses(&st.target, name) + fr_expr_uses(&st.expr, name) > 0
                1
            else
                0
        else
            fr_expr_uses(&st.expr, name)
        if hit == 1
            1
        else
            fr_stmts_use(stmts, name, i + 1, n)

fn fr_expr_uses(e: &Expr, name: &String) -> Int ! alloc
    match e
        XIdent(n) => n.eq(name)
        XField(base, field) => fr_field_base_uses(&base, name)
        XCall(fname, args, targs, xp) => fr_args_use(&args, name, 0, args.len())
        XBin(op, l, r) =>
            if fr_expr_uses(&l, name) == 1
                1
            else
                fr_expr_uses(&r, name)
        XUnary(op, x) => fr_expr_uses(&x, name)
        XIf(cond, then_b, else_b, has_else, elsifs) => fr_if_uses(&cond, &then_b, &else_b, has_else, &elsifs, name)
        XMatch(scrut, arms) => fr_match_uses(&scrut, &arms, name)
        XWhile(cond, body) =>
            if fr_expr_uses(&cond, name) == 1
                1
            else
                fr_block_uses(&body, name)
        XTo(place, x) => fr_expr_uses(&x, name)
        XTry(x) => fr_expr_uses(&x, name)
        _ => 0

# The root of a field chain is not a whole use. A call in the base still is.
fn fr_field_base_uses(base: &Expr, name: &String) -> Int ! alloc
    match base
        XIdent(n) => 0
        XField(inner, field) => fr_field_base_uses(&inner, name)
        _ => fr_expr_uses(base, name)

fn fr_args_use(args: &List[Expr], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif fr_expr_uses(&args.get(i), name) == 1
        1
    else
        fr_args_use(args, name, i + 1, n)

fn fr_if_uses(cond: &Expr, then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif], name: &String) -> Int ! alloc
    if fr_expr_uses(cond, name) == 1
        1
    elsif fr_block_uses(then_b, name) == 1
        1
    elsif has_else == 1
        if fr_block_uses(else_b, name) == 1
            1
        else
            fr_elsifs_use(elsifs, name, 0, elsifs.len())
    else
        fr_elsifs_use(elsifs, name, 0, elsifs.len())

fn fr_elsifs_use(elsifs: &List[TElsif], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = elsifs.get(i)
        if fr_expr_uses(&a.cond, name) + fr_block_uses(&a.body, name) > 0
            1
        else
            fr_elsifs_use(elsifs, name, i + 1, n)

fn fr_match_uses(scrut: &Expr, arms: &List[TArm], name: &String) -> Int ! alloc
    if fr_expr_uses(scrut, name) == 1
        1
    else
        fr_arms_use(arms, name, 0, arms.len())

fn fr_arms_use(arms: &List[TArm], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = arms.get(i)
        hit = if arm.has_suite == 1
            fr_block_uses(&arm.suite, name)
        else
            fr_expr_uses(&arm.body, name)
        if hit == 1
            1
        else
            fr_arms_use(arms, name, i + 1, n)

fn fr_is_container(t: &String) -> Int ! alloc
    base = ty_base(t)
    if str_eq(base, "Bytes") == 1
        1
    elsif str_eq(base, "List") == 1
        1
    elsif str_eq(base, "Dict") == 1
        1
    else
        0

# The root local of a field chain `a.f1.f2`, pushing the field names onto `fl`; "" when the
# expression is not such a chain.
fn fr_chain(e: &Expr, fl: &mut List[String]) -> String ! alloc
    match e
        XIdent(name) => name.dup()
        XField(base, field) => fr_chain_push(&base, &field, fl)
        _ => ""

fn fr_chain_push(base: &Expr, field: &String, fl: &mut List[String]) -> String ! alloc
    root = fr_chain(base, fl)
    if str_len(root) == 0
        ""
    else
        _p = list_push(fl, field.dup())
        root

fn fr_note(c: &FRC, e: &Expr, moving: Int) -> Int ! alloc
    fl = list_new[String]()
    root = fr_chain(e, &mut fl)
    if str_len(root) == 0
        0
    else
        si = tt_struct_find(&c.structs, &c.type_of(&root))
        if si < 0
            0
        else
            fr_walk_fields(c, &list_get(&c.structs, si), &root, &fl, 0, list_len(&fl), moving)

fn fr_walk_fields(c: &FRC, cur: &TStruct, root: &String, fl: &List[String], k: Int, n: Int, moving: Int) -> Int ! alloc
    if k >= n
        0
    else
        fname = list_get(fl, k)
        ty = fr_field_type(&cur.fields, &fname, 0, list_len(&cur.fields))
        last = if k + 1 == n
            1
        else
            0
        if str_len(ty) == 0
            0
        else
            t = trim_type_piece(&ty)
            _h = fr_mark_heap(c, root, &t, last, moving)
            if last == 1
                if moving == 1
                    if str_eq(t, "String") == 1
                        _m = fr_mark_string_moved(c, root, fl)
                    elsif enum_named_t(&c.enums, &t, 0, list_len(&c.enums)) == 1
                        _m = fr_mark_string_moved(c, root, fl)
                    else
                        _m = 0
                else
                    _m = 0
            else
                _m = 0
            si = tt_struct_find(&c.structs, &t)
            if si < 0
                0
            elsif list_len(&list_get(&c.structs, si).tparams) > 0
                0
            else
                _s = fr_mark_struct(c, root, last)
                fr_walk_fields(c, &list_get(&c.structs, si), root, fl, k + 1, n, moving)

# A List/Dict/Bytes field handed on (the last link of a moving chain): the local is not released.
fn fr_mark_heap(c: &FRC, root: &String, t: &String, last: Int, moving: Int) -> Int ! alloc
    if last == 1
        if moving == 1
            if fr_is_container(t) == 1
                fr_add(c.hm, root)
            elsif str_eq(trim_type_piece(t), "String") == 1
                0
            else
                0
        else
            0
    else
        0

# Records a `String` field path handed out by value (`return n.name`).
fn fr_mark_string_moved(c: &FRC, root: &String, fl: &List[String]) -> Int ! alloc
    path = fr_join_fields(fl, 0, list_len(fl), "")
    fr_add(c.sm, &(root + "\x1e" + path))

fn fr_join_fields(fl: &List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    elsif str_len(acc) == 0
        fr_join_fields(fl, i + 1, n, list_get(fl, i).clone())
    else
        fr_join_fields(fl, i + 1, n, (acc + "." + list_get(fl, i)))

fn fr_sm_has(c: &FRC, root: &String, path: &String) -> Int ! alloc
    key = root + "\x1e" + path
    assigned_has(c.sm, str_own(&key), 0, vec_len(c.sm))

fn fr_ct_has(c: &FRC, root: &String, path: &String) -> Int ! alloc
    key = root + "\x1e" + path
    assigned_has(c.ct, str_own(&key), 0, vec_len(c.ct))

# 1 when some entry of `set` ("root\x1epath") belongs to `root`.
fn fr_root_marked(set: Int, root: &String, i: Int) -> Int ! alloc
    if i >= vec_len(set)
        0
    elsif fr_key_of(vec_get(set, i), root) == 1
        1
    else
        fr_root_marked(set, root, i + 1)

fn fr_key_of(h: Int, root: &String) -> Int ! alloc
    key = str_from_int(h)
    pre = root + "\x1e"
    if key.len() < pre.len()
        0
    elsif key.slice(0, pre.len()).eq(pre) == 1
        1
    else
        0

# A struct field read whole (the last link): its nested structs are left alone.
fn fr_mark_struct(c: &FRC, root: &String, last: Int) -> Int ! alloc
    if last == 1
        fr_add(c.sv, root)
    else
        0

fn fr_field_type(fields: &List[TField], name: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    elsif str_eq(list_get(fields, i).name, name) == 1
        list_get(fields, i).ty.clone()
    else
        fr_field_type(fields, name, i + 1, n)

fn fr_ex(c: &FRC, e: &Expr, moving: Int) -> Int ! alloc
    match e
        XField(base, field) => fr_field(c, e, &base, moving)
        XCall(name, args, targs, xp) => fr_call(c, &name, &args, 0, list_len(&args))
        XBin(op, l, r) => fr_pair(c, &l, &r)
        XUnary(op, inner) => fr_ex(c, &inner, moving)
        XTo(place, inner) => fr_ex(c, &inner, moving)
        XTry(inner) => fr_ex(c, &inner, moving)
        XOn(place, body, is_kern, has_index) => fr_blk(c, &body)
        XIf(cond, then_b, else_b, has_else, elsifs) => fr_if(c, &cond, &then_b, &else_b, &elsifs)
        XWhile(cond, body) => fr_while(c, &cond, &body)
        XMatch(scrut, arms) => fr_match(c, &scrut, &arms)
        XLambda(param, body) => fr_ex(c, &body, 1)
        _ => 0

fn fr_field(c: &FRC, e: &Expr, base: &Expr, moving: Int) -> Int ! alloc
    _n = fr_note(c, e, moving)
    inner = fr_innermost(base)
    match inner
        XIdent(name) => 0
        _ => fr_ex(c, &inner, 0)

fn fr_innermost(e: &Expr) -> Expr ! alloc
    match e
        XField(base, field) => fr_innermost(&base)
        _ => e

fn fr_pair(c: &FRC, l: &Expr, r: &Expr) -> Int ! alloc
    _a = fr_ex(c, l, 0)
    fr_ex(c, r, 0)

fn fr_call(c: &FRC, name: &String, args: &List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _t = fr_call_taint_if_zero(c, name, args, i)
        # `xs.push(v)`, `xs.set(i, v)` and `d.put(k, v)` take their receiver by `&mut`: the
        # container stays with its owner.
        keeps = if i == 0 && name.eq("list_push") + name.eq("list_set") + name.eq("dict_put") > 0
            0
        else
            fr_keeps(c, name, i)
        _a = fr_ex(c, &list_get(args, i), keeps)
        fr_call(c, name, args, i + 1, n)

fn fr_call_taint_if_zero(c: &FRC, name: &String, args: &List[Expr], i: Int) -> Int ! alloc
    if i == 0
        fr_call_container_taint(c, name, args)
    else
        0

fn fr_call_container_taint(c: &FRC, name: &String, args: &List[Expr]) -> Int ! alloc
    if str_eq(name, "list_push") + str_eq(name, "list_set") + str_eq(name, "dict_put") == 0
        0
    elsif list_len(args) < 2
        0
    else
        fl = list_new[String]()
        root = fr_chain(&list_get(args, 0), &mut fl)
        path = fr_join_fields(&fl, 0, list_len(&fl), "")
        if str_len(root) == 0
            0
        elsif str_len(path) == 0
            0
        elsif owned_fresh_builtin(&list_get(args, list_len(args) - 1)) == 1
            0
        else
            fr_add(c.ct, &(root + "\x1e" + path))

# Whether argument i of the call to `name` may be kept (a `take` parameter, or a builtin that
# does not only read it): the caller then cannot keep the struct's fields.
fn fr_keeps(c: &FRC, name: &String, i: Int) -> Int ! alloc
    ck = ("caller:" + name).dup()
    params = map_get(c.md, ck.to_int())
    if params != 0
        if i < vec_len(params)
            if vec_get(params, i) == 2
                1
            else
                0
        else
            0
    elsif dr_borrows(name) == 1
        0
    else
        1

fn fr_if(c: &FRC, cond: &Expr, then_b: &TBlock, else_b: &TBlock, elsifs: &List[TElsif]) -> Int ! alloc
    _a = fr_ex(c, cond, 0)
    _b = fr_blk(c, then_b)
    _c = fr_elsifs(c, elsifs, 0, list_len(elsifs))
    fr_blk(c, else_b)

fn fr_elsifs(c: &FRC, elsifs: &List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(elsifs, i)
        _a = fr_ex(c, &arm.cond, 0)
        _b = fr_blk(c, &arm.body)
        fr_elsifs(c, elsifs, i + 1, n)

fn fr_while(c: &FRC, cond: &Expr, body: &TBlock) -> Int ! alloc
    _a = fr_ex(c, cond, 0)
    fr_blk(c, body)

fn fr_match(c: &FRC, scrut: &Expr, arms: &List[TArm]) -> Int ! alloc
    _a = fr_ex(c, scrut, 0)
    fr_arms(c, arms, 0, list_len(arms))

fn fr_arms(c: &FRC, arms: &List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        if arm.has_suite == 1
            _a = fr_blk(c, &arm.suite)
        else
            _a = fr_ex(c, &arm.body, 1)
        fr_arms(c, arms, i + 1, n)

fn fr_blk(c: &FRC, b: &TBlock) -> Int ! alloc
    _s = fr_stmts(c, &b.stmts, 0, list_len(&b.stmts))
    fr_ex(c, &b.tail, 1)

fn fr_stmts(c: &FRC, stmts: &List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        k = st.kind
        if k == 0
            _a = fr_ex(c, &st.expr, 0)
        elsif k == 1
            _al = c.alias(&st.name, &st.expr)
            _a = fr_ex(c, &st.expr, 1)
        elsif k == 2
            _a = fr_ex(c, &st.expr, 1)
        else
            _a = fr_ex(c, &st.target, 0)
            _b = fr_ex(c, &st.expr, 1)
        fr_stmts(c, stmts, i + 1, n)

# What the glue may release of the local `nm` (bit 0 nested structs, bit 1 containers).
fn drop_glue_bits(fr: &FRC, nm: Int) -> Int ! alloc
    nested = if assigned_has(fr.sv, nm, 0, vec_len(fr.sv)) == 0
        1
    else
        0
    containers = if assigned_has(fr.hm, nm, 0, vec_len(fr.hm)) == 0
        2
    else
        0
    nested + containers

# Frees the released fields of the struct value `base` (of type `sd`), in field order.
fn drop_fields(cx: &mut Cx, base: Int, sd: &TStruct, fields: &List[TField], i: Int, n: Int, depth: Int, g: Int, fr: &FRC, root: &String, path_p: &String) -> Int ! alloc
    if i >= n
        0
    else
        fld = list_get(fields, i)
        path = if str_len(path_p) == 0
            fld.name.clone()
        else
            path_p + "." + fld.name
        taint = fr_ct_has(fr, root, &path)
        fnm = drop_field_fn(&cx_structs(cx), &cx.enums, &fld.ty, g, depth, taint)
        if str_len(fnm) == 0
            _z = 0
        elsif str_eq(fnm, "sal_free") == 1
            if fr_sm_has(fr, root, &path) == 1
                _z = 0
            else
                ssa = drop_field_ssa(cx, base, sd, i)
                _c = ir_push(cx, ir_call_named(ssa, str_own(&fnm)))
        elsif str_eq(fnm, "sal_enum_free") == 1
            if fr_sm_has(fr, root, &path) == 1
                _z = 0
            else
                ssa = drop_field_ssa(cx, base, sd, i)
                _c = ir_push(cx, ir_call_named(ssa, str_own(&fnm)))
        elsif str_eq(fnm, "struct") == 1
            _n = drop_nested(cx, base, sd, i, &fld.ty, depth, g, fr, root, &path)
        else
            ssa = drop_field_ssa(cx, base, sd, i)
            _c = ir_push(cx, ir_call_named(ssa, str_own(&fnm)))
        drop_fields(cx, base, sd, fields, i + 1, n, depth, g, fr, root, path_p)

fn drop_field_ssa(cx: &mut Cx, base: Int, sd: &TStruct, i: Int) -> Int ! alloc
    if list_len(&sd.fields) == 1
        base
    else
        d = fresh(cx)
        _e = ir_push(cx, ir_extract(d, base, str_own(&sd.name), i))
        d

# A nested struct field: inline its releases, then free its heap block when multi-field.
fn drop_nested(cx: &mut Cx, base: Int, sd: &TStruct, i: Int, fty: &String, depth: Int, g: Int, fr: &FRC, root: &String, path: &String) -> Int ! alloc
    inner = list_get(&cx_structs(cx), tt_struct_find(&cx_structs(cx), &trim_type_piece(fty)))
    ssa = drop_field_ssa(cx, base, sd, i)
    _d = drop_fields(cx, ssa, &inner, &inner.fields, 0, list_len(&inner.fields), depth + 1, g, fr, root, path)
    if list_len(&inner.fields) > 1
        args2 = vec_new()
        _b = vec_push(args2, ssa)
        ir_push(cx, ir_call(0, str_as_int(&"sal_struct_free_box"), args2, 0))
    else
        0

fn drop_struct_fields(cx: &mut Cx, base: Int, sd: &TStruct, g: Int, fr: &FRC, root: &String) -> Int ! alloc
    _f = drop_fields(cx, base, sd, &sd.fields, 0, list_len(&sd.fields), 0, g, fr, root, &"")
    if list_len(&sd.fields) > 1
        args = vec_new()
        _a = vec_push(args, base)
        ir_push(cx, ir_call(0, str_as_int(&"sal_struct_free_box"), args, 0))
    else
        0
