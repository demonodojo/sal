# Import qualifiers and export link names (mirror of src/qualify.rs).
import result
import modules
import lexer
import tshape
import tast

fn str_replace_chr(s: String, ch: Int, rep: String) -> String ! alloc
    str_replace_chr_go(s, 0, str_len(s), ch, rep, d"")

fn str_replace_chr_go(s: String, i: Int, n: Int, ch: Int, rep: String, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == ch
            str_replace_chr_go(s, i + 1, n, ch, rep, acc + rep)
        else
            str_replace_chr_go(s, i + 1, n, ch, rep, acc + char_to_str(c))

fn implicit_qualifier(import_path: String) -> String ! alloc
    base = import_path
    if str_len(base) >= 4
        if str_eq(str_slice(base, str_len(base) - 4, str_len(base)), d".sal") == 1
            base = str_slice(base, 0, str_len(base) - 4)
        else
            base = base
    else
        base = base
    seg = basename_path(base)
    if str_len(seg) == 0
        d""
    else
        seg

fn modid_from_path(path: String, proot: String) -> String ! alloc
    pl = str_len(proot)
    n = str_len(path)
    rel = modid_rel_path(path, proot, n, pl)
    s = str_replace_chr(rel, 47, d"__")
    if str_len(s) >= 4
        if str_eq(str_slice(s, str_len(s) - 4, str_len(s)), d".sal") == 1
            s = str_slice(s, 0, str_len(s) - 4)
        else
            s = s
    else
        s = s
    s2 = str_replace_chr(s, 46, d"_")
    if str_len(s2) == 0
        d"root"
    else
        s2

fn modid_rel_path(path: String, proot: String, n: Int, pl: Int) -> String ! alloc
    if pl == 0
        path
    elsif n <= pl + 1
        path
    elsif substr_eq_at(path, 0, proot, 0, pl) == 0
        path
    elsif str_char(path, pl) != 47
        path
    else
        str_slice(path, pl + 1, n)

fn link_name(modid: String, name: String, clashing: Int) -> String ! alloc
    if clashing == 1
        modid + d"__" + name
    else
        name

fn name_clash_count(order: Graph, n: Int, name: Int) -> Int ! alloc
    name_clash_count_go(order, 0, n, name, 0)

fn name_clash_count_go(order: Graph, i: Int, n: Int, name: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        if module_defines(list_get(order.progs, i), str_from_int(name)) == 1
            name_clash_count_go(order, i + 1, n, name, acc + 1)
        else
            name_clash_count_go(order, i + 1, n, name, acc)

# 1 when the module defines a fn or a struct called `name`.
fn module_defines(tp: TProgram, name: String) -> Int ! alloc
    if tt_fn_index(tp.fns, name, 0) >= 0
        1
    elsif tt_struct_find(tp.structs, name) >= 0
        1
    else
        0

fn name_is_clashing(order: Graph, n: Int, name: Int) -> Int ! alloc
    if name_clash_count(order, n, name) > 1
        1
    else
        0

fn graph_has_import_alias(order: Graph, n: Int) -> Int ! alloc
    graph_has_import_alias_go(order, 0, n)

fn graph_has_import_alias_go(order: Graph, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        if import_alias_any(list_get(order.progs, i).aliases, 0, list_len(list_get(order.progs, i).aliases)) == 1
            1
        else
            graph_has_import_alias_go(order, i + 1, n)

fn import_alias_any(aliases: List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_len(list_get(aliases, i)) != 0
        1
    else
        import_alias_any(aliases, i + 1, n)

fn graph_has_any_clash(order: Graph, n: Int) -> Int ! alloc
    graph_has_any_clash_go(order, 0, n)

fn graph_has_any_clash_go(order: Graph, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        tp = list_get(order.progs, i)
        if fn_list_has_clash(order, n, tp.fns, 0, list_len(tp.fns)) == 1
            1
        elsif struct_list_has_clash(order, n, tp.structs, 0, list_len(tp.structs)) == 1
            1
        else
            graph_has_any_clash_go(order, i + 1, n)

fn fn_list_has_clash(order: Graph, n: Int, fns: List[TFn], i: Int, fn_n: Int) -> Int ! alloc
    if i >= fn_n
        0
    elsif name_is_clashing(order, n, str_as_int(list_get(fns, i).name)) == 1
        1
    else
        fn_list_has_clash(order, n, fns, i + 1, fn_n)

fn struct_list_has_clash(order: Graph, n: Int, sts: List[TStruct], i: Int, sn: Int) -> Int ! alloc
    if i >= sn
        0
    elsif name_is_clashing(order, n, str_as_int(list_get(sts, i).name)) == 1
        1
    else
        struct_list_has_clash(order, n, sts, i + 1, sn)

fn needs_qualify(order: Graph, n: Int) -> Int ! alloc
    if graph_has_import_alias(order, n) == 1
        1
    elsif graph_has_any_clash(order, n) == 1
        1
    else
        0

fn links_push(links: Int, dep_key: Int, export_name: Int, link: Int) -> Int ! alloc
    row = vec_new()
    _a = vec_push(row, dep_key)
    _b = vec_push(row, export_name)
    _c = vec_push(row, link)
    _p = vec_push(links, row)
    links

fn build_export_links(order: Graph, n: Int, proot: String) -> Int ! alloc
    links = vec_new()
    build_export_links_go(order, 0, n, proot, links)

fn build_export_links_go(order: Graph, i: Int, n: Int, proot: String, links: Int) -> Int ! alloc
    if i >= n
        links
    else
        key = str_as_int(mod_key_at(order, i))
        path = mod_path_at(order, i)
        modid = modid_from_path(path, proot)
        tp = list_get(order.progs, i)
        links2 = push_fn_links_go(order, n, key, modid, tp.fns, 0, list_len(tp.fns), links)
        links3 = push_struct_links_go(order, n, key, modid, tp.structs, 0, list_len(tp.structs), links2)
        links4 = push_variant_links_go(key, tp.enums, 0, list_len(tp.enums), links3)
        build_export_links_go(order, i + 1, n, proot, links4)

# `alias.Variante` names a variant of the module (SPEC: enums are not exports). Variants keep their
# names in the selfhost, so the link is the name itself.
fn push_variant_links_go(key: Int, enums: List[TEnum], i: Int, en: Int, links: Int) -> Int ! alloc
    if i >= en
        links
    else
        links2 = push_one_enum_variants(key, list_get(enums, i).variants, 0, list_len(list_get(enums, i).variants), links)
        push_variant_links_go(key, enums, i + 1, en, links2)

fn push_one_enum_variants(key: Int, vs: List[TVariant], j: Int, vn: Int, links: Int) -> Int ! alloc
    if j >= vn
        links
    else
        nm = str_as_int(list_get(vs, j).name)
        links2 = links_push(links, key, nm, nm)
        push_one_enum_variants(key, vs, j + 1, vn, links2)

fn push_fn_links_go(order: Graph, n: Int, key: Int, modid: String, fns: List[TFn], i: Int, fn_n: Int, links: Int) -> Int ! alloc
    if i >= fn_n
        links
    else
        nm = str_as_int(list_get(fns, i).name)
        clash = name_is_clashing(order, n, nm)
        lk = str_as_int(link_name(modid, str_from_int(nm), clash))
        links2 = links_push(links, key, nm, lk)
        push_fn_links_go(order, n, key, modid, fns, i + 1, fn_n, links2)

fn push_struct_links_go(order: Graph, n: Int, key: Int, modid: String, sts: List[TStruct], i: Int, sn: Int, links: Int) -> Int ! alloc
    if i >= sn
        links
    else
        nm = str_as_int(list_get(sts, i).name)
        clash = name_is_clashing(order, n, nm)
        lk = str_as_int(link_name(modid, str_from_int(nm), clash))
        links2 = links_push(links, key, nm, lk)
        push_struct_links_go(order, n, key, modid, sts, i + 1, sn, links2)

fn export_link_lookup(links: Int, dep_key: Int, item: Int) -> Int ! alloc
    export_link_lookup_go(links, 0, vec_len(links), dep_key, item)

fn export_link_lookup_go(links: Int, i: Int, n: Int, dep_key: Int, item: Int) -> Int ! alloc
    if i >= n
        0
    else
        row = vec_get(links, i)
        if str_eq(vec_get(row, 0), dep_key) == 1
            if str_eq(vec_get(row, 1), item) == 1
                vec_get(row, 2)
            else
                export_link_lookup_go(links, i + 1, n, dep_key, item)
        else
            export_link_lookup_go(links, i + 1, n, dep_key, item)

fn quals_push(quals: Int, qual: Int, dep_key: Int) -> Int ! alloc
    row = vec_new()
    _a = vec_push(row, qual)
    _b = vec_push(row, dep_key)
    _p = vec_push(quals, row)
    quals

fn qualifier_dep(explicit: Int, implicit: Int, qual: Int) -> Int ! alloc
    k = qualifier_dep_in(explicit, qual)
    if k != 0
        k
    else
        qualifier_dep_in(implicit, qual)

fn qualifier_dep_in(quals: Int, qual: Int) -> Int ! alloc
    qualifier_dep_in_go(quals, 0, vec_len(quals), qual)

fn qualifier_dep_in_go(quals: Int, i: Int, n: Int, qual: Int) -> Int ! alloc
    if i >= n
        0
    else
        row = vec_get(quals, i)
        if str_eq(vec_get(row, 0), qual) == 1
            vec_get(row, 1)
        else
            qualifier_dep_in_go(quals, i + 1, n, qual)

fn local_fn_name(tp: TProgram, name: String) -> Int ! alloc
    if tt_fn_index(tp.fns, name, 0) >= 0
        1
    else
        0

fn local_struct_name(tp: TProgram, name: String) -> Int ! alloc
    if tt_struct_find(tp.structs, name) >= 0
        1
    else
        0

fn module_qualifiers(order: Graph, mi: Int, proot: String) -> Int ! io, alloc
    explicit = vec_new()
    implicit = vec_new()
    tp = list_get(order.progs, mi)
    mpath = mod_path_at(order, mi)
    module_qualifiers_go(tp, 0, list_len(tp.imports), mpath, proot, explicit, implicit)

fn module_qualifiers_go(tp: TProgram, i: Int, n: Int, mpath: String, proot: String, explicit: Int, implicit: Int) -> Int ! io, alloc
    if i >= n
        ctx = vec_new()
        _a = vec_push(ctx, explicit)
        _b = vec_push(ctx, implicit)
        result_ok(ctx)
    else
        imp = list_get(tp.imports, i)
        alias = list_get(tp.aliases, i)
        dep_path = resolve_import_path_with_manifest(imp, mpath, proot)
        if str_len(dep_path) == 0
            module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit)
        else
            dep_key = str_as_int(path_key(dep_path))
            if str_len(alias) != 0
                if local_fn_name(tp, alias) == 1
                    result_err_str(d"import alias conflicts with a local item")
                elsif local_struct_name(tp, alias) == 1
                    result_err_str(d"import alias conflicts with a local item")
                elsif qualifier_dep_in(explicit, str_as_int(alias)) != 0
                    result_err_str(d"duplicate import alias")
                else
                    ex2 = quals_push(explicit, str_as_int(strdup(alias)), dep_key)
                    module_qualifiers_go(tp, i + 1, n, mpath, proot, ex2, implicit)
            else
                iq = implicit_qualifier(imp)
                if str_len(iq) == 0
                    module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit)
                else
                    iqh = str_as_int(iq)
                    if local_fn_name(tp, iq) == 1
                        module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit)
                    elsif local_struct_name(tp, iq) == 1
                        module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit)
                    elsif qualifier_dep_in(implicit, iqh) != 0
                        result_err_str(d"ambiguous implicit qualifier")
                    else
                        im2 = quals_push(implicit, iqh, dep_key)
                        module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, im2)

fn split_qual_member(name: String) -> Int ! alloc
    dot = find_char(name, 46, 0, str_len(name))
    if dot < 0
        0
    else
        pair = vec_new()
        _a = vec_push(pair, str_as_int(str_slice(name, 0, dot)))
        _b = vec_push(pair, str_as_int(str_slice(name, dot + 1, str_len(name))))
        pair

fn resolve_qualified_item(ctx: Int, links: Int, qual: Int, member: Int) -> Int ! alloc
    explicit = vec_get(ctx, 0)
    implicit = vec_get(ctx, 1)
    dep = qualifier_dep(explicit, implicit, qual)
    if dep == 0
        0
    else
        export_link_lookup(links, dep, member)

fn qualify_type_handle(ty: Int, ctx: Int, links: Int) -> Int ! alloc
    if ty == 0
        0
    else
        s = ts_trim(str_from_int(ty))
        pair = split_qual_member(s)
        if pair == 0
            renamed = map_get(vec_get(ctx, 2), str_as_int(ty_trim_go(s)))
            if renamed != 0
                renamed
            else
                ty
        else
            qual = vec_get(pair, 0)
            member = vec_get(pair, 1)
            lk = resolve_qualified_item(ctx, links, qual, member)
            if lk == 0
                ty
            else
                lk

# The body of a function is qualified on its typed tree: `qx_*` build the renamed copy.
# Like the handle pass it replaces, it only descends into field access, calls, binary
# operators, `if`, `while`, `to` and `on`; any other node is copied unchanged. A rebuilt
# call loses its type arguments and a rebuilt `on` its kernel flags.
fn qx_ident_link(ctx: Int, links: Int, qual: String, member: String) -> Int ! alloc
    resolve_qualified_item(ctx, links, str_as_int(strdup(qual)), str_as_int(strdup(member)))

fn qx_field(base: Expr, fld: String, ctx: Int, links: Int) -> Expr ! alloc
    match base
        XIdent(qual) => qx_field_ident(base, qual, fld, ctx, links)
        _ => XField(qx(base, ctx, links), strdup(fld))

fn qx_field_ident(base: Expr, qual: String, fld: String, ctx: Int, links: Int) -> Expr ! alloc
    lk = qx_ident_link(ctx, links, qual, fld)
    if lk != 0
        XIdent(strdup(str_from_int(lk)))
    else
        XField(qx(base, ctx, links), strdup(fld))

fn qx_call_name(nm: String, ctx: Int, links: Int) -> String ! alloc
    pair = split_qual_member(nm)
    if pair == 0
        renamed = map_get(vec_get(ctx, 2), str_as_int(strdup(nm)))
        if renamed != 0
            strdup(str_from_int(renamed))
        else
            strdup(nm)
    else
        lk = resolve_qualified_item(ctx, links, vec_get(pair, 0), vec_get(pair, 1))
        if lk == 0
            # `T.f(..)` on a local type renamed by a clash (`T` -> `mod__T`): the qualifier follows.
            renamed = map_get(vec_get(ctx, 2), str_as_int(strdup(str_from_int(vec_get(pair, 0)))))
            if renamed != 0
                strdup(str_from_int(renamed) + "." + str_from_int(vec_get(pair, 1)))
            else
                strdup(nm)
        else
            strdup(str_from_int(lk))

fn qx_args(xs: List[Expr], i: Int, n: Int, ctx: Int, links: Int, out: List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, qx(list_get(xs, i), ctx, links))
        qx_args(xs, i + 1, n, ctx, links, out)

fn qx_call(nm: String, args: List[Expr], targs: String, ctx: Int, links: Int, xp: Int) -> Expr ! alloc
    out = list_new[Expr]()
    _a = qx_args(args, 0, list_len(args), ctx, links, out)
    XCall(qx_call_name(nm, ctx, links), out, strdup(targs), qx_call_pos(nm, xp, ctx))

# A call through a module qualifier is placed at its qualifier (the start of `alias.f`), as the
# bootstrap reports it; the position of any other call is kept.
fn qx_call_pos(nm: String, xp: Int, ctx: Int) -> Int ! alloc
    pair = split_qual_member(nm)
    if pair == 0
        xp
    elsif xp <= 0
        xp
    elsif qualifier_dep(vec_get(ctx, 0), vec_get(ctx, 1), vec_get(pair, 0)) == 0
        xp
    else
        xp - str_len(nm)

fn qx_elsifs(xs: List[TElsif], i: Int, n: Int, ctx: Int, links: Int, out: List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = list_push(out, TElsif(qx(a.cond, ctx, links), qx_block(a.body, ctx, links)))
        qx_elsifs(xs, i + 1, n, ctx, links, out)

fn qx_elsif_list(xs: List[TElsif], ctx: Int, links: Int) -> List[TElsif] ! alloc
    out = list_new[TElsif]()
    _a = qx_elsifs(xs, 0, list_len(xs), ctx, links, out)
    out

fn qx(e: Expr, ctx: Int, links: Int) -> Expr ! alloc
    match e
        XField(base, fld) => qx_field(base, fld, ctx, links)
        XCall(nm, args, targs, xp) => qx_call(nm, args, targs, ctx, links, xp)
        XBin(op, l, r) => XBin(strdup(op), qx(l, ctx, links), qx(r, ctx, links))
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(qx(cond, ctx, links), qx_block(then_b, ctx, links), qx_block(else_b, ctx, links), has_else, qx_elsif_list(elsifs, ctx, links))
        XWhile(cond, body) => XWhile(qx(cond, ctx, links), qx_block(body, ctx, links))
        XTo(place, inner) => XTo(strdup(place), qx(inner, ctx, links))
        XOn(place, body, kern, idx) => XOn(strdup(place), qx_block(body, ctx, links), 0, 0)
        XMatch(scrut, arms) => XMatch(qx(scrut, ctx, links), qx_arms(arms, 0, list_len(arms), ctx, links, list_new[TArm]()))
        _ => tc_expr(e)

fn qx_arms(xs: List[TArm], i: Int, n: Int, ctx: Int, links: Int, out: List[TArm]) -> List[TArm] ! alloc
    if i >= n
        out
    else
        a = list_get(xs, i)
        _a = list_push(out, TArm(qx_pat(a.pat, ctx, links), qx(a.body, ctx, links), qx_block(a.suite, ctx, links), a.has_suite))
        qx_arms(xs, i + 1, n, ctx, links, out)

# Variant patterns of an arm. `alias.V` needs an alias whose module has `V`; a bare `V` must be a
# variant of this module or of a module that is not reached only through an alias (SPEC, Módulos).
# The errors go to the list in `ctx[3]`.
fn qx_pat(p: TPat, ctx: Int, links: Int) -> TPat ! alloc
    if p.kind == 3
        qx_variant_check(p, ctx, links)
    args = list_new[TPat]()
    _b = qx_pat_list(p.args, 0, list_len(p.args), ctx, links, args)
    TPat(p.kind, p.ival, strdup(p.name), strdup(p.qual), args)

fn qx_pat_list(xs: List[TPat], i: Int, n: Int, ctx: Int, links: Int, out: List[TPat]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, qx_pat(list_get(xs, i), ctx, links))
        qx_pat_list(xs, i + 1, n, ctx, links, out)

fn qx_variant_check(p: TPat, ctx: Int, links: Int) -> Int ! alloc
    if str_len(p.qual) > 0
        dep = qualifier_dep(vec_get(ctx, 0), vec_get(ctx, 1), str_as_int(strdup(p.qual)))
        if dep == 0
            qx_err(ctx, "unknown qualifier `" + p.qual + "`")
        elsif export_link_lookup(links, dep, str_as_int(strdup(p.name))) == 0
            qx_err(ctx, "no variant `" + p.name + "` in that module")
        else
            0
    elsif vec_has_name(vec_get(ctx, 4), p.name, 0, vec_len(vec_get(ctx, 4))) == 1
        0
    elsif alias_only_variant(vec_get(ctx, 5), links, p.name, 0, vec_len(vec_get(ctx, 5))) == 1
        if alias_only_variant(vec_get(ctx, 6), links, p.name, 0, vec_len(vec_get(ctx, 6))) == 1
            0
        else
            qx_err(ctx, "variant `" + p.name + "` is only reachable through its import alias")
    else
        0

# The modules a module sees flat (imports without `as`, transitively; SPEC, Módulos), as keys in
# `seen`. Their variants are in scope unqualified.
fn flat_keys(order: Graph, mi: Int, proot: String, seen: Int) -> Int ! io, alloc
    tp = list_get(order.progs, mi)
    ctx = result_unwrap(module_qualifiers(order, mi, proot))
    flat_keys_go(order, proot, tp, ctx, 0, list_len(tp.imports), seen)

fn flat_keys_go(order: Graph, proot: String, tp: TProgram, ctx: Int, i: Int, n: Int, seen: Int) -> Int ! io, alloc
    if i >= n
        0
    elsif str_len(list_get(tp.aliases, i)) != 0
        flat_keys_go(order, proot, tp, ctx, i + 1, n, seen)
    else
        _a = flat_add_import(order, proot, ctx, implicit_qualifier(list_get(tp.imports, i)), seen)
        flat_keys_go(order, proot, tp, ctx, i + 1, n, seen)

# The module a plain import names is flat; so are the modules it imports flat.
fn flat_add_import(order: Graph, proot: String, ctx: Int, qual: String, seen: Int) -> Int ! io, alloc
    k = qualifier_dep(vec_get(ctx, 0), vec_get(ctx, 1), str_as_int(qual))
    if k == 0
        0
    elsif vec_has_key(seen, k, 0, vec_len(seen)) == 1
        0
    else
        _p = vec_push(seen, k)
        j = graph_find_by_key(order, str_from_int(k), 0, list_len(order.mods))
        if j >= 0
            flat_keys(order, j, proot, seen)
        else
            0

fn vec_has_key(v: Int, k: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif vec_get(v, i) == k
        1
    else
        vec_has_key(v, k, i + 1, n)

fn qx_err(ctx: Int, msg: String) -> Int ! alloc
    vec_push(vec_get(ctx, 3), str_as_int(msg))

fn vec_has_name(v: Int, name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(str_from_int(vec_get(v, i)), name) == 1
        1
    else
        vec_has_name(v, name, i + 1, n)

fn alias_only_variant(deps: Int, links: Int, name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif export_link_lookup(links, vec_get(deps, i), str_as_int(strdup(name))) != 0
        1
    else
        alias_only_variant(deps, links, name, i + 1, n)

fn own_variant_names(enums: List[TEnum], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        own_one_enum(list_get(enums, i).variants, 0, list_len(list_get(enums, i).variants), out)
        own_variant_names(enums, i + 1, n, out)

fn own_one_enum(vs: List[TVariant], j: Int, n: Int, out: Int) -> Int ! alloc
    if j >= n
        0
    else
        _a = vec_push(out, str_as_int(strdup(list_get(vs, j).name)))
        own_one_enum(vs, j + 1, n, out)

fn qx_stmt(s: TStmt, ctx: Int, links: Int) -> TStmt ! alloc
    TStmt(s.kind, strdup(s.name), qx(s.expr, ctx, links), strdup(s.ty), s.is_let, tc_expr(s.target), s.frozen, s.stack, s.id)

fn qx_stmts(xs: List[TStmt], i: Int, n: Int, ctx: Int, links: Int, out: List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, qx_stmt(list_get(xs, i), ctx, links))
        qx_stmts(xs, i + 1, n, ctx, links, out)

fn qx_block(b: TBlock, ctx: Int, links: Int) -> TBlock ! alloc
    out = list_new[TStmt]()
    _a = qx_stmts(b.stmts, 0, list_len(b.stmts), ctx, links, out)
    TBlock(out, qx(b.tail, ctx, links))

# The qualified copy of a module: parameter and result types, bodies and names rewritten.
fn qualify_type_text(ty: String, ctx: Int, links: Int) -> String ! alloc
    if str_len(ty) == 0
        d""
    else
        strdup(str_from_int(qualify_type_handle(str_as_int(ty), ctx, links)))

fn qualify_params(ps: List[TParam], i: Int, n: Int, ctx: Int, links: Int, out: List[TParam]) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(ps, i)
        _a = list_push(out, TParam(strdup(pm.name), qualify_type_text(pm.ty, ctx, links), pm.mode))
        qualify_params(ps, i + 1, n, ctx, links, out)

fn ints_copy(xs: List[Int], i: Int, n: Int, out: List[Int]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, list_get(xs, i))
        ints_copy(xs, i + 1, n, out)

fn link_or_same(r: Int, name: String) -> String ! alloc
    lk = map_get(r, str_as_int(name))
    if lk != 0
        strdup(str_from_int(lk))
    else
        strdup(name)

fn qualify_fns(fns: List[TFn], i: Int, n: Int, ctx: Int, links: Int, r: Int, out: List[TFn]) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        params = list_new[TParam]()
        _p = qualify_params(f.params, 0, list_len(f.params), ctx, links, params)
        fx = list_new[Int]()
        _x = ints_copy(f.fx, 0, list_len(f.fx), fx)
        _a = list_push(out, TFn(link_or_same(r, f.name), params, qx_block(f.body, ctx, links), qualify_type_text(f.ret, ctx, links), f.no_heap, fx, tc_strs(f.tparams), strdup(f.recv), f.mkind, strdup(f.deprecated), f.tyat))
        qualify_fns(fns, i + 1, n, ctx, links, r, out)

fn fields_copy(fs: List[TField], i: Int, n: Int, out: List[TField]) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fs, i)
        _a = list_push(out, TField(strdup(f.name), strdup(f.ty)))
        fields_copy(fs, i + 1, n, out)

fn qualify_structs(sts: List[TStruct], i: Int, n: Int, r: Int, out: List[TStruct]) -> Int ! alloc
    if i >= n
        0
    else
        s = list_get(sts, i)
        fields = list_new[TField]()
        _f = fields_copy(s.fields, 0, list_len(s.fields), fields)
        _a = list_push(out, TStruct(link_or_same(r, s.name), fields, s.layout_c, tc_strs(s.tparams), s.is_frame, strdup(s.deprecated), s.tyat))
        qualify_structs(sts, i + 1, n, r, out)

# Replaces module `mi` of the graph with its qualified copy; enums are moved across.
fn qualify_typed(order: Graph, mi: Int, ctx: Int, links: Int, r: Int) -> Int ! alloc
    old = list_get(order.progs, mi)
    fns = list_new[TFn]()
    _a = qualify_fns(old.fns, 0, list_len(old.fns), ctx, links, r, fns)
    sts = list_new[TStruct]()
    _b = qualify_structs(old.structs, 0, list_len(old.structs), r, sts)
    neu = TProgram(fns, tc_strs(old.imports), sts, tc_strs(old.aliases), old.enums)
    _c = tp_free_fns(old.fns, 0, list_len(old.fns))
    _d = list_free(old.fns)
    _e = tp_free_structs(old.structs, 0, list_len(old.structs))
    _f = list_free(old.structs)
    _g = list_free(old.imports)
    _h = list_free(old.aliases)
    _z = list_set(order.progs, mi, neu)
    0

fn flat_export_name_seen(seen: Int, name: Int) -> Int ! alloc
    vec_has_str(seen, name, 0, vec_len(seen))

fn check_flat_import_clashes(order: Graph, mi: Int, proot: String) -> Int ! io, alloc
    tp = list_get(order.progs, mi)
    mpath = mod_path_at(order, mi)
    seen = vec_new()
    check_flat_go(tp, 0, list_len(tp.imports), mpath, proot, order, seen)

fn check_flat_go(tp: TProgram, i: Int, n: Int, mpath: String, proot: String, order: Graph, seen: Int) -> Int ! io, alloc
    if i >= n
        result_ok(0)
    else
        if str_len(list_get(tp.aliases, i)) != 0
            check_flat_go(tp, i + 1, n, mpath, proot, order, seen)
        else
            dep_path = resolve_import_path_with_manifest(list_get(tp.imports, i), mpath, proot)
            if str_len(dep_path) == 0
                check_flat_go(tp, i + 1, n, mpath, proot, order, seen)
            else
                dep_m = graph_find_by_key(order, path_key(dep_path), 0, list_len(order.mods))
                if dep_m < 0
                    check_flat_go(tp, i + 1, n, mpath, proot, order, seen)
                else
                    step = check_flat_dep_exports(list_get(order.progs, dep_m), seen)
                    if result_is_err(step) == 1
                        step
                    else
                        seen2 = result_unwrap(step)
                        check_flat_go(tp, i + 1, n, mpath, proot, order, seen2)

fn check_flat_dep_exports(tp: TProgram, seen: Int) -> Int ! alloc
    seen2 = merge_struct_names_seen(tp.structs, 0, list_len(tp.structs), merge_fn_names_seen(tp.fns, 0, list_len(tp.fns), seen))
    if seen2 == 0
        result_err_str(d"name defined in more than one imported module")
    else
        result_ok(seen2)

fn merge_fn_names_seen(fns: List[TFn], i: Int, n: Int, seen: Int) -> Int ! alloc
    if seen == 0
        0
    elsif i >= n
        seen
    else
        nm = str_as_int(list_get(fns, i).name)
        if flat_export_name_seen(seen, nm) == 1
            0
        else
            _p = vec_push(seen, nm)
            merge_fn_names_seen(fns, i + 1, n, seen)

fn merge_struct_names_seen(sts: List[TStruct], i: Int, n: Int, seen: Int) -> Int ! alloc
    if seen == 0
        0
    elsif i >= n
        seen
    else
        nm = str_as_int(list_get(sts, i).name)
        if flat_export_name_seen(seen, nm) == 1
            0
        else
            _p = vec_push(seen, nm)
            merge_struct_names_seen(sts, i + 1, n, seen)

# Names defined in more than one module, judged before anything is renamed.
fn build_clash_map(order: Graph, n: Int) -> Int ! alloc
    clash = map_new()
    _a = clash_map_modules(order, 0, n, n, clash)
    clash

fn clash_map_modules(order: Graph, i: Int, n: Int, total: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        tp = list_get(order.progs, i)
        _f = clash_map_fns(order, total, tp.fns, 0, list_len(tp.fns), clash)
        _s = clash_map_structs(order, total, tp.structs, 0, list_len(tp.structs), clash)
        clash_map_modules(order, i + 1, n, total, clash)

fn clash_map_fns(order: Graph, total: Int, fns: List[TFn], i: Int, n: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(list_get(fns, i).name)
        if name_is_clashing(order, total, nm) == 1
            _p = map_put(clash, nm, 1)
            clash_map_fns(order, total, fns, i + 1, n, clash)
        else
            clash_map_fns(order, total, fns, i + 1, n, clash)

fn clash_map_structs(order: Graph, total: Int, sts: List[TStruct], i: Int, n: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(list_get(sts, i).name)
        if name_is_clashing(order, total, nm) == 1
            _p = map_put(clash, nm, 1)
            clash_map_structs(order, total, sts, i + 1, n, clash)
        else
            clash_map_structs(order, total, sts, i + 1, n, clash)

# name -> link name for the clashing definitions of one module.
fn local_renames(tp: TProgram, clash: Int, modid: String) -> Int ! alloc
    r = map_new()
    _a = local_renames_fns(tp.fns, 0, list_len(tp.fns), clash, modid, r)
    _b = local_renames_structs(tp.structs, 0, list_len(tp.structs), clash, modid, r)
    _c = local_renames_methods(tp.fns, 0, list_len(tp.fns), r)
    r

# A method or static of a renamed type follows its type: `T__m` -> `mod__T__m`.
fn local_renames_methods(fns: List[TFn], i: Int, n: Int, r: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        rv = map_get(r, str_as_int(f.recv))
        if str_len(f.recv) > 0
            if rv != 0
                _p = map_put(r, str_as_int(f.name), str_as_int(str_from_int(rv) + "__" + str_slice(f.name, str_len(f.recv) + 2, str_len(f.name))))
                local_renames_methods(fns, i + 1, n, r)
            else
                local_renames_methods(fns, i + 1, n, r)
        else
            local_renames_methods(fns, i + 1, n, r)

fn local_renames_fns(fns: List[TFn], i: Int, n: Int, clash: Int, modid: String, r: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(list_get(fns, i).name)
        if map_get(clash, nm) != 0
            _p = map_put(r, nm, str_as_int(link_name(modid, str_from_int(nm), 1)))
            local_renames_fns(fns, i + 1, n, clash, modid, r)
        else
            local_renames_fns(fns, i + 1, n, clash, modid, r)

fn local_renames_structs(sts: List[TStruct], i: Int, n: Int, clash: Int, modid: String, r: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(list_get(sts, i).name)
        if map_get(clash, nm) != 0
            _p = map_put(r, nm, str_as_int(link_name(modid, str_from_int(nm), 1)))
            local_renames_structs(sts, i + 1, n, clash, modid, r)
        else
            local_renames_structs(sts, i + 1, n, clash, modid, r)

fn qualify_one_module(order: Graph, mi: Int, proot: String, links: Int, clash: Int) -> Int ! io, alloc
    ctx_step = module_qualifiers(order, mi, proot)
    if result_is_err(ctx_step) == 1
        ctx_step
    else
        ctx = result_unwrap(ctx_step)
        path = mod_path_at(order, mi)
        modid = modid_from_path(path, proot)
        tp = list_get(order.progs, mi)
        renames = local_renames(tp, clash, modid)
        _c = vec_push(ctx, renames)
        errs = vec_new()
        _e = vec_push(ctx, errs)
        own = vec_new()
        _o = own_variant_names(tp.enums, 0, list_len(tp.enums), own)
        _w = vec_push(ctx, own)
        _d = vec_push(ctx, alias_dep_keys(ctx, tp.aliases, 0, list_len(tp.aliases), vec_new()))
        flat = vec_new()
        _fl = flat_keys(order, mi, proot, flat)
        _g = vec_push(ctx, flat)
        _q = qualify_typed(order, mi, ctx, links, renames)
        if vec_len(errs) > 0
            result_err_str(str_from_int(vec_get(errs, 0)))
        else
            result_ok(0)

# The keys of the modules imported under an alias of this module.
fn alias_dep_keys(ctx: Int, aliases: List[String], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = list_get(aliases, i)
        if str_len(a) > 0
            dep = qualifier_dep(vec_get(ctx, 0), vec_get(ctx, 1), str_as_int(strdup(a)))
            if dep != 0
                _p = vec_push(out, dep)
        alias_dep_keys(ctx, aliases, i + 1, n, out)

fn qualify_all_modules(order: Graph, n: Int, proot: String, links: Int) -> Int ! io, alloc
    clash = build_clash_map(order, n)
    qualify_all_go(order, 0, n, proot, links, clash)

fn qualify_all_go(order: Graph, i: Int, n: Int, proot: String, links: Int, clash: Int) -> Int ! io, alloc
    if i >= n
        result_ok(0)
    else
        step2 = qualify_one_module(order, i, proot, links, clash)
        if result_is_err(step2) == 1
            step2
        else
            qualify_all_go(order, i + 1, n, proot, links, clash)

# Flat-import clashes are judged on the original names, before any module is
# renamed (renaming makes the clashing exports distinct).
fn check_all_flat_clashes(order: Graph, i: Int, n: Int, proot: String) -> Int ! io, alloc
    if i >= n
        result_ok(0)
    else
        step = check_flat_import_clashes(order, i, proot)
        if result_is_err(step) == 1
            step
        else
            check_all_flat_clashes(order, i + 1, n, proot)

fn qualify_module_graph(order: Graph, proot: String) -> Int ! io, alloc
    n = list_len(order.mods)
    if needs_qualify(order, n) == 0
        result_ok(0)
    else
        clash = check_all_flat_clashes(order, 0, n, proot)
        if result_is_err(clash) == 1
            clash
        else
            links = build_export_links(order, n, proot)
            step = qualify_all_modules(order, n, proot, links)
            if result_is_err(step) == 1
                step
            else
                result_ok(0)
