        "sal_gated_print_str(" + a + ",(const char*)(uintptr_t)" + b + ")"
    else
        if str_eq(fname, "write_file") == 1
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "sal_write_file((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
        else
            if str_eq(fname, "str_eq") == 1
                a = arg_at(args, 0)
                b = arg_at(args, 1)
                "sal_str_eq((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
            else
                if str_eq(fname, "str_contains") == 1
                    a = arg_at(args, 0)
                    b = arg_at(args, 1)
