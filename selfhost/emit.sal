# Emission: IR text and C.
import result
import lexer
import ast
import parser
import ir
import fuse
import modules
import cache

# ---- ir_to_text ----
fn qquote() -> String ! alloc
    char_to_str(34)

fn emit_escape_arg(s: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 34
            bs = d"\\"
            a2 = str_append(acc, bs)
            # free(bs)
            piece = char_to_str(34)
            a3 = str_append(a2, piece)
            # free(piece)
            emit_escape_arg(s, i + 1, n, a3)
        elsif c == 92
            bs = d"\\\\"
            a2 = str_append(acc, bs)
            # free(bs)
            emit_escape_arg(s, i + 1, n, a2)
        else
            piece = char_to_str(c)
            a2 = str_append(acc, piece)
            # free(piece)
            emit_escape_arg(s, i + 1, n, a2)

fn emit_arg_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn emit_arg_list(args: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_arg_comma(i)
        acc = str_append(acc, comma)
        q = qquote()
        acc = str_append(acc, q)
        a = vec_get(args, i)
        esc = emit_escape_arg(a, 0, str_len(a), strdup(""))
        acc = str_append(acc, esc)
        acc = str_append(acc, q)
        emit_arg_list(args, i + 1, n, acc)

fn emit_inst(inst: Int) -> String ! alloc
    k = vec_get(inst, 0)
    if k == II_CI()
        emit_ci(inst)
    elsif k == II_CS()
        emit_cs(inst)
    elsif k == II_BIN()
        emit_bin(inst)
    elsif k == II_CALL()
        emit_call(inst)
    elsif k == II_PLACE()
        emit_place(inst)
    elsif k == II_RET()
        emit_ret(inst)
    elsif k == II_DROP()
        emit_drop(inst)
    elsif k == II_IF()
        emit_if_inst(inst)
    else
        d""

fn emit_ci(inst: Int) -> String ! alloc
    dest = strdup(vec_get(inst, 1))
    vs = int_to_str(vec_get(inst, 2))
    "  ConstInt {{ dest: " + char_to_str(34) + dest + char_to_str(34) + ", value: " + vs + " }}\n"

fn emit_cs(inst: Int) -> String ! alloc
    q = qquote()
    "  ConstString {{ dest: " + q + vec_get(inst, 1) + q + ", value: " + q + vec_get(inst, 2) + q + " }}\n"

fn emit_bin(inst: Int) -> String ! alloc
    q = qquote()
    "  Binary {{ dest: " + q + vec_get(inst, 1) + q + ", op: " + q + vec_get(inst, 2) + q + ", left: " + q + vec_get(inst, 3) + q + ", right: " + q + vec_get(inst, 4) + q + " }}\n"

fn emit_call_dest(inst: Int, q: String) -> String ! alloc
    some = d"Some(" + q + vec_get(inst, 1) + q + d")"
    select_str(vec_get(inst, 4) == 1, some, d"None")

fn emit_call(inst: Int) -> String ! alloc
    q = qquote()
    destbit = emit_call_dest(inst, q)
    args = vec_get(inst, 3)
    pref = "  Call {{ dest: " + destbit + ", func: " + q + vec_get(inst, 2) + q + ", args: ["
    acc = emit_arg_list(args, 0, vec_len(args), pref)
    str_append(acc, "] }}\n")

fn emit_place(inst: Int) -> String ! alloc
    q = qquote()
    "  PlaceCopy {{ dest: " + q + vec_get(inst, 1) + q + ", from: " + q + vec_get(inst, 2) + q + ", to_place: " + q + vec_get(inst, 3) + q + " }}\n"

fn emit_ret(inst: Int) -> String ! alloc
    q = qquote()
    "  Return {{ value: " + q + vec_get(inst, 1) + q + " }}\n"

fn emit_drop(inst: Int) -> String ! alloc
    q = qquote()
    "  Drop {{ name: " + q + vec_get(inst, 1) + q + " }}\n"

fn emit_if_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn trim_nl(piece: String) -> String ! alloc
    ln = str_len(piece)
    if ln > 0
        if str_char(piece, ln - 1) == 10
            str_slice(piece, 0, ln - 1)
        else
            piece
    else
        piece

fn emit_if_body(body: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_if_comma(i)
        acc = str_append(acc, comma)
        piece = emit_inst(vec_get(body, i))
        piece2 = trim_nl(piece)
        piece3 = strip_spaces(piece2)
        acc = str_append(acc, piece3)
        emit_if_body(body, i + 1, n, acc)

fn strip_spaces(s: String) -> String ! alloc
    n = str_len(s)
    i = 0
    strip_spaces_go(s, 0, n)

fn strip_spaces_go(s: String, i: Int, n: Int) -> String ! alloc
    if i >= n
        strdup("")
    elsif str_char(s, i) == 32
        strip_spaces_go(s, i + 1, n)
    else
        str_slice(s, i, n)

fn emit_if_inst(inst: Int) -> String ! alloc
    q = qquote()
    tb = vec_get(inst, 3)
    eb = vec_get(inst, 4)
    acc = "  If {{ cond: " + q + vec_get(inst, 2) + q + ", then_body: ["
    acc = emit_if_body(tb, 0, vec_len(tb), acc)
    acc = str_append(acc, "], else_body: [")
    acc = emit_if_body(eb, 0, vec_len(eb), acc)
    acc = str_append(acc, "], then_val: ")
    acc = str_append(acc, q)
    acc = str_append(acc, vec_get(inst, 5))
    acc = str_append(acc, q)
    acc = str_append(acc, ", else_val: ")
    acc = str_append(acc, q)
    acc = str_append(acc, vec_get(inst, 6))
    acc = str_append(acc, q)
    acc = str_append(acc, ", dest: ")
    acc = str_append(acc, q)
    acc = str_append(acc, vec_get(inst, 1))
    acc = str_append(acc, q)
    str_append(acc, " }}\n")

fn emit_fused_word(fused: Int) -> String ! alloc
    if fused == 1
        "true"
    else
        "false"

fn emit_peak_bytes(r: Int) -> String ! alloc
    has_peak = vec_get(r, 3)
    place = vec_get(r, 0)
    peak = vec_get(r, 5)
    if has_peak == 1
        "{{\"" + place + "\": " + int_to_str(peak) + "}}"
    else
        "{{}}"

fn emit_peak_sym(r: Int) -> String ! alloc
    has_sym = vec_get(r, 4)
    place = vec_get(r, 0)
    peak_sym = vec_get(r, 6)
    if has_sym == 1
        " peak_symbolic={{\"" + place + "\": \"" + peak_sym + "\"}}"
    else
        ""

fn emit_region(r: Int) -> String ! alloc
    place = vec_get(r, 0)
    fused = vec_get(r, 2)
    fw = emit_fused_word(fused)
    pb = emit_peak_bytes(r)
    ps = emit_peak_sym(r)
    acc = "  region on " + place + " fused=" + fw + " peak_bytes=" + pb + ps + "\n"
    ops = vec_get(r, 1)
    emit_region_ops(ops, 0, vec_len(ops), acc)

fn emit_op_matmul(op: Int, q: String) -> String ! alloc
    "    Matmul {{ lhs: " + q + vec_get(op, 1) + q + ", rhs: " + q + vec_get(op, 2) + q + ", dest: " + q + vec_get(op, 3) + q + " }}\n"

fn emit_op_epilogue(op: Int, q: String) -> String ! alloc
    "    MapEpilogue {{ op: " + q + vec_get(op, 1) + q + ", input: " + q + vec_get(op, 2) + q + ", dest: " + q + vec_get(op, 3) + q + " }}  # fused epilogue, no intermediate buffer\n"

fn emit_op_softmax(op: Int, q: String) -> String ! alloc
    "    Softmax {{ input: " + q + vec_get(op, 1) + q + ", dest: " + q + vec_get(op, 3) + q + " }}\n"

fn emit_one_op(op: Int) -> String ! alloc
    k = vec_get(op, 0)
    q = qquote()
    if k == FO_MATMUL()
        emit_op_matmul(op, q)
    elsif k == FO_EPILOGUE()
        emit_op_epilogue(op, q)
    elsif k == FO_SOFTMAX()
        emit_op_softmax(op, q)
    else
        ""

fn emit_region_ops(ops: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_one_op(vec_get(ops, i))
        acc2 = str_append(acc, piece)
        emit_region_ops(ops, i + 1, n, acc2)

fn emit_dim_comma(i: Int) -> String ! alloc
    if i > 0
        strdup(", ")
    else
        strdup("")

fn emit_dim_params(dps: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_dim_comma(i)
        acc = str_append(acc, comma)
        q = qquote()
        acc = str_append(acc, q)
        acc = str_append(acc, vec_get(dps, i))
        acc = str_append(acc, q)
        emit_dim_params(dps, i + 1, n, acc)

fn emit_dim_section(dps: Int) -> String ! alloc
    if vec_len(dps) > 0
        acc = strdup("  dim_params=[")
        acc = emit_dim_params(dps, 0, vec_len(dps), acc)
        acc = str_append(acc, strdup("]\n"))
        acc
    else
        strdup("")

fn emit_fn(irf: Int) -> String ! alloc
    name = vec_get(irf, 0)
    dps = vec_get(irf, 1)
    insts = vec_get(irf, 2)
    regions = vec_get(irf, 3)
    dims = emit_dim_section(dps)
    acc = "fn " + name + ":\n" + dims
    acc = emit_insts(insts, 0, vec_len(insts), acc)
    emit_regions(regions, 0, vec_len(regions), acc)

fn emit_insts(insts: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_inst(vec_get(insts, i))
        acc = str_append(acc, piece)
        # free(piece)
        emit_insts(insts, i + 1, n, acc)

fn emit_regions(regions: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_region(vec_get(regions, i))
        acc = str_append(acc, piece)
        # free(piece)
        emit_regions(regions, i + 1, n, acc)

fn ir_to_text(mod: Int) -> String ! alloc
    ir_text(mod)

fn emit_fns(mod: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_fn(vec_get(mod, i))
        acc = str_append(acc, piece)
        # free(piece)
        emit_fns(mod, i + 1, n, acc)

fn emit_ir_from_prog(prog: Int) -> String ! alloc
    emit_ir_from_prog_with_extra(prog, vec_new())

fn emit_ir_from_prog_with_extra(prog: Int, extra: Int) -> String ! alloc
    ir = lower_program_with_callables(prog, extra)
    ir_to_text(ir)

fn dep_fn_names(order: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        m = vec_get(order, i)
        out2 = append_fn_names_from_prog(mod_prog(m), out)
        dep_fn_names(order, i + 1, n, out2)

fn emit_ir_from_graph(order_in: Int, source_path: String) -> Int ! alloc
    _p = source_path
    order = module_order_vec(order_in)
    n = vec_len(order)
    extra = vec_new()
    if n > 1
        extra = dep_fn_names(order, 0, n - 1, extra)
    else
        extra = extra
    root_prog = graph_root_prog(order_in)
    result_ok(emit_ir_from_prog_with_extra(root_prog, extra))

fn emit_ir_from_path(source_path: String) -> Int ! io, alloc
    proot = project_root()
    g = resolve_module_graph(source_path, proot)
    if result_is_err(g) == 1
        g
    else
        emit_ir_from_graph(result_payload(g), source_path)

fn emit_ir_single_file(src: Int) -> Int ! io, alloc
    pre = preprocess(src)
    parsed = parse_program(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        prog = result_unwrap(parsed)
        dir = cache_dir()
        _m = mkdir_p(dir)
        key = source_hash(pre)
        irpath = cache_ir_path(dir, key)
        metapath = cache_meta_path(dir, key)
        cached = read_file(irpath)
        if str_len(cached) > 0
            _w = write_file(metapath, strdup("hit=1\n"))
            result_ok(cached)
        else
            ir0 = emit_ir_from_prog(prog)
            _w0 = write_file(irpath, ir0)
            _w1 = write_file(metapath, strdup("hit=0\n"))
            result_ok(ir0)

fn emit_ir_imported_file(source_path: String, src: Int) -> Int ! io, alloc
    dir = cache_dir()
    _m = mkdir_p(dir)
    g = resolve_module_graph(source_path, project_root())
    if result_is_err(g) == 1
        g
    else
        key = cache_key_for_graph_path(src, source_path)
        irpath = cache_ir_path(dir, key)
        metapath = cache_meta_path(dir, key)
        cached = read_file(irpath)
        if str_len(cached) > 0
            _w = write_file(metapath, strdup("hit=1\n"))
            result_ok(cached)
        else
            ir1 = emit_ir_from_graph(g, source_path)
            if result_is_err(ir1) == 1
                ir1
            else
                body = result_unwrap(ir1)
                _w2 = write_file(irpath, body)
                _w3 = write_file(metapath, strdup("hit=0\n"))
                result_ok(body)

fn emit_ir_for_file(source_path: String, src: Int) -> Int ! io, alloc
    if str_len(source_path) > 0
        if str_contains(src, strdup("import")) == 1
            emit_ir_imported_file(source_path, src)
        else
            emit_ir_single_file(src)
    else
        emit_ir_single_file(src)

fn emit_ir(src: Int) -> Int ! io, alloc
    emit_ir_for_file(strdup(""), src)

fn emit_c_from_prog_result(src: Int) -> Int ! alloc
    pre = preprocess(src)
    parsed = parse_program(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        prog = result_unwrap(parsed)
        result_ok(emit_c_from_ast(prog))

fn emit_c_for_file(source_path: String, src: Int, out_path: String) -> Int ! io, alloc
    pre = preprocess(src)
    parsed = parse_program(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        prog = result_unwrap(parsed)
        if str_len(source_path) == 0
            result_ok(emit_c_from_ast(prog))
        elsif vec_len(prog_imports(prog)) == 0
            ccode = emit_c_from_ast(prog)
            cpath = tmp_path("out.c")
            _w = write_file(cpath, ccode)
            if clang(cpath, out_path) == 0
                result_ok(strdup(""))
            else
                result_err(strdup("clang failed"))
        else
            emit_c_from_path(source_path, out_path)

fn emit_c_from_path(source_path: String, out_path: String) -> Int ! io, alloc
    proot = project_root()
    g = resolve_module_graph(source_path, proot)
    if result_is_err(g) == 1
        g
    else
        chk = check_all_modules(g, proot)
        if result_is_err(chk) == 1
            chk
        else
            root_key = graph_root_key(g)
            emit_c_compile_graph(g, root_key, out_path, proot)

# ---- emit_c (AST → C) ----
fn mangled(name: String) -> String ! alloc
    "fn_" + name

fn c_escape_go(s: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 92
            acc = str_append(acc, strdup("\\\\"))
            c_escape_go(s, i + 1, n, acc)
        elsif c == 34
            acc = str_append(acc, strdup("\\\""))
            c_escape_go(s, i + 1, n, acc)
        elsif c == 10
            acc = str_append(acc, strdup("\\n"))
            c_escape_go(s, i + 1, n, acc)
        elsif c == 9
            acc = str_append(acc, strdup("\\t"))
            c_escape_go(s, i + 1, n, acc)
        else
            piece = char_to_str(c)
            acc = str_append(acc, piece)
            # free(piece)
            c_escape_go(s, i + 1, n, acc)

fn c_escape_str(s: Int) -> Int ! alloc
    acc = strdup("\"")
    if s == 0
        acc = str_append(acc, strdup("\""))
        acc
    else
        acc = c_escape_go(s, 0, str_len(s), acc)
        acc = str_append(acc, strdup("\""))
        acc

fn c_string_init(s: Int) -> Int ! alloc
    if s == 0
        strdup("\"\"")
    else
        acc = strdup("\"")
        acc = c_escape_go(s, 0, str_len(s), acc)
        str_append(acc, strdup("\""))

fn lit_pool_new() -> Int ! alloc
    v = vec_new()
    _a = vec_push(v, strdup(""))
    _b = vec_push(v, vec_new())
    _c = vec_push(v, vec_new())
    _d = vec_push(v, 0)
    v

fn lit_pool_globals(pool: Int) -> Int ! alloc
    vec_get(pool, 0)

fn lit_pool_find(s: Int, texts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_eq(vec_get(texts, i), s) == 1
        i
    else
        lit_pool_find(s, texts, i + 1, n)

fn sal_lit_decl_n(s: Int, name: Int, n: Int) -> Int ! alloc
    init = select_str(s == 0, strdup("\"\""), c_string_init(s))
    arr = n + 1
    acc = d"static const struct {{ int64_t cap; int64_t len; char b["
    acc = str_append(acc, int_to_str(arr))
    acc = str_append(acc, d"]; }} __attribute__((aligned(16))) ")
    acc = str_append(acc, name)
    acc = str_append(acc, d" = {{ 0, ")
    acc = str_append(acc, int_to_str(n))
    acc = str_append(acc, strdup(", "))
    acc = str_append(acc, init)
    str_append(acc, d" }};\n")

fn sal_lit_decl(s: Int, name: Int) -> Int ! alloc
    if s == 0
        sal_lit_decl_n(s, name, 0)
    else
        sal_lit_decl_n(s, name, str_len(s))

fn ensure_sal_lit(s: Int, pool: Int) -> Int ! alloc
    texts = vec_get(pool, 1)
    idx = lit_pool_find(s, texts, 0, vec_len(texts))
    if idx >= 0
        sym = vec_get(vec_get(pool, 2), idx)
        "((int64_t)(uintptr_t)" + sym + ".b)"
    else
        nid = vec_get(pool, 3) + 1
        _u = vec_set(pool, 3, nid)
        decl = sal_lit_decl(s, "sal_lit_" + int_to_str(nid))
        gacc = lit_pool_globals(pool)
        _g = vec_set(pool, 0, str_append(gacc, decl))
        _t = vec_push(texts, s)
        _sy = vec_push(vec_get(pool, 2), "sal_lit_" + int_to_str(nid))
        cast = str_append(strdup("((int64_t)(uintptr_t)"), "sal_lit_" + int_to_str(nid))
        str_append(cast, strdup(".b)"))

fn runtime_decls() -> Int ! alloc
    d"#include <stdint.h>\n#include <stdlib.h>\nvoid sal_runtime_init(int64_t argc, const char **argv);\nchar *sal_argv(int64_t i);\nchar *sal_read_file(const char *path);\nint64_t sal_write_file(const char *path, const char *data);\nint64_t sal_print_str(const char *data);\nint64_t sal_eprint_str(const char *data);\nchar *sal_getenv(const char *name);\nint64_t sal_mkdir_p(const char *path);\nint64_t sal_str_eq(const char *a, const char *b);\nint64_t sal_str_contains(const char *a, const char *b);\nint64_t sal_str_len(const char *s);\nchar *sal_str_concat(const char *a, const char *b);\nchar *sal_str_append(char *a, const char *b);\nchar *sal_strdup(const char *s);\nchar *sal_select_str(int64_t cond, char *a, char *b);\nvoid sal_free(void *p);\nint64_t sal_not(int64_t x);\nint64_t sal_gated_print_str(int64_t cond, const char *data);\nchar *sal_tmp_path(const char *suffix);\nint64_t sal_clang(const char *c_path, const char *out_path);\nint64_t sal_path_readable(const char *path);\nchar *sal_realpath(const char *p);\nint64_t sal_clang_obj(const char *c_path, const char *obj_path);\nint64_t sal_link_objs(const char *objs, const char *out_path);\nchar *sal_char_to_str(int64_t c);\nchar *sal_int_to_str(int64_t v);\nchar *sal_str_slice(const char *s, int64_t start, int64_t end);\nint64_t sal_str_char(const char *s, int64_t i);\nint64_t sal_str_skip(const char *s, int64_t i, int64_t kind, int64_t limit);\nint64_t sal_str_hash(const char *s, int64_t seed);\nvoid *sal_map_new(void);\nint64_t sal_map_get(void *m, const char *key);\nint64_t sal_map_put(void *m, const char *key, int64_t val);\nchar *sal_ir_text(void *mod);\nvoid *sal_lex_src(const char *src);\nvoid *sal_vec_new(void);\nint64_t sal_vec_push(void *v, int64_t x);\nint64_t sal_vec_get(void *v, int64_t i);\nint64_t sal_vec_set(void *v, int64_t i, int64_t x);\nint64_t sal_vec_len(void *v);\nvoid sal_vec_free(void *v);\nint64_t sal_print_i64(int64_t v);\nint64_t sal_place_matmul_ai_sum(int64_t place);\nint64_t sal_place_launches(int64_t place);\nvoid sal_on_enter(int64_t place);\nvoid *sal_image_new(int64_t w, int64_t h);\nint64_t sal_write_png(const char *path, int64_t w, int64_t h, void *rgb);\n\n"

fn user_fns_from_prog(prog: Int) -> Int ! alloc
    fns = prog_fns(prog)
    collect_fn_names(fns, 0, vec_len(fns), vec_new())

fn names_has(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        names_has(names, name, i + 1, n)

fn collect_assigns_block(b: Int, names: Int) -> Int ! alloc
    if b == 0
        0
    else
        stmts = block_stmts(b)
        _a = collect_assigns_stmts(stmts, 0, vec_len(stmts), names)
        collect_assigns_expr(block_tail(b), names)

fn collect_assigns_stmts(stmts: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(stmts, i)
        if vec_get(st, 0) == 1
            nm = vec_get(st, 1)
            if names_has(names, nm, 0, vec_len(names)) == 0
                _p = vec_push(names, nm)
            else
                _p = 0
        else
            _p = 0
        _c = collect_assigns_expr(vec_get(st, 2), names)
        collect_assigns_stmts(stmts, i + 1, n, names)

fn collect_assigns_expr(e: Int, names: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_IF()
            _a = collect_assigns_expr(vec_get(e, 1), names)
            _b = collect_assigns_block(vec_get(e, 2), names)
            _c = collect_assigns_arms(vec_get(e, 4), 0, vec_len(vec_get(e, 4)), names)
            collect_assigns_block(vec_get(e, 3), names)
        elsif k == EX_WHILE()
            _a = collect_assigns_expr(vec_get(e, 1), names)
            collect_assigns_block(vec_get(e, 2), names)
        elsif k == EX_BINARY()
            _a = collect_assigns_expr(vec_get(e, 2), names)
            collect_assigns_expr(vec_get(e, 3), names)
        elsif k == EX_CALL()
            args = vec_get(e, 2)
            collect_assigns_args(args, 0, vec_len(args), names)
        elsif k == EX_TO()
            collect_assigns_expr(vec_get(e, 2), names)
        elsif k == EX_ON()
            collect_assigns_block(vec_get(e, 2), names)
        else
            0

fn collect_assigns_arms(arms: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = vec_get(arms, i)
        _a = collect_assigns_expr(vec_get(arm, 0), names)
        _b = collect_assigns_block(vec_get(arm, 1), names)
        collect_assigns_arms(arms, i + 1, n, names)

fn collect_assigns_args(args: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = collect_assigns_expr(vec_get(args, i), names)
        collect_assigns_args(args, i + 1, n, names)

fn emit_decl_names(names: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        acc = str_append(acc, strdup("  int64_t "))
        acc = str_append(acc, vec_get(names, i))
        acc = str_append(acc, strdup(" = 0;\n"))
        emit_decl_names(names, i + 1, n, acc)

fn tmp_counter_new(pool: Int) -> Int ! alloc
    v = vec_new()
    _p = vec_push(v, 0)
    _q = vec_push(v, strenv_new())
    _r = vec_push(v, pool)
    v

fn tc_strenv(tc: Int) -> Int ! alloc
    vec_get(tc, 1)

fn tc_lit_pool(tc: Int) -> Int ! alloc
    vec_get(tc, 2)

fn seed_string_params(params: Int, i: Int, n: Int, env: Int) -> Int ! alloc
    if i >= n
        0
    else
        pm = vec_get(params, i)
        if ty_is_string(vec_get(pm, 1)) == 1
            _b = strenv_bind(env, vec_get(pm, 0), 1)
        else
            _b = 0
        seed_string_params(params, i + 1, n, env)

fn tmp_fresh(tc: Int) -> Int ! alloc
    n = vec_get(tc, 0) + 1
    _s = vec_set(tc, 0, n)
    "__t" + int_to_str(n)

fn cmap_op(op: Int) -> Int ! alloc
    if str_eq(op, "add") == 1
        "+"
    elsif str_eq(op, "sub") == 1
        "-"
    elsif str_eq(op, "mul") == 1
        "*"
    elsif str_eq(op, "div") == 1
        "/"
    elsif str_eq(op, "eq") == 1
        "=="
    elsif str_eq(op, "ne") == 1
        "!="
    elsif str_eq(op, "lt") == 1
        "<"
    elsif str_eq(op, "le") == 1
        "<="
    elsif str_eq(op, "gt") == 1
        ">"
    elsif str_eq(op, "ge") == 1
        ">="
    else
        "+"

fn emit_c_expr(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    if e == 0
        d"0"
    else
        k = ex_kind(e)
        if k == EX_INT()
            int_to_str(vec_get(e, 1))
        elsif k == EX_FLOAT()
            strdup("0")
        elsif k == EX_STRING()
            ensure_sal_lit(vec_get(e, 1), tc_lit_pool(tc))
        elsif k == EX_IDENT()
            strdup(vec_get(e, 1))
        else
            if k == EX_BINARY()
                emit_c_binary(e, user, stmts, tc)
            else
                if k == EX_CALL()
                    emit_c_call(e, user, stmts, tc)
                else
                    if k == EX_IF()
                        emit_c_if(e, user, stmts, tc)
                    else
                        if k == EX_WHILE()
                            emit_c_while(e, user, stmts, tc)
                        else
                            strdup("0")

fn emit_c_str_add(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    l = emit_c_expr(vec_get(e, 2), user, stmts, tc)
    r = emit_c_expr(vec_get(e, 3), user, stmts, tc)
    args = vec_new()
    _a = vec_push(args, l)
    _b = vec_push(args, r)
    if binary_add_uses_append(e, tc_strenv(tc)) == 1
        emit_c_builtin2(strdup("str_append"), args, stmts)
    else
        emit_c_builtin2(strdup("str_concat"), args, stmts)

fn emit_c_binary(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    if binary_add_is_string_concat(e, tc_strenv(tc)) == 1
        emit_c_str_add(e, user, stmts, tc)
    else
        emit_c_binary_num(e, user, stmts, tc)

fn emit_c_binary_num(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    l = emit_c_expr(vec_get(e, 2), user, stmts, tc)
    r = emit_c_expr(vec_get(e, 3), user, stmts, tc)
    op = cmap_op(vec_get(e, 1))
    "(" + l + " " + op + " " + r + ")"

fn emit_c_args(args: Int, i: Int, n: Int, user: Int, stmts: Int, tc: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = emit_c_expr(vec_get(args, i), user, stmts, tc)
        _p = vec_push(out, a)
        emit_c_args(args, i + 1, n, user, stmts, tc, out)

fn join_comma_piece(i: Int) -> Int ! alloc
    if i > 0
        strdup(", ")
    else
        strdup("")

fn join_commas(parts: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        comma = join_comma_piece(i)
        acc = str_append(acc, comma)
        acc = str_append(acc, vec_get(parts, i))
        join_commas(parts, i + 1, n, acc)

fn emit_c_call(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    fname = vec_get(e, 1)
    args_e = vec_get(e, 2)
    arg_parts = emit_c_args(args_e, 0, vec_len(args_e), user, stmts, tc, vec_new())
    if names_has(user, fname, 0, vec_len(user)) == 1
        m = mangled(fname)
        acc = str_append(m, "(")
        acc = join_commas(arg_parts, 0, vec_len(arg_parts), acc)
        str_append(acc, ")")
    else
        emit_c_builtin(fname, arg_parts, stmts)

fn arg_at(args: Int, i: Int) -> Int ! alloc
    if i < vec_len(args)
        vec_get(args, i)
    else
        d"0"

fn emit_c_builtin(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "map_new") == 1
        d"((int64_t)(uintptr_t)sal_map_new())"
    elsif str_eq(fname, "map_get") == 1
        a0 = arg_at(args, 0)
        a1 = arg_at(args, 1)
        "sal_map_get((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ")"
    elsif str_eq(fname, "map_put") == 1
        a0 = arg_at(args, 0)
        a1 = arg_at(args, 1)
        a2 = arg_at(args, 2)
        "sal_map_put((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ", " + a2 + ")"
    elsif str_eq(fname, "ir_text") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_ir_text((void *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, "lex_src") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_lex_src((const char *)(uintptr_t)" + a0 + "))"
    else
        emit_c_builtin_skip(fname, args, stmts)

fn emit_c_builtin_skip(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "str_skip") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        d = arg_at(args, 3)
        "sal_str_skip((const char*)(uintptr_t)" + a + "," + b + "," + c + "," + d + ")"
    elsif str_eq(fname, "str_hash") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_hash((const char*)(uintptr_t)" + a + "," + b + ")"
    else
        emit_c_builtin_rest(fname, args, stmts)

fn emit_c_builtin_rest(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "vec_new") == 1
        d"((int64_t)(uintptr_t)sal_vec_new())"
    elsif str_eq(fname, "argv") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_argv(" + a0 + "))"
    elsif str_eq(fname, "read_file") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_read_file((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, "strdup") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_strdup((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, "tmp_path") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_tmp_path((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, "int_to_str") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_int_to_str(" + a0 + "))"
    elsif str_eq(fname, "char_to_str") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_char_to_str(" + a0 + "))"
    else
        emit_c_builtin2(fname, args, stmts)

fn emit_c_builtin2(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "str_append") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_str_append((char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
    else
        if str_eq(fname, "str_concat") == 1
            a = arg_at(args, 0)
            b = arg_at(args, 1)
            "((int64_t)(uintptr_t)sal_str_concat((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
        else
            if str_eq(fname, "str_slice") == 1
                a = arg_at(args, 0)
                b = arg_at(args, 1)
                c = arg_at(args, 2)
                "((int64_t)(uintptr_t)sal_str_slice((const char*)(uintptr_t)" + a + "," + b + "," + c + "))"
            else
                if str_eq(fname, "free") == 1
                    a0 = arg_at(args, 0)
                    line = "  sal_free((void*)(uintptr_t)" + a0 + ");\n"
                    _p = vec_push(stmts, line)
                    strdup("0")
                else
                    if str_eq(fname, "clang") == 1
                        a = arg_at(args, 0)
                        b = arg_at(args, 1)
                        "sal_clang((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
                    else
                        if str_eq(fname, "clang_obj") == 1
                            a = arg_at(args, 0)
                            b = arg_at(args, 1)
                            "sal_clang_obj((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
                        else
                            if str_eq(fname, "link_objs") == 1
                                a = arg_at(args, 0)
                                b = arg_at(args, 1)
                                "sal_link_objs((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
                            else
                                if str_eq(fname, "realpath") == 1
                                    a = arg_at(args, 0)
                                    "((int64_t)(uintptr_t)sal_realpath((const char*)(uintptr_t)" + a + "))"
                                else
                                    if str_eq(fname, "path_readable") == 1
                                        a = arg_at(args, 0)
                                        "sal_path_readable((const char*)(uintptr_t)" + a + ")"
                                    else
                                        emit_c_builtin3(fname, args, stmts)

fn emit_c_builtin3(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "gated_print_str") == 1
        a = arg_at(args, 0)
