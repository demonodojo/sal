                else
                    if str_eq(fname, "str_len") == 1
                        a = arg_at(args, 0)
                        "sal_str_len((const char*)(uintptr_t)" + a + ")"
                    else
                        emit_c_builtin4(fname, args, stmts)

fn emit_c_builtin4(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "str_char") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_char((const char*)(uintptr_t)" + a + "," + b + ")"
    elsif str_eq(fname, "vec_push") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_vec_push((void*)(uintptr_t)" + a + "," + b + ")"
    elsif str_eq(fname, "vec_get") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_vec_get((void*)(uintptr_t)" + a + "," + b + ")"
    elsif str_eq(fname, "vec_set") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        "sal_vec_set((void*)(uintptr_t)" + a + "," + b + "," + c + ")"
    elsif str_eq(fname, "vec_len") == 1
        a = arg_at(args, 0)
        "sal_vec_len((void*)(uintptr_t)" + a + ")"
    else
        emit_c_builtin5(fname, args, stmts)

fn emit_c_builtin5(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "vec_free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_vec_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, line)
        strdup("0")
    elsif str_eq(fname, "not") == 1
        a0 = arg_at(args, 0)
        "sal_not(" + a0 + ")"
    elsif str_eq(fname, "print_str") == 1
        a0 = arg_at(args, 0)
        "sal_print_str((const char*)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, "eprint_str") == 1
        a0 = arg_at(args, 0)
        "sal_eprint_str((const char*)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, "print") == 1
        a0 = arg_at(args, 0)
        "sal_print_i64(" + a0 + ")"
    elsif str_eq(fname, "getenv") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_getenv((const char*)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, "mkdir_p") == 1
        a0 = arg_at(args, 0)
        "sal_mkdir_p((const char*)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, "select_str") == 1
        c = arg_at(args, 0)
        a = arg_at(args, 1)
        b = arg_at(args, 2)
        "((int64_t)(uintptr_t)sal_select_str(" + c + ",(char*)(uintptr_t)" + a + ",(char*)(uintptr_t)" + b + "))"
    elsif str_eq(fname, "place_matmul_ai_sum") == 1
        a0 = arg_at(args, 0)
        "sal_place_matmul_ai_sum(" + a0 + ")"
    elsif str_eq(fname, "place_launches") == 1
        a0 = arg_at(args, 0)
        "sal_place_launches(" + a0 + ")"
    elsif str_eq(fname, "image_new") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_image_new(" + a + "," + b + "))"
    elsif str_eq(fname, "write_png") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        d = arg_at(args, 3)
        "sal_write_png((const char*)(uintptr_t)" + a + "," + b + "," + c + ",(void*)(uintptr_t)" + d + ")"
    else
        strdup("0")

fn emit_c_while(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    cond_stmts = vec_new()
    c = emit_c_expr(vec_get(e, 1), user, cond_stmts, tc)
    _q = vec_push(stmts, "  while (1) {{\n")
    _a = append_stmts(stmts, cond_stmts)
    line = "    if (!(" + c + ")) break;\n"
    _b = vec_push(stmts, line)
    body_stmts = vec_new()
    _tv = emit_c_block(vec_get(e, 2), user, body_stmts, tc)
    _c = append_stmts(stmts, body_stmts)
    _d = vec_push(stmts, "  }}\n")
    strdup("0")

fn emit_c_if(e: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    c = emit_c_expr(vec_get(e, 1), user, stmts, tc)
    tname = tmp_fresh(tc)
    line = "  int64_t " + tname + ";\n"
    _p = vec_push(stmts, line)
    line2 = "  if (" + c + ") {{\n"
    _q = vec_push(stmts, line2)
    slen = strenv_len(tc_strenv(tc))
    then_stmts = vec_new()
    then_val = emit_c_block(vec_get(e, 2), user, then_stmts, tc)
    _rs = strenv_set_len(tc_strenv(tc), slen)
    _a = append_stmts(stmts, then_stmts)
    line3 = "    " + tname + " = " + then_val + ";\n"
    _r = vec_push(stmts, line3)
    _s = vec_push(stmts, "  }} else {{\n")
    else_stmts = vec_new()
    else_b = else_block_for_elsifs(vec_get(e, 3), vec_get(e, 4))
    else_val = emit_c_block(else_b, user, else_stmts, tc)
    _rs2 = strenv_set_len(tc_strenv(tc), slen)
    _b = append_stmts(stmts, else_stmts)
    line4 = "    " + tname + " = " + else_val + ";\n"
    _t = vec_push(stmts, line4)
    _u = vec_push(stmts, "  }}\n")
    tname

fn append_stmts(dst: Int, src: Int) -> Int ! alloc
    append_stmts_go(dst, src, 0, vec_len(src))

fn append_stmts_go(dst: Int, src: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        append_stmts_go(dst, src, i + 1, n)

fn emit_c_block(b: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    if b == 0
        strdup("0")
    else
        _a = emit_c_stmts(block_stmts(b), 0, vec_len(block_stmts(b)), user, stmts, tc)
        tail = block_tail(b)
        if tail == 0
            strdup("0")
        else
            emit_c_expr(tail, user, stmts, tc)

fn emit_c_stmts(sts: Int, i: Int, n: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(sts, i)
        if vec_get(st, 0) == 1
            val = emit_c_expr(vec_get(st, 2), user, stmts, tc)
            _ns = strenv_bind(tc_strenv(tc), vec_get(st, 1), expr_produces_string(vec_get(st, 2), tc_strenv(tc)))
            line = "  " + vec_get(st, 1) + " = " + val + ";\n"
            _p = vec_push(stmts, line)
        else
            val = emit_c_expr(vec_get(st, 2), user, stmts, tc)
            line = "  " + val + ";\n"
            _p = vec_push(stmts, line)
        emit_c_stmts(sts, i + 1, n, user, stmts, tc)

fn emit_params_comma(i: Int) -> Int ! alloc
    if i > 0
        strdup(", ")
    else
        strdup("")

fn emit_params_c(params: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        comma = emit_params_comma(i)
        acc = str_append(acc, comma)
        acc = str_append(acc, strdup("int64_t "))
        acc = str_append(acc, vec_get(vec_get(params, i), 0))
        emit_params_c(params, i + 1, n, acc)

fn emit_extern_comma(i: Int, acc: Int) -> Int ! alloc
    if i > 0
        str_append(acc, strdup(", "))
    else
        acc

fn emit_extern_params(n: Int, i: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        acc2 = emit_extern_comma(i, acc)
        acc3 = str_append(acc2, strdup("int64_t p"))
        acc4 = str_append(acc3, int_to_str(i))
        emit_extern_params(n, i + 1, acc4)

fn emit_extern_decl(pair: Int) -> Int ! alloc
    name = vec_get(pair, 0)
    nparams = vec_get(pair, 1)
    m = mangled(name)
    acc = "extern int64_t " + m + "("
    if nparams == 0
        acc = str_append(acc, "void")
    else
        acc = emit_extern_params(nparams, 0, acc)
    str_append(acc, ");\n")

fn emit_extern_decls(externs: Int, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        piece = emit_extern_decl(vec_get(externs, i))
        acc = str_append(acc, piece)
        emit_extern_decls(externs, i + 1, n, acc)

fn emit_c_fn_header(f: Int, linkable: Int, allow_main: Int) -> Int ! alloc
    name = vec_get(f, 0)
    params = vec_get(f, 1)
    if allow_main == 0
        if str_eq(name, "main") == 1
            strdup("")
        else
            emit_c_fn_header_body(name, params, linkable)
    else
        if str_eq(name, "main") == 1
            "int main(int argc, char **argv) {{\n  sal_runtime_init((int64_t)argc, (const char **)argv);\n"
        else
            emit_c_fn_header_body(name, params, linkable)

fn emit_c_fn_header_body(name: Int, params: Int, linkable: Int) -> Int ! alloc
    m = mangled(name)
    pref = select_str(linkable, strdup("int64_t "), strdup("static int64_t "))
    acc = str_append(pref, m)
    acc = str_append(acc, strdup("("))
    acc = emit_params_c(params, 0, vec_len(params), acc)
    str_append(acc, strdup(") {{\n"))

fn emit_c_fn_footer(is_main: Int, val: Int) -> Int ! alloc
    if is_main == 1
        "  return (int)(" + val + ");\n}}\n\n"
    else
        "  return " + val + ";\n}}\n\n"

fn param_names(params: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, vec_get(vec_get(params, i), 0))
        param_names(params, i + 1, n, out)

fn emit_decl_names_filtered(names: Int, i: Int, n: Int, skip: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        nm = vec_get(names, i)
        if names_has(skip, nm, 0, vec_len(skip)) == 1
            emit_decl_names_filtered(names, i + 1, n, skip, acc)
        else
            acc = str_append(acc, strdup("  int64_t "))
            acc = str_append(acc, nm)
            acc = str_append(acc, strdup(" = 0;\n"))
            emit_decl_names_filtered(names, i + 1, n, skip, acc)

fn emit_c_fn(f: Int, user: Int, linkable: Int, allow_main: Int, pool: Int) -> Int ! alloc
    name = vec_get(f, 0)
    body = vec_get(f, 2)
    is_main = str_eq(name, "main")
    acc = emit_c_fn_header(f, linkable, allow_main)
    if str_len(acc) == 0
        strdup("")
    else
        emit_c_fn_body(f, user, is_main, acc, pool)

fn emit_c_fn_body(f: Int, user: Int, is_main: Int, acc: Int, pool: Int) -> Int ! alloc
    name = vec_get(f, 0)
    body = vec_get(f, 2)
    names = vec_new()
    _c = collect_assigns_block(body, names)
    skip = param_names(vec_get(f, 1), 0, vec_len(vec_get(f, 1)), vec_new())
    acc = emit_decl_names_filtered(names, 0, vec_len(names), skip, acc)
    stmts = vec_new()
    tc = tmp_counter_new(pool)
    _sp = seed_string_params(vec_get(f, 1), 0, vec_len(vec_get(f, 1)), tc_strenv(tc))
    val = emit_c_block(body, user, stmts, tc)
    acc = append_stmt_strings(acc, stmts, 0, vec_len(stmts))
    foot = emit_c_fn_footer(is_main, val)
    acc = str_append(acc, foot)
    acc

fn emit_forward_params(params: Int) -> Int ! alloc
    if vec_len(params) == 0
        strdup("void")
    else
        emit_params_c(params, 0, vec_len(params), strdup(""))

fn emit_forward_decls(fns: Int, i: Int, n: Int, acc: Int, allow_main: Int, linkable: Int) -> Int ! alloc
    idx = i
    out = acc
    while idx < n
        f = vec_get(fns, idx)
        name = vec_get(f, 0)
        skip_main = 0
        if allow_main == 0
            if str_eq(name, "main") == 1
                skip_main = 1
            else
                skip_main = 0
        elsif str_eq(name, "main") == 1
            skip_main = 1
        else
            skip_main = 0
        if skip_main == 0
            out = emit_forward_one(f, out, linkable)
        else
            out = out
        idx = idx + 1
    out

fn emit_forward_one(f: Int, acc: Int, linkable: Int) -> Int ! alloc
    m = mangled(vec_get(f, 0))
    pref = select_str(linkable, strdup("int64_t "), strdup("static int64_t "))
    acc = str_append(acc, pref)
    acc = str_append(acc, m)
    acc = str_append(acc, strdup("("))
    ps = emit_forward_params(vec_get(f, 1))
    acc = str_append(acc, ps)
    str_append(acc, strdup(");\n"))

fn append_stmt_strings(acc: Int, stmts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        acc
    else
        acc = str_append(acc, vec_get(stmts, i))
        append_stmt_strings(acc, stmts, i + 1, n)

fn emit_c_fns(fns: Int, i: Int, n: Int, user: Int, acc: Int, allow_main: Int, linkable: Int, pool: Int) -> Int ! alloc
    idx = i
    out = acc
    while idx < n
        piece = emit_c_fn(vec_get(fns, idx), user, linkable, allow_main, pool)
        if str_len(piece) > 0
            out = str_append(out, piece)
        else
            out = out
        idx = idx + 1
    out

fn emit_c_from_ast_module(prog: Int, callables: Int, externs: Int, allow_main: Int, linkable: Int) -> Int ! alloc
    pool = lit_pool_new()
    acc = runtime_decls()
    acc = str_append(acc, strdup("#include <stdint.h>\n"))
    acc = emit_extern_decls(externs, 0, vec_len(externs), acc)
    fns = prog_fns(prog)
    acc = emit_forward_decls(fns, 0, vec_len(fns), acc, allow_main, linkable)
    acc = str_append(acc, strdup("\n"))
    body = emit_c_fns(fns, 0, vec_len(fns), callables, strdup(""), allow_main, linkable, pool)
    lits = lit_pool_globals(pool)
    if str_len(lits) > 0
        acc = str_append(acc, lits)
        acc = str_append(acc, strdup("\n"))
    str_append(acc, body)

fn emit_c_from_ast(prog: Int) -> Int ! alloc
    user = user_fns_from_prog(prog)
    emit_c_from_ast_module(prog, user, vec_new(), 1, 0)

fn call_link_objs(obj_list: Int, out_path: Int) -> Int ! io, alloc
    link_objs(obj_list, out_path)

fn call_clang_obj(c_path: Int, o_path: Int) -> Int ! io, alloc
    clang_obj(c_path, o_path)

fn obj_list_prefix(obj_list: Int) -> Int ! alloc
    if str_len(obj_list) > 0
        str_append(obj_list, strdup(" "))
    else
        obj_list

fn emit_c_compile_graph_go(graph: Int, i: Int, n: Int, root_key: Int, proot: Int, out_path: Int, obj_list: Int) -> Int ! io, alloc
    if i >= n
        lrc = call_link_objs(obj_list, out_path)
        if lrc == 0
            result_ok(strdup(""))
        else
            result_err(strdup("link failed"))
    else
        m = vec_get(graph, i)
        is_root = str_eq(mod_key(m), root_key)
        allow_main = is_root
        cstep = callable_fn_names(m, graph, proot)
        if result_is_err(cstep) == 1
            cstep
        else
            callables = result_unwrap(cstep)
            externs = extern_fn_arity(m, graph, callables)
            ccode = emit_c_from_ast_module(mod_prog(m), callables, externs, allow_main, 1)
            cpath = tmp_path("m" + int_to_str(i) + ".c")
            opath = tmp_path("m" + int_to_str(i) + ".o")
            _w = write_file(cpath, ccode)
            if call_clang_obj(cpath, opath) != 0
                result_err(strdup("clang_obj failed"))
            else
                prefix = obj_list_prefix(obj_list)
                objs2 = str_append(prefix, opath)
                emit_c_compile_graph_go(graph, i + 1, n, root_key, proot, out_path, objs2)

fn emit_c_compile_graph(graph_in: Int, root_key: Int, out_path: Int, proot: Int) -> Int ! io, alloc
    emit_c_compile_graph_go(module_order_vec(graph_in), 0, vec_len(module_order_vec(graph_in)), root_key, proot, out_path, strdup(""))

fn emit_c(src: Int) -> Int ! alloc
    emit_c_from_prog_result(src)
