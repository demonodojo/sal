                                acc = str_append(acc, a0)
                                acc = str_append(acc, strdup("))"))
                                acc
                            else
                                emit_c_builtin2(fname, args, stmts)

fn emit_c_builtin2(fname: Int, args: Int, stmts: Int) -> Int ! alloc
    if str_eq(fname, "str_append") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
