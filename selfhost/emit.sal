# Emission: IR text and C.
import result
import lexer
import parser
import ir
import fuse
import drops
import modules
import methods
import qualify
import cache
import checks
import tshape
import tir
import tast
import tytext
import ttypes
import deprecation
import protocols

fn resolve_module_graph_qualified(source_path: String, proot: String, order: Graph) -> Int ! io, alloc
    g = resolve_module_graph(source_path, proot, order)
    if result_is_err(g) == 1
        g
    else
        q = qualify_module_graph(order, proot)
        if result_is_err(q) == 1
            q
        else
            _m = methods_resolve_graph(order)
            result_ok(0)

# ---- ir_to_text ----
fn qquote() -> String ! alloc
    char_to_str(34)

fn ir_q() -> String ! alloc
    char_to_str(34)

fn emit_escape_arg(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 34
            bs = d"\\"
            a2 = acc + bs
            # free(bs)
            piece = char_to_str(34)
            a3 = a2 + piece
            # free(piece)
            emit_escape_arg(s, i + 1, n, a3)
        elsif c == 92
            bs = d"\\\\"
            a2 = acc + bs
            # free(bs)
            emit_escape_arg(s, i + 1, n, a2)
        else
            piece = char_to_str(c)
            a2 = acc + piece
            # free(piece)
            emit_escape_arg(s, i + 1, n, a2)

fn emit_arg_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn emit_arg_list(args: List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_arg_comma(i)
        acc = acc + comma
        acc = acc + ir_q()
        a = list_get(args, i)
        esc = emit_escape_arg(a, 0, str_len(a), d"")
        acc = acc + esc
        acc = acc + ir_q()
        emit_arg_list(args, i + 1, n, acc)

fn emit_inst(inst: Inst) -> String ! alloc
    k = inst.kind
    if k == II_CI()
        emit_ci(inst)
    elsif k == II_CS()
        emit_cs(inst)
    elsif k == II_BIN()
        emit_bin(inst)
    elsif k == II_CF()
        emit_cf(inst)
    elsif k == II_TBIN()
        emit_tbin(inst)
    elsif k == II_TUN()
        emit_tun(inst)
    elsif k == II_CALL()
        emit_call(inst)
    elsif k == II_PLACE()
        emit_place(inst)
    elsif k == II_RET()
        emit_ret(inst)
    elsif k == II_DROP()
        emit_drop(inst)
    elsif k == II_IF()
        emit_if_inst(inst)
    elsif k == II_WHILE()
        emit_while_inst(inst)
    elsif k == II_AGG()
        emit_agg(inst)
    elsif k == II_EXTRACT()
        emit_extract(inst)
    elsif k == II_REBIND()
        emit_rebind(inst)
    elsif k == II_EMAKE()
        emit_emake(inst)
    elsif k == II_EFIELD()
        emit_efield(inst)
    elsif k == II_SWITCH()
        emit_switch(inst)
    elsif k == II_ANYBOX()
        emit_anybox(inst)
    elsif k == II_ANYCALL()
        emit_anycall(inst)
    else
        d""

fn emit_ci(inst: Inst) -> String ! alloc
    "  ConstInt { dest: " + ir_q() + inst.dest + ir_q() + ", value: " + int_to_str(inst.n1) + " }\n"

fn emit_cs(inst: Inst) -> String ! alloc
    "  ConstString { dest: " + ir_q() + inst.dest + ir_q() + ", value: " + ir_q() + ir_debug_escape_s(inst.s1) + ir_q() + " }\n"

fn emit_bin(inst: Inst) -> String ! alloc
    "  Binary { dest: " + ir_q() + inst.dest + ir_q() + ", op: " + ir_q() + inst.s1 + ir_q() + ", left: " + ir_q() + inst.s2 + ir_q() + ", right: " + ir_q() + inst.s3 + ir_q() + " }\n"

fn emit_cf(inst: Inst) -> String ! alloc
    "  ConstFloat { dest: " + ir_q() + inst.dest + ir_q() + ", value: " + inst.s1 + " }\n"

fn emit_elem_name(code: Int) -> String ! alloc
    if code == 1
        d"I8"
    elsif code == 2
        d"F16"
    elsif code == 3
        d"BF16"
    else
        d"F32"

fn emit_tbin_scalar(scalar: Int) -> String ! alloc
    if scalar == 1
        d"true"
    else
        d"false"

fn emit_tun(inst: Inst) -> String ! alloc
    elem = emit_elem_name(inst.n1)
    "  TensorUnary { dest: " + ir_q() + inst.dest + ir_q() + ", op: " + ir_q() + inst.s1 + ir_q() + ", elem: " + elem + ", place: " + ir_q() + inst.s2 + ir_q() + ", input: " + ir_q() + inst.s3 + ir_q() + ", len: " + ir_q() + inst.s5 + ir_q() + " }\n"

fn emit_tbin(inst: Inst) -> String ! alloc
    elem = emit_elem_name(inst.n1)
    sc = emit_tbin_scalar(inst.n2)
    "  TensorBin { dest: " + ir_q() + inst.dest + ir_q() + ", op: " + ir_q() + inst.s1 + ir_q() + ", elem: " + elem + ", place: " + ir_q() + inst.s2 + ir_q() + ", left: " + ir_q() + inst.s3 + ir_q() + ", right: " + ir_q() + inst.s4 + ir_q() + ", len: " + ir_q() + inst.s5 + ir_q() + ", right_scalar: " + sc + " }\n"

fn emit_call_dest(inst: Inst) -> String ! alloc
    if inst.n1 == 1
        "Some(" + ir_q() + inst.dest + ir_q() + ")"
    else
        d"None"

fn emit_call(inst: Inst) -> String ! alloc
    destbit = emit_call_dest(inst)
    pref = "  Call { dest: " + destbit + ", func: " + ir_q() + inst.s1 + ir_q() + ", args: ["
    acc = emit_arg_list(inst.strs, 0, list_len(inst.strs), pref)
    acc + "] }\n"

fn emit_place(inst: Inst) -> String ! alloc
    "  PlaceCopy { dest: " + ir_q() + inst.dest + ir_q() + ", from: " + ir_q() + inst.s1 + ir_q() + ", to_place: " + ir_q() + inst.s2 + ir_q() + " }\n"

fn emit_ret(inst: Inst) -> String ! alloc
    "  Return { value: " + ir_q() + inst.s1 + ir_q() + " }\n"

fn emit_drop(inst: Inst) -> String ! alloc
    "  Drop { name: " + ir_q() + inst.s1 + ir_q() + " }\n"

fn emit_anybox(inst: Inst) -> String ! alloc
    "  AnyBox { dest: " + ir_q() + inst.dest + ir_q() + ", vtable: " + ir_q() + inst.s1 + ir_q() + ", payload: " + ir_q() + inst.s2 + ir_q() + ", drop_slot: " + int_to_str(inst.n1) + " }\n"

fn emit_anycall_dest(inst: Inst) -> String ! alloc
    if str_len(inst.dest) == 0
        d"None"
    else
        "Some(" + ir_q() + inst.dest + ir_q() + ")"

fn emit_anycall(inst: Inst) -> String ! alloc
    destbit = emit_anycall_dest(inst)
    pref = "  AnyCall { dest: " + destbit + ", receiver: " + ir_q() + inst.s1 + ir_q() + ", slot: " + int_to_str(inst.n1) + ", args: ["
    acc = emit_arg_list(inst.strs, 0, list_len(inst.strs), pref)
    acc + "] }\n"

fn emit_if_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn trim_nl(piece: String) -> String ! alloc
    ln = str_len(piece)
    if ln > 0
        if str_char(piece, ln - 1) == 10
            str_slice(piece, 0, ln - 1)
        else
            piece
    else
        piece

fn emit_if_body(body: List[Inst], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_if_comma(i)
        acc = acc + comma
        piece = emit_inst(list_get(body, i))
        piece2 = trim_nl(piece)
        piece3 = strip_spaces(piece2)
        acc = acc + piece3
        emit_if_body(body, i + 1, n, acc)

fn strip_spaces(s: String) -> String ! alloc
    n = str_len(s)
    strip_spaces_go(s, 0, n)

fn strip_spaces_go(s: String, i: Int, n: Int) -> String ! alloc
    if i >= n
        d""
    elsif str_char(s, i) == 32
        strip_spaces_go(s, i + 1, n)
    else
        str_slice(s, i, n)

fn emit_if_inst(inst: Inst) -> String ! alloc
    acc = "  If { cond: " + ir_q() + inst.s1 + ir_q() + ", then_body: ["
    acc = emit_if_body(inst.b1, 0, list_len(inst.b1), acc)
    acc = acc + "], else_body: ["
    acc = emit_if_body(inst.b2, 0, list_len(inst.b2), acc)
    acc = acc + "], then_val: "
    acc = acc + ir_q()
    acc = acc + inst.s2
    acc = acc + ir_q()
    acc = acc + ", else_val: "
    acc = acc + ir_q()
    acc = acc + inst.s3
    acc = acc + ir_q()
    acc = acc + ", dest: "
    acc = acc + ir_q()
    acc = acc + inst.dest
    acc = acc + ir_q()
    if list_len(inst.rows) > 0
        acc = acc + ", carried: ["
        acc = emit_carries(inst.rows, 0, list_len(inst.rows), acc)
        acc = acc + "]"
    acc + " }\n"

fn emit_rebind(inst: Inst) -> String ! alloc
    "  TensorRebind { dest: " + ir_q() + inst.dest + ir_q() + ", src: " + ir_q() + inst.s1 + ir_q() + " }\n"

fn emit_extract(inst: Inst) -> String ! alloc
    "  Extract { dest: " + ir_q() + inst.dest + ir_q() + ", base: " + ir_q() + inst.s1 + ir_q() + ", struct_name: " + ir_q() + inst.s2 + ir_q() + ", field_index: " + int_to_str(inst.n1) + " }\n"

fn emit_emake(inst: Inst) -> String ! alloc
    acc = "  EnumMake { dest: " + ir_q() + inst.dest + ir_q()
    acc = acc + ", enum_name: " + ir_q() + inst.s1 + ir_q()
    acc = acc + ", variant_index: " + int_to_str(inst.n1) + ", payload: ["
    acc = emit_arg_list(inst.strs, 0, list_len(inst.strs), acc)
    acc + "], owned: " + int_to_str(inst.n2) + " }\n"

fn emit_efield(inst: Inst) -> String ! alloc
    "  EnumField { dest: " + ir_q() + inst.dest + ir_q() + ", value: " + ir_q() + inst.s1 + ir_q() + ", index: " + int_to_str(inst.n1) + " }\n"

fn emit_switch(inst: Inst) -> String ! alloc
    acc = "  Switch { scrut: " + ir_q() + inst.s1 + ir_q() + ", arms: ["
    acc = emit_switch_arms(inst.rows, 0, list_len(inst.rows), acc)
    acc = acc + "], default_body: ["
    acc = emit_if_body(inst.b1, 0, list_len(inst.b1), acc)
    acc = acc + "], default_val: " + ir_q() + inst.s2 + ir_q()
    acc + ", dest: " + ir_q() + inst.dest + ir_q() + " }\n"

fn emit_switch_arms(arms: List[Inst], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        a = list_get(arms, i)
        acc = acc + emit_if_comma(i)
        acc = acc + "SwitchArm { tag: " + int_to_str(a.n1) + ", body: ["
        acc = emit_if_body(a.b1, 0, list_len(a.b1), acc)
        acc = acc + "], value: " + ir_q() + a.s1 + ir_q() + " }"
        emit_switch_arms(arms, i + 1, n, acc)

fn emit_agg(inst: Inst) -> String ! alloc
    acc = "  Aggregate { dest: " + ir_q() + inst.dest + ir_q()
    acc = acc + ", struct_name: " + ir_q() + inst.s1 + ir_q() + ", fields: ["
    acc = emit_arg_list(inst.strs, 0, list_len(inst.strs), acc)
    acc + "] }\n"

fn emit_while_inst(inst: Inst) -> String ! alloc
    acc = "  While { cond_insts: ["
    acc = emit_if_body(inst.b1, 0, list_len(inst.b1), acc)
    acc = acc + "], cond: " + ir_q() + inst.s1 + ir_q() + ", body: ["
    acc = emit_if_body(inst.b2, 0, list_len(inst.b2), acc)
    acc = acc + "]"
    if list_len(inst.rows) > 0
        acc = acc + ", carried: ["
        acc = emit_while_carries(inst.rows, 0, list_len(inst.rows), acc)
        acc = acc + "]"
    acc + " }\n"

fn emit_while_carries(cs: List[Inst], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = list_get(cs, i)
        acc = acc + emit_if_comma(i)
        acc = acc + "WhileCarry { dest: " + ir_q() + c.dest + ir_q()
        acc = acc + ", incoming: " + ir_q() + c.s1 + ir_q()
        acc = acc + ", updated: " + ir_q() + c.s2 + ir_q() + " }"
        emit_while_carries(cs, i + 1, n, acc)

fn emit_carries(cs: List[Inst], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = list_get(cs, i)
        acc = acc + emit_if_comma(i)
        acc = acc + "IfCarry { dest: " + ir_q() + c.dest + ir_q()
        acc = acc + ", then_val: " + ir_q() + c.s1 + ir_q()
        acc = acc + ", else_val: " + ir_q() + c.s2 + ir_q() + " }"
        emit_carries(cs, i + 1, n, acc)

fn emit_fused_word(fused: Int) -> String ! alloc
    select_str(fused == 1, d"true", d"false")

fn emit_peak_bytes(r: Region) -> String ! alloc
    if r.has_peak == 1
        "{\"" + r.place + "\": " + int_to_str(r.peak) + "}"
    else
        d"{}"

fn emit_peak_sym(r: Region) -> String ! alloc
    if r.has_sym == 1
        " peak_symbolic={\"" + r.place + "\": \"" + r.peak_sym + "\"}"
    else
        d""

fn emit_region(r: Region) -> String ! alloc
    fw = emit_fused_word(r.fused)
    pb = emit_peak_bytes(r)
    ps = emit_peak_sym(r)
    acc = "  region on " + r.place + " fused=" + fw + " peak_bytes=" + pb + ps + "\n"
    emit_region_ops(r.ops, 0, list_len(r.ops), acc)

fn emit_op_matmul(op: FOp) -> String ! alloc
    "    Matmul { lhs: " + ir_q() + op.a + ir_q() + ", rhs: " + ir_q() + op.b + ir_q() + ", dest: " + ir_q() + op.c + ir_q() + " }\n"

fn emit_op_epilogue(op: FOp) -> String ! alloc
    "    MapEpilogue { op: " + ir_q() + op.a + ir_q() + ", input: " + ir_q() + op.b + ir_q() + ", dest: " + ir_q() + op.c + ir_q() + " }  # fused epilogue, no intermediate buffer\n"

fn emit_op_softmax(op: FOp) -> String ! alloc
    "    Softmax { input: " + ir_q() + op.a + ir_q() + ", dest: " + ir_q() + op.c + ir_q() + " }\n"

fn emit_column_scalar(op: FOp) -> String ! alloc
    if op.nslots > 5
        if str_len(op.scalar) == 0
            d"None"
        else
            d"Some(" + ir_q() + op.scalar + ir_q() + ")"
    else
        if str_eq(op.a, d"mul") == 1
            if str_eq(op.c, d"tmp") == 1
                d"Some(" + ir_q() + d"tmp" + ir_q() + ")"
            else
                d"None"
        else
            d"None"

fn emit_op_column(op: FOp) -> String ! alloc
    sc = emit_column_scalar(op)
    "    ColumnBin { op: " + ir_q() + op.a + ir_q() + ", left: " + ir_q() + op.b + ir_q() + ", right: " + ir_q() + op.c + ir_q() + ", dest: " + ir_q() + op.d + ir_q() + ", scalar: " + sc + " }\n"

fn emit_one_op(op: FOp) -> String ! alloc
    k = op.kind
    if k == FO_MATMUL()
        emit_op_matmul(op)
    elsif k == FO_EPILOGUE()
        emit_op_epilogue(op)
    elsif k == FO_SOFTMAX()
        emit_op_softmax(op)
    elsif k == FO_COLUMN()
        emit_op_column(op)
    else
        d""

fn emit_region_ops(ops: List[FOp], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_one_op(list_get(ops, i))
        acc2 = acc + piece
        emit_region_ops(ops, i + 1, n, acc2)

fn emit_dim_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn emit_dim_params(dps: List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_dim_comma(i)
        acc = acc + comma
        q = qquote()
        acc = acc + q
        acc = acc + list_get(dps, i)
        acc = acc + q
        emit_dim_params(dps, i + 1, n, acc)

fn emit_dim_section(dps: List[String]) -> String ! alloc
    if list_len(dps) > 0
        acc = d"  dim_params=["
        acc = emit_dim_params(dps, 0, list_len(dps), acc)
        acc = acc + "]\n"
        acc
    else
        d""

fn emit_fn(irf: IrFn) -> String ! alloc
    dims = emit_dim_section(irf.dps)
    acc = "fn " + irf.name + ":\n" + dims
    acc = emit_insts(irf.insts, 0, list_len(irf.insts), acc)
    emit_regions(irf.regions, 0, list_len(irf.regions), acc)

fn emit_insts(insts: List[Inst], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_inst(list_get(insts, i))
        acc = acc + piece
        emit_insts(insts, i + 1, n, acc)

fn emit_regions(regions: List[Region], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_region(list_get(regions, i))
        acc = acc + piece
        emit_regions(regions, i + 1, n, acc)

# The IR module is a vec of function handles; it is read through its typed copy.
fn ir_to_text(mod: Int) -> String ! alloc
    fns = ti_module(mod)
    text = emit_fns(fns, 0, list_len(fns), d"")
    _f = ti_free_module(fns)
    text

fn emit_fns(fns: List[IrFn], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_fn(list_get(fns, i))
        acc = acc + piece
        emit_fns(fns, i + 1, n, acc)

fn emit_ir_from_prog(tp: TProgram) -> String ! alloc
    emit_ir_from_prog_with_extra(tp, vec_new())

fn emit_ir_from_prog_with_extra(tp: TProgram, extra: Int) -> String ! alloc
    ir = lower_program_with_callables(tp, extra)
    ir_to_text(ir)

fn emit_ir_from_prog_with_types(tp: TProgram, extra: Int, enums: List[TEnum], env: TEnv) -> String ! alloc
    ir = lower_program_typed(tp, extra, env, enums)
    ir_to_text(ir)

# The typed environment of a module graph: every module's structs and fn results, as
# `graph_types` collects them for the handle typers.
fn tenv_for_graph(order: Graph) -> TEnv ! alloc
    env = TEnv(list_new[String](), list_new[String](), list_new[TStruct](), list_new[String](), list_new[String](), list_new[String](), list_new[Int]())
    _a = tenv_graph_fill(env, order, 0, list_len(order.progs))
    env

fn tenv_graph_fill(env: TEnv, order: Graph, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        tp = list_get(order.progs, i)
        _a = tenv_push_structs(env.structs, tp.structs, 0, list_len(tp.structs))
        _b = tenv_fill(env, tp.fns, 0, list_len(tp.fns))
        tenv_graph_fill(env, order, i + 1, n)

fn tenv_push_structs(out: List[TStruct], src: List[TStruct], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, list_get(src, i))
        tenv_push_structs(out, src, i + 1, n)

# The enums of every module of the graph, in module order (the list is the caller's to free;
# the enums themselves belong to `order`).
fn graph_enums_t(order: Graph) -> List[TEnum] ! alloc
    out = list_new[TEnum]()
    _a = graph_enums_go(order, 0, list_len(order.mods), out)
    out

fn graph_enums_go(order: Graph, i: Int, n: Int, out: List[TEnum]) -> Int ! alloc
    if i >= n
        0
    else
        _p = enums_push(out, list_get(order.progs, i).enums, 0, list_len(list_get(order.progs, i).enums))
        graph_enums_go(order, i + 1, n, out)

fn enums_push(out: List[TEnum], src: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, list_get(src, i))
        enums_push(out, src, i + 1, n)

fn dep_fn_names(order: Graph, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        out2 = append_fn_names_from_prog(list_get(order.progs, i), out)
        dep_fn_names(order, i + 1, n, out2)

fn emit_ir_from_graph(order: Graph, source_path: String) -> Int ! alloc
    _p = source_path
    n = list_len(order.mods)
    extra = vec_new()
    if n > 1
        extra = dep_fn_names(order, 0, n - 1, extra)
    else
        extra = extra
    root_prog = list_get(order.progs, list_len(order.mods) - 1)
    env = tenv_for_graph(order)
    genums = graph_enums_t(order)
    text = emit_ir_from_prog_with_types(root_prog, extra, genums, env)
    _h = list_free(genums)
    _f = tenv_free(env)
    _g = list_free(env.structs)
    result_ok_str(text)

fn emit_ir_from_path(source_path: String) -> Int ! io, alloc
    proot = project_root()
    order = graph_new()
    g = resolve_module_graph_qualified(source_path, proot, order)
    if result_is_err(g) == 1
        g
    else
        emit_ir_from_graph(order, source_path)

fn emit_ir_single_file(src: String) -> Int ! io, alloc
    pre = preprocess(src)
    errs = list_new[String]()
    tp = parse_program(pre, errs)
    msg = errs_take(errs)
    if str_len(msg) > 0
        result_err_str(msg)
    else
        emit_ir_cached(tp, pre)

fn emit_ir_cached(tp: TProgram, pre: String) -> Int ! io, alloc
    dir = cache_dir()
    _m = cache_mkdir(dir)
    key = source_hash(pre)
    irpath = cache_ir_path_raw(dir, key)
    metapath = cache_meta_path_raw(dir, key)
    cached = read_file(irpath)
    if str_len(cached) > 0
        _w = write_file(metapath, d"hit=1\n")
        result_ok_str(cached)
    else
        checked = check_program(tp)
        if result_is_err(checked) == 1
            checked
        else
            ir0 = emit_ir_from_prog(tp)
            kept = emit_keep_text(tp, ir0)
            _w0 = write_file(irpath, kept)
            _w1 = write_file(metapath, d"hit=0\n")
            result_ok_str(kept)

fn emit_ir_imported_file(source_path: String, src: String) -> Int ! io, alloc
    dir = cache_dir()
    _m = cache_mkdir(dir)
    order = graph_new()
    g = resolve_module_graph_qualified(source_path, project_root(), order)
    if result_is_err(g) == 1
        g
    else
        key = cache_key_for_graph_path(src, source_path)
        irpath = cache_ir_path_raw(dir, key)
        metapath = cache_meta_path_raw(dir, key)
        cached = read_file(irpath)
        if str_len(cached) > 0
            _w = write_file(metapath, d"hit=1\n")
            result_ok_str(cached)
        else
            ir1 = emit_ir_from_graph(order, source_path)
            if result_is_err(ir1) == 1
                ir1
            else
                body = str_from_int(result_unwrap(ir1))
                _w2 = write_file(irpath, body)
                _w3 = write_file(metapath, d"hit=0\n")
                result_ok_str(body)

fn emit_ir_for_file(source_path: String, src: String) -> Int ! io, alloc
    if str_len(source_path) > 0
        if str_contains(src, d"import") == 1
            emit_ir_imported_file(source_path, src)
        else
            emit_ir_single_file(src)
    else
        emit_ir_single_file(src)

fn emit_ir(src: String) -> Int ! io, alloc
    emit_ir_for_file(d"", src)

# Copy emitted text; release program metadata. Parsed fn bodies are not freed (alias struct/protocol names).
fn emit_keep_text(tp: TProgram, text: String) -> String ! alloc
    kept = strdup(text)
    _p = tp_free_shallow(tp)
    kept

# The C text of `tp`, or the error of the first semantic check it fails (an effect its
# signature does not declare, a moved value...).
fn emit_c_checked(tp: TProgram) -> Int ! alloc
    checked = check_program(tp)
    if result_is_err(checked) == 1
        checked
    else
        text = emit_c_from_ast(tp)
        kept = emit_keep_text(tp, text)
        result_ok_str(kept)

fn emit_c_from_prog_result(src: String) -> Int ! alloc
    pre = preprocess(src)
    errs = list_new[String]()
    tp = parse_program(pre, errs)
    msg = errs_take(errs)
    if str_len(msg) > 0
        result_err_str(msg)
    else
        emit_c_checked(tp)

fn emit_c_for_file(source_path: String, src: String, out_path: String) -> Int ! io, alloc
    if str_len(source_path) > 0
        if str_contains(src, d"import") == 1
            # The module graph parses the file itself and resolves its methods over all modules.
            emit_c_from_path(source_path, out_path)
        else
            emit_c_for_single(src, source_path, out_path)
    else
        emit_c_for_single(src, source_path, out_path)

# The file a warning names: the source path, or "<input>" for text read from stdin.
fn warning_label(source_path: String) -> String ! alloc
    if str_len(source_path) > 0
        source_path
    else
        d"<input>"

fn emit_c_for_single(src: String, source_path: String, out_path: String) -> Int ! io, alloc
    pre = preprocess(src)
    errs = list_new[String]()
    tp = parse_program(pre, errs)
    msg = errs_take(errs)
    if str_len(msg) > 0
        result_err_str(msg)
    else
        _w = dep_warnings_single(warning_label(source_path), pre, tp)
        emit_c_parsed_file(tp, source_path, out_path)

fn emit_c_parsed_file(tp: TProgram, source_path: String, out_path: String) -> Int ! io, alloc
    checked = check_program(tp)
    if result_is_err(checked) == 1
        checked
    elsif str_len(source_path) == 0
        text = emit_c_from_ast(tp)
        kept = emit_keep_text(tp, text)
        result_ok_str(kept)
    elsif list_len(tp.imports) == 0
        ccode = emit_c_from_ast(tp)
        kept = emit_keep_text(tp, ccode)
        cpath = tmp_path("out.c")
        _w = write_file(cpath, kept)
        if clang(cpath, out_path) == 0
            result_ok_str(d"")
        else
            result_err_str(d"clang failed")
    else
        emit_c_from_path(source_path, out_path)

fn emit_c_from_path(source_path: String, out_path: String) -> Int ! io, alloc
    proot = project_root()
    graph = graph_new()
    g = resolve_module_graph_qualified(source_path, proot, graph)
    if result_is_err(g) == 1
        g
    else
        _w = dep_warnings_graph(graph)
        chk = check_all_modules(graph, proot)
        if result_is_err(chk) == 1
            chk
        else
            root_key = graph_root_key(graph)
            emit_c_compile_graph(graph, root_key, out_path, proot)

# Rust `{:?}` escaping of a string body (quotes are added by the caller).
fn ir_debug_escape_s(s: String) -> String ! alloc
    ir_debug_escape_go(s, 0, str_len(s), d"")

fn ir_debug_escape_go(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 92
            acc = acc + "\\\\"
        elsif c == 34
            acc = acc + "\\\""
        elsif c == 10
            acc = acc + "\\n"
        elsif c == 9
            acc = acc + "\\t"
        elsif c == 13
            acc = acc + "\\r"
        elsif c == 0
            acc = acc + "\\0"
        else
            acc = acc + char_to_str(c)
        ir_debug_escape_go(s, i + 1, n, acc)

# ---- emit_c (AST → C) ----
fn mangled(name: String) -> String ! alloc
    "fn_" + name

fn vtable_c_symbol(sym: String) -> String ! alloc
    pre = d"sal_any_drop_"
    pl = str_len(pre)
    if str_len(sym) >= pl
        if str_eq(str_slice(sym, 0, pl), pre) == 1
            sym
        else
            mangled(sym)
    else
        mangled(sym)

fn emit_vtable_cells(syms: List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc + "};\n"
    else
        sym = vtable_c_symbol(list_get(syms, i))
        acc2 = acc + "  (int64_t)(uintptr_t)" + sym + ",\n"
        emit_vtable_cells(syms, i + 1, n, acc2)

fn emit_one_vtable(type_name: String, protocol_name: String, p: TProtocol) -> String ! alloc
    global = proto_vtable_global(type_name, protocol_name)
    drop = any_drop_thunk(type_name)
    syms = vtable_entry_symbols(type_name, p)
    acc = "static void " + drop + "(int64_t p) { (void)p; }\n"
    acc = acc + "static int64_t " + global + "[] = {\n"
    emit_vtable_cells(syms, 0, list_len(syms), acc)

fn emit_vtables_claims(tp: TProgram, type_name: String, claims: List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        claim = list_get(claims, i)
        pi = proto_find(tp.protocols, claim, 0, list_len(tp.protocols))
        if pi < 0
            emit_vtables_claims(tp, type_name, claims, i + 1, n, acc)
        else
            p = list_get(tp.protocols, pi)
            piece = emit_one_vtable(type_name, claim, p)
            emit_vtables_claims(tp, type_name, claims, i + 1, n, acc + piece)

fn emit_vtables_structs(tp: TProgram, sts: List[TStruct], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        st = list_get(sts, i)
        acc2 = emit_vtables_claims(tp, st.name, st.protocols, 0, list_len(st.protocols), acc)
        emit_vtables_structs(tp, sts, i + 1, n, acc2)

fn emit_vtables_enums(tp: TProgram, es: List[TEnum], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        e = list_get(es, i)
        acc2 = emit_vtables_claims(tp, e.name, e.protocols, 0, list_len(e.protocols), acc)
        emit_vtables_enums(tp, es, i + 1, n, acc2)

fn emit_any_vtables_module(tp: TProgram, acc: String) -> String ! alloc
    acc2 = emit_vtables_structs(tp, tp.structs, 0, list_len(tp.structs), acc)
    emit_vtables_enums(tp, tp.enums, 0, list_len(tp.enums), acc2)

fn c_escape_go(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 92
            acc = acc + "\\\\"
            c_escape_go(s, i + 1, n, acc)
        elsif c == 34
            acc = acc + "\\\""
            c_escape_go(s, i + 1, n, acc)
        elsif c == 10
            acc = acc + "\\n"
            c_escape_go(s, i + 1, n, acc)
        elsif c == 9
            acc = acc + "\\t"
            c_escape_go(s, i + 1, n, acc)
        elsif c == 13
            acc = acc + "\\r"
            c_escape_go(s, i + 1, n, acc)
        elsif c < 32
            acc = acc + c_octal(c)
            c_escape_go(s, i + 1, n, acc)
        elsif c >= 127
            acc = acc + c_octal(c)
            c_escape_go(s, i + 1, n, acc)
        else
            piece = char_to_str(c)
            acc = acc + piece
            # free(piece)
            c_escape_go(s, i + 1, n, acc)

# Always three digits, so a following digit character can't extend the escape.
fn c_octal(c: Int) -> String ! alloc
    "\\" + int_to_str(c / 64) + int_to_str((c / 8) % 8) + int_to_str(c % 8)

fn c_escape_str(s: String) -> String ! alloc
    acc = d"\""
    if str_len(s) == 0
        acc + "\""
    else
        acc2 = c_escape_go(s, 0, str_len(s), acc)
        acc2 + "\""

fn c_string_init(s: String) -> String ! alloc
    if str_len(s) == 0
        d"\"\""
    else
        acc = d"\""
        acc2 = c_escape_go(s, 0, str_len(s), acc)
        acc2 + "\""

fn lit_pool_new() -> Int ! alloc
    v = vec_new()
    _a = vec_push(v, str_as_int(d""))
    _b = vec_push(v, vec_new())
    _c = vec_push(v, vec_new())
    _d = vec_push(v, 0)
    _e = vec_push(v, 0)
    _f = vec_push(v, 0)
    _g = vec_push(v, map_new())
    _h = vec_push(v, map_new())
    _i = vec_push(v, map_new())
    v

# Variant name -> (tag + 1) * 2 + nullary, as `EnumMake` tags them: `index + 1`,
# except a payload-free first variant, which is 0.
fn lit_pool_variants(pool: Int) -> Int ! alloc
    vec_get(pool, 6)

# Variant name -> its field types, for typing pattern bindings.
fn lit_pool_variant_fields(pool: Int) -> Int ! alloc
    vec_get(pool, 7)

# Registers every variant of `enums` (an entry per name: its code in `m`, `[enum index, variant
# index]` in `ft`); a later definition of a name replaces an earlier one.
fn variants_register(m: Int, ft: Int, enums: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ed = list_get(enums, i)
        _a = variants_register_go(m, ft, i, ed.variants, 0, list_len(ed.variants))
        variants_register(m, ft, enums, i + 1, n)

fn variants_register_go(m: Int, ft: Int, ei: Int, vs: List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = list_get(vs, i)
        nullary = if list_len(v.fields) == 0
            1
        else
            0
        tag = if nullary == 1
            if i == 0
                0
            else
                i + 1
        else
            i + 1
        key = str_as_int(v.name)
        _p = map_put(m, key, (tag + 1) * 2 + nullary)
        entry = vec_new()
        _q1 = vec_push(entry, ei)
        _q2 = vec_push(entry, i)
        _q = map_put(ft, key, entry)
        variants_register_go(m, ft, ei, vs, i + 1, n)

fn variant_code(tc: Tc, name: Int) -> Int ! alloc
    map_get(lit_pool_variants(tc_lit_pool(tc)), name)

fn variant_tag(code: Int) -> Int ! alloc
    code / 2 - 1

fn lit_pool_globals(pool: Int) -> String ! alloc
    str_from_int(vec_get(pool, 0))

fn lit_pool_find(s: Int, texts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_eq(vec_get(texts, i), s) == 1
        i
    else
        lit_pool_find(s, texts, i + 1, n)

fn sal_lit_decl_n(s: String, name: String, n: Int) -> String ! alloc
    init = select_str(str_len(s) == 0, d"\"\"", c_string_init(s))
    arr = n + 1
    acc = d"static const struct { int64_t cap; int64_t len; char b["
    acc = acc + int_to_str(arr)
    acc = acc + "]; } __attribute__((aligned(16))) "
    acc = acc + name
    acc = acc + " = { 0, "
    acc = acc + int_to_str(n)
    acc = acc + ", "
    acc = acc + init
    acc + " };\n"

fn sal_lit_decl(s: String, name: String) -> String ! alloc
    if str_len(s) == 0
        sal_lit_decl_n(s, name, 0)
    else
        sal_lit_decl_n(s, name, str_len(s))

fn ensure_sal_lit(s: Int, pool: Int) -> String ! alloc
    texts = vec_get(pool, 1)
    idx = lit_pool_find(s, texts, 0, vec_len(texts))
    if idx >= 0
        sym = vec_get(vec_get(pool, 2), idx)
        "((int64_t)(uintptr_t)" + str_from_int(sym) + ".b)"
    else
        nid = vec_get(pool, 3) + 1
        _u = vec_set(pool, 3, nid)
        decl = sal_lit_decl(str_from_int(s), "sal_lit_" + int_to_str(nid))
        gacc = lit_pool_globals(pool)
        _g = vec_set(pool, 0, str_as_int(gacc + decl))
        _t = vec_push(texts, str_as_int(strdup(str_from_int(s))))
        _sy = vec_push(vec_get(pool, 2), str_as_int("sal_lit_" + int_to_str(nid)))
        cast = "((int64_t)(uintptr_t)" + "sal_lit_" + int_to_str(nid)
        cast + ".b)"

fn runtime_decls() -> String ! alloc
    d"#include <stdint.h>\n#include <stdlib.h>\nvoid sal_runtime_init(int64_t argc, const char **argv);\nchar *sal_argv(int64_t i);\nchar *sal_read_file(const char *path);\nint64_t sal_write_file(const char *path, const char *data);\nint64_t sal_print_str(const char *data);\nint64_t sal_eprint_str(const char *data);\nchar *sal_getenv(const char *name);\nint64_t sal_mkdir_p(const char *path);\nint64_t sal_str_eq(const char *a, const char *b);\n" + d"int64_t sal_regex_match(const char *s, const char *pat);\nint64_t sal_str_contains(const char *a, const char *b);\nint64_t sal_str_index_of(const char *a, const char *b);\nint64_t sal_str_index_from(const char *a, const char *b, int64_t start);\nint64_t sal_str_len(const char *s);\nchar *sal_str_concat(const char *a, const char *b);\nchar *sal_str_append(char *a, const char *b);\nchar *sal_strdup(const char *s);\nchar *sal_select_str(int64_t cond, char *a, char *b);\nvoid sal_free(void *p);\nint64_t sal_not(int64_t x);\nint64_t sal_gated_print_str(int64_t cond, const char *data);\nchar *sal_tmp_path(const char *suffix);\nint64_t sal_clang(const char *c_path, const char *out_path);\nint64_t sal_path_readable(const char *path);\nchar *sal_realpath(const char *p);\nint64_t sal_clang_obj(const char *c_path, const char *obj_path);\nint64_t sal_link_objs(const char *objs, const char *out_path);\nchar *sal_char_to_str(int64_t c);\nchar *sal_int_to_str(int64_t v);\nchar *sal_str_slice(const char *s, int64_t start, int64_t end);\nint64_t sal_str_char(const char *s, int64_t i);\nint64_t sal_str_skip(const char *s, int64_t i, int64_t kind, int64_t limit);\nint64_t sal_str_hash(const char *s, int64_t seed);\nint64_t sal_str_to_f64_bits(const char *s);\nvoid *sal_map_new(void);\nint64_t sal_map_get(void *m, const char *key);\nint64_t sal_map_put(void *m, const char *key, int64_t val);\nchar *sal_ir_text(void *mod);\nvoid *sal_lex_src(const char *src);\nvoid *sal_vec_new(void);\nint64_t sal_vec_push(void *v, int64_t x);\nint64_t sal_vec_get(void *v, int64_t i);\nint64_t sal_vec_set(void *v, int64_t i, int64_t x);\nint64_t sal_vec_len(void *v);\nvoid sal_vec_free(void *v);\nint64_t sal_enum_new(int64_t tag, int64_t n);\nint64_t sal_enum_set(int64_t v, int64_t i, int64_t x);\nint64_t sal_enum_tag(int64_t v);\nint64_t sal_enum_owns(int64_t v, int64_t i);\nint64_t sal_enum_box_id(int64_t v);\nint64_t sal_enum_field(int64_t v, int64_t i);\nvoid sal_list_free(void *v);\nint64_t sal_list_box_id(void *v);\nvoid *sal_list_new_desc(const char *desc);\nvoid sal_dict_free(void *v);\nvoid *sal_dict_new(int64_t key_kind, int64_t val_kind);\nvoid sal_enum_free(int64_t v);\nvoid sal_bytes_free(void *v);\nint64_t sal_print_i64(int64_t v);\nint64_t sal_place_matmul_ai_sum(int64_t place);\nint64_t sal_place_launches(int64_t place);\nvoid sal_on_enter(int64_t place);\nvoid *sal_image_new(int64_t w, int64_t h);\nint64_t sal_write_png(const char *path, int64_t w, int64_t h, void *rgb);\nvoid *sal_place_malloc(int64_t nbytes, int32_t place);\nint64_t sal_mask_select_count(const int8_t *mask, int64_t len);\nvoid sal_tensor_select_f32(float *out, const float *in, const int8_t *mask, int64_t len);\nvoid sal_tensor_select_i8(int8_t *out, const int8_t *in, const int8_t *mask, int64_t len);\nvoid *sal_list_select(void *in_list, const int8_t *mask, int64_t len);\nstatic int64_t sal_tn_len(int64_t p) { return ((int64_t *)(uintptr_t)p)[-2]; }\nstatic float *sal_tn_alloc_bytes(int64_t n, int64_t esz) { int64_t *b = (int64_t *)sal_place_malloc(n * esz + 16, 0); b[0] = n; return (float *)(b + 2); }\nstatic float *sal_tn_alloc(int64_t n) { return sal_tn_alloc_bytes(n, 4); }\nstatic float *sal_tn_from(int64_t raw, int64_t n) { float *t = sal_tn_alloc(n); __builtin_memcpy(t, (void *)(uintptr_t)raw, (size_t)n * 4); return t; }\nstatic float *sal_tn_copy(int64_t p) { if (!p) return 0; int64_t n = sal_tn_len(p); float *t = sal_tn_alloc(n); __builtin_memcpy(t, (void *)(uintptr_t)p, (size_t)n * 4); return t; }\nstatic int64_t sal_fop(int64_t op, int64_t a, int64_t b) { double x, y, r; __builtin_memcpy(&x, &a, 8); __builtin_memcpy(&y, &b, 8); switch (op) { case 0: r = x + y; break; case 1: r = x - y; break; case 2: r = x * y; break; case 3: r = x / y; break; case 4: return x == y; case 5: return x != y; case 6: return x < y; case 7: return x <= y; case 8: return x > y; case 9: return x >= y; case 10: r = -x; break; case 11: return (int64_t)x; default: r = (double)a; } int64_t o; __builtin_memcpy(&o, &r, 8); return o; }\nint64_t sal_any_box(int64_t vtable, int64_t drop_slot, int64_t payload);\nvoid sal_any_free(int64_t box);\nint64_t sal_any_call(int64_t box, int64_t slot, int64_t argc, int64_t a0, int64_t a1, int64_t a2, int64_t a3);\n\n"

fn names_has(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        names_has(names, name, i + 1, n)

fn collect_assigns_block(b: TBlock, names: Int) -> Int ! alloc
    _a = collect_assigns_stmts(b.stmts, 0, list_len(b.stmts), names)
    collect_assigns_expr(b.tail, names)

fn collect_assigns_stmts(stmts: List[TStmt], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        if st.kind == 1
            nm = str_as_int(st.name)
            if names_has(names, nm, 0, vec_len(names)) == 0
                _p = vec_push(names, nm)
            else
                _p = 0
        else
            _p = 0
        _c = collect_assigns_expr(st.expr, names)
        collect_assigns_stmts(stmts, i + 1, n, names)

fn collect_assigns_if(cond: Expr, then_b: TBlock, else_b: TBlock, arms: List[TElsif], names: Int) -> Int ! alloc
    _a = collect_assigns_expr(cond, names)
    _b = collect_assigns_block(then_b, names)
    _c = collect_assigns_arms(arms, 0, list_len(arms), names)
    collect_assigns_block(else_b, names)

fn collect_assigns_while(cond: Expr, body: TBlock, names: Int) -> Int ! alloc
    _a = collect_assigns_expr(cond, names)
    collect_assigns_block(body, names)

fn collect_assigns_bin(l: Expr, r: Expr, names: Int) -> Int ! alloc
    _a = collect_assigns_expr(l, names)
    collect_assigns_expr(r, names)

fn collect_assigns_expr(e: Expr, names: Int) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => collect_assigns_if(cond, then_b, else_b, elsifs, names)
        XWhile(cond, body) => collect_assigns_while(cond, body, names)
        XBin(op, l, r) => collect_assigns_bin(l, r, names)
        XCall(name, args, targs, xp) => collect_assigns_args(args, 0, list_len(args), names)
        XTo(place, inner) => collect_assigns_expr(inner, names)
        XOn(place, body, is_kern, has_index) => collect_assigns_block(body, names)
        _ => 0

fn collect_assigns_arms(arms: List[TElsif], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = collect_assigns_expr(arm.cond, names)
        _b = collect_assigns_block(arm.body, names)
        collect_assigns_arms(arms, i + 1, n, names)

fn collect_assigns_args(args: List[Expr], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = collect_assigns_expr(list_get(args, i), names)
        collect_assigns_args(args, i + 1, n, names)

fn emit_decl_names(names: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + "  int64_t "
        acc = acc + str_from_int(vec_get(names, i))
        acc = acc + " = 0;\n"
        emit_decl_names(names, i + 1, n, acc)

# Emission state of one function. The counter, the accumulator name and the small-matmul quirk live
# in lists so callees can update them; `env` is the typed local environment shared by the program;
# `lam_*` are the locals bound to a lambda (`f = x => body`), searched newest first.
struct Tc
    ctr: List[Int]
    acc: List[Int]
    mm_out: List[Int]
    mm_n: List[Int]
    lam_names: List[String]
    lam_params: List[String]
    lam_bodies: List[Expr]
    pool: Int
    env: TEnv
    enums: List[TEnum]

fn tc_new(pool: Int, env: TEnv borrow, enums: List[TEnum] borrow) -> Tc ! alloc
    ctr = list_new[Int]()
    _a = list_push(ctr, 0)
    acc = list_new[Int]()
    _b = list_push(acc, 0)
    mm_out = list_new[Int]()
    _c = list_push(mm_out, 0)
    mm_n = list_new[Int]()
    _d = list_push(mm_n, 0)
    _t = tenv_truncate(env, 0)
    Tc(ctr, acc, mm_out, mm_n, list_new[String](), list_new[String](), list_new[Expr](), pool, env, enums)

# Releases the lists; the env and the pool are the caller's.
fn tc_free(tc: Tc) -> Int ! alloc
    _l = tp_free_expr_list(tc.lam_bodies)
    _a = list_free(tc.ctr)
    _b = list_free(tc.acc)
    _c = list_free(tc.mm_out)
    _d = list_free(tc.mm_n)
    _e = list_free(tc.lam_names)
    _f = list_free(tc.lam_params)
    list_free(tc.lam_bodies)

fn lit_pool_free_texts_go(texts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        s = str_from_int(vec_get(texts, i))
        if str_len(s) > 0
            _f = free(s)
        lit_pool_free_texts_go(texts, i + 1, n)

# Dup'd literal strings registered during one function; pool globals are kept.
fn lit_pool_free_texts(pool: Int) -> Int ! alloc
    texts = vec_get(pool, 1)
    _a = lit_pool_free_texts_go(texts, 0, vec_len(texts))
    _n = vec_set(pool, 1, vec_new())
    0

fn tc_lit_pool(tc: Tc) -> Int ! alloc
    tc.pool

# Name of the binding an `x = x + ...` chain accumulates into (0 when none).
fn tc_acc(tc: Tc) -> Int ! alloc
    list_get(tc.acc, 0)

fn tc_set_acc(tc: Tc, name: Int) -> Int ! alloc
    _s = list_set(tc.acc, 0, name)
    0

fn tc_lam_find(tc: Tc, name: String, i: Int) -> Int ! alloc
    if i < 0
        0 - 1
    elsif str_eq(list_get(tc.lam_names, i), name) == 1
        i
    else
        tc_lam_find(tc, name, i - 1)

fn tc_lam_add(tc: Tc, name: String, lam: Expr) -> Int ! alloc
    match lam
        XLambda(param, body) => tc_lam_push(tc, name, param, body)
        _ => 0

fn tc_lam_push(tc: Tc, name: String, param: String, body: Expr) -> Int ! alloc
    _a = list_push(tc.lam_names, strdup(name))
    _b = list_push(tc.lam_params, strdup(param))
    _c = list_push(tc.lam_bodies, tc_expr(body))
    0

fn seed_string_params(params: List[TParam], i: Int, n: Int, env: TEnv) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(params, i)
        _b = tenv_bind(env, pm.name, pm.ty)
        seed_string_params(params, i + 1, n, env)

fn tmp_fresh(tc: Tc) -> String ! alloc
    n = list_get(tc.ctr, 0) + 1
    _s = list_set(tc.ctr, 0, n)
    "__t" + int_to_str(n)

fn cmap_op(op: String) -> String ! alloc
    if str_eq(op, d"add") == 1
        "+"
    elsif str_eq(op, d"sub") == 1
        d"-"
    elsif str_eq(op, d"mul") == 1
        d"*"
    elsif str_eq(op, d"div") == 1
        d"/"
    elsif str_eq(op, d"eq") == 1
        d"=="
    elsif str_eq(op, d"ne") == 1
        d"!="
    elsif str_eq(op, d"lt") == 1
        d"<"
    elsif str_eq(op, d"le") == 1
        d"<="
    elsif str_eq(op, d"gt") == 1
        d">"
    elsif str_eq(op, d"ge") == 1
        d">="
    elsif str_eq(op, d"mod") == 1
        d"%"
    elsif str_eq(op, d"band") == 1
        d"&"
    elsif str_eq(op, d"bxor") == 1
        d"^"
    elsif str_eq(op, d"bor") == 1
        d"|"
    elsif str_eq(op, d"shl") == 1
        d"<<"
    elsif str_eq(op, d"shr") == 1
        d">>"
    else
        d"+"

fn emit_c_expr(e: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    match e
        XNone => d"0"
        XInt(v) => int_to_str(v) + "LL"
        XFloat(bits, txt) => int_to_str(bits) + "LL"
        XStr(s) => ensure_sal_lit(str_as_int(s), tc_lit_pool(tc))
        XIdent(name) => emit_c_ident(name, tc)
        XField(base, field) => emit_c_field(base, field, user, stmts, tc)
        XBin(op, l, r) => emit_c_binary(op, l, r, user, stmts, tc)
        XCall(name, args, targs, xp) => emit_c_call(name, args, targs, user, stmts, tc)
        XTensor(nr, nc, data) => emit_c_tensor_lit(data)
        XOn(place, body, is_kern, has_index) => emit_c_block(body, user, stmts, tc)
        XIf(cond, then_b, else_b, has_else, elsifs) => emit_c_if(cond, then_b, else_b, elsifs, user, stmts, tc)
        XWhile(cond, body) => emit_c_while(cond, body, user, stmts, tc)
        XMatch(scrut, arms) => emit_c_match(scrut, arms, user, stmts, tc)
        XTry(inner) => emit_c_try(inner, user, stmts, tc)
        XBool(v) => int_to_str(v)
        XUnary(op, inner) => emit_c_unary(op, inner, user, stmts, tc)
        _ => d"0"

fn emit_c_unary(op: String, operand: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    inner = emit_c_expr(operand, user, stmts, tc)
    if str_eq(op, "neg") == 1
        if tt_is_float(texpr_type(tc.env, operand)) == 1
            "sal_fop(10, " + inner + ", 0LL)"
        else
            "(-(" + inner + "))"
    else
        "(!(" + inner + "))"

# `left` is the left operand of a string `+`; its own left chain makes the append form.
fn c_str_add_fname(env: TEnv, left: Expr, into_acc: Int) -> String ! alloc
    if into_acc == 1
        d"str_append"
    elsif tbinary_is_string_concat(env, left) == 1
        d"str_append"
    else
        d"str_concat"

fn emit_c_str_add(left: Expr, right: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    # Only the left spine of the chain may see the accumulator.
    acc = tc_acc(tc)
    _s = tc_set_acc(tc, tspine_acc(left, acc))
    l = emit_c_expr(left, user, stmts, tc)
    _z = tc_set_acc(tc, 0)
    r = emit_c_expr(right, user, stmts, tc)
    fname = c_str_add_fname(tc.env, left, tadd_left_is_acc(left, acc))
    args = vec_new()
    free_left = 0
    if str_eq(fname, d"str_concat") == 1
        free_left = tadd_left_is_fresh_call(left)
    if free_left == 1
        # Materialize the left temp so it can be freed after the copy.
        lt = tmp_fresh(tc)
        _lp = vec_push(stmts, str_as_int("  int64_t " + lt + " = " + l + ";\n"))
        _a = vec_push(args, lt)
    else
        _a = vec_push(args, l)
    if tadd_right_is_fresh_temp(tc.env, right) == 1
        # Materialize the temp so it can be freed after the copy.
        rt = tmp_fresh(tc)
        _b = vec_push(args, rt)
        _p = vec_push(stmts, str_as_int("  int64_t " + rt + " = " + r + ";\n"))
        call = emit_c_builtin2(fname, args, stmts)
        dt = tmp_fresh(tc)
        _q = vec_push(stmts, str_as_int("  int64_t " + dt + " = " + call + ";\n"))
        _f = vec_push(stmts, str_as_int("  sal_free((void*)(uintptr_t)" + rt + ");\n"))
        if free_left == 1
            _fl = vec_push(stmts, str_as_int("  sal_free((void*)(uintptr_t)" + str_from_int(vec_get(args, 0)) + ");\n"))
        dt
    elsif free_left == 1
        _b = vec_push(args, r)
        call = emit_c_builtin2(fname, args, stmts)
        dt = tmp_fresh(tc)
        _q = vec_push(stmts, str_as_int("  int64_t " + dt + " = " + call + ";\n"))
        _fl = vec_push(stmts, str_as_int("  sal_free((void*)(uintptr_t)" + str_from_int(vec_get(args, 0)) + ");\n"))
        dt
    else
        _b = vec_push(args, r)
        emit_c_builtin2(fname, args, stmts)

fn emit_c_binary(op: String, l: Expr, r: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    if str_eq(op, "and") + str_eq(op, "or") > 0
        emit_c_logic(op, l, r, user, stmts, tc)
    elsif str_eq(op, "add") == 1
        if texpr_is_string(tc.env, l) == 1
            emit_c_str_add(l, r, user, stmts, tc)
        else
            emit_c_binary_num(op, l, r, user, stmts, tc)
    else
        emit_c_binary_num(op, l, r, user, stmts, tc)

# `&&` and `||` in C. If the right operand emits no statements, the C operator is enough. Otherwise
# its statements go inside a branch that only the needed case runs, and the result is a temporary.
fn emit_c_logic(op: String, left: Expr, right: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    l = emit_c_expr(left, user, stmts, tc)
    sub = vec_new()
    r = emit_c_expr(right, user, sub, tc)
    cop = " || "
    if str_eq(op, "and") == 1
        cop = " && "
    if vec_len(sub) == 0
        "(" + l + cop + r + ")"
    else
        t = tmp_fresh(tc)
        _a = vec_push(stmts, str_as_int("  int64_t " + t + " = " + l + ";\n"))
        if str_eq(op, "and") == 1
            _b = vec_push(stmts, str_as_int("  if (" + t + ") {\n"))
        else
            _b = vec_push(stmts, str_as_int("  if (!" + t + ") {\n"))
        _c = emit_c_move_stmts(sub, 0, vec_len(sub), stmts)
        _d = vec_push(stmts, str_as_int("    " + t + " = (" + r + ") != 0;\n  }\n"))
        t

fn emit_c_move_stmts(sub: Int, i: Int, n: Int, stmts: Int) -> Int ! alloc
    if i < n
        _a = vec_push(stmts, vec_get(sub, i))
        emit_c_move_stmts(sub, i + 1, n, stmts)
    else
        0

fn emit_c_binary_num(op: String, left: Expr, right: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    l = emit_c_expr(left, user, stmts, tc)
    r = emit_c_expr(right, user, stmts, tc)
    if tt_is_float(texpr_type(tc.env, left)) + tt_is_float(texpr_type(tc.env, right)) > 0
        "sal_fop(" + int_to_str(float_op_code(op)) + ", " + l + ", " + r + ")"
    else
        "(" + l + " " + cmap_op(op) + " " + r + ")"

# Code understood by `sal_fop` in the C prelude (`op` without the `f` prefix).
fn float_op_code(op: String) -> Int ! alloc
    if str_eq(op, d"add") == 1
        0
    elsif str_eq(op, d"sub") == 1
        1
    elsif str_eq(op, d"mul") == 1
        2
    elsif str_eq(op, d"div") == 1
        3
    elsif str_eq(op, d"eq") == 1
        4
    elsif str_eq(op, d"ne") == 1
        5
    elsif str_eq(op, d"lt") == 1
        6
    elsif str_eq(op, d"le") == 1
        7
    elsif str_eq(op, d"gt") == 1
        8
    elsif str_eq(op, d"ge") == 1
        9
    else
        10

# A payload-free enum variant used as a value is its tag.
fn emit_c_ident(name: String, tc: Tc) -> String ! alloc
    code = variant_code(tc, str_as_int(name))
    if code != 0
        if str_len(tenv_type(tc.env, name)) == 0
            if code % 2 == 1
                int_to_str(variant_tag(code)) + "LL"
            else
                name
        else
            name
    else
        name

fn emit_c_args(args: List[Expr], i: Int, n: Int, user: Int, stmts: Int, tc: Tc, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = emit_c_expr(list_get(args, i), user, stmts, tc)
        _p = vec_push(out, str_as_int(a))
        emit_c_args(args, i + 1, n, user, stmts, tc, out)

fn join_comma_piece(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn join_commas(parts: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = join_comma_piece(i)
        acc = acc + comma
        acc = acc + str_from_int(vec_get(parts, i))
        join_commas(parts, i + 1, n, acc)

# Type text of the leftmost operand of a `+` chain ("" when unknown).
fn c_row_len_spine(e: Expr, env: TEnv) -> String ! alloc
    match e
        XBin(op, l, r) => c_row_len_spine(l, env)
        XNone => d""
        _ => texpr_type(env, e)

fn type_row_len_from_text(ty: String) -> String ! alloc
    if str_len(ty) == 0
        d"1"
    else
        prod = type_concrete_row_len(ty)
        if prod > 0
            int_to_str(prod)
        else
            d"1"

fn type_concrete_row_len(ty: String) -> Int ! alloc
    lb = find_char(ty, 91, 0, str_len(ty))
    if lb < 0
        0 - 1
    else
        rb = find_char(ty, 93, lb, str_len(ty))
        if rb < 0
            0 - 1
        else
            inner = str_slice(ty, lb + 1, rb)
            type_dim_product(inner, 0, str_len(inner), 1)

fn type_dim_product(s: String, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        j = skip_spaces(s, i, n)
        if j >= n
            acc
        else
            k = type_dim_token_end(s, j, n)
            tok = str_slice(s, j, k)
            if str_contains(tok, d"?") == 1
                0 - 1
            else
                v = parse_int_digits(tok, 0, str_len(tok), 0)
                if v <= 0
                    0 - 1
                else
                    type_dim_product(s, k + 1, n, acc * v)

fn type_dim_token_end(s: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    else
        c = str_char(s, i)
        if c == 44
            i
        else
            type_dim_token_end(s, i + 1, n)

# Name of the frame struct `where` filters, "" when it is not one.
fn emit_c_where_struct(ty: String, env: TEnv) -> String ! alloc
    if tt_struct_find(env.structs, ty) >= 0
        ty
    else
        d""

fn emit_c_where_frame_ty(args_e: List[Expr], env: TEnv) -> String ! alloc
    if list_len(args_e) == 0
        d""
    else
        where_frame_of(list_get(args_e, 0), env)

fn where_frame_of(frame_e: Expr, env: TEnv) -> String ! alloc
    match frame_e
        XIdent(name) => emit_c_where_struct(tenv_type(env, name), env)
        XCall(callee, cargs, targs, xp) => where_frame_call(frame_e, callee, env)
        _ => emit_c_where_struct(texpr_type(env, frame_e), env)

fn where_frame_call(frame_e: Expr, callee: String, env: TEnv) -> String ! alloc
    if tt_struct_find(env.structs, callee) >= 0
        callee
    else
        emit_c_where_struct(texpr_type(env, frame_e), env)

fn emit_c_where(args_e: List[Expr], user: Int, stmts: Int, tc: Tc) -> String ! alloc
    frame_ty = emit_c_where_frame_ty(args_e, tc.env)
    if str_len(frame_ty) == 0
        d"0"
    else
        emit_c_where_body(list_get(args_e, 0), list_get(args_e, 1), frame_ty, user, stmts, tc)

fn emit_c_where_body(frame_e: Expr, mask_e: Expr, frame_ty: String, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    frame_v = emit_c_expr(frame_e, user, stmts, tc)
    mask_v = emit_c_expr(mask_e, user, stmts, tc)
    len_v = type_row_len_from_text(c_row_len_spine(mask_e, tc.env))
    sd = list_get(tc.env.structs, tt_struct_find(tc.env.structs, frame_ty))
    nfields = list_len(sd.fields)
    cnt = tmp_fresh(tc)
    line = "  int64_t " + cnt + " = sal_mask_select_count((const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _p = vec_push(stmts, str_as_int(line))
    fv = str_as_int(frame_v)
    mv = str_as_int(mask_v)
    lv = str_as_int(len_v)
    cv = str_as_int(cnt)
    emit_c_where_fields(sd.fields, 0, nfields, fv, mv, lv, cv, stmts, tc, d"0")

fn emit_c_where_fields(fields: List[TField], i: Int, n: Int, frame_v: Int, mask_v: Int, len_v: Int, cnt: Int, stmts: Int, tc: Tc, last_out: String) -> String ! alloc
    if i >= n
        if str_eq(last_out, d"0") == 1
            d"0"
        else
            last_out
    else
        fty_s = list_get(fields, i).ty
        out = tmp_fresh(tc)
        fv_s = str_from_int(frame_v)
        mv_s = str_from_int(mask_v)
        lv_s = str_from_int(len_v)
        cnt_s = str_from_int(cnt)
        if str_contains(fty_s, d"Tensor") == 1
            if str_contains(fty_s, d"F32") == 1
                _e = emit_c_where_f32(out, fv_s, mv_s, lv_s, cnt_s, stmts, tc)
            elsif str_contains(fty_s, d"I8") == 1
                _e = emit_c_where_i8(out, fv_s, mv_s, lv_s, cnt_s, stmts, tc)
            else
                _e = 0
        elsif str_contains(fty_s, d"List") == 1
            _e = emit_c_where_list(out, fv_s, mv_s, lv_s, stmts, tc)
        else
            _e = 0
        emit_c_where_fields(fields, i + 1, n, frame_v, mask_v, len_v, cnt, stmts, tc, out)

fn emit_c_where_f32(out: String, col: String, mask_v: String, len_v: String, cnt: String, stmts: Int, tc: Tc) -> Int ! alloc
    heap = tmp_fresh(tc)
    bline = "  int64_t " + heap + "_bytes = " + cnt + " * 4;\n"
    _a = vec_push(stmts, str_as_int(bline))
    mline = "  void *" + heap + " = sal_place_malloc(" + heap + "_bytes, 0);\n"
    _b = vec_push(stmts, str_as_int(mline))
    sline = "  sal_tensor_select_f32((float *)(uintptr_t)" + heap + ", (const float *)(uintptr_t)" + col + ", (const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _c = vec_push(stmts, str_as_int(sline))
    oline = "  int64_t " + out + " = (int64_t)(uintptr_t)" + heap + ";\n"
    _d = vec_push(stmts, str_as_int(oline))
    0

fn emit_c_where_i8(out: String, col: String, mask_v: String, len_v: String, cnt: String, stmts: Int, tc: Tc) -> Int ! alloc
    heap = tmp_fresh(tc)
    bline = "  int64_t " + heap + "_bytes = " + cnt + ";\n"
    _a = vec_push(stmts, str_as_int(bline))
    mline = "  void *" + heap + " = sal_place_malloc(" + heap + "_bytes, 0);\n"
    _b = vec_push(stmts, str_as_int(mline))
    sline = "  sal_tensor_select_i8((int8_t *)(uintptr_t)" + heap + ", (const int8_t *)(uintptr_t)" + col + ", (const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _c = vec_push(stmts, str_as_int(sline))
    oline = "  int64_t " + out + " = (int64_t)(uintptr_t)" + heap + ";\n"
    _d = vec_push(stmts, str_as_int(oline))
    0

fn emit_c_where_list(out: String, col: String, mask_v: String, len_v: String, stmts: Int, tc: Tc) -> Int ! alloc
    heap = tmp_fresh(tc)
    mline = "  void *" + heap + " = sal_list_select((void *)(uintptr_t)" + col + ", (const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _b = vec_push(stmts, str_as_int(mline))
    oline = "  int64_t " + out + " = (int64_t)(uintptr_t)" + heap + ";\n"
    _d = vec_push(stmts, str_as_int(oline))
    0

fn emit_c_call(fname: String, args_e: List[Expr], targs: String, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    hname = str_as_int(fname)
    arg_parts = emit_c_args(args_e, 0, list_len(args_e), user, stmts, tc, vec_new())
    if names_has(user, hname, 0, vec_len(user)) == 1
        m = mangled(fname)
        acc = m + "("
        acc = join_commas(arg_parts, 0, vec_len(arg_parts), acc)
        acc + ")"
    elsif str_eq(fname, d"where") == 1
        emit_c_where(args_e, user, stmts, tc)
    elsif tt_struct_find(tc.env.structs, fname) >= 0
        emit_c_struct_ctor(arg_parts)
    elsif tc_lam_find(tc, fname, list_len(tc.lam_names) - 1) >= 0
        emit_c_lambda_call(tc_lam_find(tc, fname, list_len(tc.lam_names) - 1), arg_parts, user, stmts, tc)
    elsif variant_code(tc, hname) != 0
        emit_c_variant_make(variant_tag(variant_code(tc, hname)) + emit_c_owned_mask(tc, args_e, 0, list_len(args_e), 0, 1) * 256, arg_parts)
    elsif str_eq(fname, d"dict_new") == 1
        emit_c_dict_new(targs)
    elsif str_eq(fname, d"list_new") == 1
        emit_c_list_new(targs, 0, tc)
    elsif str_eq(fname, d"list_new_owned") == 1
        emit_c_list_new(targs, 1, tc)
    elsif str_eq(fname, d"float_to_int") == 1
        "sal_fop(11, " + str_from_int(vec_get(arg_parts, 0)) + ", 0LL)"
    elsif str_eq(fname, d"int_to_float") == 1
        "sal_fop(12, " + str_from_int(vec_get(arg_parts, 0)) + ", 0LL)"
    elsif str_eq(fname, d"print") == 1
        emit_c_print(args_e, arg_parts, tc)
    elsif str_eq(fname, d"load") == 1
        emit_c_load(arg_parts, stmts)
    elsif str_eq(fname, d"matmul") == 1
        emit_c_matmul(args_e, arg_parts, stmts, tc)
    else
        emit_c_builtin(fname, arg_parts, stmts)

# `list_new[T]()` / `list_new_owned[T]()`: the element descriptor is a C string literal
# (the same rule as `desc_type_text` in fuse.sal).
fn emit_c_list_new(targs: String, owned: Int, tc: Tc) -> String ! alloc
    q = char_to_str(34)
    "((int64_t)(uintptr_t)sal_list_new_desc(" + q + emit_c_list_desc(targs, owned, tc) + q + "))"

fn emit_c_list_desc(targs: String, owned: Int, tc: Tc) -> String ! alloc
    desc_type_text(tc.env.structs, tc.enums, targs, owned)

# `dict_new[K, V]()` passes both runtime kinds (Int 0, Float 1, Bool 2, String 3).
fn emit_c_dict_new(targs: String) -> String ! alloc
    comma = find_char(targs, 44, 0, str_len(targs))
    k1 = 0
    k2 = 0
    if comma >= 0
        k1 = scalar_kind_text(targs, 0, comma)
        k2 = scalar_kind_text(targs, comma + 1, str_len(targs))
    "((int64_t)(uintptr_t)sal_dict_new(" + int_to_str(k1) + ", " + int_to_str(k2) + "))"

# Inline a lambda call: the parameter is a fresh C local in its own block.
fn emit_c_lambda_call(idx: Int, arg_parts: Int, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    tname = tmp_fresh(tc)
    _a = vec_push(stmts, str_as_int("  int64_t " + tname + " = 0;\n"))
    arg = if vec_len(arg_parts) > 0
        str_from_int(vec_get(arg_parts, 0))
    else
        d"0"
    _b = vec_push(stmts, str_as_int("  { int64_t " + list_get(tc.lam_params, idx) + " = " + arg + ";\n"))
    slen = tenv_len(tc.env)
    body_stmts = vec_new()
    val = emit_c_expr(list_get(tc.lam_bodies, idx), user, body_stmts, tc)
    _r = tenv_truncate(tc.env, slen)
    _c = append_stmts(stmts, body_stmts)
    _d = vec_push(stmts, str_as_int("  " + tname + " = " + val + "; }\n"))
    tname

# `try x`: return the operand unchanged when it is the failing variant
# (`Err` / `None`), else continue with its payload.
fn emit_c_try(operand: Expr, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    inner = emit_c_expr(operand, user, stmts, tc)
    tname = tmp_fresh(tc)
    _a = vec_push(stmts, str_as_int("  int64_t " + tname + " = " + inner + ";\n"))
    err = variant_code(tc, str_as_int(d"Err"))
    none = variant_code(tc, str_as_int(d"None"))
    code = if err != 0
        err
    else
        none
    if code != 0
        _b = vec_push(stmts, str_as_int("  if (sal_enum_tag(" + tname + ") == " + int_to_str(variant_tag(code)) + "LL) return " + tname + ";\n"))
        "sal_enum_field(" + tname + ", 0)"
    else
        tname

# Two bits per field, as the bootstrap's `enum_owned_mask`: 1 a fresh String, 2 a fresh
# box of a variant with fields. `mul` is 4^i.
fn emit_c_owned_mask(tc: Tc, args_e: List[Expr], i: Int, n: Int, acc: Int, mul: Int) -> Int ! alloc
    if i >= n
        acc
    elsif i >= 28
        acc
    else
        kind = emit_c_owned_kind(tc, list_get(args_e, i))
        emit_c_owned_mask(tc, args_e, i + 1, n, acc + kind * mul, mul * 4)

fn emit_c_owned_kind(tc: Tc, a: Expr) -> Int ! alloc
    if dx_is_fresh_value(a) == 1
        1
    else
        match a
            XCall(name, cargs, targs, xp) => emit_c_owned_variant_kind(tc, name, cargs)
            _ => 0

fn emit_c_owned_variant_kind(tc: Tc, name: String, cargs: List[Expr]) -> Int ! alloc
    if list_len(cargs) > 0
        if variant_code(tc, str_as_int(name)) != 0
            2
        else
            0
    else
        0

fn emit_c_variant_make(tag: Int, arg_parts: Int) -> String ! alloc
    if vec_len(arg_parts) == 0
        int_to_str(tag) + "LL"
    else
        pref = "({ int64_t __e = sal_enum_new(" + int_to_str(tag) + "LL, " + int_to_str(vec_len(arg_parts)) + "LL); "
        sets = emit_c_variant_sets(arg_parts, 0, pref)
        sets + "__e; })"

fn emit_c_variant_sets(arg_parts: Int, i: Int, acc: String) -> String ! alloc
    if i >= vec_len(arg_parts)
        acc
    else
        acc = acc + "sal_enum_set(__e, " + int_to_str(i) + "LL, " + str_from_int(vec_get(arg_parts, i)) + "); "
        emit_c_variant_sets(arg_parts, i + 1, acc)

# Tensors are `float *` buffers from sal_place_malloc; the value is the pointer.
fn emit_c_tensor_lit(data: List[String]) -> String ! alloc
    n = list_len(data)
    acc = "({ float *__t = (float *)sal_place_malloc(" + int_to_str(n * 4 + 4) + ", 0); "
    acc = emit_c_tensor_cells(data, 0, n, acc)
    acc + "(int64_t)(uintptr_t)__t; })"

fn emit_c_tensor_cells(data: List[String], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + "__t[" + int_to_str(i) + "] = " + list_get(data, i) + "f; "
        emit_c_tensor_cells(data, i + 1, n, acc)

fn emit_c_load(arg_parts: Int, stmts: Int) -> String ! alloc
    _p = vec_push(stmts, str_as_int(d"  extern int64_t sal_load_f32();\n"))
    "({ int64_t __n = 0; (int64_t)(uintptr_t)sal_load_f32((const char *)(uintptr_t)(" + arg_at(arg_parts, 0) + "), &__n); })"

fn emit_c_matmul(args_e: List[Expr], arg_parts: Int, stmts: Int, tc: Tc) -> String ! alloc
    ta = str_as_int(texpr_type(tc.env, list_get(args_e, 0)))
    tb = str_as_int(texpr_type(tc.env, list_get(args_e, 1)))
    pa = tt_split(ta)
    pb = tt_split(tb)
    if vec_len(pa) < 3
        d"0"
    elsif vec_len(pb) < 3
        d"0"
    else
        m = tt_dim_val(vec_get(pa, vec_len(pa) - 2))
        k = tt_dim_val(vec_get(pa, vec_len(pa) - 1))
        n = tt_dim_val(vec_get(pb, vec_len(pb) - 1))
        tc_n = list_get(tc.ctr, 0) + 1
        _u = list_set(tc.ctr, 0, tc_n)
        out = "__mm" + int_to_str(tc_n)
        _e = vec_push(stmts, str_as_int(d"  extern void sal_matmul_f32();\n"))
        _p = vec_push(stmts, str_as_int("  float *" + out + " = (float *)sal_place_malloc(" + int_to_str(m * n * 4) + ", 0);\n"))
        _q = vec_push(stmts, str_as_int("  sal_matmul_f32((const float *)(uintptr_t)" + arg_at(arg_parts, 0) + ", (const float *)(uintptr_t)" + arg_at(arg_parts, 1) + ", " + out + ", " + int_to_str(m) + ", " + int_to_str(k) + ", " + int_to_str(n) + ");\n"))
        if m * n <= 16
            _r = list_set(tc.mm_out, 0, str_as_int(out))
            _t = list_set(tc.mm_n, 0, m * n)
        "((int64_t)(uintptr_t)" + out + ")"

# The bootstrap returns the element sum of the last (small) matmul from `main`.
fn emit_c_matmul_exit(tc: Tc, is_main: Int, val: String) -> String ! alloc
    q = list_get(tc.mm_out, 0)
    if q == 0
        val
    elsif is_main == 0
        val
    else
        out = str_from_int(q)
        cnt = int_to_str(list_get(tc.mm_n, 0))
        "({ double __s = 0; for (int __i = 0; __i < " + cnt + "; __i++) __s += " + out + "[__i]; (int64_t)__s; })"

# `print` of a String prints its text, of anything else the integer.
fn emit_c_print(args_e: List[Expr], arg_parts: Int, tc: Tc) -> String ! alloc
    a0 = arg_at(arg_parts, 0)
    if list_len(args_e) > 0
        if texpr_is_string(tc.env, list_get(args_e, 0)) == 1
            "sal_print_str((const char*)(uintptr_t)" + a0 + ")"
        else
            "sal_print_i64(" + a0 + ")"
    else
        "sal_print_i64(0)"

# One-field structs are transparent; wider ones are a heap array of int64
# slots, so a struct value is the pointer to it.
fn emit_c_struct_ctor(arg_parts: Int) -> String ! alloc
    n = vec_len(arg_parts)
    if n == 0
        d"0"
    elsif n == 1
        str_from_int(vec_get(arg_parts, 0))
    else
        acc = "({ int64_t *__s = (int64_t *)malloc(" + int_to_str(n * 8) + "); "
        acc = emit_c_ctor_slots(arg_parts, 0, n, acc)
        acc + "(int64_t)__s; })"

fn emit_c_ctor_slots(parts: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + "__s[" + int_to_str(i) + "] = " + str_from_int(vec_get(parts, i)) + "; "
        emit_c_ctor_slots(parts, i + 1, n, acc)

# C lvalue/rvalue for `base.field`, or just the base for a one-field struct.
fn emit_c_field(base_e: Expr, field: String, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    base = emit_c_expr(base_e, user, stmts, tc)
    si = tt_struct_find(tc.env.structs, texpr_type(tc.env, base_e))
    if si < 0
        base
    else
        sd = list_get(tc.env.structs, si)
        if list_len(sd.fields) < 2
            base
        else
            idx = tt_field_index(sd.fields, field, 0, list_len(sd.fields))
            "(((int64_t *)(" + base + "))[" + int_to_str(idx) + "])"

# A struct is a value: `p.x = v` writes into a private copy of `p`, so a caller
# that still holds the original (or another name for it) never sees the update.
fn emit_c_field_copy(target: Expr, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    match target
        XField(b, field) => emit_c_field_copy_base(b, user, stmts, tc)
        _ => 0

fn emit_c_field_copy_base(b: Expr, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    match b
        XIdent(nm) => emit_c_field_copy_ident(b, user, stmts, tc)
        _ => 0

fn emit_c_field_copy_ident(b: Expr, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    si = tt_struct_find(tc.env.structs, texpr_type(tc.env, b))
    if si < 0
        0
    elsif list_len(list_get(tc.env.structs, si).fields) < 2
        0
    else
        name = emit_c_expr(b, user, stmts, tc)
        bytes = int_to_str(list_len(list_get(tc.env.structs, si).fields) * 8)
        line = "  " + name + " = ({ int64_t *__d = (int64_t *)malloc(" + bytes + "); __builtin_memcpy(__d, (int64_t *)(" + name + "), " + bytes + "); (int64_t)__d; });\n"
        vec_push(stmts, str_as_int(line))

fn arg_at(args: Int, i: Int) -> String ! alloc
    if i < vec_len(args)
        str_from_int(vec_get(args, i))
    else
        d"0"

fn emit_c_builtin(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_as_int") == 1
        arg_at(args, 0)
    elsif str_eq(fname, d"str_to_f64_bits") == 1
        a0 = arg_at(args, 0)
        "sal_str_to_f64_bits((const char *)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, d"str_from_int") == 1
        arg_at(args, 0)
    elsif str_eq(fname, d"map_new") == 1
        d"((int64_t)(uintptr_t)sal_map_new())"
    elsif str_eq(fname, d"map_get") == 1
        a0 = arg_at(args, 0)
        a1 = arg_at(args, 1)
        "sal_map_get((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ")"
    elsif str_eq(fname, d"map_put") == 1
        a0 = arg_at(args, 0)
        a1 = arg_at(args, 1)
        a2 = arg_at(args, 2)
        "sal_map_put((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ", " + a2 + ")"
    elsif str_eq(fname, d"ir_text") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_ir_text((void *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"lex_src") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_lex_src((const char *)(uintptr_t)" + a0 + "))"
    else
        emit_c_builtin_skip(fname, args, stmts)

fn emit_c_builtin_skip(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_skip") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        d = arg_at(args, 3)
        "sal_str_skip((const char*)(uintptr_t)" + a + "," + b + "," + c + "," + d + ")"
    elsif str_eq(fname, d"str_hash") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_hash((const char*)(uintptr_t)" + a + "," + b + ")"
    else
        emit_c_builtin_rest(fname, args, stmts)

fn emit_c_builtin_rest(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"vec_new") == 1
        d"((int64_t)(uintptr_t)sal_vec_new())"
    elsif str_eq(fname, d"argv") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_argv(" + a0 + "))"
    elsif str_eq(fname, d"read_file") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_read_file((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"strdup") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_strdup((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"tmp_path") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_tmp_path((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"int_to_str") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_int_to_str(" + a0 + "))"
    elsif str_eq(fname, d"char_to_str") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_char_to_str(" + a0 + "))"
    else
        emit_c_builtin2(fname, args, stmts)

fn emit_c_builtin2(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_append") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_str_append((char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
    elsif str_eq(fname, d"str_concat") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_str_concat((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
    elsif str_eq(fname, d"str_slice") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        "((int64_t)(uintptr_t)sal_str_slice((const char*)(uintptr_t)" + a + "," + b + "," + c + "))"
    elsif str_eq(fname, d"free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, str_as_int(line))
        d"0"
    elsif str_eq(fname, d"clang") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_clang((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"clang_obj") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_clang_obj((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"link_objs") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_link_objs((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"realpath") == 1
        a = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_realpath((const char*)(uintptr_t)" + a + "))"
    elsif str_eq(fname, d"path_readable") == 1
        a = arg_at(args, 0)
        "sal_path_readable((const char*)(uintptr_t)" + a + ")"
    else
        emit_c_builtin3(fname, args, stmts)

fn emit_c_builtin3(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"gated_print_str") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_gated_print_str(" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"write_file") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_write_file((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"str_eq") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_eq((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"str_contains") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_contains((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"str_index_of") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_index_of((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"str_index_from") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        "sal_str_index_from((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "," + c + ")"
    elsif str_eq(fname, d"str_len") == 1
        a = arg_at(args, 0)
        "sal_str_len((const char*)(uintptr_t)" + a + ")"
    else
        emit_c_builtin4(fname, args, stmts)

fn emit_c_builtin4(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_char") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_char((const char*)(uintptr_t)" + a + "," + b + ")"
    elsif str_eq(fname, d"vec_push") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_vec_push((void*)(uintptr_t)" + a + "," + b + ")"
    elsif str_eq(fname, d"vec_get") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_vec_get((void*)(uintptr_t)" + a + "," + b + ")"
    elsif str_eq(fname, d"vec_set") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        "sal_vec_set((void*)(uintptr_t)" + a + "," + b + "," + c + ")"
    elsif str_eq(fname, d"vec_len") == 1
        a = arg_at(args, 0)
        "sal_vec_len((void*)(uintptr_t)" + a + ")"
    else
        emit_c_builtin5(fname, args, stmts)

fn emit_c_builtin5(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"vec_free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_vec_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, line)
        d"0"
    elsif str_eq(fname, d"list_free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_list_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, line)
        d"0"
    elsif str_eq(fname, d"enum_free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_enum_free(" + a0 + ");\n"
        _p = vec_push(stmts, line)
        d"0"
    elsif str_eq(fname, d"enum_owns") == 1
        "sal_enum_owns(" + arg_at(args, 0) + ", " + arg_at(args, 1) + ")"
    elsif str_eq(fname, d"enum_box_id") == 1
        "sal_enum_box_id(" + arg_at(args, 0) + ")"
    elsif str_eq(fname, d"list_box_id") == 1
        "sal_list_box_id((void *)(uintptr_t)" + arg_at(args, 0) + ")"
    elsif str_eq(fname, d"dict_free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_dict_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, line)
        d"0"
    elsif str_eq(fname, d"bytes_free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_bytes_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, line)
        d"0"
    elsif str_eq(fname, d"not") == 1
        a0 = arg_at(args, 0)
        "sal_not(" + a0 + ")"
    elsif str_eq(fname, d"print_str") == 1
        a0 = arg_at(args, 0)
        "sal_print_str((const char*)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, d"eprint_str") == 1
        a0 = arg_at(args, 0)
        "sal_eprint_str((const char*)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, d"print") == 1
        a0 = arg_at(args, 0)
        "sal_print_i64(" + a0 + ")"
    elsif str_eq(fname, d"getenv") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_getenv((const char*)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"mkdir_p") == 1
        a0 = arg_at(args, 0)
        "sal_mkdir_p((const char*)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, d"select_str") == 1
        c = arg_at(args, 0)
        a = arg_at(args, 1)
        b = arg_at(args, 2)
        "((int64_t)(uintptr_t)sal_select_str(" + c + ",(char*)(uintptr_t)" + a + ",(char*)(uintptr_t)" + b + "))"
    elsif str_eq(fname, d"place_matmul_ai_sum") == 1
        a0 = arg_at(args, 0)
        "sal_place_matmul_ai_sum(" + a0 + ")"
    elsif str_eq(fname, d"place_launches") == 1
        a0 = arg_at(args, 0)
        "sal_place_launches(" + a0 + ")"
    elsif str_eq(fname, d"image_new") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_image_new(" + a + "," + b + "))"
    elsif str_eq(fname, d"write_png") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        d = arg_at(args, 3)
        "sal_write_png((const char*)(uintptr_t)" + a + "," + b + "," + c + ",(void*)(uintptr_t)" + d + ")"
    else
        emit_c_runtime_call(fname, args, stmts)

# Any other builtin is the runtime function `sal_<name>`. Values are all
# int64 (pointers included), which matches the x86-64 calling convention, so a
# block-scope unprototyped declaration is enough.
fn emit_c_runtime_call(fname: String, args: Int, stmts: Int) -> String ! alloc
    if cir_is_stub(str_slice("sal_" + fname, 0, 4 + str_len(fname))) == 1
        d"0"
    elsif str_eq(fname, d"syscall") == 1
        emit_c_syscall(args, stmts)
    elsif str_eq(fname, d"bytes_get_u8") == 1
        emit_c_bytes_get(args, 1)
    elsif str_eq(fname, d"bytes_get_u16") == 1
        emit_c_bytes_get(args, 2)
    elsif str_eq(fname, d"bytes_get_u32") == 1
        emit_c_bytes_get(args, 4)
    elsif str_eq(fname, d"bytes_get_i64") == 1
        emit_c_bytes_get(args, 8)
    elsif str_eq(fname, d"bytes_set_u8") == 1
        emit_c_bytes_set(args, 1)
    elsif str_eq(fname, d"bytes_set_u16") == 1
        emit_c_bytes_set(args, 2)
    elsif str_eq(fname, d"bytes_set_u32") == 1
        emit_c_bytes_set(args, 4)
    elsif str_eq(fname, d"bytes_set_i64") == 1
        emit_c_bytes_set(args, 8)
    else
        emit_c_plain_runtime_call(fname, args, stmts)

fn emit_c_syscall(args: Int, stmts: Int) -> String ! alloc
    _p = vec_push(stmts, str_as_int(d"  extern int64_t sal_os_syscall();\n"))
    padded = vec_copy(args)
    _z = pad_args(padded, 7)
    acc = d"sal_os_syscall("
    acc = join_commas(padded, 0, vec_len(padded), acc)
    acc + ")"

fn pad_args(v: Int, n: Int) -> Int ! alloc
    if vec_len(v) >= n
        0
    else
        _p = vec_push(v, str_as_int(d"0"))
        pad_args(v, n)

# Bytes handles point at {uint8_t *data; int64_t len}; accesses are checked.
fn emit_c_bytes_get(args: Int, width: Int) -> String ! alloc
    w = int_to_str(width)
    "({ int64_t *__b = (int64_t *)(uintptr_t)(" + arg_at(args, 0) + "); int64_t __i = " + arg_at(args, 1) + "; extern void sal_bytes_check(); sal_bytes_check(__i, " + w + ", __b[1]); uint64_t __v = 0; __builtin_memcpy(&__v, (char *)__b[0] + __i, " + w + "); (int64_t)__v; })"

fn emit_c_bytes_set(args: Int, width: Int) -> String ! alloc
    w = int_to_str(width)
    "({ int64_t *__b = (int64_t *)(uintptr_t)(" + arg_at(args, 0) + "); int64_t __i = " + arg_at(args, 1) + "; int64_t __x = " + arg_at(args, 2) + "; extern void sal_bytes_check(); sal_bytes_check(__i, " + w + ", __b[1]); __builtin_memcpy((char *)__b[0] + __i, &__x, " + w + "); (int64_t)0; })"

fn emit_c_plain_runtime_call(fname: String, args: Int, stmts: Int) -> String ! alloc
    rname = "sal_" + fname
    _p = vec_push(stmts, str_as_int("  extern int64_t " + rname + "();\n"))
    acc = "((int64_t)" + rname + "("
    acc = join_commas(args, 0, vec_len(args), acc)
    acc + "))"

fn emit_c_while(cond: Expr, body: TBlock, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    cond_stmts = vec_new()
    c = emit_c_expr(cond, user, cond_stmts, tc)
    _q = vec_push(stmts, str_as_int(d"  while (1) {\n"))
    _a = append_stmts(stmts, cond_stmts)
    line = "    if (!(" + c + ")) break;\n"
    _b = vec_push(stmts, str_as_int(line))
    body_stmts = vec_new()
    _tv = emit_c_block(body, user, body_stmts, tc)
    _c = append_stmts(stmts, body_stmts)
    _d = vec_push(stmts, str_as_int(d"  }\n"))
    d"0"

fn emit_c_if(cond: Expr, then_b: TBlock, else_in: TBlock, elsifs: List[TElsif], user: Int, stmts: Int, tc: Tc) -> String ! alloc
    c = emit_c_expr(cond, user, stmts, tc)
    tname = tmp_fresh(tc)
    line = "  int64_t " + tname + ";\n"
    _p = vec_push(stmts, str_as_int(line))
    line2 = "  if (" + c + ") {\n"
    _q = vec_push(stmts, str_as_int(line2))
    slen = tenv_len(tc.env)
    then_stmts = vec_new()
    then_val = emit_c_block(then_b, user, then_stmts, tc)
    _rs = tenv_truncate(tc.env, slen)
    _a = append_stmts(stmts, then_stmts)
    line3 = "    " + tname + " = " + then_val + ";\n"
    _r = vec_push(stmts, str_as_int(line3))
    _s = vec_push(stmts, str_as_int(d"  } else {\n"))
    else_stmts = vec_new()
    else_b = elsifs_else_block(else_in, elsifs)
    else_val = emit_c_block(else_b, user, else_stmts, tc)
    _rs2 = tenv_truncate(tc.env, slen)
    _b = append_stmts(stmts, else_stmts)
    line4 = "    " + tname + " = " + else_val + ";\n"
    _t = vec_push(stmts, str_as_int(line4))
    _u = vec_push(stmts, str_as_int(d"  }\n"))
    tname

# `match` over Int: integer literals, `_` and a binding name. Variant patterns
# never match (enums are not lowered by the selfhost yet).
fn emit_c_match(scrut_e: Expr, arms: List[TArm], user: Int, stmts: Int, tc: Tc) -> String ! alloc
    scrut = emit_c_expr(scrut_e, user, stmts, tc)
    sname = tmp_fresh(tc)
    tname = tmp_fresh(tc)
    _a = vec_push(stmts, str_as_int("  int64_t " + sname + " = " + scrut + ";\n"))
    _b = vec_push(stmts, str_as_int("  int64_t " + tname + " = 0;\n"))
    sty = texpr_type(tc.env, scrut_e)
    opens = emit_c_match_arms(arms, 0, list_len(arms), sname, sty, tname, user, stmts, tc)
    _c = emit_c_match_close(stmts, opens)
    tname

fn emit_c_match_close(stmts: Int, n: Int) -> Int ! alloc
    if n <= 0
        0
    else
        _p = vec_push(stmts, str_as_int(d"  }\n"))
        emit_c_match_close(stmts, n - 1)

# Emits the arm body into the then-block; returns the C name of nothing.
fn emit_c_arm_body(arm: TArm, tname: String, user: Int, stmts: Int, tc: Tc, slen: Int) -> Int ! alloc
    body_stmts = vec_new()
    val = if arm.has_suite == 1
        emit_c_block(arm.suite, user, body_stmts, tc)
    else
        emit_c_expr(arm.body, user, body_stmts, tc)
    _r = tenv_truncate(tc.env, slen)
    _m = append_stmts(stmts, body_stmts)
    vec_push(stmts, str_as_int("    " + tname + " = " + val + ";\n"))

# Returns the number of `else {` blocks still open.
fn emit_c_match_arms(arms: List[TArm], i: Int, n: Int, sname: String, sty: String, tname: String, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        kind = arm.pat.kind
        slen = tenv_len(tc.env)
        if kind == 2
            _h = vec_push(stmts, str_as_int("  if (" + sname + " == " + int_to_str(arm.pat.ival) + "LL) {\n"))
            _x = emit_c_arm_body(arm, tname, user, stmts, tc, slen)
            _e = vec_push(stmts, str_as_int(d"  } else {\n"))
            1 + emit_c_match_arms(arms, i + 1, n, sname, sty, tname, user, stmts, tc)
        elsif kind == 4
            plit = ensure_sal_lit(str_as_int(arm.pat.name), tc_lit_pool(tc))
            cond = "sal_str_eq((const char*)(uintptr_t)" + sname + ", (const char*)(uintptr_t)" + plit + ") == 1LL"
            _h = vec_push(stmts, str_as_int("  if (" + cond + ") {\n"))
            _x = emit_c_arm_body(arm, tname, user, stmts, tc, slen)
            _e = vec_push(stmts, str_as_int(d"  } else {\n"))
            1 + emit_c_match_arms(arms, i + 1, n, sname, sty, tname, user, stmts, tc)
        elsif kind == 5
            plit = ensure_sal_lit(str_as_int(arm.pat.name), tc_lit_pool(tc))
            cond = "sal_regex_match((const char*)(uintptr_t)" + sname + ", (const char*)(uintptr_t)" + plit + ") == 1LL"
            _h = vec_push(stmts, str_as_int("  if (" + cond + ") {\n"))
            _x = emit_c_arm_body(arm, tname, user, stmts, tc, slen)
            _e = vec_push(stmts, str_as_int(d"  } else {\n"))
            1 + emit_c_match_arms(arms, i + 1, n, sname, sty, tname, user, stmts, tc)
        elsif kind == 3
            code = variant_code(tc, str_as_int(arm.pat.name))
            cond = if code == 0
                d"0"
            else
                "sal_enum_tag(" + sname + ") == " + int_to_str(variant_tag(code)) + "LL"
            _h = vec_push(stmts, str_as_int("  if (" + cond + ") {\n"))
            _pb = emit_c_variant_binds(arm.pat.args, 0, sname, stmts, tc, arm.pat.name, sty)
            _x = emit_c_arm_body(arm, tname, user, stmts, tc, slen)
            _e = vec_push(stmts, str_as_int(d"  } else {\n"))
            1 + emit_c_match_arms(arms, i + 1, n, sname, sty, tname, user, stmts, tc)
        elsif ident_pat_is_variant(arm.pat, tc) == 1
            code = variant_code(tc, str_as_int(arm.pat.name))
            _h = vec_push(stmts, str_as_int("  if (sal_enum_tag(" + sname + ") == " + int_to_str(variant_tag(code)) + "LL) {\n"))
            _x = emit_c_arm_body(arm, tname, user, stmts, tc, slen)
            _e = vec_push(stmts, str_as_int(d"  } else {\n"))
            1 + emit_c_match_arms(arms, i + 1, n, sname, sty, tname, user, stmts, tc)
        else
            _h = vec_push(stmts, str_as_int(d"  {\n"))
            if kind == 1
                _bind = vec_push(stmts, str_as_int("  int64_t " + arm.pat.name + " = " + sname + ";\n"))
            else
                _bind = 0
            _x = emit_c_arm_body(arm, tname, user, stmts, tc, slen)
            _e = vec_push(stmts, str_as_int(d"  }\n"))
            0

fn ident_pat_is_variant(pat: TPat, tc: Tc) -> Int ! alloc
    if pat.kind == 1
        if variant_code(tc, str_as_int(pat.name)) != 0
            1
        else
            0
    else
        0

# Type of field `i` of variant `vname`; a type parameter of its enum is replaced
# by the matching argument of the scrutinee type `sty` (`Option[P]` -> `P`).
fn variant_field_type(tc: Tc, vname: String, i: Int, sty: String) -> String ! alloc
    entry = map_get(lit_pool_variant_fields(tc_lit_pool(tc)), str_as_int(vname))
    if entry == 0
        d""
    else
        ed = list_get(tc.enums, vec_get(entry, 0))
        v = list_get(ed.variants, vec_get(entry, 1))
        if i < list_len(v.fields)
            fty = list_get(v.fields, i)
            pi = type_param_index(ed.tparams, trim_spaces(fty), 0)
            if pi < 0
                strdup(fty)
            elsif str_len(sty) == 0
                d""
            else
                strdup(str_from_int(nth_type_arg(sty, pi)))
        else
            d""

fn type_param_index(params: List[String], name: String, i: Int) -> Int ! alloc
    if i >= list_len(params)
        0 - 1
    elsif str_eq(list_get(params, i), name) == 1
        i
    else
        type_param_index(params, name, i + 1)

fn emit_c_variant_binds(args: List[TPat], i: Int, sname: String, stmts: Int, tc: Tc, vname: String, sty: String) -> Int ! alloc
    if i >= list_len(args)
        0
    else
        sub = list_get(args, i)
        if sub.kind == 1
            _b = vec_push(stmts, str_as_int("    int64_t " + sub.name + " = sal_enum_field(" + sname + ", " + int_to_str(i) + "LL);\n"))
            _t = tenv_bind(tc.env, sub.name, variant_field_type(tc, vname, i, sty))
            emit_c_variant_binds(args, i + 1, sname, stmts, tc, vname, sty)
        else
            emit_c_variant_binds(args, i + 1, sname, stmts, tc, vname, sty)

fn append_stmts(dst: Int, src: Int) -> Int ! alloc
    append_stmts_go(dst, src, 0, vec_len(src))

fn append_stmts_go(dst: Int, src: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        append_stmts_go(dst, src, i + 1, n)

fn emit_c_block(b: TBlock, user: Int, stmts: Int, tc: Tc) -> String ! alloc
    stopped = emit_c_stmts(b.stmts, 0, list_len(b.stmts), user, stmts, tc)
    if stopped == 1
        d"0"
    else
        emit_c_expr(b.tail, user, stmts, tc)

fn tc_assign_accumulates(env: TEnv, name: String, value: Expr) -> Int ! alloc
    if tbinary_is_string_concat(env, value) == 0
        0
    else
        str_eq(dx_leftmost(value), name)

fn emit_c_lambda_reg(tc: Tc, name: String, value: Expr) -> Int ! alloc
    match value
        XLambda(param, body) => tc_lam_push(tc, name, param, body)
        _ => 0

fn emit_c_stmts(sts: List[TStmt], i: Int, n: Int, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(sts, i)
        if st.kind == 1
            if tc_assign_accumulates(tc.env, st.name, st.expr) == 1
                _sa = tc_set_acc(tc, str_as_int(st.name))
            else
                _sa = tc_set_acc(tc, 0)
            val = emit_c_expr(st.expr, user, stmts, tc)
            _za = tc_set_acc(tc, 0)
            _lm = emit_c_lambda_reg(tc, st.name, st.expr)
            _ns = tenv_bind(tc.env, st.name, texpr_type(tc.env, st.expr))
            line = "  " + st.name + " = " + val + ";\n"
            _p = vec_push(stmts, str_as_int(line))
            emit_c_stmts(sts, i + 1, n, user, stmts, tc)
        elsif st.kind == 2
            val0 = emit_c_expr(st.expr, user, stmts, tc)
            line = "  return " + val0 + ";\n"
            _p = vec_push(stmts, str_as_int(line))
            1
        elsif st.kind == 3
            _cp = emit_c_field_copy(st.target, user, stmts, tc)
            lhs = emit_c_expr(st.target, user, stmts, tc)
            val3 = emit_c_expr(st.expr, user, stmts, tc)
            line = "  " + lhs + " = " + val3 + ";\n"
            _p = vec_push(stmts, str_as_int(line))
            emit_c_stmts(sts, i + 1, n, user, stmts, tc)
        else
            val1 = emit_c_expr(st.expr, user, stmts, tc)
            line = "  " + val1 + ";\n"
            _p = vec_push(stmts, str_as_int(line))
            emit_c_stmts(sts, i + 1, n, user, stmts, tc)

fn emit_params_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn emit_params_c(params: List[TParam], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_params_comma(i)
        acc = acc + comma
        acc = acc + "int64_t "
        acc = acc + list_get(params, i).name
        emit_params_c(params, i + 1, n, acc)

fn emit_extern_comma(i: Int, acc: String) -> String ! alloc
    if i > 0
        acc + ", "
    else
        acc

fn emit_extern_params(n: Int, i: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc2 = emit_extern_comma(i, acc)
        acc3 = acc2 + "int64_t p"
        acc4 = acc3 + int_to_str(i)
        emit_extern_params(n, i + 1, acc4)

fn emit_extern_decl(pair: Int) -> String ! alloc
    name = vec_get(pair, 0)
    nparams = vec_get(pair, 1)
    m = mangled(str_from_int(name))
    acc = "extern int64_t " + m + "("
    if nparams == 0
        acc = acc + "void"
    else
        acc = emit_extern_params(nparams, 0, acc)
    acc + ");\n"

fn emit_extern_decls(externs: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_extern_decl(vec_get(externs, i))
        acc = acc + piece
        emit_extern_decls(externs, i + 1, n, acc)

fn emit_c_fn_header(f: TFn, linkable: Int, allow_main: Int) -> String ! alloc
    if allow_main == 0
        if str_eq(f.name, d"main") == 1
            d""
        else
            emit_c_fn_header_body(f.name, f.params, linkable)
    elsif str_eq(f.name, d"main") == 1
        d"int main(int argc, char **argv) {\n  sal_runtime_init((int64_t)argc, (const char **)argv);\n"
    else
        emit_c_fn_header_body(f.name, f.params, linkable)

fn emit_c_fn_header_body(name: String, params: List[TParam], linkable: Int) -> String ! alloc
    m = mangled(name)
    pref = select_str(linkable, d"int64_t ", d"static int64_t ")
    acc = pref + m
    acc = acc + "("
    acc = emit_params_c(params, 0, list_len(params), acc)
    acc + ") {\n"

fn emit_c_fn_footer(is_main: Int, val: String) -> String ! alloc
    if is_main == 1
        "  return (int)(" + val + ");\n}\n\n"
    else
        "  return " + val + ";\n}\n\n"

fn emit_decl_names_filtered(names: Int, i: Int, n: Int, skip: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        nm = vec_get(names, i)
        if names_has(skip, nm, 0, vec_len(skip)) == 1
            emit_decl_names_filtered(names, i + 1, n, skip, acc)
        else
            acc = acc + "  int64_t "
            acc = acc + str_from_int(nm)
            acc = acc + " = 0;\n"
            emit_decl_names_filtered(names, i + 1, n, skip, acc)

fn emit_c_fn(tf: TFn, user: Int, linkable: Int, allow_main: Int, pool: Int, env: TEnv, enums: List[TEnum]) -> String ! alloc
    is_main = str_eq(tf.name, d"main")
    acc = emit_c_fn_header(tf, linkable, allow_main)
    if str_len(acc) == 0
        d""
    else
        emit_c_fn_body(tf, user, is_main, acc, pool, env, enums)

fn emit_c_fn_body(tf: TFn, user: Int, is_main: Int, acc: String, pool: Int, env: TEnv, enums: List[TEnum]) -> String ! alloc
    body = drops_body_tc(tf, vec_get(pool, 8))
    names = vec_new()
    _c = collect_assigns_block(body, names)
    skip = tparam_names(tf.params, 0, list_len(tf.params), vec_new())
    acc = emit_decl_names_filtered(names, 0, vec_len(names), skip, acc)
    stmts = vec_new()
    tc = tc_new(pool, env, enums)
    _sp = seed_string_params(tf.params, 0, list_len(tf.params), tc.env)
    val = emit_c_block(body, user, stmts, tc)
    acc = append_stmt_strings(acc, stmts, 0, vec_len(stmts))
    val = emit_c_matmul_exit(tc, is_main, val)
    foot = emit_c_fn_footer(is_main, val)
    acc = acc + foot
    _lt = lit_pool_free_texts(pool)
    _fc = tc_free(tc)
    # Do not `tp_free_block(body)` here: the drops AST can still share nodes with lambda bodies
    # held in `tc.lam_bodies` (deep copies) in patterns the selfhost runtime does not keep disjoint.
    acc

fn tparam_names(params: List[TParam], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, str_as_int(list_get(params, i).name))
        tparam_names(params, i + 1, n, out)

fn emit_forward_params(params: List[TParam]) -> String ! alloc
    if list_len(params) == 0
        d"void"
    else
        emit_params_c(params, 0, list_len(params), d"")

fn emit_forward_decls(fns: List[TFn], i: Int, n: Int, acc: String, allow_main: Int, linkable: Int) -> String ! alloc
    if i >= n
        acc
    else
        f = list_get(fns, i)
        if str_eq(f.name, d"main") == 1
            emit_forward_decls(fns, i + 1, n, acc, allow_main, linkable)
        else
            emit_forward_decls(fns, i + 1, n, emit_forward_one(f, acc, linkable), allow_main, linkable)

fn emit_forward_one(f: TFn, acc: String, linkable: Int) -> String ! alloc
    m = mangled(f.name)
    pref = select_str(linkable, d"int64_t ", d"static int64_t ")
    acc = acc + pref
    acc = acc + m
    acc = acc + "("
    ps = emit_forward_params(f.params)
    acc = acc + ps
    acc + ");\n"

fn append_stmt_strings(acc: String, stmts: Int, i: Int, n: Int) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + str_from_int(vec_get(stmts, i))
        append_stmt_strings(acc, stmts, i + 1, n)

fn emit_c_one_fn(tf: TFn, irf: Int, user: Int, linkable: Int, allow_main: Int, pool: Int, env: TEnv, enums: List[TEnum]) -> String ! alloc
    if irf == 0
        emit_c_fn(tf, user, linkable, allow_main, pool, env, enums)
    else
        emit_c_one_ir_fn(tf, ti_fn(irf), user, linkable, allow_main, pool, env, enums)

fn emit_c_one_ir_fn(tf: TFn, irf: IrFn, user: Int, linkable: Int, allow_main: Int, pool: Int, env: TEnv, enums: List[TEnum]) -> String ! alloc
    text = d""
    if cir_use_ir_path(irf.insts) == 1
        text = cir_fn(tf, irf, user, linkable, allow_main, pool)
    else
        text = emit_c_fn(tf, user, linkable, allow_main, pool, env, enums)
    _x = ti_free_fn_parts(irf)
    text

fn emit_c_fns(tfns: List[TFn], i: Int, n: Int, user: Int, acc: String, allow_main: Int, linkable: Int, pool: Int, irmod: Int, env: TEnv, enums: List[TEnum]) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_c_one_fn(list_get(tfns, i), vec_get(irmod, i), user, linkable, allow_main, pool, env, enums)
        emit_c_fns(tfns, i + 1, n, user, acc + piece, allow_main, linkable, pool, irmod, env, enums)

# `genums`: the enums of the whole module graph (empty for a single file).
fn emit_c_from_ast_module(tp: TProgram, callables: Int, externs: Int, allow_main: Int, linkable: Int, genums: List[TEnum], env: TEnv borrow) -> String ! alloc
    pool = lit_pool_new()
    enums = list_new[TEnum]()
    _e1 = enums_push(enums, genums, 0, list_len(genums))
    _e2 = enums_push(enums, tp.enums, 0, list_len(tp.enums))
    _vr = variants_register(lit_pool_variants(pool), lit_pool_variant_fields(pool), enums, 0, list_len(enums))
    _dv = vec_set(pool, 8, drop_env_t(tp, env.structs, enums))
    acc = runtime_decls()
    acc = acc + "#include <stdint.h>\n"
    acc = emit_extern_decls(externs, 0, vec_len(externs), acc)
    acc = emit_forward_decls(tp.fns, 0, list_len(tp.fns), acc, allow_main, linkable)
    acc = acc + "\n"
    acc = emit_any_vtables_module(tp, acc)
    irmod = lower_program_typed(tp, callables, env, enums)
    body = emit_c_fns(tp.fns, 0, list_len(tp.fns), callables, d"", allow_main, linkable, pool, irmod, env, enums)
    _fe = list_free(enums)
    lits = lit_pool_globals(pool)
    if str_len(lits) > 0
        acc = acc + lits
        acc = acc + "\n"
    acc = acc + body
    # A library root still links as a program, like the bootstrap's entry stub.
    if allow_main == 1
        if fns_have_main(tp.fns, 0, list_len(tp.fns)) == 0
            acc + "int main(int argc, char **argv) {\n  sal_runtime_init((int64_t)argc, (const char **)argv);\n  return 0;\n}\n"
        else
            acc
    else
        acc

fn fns_have_main(fns: List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(fns, i).name, d"main") == 1
        1
    else
        fns_have_main(fns, i + 1, n)

fn emit_c_from_ast(tp: TProgram) -> String ! alloc
    user = collect_fn_names_t(tp.fns, 0, list_len(tp.fns), vec_new())
    env = tenv_new(tp)
    text = emit_c_from_ast_module(tp, user, vec_new(), 1, 0, list_new[TEnum](), env)
    _a = tenv_free(env)
    text

fn call_link_objs(obj_list: String, out_path: String) -> Int ! io, alloc
    link_objs(obj_list, out_path)

fn call_clang_obj(c_path: String, o_path: String) -> Int ! io, alloc
    clang_obj(c_path, o_path)

fn obj_list_prefix(obj_list: String) -> String ! alloc
    if str_len(obj_list) > 0
        obj_list + " "
    else
        obj_list

fn emit_c_compile_graph_go(graph: Graph, i: Int, n: Int, root_key: String, proot: String, out_path: String, obj_list: String, genums: List[TEnum], env: TEnv) -> Int ! io, alloc
    if i >= n
        lrc = call_link_objs(obj_list, out_path)
        if lrc == 0
            result_ok_str(d"")
        else
            result_err_str(d"link failed")
    else
        is_root = str_eq(mod_key_at(graph, i), root_key)
        allow_main = is_root
        cstep = callable_fn_names(graph, i, proot)
        if result_is_err(cstep) == 1
            cstep
        else
            callables = result_unwrap(cstep)
            externs = extern_fn_arity(graph, i, callables)
            ccode = emit_c_from_ast_module(list_get(graph.progs, i), callables, externs, allow_main, 1, genums, env)
            cpath = tmp_path("m" + int_to_str(i) + ".c")
            opath = tmp_path("m" + int_to_str(i) + ".o")
            _w = write_file(cpath, ccode)
            if call_clang_obj(cpath, opath) != 0
                result_err_str(d"clang_obj failed")
            else
                prefix = obj_list_prefix(obj_list)
                objs2 = prefix + opath
                emit_c_compile_graph_go(graph, i + 1, n, root_key, proot, out_path, objs2, genums, env)

fn emit_c_compile_graph(order: Graph, root_key: String, out_path: String, proot: String) -> Int ! io, alloc
    env = tenv_for_graph(order)
    genums = graph_enums_t(order)
    r = emit_c_compile_graph_go(order, 0, list_len(order.mods), root_key, proot, out_path, d"", genums, env)
    _h = list_free(genums)
    _f = tenv_free(env)
    _g = list_free(env.structs)
    r

fn emit_c(src: String) -> Int ! alloc
    emit_c_from_prog_result(src)

# ---- IR -> C (functions that touch tensors) ----
# Context: [pool, user, locals, consts, floats, strs, lines, quirk_out, quirk_n, uid, is_main]
fn cc_new(pool: Int, user: Int, is_main: Int) -> Int ! alloc
    c = vec_new()
    _a = vec_push(c, pool)
    _b = vec_push(c, user)
    _c = vec_push(c, vec_new())
    _d = vec_push(c, map_new())
    _e = vec_push(c, map_new())
    _f = vec_push(c, map_new())
    _g = vec_push(c, vec_new())
    _h = vec_push(c, 0)
    _i = vec_push(c, 0)
    _j = vec_push(c, 0)
    _k = vec_push(c, is_main)
    c

fn cc_line(cc: Int, s: String) -> Int ! alloc
    vec_push(vec_get(cc, 6), str_as_int(s))

fn cc_uid(cc: Int) -> Int ! alloc
    n = vec_get(cc, 9) + 1
    _s = vec_set(cc, 9, n)
    n

fn cir_is_num(s: String) -> Int ! alloc
    if str_len(s) == 0
        0
    else
        c = str_char(s, 0)
        if c >= 48
            if c <= 57
                1
            else
                0
        elsif c == 45
            if str_len(s) > 1
                1
            else
                0
        else
            0

# An IR operand as a C int64 expression.
fn cir_op(cc: Int, a: Int) -> String ! alloc
    s = str_from_int(a)
    if str_len(s) == 0
        d"0"
    elsif str_char(s, 0) == 34
        inner = str_slice(s, 1, str_len(s) - 1)
        ensure_sal_lit(str_as_int(inner), vec_get(cc, 0))
    elsif cir_is_num(s) == 1
        s + "LL"
    elsif names_has(vec_get(cc, 2), a, 0, vec_len(vec_get(cc, 2))) == 1
        s
    else
        d"0"

fn cir_ops(cc: Int, args: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, str_as_int(cir_op(cc, vec_get(args, i))))
        cir_ops(cc, args, i + 1, n, out)

# Static value of an operand when it is a literal or a known constant.
fn cir_const(cc: Int, a: Int) -> Int ! alloc
    s = str_from_int(a)
    if cir_is_num(s) == 1
        tt_dim_val(a)
    else
        map_get(vec_get(cc, 3), a)

fn cir_decl(cc: Int, name: String) -> Int ! alloc
    cc_line(cc, "  extern int64_t R_" + name + "() __asm__(\"" + name + "\");\n")

# Calls the runtime function `name` (symbol aliased to R_<name> so it never
# clashes with the prototypes in the prelude).
fn cir_rt(cc: Int, name: String, ops: Int) -> String ! alloc
    _d = cir_decl(cc, name)
    acc = "R_" + name + "("
    join_commas(ops, 0, vec_len(ops), acc) + ")"

fn cir_set(cc: Int, dest: Int, rhs: String) -> Int ! alloc
    cc_line(cc, "  " + str_from_int(dest) + " = " + rhs + ";\n")

# Tensor buffers: a 16-byte header holds the element count before the data.
fn cir_tn_alloc(n: String) -> String ! alloc
    "((int64_t)(uintptr_t)sal_tn_alloc(" + n + "))"

# A handle for an operand text that outlives the typed IR (0 for the empty text).
fn ih(s: String) -> Int ! alloc
    if str_len(s) == 0
        0
    else
        str_as_int(strdup(s))

fn ih_vec(xs: List[String], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, ih(list_get(xs, i)))
        ih_vec(xs, i + 1, n, out)

fn cir_call(cc: Int, inst: Inst) -> Int ! alloc
    dest = ih(inst.dest)
    fname = inst.s1
    args = ih_vec(inst.strs, 0, list_len(inst.strs), vec_new())
    ops = cir_ops(cc, args, 0, vec_len(args), vec_new())
    if inst.n1 == 0
        cir_call_free(cc, fname, ops)
    elsif cir_shaped_call(fname, inst.n2) == 1
        cir_shaped(cc, inst.dest, fname, ops, inst.n2)
    else
        cir_call_dest(cc, dest, fname, args, ops)

# Calls that carry a tensor shape (`ir_call_shaped`): the shape handle is non-zero.
fn cir_shaped_call(fname: String, shape: Int) -> Int ! alloc
    if shape == 0
        0
    elsif str_eq(fname, d"sal_softmax_axis_f32") == 1
        1
    elsif str_eq(fname, d"sal_reduce") == 1
        1
    elsif str_eq(fname, d"sal_relu") == 1
        1
    else
        0

fn cir_shaped(cc: Int, dest: String, fname: String, ops: Int, shape: Int) -> Int ! alloc
    if str_eq(fname, d"sal_softmax_axis_f32") == 1
        cir_softmax_axis(cc, dest, ops, shape)
    elsif str_eq(fname, d"sal_relu") == 1
        cir_relu(cc, dest, ops, shape)
    else
        cir_reduce(cc, dest, ops, shape)

# `relu` of a buffer whose shape is not known at compile time panics, as the bootstrap does.
fn cir_relu(cc: Int, dest: String, ops: Int, shape: Int) -> Int ! alloc
    input = cir_arg(ops, 0)
    if vec_get(shape, 0) < 0
        _p = cc_line(cc, "  { extern void sal_panic(const char *); sal_panic(\"tensor op needs a shape known at compile time\"); }\n")
        cir_set(cc, str_as_int(dest), d"0")
    else
        n = "sal_tn_len(" + input + ")"
        _a = cc_line(cc, "  " + dest + " = " + cir_tn_alloc(n) + ";\n")
        _b = cc_line(cc, "  " + cir_call_expr(cc, d"sal_relu_f32", cir_vec3(dest, input, n)) + ";\n")
        0

# `softmax` over the last axis of a matrix, in place: the kernel takes (rows, row length). Unknown
# shapes are one row of the whole buffer (the bootstrap leaves them to the length of the input).
fn cir_softmax_axis(cc: Int, dest: String, ops: Int, shape: Int) -> Int ! alloc
    input = cir_arg(ops, 0)
    rows = vec_get(shape, 0)
    cols = vec_get(shape, 1)
    _x = cc_line(cc, "  extern void sal_softmax_axis_f32(float *, int64_t, int64_t);\n")
    if rows < 0
        _y = cc_line(cc, "  sal_softmax_axis_f32((float *)(uintptr_t)" + input + ", 1, sal_tn_len(" + input + "));\n")
    else
        _y = cc_line(cc, "  sal_softmax_axis_f32((float *)(uintptr_t)" + input + ", " + int_to_str(rows) + ", " + int_to_str(cols) + ");\n")
    cir_set(cc, str_as_int(dest), input)

# `reduce` of a matrix along an axis (`(outer, axis_len, inner)` as the bootstrap computes it);
# the result is a fresh buffer of `outer * inner` floats. A shape or axis that does not fit is taken as
# the whole buffer (one row).
fn cir_reduce(cc: Int, dest: String, ops: Int, shape: Int) -> Int ! alloc
    input = cir_arg(ops, 0)
    rows = vec_get(shape, 0)
    cols = vec_get(shape, 1)
    axis = vec_get(shape, 2)
    outer = 1
    alen = sal_tn_len_text(input)
    inner = 1
    if rows < 0
        _z = 0
    elsif axis == 0 - 1
        alen = int_to_str(rows * cols)
    elsif axis == 0
        alen = int_to_str(rows)
        inner = cols
    elsif axis == 1
        outer = rows
        alen = int_to_str(cols)
    else
        _z = 0
    _x = cc_line(cc, "  extern void sal_reduce_strided_f32(const float *, float *, int64_t, int64_t, int64_t);\n")
    _y = cc_line(cc, "  " + dest + " = (int64_t)(uintptr_t)sal_tn_alloc(" + int_to_str(outer * inner) + ");\n")
    cc_line(cc, "  sal_reduce_strided_f32((const float *)(uintptr_t)" + input + ", (float *)(uintptr_t)" + dest + ", " + int_to_str(outer) + ", " + alen + ", " + int_to_str(inner) + ");\n")

fn sal_tn_len_text(input: String) -> String ! alloc
    "sal_tn_len(" + input + ")"

fn cir_call_free(cc: Int, fname: String, ops: Int) -> Int ! alloc
    cc_line(cc, "  " + cir_call_expr(cc, fname, ops) + ";\n")

fn cir_call_expr(cc: Int, fname: String, ops: Int) -> String ! alloc
    if names_has(vec_get(cc, 1), str_as_int(fname), 0, vec_len(vec_get(cc, 1))) == 1
        acc = mangled(fname) + "("
        join_commas(ops, 0, vec_len(ops), acc) + ")"
    else
        cir_rt(cc, fname, ops)

fn cir_arg(ops: Int, i: Int) -> String ! alloc
    arg_at(ops, i)

fn cir_call_dest(cc: Int, dest: Int, fname: String, args: Int, ops: Int) -> Int ! alloc
    d = str_from_int(dest)
    if names_has(vec_get(cc, 1), str_as_int(fname), 0, vec_len(vec_get(cc, 1))) == 1
        _a = cir_set(cc, dest, cir_call_expr(cc, fname, ops))
        _b = map_put(vec_get(cc, 5), dest, 0)
        0
    elsif str_eq(fname, d"sal_matmul_f32") == 1
        cir_matmul(cc, dest, args, ops)
    elsif str_eq(fname, d"sal_rope") == 1
        argv = vec_new()
        _p0 = vec_push(argv, str_as_int(cir_arg(ops, 0)))
        _p1 = vec_push(argv, str_as_int(cir_arg(ops, 1)))
        _p2 = vec_push(argv, str_as_int(cir_arg(ops, 2)))
        _p3 = vec_push(argv, str_as_int(cir_arg(ops, 3)))
        _b = cc_line(cc, "  " + cir_rt(cc, d"sal_rope_f32", argv) + ";\n")
        cir_set(cc, dest, cir_arg(ops, 0))
    else
        cir_call_dest2(cc, dest, fname, args, ops)

fn cir_call_dest2(cc: Int, dest: Int, fname: String, args: Int, ops: Int) -> Int ! alloc
    d = str_from_int(dest)
    if str_eq(fname, d"sal_silu") == 1
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, "  " + d + " = " + cir_tn_alloc(n) + ";\n")
        _b = cc_line(cc, "  " + cir_call_expr(cc, d"sal_silu_f32", cir_vec3(d, cir_arg(ops, 0), n)) + ";\n")
        0
    elsif str_eq(fname, d"sal_relu") == 1
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, "  " + d + " = " + cir_tn_alloc(n) + ";\n")
        _b = cc_line(cc, "  " + cir_call_expr(cc, d"sal_relu_f32", cir_vec3(d, cir_arg(ops, 0), n)) + ";\n")
        0
    elsif str_eq(fname, d"sal_rms_norm") == 1
        # The epsilon is the bootstrap's literal (1e-5), passed as a double.
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, "  " + d + " = " + cir_tn_alloc(n) + ";\n")
        _b = cc_line(cc, "  extern void sal_rms_norm_f32(float *, const float *, const float *, int64_t, double);\n")
        _c = cc_line(cc, "  sal_rms_norm_f32((float *)(uintptr_t)" + d + ", (const float *)(uintptr_t)" + cir_arg(ops, 0) + ", (const float *)(uintptr_t)" + cir_arg(ops, 1) + ", " + n + ", 1e-5);\n")
        0
    elsif str_eq(fname, d"sal_transpose_f32") == 1
        n = "(" + cir_arg(ops, 1) + " * " + cir_arg(ops, 2) + ")"
        _a = cc_line(cc, "  " + d + " = " + cir_tn_alloc(n) + ";\n")
        v4 = cir_vec3(d, cir_arg(ops, 0), cir_arg(ops, 1))
        _v = vec_push(v4, str_as_int(cir_arg(ops, 2)))
        _b = cc_line(cc, "  " + cir_call_expr(cc, d"sal_transpose_f32", v4) + ";\n")
        0
    elsif str_eq(fname, d"sal_softmax") == 1
        n = "sal_tn_len(" + cir_arg(ops, 0) + ")"
        _a = cc_line(cc, "  " + cir_call_expr(cc, d"sal_softmax_f32", cir_vec2(cir_arg(ops, 0), n)) + ";\n")
        cir_set(cc, dest, cir_arg(ops, 0))
    elsif str_eq(fname, d"sal_argmax") == 1
        cir_set(cc, dest, cir_call_expr(cc, d"sal_argmax_axis_f32", cir_vec2(cir_arg(ops, 0), cir_arg(ops, 1))))
    elsif str_eq(fname, d"sal_attention_f32") == 1
        cir_attention(cc, dest, ops)
    elsif str_eq(fname, d"sal_load") == 1
        _a = cc_line(cc, "  { int64_t __n = 0; int64_t __b = " + cir_rt(cc, d"sal_load_f32", cir_vec2(cir_arg(ops, 0), d"(int64_t)&__n")) + "; " + d + " = (int64_t)(uintptr_t)sal_tn_from(__b, __n); }\n")
        0
    elsif cir_is_stub(fname) == 1
        cir_set(cc, dest, d"0")
    elsif str_eq(fname, d"sal_print") == 1
        cir_print(cc, dest, args, ops)
    elsif str_eq(fname, d"sal_syscall") == 1
        cir_set(cc, dest, cir_rt(cc, d"sal_os_syscall", cir_pad7(ops)))
    elsif str_eq(fname, d"sal_bytes_get_u8") == 1
        cir_set(cc, dest, emit_c_bytes_get(ops, 1))
    elsif str_eq(fname, d"sal_bytes_get_u16") == 1
        cir_set(cc, dest, emit_c_bytes_get(ops, 2))
    elsif str_eq(fname, d"sal_bytes_get_u32") == 1
        cir_set(cc, dest, emit_c_bytes_get(ops, 4))
    elsif str_eq(fname, d"sal_bytes_get_i64") == 1
        cir_set(cc, dest, emit_c_bytes_get(ops, 8))
    elsif str_eq(fname, d"sal_bytes_set_u8") == 1
        cir_set(cc, dest, emit_c_bytes_set(ops, 1))
    elsif str_eq(fname, d"sal_bytes_set_u16") == 1
        cir_set(cc, dest, emit_c_bytes_set(ops, 2))
    elsif str_eq(fname, d"sal_bytes_set_u32") == 1
        cir_set(cc, dest, emit_c_bytes_set(ops, 4))
    elsif str_eq(fname, d"sal_bytes_set_i64") == 1
        cir_set(cc, dest, emit_c_bytes_set(ops, 8))
    else
        cir_set(cc, dest, "(int64_t)" + cir_rt(cc, fname, ops))

fn cir_vec2(a: String, b: String) -> Int ! alloc
    v = vec_new()
    _a = vec_push(v, str_as_int(a))
    _b = vec_push(v, str_as_int(b))
    v

fn cir_vec3(a: String, b: String, c: String) -> Int ! alloc
    v = cir_vec2(a, b)
    _c = vec_push(v, str_as_int(c))
    v

fn cir_pad7(ops: Int) -> Int ! alloc
    v = vec_copy(ops)
    _z = pad_args(v, 7)
    v

# `print` of a value known to be a String prints text, otherwise the integer.
fn cir_print(cc: Int, dest: Int, args: Int, ops: Int) -> Int ! alloc
    if vec_len(args) > 0
        if map_get(vec_get(cc, 5), vec_get(args, 0)) == 1
            cir_set(cc, dest, "(int64_t)" + cir_rt(cc, d"sal_print_str", ops))
        else
            cir_set(cc, dest, "(int64_t)" + cir_rt(cc, d"sal_print_i64", ops))
    else
        cir_set(cc, dest, d"0")

fn cir_matmul(cc: Int, dest: Int, args: Int, ops: Int) -> Int ! alloc
    d = str_from_int(dest)
    m = cir_arg(ops, 2)
    k = cir_arg(ops, 3)
    n = cir_arg(ops, 4)
    _a = cc_line(cc, "  " + d + " = " + cir_tn_alloc("(" + m + ") * (" + n + ")") + ";\n")
    argv = vec_new()
    _p0 = vec_push(argv, str_as_int(cir_arg(ops, 0)))
    _p1 = vec_push(argv, str_as_int(cir_arg(ops, 1)))
    _p2 = vec_push(argv, str_as_int(d))
    _p3 = vec_push(argv, str_as_int(m))
    _p4 = vec_push(argv, str_as_int(k))
    _p5 = vec_push(argv, str_as_int(n))
    _b = cc_line(cc, "  " + cir_rt(cc, d"sal_matmul_f32", argv) + ";\n")
    mv = cir_const(cc, vec_get(args, 2))
    nv = cir_const(cc, vec_get(args, 4))
    if mv > 0
        if nv > 0
            if mv * nv <= 16
                _q = vec_set(cc, 7, dest)
                vec_set(cc, 8, mv * nv)
            else
                0
        else
            0
    else
        0

fn cir_attention(cc: Int, dest: Int, ops: Int) -> Int ! alloc
    d = str_from_int(dest)
    n = "(" + cir_arg(ops, 3) + ") * (" + cir_arg(ops, 4) + ") * (" + cir_arg(ops, 6) + ")"
    _a = cc_line(cc, "  " + d + " = " + cir_tn_alloc(n) + ";\n")
    argv = vec_new()
    _p0 = vec_push(argv, str_as_int(d))
    _p1 = vec_push(argv, str_as_int(cir_arg(ops, 0)))
    _p2 = vec_push(argv, str_as_int(cir_arg(ops, 1)))
    _p3 = vec_push(argv, str_as_int(cir_arg(ops, 2)))
    _p4 = vec_push(argv, str_as_int(cir_arg(ops, 3)))
    _p5 = vec_push(argv, str_as_int(cir_arg(ops, 4)))
    _p6 = vec_push(argv, str_as_int(cir_arg(ops, 5)))
    _p7 = vec_push(argv, str_as_int(cir_arg(ops, 6)))
    _p8 = vec_push(argv, str_as_int(cir_arg(ops, 7)))
    guard = "(" + cir_arg(ops, 0) + ") && (" + cir_arg(ops, 1) + ") && (" + cir_arg(ops, 2) + ")"
    cc_line(cc, "  if (" + guard + ") " + cir_rt(cc, d"sal_attention_f32", argv) + ";\n")

fn cir_tbin(cc: Int, inst: Inst) -> Int ! alloc
    dest = ih(inst.dest)
    op = inst.s1
    d = inst.dest
    len = cir_op(cc, ih(inst.s5))
    left = cir_op(cc, ih(inst.s3))
    right = cir_op(cc, ih(inst.s4))
    scalar = inst.n2
    sval = d"0"
    rarg = right
    if scalar == 1
        sval = cir_float_text(cc, ih(inst.s4))
        rarg = d"0"
    code = cir_tbin_code(op)
    is_cmp = cir_tbin_is_cmp(op)
    elem_sz = select_str(is_cmp, d"1", d"4")
    _a = cc_line(cc, "  " + d + " = (int64_t)(uintptr_t)sal_tn_alloc_bytes(" + len + ", " + elem_sz + ");\n")
    argv = vec_new()
    _p0 = vec_push(argv, str_as_int(int_to_str(code)))
    _p1 = vec_push(argv, str_as_int(strdup(d)))
    _p2 = vec_push(argv, str_as_int(left))
    _p3 = vec_push(argv, str_as_int(rarg))
    _p4 = vec_push(argv, str_as_int(len))
    _p5 = vec_push(argv, str_as_int(int_to_str(scalar)))
    _p6 = vec_push(argv, str_as_int(sval))
    fn_name = select_str(is_cmp, d"sal_tensor_cmp_f32", d"sal_tensor_bin_f32")
    cc_line(cc, "  " + cir_rt_dbl(cc, fn_name, argv) + ";\n")

# The scalar operand is a double; it goes through a typed prototype.
fn cir_rt_dbl(cc: Int, name: String, ops: Int) -> String ! alloc
    _d = cc_line(cc, "  extern void R_" + name + "(int, void *, void *, void *, int64_t, int, double) __asm__(\"" + name + "\");\n")
    "R_" + name + "((int)" + arg_at(ops, 0) + ", (void *)(uintptr_t)" + arg_at(ops, 1) + ", (void *)(uintptr_t)" + arg_at(ops, 2) + ", (void *)(uintptr_t)" + arg_at(ops, 3) + ", " + arg_at(ops, 4) + ", " + arg_at(ops, 5) + ", " + arg_at(ops, 6) + ")"

fn cir_float_text(cc: Int, a: Int) -> String ! alloc
    t = map_get(vec_get(cc, 4), a)
    if t != 0
        str_from_int(t)
    else
        c = map_get(vec_get(cc, 3), a)
        int_to_str(c)

# `neg` over a tensor: the runtime kernel writes a fresh buffer of `len` floats.
fn cir_tun(cc: Int, inst: Inst) -> Int ! alloc
    d = inst.dest
    input = cir_op(cc, ih(inst.s3))
    len = cir_op(cc, ih(inst.s5))
    _a = cc_line(cc, "  " + d + " = (int64_t)(uintptr_t)sal_tn_alloc(" + len + ");\n")
    _b = cc_line(cc, "  extern void sal_tensor_neg_f32(float *, const float *, int64_t);\n")
    cc_line(cc, "  sal_tensor_neg_f32((float *)(uintptr_t)" + d + ", (const float *)(uintptr_t)" + input + ", " + len + ");\n")

fn cir_tbin_code(op: String) -> Int ! alloc
    if str_eq(op, d"add") == 1
        0
    elsif str_eq(op, d"sub") == 1
        1
    elsif str_eq(op, d"mul") == 1
        2
    elsif str_eq(op, d"div") == 1
        3
    elsif str_eq(op, d"eq") == 1
        4
    elsif str_eq(op, d"ne") == 1
        5
    elsif str_eq(op, d"lt") == 1
        6
    elsif str_eq(op, d"le") == 1
        7
    elsif str_eq(op, d"gt") == 1
        8
    elsif str_eq(op, d"ge") == 1
        9
    else
        0

fn cir_tbin_is_cmp(op: String) -> Int ! alloc
    if cir_tbin_code(op) >= 4
        1
    else
        0

fn cir_insts(cc: Int, insts: List[Inst], i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        _x = cir_inst(cc, list_get(insts, idx))
        idx = idx + 1
    0

fn cir_inst(cc: Int, inst: Inst) -> Int ! alloc
    k = inst.kind
    dest = ih(inst.dest)
    if k == II_CI()
        _m = map_put(vec_get(cc, 3), dest, inst.n1)
        cir_set(cc, dest, int_to_str(inst.n1))
    elsif k == II_CS()
        _m = map_put(vec_get(cc, 5), dest, 1)
        cir_set(cc, dest, ensure_sal_lit(str_as_int(strdup(inst.s1)), vec_get(cc, 0)))
    elsif k == II_CF()
        _m = map_put(vec_get(cc, 4), dest, str_as_int(strdup(inst.s1)))
        cir_set(cc, dest, d"0")
    elsif k == II_BIN()
        cir_binary(cc, dest, inst.s1, cir_op(cc, ih(inst.s2)), cir_op(cc, ih(inst.s3)))
    elsif k == II_CALL()
        cir_call(cc, inst)
    elsif k == II_TBIN()
        cir_tbin(cc, inst)
    elsif k == II_TUN()
        cir_tun(cc, inst)
    elsif k == II_REBIND()
        cir_set(cc, dest, cir_op(cc, ih(inst.s1)))
    elsif k == II_PLACE()
        cir_set(cc, dest, "(int64_t)(uintptr_t)sal_tn_copy(" + cir_op(cc, ih(inst.s1)) + ")")
    elsif k == II_DROP()
        0
    elsif k == II_RET()
        cir_ret(cc, ih(inst.s1))
    elsif k == II_IF()
        cir_if(cc, inst)
    elsif k == II_WHILE()
        cir_while(cc, inst)
    elsif k == II_AGG()
        cir_agg(cc, inst)
    elsif k == II_EXTRACT()
        cir_set(cc, dest, "((int64_t *)(uintptr_t)(" + cir_op(cc, ih(inst.s1)) + "))[" + int_to_str(inst.n1) + "]")
    elsif k == II_ANYBOX()
        cir_anybox(cc, dest, inst)
    elsif k == II_ANYCALL()
        cir_anycall(cc, dest, inst)
    else
        0

fn cir_anybox(cc: Int, dest: Int, inst: Inst) -> Int ! alloc
    vt = "(int64_t)(uintptr_t)" + inst.s1
    pl = cir_op(cc, ih(inst.s2))
    expr = "sal_any_box(" + vt + ", " + int_to_str(inst.n1) + ", " + pl + ")"
    cir_set(cc, dest, expr)

fn cir_anycall(cc: Int, dest: Int, inst: Inst) -> Int ! alloc
    recv = cir_op(cc, ih(inst.s1))
    argc = list_len(inst.strs)
    args = ih_vec(inst.strs, 0, argc, vec_new())
    ops = cir_ops(cc, args, 0, vec_len(args), vec_new())
    a0 = cir_arg(ops, 0)
    a1 = cir_arg(ops, 1)
    a2 = cir_arg(ops, 2)
    a3 = cir_arg(ops, 3)
    expr = "sal_any_call(" + recv + ", " + int_to_str(inst.n1) + ", " + int_to_str(argc) + ", " + a0 + ", " + a1 + ", " + a2 + ", " + a3 + ")"
    if dest == 0
        cc_line(cc, "  " + expr + ";\n")
    else
        cir_set(cc, dest, expr)

fn cir_agg(cc: Int, inst: Inst) -> Int ! alloc
    fields = ih_vec(inst.strs, 0, list_len(inst.strs), vec_new())
    ops = cir_ops(cc, fields, 0, vec_len(fields), vec_new())
    cir_set(cc, ih(inst.dest), emit_c_struct_ctor(ops))

fn cir_ret(cc: Int, v: Int) -> Int ! alloc
    q = vec_get(cc, 7)
    val = cir_op(cc, v)
    if q != 0
        if vec_get(cc, 10) == 1
            out = str_from_int(q)
            val = "({ double __s = 0; float *__o = (float *)(uintptr_t)" + out + "; for (int __i = 0; __i < " + int_to_str(vec_get(cc, 8)) + "; __i++) __s += __o[__i]; (int64_t)__s; })"
    if vec_get(cc, 10) == 1
        cc_line(cc, "  return (int)(" + val + ");\n")
    else
        cc_line(cc, "  return " + val + ";\n")

fn cir_if(cc: Int, inst: Inst) -> Int ! alloc
    dest = ih(inst.dest)
    _a = cc_line(cc, "  if (" + cir_op(cc, ih(inst.s1)) + ") {\n")
    _b = cir_insts(cc, inst.b1, 0, list_len(inst.b1))
    _c = cir_if_assign(cc, dest, ih(inst.s2))
    _d = cir_carry_assign(cc, inst.rows, 0, 1)
    _e = cc_line(cc, "  } else {\n")
    _f = cir_insts(cc, inst.b2, 0, list_len(inst.b2))
    _g = cir_if_assign(cc, dest, ih(inst.s3))
    _h = cir_carry_assign(cc, inst.rows, 0, 2)
    cc_line(cc, "  }\n")

fn cir_if_assign(cc: Int, dest: Int, val: Int) -> Int ! alloc
    if dest == 0
        0
    elsif val == 0
        0
    else
        cir_set(cc, dest, cir_op(cc, val))

# Carried values: `which` selects the then (1) or else (2) source slot.
fn cir_carry_assign(cc: Int, carried: List[Inst], i: Int, which: Int) -> Int ! alloc
    idx = i
    n = list_len(carried)
    while idx < n
        c = list_get(carried, idx)
        src = select_str(which == 1, c.s1, c.s2)
        _x = cir_set(cc, ih(c.dest), cir_op(cc, ih(src)))
        idx = idx + 1
    0

fn cir_while(cc: Int, inst: Inst) -> Int ! alloc
    _a = cir_carry_assign(cc, inst.rows, 0, 1)
    _b = cc_line(cc, "  while (1) {\n")
    _c = cir_insts(cc, inst.b1, 0, list_len(inst.b1))
    _d = cc_line(cc, "  if (!(" + cir_op(cc, ih(inst.s1)) + ")) break;\n")
    _e = cir_insts(cc, inst.b2, 0, list_len(inst.b2))
    _f = cir_carry_assign(cc, inst.rows, 0, 2)
    cc_line(cc, "  }\n")

# ---- locals ----
fn cir_add_local(cc: Int, name: Int) -> Int ! alloc
    if name == 0
        0
    elsif names_has(vec_get(cc, 2), name, 0, vec_len(vec_get(cc, 2))) == 1
        0
    else
        vec_push(vec_get(cc, 2), name)

fn cir_collect(cc: Int, insts: List[Inst]) -> Int ! alloc
    idx = 0
    n = list_len(insts)
    while idx < n
        inst = list_get(insts, idx)
        k = inst.kind
        if k == II_IF()
            _a = cir_add_local(cc, ih(inst.dest))
            _b = cir_collect(cc, inst.b1)
            _c = cir_collect(cc, inst.b2)
            _d = cir_collect_carried(cc, inst.rows)
        elsif k == II_WHILE()
            _e = cir_collect(cc, inst.b1)
            _f = cir_collect(cc, inst.b2)
            _g = cir_collect_carried(cc, inst.rows)
        elsif k == II_RET()
            _h = 0
        elsif k == II_DROP()
            _h = 0
        elsif k == II_CALL()
            if inst.n1 == 1
                _i = cir_add_local(cc, ih(inst.dest))
        else
            _j = cir_add_local(cc, ih(inst.dest))
        idx = idx + 1
    0

fn cir_collect_carried(cc: Int, carried: List[Inst]) -> Int ! alloc
    idx = 0
    n = list_len(carried)
    while idx < n
        c = list_get(carried, idx)
        _x = cir_add_local(cc, ih(c.dest))
        idx = idx + 1
    0

fn cir_decl_locals(cc: Int, params: Int, acc: String) -> String ! alloc
    names = vec_get(cc, 2)
    idx = 0
    n = vec_len(names)
    out = acc
    while idx < n
        nm = vec_get(names, idx)
        if names_has(params, nm, 0, vec_len(params)) == 0
            out = out + "  int64_t " + str_from_int(nm) + " = 0;\n"
        idx = idx + 1
    out

# An IR function `[name, dim_params, insts, regions]` as C; params come from the AST fn.
fn cir_fn(f: TFn, irf: IrFn, user: Int, linkable: Int, allow_main: Int, pool: Int) -> String ! alloc
    header = emit_c_fn_header(f, linkable, allow_main)
    if str_len(header) == 0
        d""
    else
        pnames = tparam_names(f.params, 0, list_len(f.params), vec_new())
        is_main = select_main(f, allow_main)
        cc = cc_new(pool, user, is_main)
        _p = cir_seed_params(cc, pnames, 0, vec_len(pnames))
        _c = cir_collect(cc, irf.insts)
        _c2 = cir_collect_lits(cc, irf.lits)
        _l = cir_literals(cc, irf.lits, 0, list_len(irf.lits))
        _r = cir_insts(cc, irf.insts, 0, list_len(irf.insts))
        acc = cir_decl_locals(cc, pnames, header)
        lines = vec_get(cc, 6)
        acc = append_stmt_strings(acc, lines, 0, vec_len(lines))
        acc + "  return 0;\n}\n\n"

fn select_main(f: TFn, allow_main: Int) -> Int ! alloc
    if allow_main == 1
        str_eq(f.name, d"main")
    else
        0

fn cir_seed_params(cc: Int, pnames: Int, i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        _x = cir_add_local(cc, vec_get(pnames, idx))
        idx = idx + 1
    0

# Scalar IR with `any` boxing or dispatch uses the same C backend as tensors.
fn cir_use_ir_path(insts: List[Inst]) -> Int ! alloc
    if cir_is_tensor_fn(insts) == 1
        1
    else
        cir_has_any_insts(insts, 0, list_len(insts))

fn cir_has_any_insts(insts: List[Inst], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        inst = list_get(insts, i)
        k = inst.kind
        if k == II_ANYBOX()
            1
        elsif k == II_ANYCALL()
            1
        elsif k == II_IF()
            if cir_has_any_insts(inst.b1, 0, list_len(inst.b1)) == 1
                1
            else
                cir_has_any_insts(inst.b2, 0, list_len(inst.b2))
        elsif k == II_WHILE()
            if cir_has_any_insts(inst.b1, 0, list_len(inst.b1)) == 1
                1
            else
                cir_has_any_insts(inst.b2, 0, list_len(inst.b2))
        else
            cir_has_any_insts(insts, i + 1, n)

# A function goes through the IR path when it uses tensors.
fn cir_is_tensor_fn(insts: List[Inst]) -> Int ! alloc
    idx = 0
    n = list_len(insts)
    found = 0
    while idx < n
        inst = list_get(insts, idx)
        k = inst.kind
        if k == II_TBIN()
            found = 1
        elsif k == II_TUN()
            found = 1
        elsif k == II_REBIND()
            found = 1
        elsif k == II_PLACE()
            found = 1
        elsif k == II_CALL()
            if cir_tensor_call(inst.s1) == 1
                found = 1
        elsif k == II_IF()
            if cir_is_tensor_fn(inst.b1) + cir_is_tensor_fn(inst.b2) > 0
                found = 1
        elsif k == II_WHILE()
            if cir_is_tensor_fn(inst.b1) + cir_is_tensor_fn(inst.b2) > 0
                found = 1
        idx = idx + 1
    found

fn cir_tensor_call(f: String) -> Int ! alloc
    if str_eq(f, d"sal_load") == 1
        1
    elsif str_eq(f, d"sal_matmul_f32") == 1
        1
    elsif str_eq(f, d"sal_rope") == 1
        1
    elsif str_eq(f, d"sal_silu") == 1
        1
    elsif str_eq(f, d"sal_relu") == 1
        1
    elsif str_eq(f, d"sal_rms_norm") == 1
        1
    elsif str_eq(f, d"sal_softmax") == 1
        1
    elsif str_eq(f, d"sal_argmax") == 1
        1
    elsif str_eq(f, d"sal_transpose_f32") == 1
        1
    elsif str_eq(f, d"sal_attention_f32") == 1
        1
    else
        0

fn cir_collect_lits(cc: Int, lits: List[Lit]) -> Int ! alloc
    idx = 0
    n = list_len(lits)
    while idx < n
        l = list_get(lits, idx)
        _x = cir_add_local(cc, ih(l.name))
        idx = idx + 1
    0

# Literal tensors are allocated up front, in source order.
fn cir_literals(cc: Int, lits: List[Lit], i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        lit = list_get(lits, idx)
        acc = "  " + lit.name + " = (int64_t)(uintptr_t)sal_tn_alloc(" + int_to_str(list_len(lit.data)) + ");\n"
        _a = cc_line(cc, acc)
        _b = cir_lit_cells(cc, lit.name, lit.data, 0, list_len(lit.data))
        idx = idx + 1
    0

fn cir_lit_cells(cc: Int, name: String, data: List[String], i: Int, n: Int) -> Int ! alloc
    idx = i
    while idx < n
        _x = cc_line(cc, "  ((float *)(uintptr_t)" + name + ")[" + int_to_str(idx) + "] = " + list_get(data, idx) + "f;\n")
        idx = idx + 1
    0

# List/tensor ops the bootstrap backend leaves as no-ops (the value is 0).
fn cir_is_stub(f: String) -> Int ! alloc
    if str_eq(f, d"sal_index") == 1
        1
    elsif str_eq(f, d"sal_map") == 1
        1
    elsif str_eq(f, d"sal_relu") == 1
        1
    elsif str_eq(f, d"sal_where") == 1
        1
    else
        0

# Struct scope-end field releases (espejo de `emit_struct_drops` en fuse.sal).
fn emit_c_struct_scope_frees(tf: TFn, body: TBlock, denv: Int, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    md = vec_get(denv, 1)
    fr = fr_new(tc.env, tc.enums, md)
    _w = fr_blk(fr, body)
    moved = vec_new()
    _m = mv_block(body, moved, md)
    cands = vec_new()
    _c = drop_candidates_env(tc.env, tf.params, fn_modes_of(md, tf.name), 0, tenv_len(tc.env), cands)
    emit_c_drop_struct_locals(cands, moved, fr, user, stmts, tc, 0, vec_len(cands))

fn emit_c_drop_struct_locals(cands: Int, moved: Int, fr: FRC, user: Int, stmts: Int, tc: Tc, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = vec_get(cands, i)
        if assigned_has(moved, nm, 0, vec_len(moved)) == 0
            if assigned_has(fr.al, nm, 0, vec_len(fr.al)) == 0
                local = str_from_int(nm)
                ty = tenv_type(tc.env, local)
                si = tt_struct_find(tc.env.structs, ty)
                if si >= 0
                    g = drop_glue_bits(fr, nm)
                    sd = list_get(tc.env.structs, si)
                    _f = emit_c_drop_fields(local, sd, sd.fields, 0, list_len(sd.fields), g, fr, local, d"", user, stmts, tc, 0)
        emit_c_drop_struct_locals(cands, moved, fr, user, stmts, tc, i + 1, n)

fn emit_c_drop_fields(local: String, sd: TStruct borrow, fields: List[TField], i: Int, n: Int, g: Int, fr: FRC, root: String, path_p: String, user: Int, stmts: Int, tc: Tc, depth: Int) -> Int ! alloc
    if i >= n
        0
    else
        fld = list_get(fields, i)
        path = if str_len(path_p) == 0
            fld.name
        else
            path_p + d"." + fld.name
        taint = fr_ct_has(fr, root, path)
        fnm = drop_field_fn(tc.env.structs, tc.enums, fld.ty, g, depth, taint)
        if str_len(fnm) == 0
            _z = 0
        elsif str_eq(fnm, "sal_free") == 1
            if fr_sm_has(fr, root, path) == 1
                _z = 0
            else
                _p = emit_c_drop_call(local, fld.name, fnm, user, stmts, tc)
        elsif str_eq(fnm, "sal_enum_free") == 1
            if fr_sm_has(fr, root, path) == 1
                _z = 0
            else
                _p = emit_c_drop_call(local, fld.name, fnm, user, stmts, tc)
        elsif str_eq(fnm, "struct") == 1
            _n = emit_c_drop_nested(local, fld, sd, i, g, fr, root, path, user, stmts, tc, depth)
        else
            _p = emit_c_drop_call(local, fld.name, fnm, user, stmts, tc)
        emit_c_drop_fields(local, sd, fields, i + 1, n, g, fr, root, path_p, user, stmts, tc, depth)

fn emit_c_drop_call(local: String, field: String, fnm: String, user: Int, stmts: Int, tc: Tc) -> Int ! alloc
    base = XIdent(strdup(local))
    slot = emit_c_field(base, field, user, stmts, tc)
    vec_push(stmts, str_as_int("  " + fnm + "((void*)(uintptr_t)" + slot + ");\n"))

fn emit_c_drop_nested(local: String, fld: TField, sd: TStruct borrow, idx: Int, g: Int, fr: FRC, root: String, path: String, user: Int, stmts: Int, tc: Tc, depth: Int) -> Int ! alloc
    inner = list_get(tc.env.structs, tt_struct_find(tc.env.structs, trim_type_piece(fld.ty)))
    base = XIdent(strdup(local))
    slot = emit_c_field(base, fld.name, user, stmts, tc)
    emit_c_drop_fields(local, inner, inner.fields, 0, list_len(inner.fields), g, fr, root, path, user, stmts, tc, depth + 1)

# Integer ops are C operators; `f`-prefixed ops (Float) go through `sal_fop`.
fn cir_binary(cc: Int, dest: Int, op: String, l: String, r: String) -> Int ! alloc
    if str_char(op, 0) == 102
        cir_set(cc, dest, "sal_fop(" + int_to_str(float_op_code(str_slice(op, 1, str_len(op)))) + ", " + l + ", " + r + ")")
    else
        cir_set(cc, dest, "(" + l + " " + cmap_op(op) + " " + r + ")")
