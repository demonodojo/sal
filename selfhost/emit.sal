# Emission: IR text and C.
import result
import lexer
import ast
import parser
import ir
import fuse
import modules
import qualify
import cache
import checks
import tshape

fn resolve_module_graph_qualified(source_path: String, proot: String) -> Int ! io, alloc
    g = resolve_module_graph(source_path, proot)
    if result_is_err(g) == 1
        g
    else
        order = result_payload(g)
        qualify_module_graph(order, proot)

# ---- ir_to_text ----
fn qquote() -> String ! alloc
    char_to_str(34)

fn ir_q() -> String ! alloc
    char_to_str(34)

fn emit_escape_arg(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 34
            bs = d"\\"
            a2 = acc + bs
            # free(bs)
            piece = char_to_str(34)
            a3 = a2 + piece
            # free(piece)
            emit_escape_arg(s, i + 1, n, a3)
        elsif c == 92
            bs = d"\\\\"
            a2 = acc + bs
            # free(bs)
            emit_escape_arg(s, i + 1, n, a2)
        else
            piece = char_to_str(c)
            a2 = acc + piece
            # free(piece)
            emit_escape_arg(s, i + 1, n, a2)

fn emit_arg_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn emit_arg_list(args: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_arg_comma(i)
        acc = acc + comma
        acc = acc + ir_q()
        a = vec_get(args, i)
        esc = emit_escape_arg(str_from_int(a), 0, str_len(str_from_int(a)), d"")
        acc = acc + esc
        acc = acc + ir_q()
        emit_arg_list(args, i + 1, n, acc)

fn emit_inst(inst: Int) -> String ! alloc
    k = vec_get(inst, 0)
    if k == II_CI()
        emit_ci(inst)
    elsif k == II_CS()
        emit_cs(inst)
    elsif k == II_BIN()
        emit_bin(inst)
    elsif k == II_CF()
        emit_cf(inst)
    elsif k == II_TBIN()
        emit_tbin(inst)
    elsif k == II_CALL()
        emit_call(inst)
    elsif k == II_PLACE()
        emit_place(inst)
    elsif k == II_RET()
        emit_ret(inst)
    elsif k == II_DROP()
        emit_drop(inst)
    elsif k == II_IF()
        emit_if_inst(inst)
    elsif k == II_WHILE()
        emit_while_inst(inst)
    elsif k == II_AGG()
        emit_agg(inst)
    elsif k == II_EXTRACT()
        emit_extract(inst)
    elsif k == II_REBIND()
        emit_rebind(inst)
    else
        d""

fn emit_ci(inst: Int) -> String ! alloc
    dest = str_from_int(vec_get(inst, 1))
    vs = int_to_str(vec_get(inst, 2))
    "  ConstInt {{ dest: " + ir_q() + dest + ir_q() + ", value: " + vs + " }}\n"

fn emit_cs(inst: Int) -> String ! alloc
    "  ConstString {{ dest: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + ", value: " + ir_q() + ir_debug_escape(vec_get(inst, 2)) + ir_q() + " }}\n"

fn emit_bin(inst: Int) -> String ! alloc
    "  Binary {{ dest: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + ", op: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", left: " + ir_q() + str_from_int(vec_get(inst, 3)) + ir_q() + ", right: " + ir_q() + str_from_int(vec_get(inst, 4)) + ir_q() + " }}\n"

fn emit_cf(inst: Int) -> String ! alloc
    dest = str_from_int(vec_get(inst, 1))
    txt = str_from_int(vec_get(inst, 3))
    "  ConstFloat {{ dest: " + ir_q() + dest + ir_q() + ", value: " + txt + " }}\n"

fn emit_elem_name(code: Int) -> String ! alloc
    if code == 1
        d"I8"
    elsif code == 2
        d"F16"
    elsif code == 3
        d"BF16"
    else
        d"F32"

fn emit_tbin_scalar(scalar: Int) -> String ! alloc
    if scalar == 1
        d"true"
    else
        d"false"

fn emit_tbin(inst: Int) -> String ! alloc
    dest = str_from_int(vec_get(inst, 1))
    op = str_from_int(vec_get(inst, 2))
    elem = emit_elem_name(vec_get(inst, 3))
    place = str_from_int(vec_get(inst, 4))
    left = str_from_int(vec_get(inst, 5))
    right = str_from_int(vec_get(inst, 6))
    len = str_from_int(vec_get(inst, 7))
    sc = emit_tbin_scalar(vec_get(inst, 8))
    "  TensorBin {{ dest: " + ir_q() + dest + ir_q() + ", op: " + ir_q() + op + ir_q() + ", elem: " + elem + ", place: " + ir_q() + place + ir_q() + ", left: " + ir_q() + left + ir_q() + ", right: " + ir_q() + right + ir_q() + ", len: " + ir_q() + len + ir_q() + ", right_scalar: " + sc + " }}\n"

fn emit_call_dest(inst: Int) -> String ! alloc
    if vec_get(inst, 4) == 1
        "Some(" + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + ")"
    else
        d"None"

fn emit_call(inst: Int) -> String ! alloc
    destbit = emit_call_dest(inst)
    args = vec_get(inst, 3)
    pref = "  Call {{ dest: " + destbit + ", func: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", args: ["
    acc = emit_arg_list(args, 0, vec_len(args), pref)
    acc + "] }}\n"

fn emit_place(inst: Int) -> String ! alloc
    "  PlaceCopy {{ dest: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + ", from: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", to_place: " + ir_q() + str_from_int(vec_get(inst, 3)) + ir_q() + " }}\n"

fn emit_ret(inst: Int) -> String ! alloc
    "  Return {{ value: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + " }}\n"

fn emit_drop(inst: Int) -> String ! alloc
    "  Drop {{ name: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + " }}\n"

fn emit_if_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn trim_nl(piece: String) -> String ! alloc
    ln = str_len(piece)
    if ln > 0
        if str_char(piece, ln - 1) == 10
            str_slice(piece, 0, ln - 1)
        else
            piece
    else
        piece

fn emit_if_body(body: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_if_comma(i)
        acc = acc + comma
        piece = emit_inst(vec_get(body, i))
        piece2 = trim_nl(piece)
        piece3 = strip_spaces(piece2)
        acc = acc + piece3
        emit_if_body(body, i + 1, n, acc)

fn strip_spaces(s: String) -> String ! alloc
    n = str_len(s)
    i = 0
    strip_spaces_go(s, 0, n)

fn strip_spaces_go(s: String, i: Int, n: Int) -> String ! alloc
    if i >= n
        d""
    elsif str_char(s, i) == 32
        strip_spaces_go(s, i + 1, n)
    else
        str_slice(s, i, n)

fn emit_if_inst(inst: Int) -> String ! alloc
    tb = vec_get(inst, 3)
    eb = vec_get(inst, 4)
    acc = "  If {{ cond: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", then_body: ["
    acc = emit_if_body(tb, 0, vec_len(tb), acc)
    acc = acc + "], else_body: ["
    acc = emit_if_body(eb, 0, vec_len(eb), acc)
    acc = acc + "], then_val: "
    acc = acc + ir_q()
    acc = acc + str_from_int(vec_get(inst, 5))
    acc = acc + ir_q()
    acc = acc + ", else_val: "
    acc = acc + ir_q()
    acc = acc + str_from_int(vec_get(inst, 6))
    acc = acc + ir_q()
    acc = acc + ", dest: "
    acc = acc + ir_q()
    acc = acc + str_from_int(vec_get(inst, 1))
    acc = acc + ir_q()
    carried = vec_get(inst, 7)
    if vec_len(carried) > 0
        acc = acc + ", carried: ["
        acc = emit_carries(carried, 0, vec_len(carried), acc)
        acc = acc + "]"
    acc + " }}\n"

fn emit_rebind(inst: Int) -> String ! alloc
    "  TensorRebind {{ dest: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + ", src: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + " }}\n"

fn emit_extract(inst: Int) -> String ! alloc
    "  Extract {{ dest: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q() + ", base: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", struct_name: " + ir_q() + str_from_int(vec_get(inst, 3)) + ir_q() + ", field_index: " + int_to_str(vec_get(inst, 4)) + " }}\n"

fn emit_agg(inst: Int) -> String ! alloc
    fields = vec_get(inst, 3)
    acc = "  Aggregate {{ dest: " + ir_q() + str_from_int(vec_get(inst, 1)) + ir_q()
    acc = acc + ", struct_name: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", fields: ["
    acc = emit_arg_list(fields, 0, vec_len(fields), acc)
    acc + "] }}\n"

fn emit_while_inst(inst: Int) -> String ! alloc
    ci = vec_get(inst, 1)
    bd = vec_get(inst, 3)
    acc = "  While {{ cond_insts: ["
    acc = emit_if_body(ci, 0, vec_len(ci), acc)
    acc = acc + "], cond: " + ir_q() + str_from_int(vec_get(inst, 2)) + ir_q() + ", body: ["
    acc = emit_if_body(bd, 0, vec_len(bd), acc)
    acc = acc + "]"
    carried = vec_get(inst, 4)
    if vec_len(carried) > 0
        acc = acc + ", carried: ["
        acc = emit_while_carries(carried, 0, vec_len(carried), acc)
        acc = acc + "]"
    acc + " }}\n"

fn emit_while_carries(cs: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = vec_get(cs, i)
        acc = acc + emit_if_comma(i)
        acc = acc + "WhileCarry {{ dest: " + ir_q() + str_from_int(vec_get(c, 0)) + ir_q()
        acc = acc + ", incoming: " + ir_q() + str_from_int(vec_get(c, 1)) + ir_q()
        acc = acc + ", updated: " + ir_q() + str_from_int(vec_get(c, 2)) + ir_q() + " }}"
        emit_while_carries(cs, i + 1, n, acc)

fn emit_carries(cs: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = vec_get(cs, i)
        acc = acc + emit_if_comma(i)
        acc = acc + "IfCarry {{ dest: " + ir_q() + str_from_int(vec_get(c, 0)) + ir_q()
        acc = acc + ", then_val: " + ir_q() + str_from_int(vec_get(c, 1)) + ir_q()
        acc = acc + ", else_val: " + ir_q() + str_from_int(vec_get(c, 2)) + ir_q() + " }}"
        emit_carries(cs, i + 1, n, acc)

fn emit_fused_word(fused: Int) -> String ! alloc
    select_str(fused == 1, d"true", d"false")

fn emit_peak_bytes(r: Int) -> String ! alloc
    has_peak = vec_get(r, 3)
    place = vec_get(r, 0)
    peak = vec_get(r, 5)
    if has_peak == 1
        "{{\"" + str_from_int(place) + "\": " + int_to_str(peak) + "}}"
    else
        d"{{}}"

fn emit_peak_sym(r: Int) -> String ! alloc
    has_sym = vec_get(r, 4)
    place = vec_get(r, 0)
    peak_sym = vec_get(r, 6)
    if has_sym == 1
        " peak_symbolic={{\"" + str_from_int(place) + "\": \"" + str_from_int(peak_sym) + "\"}}"
    else
        d""

fn emit_region(r: Int) -> String ! alloc
    place = vec_get(r, 0)
    fused = vec_get(r, 2)
    fw = emit_fused_word(fused)
    pb = emit_peak_bytes(r)
    ps = emit_peak_sym(r)
    acc = "  region on " + str_from_int(place) + " fused=" + fw + " peak_bytes=" + pb + ps + "\n"
    ops = vec_get(r, 1)
    emit_region_ops(ops, 0, vec_len(ops), acc)

fn emit_op_matmul(op: Int) -> String ! alloc
    "    Matmul {{ lhs: " + ir_q() + str_from_int(vec_get(op, 1)) + ir_q() + ", rhs: " + ir_q() + str_from_int(vec_get(op, 2)) + ir_q() + ", dest: " + ir_q() + str_from_int(vec_get(op, 3)) + ir_q() + " }}\n"

fn emit_op_epilogue(op: Int) -> String ! alloc
    "    MapEpilogue {{ op: " + ir_q() + str_from_int(vec_get(op, 1)) + ir_q() + ", input: " + ir_q() + str_from_int(vec_get(op, 2)) + ir_q() + ", dest: " + ir_q() + str_from_int(vec_get(op, 3)) + ir_q() + " }}  # fused epilogue, no intermediate buffer\n"

fn emit_op_softmax(op: Int) -> String ! alloc
    "    Softmax {{ input: " + ir_q() + str_from_int(vec_get(op, 1)) + ir_q() + ", dest: " + ir_q() + str_from_int(vec_get(op, 3)) + ir_q() + " }}\n"

fn emit_column_scalar(op: Int) -> String ! alloc
    if vec_len(op) > 5
        scalar = vec_get(op, 5)
        if scalar == 0
            d"None"
        else
            d"Some(" + ir_q() + str_from_int(scalar) + ir_q() + ")"
    else
        opn = str_from_int(vec_get(op, 1))
        if str_eq(opn, d"mul") == 1
            rhs = str_from_int(vec_get(op, 3))
            if str_eq(rhs, d"tmp") == 1
                d"Some(" + ir_q() + d"tmp" + ir_q() + ")"
            else
                d"None"
        else
            d"None"

fn emit_op_column(op: Int) -> String ! alloc
    sc = emit_column_scalar(op)
    "    ColumnBin {{ op: " + ir_q() + str_from_int(vec_get(op, 1)) + ir_q() + ", left: " + ir_q() + str_from_int(vec_get(op, 2)) + ir_q() + ", right: " + ir_q() + str_from_int(vec_get(op, 3)) + ir_q() + ", dest: " + ir_q() + str_from_int(vec_get(op, 4)) + ir_q() + ", scalar: " + sc + " }}\n"

fn emit_one_op(op: Int) -> String ! alloc
    k = vec_get(op, 0)
    if k == FO_MATMUL()
        emit_op_matmul(op)
    elsif k == FO_EPILOGUE()
        emit_op_epilogue(op)
    elsif k == FO_SOFTMAX()
        emit_op_softmax(op)
    elsif k == FO_COLUMN()
        emit_op_column(op)
    else
        d""

fn emit_region_ops(ops: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_one_op(vec_get(ops, i))
        acc2 = acc + piece
        emit_region_ops(ops, i + 1, n, acc2)

fn emit_dim_comma(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn emit_dim_params(dps: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = emit_dim_comma(i)
        acc = acc + comma
        q = qquote()
        acc = acc + q
        acc = acc + str_from_int(vec_get(dps, i))
        acc = acc + q
        emit_dim_params(dps, i + 1, n, acc)

fn emit_dim_section(dps: Int) -> String ! alloc
    if vec_len(dps) > 0
        acc = d"  dim_params=["
        acc = emit_dim_params(dps, 0, vec_len(dps), acc)
        acc = acc + "]\n"
        acc
    else
        d""

fn emit_fn(irf: Int) -> String ! alloc
    name = vec_get(irf, 0)
    dps = vec_get(irf, 1)
    insts = vec_get(irf, 2)
    regions = vec_get(irf, 3)
    dims = emit_dim_section(dps)
    acc = "fn " + str_from_int(name) + ":\n" + dims
    acc = emit_insts(insts, 0, vec_len(insts), acc)
    emit_regions(regions, 0, vec_len(regions), acc)

fn emit_insts(insts: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_inst(vec_get(insts, i))
        acc = acc + piece
        # free(piece)
        emit_insts(insts, i + 1, n, acc)

fn emit_regions(regions: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_region(vec_get(regions, i))
        acc = acc + piece
        # free(piece)
        emit_regions(regions, i + 1, n, acc)

fn ir_to_text(mod: Int) -> String ! alloc
    emit_fns(mod, 0, vec_len(mod), d"")

fn emit_fns(mod: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        piece = emit_fn(vec_get(mod, i))
        acc = acc + piece
        # free(piece)
        emit_fns(mod, i + 1, n, acc)

fn emit_ir_from_prog(prog: Int) -> String ! alloc
    emit_ir_from_prog_with_extra(prog, vec_new())

fn emit_ir_from_prog_with_extra(prog: Int, extra: Int) -> String ! alloc
    ir = lower_program_with_callables(prog, extra)
    ir_to_text(ir)

fn emit_ir_from_prog_with_types(prog: Int, extra: Int, types: Int) -> String ! alloc
    ir = lower_program_with_types(prog, extra, graph_types_structs(types), graph_types_fnrets(types))
    ir_to_text(ir)

# Types visible across the module graph: `[fnrets, structs]`, the mirror of the
# bootstrap's StringEnv::from_module_graph.
fn graph_types(order: Int) -> Int ! alloc
    n = vec_len(order)
    fr = graph_fnrets(order, 0, n, map_new())
    sm = graph_structs(order, 0, n, vec_new())
    v = vec_new()
    _a = vec_push(v, fr)
    _b = vec_push(v, sm)
    v

fn graph_types_fnrets(types: Int) -> Int ! alloc
    vec_get(types, 0)

fn graph_types_structs(types: Int) -> Int ! alloc
    vec_get(types, 1)

fn graph_fnrets(order: Int, i: Int, n: Int, m: Int) -> Int ! alloc
    if i >= n
        m
    else
        fns = prog_fns(mod_prog(vec_get(order, i)))
        _f = fnret_map_fill(m, fns, 0, vec_len(fns))
        graph_fnrets(order, i + 1, n, m)

fn graph_structs(order: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        sts = prog_structs(mod_prog(vec_get(order, i)))
        _p = vec_push_all(out, sts, 0, vec_len(sts))
        graph_structs(order, i + 1, n, out)

fn vec_push_all(dst: Int, src: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        dst
    else
        _p = vec_push(dst, vec_get(src, i))
        vec_push_all(dst, src, i + 1, n)

fn dep_fn_names(order: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        m = vec_get(order, i)
        out2 = append_fn_names_from_prog(mod_prog(m), out)
        dep_fn_names(order, i + 1, n, out2)

fn emit_ir_from_graph(order_in: Int, source_path: String) -> Int ! alloc
    _p = source_path
    order = module_order_vec(order_in)
    n = vec_len(order)
    extra = vec_new()
    if n > 1
        extra = dep_fn_names(order, 0, n - 1, extra)
    else
        extra = extra
    root_prog = graph_root_prog(order_in)
    result_ok_str(emit_ir_from_prog_with_types(root_prog, extra, graph_types(order)))

fn emit_ir_from_path(source_path: String) -> Int ! io, alloc
    proot = project_root()
    g = resolve_module_graph_qualified(source_path, proot)
    if result_is_err(g) == 1
        g
    else
        emit_ir_from_graph(result_payload(g), source_path)

fn emit_ir_single_file(src: String) -> Int ! io, alloc
    pre = preprocess(src)
    parsed = parse_program(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        prog = result_unwrap(parsed)
        dir = cache_dir()
        _m = cache_mkdir(dir)
        key = source_hash(pre)
        irpath = cache_ir_path_raw(dir, key)
        metapath = cache_meta_path_raw(dir, key)
        cached = read_file(irpath)
        if str_len(cached) > 0
            _w = write_file(metapath, d"hit=1\n")
            result_ok_str(cached)
        else
            ir0 = emit_ir_from_prog(prog)
            _w0 = write_file(irpath, ir0)
            _w1 = write_file(metapath, d"hit=0\n")
            result_ok_str(ir0)

fn emit_ir_imported_file(source_path: String, src: String) -> Int ! io, alloc
    dir = cache_dir()
    _m = cache_mkdir(dir)
    g = resolve_module_graph_qualified(source_path, project_root())
    if result_is_err(g) == 1
        g
    else
        key = cache_key_for_graph_path(src, source_path)
        irpath = cache_ir_path_raw(dir, key)
        metapath = cache_meta_path_raw(dir, key)
        cached = read_file(irpath)
        if str_len(cached) > 0
            _w = write_file(metapath, d"hit=1\n")
            result_ok_str(cached)
        else
            ir1 = emit_ir_from_graph(result_payload(g), source_path)
            if result_is_err(ir1) == 1
                ir1
            else
                body = str_from_int(result_unwrap(ir1))
                _w2 = write_file(irpath, body)
                _w3 = write_file(metapath, d"hit=0\n")
                result_ok_str(body)

fn emit_ir_for_file(source_path: String, src: String) -> Int ! io, alloc
    if str_len(source_path) > 0
        if str_contains(src, d"import") == 1
            emit_ir_imported_file(source_path, src)
        else
            emit_ir_single_file(src)
    else
        emit_ir_single_file(src)

fn emit_ir(src: String) -> Int ! io, alloc
    emit_ir_for_file(d"", src)

# Parse, then reject a fn that uses an effect its signature does not declare.
fn parse_checked(pre: String) -> Int ! alloc
    parsed = parse_program(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        checked = check_program(result_unwrap(parsed))
        if result_is_err(checked) == 1
            checked
        else
            parsed

fn emit_c_from_prog_result(src: String) -> Int ! alloc
    pre = preprocess(src)
    parsed = parse_checked(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        prog = result_unwrap(parsed)
        result_ok_str(emit_c_from_ast(prog))

fn emit_c_for_file(source_path: String, src: String, out_path: String) -> Int ! io, alloc
    pre = preprocess(src)
    parsed = parse_checked(pre)
    if result_is_err(parsed) == 1
        parsed
    else
        prog = result_unwrap(parsed)
        if str_len(source_path) == 0
            result_ok_str(emit_c_from_ast(prog))
        elsif vec_len(prog_imports(prog)) == 0
            ccode = emit_c_from_ast(prog)
            cpath = tmp_path("out.c")
            _w = write_file(cpath, ccode)
            if clang(cpath, out_path) == 0
                result_ok_str(d"")
            else
                result_err_str(d"clang failed")
        else
            emit_c_from_path(source_path, out_path)

fn emit_c_from_path(source_path: String, out_path: String) -> Int ! io, alloc
    proot = project_root()
    g = resolve_module_graph_qualified(source_path, proot)
    if result_is_err(g) == 1
        g
    else
        graph = result_payload(g)
        chk = check_all_modules(graph, proot)
        if result_is_err(chk) == 1
            chk
        else
            root_key = graph_root_key(graph)
            emit_c_compile_graph(graph, root_key, out_path, proot)

# Rust `{:?}` escaping of a string body (quotes are added by the caller).
fn ir_debug_escape(h: Int) -> String ! alloc
    s = str_from_int(h)
    ir_debug_escape_go(s, 0, str_len(s), d"")

fn ir_debug_escape_go(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 92
            acc = acc + "\\\\"
        elsif c == 34
            acc = acc + "\\\""
        elsif c == 10
            acc = acc + "\\n"
        elsif c == 9
            acc = acc + "\\t"
        elsif c == 13
            acc = acc + "\\r"
        elsif c == 0
            acc = acc + "\\0"
        else
            acc = acc + char_to_str(c)
        ir_debug_escape_go(s, i + 1, n, acc)

# ---- emit_c (AST → C) ----
fn mangled(name: String) -> String ! alloc
    "fn_" + name

fn c_escape_go(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 92
            acc = acc + "\\\\"
            c_escape_go(s, i + 1, n, acc)
        elsif c == 34
            acc = acc + "\\\""
            c_escape_go(s, i + 1, n, acc)
        elsif c == 10
            acc = acc + "\\n"
            c_escape_go(s, i + 1, n, acc)
        elsif c == 9
            acc = acc + "\\t"
            c_escape_go(s, i + 1, n, acc)
        elsif c == 13
            acc = acc + "\\r"
            c_escape_go(s, i + 1, n, acc)
        elsif c < 32
            acc = acc + c_octal(c)
            c_escape_go(s, i + 1, n, acc)
        elsif c >= 127
            acc = acc + c_octal(c)
            c_escape_go(s, i + 1, n, acc)
        else
            piece = char_to_str(c)
            acc = acc + piece
            # free(piece)
            c_escape_go(s, i + 1, n, acc)

# Always three digits, so a following digit character can't extend the escape.
fn c_octal(c: Int) -> String ! alloc
    "\\" + int_to_str(c / 64) + int_to_str((c / 8) % 8) + int_to_str(c % 8)

fn c_escape_str(s: String) -> String ! alloc
    acc = d"\""
    if str_len(s) == 0
        acc + "\""
    else
        acc2 = c_escape_go(s, 0, str_len(s), acc)
        acc2 + "\""

fn c_string_init(s: String) -> String ! alloc
    if str_len(s) == 0
        d"\"\""
    else
        acc = d"\""
        acc2 = c_escape_go(s, 0, str_len(s), acc)
        acc2 + "\""

fn lit_pool_new() -> Int ! alloc
    v = vec_new()
    _a = vec_push(v, str_as_int(d""))
    _b = vec_push(v, vec_new())
    _c = vec_push(v, vec_new())
    _d = vec_push(v, 0)
    _e = vec_push(v, 0)
    _f = vec_push(v, 0)
    _g = vec_push(v, map_new())
    _h = vec_push(v, map_new())
    _i = vec_push(v, map_new())
    v

# Variant name -> (tag + 1) * 2 + nullary, as `EnumMake` tags them: `index + 1`,
# except a payload-free first variant, which is 0.
fn lit_pool_variants(pool: Int) -> Int ! alloc
    vec_get(pool, 6)

# Variant name -> its field types, for typing pattern bindings.
fn lit_pool_variant_fields(pool: Int) -> Int ! alloc
    vec_get(pool, 7)

fn variants_register(m: Int, ft: Int, enums: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        vs = vec_get(vec_get(enums, i), 1)
        _a = variants_register_go(m, ft, vec_get(vec_get(enums, i), 2), vs, 0, vec_len(vs))
        variants_register(m, ft, enums, i + 1, n)

fn variants_register_go(m: Int, ft: Int, params: Int, vs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = vec_get(vs, i)
        nullary = if vec_len(vec_get(v, 1)) == 0
            1
        else
            0
        tag = if nullary == 1
            if i == 0
                0
            else
                i + 1
        else
            i + 1
        _p = map_put(m, vec_get(v, 0), (tag + 1) * 2 + nullary)
        entry = vec_new()
        _q1 = vec_push(entry, v)
        _q2 = vec_push(entry, params)
        _q = map_put(ft, vec_get(v, 0), entry)
        variants_register_go(m, ft, params, vs, i + 1, n)

fn variant_code(tc: Int, name: Int) -> Int ! alloc
    map_get(lit_pool_variants(tc_lit_pool(tc)), name)

fn variant_tag(code: Int) -> Int ! alloc
    code / 2 - 1

# Program-wide typing the C backend needs: fn return types and struct defs.
fn lit_pool_set_types(pool: Int, fnrets: Int, structs: Int) -> Int ! alloc
    _a = vec_set(pool, 4, fnrets)
    _b = vec_set(pool, 5, structs)
    0

fn lit_pool_fnrets(pool: Int) -> Int ! alloc
    vec_get(pool, 4)

fn lit_pool_structs(pool: Int) -> Int ! alloc
    vec_get(pool, 5)

fn lit_pool_globals(pool: Int) -> String ! alloc
    str_from_int(vec_get(pool, 0))

fn lit_pool_find(s: Int, texts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_eq(vec_get(texts, i), s) == 1
        i
    else
        lit_pool_find(s, texts, i + 1, n)

fn sal_lit_decl_n(s: String, name: String, n: Int) -> String ! alloc
    init = select_str(str_len(s) == 0, d"\"\"", c_string_init(s))
    arr = n + 1
    acc = d"static const struct {{ int64_t cap; int64_t len; char b["
    acc = acc + int_to_str(arr)
    acc = acc + "]; }} __attribute__((aligned(16))) "
    acc = acc + name
    acc = acc + " = {{ 0, "
    acc = acc + int_to_str(n)
    acc = acc + ", "
    acc = acc + init
    acc + " }};\n"

fn sal_lit_decl(s: String, name: String) -> String ! alloc
    if str_len(s) == 0
        sal_lit_decl_n(s, name, 0)
    else
        sal_lit_decl_n(s, name, str_len(s))

fn ensure_sal_lit(s: Int, pool: Int) -> String ! alloc
    texts = vec_get(pool, 1)
    idx = lit_pool_find(s, texts, 0, vec_len(texts))
    if idx >= 0
        sym = vec_get(vec_get(pool, 2), idx)
        "((int64_t)(uintptr_t)" + str_from_int(sym) + ".b)"
    else
        nid = vec_get(pool, 3) + 1
        _u = vec_set(pool, 3, nid)
        decl = sal_lit_decl(str_from_int(s), "sal_lit_" + int_to_str(nid))
        gacc = lit_pool_globals(pool)
        _g = vec_set(pool, 0, str_as_int(gacc + decl))
        _t = vec_push(texts, s)
        _sy = vec_push(vec_get(pool, 2), str_as_int("sal_lit_" + int_to_str(nid)))
        cast = "((int64_t)(uintptr_t)" + "sal_lit_" + int_to_str(nid)
        cast + ".b)"

fn runtime_decls() -> String ! alloc
    d"#include <stdint.h>\n#include <stdlib.h>\nvoid sal_runtime_init(int64_t argc, const char **argv);\nchar *sal_argv(int64_t i);\nchar *sal_read_file(const char *path);\nint64_t sal_write_file(const char *path, const char *data);\nint64_t sal_print_str(const char *data);\nint64_t sal_eprint_str(const char *data);\nchar *sal_getenv(const char *name);\nint64_t sal_mkdir_p(const char *path);\nint64_t sal_str_eq(const char *a, const char *b);\nint64_t sal_str_contains(const char *a, const char *b);\nint64_t sal_str_len(const char *s);\nchar *sal_str_concat(const char *a, const char *b);\nchar *sal_str_append(char *a, const char *b);\nchar *sal_strdup(const char *s);\nchar *sal_select_str(int64_t cond, char *a, char *b);\nvoid sal_free(void *p);\nint64_t sal_not(int64_t x);\nint64_t sal_gated_print_str(int64_t cond, const char *data);\nchar *sal_tmp_path(const char *suffix);\nint64_t sal_clang(const char *c_path, const char *out_path);\nint64_t sal_path_readable(const char *path);\nchar *sal_realpath(const char *p);\nint64_t sal_clang_obj(const char *c_path, const char *obj_path);\nint64_t sal_link_objs(const char *objs, const char *out_path);\nchar *sal_char_to_str(int64_t c);\nchar *sal_int_to_str(int64_t v);\nchar *sal_str_slice(const char *s, int64_t start, int64_t end);\nint64_t sal_str_char(const char *s, int64_t i);\nint64_t sal_str_skip(const char *s, int64_t i, int64_t kind, int64_t limit);\nint64_t sal_str_hash(const char *s, int64_t seed);\nint64_t sal_str_to_f64_bits(const char *s);\nvoid *sal_map_new(void);\nint64_t sal_map_get(void *m, const char *key);\nint64_t sal_map_put(void *m, const char *key, int64_t val);\nchar *sal_ir_text(void *mod);\nvoid *sal_lex_src(const char *src);\nvoid *sal_vec_new(void);\nint64_t sal_vec_push(void *v, int64_t x);\nint64_t sal_vec_get(void *v, int64_t i);\nint64_t sal_vec_set(void *v, int64_t i, int64_t x);\nint64_t sal_vec_len(void *v);\nvoid sal_vec_free(void *v);\nint64_t sal_enum_new(int64_t tag, int64_t n);\nint64_t sal_enum_set(int64_t v, int64_t i, int64_t x);\nint64_t sal_enum_tag(int64_t v);\nint64_t sal_enum_field(int64_t v, int64_t i);\nvoid sal_list_free(void *v);\nvoid sal_dict_free(void *v);\nvoid sal_enum_free(int64_t v);\nvoid sal_bytes_free(void *v);\nint64_t sal_print_i64(int64_t v);\nint64_t sal_place_matmul_ai_sum(int64_t place);\nint64_t sal_place_launches(int64_t place);\nvoid sal_on_enter(int64_t place);\nvoid *sal_image_new(int64_t w, int64_t h);\nint64_t sal_write_png(const char *path, int64_t w, int64_t h, void *rgb);\nvoid *sal_place_malloc(int64_t nbytes, int32_t place);\nint64_t sal_mask_select_count(const int8_t *mask, int64_t len);\nvoid sal_tensor_select_f32(float *out, const float *in, const int8_t *mask, int64_t len);\nvoid sal_tensor_select_i8(int8_t *out, const int8_t *in, const int8_t *mask, int64_t len);\nvoid *sal_list_select(void *in_list, const int8_t *mask, int64_t len);\nstatic int64_t sal_tn_len(int64_t p) {{ return ((int64_t *)(uintptr_t)p)[-2]; }}\nstatic float *sal_tn_alloc_bytes(int64_t n, int64_t esz) {{ int64_t *b = (int64_t *)sal_place_malloc(n * esz + 16, 0); b[0] = n; return (float *)(b + 2); }}\nstatic float *sal_tn_alloc(int64_t n) {{ return sal_tn_alloc_bytes(n, 4); }}\nstatic float *sal_tn_from(int64_t raw, int64_t n) {{ float *t = sal_tn_alloc(n); __builtin_memcpy(t, (void *)(uintptr_t)raw, (size_t)n * 4); return t; }}\nstatic float *sal_tn_copy(int64_t p) {{ if (!p) return 0; int64_t n = sal_tn_len(p); float *t = sal_tn_alloc(n); __builtin_memcpy(t, (void *)(uintptr_t)p, (size_t)n * 4); return t; }}\nstatic int64_t sal_fop(int64_t op, int64_t a, int64_t b) {{ double x, y, r; __builtin_memcpy(&x, &a, 8); __builtin_memcpy(&y, &b, 8); switch (op) {{ case 0: r = x + y; break; case 1: r = x - y; break; case 2: r = x * y; break; case 3: r = x / y; break; case 4: return x == y; case 5: return x != y; case 6: return x < y; case 7: return x <= y; case 8: return x > y; case 9: return x >= y; case 10: r = -x; break; case 11: return (int64_t)x; default: r = (double)a; }} int64_t o; __builtin_memcpy(&o, &r, 8); return o; }}\n\n"

fn user_fns_from_prog(prog: Int) -> Int ! alloc
    fns = prog_fns(prog)
    collect_fn_names(fns, 0, vec_len(fns), vec_new())

fn names_has(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        names_has(names, name, i + 1, n)

fn collect_assigns_block(b: Int, names: Int) -> Int ! alloc
    if b == 0
        0
    else
        stmts = block_stmts(b)
        _a = collect_assigns_stmts(stmts, 0, vec_len(stmts), names)
        collect_assigns_expr(block_tail(b), names)

fn collect_assigns_stmts(stmts: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(stmts, i)
        if vec_get(st, 0) == 1
            nm = vec_get(st, 1)
            if names_has(names, nm, 0, vec_len(names)) == 0
                _p = vec_push(names, nm)
            else
                _p = 0
        else
            _p = 0
        _c = collect_assigns_expr(vec_get(st, 2), names)
        collect_assigns_stmts(stmts, i + 1, n, names)

fn collect_assigns_expr(e: Int, names: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_IF()
            _a = collect_assigns_expr(vec_get(e, 1), names)
            _b = collect_assigns_block(vec_get(e, 2), names)
            _c = collect_assigns_arms(vec_get(e, 4), 0, vec_len(vec_get(e, 4)), names)
            collect_assigns_block(vec_get(e, 3), names)
        elsif k == EX_WHILE()
            _a = collect_assigns_expr(vec_get(e, 1), names)
            collect_assigns_block(vec_get(e, 2), names)
        elsif k == EX_BINARY()
            _a = collect_assigns_expr(vec_get(e, 2), names)
            collect_assigns_expr(vec_get(e, 3), names)
        elsif k == EX_CALL()
            args = vec_get(e, 2)
            collect_assigns_args(args, 0, vec_len(args), names)
        elsif k == EX_TO()
            collect_assigns_expr(vec_get(e, 2), names)
        elsif k == EX_ON()
            collect_assigns_block(vec_get(e, 2), names)
        else
            0

fn collect_assigns_arms(arms: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = vec_get(arms, i)
        _a = collect_assigns_expr(vec_get(arm, 0), names)
        _b = collect_assigns_block(vec_get(arm, 1), names)
        collect_assigns_arms(arms, i + 1, n, names)

fn collect_assigns_args(args: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = collect_assigns_expr(vec_get(args, i), names)
        collect_assigns_args(args, i + 1, n, names)

fn emit_decl_names(names: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + "  int64_t "
        acc = acc + str_from_int(vec_get(names, i))
        acc = acc + " = 0;\n"
        emit_decl_names(names, i + 1, n, acc)

fn tmp_counter_new(pool: Int) -> Int ! alloc
    v = vec_new()
    _p = vec_push(v, 0)
    senv = strenv_new()
    _g = strenv_set_globals(senv, lit_pool_fnrets(pool), lit_pool_structs(pool))
    _q = vec_push(v, senv)
    _r = vec_push(v, pool)
    _s = vec_push(v, 0)
    _m = vec_push(v, 0)
    _n = vec_push(v, 0)
    _l = vec_push(v, map_new())
    v

# Locals bound to a lambda (`f = x => body`): name -> lambda expression.
fn tc_lambdas(tc: Int) -> Int ! alloc
    vec_get(tc, 6)

fn tc_strenv(tc: Int) -> Int ! alloc
    vec_get(tc, 1)

fn tc_lit_pool(tc: Int) -> Int ! alloc
    vec_get(tc, 2)

# Name of the binding an `x = x + ...` chain accumulates into (0 when none).
fn tc_acc(tc: Int) -> Int ! alloc
    vec_get(tc, 3)

fn tc_set_acc(tc: Int, name: Int) -> Int ! alloc
    _s = vec_set(tc, 3, name)
    0

fn seed_string_params(params: Int, i: Int, n: Int, env: Int) -> Int ! alloc
    if i >= n
        0
    else
        pm = vec_get(params, i)
        _b = strenv_bind(env, vec_get(pm, 0), vec_get(pm, 1))
        seed_string_params(params, i + 1, n, env)

fn tmp_fresh(tc: Int) -> String ! alloc
    n = vec_get(tc, 0) + 1
    _s = vec_set(tc, 0, n)
    "__t" + int_to_str(n)

fn cmap_op(op: String) -> String ! alloc
    if str_eq(op, d"add") == 1
        "+"
    elsif str_eq(op, d"sub") == 1
        d"-"
    elsif str_eq(op, d"mul") == 1
        d"*"
    elsif str_eq(op, d"div") == 1
        d"/"
    elsif str_eq(op, d"eq") == 1
        d"=="
    elsif str_eq(op, d"ne") == 1
        d"!="
    elsif str_eq(op, d"lt") == 1
        d"<"
    elsif str_eq(op, d"le") == 1
        d"<="
    elsif str_eq(op, d"gt") == 1
        d">"
    elsif str_eq(op, d"ge") == 1
        d">="
    elsif str_eq(op, d"mod") == 1
        d"%"
    elsif str_eq(op, d"band") == 1
        d"&"
    elsif str_eq(op, d"bxor") == 1
        d"^"
    elsif str_eq(op, d"bor") == 1
        d"|"
    elsif str_eq(op, d"shl") == 1
        d"<<"
    elsif str_eq(op, d"shr") == 1
        d">>"
    else
        d"+"

fn emit_c_expr(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    if e == 0
        d"0"
    else
        k = ex_kind(e)
        if k == EX_INT()
            int_to_str(vec_get(e, 1)) + "LL"
        elsif k == EX_FLOAT()
            int_to_str(vec_get(e, 1)) + "LL"
        elsif k == EX_STRING()
            ensure_sal_lit(vec_get(e, 1), tc_lit_pool(tc))
        elsif k == EX_IDENT()
            emit_c_ident(e, tc)
        elsif k == EX_FIELD()
            emit_c_field(e, user, stmts, tc)
        elsif k == EX_BINARY()
            emit_c_binary(e, user, stmts, tc)
        elsif k == EX_CALL()
            emit_c_call(e, user, stmts, tc)
        elsif k == EX_TENSOR()
            emit_c_tensor_lit(e)
        elsif k == EX_ON()
            emit_c_on(e, user, stmts, tc)
        elsif k == EX_IF()
            emit_c_if(e, user, stmts, tc)
        elsif k == EX_WHILE()
            emit_c_while(e, user, stmts, tc)
        elsif k == EX_MATCH()
            emit_c_match(e, user, stmts, tc)
        elsif k == EX_TRY()
            emit_c_try(e, user, stmts, tc)
        elsif k == EX_BOOL()
            int_to_str(vec_get(e, 1))
        elsif k == EX_UNARY()
            inner = emit_c_expr(vec_get(e, 2), user, stmts, tc)
            if str_eq(vec_get(e, 1), "neg") == 1
                if expr_is_float(vec_get(e, 2), tc_strenv(tc)) == 1
                    "sal_fop(10, " + inner + ", 0LL)"
                else
                    "(-(" + inner + "))"
            else
                "(!(" + inner + "))"
        else
            d"0"

fn c_str_add_fname(e: Int, env: Int, into_acc: Int) -> String ! alloc
    if into_acc == 1
        d"str_append"
    elsif binary_add_uses_append(e, env) == 1
        d"str_append"
    else
        d"str_concat"

fn emit_c_str_add(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    # Only the left spine of the chain may see the accumulator.
    acc = tc_acc(tc)
    left = vec_get(e, 2)
    right = vec_get(e, 3)
    _s = tc_set_acc(tc, spine_acc(left, acc))
    l = emit_c_expr(left, user, stmts, tc)
    _z = tc_set_acc(tc, 0)
    r = emit_c_expr(right, user, stmts, tc)
    fname = c_str_add_fname(e, tc_strenv(tc), add_left_is_acc(left, acc))
    args = vec_new()
    free_left = 0
    if str_eq(fname, d"str_concat") == 1
        free_left = add_left_is_fresh_call(left)
    if free_left == 1
        # Materialize the left temp so it can be freed after the copy.
        lt = tmp_fresh(tc)
        _lp = vec_push(stmts, str_as_int("  int64_t " + lt + " = " + l + ";\n"))
        _a = vec_push(args, lt)
    else
        _a = vec_push(args, l)
    if add_right_is_fresh_temp(right, tc_strenv(tc)) == 1
        # Materialize the temp so it can be freed after the copy.
        rt = tmp_fresh(tc)
        _b = vec_push(args, rt)
        _p = vec_push(stmts, str_as_int("  int64_t " + rt + " = " + r + ";\n"))
        call = emit_c_builtin2(fname, args, stmts)
        dt = tmp_fresh(tc)
        _q = vec_push(stmts, str_as_int("  int64_t " + dt + " = " + call + ";\n"))
        _f = vec_push(stmts, str_as_int("  sal_free((void*)(uintptr_t)" + rt + ");\n"))
        if free_left == 1
            _fl = vec_push(stmts, str_as_int("  sal_free((void*)(uintptr_t)" + str_from_int(vec_get(args, 0)) + ");\n"))
        dt
    elsif free_left == 1
        _b = vec_push(args, r)
        call = emit_c_builtin2(fname, args, stmts)
        dt = tmp_fresh(tc)
        _q = vec_push(stmts, str_as_int("  int64_t " + dt + " = " + call + ";\n"))
        _fl = vec_push(stmts, str_as_int("  sal_free((void*)(uintptr_t)" + str_from_int(vec_get(args, 0)) + ");\n"))
        dt
    else
        _b = vec_push(args, r)
        emit_c_builtin2(fname, args, stmts)

fn emit_c_binary(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    if binary_add_is_string_concat(e, tc_strenv(tc)) == 1
        emit_c_str_add(e, user, stmts, tc)
    else
        emit_c_binary_num(e, user, stmts, tc)

fn emit_c_binary_num(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    l = emit_c_expr(vec_get(e, 2), user, stmts, tc)
    r = emit_c_expr(vec_get(e, 3), user, stmts, tc)
    if expr_is_float(vec_get(e, 2), tc_strenv(tc)) + expr_is_float(vec_get(e, 3), tc_strenv(tc)) > 0
        "sal_fop(" + int_to_str(float_op_code(str_from_int(vec_get(e, 1)))) + ", " + l + ", " + r + ")"
    else
        op = cmap_op(str_from_int(vec_get(e, 1)))
        "(" + l + " " + op + " " + r + ")"

# Code understood by `sal_fop` in the C prelude (`op` without the `f` prefix).
fn float_op_code(op: String) -> Int ! alloc
    if str_eq(op, d"add") == 1
        0
    elsif str_eq(op, d"sub") == 1
        1
    elsif str_eq(op, d"mul") == 1
        2
    elsif str_eq(op, d"div") == 1
        3
    elsif str_eq(op, d"eq") == 1
        4
    elsif str_eq(op, d"ne") == 1
        5
    elsif str_eq(op, d"lt") == 1
        6
    elsif str_eq(op, d"le") == 1
        7
    elsif str_eq(op, d"gt") == 1
        8
    elsif str_eq(op, d"ge") == 1
        9
    else
        10

# A payload-free enum variant used as a value is its tag.
fn emit_c_ident(e: Int, tc: Int) -> String ! alloc
    name = vec_get(e, 1)
    code = variant_code(tc, name)
    if code != 0
        if strenv_has_binding(tc_strenv(tc), name) == 0
            if code % 2 == 1
                int_to_str(variant_tag(code)) + "LL"
            else
                str_from_int(name)
        else
            str_from_int(name)
    else
        str_from_int(name)

fn emit_c_args(args: Int, i: Int, n: Int, user: Int, stmts: Int, tc: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = emit_c_expr(vec_get(args, i), user, stmts, tc)
        _p = vec_push(out, str_as_int(a))
        emit_c_args(args, i + 1, n, user, stmts, tc, out)

fn join_comma_piece(i: Int) -> String ! alloc
    if i > 0
        d", "
    else
        d""

fn join_commas(parts: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        comma = join_comma_piece(i)
        acc = acc + comma
        acc = acc + str_from_int(vec_get(parts, i))
        join_commas(parts, i + 1, n, acc)

fn c_row_len_spine(e: Int, env: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_BINARY()
            c_row_len_spine(vec_get(e, 2), env)
        else
            expr_type(e, env)

fn type_row_len_from_handle(ty: Int) -> String ! alloc
    if ty == 0
        d"1"
    else
        prod = type_concrete_row_len(str_from_int(ty))
        if prod > 0
            int_to_str(prod)
        else
            d"1"

fn type_concrete_row_len(ty: String) -> Int ! alloc
    lb = find_char(ty, 91, 0, str_len(ty))
    if lb < 0
        0 - 1
    else
        rb = find_char(ty, 93, lb, str_len(ty))
        if rb < 0
            0 - 1
        else
            inner = str_slice(ty, lb + 1, rb)
            type_dim_product(inner, 0, str_len(inner), 1)

fn type_dim_product(s: String, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        j = skip_spaces(s, i, n)
        if j >= n
            acc
        else
            k = type_dim_token_end(s, j, n)
            tok = str_slice(s, j, k)
            if str_contains(tok, d"?") == 1
                0 - 1
            else
                v = parse_int_digits(tok, 0, str_len(tok), 0)
                if v <= 0
                    0 - 1
                else
                    type_dim_product(s, k + 1, n, acc * v)

fn type_dim_token_end(s: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        i
    else
        c = str_char(s, i)
        if c == 44
            i
        else
            type_dim_token_end(s, i + 1, n)

fn emit_c_where_frame_ty(args_e: Int, env: Int) -> Int ! alloc
    if vec_len(args_e) == 0
        0
    else
        frame_e = vec_get(args_e, 0)
        k = ex_kind(frame_e)
        if k == EX_IDENT()
            ty = strenv_type(env, vec_get(frame_e, 1))
            if struct_find(strenv_structs(env), ty) != 0
                ty
            else
                0
        elsif k == EX_CALL()
            callee = vec_get(frame_e, 1)
            if struct_find(strenv_structs(env), callee) != 0
                callee
            else
                ty = expr_type(frame_e, env)
                if struct_find(strenv_structs(env), ty) != 0
                    ty
                else
                    0
        else
            ty = expr_type(frame_e, env)
            if struct_find(strenv_structs(env), ty) != 0
                ty
            else
                0

fn emit_c_where(args_e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    env = tc_strenv(tc)
    frame_ty = emit_c_where_frame_ty(args_e, env)
    if frame_ty == 0
        d"0"
    else
        frame_e = vec_get(args_e, 0)
        mask_e = vec_get(args_e, 1)
        emit_c_where_body(frame_e, mask_e, frame_ty, user, stmts, tc)

fn emit_c_where_body(frame_e: Int, mask_e: Int, frame_ty: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    frame_v = emit_c_expr(frame_e, user, stmts, tc)
    mask_v = emit_c_expr(mask_e, user, stmts, tc)
    len_v = type_row_len_from_handle(c_row_len_spine(mask_e, tc_strenv(tc)))
    sd = struct_find(strenv_structs(tc_strenv(tc)), frame_ty)
    fields = structdef_fields(sd)
    nfields = vec_len(fields)
    cnt = tmp_fresh(tc)
    line = "  int64_t " + cnt + " = sal_mask_select_count((const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _p = vec_push(stmts, str_as_int(line))
    fv = str_as_int(frame_v)
    mv = str_as_int(mask_v)
    lv = str_as_int(len_v)
    cv = str_as_int(cnt)
    emit_c_where_fields(fields, 0, nfields, fv, mv, lv, cv, stmts, tc, d"0")

fn emit_c_where_fields(fields: Int, i: Int, n: Int, frame_v: Int, mask_v: Int, len_v: Int, cnt: Int, stmts: Int, tc: Int, last_out: String) -> String ! alloc
    if i >= n
        if str_eq(last_out, d"0") == 1
            d"0"
        else
            last_out
    else
        fd = vec_get(fields, i)
        fty = vec_get(fd, 1)
        fty_s = str_from_int(fty)
        out = tmp_fresh(tc)
        fv_s = str_from_int(frame_v)
        mv_s = str_from_int(mask_v)
        lv_s = str_from_int(len_v)
        cnt_s = str_from_int(cnt)
        if str_contains(fty_s, d"Tensor") == 1
            if str_contains(fty_s, d"F32") == 1
                _e = emit_c_where_f32(out, fv_s, mv_s, lv_s, cnt_s, stmts, tc)
            elsif str_contains(fty_s, d"I8") == 1
                _e = emit_c_where_i8(out, fv_s, mv_s, lv_s, cnt_s, stmts, tc)
            else
                _e = 0
        elsif str_contains(fty_s, d"List") == 1
            _e = emit_c_where_list(out, fv_s, mv_s, lv_s, stmts, tc)
        else
            _e = 0
        emit_c_where_fields(fields, i + 1, n, frame_v, mask_v, len_v, cnt, stmts, tc, out)

fn emit_c_where_f32(out: String, col: String, mask_v: String, len_v: String, cnt: String, stmts: Int, tc: Int) -> Int ! alloc
    heap = tmp_fresh(tc)
    bline = "  int64_t " + heap + "_bytes = " + cnt + " * 4;\n"
    _a = vec_push(stmts, str_as_int(bline))
    mline = "  void *" + heap + " = sal_place_malloc(" + heap + "_bytes, 0);\n"
    _b = vec_push(stmts, str_as_int(mline))
    sline = "  sal_tensor_select_f32((float *)(uintptr_t)" + heap + ", (const float *)(uintptr_t)" + col + ", (const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _c = vec_push(stmts, str_as_int(sline))
    oline = "  int64_t " + out + " = (int64_t)(uintptr_t)" + heap + ";\n"
    _d = vec_push(stmts, str_as_int(oline))
    0

fn emit_c_where_i8(out: String, col: String, mask_v: String, len_v: String, cnt: String, stmts: Int, tc: Int) -> Int ! alloc
    heap = tmp_fresh(tc)
    bline = "  int64_t " + heap + "_bytes = " + cnt + ";\n"
    _a = vec_push(stmts, str_as_int(bline))
    mline = "  void *" + heap + " = sal_place_malloc(" + heap + "_bytes, 0);\n"
    _b = vec_push(stmts, str_as_int(mline))
    sline = "  sal_tensor_select_i8((int8_t *)(uintptr_t)" + heap + ", (const int8_t *)(uintptr_t)" + col + ", (const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _c = vec_push(stmts, str_as_int(sline))
    oline = "  int64_t " + out + " = (int64_t)(uintptr_t)" + heap + ";\n"
    _d = vec_push(stmts, str_as_int(oline))
    0

fn emit_c_where_list(out: String, col: String, mask_v: String, len_v: String, stmts: Int, tc: Int) -> Int ! alloc
    heap = tmp_fresh(tc)
    mline = "  void *" + heap + " = sal_list_select((void *)(uintptr_t)" + col + ", (const int8_t *)(uintptr_t)" + mask_v + ", " + len_v + ");\n"
    _b = vec_push(stmts, str_as_int(mline))
    oline = "  int64_t " + out + " = (int64_t)(uintptr_t)" + heap + ";\n"
    _d = vec_push(stmts, str_as_int(oline))
    0

fn emit_c_call(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    fname = vec_get(e, 1)
    args_e = vec_get(e, 2)
    arg_parts = emit_c_args(args_e, 0, vec_len(args_e), user, stmts, tc, vec_new())
    if names_has(user, fname, 0, vec_len(user)) == 1
        m = mangled(str_from_int(fname))
        acc = m + "("
        acc = join_commas(arg_parts, 0, vec_len(arg_parts), acc)
        acc + ")"
    elsif str_eq(str_from_int(fname), d"where") == 1
        emit_c_where(args_e, user, stmts, tc)
    elsif struct_find(strenv_structs(tc_strenv(tc)), fname) != 0
        emit_c_struct_ctor(arg_parts)
    elsif map_get(tc_lambdas(tc), fname) != 0
        emit_c_lambda_call(map_get(tc_lambdas(tc), fname), arg_parts, user, stmts, tc)
    elsif variant_code(tc, fname) != 0
        emit_c_variant_make(variant_tag(variant_code(tc, fname)) + emit_c_owned_mask(tc, args_e, 0, vec_len(args_e), 0, 1) * 256, arg_parts)
    elsif str_eq(str_from_int(fname), d"float_to_int") == 1
        "sal_fop(11, " + str_from_int(vec_get(arg_parts, 0)) + ", 0LL)"
    elsif str_eq(str_from_int(fname), d"int_to_float") == 1
        "sal_fop(12, " + str_from_int(vec_get(arg_parts, 0)) + ", 0LL)"
    elsif str_eq(str_from_int(fname), d"print") == 1
        emit_c_print(args_e, arg_parts, tc)
    elsif str_eq(str_from_int(fname), d"load") == 1
        emit_c_load(arg_parts, stmts)
    elsif str_eq(str_from_int(fname), d"matmul") == 1
        emit_c_matmul(args_e, arg_parts, stmts, tc)
    else
        emit_c_builtin(str_from_int(fname), arg_parts, stmts)

# Inline a lambda call: the parameter is a fresh C local in its own block.
fn emit_c_lambda_call(lam: Int, arg_parts: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    tname = tmp_fresh(tc)
    _a = vec_push(stmts, str_as_int("  int64_t " + tname + " = 0;\n"))
    arg = if vec_len(arg_parts) > 0
        str_from_int(vec_get(arg_parts, 0))
    else
        d"0"
    _b = vec_push(stmts, str_as_int("  {{ int64_t " + str_from_int(vec_get(lam, 1)) + " = " + arg + ";\n"))
    slen = strenv_len(tc_strenv(tc))
    body_stmts = vec_new()
    val = emit_c_expr(vec_get(lam, 2), user, body_stmts, tc)
    _r = strenv_set_len(tc_strenv(tc), slen)
    _c = append_stmts(stmts, body_stmts)
    _d = vec_push(stmts, str_as_int("  " + tname + " = " + val + "; }}\n"))
    tname

# `try x`: return the operand unchanged when it is the failing variant
# (`Err` / `None`), else continue with its payload.
fn emit_c_try(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    inner = emit_c_expr(vec_get(e, 1), user, stmts, tc)
    tname = tmp_fresh(tc)
    _a = vec_push(stmts, str_as_int("  int64_t " + tname + " = " + inner + ";\n"))
    err = variant_code(tc, str_as_int(d"Err"))
    none = variant_code(tc, str_as_int(d"None"))
    code = if err != 0
        err
    else
        none
    if code != 0
        _b = vec_push(stmts, str_as_int("  if (sal_enum_tag(" + tname + ") == " + int_to_str(variant_tag(code)) + "LL) return " + tname + ";\n"))
        "sal_enum_field(" + tname + ", 0)"
    else
        tname

# Two bits per field, as the bootstrap's `enum_owned_mask`: 1 a fresh String, 2 a fresh
# box of a variant with fields. `mul` is 4^i.
fn emit_c_owned_mask(tc: Int, args_e: Int, i: Int, n: Int, acc: Int, mul: Int) -> Int ! alloc
    if i >= n
        acc
    elsif i >= 28
        acc
    else
        a = vec_get(args_e, i)
        kind = 0
        if dr_is_fresh_value(a) == 1
            kind = 1
        elsif ex_kind(a) == EX_CALL()
            if vec_len(vec_get(a, 2)) > 0
                if variant_code(tc, vec_get(a, 1)) != 0
                    kind = 2
        emit_c_owned_mask(tc, args_e, i + 1, n, acc + kind * mul, mul * 4)

fn emit_c_variant_make(tag: Int, arg_parts: Int) -> String ! alloc
    if vec_len(arg_parts) == 0
        int_to_str(tag) + "LL"
    else
        pref = "({{ int64_t __e = sal_enum_new(" + int_to_str(tag) + "LL, " + int_to_str(vec_len(arg_parts)) + "LL); "
        sets = emit_c_variant_sets(arg_parts, 0, pref)
        sets + "__e; }})"

fn emit_c_variant_sets(arg_parts: Int, i: Int, acc: String) -> String ! alloc
    if i >= vec_len(arg_parts)
        acc
    else
        acc = acc + "sal_enum_set(__e, " + int_to_str(i) + "LL, " + str_from_int(vec_get(arg_parts, i)) + "); "
        emit_c_variant_sets(arg_parts, i + 1, acc)

# Tensors are `float *` buffers from sal_place_malloc; the value is the pointer.
fn emit_c_tensor_lit(e: Int) -> String ! alloc
    data = vec_get(e, 3)
    n = vec_len(data)
    acc = "({{ float *__t = (float *)sal_place_malloc(" + int_to_str(n * 4 + 4) + ", 0); "
    acc = emit_c_tensor_cells(data, 0, n, acc)
    acc + "(int64_t)(uintptr_t)__t; }})"

fn emit_c_tensor_cells(data: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + "__t[" + int_to_str(i) + "] = " + str_from_int(vec_get(data, i)) + "f; "
        emit_c_tensor_cells(data, i + 1, n, acc)

fn emit_c_load(arg_parts: Int, stmts: Int) -> String ! alloc
    _p = vec_push(stmts, str_as_int(d"  extern int64_t sal_load_f32();\n"))
    "({{ int64_t __n = 0; (int64_t)(uintptr_t)sal_load_f32((const char *)(uintptr_t)(" + arg_at(arg_parts, 0) + "), &__n); }})"

# `on <place> ...` runs its block inline (every place is the host here).
fn emit_c_on(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    emit_c_block(vec_get(e, 2), user, stmts, tc)

fn emit_c_matmul(args_e: Int, arg_parts: Int, stmts: Int, tc: Int) -> String ! alloc
    ta = expr_type(vec_get(args_e, 0), tc_strenv(tc))
    tb = expr_type(vec_get(args_e, 1), tc_strenv(tc))
    pa = tt_split(ta)
    pb = tt_split(tb)
    if vec_len(pa) < 3
        d"0"
    elsif vec_len(pb) < 3
        d"0"
    else
        m = tt_dim_val(vec_get(pa, vec_len(pa) - 2))
        k = tt_dim_val(vec_get(pa, vec_len(pa) - 1))
        n = tt_dim_val(vec_get(pb, vec_len(pb) - 1))
        tc_n = vec_get(tc, 0) + 1
        _u = vec_set(tc, 0, tc_n)
        out = "__mm" + int_to_str(tc_n)
        _e = vec_push(stmts, str_as_int(d"  extern void sal_matmul_f32();\n"))
        _p = vec_push(stmts, str_as_int("  float *" + out + " = (float *)sal_place_malloc(" + int_to_str(m * n * 4) + ", 0);\n"))
        _q = vec_push(stmts, str_as_int("  sal_matmul_f32((const float *)(uintptr_t)" + arg_at(arg_parts, 0) + ", (const float *)(uintptr_t)" + arg_at(arg_parts, 1) + ", " + out + ", " + int_to_str(m) + ", " + int_to_str(k) + ", " + int_to_str(n) + ");\n"))
        if m * n <= 16
            _r = vec_set(tc, 4, str_as_int(out))
            _t = vec_set(tc, 5, m * n)
        "((int64_t)(uintptr_t)" + out + ")"

# The bootstrap returns the element sum of the last (small) matmul from `main`.
fn emit_c_matmul_exit(tc: Int, is_main: Int, val: String) -> String ! alloc
    q = vec_get(tc, 4)
    if q == 0
        val
    elsif is_main == 0
        val
    else
        out = str_from_int(q)
        cnt = int_to_str(vec_get(tc, 5))
        "({{ double __s = 0; for (int __i = 0; __i < " + cnt + "; __i++) __s += " + out + "[__i]; (int64_t)__s; }})"

# `print` of a String prints its text, of anything else the integer.
fn emit_c_print(args_e: Int, arg_parts: Int, tc: Int) -> String ! alloc
    a0 = arg_at(arg_parts, 0)
    if vec_len(args_e) > 0
        if expr_produces_string(vec_get(args_e, 0), tc_strenv(tc)) == 1
            "sal_print_str((const char*)(uintptr_t)" + a0 + ")"
        else
            "sal_print_i64(" + a0 + ")"
    else
        "sal_print_i64(0)"

# One-field structs are transparent; wider ones are a heap array of int64
# slots, so a struct value is the pointer to it.
fn emit_c_struct_ctor(arg_parts: Int) -> String ! alloc
    n = vec_len(arg_parts)
    if n == 0
        d"0"
    elsif n == 1
        str_from_int(vec_get(arg_parts, 0))
    else
        acc = "({{ int64_t *__s = (int64_t *)malloc(" + int_to_str(n * 8) + "); "
        acc = emit_c_ctor_slots(arg_parts, 0, n, acc)
        acc + "(int64_t)__s; }})"

fn emit_c_ctor_slots(parts: Int, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        acc = acc + "__s[" + int_to_str(i) + "] = " + str_from_int(vec_get(parts, i)) + "; "
        emit_c_ctor_slots(parts, i + 1, n, acc)

# C lvalue/rvalue for `base.field`, or just the base for a one-field struct.
fn emit_c_field(e: Int, user: Int, stmts: Int, tc: Int) -> String ! alloc
    base = emit_c_expr(vec_get(e, 1), user, stmts, tc)
    sd = struct_find(strenv_structs(tc_strenv(tc)), expr_type(vec_get(e, 1), tc_strenv(tc)))
    if sd == 0
        base
    elsif structdef_field_count(sd) < 2
        base
    else
        idx = field_index_go(structdef_fields(sd), vec_get(e, 2), 0, structdef_field_count(sd))
        "(((int64_t *)(" + base + "))[" + int_to_str(idx) + "])"

# A struct is a value: `p.x = v` writes into a private copy of `p`, so a caller
# that still holds the original (or another name for it) never sees the update.
fn emit_c_field_copy(target: Int, user: Int, stmts: Int, tc: Int) -> Int ! alloc
    b = vec_get(target, 1)
    if ex_kind(b) != EX_IDENT()
        0
    else
        sd = struct_find(strenv_structs(tc_strenv(tc)), expr_type(b, tc_strenv(tc)))
        if sd == 0
            0
        elsif structdef_field_count(sd) < 2
            0
        else
            name = emit_c_expr(b, user, stmts, tc)
            bytes = int_to_str(structdef_field_count(sd) * 8)
            line = "  " + name + " = ({{ int64_t *__d = (int64_t *)malloc(" + bytes + "); __builtin_memcpy(__d, (int64_t *)(" + name + "), " + bytes + "); (int64_t)__d; }});\n"
            vec_push(stmts, str_as_int(line))

fn arg_at(args: Int, i: Int) -> String ! alloc
    if i < vec_len(args)
        str_from_int(vec_get(args, i))
    else
        d"0"

fn emit_c_builtin(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_as_int") == 1
        arg_at(args, 0)
    elsif str_eq(fname, d"str_to_f64_bits") == 1
        a0 = arg_at(args, 0)
        "sal_str_to_f64_bits((const char *)(uintptr_t)" + a0 + ")"
    elsif str_eq(fname, d"str_from_int") == 1
        arg_at(args, 0)
    elsif str_eq(fname, d"map_new") == 1
        d"((int64_t)(uintptr_t)sal_map_new())"
    elsif str_eq(fname, d"map_get") == 1
        a0 = arg_at(args, 0)
        a1 = arg_at(args, 1)
        "sal_map_get((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ")"
    elsif str_eq(fname, d"map_put") == 1
        a0 = arg_at(args, 0)
        a1 = arg_at(args, 1)
        a2 = arg_at(args, 2)
        "sal_map_put((void *)(uintptr_t)" + a0 + ", (const char *)(uintptr_t)" + a1 + ", " + a2 + ")"
    elsif str_eq(fname, d"ir_text") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_ir_text((void *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"lex_src") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_lex_src((const char *)(uintptr_t)" + a0 + "))"
    else
        emit_c_builtin_skip(fname, args, stmts)

fn emit_c_builtin_skip(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_skip") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        d = arg_at(args, 3)
        "sal_str_skip((const char*)(uintptr_t)" + a + "," + b + "," + c + "," + d + ")"
    elsif str_eq(fname, d"str_hash") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_str_hash((const char*)(uintptr_t)" + a + "," + b + ")"
    else
        emit_c_builtin_rest(fname, args, stmts)

fn emit_c_builtin_rest(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"vec_new") == 1
        d"((int64_t)(uintptr_t)sal_vec_new())"
    elsif str_eq(fname, d"argv") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_argv(" + a0 + "))"
    elsif str_eq(fname, d"read_file") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_read_file((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"strdup") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_strdup((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"tmp_path") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_tmp_path((const char *)(uintptr_t)" + a0 + "))"
    elsif str_eq(fname, d"int_to_str") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_int_to_str(" + a0 + "))"
    elsif str_eq(fname, d"char_to_str") == 1
        a0 = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_char_to_str(" + a0 + "))"
    else
        emit_c_builtin2(fname, args, stmts)

fn emit_c_builtin2(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"str_append") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_str_append((char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
    elsif str_eq(fname, d"str_concat") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "((int64_t)(uintptr_t)sal_str_concat((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + "))"
    elsif str_eq(fname, d"str_slice") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        c = arg_at(args, 2)
        "((int64_t)(uintptr_t)sal_str_slice((const char*)(uintptr_t)" + a + "," + b + "," + c + "))"
    elsif str_eq(fname, d"free") == 1
        a0 = arg_at(args, 0)
        line = "  sal_free((void*)(uintptr_t)" + a0 + ");\n"
        _p = vec_push(stmts, str_as_int(line))
        d"0"
    elsif str_eq(fname, d"clang") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_clang((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"clang_obj") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_clang_obj((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"link_objs") == 1
        a = arg_at(args, 0)
        b = arg_at(args, 1)
        "sal_link_objs((const char*)(uintptr_t)" + a + ",(const char*)(uintptr_t)" + b + ")"
    elsif str_eq(fname, d"realpath") == 1
        a = arg_at(args, 0)
        "((int64_t)(uintptr_t)sal_realpath((const char*)(uintptr_t)" + a + "))"
    elsif str_eq(fname, d"path_readable") == 1
        a = arg_at(args, 0)
        "sal_path_readable((const char*)(uintptr_t)" + a + ")"
    else
        emit_c_builtin3(fname, args, stmts)

fn emit_c_builtin3(fname: String, args: Int, stmts: Int) -> String ! alloc
    if str_eq(fname, d"gated_print_str") == 1
