# Typed AST: what `parser.sal` builds and every pass reads, with `match` and struct fields.
# `tp_free*` returns the boxes and lists of a tree; its strings stay.
#
# `TFn.mkind`: 0 plain `fn`, 1 `method`, 2 `static`, 3 `init`; `recv` is the receiver type ("" for `fn`)
# and `name` the mangled `Recv__name` (`Recv__new` for an `init`).
# `XNone` stands for an absent expression (handle 0): a missing block tail, `else` or `let` type.

struct TParam
    name: String
    ty: String
    mode: Int

struct TField
    name: String
    ty: String

struct TStruct
    name: String
    fields: List[TField]
    layout_c: Int
    tparams: List[String]
    is_frame: Int
    # `@deprecated("…")` message; "" when the item has none.
    deprecated: String
    # Byte offsets of the identifiers of its field types, in order (see `TFn.tyat`).
    tyat: String

struct TVariant
    name: String
    fields: List[String]

struct TEnum
    name: String
    variants: List[TVariant]
    tparams: List[String]
    deprecated: String
    # Byte offsets of the identifiers of its variant field types, in order (see `TFn.tyat`).
    tyat: String

# A pattern: kind 0 `_`, 1 binding `name`, 2 integer `ival`, 3 variant, 4 string `"…"`, 5 regex `r"…"` (text in `name`).
struct TPat
    kind: Int
    ival: Int
    name: String
    qual: String
    args: List[TPat]

struct TArm
    pat: TPat
    body: Expr
    suite: TBlock
    has_suite: Int

# Match arm value: indented block tail or single expression.
fn tarm_value(arm: TArm) -> Expr ! alloc
    if arm.has_suite == 1
        arm.suite.tail
    else
        arm.body

fn tarm_block(arm: TArm) -> TBlock ! alloc
    if arm.has_suite == 1
        arm.suite
    else
        TBlock(list_new[TStmt](), arm.body)

struct TElsif
    cond: Expr
    body: TBlock

struct TBlock
    stmts: List[TStmt]
    tail: Expr

# `kind` 0 expression, 1 binding or assignment (`is_let` tells them apart), 2 `return`, 3 field assignment.
# `id` names the statement across a pass (the handle it came from, 0 for one a pass creates).
struct TStmt
    kind: Int
    name: String
    expr: Expr
    ty: String
    is_let: Int
    target: Expr
    frozen: Int
    stack: Int
    id: Int

enum Expr
    XNone
    XInt(Int)
    XFloat(Int, String)
    XStr(String)
    XIdent(String)
    XBin(String, Expr, Expr)
    # The last field is the byte offset of the callee's name in the preprocessed source (0 when none).
    XCall(String, List[Expr], String, Int)
    XTo(String, Expr)
    XOn(String, TBlock, Int, Int)
    XTensor(Int, Int, List[String])
    XIf(Expr, TBlock, TBlock, Int, List[TElsif])
    XWhile(Expr, TBlock)
    XField(Expr, String)
    XBool(Int)
    XLambda(String, Expr)
    XUnary(String, Expr)
    XMatch(Expr, List[TArm])
    XTry(Expr)

struct TFn
    name: String
    params: List[TParam]
    body: TBlock
    ret: String
    no_heap: Int
    fx: List[Int]
    tparams: List[String]
    recv: String
    mkind: Int
    deprecated: String
    # Byte offsets of the identifiers written in its types, comma-separated, in the order the parser
    # read them: the parameters (`self` first), the result, then the body. Qualifiers are not listed.
    tyat: String

struct TProgram
    fns: List[TFn]
    imports: List[String]
    structs: List[TStruct]
    aliases: List[String]
    enums: List[TEnum]

# ---- release ----
# `tp_free` returns the boxes and lists of a typed tree. Strings stay, except in lists, which own
# copies (`list_free` releases them).
fn tp_free(tp: TProgram) -> Int ! alloc
    _a = tp_free_fns(tp.fns, 0, list_len(tp.fns))
    _b = list_free(tp.fns)
    _c = tp_free_structs(tp.structs, 0, list_len(tp.structs))
    _d = list_free(tp.structs)
    _e = tp_free_enums(tp.enums, 0, list_len(tp.enums))
    _f = list_free(tp.enums)
    _g = list_free(tp.imports)
    list_free(tp.aliases)

fn tp_free_fns(fns: List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        _a = tp_free_block(f.body)
        _c = list_free(f.fx)
        _d = list_free(f.params)
        _e = list_free(f.tparams)
        tp_free_fns(fns, i + 1, n)

fn tp_free_structs(sts: List[TStruct], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(sts, i)
        _a = list_free(st.fields)
        _b = list_free(st.tparams)
        tp_free_structs(sts, i + 1, n)

fn tp_free_enums(es: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        e = list_get(es, i)
        _v = tp_free_variants(e.variants, 0, list_len(e.variants))
        _t = list_free(e.tparams)
        _a = list_free(e.variants)
        tp_free_enums(es, i + 1, n)

fn tp_free_variants(vs: List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_free(list_get(vs, i).fields)
        tp_free_variants(vs, i + 1, n)

fn tp_free_block(b: TBlock) -> Int ! alloc
    _a = tp_free_stmts(b.stmts, 0, list_len(b.stmts))
    _b = list_free(b.stmts)
    tp_free_expr(b.tail)

fn tp_free_stmts(stmts: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        _a = tp_free_expr(st.expr)
        _b = tp_free_expr(st.target)
        tp_free_stmts(stmts, i + 1, n)

fn tp_free_exprs(xs: List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = tp_free_expr(list_get(xs, i))
        tp_free_exprs(xs, i + 1, n)

fn tp_free_elsifs(xs: List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = tp_free_expr(a.cond)
        _b = tp_free_block(a.body)
        tp_free_elsifs(xs, i + 1, n)

fn tp_free_pat(p: TPat) -> Int ! alloc
    _a = tp_free_pats(p.args, 0, list_len(p.args))
    list_free(p.args)

fn tp_free_pats(ps: List[TPat], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = tp_free_pat(list_get(ps, i))
        tp_free_pats(ps, i + 1, n)

fn tp_free_arms(xs: List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = tp_free_pat(a.pat)
        if a.has_suite == 1
            _b = tp_free_block(a.suite)
        else
            _b = tp_free_expr(a.body)
        tp_free_arms(xs, i + 1, n)

fn tp_free_expr(e: Expr) -> Int ! alloc
    _a = tp_free_children(e)
    enum_free(e)

# Children the box owns are released by `enum_free`; the others (built by calls or from locals)
# are released here, so nothing is freed twice whichever way the tree was built.
fn tp_free_children(e: Expr) -> Int ! alloc
    match e
        XBin(op, l, r) => tp_free_pair(e, l, r)
        XCall(name, args, targs, xp) => tp_free_call(args)
        XTo(place, inner) => tp_free_one(e, 1, inner)
        XOn(place, body, is_kern, has_index) => tp_free_block(body)
        XIf(cond, then_b, else_b, has_else, elsifs) => tp_free_if(e, cond, then_b, else_b, elsifs)
        XWhile(cond, body) => tp_free_while(e, cond, body)
        XField(base, field) => tp_free_one(e, 0, base)
        XLambda(param, body) => tp_free_one(e, 1, body)
        XUnary(op, inner) => tp_free_one(e, 1, inner)
        XTry(inner) => tp_free_one(e, 0, inner)
        XMatch(scrut, arms) => tp_free_match(e, scrut, arms)
        _ => 0

# Frees `child`, field `i` of `e`, unless the box of `e` owns it.
fn tp_free_one(e: Expr, i: Int, child: Expr) -> Int ! alloc
    if enum_owns(e, i) == 1
        0
    else
        tp_free_expr(child)

fn tp_free_pair(e: Expr, l: Expr, r: Expr) -> Int ! alloc
    _x = tp_free_one(e, 1, l)
    tp_free_one(e, 2, r)

fn tp_free_call(args: List[Expr]) -> Int ! alloc
    _x = tp_free_exprs(args, 0, list_len(args))
    list_free(args)

fn tp_free_if(e: Expr, cond: Expr, then_b: TBlock, else_b: TBlock, elsifs: List[TElsif]) -> Int ! alloc
    _x = tp_free_one(e, 0, cond)
    _y = tp_free_block(then_b)
    _z = tp_free_block(else_b)
    _w = tp_free_elsifs(elsifs, 0, list_len(elsifs))
    list_free(elsifs)

fn tp_free_while(e: Expr, cond: Expr, body: TBlock) -> Int ! alloc
    _x = tp_free_one(e, 0, cond)
    tp_free_block(body)

fn tp_free_match(e: Expr, scrut: Expr, arms: List[TArm]) -> Int ! alloc
    _x = tp_free_one(e, 0, scrut)
    _y = tp_free_arms(arms, 0, list_len(arms))
    list_free(arms)

# ---- deep copies ----
# A copy shares nothing with the original, so either can be released alone.
fn tc_exprs(xs: List[Expr], i: Int, n: Int, out: List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, tc_expr(list_get(xs, i)))
        tc_exprs(xs, i + 1, n, out)

fn tc_list(xs: List[Expr]) -> List[Expr] ! alloc
    out = list_new[Expr]()
    _a = tc_exprs(xs, 0, list_len(xs), out)
    out

fn tc_strs(xs: List[String]) -> List[String] ! alloc
    out = list_new[String]()
    _a = tc_strs_go(xs, 0, list_len(xs), out)
    out

fn tc_strs_go(xs: List[String], i: Int, n: Int, out: List[String]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, strdup(list_get(xs, i)))
        tc_strs_go(xs, i + 1, n, out)

fn tc_expr(e: Expr) -> Expr ! alloc
    match e
        XNone => XNone
        XInt(v) => XInt(v)
        XFloat(bits, txt) => XFloat(bits, strdup(txt))
        XStr(s) => XStr(strdup(s))
        XIdent(s) => XIdent(strdup(s))
        XBin(op, l, r) => XBin(strdup(op), tc_expr(l), tc_expr(r))
        XCall(name, args, targs, xp) => XCall(strdup(name), tc_list(args), strdup(targs), xp)
        XTo(place, inner) => XTo(strdup(place), tc_expr(inner))
        XOn(place, body, kern, idx) => XOn(strdup(place), tc_block(body), kern, idx)
        XTensor(nr, nc, data) => XTensor(nr, nc, tc_strs(data))
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(tc_expr(cond), tc_block(then_b), tc_block(else_b), has_else, tc_elsifs(elsifs))
        XWhile(cond, body) => XWhile(tc_expr(cond), tc_block(body))
        XField(base, field) => XField(tc_expr(base), strdup(field))
        XBool(v) => XBool(v)
        XLambda(param, body) => XLambda(strdup(param), tc_expr(body))
        XUnary(op, inner) => XUnary(strdup(op), tc_expr(inner))
        XMatch(scrut, arms) => XMatch(tc_expr(scrut), tc_arms(arms))
        XTry(inner) => XTry(tc_expr(inner))

fn tc_elsifs(xs: List[TElsif]) -> List[TElsif] ! alloc
    out = list_new[TElsif]()
    _a = tc_elsifs_go(xs, 0, list_len(xs), out)
    out

fn tc_elsifs_go(xs: List[TElsif], i: Int, n: Int, out: List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = list_push(out, TElsif(tc_expr(a.cond), tc_block(a.body)))
        tc_elsifs_go(xs, i + 1, n, out)

fn tc_arms(xs: List[TArm]) -> List[TArm] ! alloc
    out = list_new[TArm]()
    _a = tc_arms_go(xs, 0, list_len(xs), out)
    out

fn tc_arms_go(xs: List[TArm], i: Int, n: Int, out: List[TArm]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = list_push(out, TArm(tc_pat(a.pat), tc_expr(a.body), tc_block(a.suite), a.has_suite))
        tc_arms_go(xs, i + 1, n, out)

fn tc_pats(xs: List[TPat]) -> List[TPat] ! alloc
    out = list_new[TPat]()
    _a = tc_pats_go(xs, 0, list_len(xs), out)
    out

fn tc_pats_go(xs: List[TPat], i: Int, n: Int, out: List[TPat]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, tc_pat(list_get(xs, i)))
        tc_pats_go(xs, i + 1, n, out)

fn tc_pat(p: TPat) -> TPat ! alloc
    TPat(p.kind, p.ival, strdup(p.name), strdup(p.qual), tc_pats(p.args))

fn tc_stmt(s: TStmt) -> TStmt ! alloc
    TStmt(s.kind, strdup(s.name), tc_expr(s.expr), strdup(s.ty), s.is_let, tc_expr(s.target), s.frozen, s.stack, s.id)

fn tc_stmts(xs: List[TStmt], i: Int, n: Int, out: List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, tc_stmt(list_get(xs, i)))
        tc_stmts(xs, i + 1, n, out)

fn tc_block(b: TBlock) -> TBlock ! alloc
    out = list_new[TStmt]()
    _a = tc_stmts(b.stmts, 0, list_len(b.stmts), out)
    TBlock(out, tc_expr(b.tail))

# ---- view copies ----
# Like `tc_*`, but each text is a leaked copy the boxes do not own (`str_from_int` of a handle is
# not fresh), so `tp_free*` releases the tree and whoever kept the texts (the IR) still reads them.
fn tv_s(s: String) -> String ! alloc
    str_from_int(str_as_int(strdup(s)))

fn tv_exprs(xs: List[Expr], i: Int, n: Int, out: List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, tv_expr(list_get(xs, i)))
        tv_exprs(xs, i + 1, n, out)

fn tv_list(xs: List[Expr]) -> List[Expr] ! alloc
    out = list_new[Expr]()
    _a = tv_exprs(xs, 0, list_len(xs), out)
    out

fn tv_expr(e: Expr) -> Expr ! alloc
    match e
        XNone => XNone
        XInt(v) => XInt(v)
        XFloat(bits, txt) => XFloat(bits, tv_s(txt))
        XStr(s) => XStr(tv_s(s))
        XIdent(s) => XIdent(tv_s(s))
        XBin(op, l, r) => XBin(tv_s(op), tv_expr(l), tv_expr(r))
        XCall(name, args, targs, xp) => XCall(tv_s(name), tv_list(args), tv_s(targs), xp)
        XTo(place, inner) => XTo(tv_s(place), tv_expr(inner))
        XOn(place, body, kern, idx) => XOn(tv_s(place), tv_block(body), kern, idx)
        XTensor(nr, nc, data) => XTensor(nr, nc, tc_strs(data))
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(tv_expr(cond), tv_block(then_b), tv_block(else_b), has_else, tv_elsifs(elsifs))
        XWhile(cond, body) => XWhile(tv_expr(cond), tv_block(body))
        XField(base, field) => XField(tv_expr(base), tv_s(field))
        XBool(v) => XBool(v)
        XLambda(param, body) => XLambda(tv_s(param), tv_expr(body))
        XUnary(op, inner) => XUnary(tv_s(op), tv_expr(inner))
        XMatch(scrut, arms) => XMatch(tv_expr(scrut), tv_arms(arms))
        XTry(inner) => XTry(tv_expr(inner))

fn tv_elsifs(xs: List[TElsif]) -> List[TElsif] ! alloc
    out = list_new[TElsif]()
    _a = tv_elsifs_go(xs, 0, list_len(xs), out)
    out

fn tv_elsifs_go(xs: List[TElsif], i: Int, n: Int, out: List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = list_push(out, TElsif(tv_expr(a.cond), tv_block(a.body)))
        tv_elsifs_go(xs, i + 1, n, out)

fn tv_arms(xs: List[TArm]) -> List[TArm] ! alloc
    out = list_new[TArm]()
    _a = tv_arms_go(xs, 0, list_len(xs), out)
    out

fn tv_arms_go(xs: List[TArm], i: Int, n: Int, out: List[TArm]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = list_push(out, TArm(tv_pat(a.pat), tv_expr(a.body), tv_block(a.suite), a.has_suite))
        tv_arms_go(xs, i + 1, n, out)

fn tv_pats(xs: List[TPat]) -> List[TPat] ! alloc
    out = list_new[TPat]()
    _a = tv_pats_go(xs, 0, list_len(xs), out)
    out

fn tv_pats_go(xs: List[TPat], i: Int, n: Int, out: List[TPat]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, tv_pat(list_get(xs, i)))
        tv_pats_go(xs, i + 1, n, out)

fn tv_pat(p: TPat) -> TPat ! alloc
    TPat(p.kind, p.ival, tv_s(p.name), tv_s(p.qual), tv_pats(p.args))

fn tv_stmt(s: TStmt) -> TStmt ! alloc
    TStmt(s.kind, tv_s(s.name), tv_expr(s.expr), tv_s(s.ty), s.is_let, tv_expr(s.target), s.frozen, s.stack, s.id)

fn tv_stmts(xs: List[TStmt], i: Int, n: Int, out: List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(out, tv_stmt(list_get(xs, i)))
        tv_stmts(xs, i + 1, n, out)

fn tv_block(b: TBlock) -> TBlock ! alloc
    out = list_new[TStmt]()
    _a = tv_stmts(b.stmts, 0, list_len(b.stmts), out)
    TBlock(out, tv_expr(b.tail))
