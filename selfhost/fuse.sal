# Fusion, peak_bytes, and the lowering that builds fused regions.
# lower_program calls fusion; fusion reads ir.sal. Keeping both here avoids an import cycle.
import tast
import tytext
import ttypes
import ir
import tensorops
import drops
import ownership

fn FO_MATMUL() -> Int
    0

fn FO_EPILOGUE() -> Int
    1

fn FO_SOFTMAX() -> Int
    2

fn FO_COLUMN() -> Int
    3

fn lower_args(cx: Cx, args: List[Expr], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        v = lower_expr(cx, list_get(args, i))
        _p = vec_push(out, v)
        lower_args(cx, args, i + 1, n, out)

fn collect_fused(e: Expr, cx: Cx, ops: Int) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => collect_fused_call_args(cx, ops, name, args)
        XBin(op, l, r) => collect_fused_bin_args(cx, ops, op, l, r)
        _ => 0

fn collect_fused_call_args(cx: Cx, ops: Int, name: String, args: List[Expr]) -> Int ! alloc
    _a = collect_fused_args(args, cx, ops, 0, list_len(args))
    collect_fused_call(cx, ops, name, args)

fn collect_fused_bin_args(cx: Cx, ops: Int, op: String, l: Expr, r: Expr) -> Int ! alloc
    _a = collect_fused(l, cx, ops)
    _b = collect_fused(r, cx, ops)
    collect_fused_binary(cx, ops, op, l, r)

fn collect_fused_args(args: List[Expr], cx: Cx, ops: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = collect_fused(list_get(args, i), cx, ops)
        collect_fused_args(args, cx, ops, i + 1, n)

fn fo_new(kind: Int, a: Int, b: Int, c: Int) -> Int ! alloc
    o = vec_new()
    _a = vec_push(o, kind)
    _b = vec_push(o, a)
    _c = vec_push(o, b)
    _d = vec_push(o, c)
    o

fn fo_column(op: Int, lhs: Int, rhs: Int, dest: Int, scalar: Int) -> Int ! alloc
    o = fo_new(FO_COLUMN(), op, lhs, rhs)
    _e = vec_push(o, dest)
    o

fn fused_rhs_is_scalar(right: Expr) -> Int ! alloc
    match right
        XInt(v) => 1
        XFloat(bits, txt) => 1
        _ => 0

fn fused_arg_name(cx: Cx, a: Expr) -> Int ! alloc
    match a
        XIdent(name) => cx_lookup(cx, str_as_int(name))
        _ => str_as_int(d"tmp")

fn fused_arg0_name(cx: Cx, args: List[Expr]) -> Int ! alloc
    if list_len(args) > 0
        fused_arg_name(cx, list_get(args, 0))
    else
        str_as_int(d"tmp")

fn fused_op_is_matmul(op: Int) -> Int ! alloc
    if op == 0
        0
    elsif vec_len(op) < 4
        0
    elsif vec_get(op, 0) == FO_MATMUL()
        1
    else
        0

fn fused_ops_valid_count(ops: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_len(op) == 0
            fused_ops_valid_count(ops, i + 1, n)
        else
            rest = fused_ops_valid_count(ops, i + 1, n)
            1 + rest

fn collect_fused_binary(cx: Cx, ops: Int, op: String, left: Expr, right: Expr) -> Int ! alloc
    lhs = fused_arg_name(cx, left)
    rhs = fused_arg_name(cx, right)
    idx = fused_ops_valid_count(ops, 0, vec_len(ops))
    dest = str_as_int(d"col_" + int_to_str(idx))
    scal = 0
    if fused_rhs_is_scalar(right) == 1
        scal = str_as_int(d"tmp")
    else
        scal = 0
    oprec = fo_column(str_as_int(op), lhs, rhs, dest, scal)
    _p = vec_push(ops, oprec)
    0

fn collect_fused_call(cx: Cx, ops: Int, fname: String, args: List[Expr]) -> Int ! alloc
    nops = vec_len(ops)
    if str_eq(fname, "relu") == 1
        collect_fused_epilogue(ops, fname, nops)
    elsif str_eq(fname, "map") == 1
        collect_fused_epilogue(ops, fname, nops)
    elsif str_eq(fname, "matmul") == 1
        if list_len(args) == 2
            lhs = fused_arg_name(cx, list_get(args, 0))
            rhs = fused_arg_name(cx, list_get(args, 1))
            mm = str_as_int(d"mm")
            _p = vec_push(ops, fo_new(FO_MATMUL(), lhs, rhs, mm))
            0
        else
            0
    elsif str_eq(fname, "softmax") == 1
        inp = fused_arg0_name(cx, args)
        sm = str_as_int(d"sm")
        _p = vec_push(ops, fo_new(FO_SOFTMAX(), inp, 0, sm))
        0
    else
        0

# `relu`/`map` after a fused matmul add its epilogue.
fn collect_fused_epilogue(ops: Int, fname: String, nops: Int) -> Int ! alloc
    if nops > 0
        last = vec_get(ops, nops - 1)
        if fused_op_is_matmul(last) == 1
            mmc = vec_get(last, 3)
            ep = d"_epilogue"
            dest = str_from_int(mmc) + ep
            _p = vec_push(ops, fo_new(FO_EPILOGUE(), str_as_int(fname), mmc, str_as_int(dest)))
            0
        else
            0
    else
        0

fn estimate_peak(r: Int, cx: Cx) -> Int ! alloc
    # Simplified peak matching salc_py for static tensors
    ops = vec_get(r, 1)
    estimate_peak_go(r, cx, ops, 0, vec_len(ops), 0, d"", 0)

fn estimate_peak_finish_sym(r: Int, static_total: Int, sym: String) -> Int ! alloc
    _a = vec_set(r, 4, 1)
    if static_total > 0
        pref = int_to_str(static_total)
        plus = d"+"
        s1 = pref + plus
        s2 = s1 + sym
        _b = vec_set(r, 6, str_as_int(s2))
    else
        _b = vec_set(r, 6, str_as_int(sym))
    _c = vec_set(r, 3, 1)
    _d = vec_set(r, 5, static_total)
    0

fn estimate_peak_finish_static(r: Int, static_total: Int, saw: Int) -> Int ! alloc
    if saw == 1
        _c = vec_set(r, 3, 1)
        _d = vec_set(r, 5, static_total)
        0
    elsif static_total > 0
        _c = vec_set(r, 3, 1)
        _d = vec_set(r, 5, static_total)
        0
    else
        0

fn estimate_peak_go(r: Int, cx: Cx, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int) -> Int ! alloc
    if i >= n
        if str_len(sym) > 0
            estimate_peak_finish_sym(r, static_total, sym)
        else
            estimate_peak_finish_static(r, static_total, saw)
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_MATMUL()
            estimate_peak_mm(r, cx, ops, i, n, static_total, sym, saw, op)
        elsif vec_get(op, 0) == FO_COLUMN()
            estimate_peak_col(r, cx, ops, i, n, static_total, sym, saw, op)
        elsif vec_get(op, 0) == FO_SOFTMAX()
            estimate_peak_softmax(r, cx, ops, i, n, static_total, sym, saw, op)
        else
            estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)

# A binding by variable name, else by the SSA value it holds.
fn cx_find_any(cx: Cx, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        bind_for_ssa(cx, name)
    else
        b

fn estimate_peak_softmax(r: Int, cx: Cx, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    inp = cx_find_any(cx, vec_get(op, 1))
    if inp == 0
        piece = "softmax(" + str_from_int(vec_get(op, 1)) + "):symbolic"
        s2 = append_sym_plus(sym, piece)
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    elsif bind_is_tensor(inp) == 0
        piece = "softmax(" + str_from_int(vec_get(op, 1)) + "):symbolic"
        s2 = append_sym_plus(sym, piece)
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    else
        pa = peak_tensor_piece(inp, d"softmax")
        a1 = add_peak_piece(static_total, sym, pa)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a1, 0), str_from_int(vec_get(a1, 1)), 1)

fn estimate_peak_col(r: Int, cx: Cx, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    lhs = cx_find_any(cx, vec_get(op, 2))
    if lhs == 0
        piece = str_as_int(d"column_bin(tmp):symbolic")
        s2 = append_sym_plus(sym, str_from_int(piece))
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    elsif bind_is_tensor(lhs) == 0
        piece = str_as_int(d"column_bin(tmp):symbolic")
        s2 = append_sym_plus(sym, str_from_int(piece))
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    else
        pa = peak_tensor_piece(lhs, d"col")
        pa2 = peak_column_piece(pa)
        a1 = add_peak_piece(static_total, sym, pa2)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a1, 0), str_from_int(vec_get(a1, 1)), 1)

fn peak_column_piece(pa: Int) -> Int ! alloc
    res = vec_new()
    if vec_get(pa, 0) == 1
        _a = vec_push(res, 1)
        _b = vec_push(res, vec_get(pa, 1) * 2)
        _c = vec_push(res, vec_get(pa, 2))
        res
    else
        pa

fn append_sym_plus(sym: String, piece: String) -> Int ! alloc
    if str_len(sym) > 0
        plus = d"+"
        s1 = sym + plus
        str_as_int(s1 + piece)
    else
        str_as_int(sym + piece)

fn add_peak_piece(st: Int, sym: String, piece: Int) -> Int ! alloc
    out = vec_new()
    if vec_get(piece, 0) == 1
        _a = vec_push(out, st + vec_get(piece, 1))
        _b = vec_push(out, str_as_int(sym))
        out
    else
        s2 = append_sym_plus(sym, str_from_int(vec_get(piece, 2)))
        _a = vec_push(out, st)
        _b = vec_push(out, s2)
        out

fn estimate_peak_mm(r: Int, cx: Cx, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    l = cx_find_any(cx, vec_get(op, 1))
    w = cx_find_any(cx, vec_get(op, 2))
    if l == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif w == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif bind_is_tensor(l) == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif bind_is_tensor(w) == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    else
        pa = peak_tensor_piece(l, d"act")
        a1 = add_peak_piece(static_total, sym, pa)
        pw = peak_tensor_piece(w, d"w")
        a2 = add_peak_piece(vec_get(a1, 0), str_from_int(vec_get(a1, 1)), pw)
        po = peak_out_piece(l, w)
        a3 = add_peak_piece(vec_get(a2, 0), str_from_int(vec_get(a2, 1)), po)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a3, 0), str_from_int(vec_get(a3, 1)), 1)

fn peak_tensor_piece(tens: Int, label: String) -> Int ! alloc
    # returns vec [is_static, static_bytes, sym_piece]
    res = vec_new()
    dims = bind_dims(tens)
    conc = bind_concrete(tens)
    nd = bind_ndims(tens)
    eb = bind_elem(tens)
    pr = peak_prod(dims, conc, 0, nd, 1, 0, d"")
    is_dyn = vec_get(pr, 0)
    prod = vec_get(pr, 1)
    parts = vec_get(pr, 2)
    if is_dyn == 1
        _a = vec_push(res, 0)
        _b = vec_push(res, 0)
        col = d":"
        s1 = label + col
        s2 = s1 + str_from_int(parts)
        star = d"*"
        s3 = s2 + star
        ebs = int_to_str(eb)
        s4 = s3 + ebs
        _c = vec_push(res, str_as_int(s4))
        res
    else
        _a = vec_push(res, 1)
        _b = vec_push(res, prod * eb)
        _c = vec_push(res, str_as_int(d""))
        res

fn peak_dyn_parts(parts: String) -> String ! alloc
    if str_len(parts) > 0
        parts + "*?"
    else
        d"?"

fn peak_static_prefix(parts: String) -> String ! alloc
    if str_len(parts) > 0
        parts + "*"
    else
        d""

fn peak_prod(dims: Int, conc: Int, d: Int, nd: Int, prod: Int, dyn: Int, parts: String) -> Int ! alloc
    if d >= nd
        r = vec_new()
        _a = vec_push(r, dyn)
        _b = vec_push(r, prod)
        _c = vec_push(r, str_as_int(parts))
        r
    else
        dv = dim_at(dims, d)
        cv = dim_at(conc, d)
        if dv < 0
            if cv < 0
                np = peak_dyn_parts(parts)
                peak_prod(dims, conc, d + 1, nd, prod, 1, np)
            else
                peak_prod_static(dims, conc, d, nd, prod, dyn, parts, cv)
        else
            peak_prod_static(dims, conc, d, nd, prod, dyn, parts, dv)

fn peak_prod_static(dims: Int, conc: Int, d: Int, nd: Int, prod: Int, dyn: Int, parts: String, v: Int) -> Int ! alloc
    np = peak_static_prefix(parts)
    vs = int_to_str(v)
    np2 = np + vs
    peak_prod(dims, conc, d + 1, nd, prod * v, dyn, np2)

fn peak_out_piece(l: Int, w: Int) -> Int ! alloc
    res = vec_new()
    ld = bind_dims(l)
    lc = bind_concrete(l)
    wd = bind_dims(w)
    wc = bind_concrete(w)
    lnd = bind_ndims(l)
    wnd = bind_ndims(w)
    eb = bind_elem(l)
    od = vec_new()
    oc = vec_new()
    _a = peak_out_fill(od, oc, ld, lc, 0, lnd - 1)
    widx = wnd - 1
    wdv = dim_at(wd, widx)
    wcv = dim_at(wc, widx)
    _b = vec_push(od, wdv)
    _c = vec_push(oc, wcv)
    pr = peak_prod(od, oc, 0, vec_len(od), 1, 0, d"")
    is_dyn = vec_get(pr, 0)
    prod = vec_get(pr, 1)
    parts = vec_get(pr, 2)
    if is_dyn == 1
        lab = d"out:"
        s2 = lab + str_from_int(parts)
        star = d"*"
        s3 = s2 + star
        ebs = int_to_str(eb)
        s4 = s3 + ebs
        _d = vec_push(res, 0)
        _e = vec_push(res, 0)
        _f = vec_push(res, str_as_int(s4))
        res
    else
        _d = vec_push(res, 1)
        _e = vec_push(res, prod * eb)
        _f = vec_push(res, str_as_int(d""))
        res

fn peak_out_fill(od: Int, oc: Int, ld: Int, lc: Int, d: Int, n: Int) -> Int ! alloc
    if d >= n
        0
    else
        dv = dim_at(ld, d)
        cv = dim_at(lc, d)
        _a = vec_push(od, dv)
        _b = vec_push(oc, cv)
        peak_out_fill(od, oc, ld, lc, d + 1, n)

# `left` is the left operand of a string `+`; its own left chain makes the append form.
fn str_add_name(env: TEnv, left: Expr, into_acc: Int) -> Int ! alloc
    if into_acc == 1
        str_as_int(d"sal_str_append")
    elsif tbinary_is_string_concat(env, left) == 1
        str_as_int(d"sal_str_append")
    else
        str_as_int(d"sal_str_concat")

# `left` is the accumulator of an `x = x + ...` chain being lowered.
fn tadd_left_is_acc(left: Expr, acc: Int) -> Int ! alloc
    if acc == 0
        0
    else
        match left
            XIdent(name) => str_eq(str_as_int(name), acc)
            _ => 0

fn tspine_acc(left: Expr, acc: Int) -> Int ! alloc
    match left
        XBin(op, l, r) => acc
        _ => 0

# The right operand of a string `+` is a temporary this expression owns.
fn tadd_right_is_fresh_temp(env: TEnv, right: Expr) -> Int ! alloc
    match right
        XBin(op, l, r) => tbinary_is_string_concat(env, right)
        XCall(name, args, targs, xp) => call_allocates_fresh_string(name)
        _ => 0

# A left operand that is a fresh-string call: the first `str_concat` of a chain copies from it
# and must release it.
fn tadd_left_is_fresh_call(left: Expr) -> Int ! alloc
    match left
        XCall(name, args, targs, xp) => call_allocates_fresh_string(name)
        _ => 0

fn lower_str_add(cx: Cx, left: Expr, right: Expr) -> Int ! alloc
    # Only the left spine of the chain may see the accumulator.
    acc = cx_acc(cx)
    _s = cx_set_acc(cx, tspine_acc(left, acc))
    l = lower_expr(cx, left)
    _z = cx_set_acc(cx, 0)
    r = lower_expr(cx, right)
    d = fresh(cx)
    args = vec_new()
    _a = vec_push(args, l)
    _b = vec_push(args, r)
    fnm = str_add_name(cx.env, left, tadd_left_is_acc(left, acc))
    _p = ir_push(cx, ir_call(d, fnm, args, 1))
    if tadd_right_is_fresh_temp(cx.env, right) == 1
        fargs = vec_new()
        _f = vec_push(fargs, r)
        _q = ir_push(cx, ir_call(0, str_as_int(d"sal_free"), fargs, 0))
    else
        _q = 0
    if str_eq(fnm, "sal_str_concat") == 1
        if tadd_left_is_fresh_call(left) == 1
            largs = vec_new()
            _g = vec_push(largs, l)
            _h = ir_push(cx, ir_call(0, str_as_int(d"sal_free"), largs, 0))
    d

fn lower_expr(cx: Cx, e: Expr) -> Int ! alloc
    match e
        XNone => 0
        XInt(v) => lower_const(cx, v)
        XBool(v) => lower_const(cx, v)
        XFloat(bits, txt) => lower_float(cx, bits, txt)
        XStr(s) => lower_str_lit(cx, s)
        XIdent(name) => lower_ident(cx, str_as_int(name))
        XMatch(scrut, arms) => lower_match(cx, scrut, arms)
        XBin(op, l, r) => lower_binary(cx, op, l, r)
        XTensor(nr, nc, data) => lower_tensor_lit(cx, data)
        XTo(place, inner) => lower_to(cx, place, inner)
        XOn(place, body, is_kern, has_index) => lower_on(cx, place, body)
        XCall(name, args, targs, xp) => lower_call(cx, name, args, targs)
        XField(base, field) => lower_field(cx, base, field)
        XIf(cond, then_b, else_b, has_else, elsifs) => lower_if(cx, cond, then_b, else_b, elsifs)
        XWhile(cond, body) => lower_while(cx, cond, body)
        XUnary(op, inner) => lower_unary(cx, op, inner)
        _ => fresh(cx)

fn lower_const(cx: Cx, v: Int) -> Int ! alloc
    d = fresh(cx)
    _p = push_const_int(cx, d, v)
    d

fn lower_float(cx: Cx, bits: Int, txt: String) -> Int ! alloc
    d = fresh(cx)
    _p = ir_push(cx, ir_cf(d, bits, str_as_int(txt)))
    d

fn lower_str_lit(cx: Cx, s: String) -> Int ! alloc
    d = fresh(cx)
    _p = ir_push(cx, ir_cs(d, str_as_int(s)))
    d

fn lower_tensor_lit(cx: Cx, data: List[String]) -> Int ! alloc
    d = fresh(cx)
    lit = vec_new()
    _l0 = vec_push(lit, d)
    _l1 = vec_push(lit, strs_vec(data, 0, list_len(data), vec_new()))
    _l2 = vec_push(cx_literals(cx), lit)
    d

fn strs_vec(xs: List[String], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, str_as_int(list_get(xs, i)))
        strs_vec(xs, i + 1, n, out)

# `a && b` is `if a then (b != 0) else false`; `a || b` is `if a then true else (b != 0)`. The
# right operand runs only on the branch that needs it, as in the bootstrap (`ir.rs`).
fn short_circuit(op: String, left: Expr, right: Expr) -> Expr ! alloc
    truth = XBin(d"ne", right, XInt(0))
    if str_eq(op, "and") == 1
        XIf(left, TBlock(list_new[TStmt](), truth), TBlock(list_new[TStmt](), XBool(0)), 1, list_new[TElsif]())
    else
        XIf(left, TBlock(list_new[TStmt](), XBool(1)), TBlock(list_new[TStmt](), truth), 1, list_new[TElsif]())

fn lower_binary(cx: Cx, op: String, left: Expr, right: Expr) -> Int ! alloc
    if str_eq(op, "and") + str_eq(op, "or") > 0
        lower_expr(cx, short_circuit(op, left, right))
    elsif str_eq(op, "add") == 1
        if texpr_is_string(cx.env, left) == 1
            lower_str_add(cx, left, right)
        else
            lower_binary_plain(cx, op, left, right)
    else
        lower_binary_plain(cx, op, left, right)

fn lower_binary_plain(cx: Cx, op: String, left: Expr, right: Expr) -> Int ! alloc
    l = lower_expr(cx, left)
    r = lower_expr(cx, right)
    d = fresh(cx)
    if try_lower_tensor_bin(cx, op, left, right, l, r, d) == 1
        d
    else
        _p = ir_push(cx, ir_bin(d, tbinary_ir_op(cx.env, op, left, right), l, r))
        d

# IR name of a binary op: `fadd` for Float operands, `add` otherwise.
fn tbinary_ir_op(env: TEnv, op: String, left: Expr, right: Expr) -> Int ! alloc
    if tt_is_float(texpr_type(env, left)) + tt_is_float(texpr_type(env, right)) > 0
        str_as_int("f" + op)
    else
        str_as_int(op)

fn lower_unary(cx: Cx, op: String, operand: Expr) -> Int ! alloc
    inner = lower_expr(cx, operand)
    d = fresh(cx)
    if str_eq(op, "neg") + expr_is_tensor(cx, operand) == 2
        lower_tensor_neg(cx, operand, inner, d)
    else
        uop = unary_ir_op(cx.env, op, operand)
        _p = ir_push(cx, ir_bin(d, uop, inner, str_as_int(d"0")))
        d

# `-t` on a tensor is a `TensorUnary` over the operand's own length and place.
fn lower_tensor_neg(cx: Cx, operand: Expr, inner: Int, d: Int) -> Int ! alloc
    b = tensor_operand_bind(cx, operand, inner)
    len = tensor_len_operand(cx, b, inner)
    _p = ir_push(cx, ir_tun(d, str_as_int(d"neg"), bind_elem(b), bind_place(b), inner, len))
    register_tensor_ssa(cx, d, b)
    d

fn unary_ir_op(env: TEnv, op: String, operand: Expr) -> Int ! alloc
    if str_eq(op, "neg") == 1
        if tt_is_float(texpr_type(env, operand)) == 1
            str_as_int(d"fneg")
        else
            str_as_int(op)
    else
        str_as_int(op)

# Index of `field` among `fields`; 0 when absent (as the handle typer did).
fn tt_field_index(fields: List[TField], field: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(fields, i).name, field) == 1
        i
    else
        tt_field_index(fields, field, i + 1, n)

fn lower_field(cx: Cx, base: Expr, field: String) -> Int ! alloc
    b = lower_expr(cx, base)
    si = tt_struct_find(cx_structs(cx), texpr_type(cx.env, base))
    if si < 0
        b
    else
        lower_field_of(cx, b, list_get(cx_structs(cx), si), field)

fn lower_field_of(cx: Cx, base: Int, sd: TStruct, field: String) -> Int ! alloc
    nf = list_len(sd.fields)
    if nf == 1
        base
    else
        idx = tt_field_index(sd.fields, field, 0, nf)
        d = fresh(cx)
        _p = ir_push(cx, ir_extract(d, base, str_as_int(sd.name), idx))
        d

# `S(a, b)`: a single field is the field itself (newtype); more become an Aggregate.
fn lower_struct_ctor(cx: Cx, fname: String, args: List[Expr]) -> Int ! alloc
    arg_names = lower_args(cx, args, 0, list_len(args), vec_new())
    d = fresh(cx)
    if vec_len(arg_names) == 1
        vec_get(arg_names, 0)
    else
        _p = ir_push(cx, ir_agg(d, str_as_int(fname), arg_names))
        d

# The result of `to <place> x` is a tensor of x's shape on that place.
fn register_to_tensor(cx: Cx, d: Int, src: Int, place: Int) -> Int ! alloc
    b = find_tensor(cx, src)
    if b == 0
        0
    else
        reg_tensor(cx, d, bind_elem(b), place, vec_copy(bind_dims(b)), vec_copy(bind_concrete(b)))

fn lower_to(cx: Cx, place: String, inner: Expr) -> Int ! alloc
    src = lower_expr(cx, inner)
    d = fresh(cx)
    _p = ir_push(cx, ir_place(d, src, str_as_int(place)))
    _t = register_to_tensor(cx, d, src, str_as_int(place))
    dropn = drop_name_for(inner)
    _q = ir_push(cx, ir_drop(dropn))
    d

fn collect_on_ops(body: TBlock, cx: Cx) -> Int ! alloc
    ops = vec_new()
    _seed = vec_push(ops, vec_new())
    _t = collect_on_tail(body.tail, cx, ops)
    fused_ops_drop_empty(ops)

# A binary tail is a column expression: its operators fuse in evaluation order.
fn collect_on_tail(tail: Expr, cx: Cx, ops: Int) -> Int ! alloc
    match tail
        XNone => 0
        XBin(op, l, r) => collect_column_bins(tail, cx, ops)
        _ => collect_fused(tail, cx, ops)

fn collect_column_bins(e: Expr, cx: Cx, ops: Int) -> Int ! alloc
    match e
        XBin(op, l, r) => collect_column_walk(cx, ops, op, l, r)
        _ => 0

fn collect_column_walk(cx: Cx, ops: Int, op: String, l: Expr, r: Expr) -> Int ! alloc
    _l = collect_column_bins(l, cx, ops)
    _r = collect_column_bins(r, cx, ops)
    collect_fused_binary(cx, ops, op, l, r)

fn fused_ops_drop_empty(ops: Int) -> Int ! alloc
    out = vec_new()
    _c = fused_ops_drop_empty_go(ops, out, 0, vec_len(ops))
    out

fn fused_ops_drop_empty_go(ops: Int, out: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_len(op) > 0
            _p = vec_push(out, op)
        fused_ops_drop_empty_go(ops, out, i + 1, n)

fn fused_flag(has_ep: Int, has_mm: Int, has_col: Int, nops: Int) -> Int ! alloc
    if has_ep == 1
        1
    elsif has_col == 1
        1
    elsif nops > 1
        1
    elsif has_mm == 1
        1
    else
        0

fn lower_on(cx: Cx, place: String, body: TBlock) -> Int ! alloc
    ops = collect_on_ops(body, cx)
    has_ep = ops_has_kind(ops, FO_EPILOGUE(), 0, vec_len(ops))
    has_mm = ops_has_kind(ops, FO_MATMUL(), 0, vec_len(ops))
    has_col = ops_has_kind(ops, FO_COLUMN(), 0, vec_len(ops))
    fused = fused_flag(has_ep, has_mm, has_col, vec_len(ops))
    reg = region_new(str_as_int(place), ops, fused)
    _e = estimate_peak(reg, cx)
    if has_col == 0
        if has_mm == 0
            _r = vec_push(cx_regions(cx), reg)
            lower_block_value(cx, body)
        else
            d = fresh(cx)
            _m = lower_on_matmul(cx, ops, d, 0, vec_len(ops))
            _r = vec_push(cx_regions(cx), reg)
            if has_ep == 1
                lower_fused_epilogue_out(cx, ops, d, 0, vec_len(ops))
            else
                d
    else
        _r = vec_push(cx_regions(cx), reg)
        lower_block_value(cx, body)

fn ops_has_kind(ops: Int, kind: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_len(op) == 0
            ops_has_kind(ops, kind, i + 1, n)
        elsif vec_get(op, 0) == kind
            1
        else
            ops_has_kind(ops, kind, i + 1, n)

fn lower_fused_epilogue_out(cx: Cx, ops: Int, src: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        src
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_EPILOGUE()
            ir_call_unary(cx, runtime_name(cx, vec_get(op, 1)), src)
        else
            lower_fused_epilogue_out(cx, ops, src, i + 1, n)

fn lower_on_matmul(cx: Cx, ops: Int, d: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_MATMUL()
            m = axis_len(cx, vec_get(op, 1), 1)
            k = axis_len(cx, vec_get(op, 1), 0)
            nn = axis_len(cx, vec_get(op, 2), 0)
            args = vec_new()
            _a = vec_push(args, vec_get(op, 1))
            _b = vec_push(args, vec_get(op, 2))
            _c = vec_push(args, m)
            _d = vec_push(args, k)
            _e = vec_push(args, nn)
            fnm = str_as_int(d"sal_matmul_f32")
            _p = ir_push(cx, ir_call(d, fnm, args, 1))
            0
        else
            lower_on_matmul(cx, ops, d, i + 1, n)

fn is_struct_ctor_call(cx: Cx, fname: String, args: List[Expr]) -> Int ! alloc
    si = tt_struct_find(cx_structs(cx), fname)
    if si < 0
        0
    elsif list_len(list_get(cx_structs(cx), si).fields) == list_len(args)
        1
    else
        0

fn lower_call(cx: Cx, name: String, args: List[Expr], targs: String) -> Int ! alloc
    if is_struct_ctor_call(cx, name, args) == 1
        lower_struct_ctor(cx, name, args)
    elsif variant_rec(cx, str_as_int(name)) != 0
        lower_variant_ctor(cx, str_as_int(name), args)
    else
        lower_call_runtime(cx, name, args, targs)

# Runtime container kind: Int 0, Float 1, Bool 2, String 3.
fn scalar_kind_text(txt: String, i: Int, j: Int) -> Int ! alloc
    t = trim_type_piece(str_slice(txt, i, j))
    if str_eq(t, "Float") == 1
        1
    elsif str_eq(t, "Bool") == 1
        2
    elsif str_eq(t, "String") == 1
        3
    else
        0

fn shift_left_one(i: Int) -> Int ! alloc
    if i == 0
        1
    else
        2 * shift_left_one(i - 1)

# Descriptor of a type as an element of `list_new[T]()` (read by `sal_list_new_desc`; `list_desc`
# in src/ir.rs): `i` a Copy scalar or a borrowed value, `s` a String, `E` an enum box an owned
# list releases, `S(d..)` a struct whose fields are all describable (`desc_struct_text`).
fn desc_type_text(structs: List[TStruct], enums: List[TEnum], txt: String, owned: Int) -> String ! alloc
    base = desc_base_text(structs, enums, txt, owned)
    if owned == 1
        "+" + base
    else
        base

# The descriptor without the ownership mark (see `desc_type_text`).
fn desc_base_text(structs: List[TStruct], enums: List[TEnum], txt: String, owned: Int) -> String ! alloc
    t = trim_type_piece(txt)
    if str_eq(t, "String") == 1
        d"s"
    elsif owned == 0
        desc_struct_or_i(structs, enums, t)
    elsif enum_named_t(enums, t, 0, list_len(enums)) == 1
        d"E"
    else
        desc_struct_or_i(structs, enums, t)

# The struct descriptor of `t`, or "i" for anything else (a borrowed value).
fn desc_struct_or_i(structs: List[TStruct], enums: List[TEnum], t: String) -> String ! alloc
    sd = desc_struct_text(structs, enums, t, 0)
    if str_len(sd) == 0
        d"i"
    else
        sd


# The enum named `t` in `enums` (0 or 1).
fn enum_named_t(enums: List[TEnum], t: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(enums, i).name, t) == 1
        1
    else
        enum_named_t(enums, t, i + 1, n)

# Descriptor `S(..)` of the struct `name`, or "" when it is not a struct a list can own.
fn desc_struct_text(structs: List[TStruct], enums: List[TEnum], name: String, depth: Int) -> String ! alloc
    si = tt_struct_find(structs, name)
    if depth > 16
        d""
    elsif si < 0
        d""
    else
        sd = list_get(structs, si)
        if list_len(sd.tparams) > 0
            d""
        elsif list_len(sd.fields) < 2
            d""
        else
            body = desc_fields_text(structs, enums, sd.fields, 0, list_len(sd.fields), depth + 1, d"")
            if str_contains(body, d"?") == 1
                d""
            else
                "S(" + body + ")"

fn desc_fields_text(structs: List[TStruct], enums: List[TEnum], fields: List[TField], i: Int, n: Int, depth: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        f = desc_field_text(structs, enums, list_get(fields, i).ty, depth)
        desc_fields_text(structs, enums, fields, i + 1, n, depth, acc + f)

# One field: `i` a Copy scalar, `s` a String, `E` an enum box, `S(..)` a struct; "?" otherwise.
fn desc_field_text(structs: List[TStruct], enums: List[TEnum], ty: String, depth: Int) -> String ! alloc
    t = trim_type_piece(ty)
    if str_eq(t, "String") == 1
        d"s"
    elsif str_eq(t, "Int") == 1
        d"i"
    elsif str_eq(t, "Float") == 1
        d"i"
    elsif str_eq(t, "Bool") == 1
        d"i"
    elsif enum_named_t(enums, t, 0, list_len(enums)) == 1
        d"E"
    else
        sd = desc_struct_text(structs, enums, t, depth)
        if str_len(sd) == 0
            d"?"
        else
            sd

# Ownership class of a struct field, for `struct:Name` in the drops table (`OWNABLE` in
# src/drops.rs): 0 a Copy scalar, 1 a String, 2 an enum box, 3 a struct box.
fn field_class_text(enums: List[TEnum], ty: String) -> Int ! alloc
    t = trim_type_piece(ty)
    if str_eq(t, "String") == 1
        1
    elsif str_eq(t, "Int") == 1
        0
    elsif str_eq(t, "Float") == 1
        0
    elsif str_eq(t, "Bool") == 1
        0
    elsif enum_named_t(enums, t, 0, list_len(enums)) == 1
        2
    else
        3

# `list_new[T]()`: the element descriptor travels as a string constant.
fn lower_list_new(cx: Cx, txt: String, d: Int, owned: Int) -> Int ! alloc
    dsc = fresh(cx)
    _a = ir_push(cx, ir_cs(dsc, str_as_int(desc_type_text(cx_structs(cx), cx.enums, txt, owned))))
    argv = vec_new()
    _b = vec_push(argv, dsc)
    _p = ir_push(cx, ir_call(d, str_as_int(d"sal_list_new_desc"), argv, 1))
    d

# `dict_new[K, V]()` passes both runtime kinds (Int 0, Float 1, Bool 2, String 3).
fn lower_container_new(cx: Cx, name: String, txt: String, d: Int, nkinds: Int) -> Int ! alloc
    comma = find_char(txt, 44, 0, str_len(txt))
    k1 = 0
    k2 = 0
    if comma < 0
        k1 = scalar_kind_text(txt, 0, str_len(txt))
    else
        k1 = scalar_kind_text(txt, 0, comma)
        k2 = scalar_kind_text(txt, comma + 1, str_len(txt))
    argv = vec_new()
    k1d = fresh(cx)
    _a = push_const_int(cx, k1d, k1)
    _b = vec_push(argv, k1d)
    k2d = fresh(cx)
    _c = push_const_int(cx, k2d, k2)
    _e = vec_push(argv, k2d)
    _p = ir_push(cx, ir_call(d, str_as_int(d"sal_" + name), argv, 1))
    d

fn lower_call_runtime(cx: Cx, name: String, args: List[Expr], targs: String) -> Int ! alloc
    out = vec_new()
    arg_names = lower_args(cx, args, 0, list_len(args), out)
    src = map_lambda_source(cx, name, args, arg_names)
    if src != 0
        lower_map_lambda(cx, src, vec_get(arg_names, 0), list_get(args, 1))
    else
        lower_call_runtime_go(cx, name, targs, args, arg_names)

fn expr_is_lambda(e: Expr) -> Int ! alloc
    match e
        XLambda(param, body) => 1
        _ => 0

# `map(t, x => body)` over a tensor: the tensor bind it reads, or 0.
fn map_lambda_source(cx: Cx, fname: String, args: List[Expr], arg_names: Int) -> Int ! alloc
    if str_eq(fname, "map") == 0
        0
    elsif list_len(args) != 2
        0
    elsif expr_is_lambda(list_get(args, 1)) == 0
        0
    else
        find_tensor(cx, vec_get(arg_names, 0))

# The body is lowered with the parameter bound to the tensor, so its operators
# become tensor ops.
fn lower_map_lambda(cx: Cx, src: Int, arg: Int, lam: Expr) -> Int ! alloc
    match lam
        XLambda(param, body) => lower_map_lambda_go(cx, src, arg, param, body)
        _ => 0

fn lower_map_lambda_go(cx: Cx, src: Int, arg: Int, param_name: String, body: Expr) -> Int ! alloc
    param = str_as_int(param_name)
    prev = cx_find(cx, param)
    b = bind_new(param, arg)
    _t = bind_set_tensor(b, 1)
    _e = bind_set_elem(b, bind_elem(src))
    _p = bind_set_place(b, bind_place(src))
    _n = bind_set_ndims(b, bind_ndims(src))
    _g = register_tensor_ssa_go(b, bind_dims(src), bind_concrete(src), 0, bind_ndims(src))
    _m = map_put(cx_bind_map(cx), param, b)
    r = lower_expr(cx, body)
    _u = map_put(cx_bind_map(cx), param, prev)
    r

# `load("path")` with a literal path becomes `sal_load("path", cpu)`; 0 when the first
# argument is not a string literal.
fn lower_load_literal(cx: Cx, d: Int, args: List[Expr]) -> Int ! alloc
    if list_len(args) == 0
        0
    else
        load_literal_of(cx, d, list_get(args, 0))

fn load_literal_of(cx: Cx, d: Int, a0: Expr) -> Int ! alloc
    match a0
        XStr(s) => load_literal_emit(cx, d, s)
        _ => 0

fn load_literal_emit(cx: Cx, d: Int, s: String) -> Int ! alloc
    q1 = d"\""
    q2 = q1 + s
    qe = d"\""
    q3 = q2 + qe
    argv = vec_new()
    _a = vec_push(argv, str_as_int(q3))
    _pl = vec_push(argv, str_as_int(d"cpu"))
    fnm = str_as_int(d"sal_load")
    _p = ir_push(cx, ir_call(d, fnm, argv, 1))
    1

fn lower_call_runtime_go(cx: Cx, name: String, targs: String, args: List[Expr], arg_names: Int) -> Int ! alloc
    d = fresh(cx)
    fname = str_as_int(name)
    if str_eq(name, "load") == 1
        if lower_load_literal(cx, d, args) == 1
            d
        else
            rname = runtime_name(cx, fname)
            _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
            d
    elsif str_eq(name, "where") == 1
        lower_where_call(cx, args, arg_names, d)
    elsif lower_tensor_builtin(cx, name, args, arg_names, d) == 1
        d
    elsif str_eq(name, "list_new") == 1
        lower_list_new(cx, targs, d, 0)
    elsif str_eq(name, "list_new_owned") == 1
        lower_list_new(cx, targs, d, 1)
    elsif str_eq(name, "dict_new") == 1
        lower_container_new(cx, name, targs, d, 2)
    else
        rname = runtime_name(cx, fname)
        _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
        _r = register_ret_tensor(cx, d, name)
        d

# A user fn declared to return a tensor gives its result that shape.
fn register_ret_tensor(cx: Cx, d: Int, name: String) -> Int ! alloc
    if is_user_fn(cx, str_as_int(name)) == 0
        0
    else
        r = tt_index_of(cx.env.fn_names, name, 0, list_len(cx.env.fn_names))
        if r < 0
            0
        else
            register_ret_text(cx, d, list_get(cx.env.fn_rets, r))

fn register_ret_text(cx: Cx, d: Int, ret: String) -> Int ! alloc
    if str_contains_tensor(ret) == 0
        0
    else
        b = bind_new(d, d)
        _t = parse_tensor_type(ret, b)
        vec_push(cx_binds(cx), b)

# Handle of the struct type `ty` names, or 0.
fn where_struct_type(cx: Cx, ty: String) -> Int ! alloc
    if tt_struct_find(cx_structs(cx), ty) >= 0
        str_as_int(ty)
    else
        0

fn frame_name_for_where(cx: Cx, e: Expr) -> Int ! alloc
    match e
        XNone => 0
        XIdent(name) => where_struct_type(cx, tenv_type(cx.env, name))
        XCall(callee, args, targs, xp) => where_call_frame(cx, e, callee)
        _ => where_struct_type(cx, texpr_type(cx.env, e))

fn where_call_frame(cx: Cx, e: Expr, callee: String) -> Int ! alloc
    if tt_struct_find(cx_structs(cx), callee) >= 0
        str_as_int(callee)
    else
        where_struct_type(cx, texpr_type(cx.env, e))

fn where_frame_lit(frame_ty: Int) -> Int ! alloc
    q1 = d"\""
    mid = str_from_int(frame_ty)
    q2 = q1 + mid
    qe = d"\""
    str_as_int(q2 + qe)

fn lower_where_call(cx: Cx, args: List[Expr], arg_names: Int, d: Int) -> Int ! alloc
    if list_len(args) < 2
        _p = push_const_int(cx, d, 0)
        d
    else
        frame_ty = frame_name_for_where(cx, list_get(args, 0))
        if frame_ty == 0
            _p = push_const_int(cx, d, 0)
            d
        else
            frame_ssa = vec_get(arg_names, 0)
            mask_ssa = vec_get(arg_names, 1)
            len_ssa = tensor_row_len_for_expr(cx, list_get(args, 1), mask_ssa)
            argv = vec_new()
            _a = vec_push(argv, frame_ssa)
            _b = vec_push(argv, mask_ssa)
            _c = vec_push(argv, len_ssa)
            _d = vec_push(argv, where_frame_lit(frame_ty))
            fnm = str_as_int(d"sal_where")
            _p = ir_push(cx, ir_call(d, fnm, argv, 1))
            d

# ---- enums ----
fn variant_rec(cx: Cx, name: Int) -> Int ! alloc
    map_get(cx_variants(cx), name)

# A bound name, or a payload-free variant (a unit value), else the name itself.
fn lower_ident(cx: Cx, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b != 0
        bind_ssa(b)
    else
        rec = variant_rec(cx, name)
        if rec == 0
            name
        elsif vec_get(rec, 2) == 0
            d = fresh(cx)
            _p = ir_push(cx, ir_emake(d, vec_get(rec, 0), vec_get(rec, 1), vec_new(), 0))
            d
        else
            name

fn lower_variant_ctor(cx: Cx, fname: Int, args: List[Expr]) -> Int ! alloc
    rec = variant_rec(cx, fname)
    arg_names = lower_args(cx, args, 0, list_len(args), vec_new())
    d = fresh(cx)
    mask = enum_owned_mask(cx, args, 0, list_len(args), 1, 0)
    _p = ir_push(cx, ir_emake(d, vec_get(rec, 0), vec_get(rec, 1), arg_names, mask))
    d

# Two bits per field (first 28): 1 a fresh value, 2 a nested variant with fields.
fn enum_owned_mask(cx: Cx, args: List[Expr], i: Int, n: Int, scale: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    elsif i >= 28
        acc
    else
        a = list_get(args, i)
        kind = if dx_is_fresh_value(a) == 1
            1
        else
            nested_variant_kind(cx, a)
        enum_owned_mask(cx, args, i + 1, n, scale * 4, acc + kind * scale)

fn nested_variant_kind(cx: Cx, a: Expr) -> Int ! alloc
    match a
        XCall(name, inner, targs, xp) => nested_call_kind(cx, name, inner)
        _ => 0

fn nested_call_kind(cx: Cx, name: String, inner: List[Expr]) -> Int ! alloc
    if list_len(inner) == 0
        0
    elsif variant_rec(cx, str_as_int(name)) != 0
        2
    else
        0

# `match` over an enum: a `Switch` on the tag. Only variant, bare and `_` patterns lower.
fn lower_match(cx: Cx, scrut_e: Expr, arms: List[TArm]) -> Int ! alloc
    scrut = lower_expr(cx, scrut_e)
    if list_len(arms) == 0
        fresh(cx)
    elsif match_switchable(arms, 0, list_len(arms)) == 0
        fresh(cx)
    else
        lower_match_switch(cx, scrut, arms)

fn match_switchable(arms: List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    elsif list_get(arms, i).pat.kind == 2
        0
    else
        match_switchable(arms, i + 1, n)

fn lower_match_switch(cx: Cx, scrut: Int, arms: List[TArm]) -> Int ! alloc
    saved = cx_insts(cx)
    binds = cx_binds(cx)
    n0 = vec_len(binds)
    base_snap = snap_binds(binds, 0, n0, vec_new())
    slen = tenv_len(cx.env)
    sw = vec_new()
    dflt = vec_new()
    _a = vec_push(dflt, vec_new())
    _b = vec_push(dflt, str_as_int(d"0"))
    _c = lower_switch_arms(cx, scrut, arms, 0, list_len(arms), n0, base_snap, slen, sw, dflt)
    _d = cx_set_insts(cx, saved)
    d = fresh(cx)
    _p = ir_push(cx, ir_switch(d, scrut, sw, vec_get(dflt, 0), vec_get(dflt, 1)))
    d

fn lower_switch_arms(cx: Cx, scrut: Int, arms: List[TArm], i: Int, n: Int, n0: Int, snap: Int, slen: Int, sw: Int, dflt: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        pat = arm.pat
        k = pat.kind
        _i = cx_set_insts(cx, vec_new())
        tag = switch_pattern_tag(cx, pat)
        _p = bind_variant_payloads(cx, scrut, pat.args, 0, list_len(pat.args), k)
        val = lower_expr(cx, arm.body)
        body = cx_insts(cx)
        _k = kill_new_binds(cx, n0)
        _r = restore_binds(cx_binds(cx), snap, 0, n0)
        _s = tenv_truncate(cx.env, slen)
        if k == 0
            _x = vec_set(dflt, 0, body)
            _y = vec_set(dflt, 1, val)
            lower_switch_arms(cx, scrut, arms, i + 1, n, n0, snap, slen, sw, dflt)
        else
            rec = vec_new()
            _t1 = vec_push(rec, tag)
            _t2 = vec_push(rec, body)
            _t3 = vec_push(rec, val)
            _t4 = vec_push(sw, rec)
            lower_switch_arms(cx, scrut, arms, i + 1, n, n0, snap, slen, sw, dflt)

# Low tag byte of the variant a pattern names; a bare binding or `_` is 0.
fn switch_pattern_tag(cx: Cx, pat: TPat) -> Int ! alloc
    k = pat.kind
    if k == 1
        rec = variant_rec(cx, str_as_int(pat.name))
        if rec == 0
            0
        else
            vec_get(rec, 3)
    elsif k == 3
        rec = variant_rec(cx, str_as_int(pat.name))
        if rec == 0
            name_variant_tag(str_as_int(pat.name)) + 1
        else
            vec_get(rec, 3)
    else
        0

fn name_variant_tag(name: Int) -> Int ! alloc
    if str_eq(name, "None") == 1
        0
    elsif str_eq(name, "Some") == 1
        1
    elsif str_eq(name, "Ok") == 1
        1
    elsif str_eq(name, "Err") == 1
        2
    else
        1

# One `EnumField` per bound payload name of a variant pattern.
fn bind_variant_payloads(cx: Cx, scrut: Int, args: List[TPat], i: Int, n: Int, k: Int) -> Int ! alloc
    if k != 3
        0
    elsif i >= n
        0
    else
        a = list_get(args, i)
        if a.kind == 1
            d = fresh(cx)
            _p = ir_push(cx, ir_efield(d, scrut, i))
            _b = cx_bind(cx, str_as_int(a.name), d)
            bind_variant_payloads(cx, scrut, args, i + 1, n, k)
        else
            bind_variant_payloads(cx, scrut, args, i + 1, n, k)

fn lower_if(cx: Cx, cond: Expr, then_b: TBlock, else_b0: TBlock, elsifs: List[TElsif]) -> Int ! alloc
    c = lower_expr(cx, cond)
    saved = cx_insts(cx)
    binds = cx_binds(cx)
    n0 = vec_len(binds)
    base_snap = snap_binds(binds, 0, n0, vec_new())
    slen = tenv_len(cx.env)
    _a = cx_set_insts(cx, vec_new())
    then_val = lower_block_value(cx, then_b)
    then_body = cx_insts(cx)
    then_snap = snap_binds(binds, 0, n0, vec_new())
    _k1 = kill_new_binds(cx, n0)
    _r1 = restore_binds(binds, base_snap, 0, n0)
    _rs = tenv_truncate(cx.env, slen)
    _b = cx_set_insts(cx, vec_new())
    else_b = elsifs_else_block(else_b0, elsifs)
    else_val = lower_block_value(cx, else_b)
    else_body = cx_insts(cx)
    else_snap = snap_binds(binds, 0, n0, vec_new())
    _k2 = kill_new_binds(cx, n0)
    _r2 = restore_binds(binds, base_snap, 0, n0)
    _rs2 = tenv_truncate(cx.env, slen)
    _c = cx_set_insts(cx, saved)
    d = fresh(cx)
    order = sorted_live_binds(cx, n0)
    carried = merge_if_carries(cx, order, 0, base_snap, then_snap, else_snap, vec_new())
    inst = vec_new()
    _d = vec_push(inst, II_IF())
    _e = vec_push(inst, d)
    _f = vec_push(inst, c)
    _g = vec_push(inst, then_body)
    _h = vec_push(inst, else_body)
    _i = vec_push(inst, then_val)
    _j = vec_push(inst, else_val)
    _l = vec_push(inst, carried)
    _p = ir_push(cx, inst)
    d

fn snap_binds(binds: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, bind_ssa(vec_get(binds, i)))
        snap_binds(binds, i + 1, n, out)

fn restore_binds(binds: Int, snap: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _s = bind_set_ssa(vec_get(binds, i), vec_get(snap, i))
        restore_binds(binds, snap, i + 1, n)

# Bindings created inside a branch go out of scope with it.
fn kill_new_binds(cx: Cx, n0: Int) -> Int ! alloc
    binds = cx_binds(cx)
    kill_new_binds_go(cx, binds, n0, vec_len(binds))

fn kill_new_binds_go(cx: Cx, binds: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(binds, i)
        if cx_find(cx, bind_name(b)) == b
            _m = map_put(cx_bind_map(cx), bind_name(b), 0)
        else
            _m = 0
        kill_new_binds_go(cx, binds, i + 1, n)

fn str_less_go(a: Int, b: Int, i: Int, na: Int, nb: Int) -> Int ! alloc
    if i >= na
        if i < nb
            1
        else
            0
    elsif i >= nb
        0
    elsif str_char(a, i) < str_char(b, i)
        1
    elsif str_char(a, i) > str_char(b, i)
        0
    else
        str_less_go(a, b, i + 1, na, nb)

fn str_less(a: Int, b: Int) -> Int ! alloc
    str_less_go(a, b, 0, str_len(a), str_len(b))

# Indices of the live bindings among the first n0, ordered by name.
fn sorted_live_binds(cx: Cx, n0: Int) -> Int ! alloc
    sorted_live_binds_go(cx, cx_binds(cx), 0, n0, vec_new())

fn sorted_live_binds_go(cx: Cx, binds: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        b = vec_get(binds, i)
        if cx_find(cx, bind_name(b)) == b
            _p = sorted_insert(binds, out, i, vec_len(out))
        else
            _p = 0
        sorted_live_binds_go(cx, binds, i + 1, n, out)

# Insert index `idx` into `out` keeping names ascending.
fn sorted_insert(binds: Int, out: Int, idx: Int, at: Int) -> Int ! alloc
    _p = vec_push(out, idx)
    sorted_bubble(binds, out, at)

fn sorted_bubble(binds: Int, out: Int, j: Int) -> Int ! alloc
    if j <= 0
        0
    else
        a = vec_get(out, j - 1)
        b = vec_get(out, j)
        if str_less(bind_name(vec_get(binds, b)), bind_name(vec_get(binds, a))) == 1
            _x = vec_set(out, j - 1, b)
            _y = vec_set(out, j, a)
            sorted_bubble(binds, out, j - 1)
        else
            0

fn merge_if_carries(cx: Cx, order: Int, k: Int, base: Int, ts: Int, es: Int, out: Int) -> Int ! alloc
    if k >= vec_len(order)
        out
    else
        i = vec_get(order, k)
        b = vec_get(cx_binds(cx), i)
        base_v = vec_get(base, i)
        t = vec_get(ts, i)
        e = vec_get(es, i)
        if str_eq(t, base_v) == 1
            if str_eq(e, base_v) == 1
                _s = 0
            else
                _s = carry_one(cx, b, t, e, out)
        else
            _s = carry_one(cx, b, t, e, out)
        merge_if_carries(cx, order, k + 1, base, ts, es, out)

fn carry_one(cx: Cx, b: Int, t: Int, e: Int, out: Int) -> Int ! alloc
    if str_eq(t, e) == 1
        bind_set_ssa(b, t)
    else
        dest = fresh(cx)
        _s = bind_set_ssa(b, dest)
        c = vec_new()
        _a = vec_push(c, dest)
        _b = vec_push(c, t)
        _c = vec_push(c, e)
        vec_push(out, c)

# ---- while ----
# Names assigned (not `let`) anywhere in a block, as the bootstrap's collect_assigned_*.
fn assigned_add(names: Int, name: Int) -> Int ! alloc
    if assigned_has(names, name, 0, vec_len(names)) == 0
        vec_push(names, name)
    else
        0

fn assigned_has(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        assigned_has(names, name, i + 1, n)

fn assigned_stmts(stmts: List[TStmt], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        if st.kind == 1
            if st.is_let == 0
                _a = assigned_add(names, str_as_int(st.name))
            else
                _a = 0
        else
            _a = 0
        _b = assigned_expr(st.expr, names)
        assigned_stmts(stmts, i + 1, n, names)

fn assigned_block(b: TBlock, names: Int) -> Int ! alloc
    _a = assigned_stmts(b.stmts, 0, list_len(b.stmts), names)
    assigned_expr(b.tail, names)

fn assigned_args(args: List[Expr], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = assigned_expr(list_get(args, i), names)
        assigned_args(args, i + 1, n, names)

fn assigned_arms(arms: List[TElsif], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = assigned_expr(arm.cond, names)
        _b = assigned_block(arm.body, names)
        assigned_arms(arms, i + 1, n, names)

fn assigned_if(cond: Expr, then_b: TBlock, else_b: TBlock, arms: List[TElsif], names: Int) -> Int ! alloc
    _a = assigned_expr(cond, names)
    _b = assigned_block(then_b, names)
    _c = assigned_arms(arms, 0, list_len(arms), names)
    assigned_block(else_b, names)

fn assigned_while(cond: Expr, body: TBlock, names: Int) -> Int ! alloc
    _a = assigned_expr(cond, names)
    assigned_block(body, names)

fn assigned_bin(l: Expr, r: Expr, names: Int) -> Int ! alloc
    _a = assigned_expr(l, names)
    assigned_expr(r, names)

fn assigned_expr(e: Expr, names: Int) -> Int ! alloc
    match e
        XIf(cond, then_b, else_b, has_else, elsifs) => assigned_if(cond, then_b, else_b, elsifs, names)
        XOn(place, body, is_kern, has_index) => assigned_block(body, names)
        XWhile(cond, body) => assigned_while(cond, body, names)
        XCall(name, args, targs, xp) => assigned_args(args, 0, list_len(args), names)
        XBin(op, l, r) => assigned_bin(l, r, names)
        XUnary(op, inner) => assigned_expr(inner, names)
        XTo(place, inner) => assigned_expr(inner, names)
        XTry(inner) => assigned_expr(inner, names)
        _ => 0

# Assigned names that are bound at the loop head, ordered by name.
fn while_carried_names(cx: Cx, assigned: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        nm = vec_get(assigned, i)
        if cx_find(cx, nm) != 0
            _p = vec_push(out, nm)
            _s = names_bubble(out, vec_len(out) - 1)
        else
            _s = 0
        while_carried_names(cx, assigned, i + 1, n, out)

fn names_bubble(out: Int, j: Int) -> Int ! alloc
    if j <= 0
        0
    elsif str_less(vec_get(out, j), vec_get(out, j - 1)) == 1
        a = vec_get(out, j - 1)
        _x = vec_set(out, j - 1, vec_get(out, j))
        _y = vec_set(out, j, a)
        names_bubble(out, j - 1)
    else
        0

# [name, incoming, dest] per carried binding; dests are allocated in name order.
fn while_specs(cx: Cx, names: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        nm = vec_get(names, i)
        b = cx_find(cx, nm)
        spec = vec_new()
        _a = vec_push(spec, nm)
        _b = vec_push(spec, bind_ssa(b))
        dest = fresh(cx)
        _c = vec_push(spec, dest)
        _d = bind_set_ssa(b, dest)
        _e = vec_push(out, spec)
        while_specs(cx, names, i + 1, n, out)

fn while_carries(cx: Cx, specs: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        spec = vec_get(specs, i)
        b = cx_find(cx, vec_get(spec, 0))
        incoming = vec_get(spec, 1)
        dest = vec_get(spec, 2)
        updated = bind_ssa(b)
        if str_eq(updated, dest) == 1
            updated = incoming
        else
            updated = updated
        _s = bind_set_ssa(b, dest)
        c = vec_new()
        _a = vec_push(c, dest)
        _b = vec_push(c, incoming)
        _c = vec_push(c, updated)
        _d = vec_push(out, c)
        while_carries(cx, specs, i + 1, n, out)

fn lower_while(cx: Cx, cond: Expr, body: TBlock) -> Int ! alloc
    assigned = vec_new()
    _a = assigned_block(body, assigned)
    names = while_carried_names(cx, assigned, 0, vec_len(assigned), vec_new())
    specs = while_specs(cx, names, 0, vec_len(names), vec_new())
    saved = cx_insts(cx)
    binds = cx_binds(cx)
    n0 = vec_len(binds)
    slen = tenv_len(cx.env)
    _b = cx_set_insts(cx, vec_new())
    c = lower_expr(cx, cond)
    cond_insts = cx_insts(cx)
    _c = cx_set_insts(cx, vec_new())
    _v = lower_block_effects(cx, body)
    body_insts = cx_insts(cx)
    _k = kill_new_binds(cx, n0)
    _rs = tenv_truncate(cx.env, slen)
    _d = cx_set_insts(cx, saved)
    carried = while_carries(cx, specs, 0, vec_len(specs), vec_new())
    inst = vec_new()
    _e = vec_push(inst, II_WHILE())
    _f = vec_push(inst, cond_insts)
    _g = vec_push(inst, c)
    _h = vec_push(inst, body_insts)
    _i = vec_push(inst, carried)
    _p = ir_push(cx, inst)
    0

# Statements and tail for effect only: no placeholder value when there is no tail.
fn lower_block_effects(cx: Cx, b: TBlock) -> Int ! alloc
    stopped = lower_stmts(cx, b.stmts, 0, list_len(b.stmts))
    if stopped == 1
        0
    else
        lower_effect_tail(cx, b.tail)

fn lower_effect_tail(cx: Cx, tail: Expr) -> Int ! alloc
    match tail
        XNone => 0
        _ => lower_expr(cx, tail)

fn lower_block_value(cx: Cx, b: TBlock) -> Int ! alloc
    stopped = lower_stmts(cx, b.stmts, 0, list_len(b.stmts))
    if stopped == 1
        d = fresh(cx)
        d
    else
        lower_value_tail(cx, b.tail)

fn lower_value_tail(cx: Cx, tail: Expr) -> Int ! alloc
    match tail
        XNone => lower_const(cx, 0)
        _ => lower_expr(cx, tail)

# `x = load[Tensor[...] on p](path)` binds a tensor of the declared type; any other
# call result keeps the shape registered for its SSA value.
fn bind_load_tensor(cx: Cx, name: Int, call: Expr) -> Int ! alloc
    match call
        XCall(fname, args, targs, xp) => bind_load_go(cx, name, fname, targs)
        _ => 0

fn bind_load_go(cx: Cx, name: Int, fname: String, targs: String) -> Int ! alloc
    if str_len(targs) == 0
        0
    elsif str_eq(fname, "load") == 0
        0
    else
        bb = cx_find(cx, name)
        if bb == 0
            0
        elsif str_contains_tensor(targs) == 0
            0
        else
            parse_tensor_type(targs, bb)

# `let x: Tensor[...] on p = ...` binds a tensor of the declared type.
fn bind_declared_tensor(cx: Cx, name: Int, ty: String) -> Int ! alloc
    bb = cx_find(cx, name)
    if bb == 0
        0
    elsif str_contains_tensor(ty) == 0
        0
    else
        parse_tensor_type(ty, bb)

# `y = <tensor value>`: y takes the shape registered for that SSA value.
fn inherit_tensor(cx: Cx, name: Int, v: Int) -> Int ! alloc
    bb = cx_find(cx, name)
    if bb == 0
        0
    elsif bind_is_tensor(bb) == 1
        0
    else
        src = bind_for_ssa(cx, v)
        if src == 0
            0
        elsif src == bb
            0
        elsif bind_is_tensor(src) == 0
            0
        else
            _a = bind_set_tensor(bb, 1)
            _b = bind_set_elem(bb, bind_elem(src))
            _c = bind_set_ndims(bb, bind_ndims(src))
            _d = bind_set_place(bb, bind_place(src))
            _e = copy_dims(bind_dims(src), bind_dims(bb), 0, vec_len(bind_dims(src)))
            copy_dims(bind_concrete(src), bind_concrete(bb), 0, vec_len(bind_concrete(src)))

fn copy_dims(src: Int, dst: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        copy_dims(src, dst, i + 1, n)

# `x = [[..]]` binds a 2-D tensor with the literal's extents.
fn bind_tensor_lit(cx: Cx, name: Int, nr: Int, nc: Int) -> Int ! alloc
    bb = cx_find(cx, name)
    if bb == 0
        0
    else
        _t = bind_set_tensor(bb, 1)
        _n = bind_set_ndims(bb, 2)
        dims = bind_dims(bb)
        conc = bind_concrete(bb)
        _p = vec_push(dims, nr)
        _q = vec_push(dims, nc)
        _r = vec_push(conc, nr)
        vec_push(conc, nc)

fn lower_assign_shape(cx: Cx, name: Int, st: TStmt) -> Int ! alloc
    match st.expr
        XTensor(nr, nc, data) => bind_tensor_lit(cx, name, nr, nc)
        _ => lower_assign_declared(cx, name, st)

fn lower_assign_declared(cx: Cx, name: Int, st: TStmt) -> Int ! alloc
    if str_len(st.ty) != 0
        bind_declared_tensor(cx, name, st.ty)
    else
        bind_load_tensor(cx, name, st.expr)

# `name = name + ...` with a string chain starting at `name`.
fn tassign_accumulates_string(cx: Cx, name: String, value: Expr) -> Int ! alloc
    if tbinary_is_string_concat(cx.env, value) == 0
        0
    else
        str_eq(dx_leftmost(value), name)

fn lower_stmt_assign(cx: Cx, st: TStmt) -> Int ! alloc
    name = str_as_int(st.name)
    if tassign_accumulates_string(cx, st.name, st.expr) == 1
        _sa = cx_set_acc(cx, name)
    else
        _sa = cx_set_acc(cx, 0)
    v = lower_expr(cx, st.expr)
    _za = cx_set_acc(cx, 0)
    _b = cx_bind(cx, name, v)
    _ns = tenv_bind(cx.env, st.name, texpr_type(cx.env, st.expr))
    lower_assign_shape(cx, name, st)

fn lower_stmt_return(cx: Cx, st: TStmt) -> Int ! alloc
    match st.expr
        XNone => lower_return_unit(cx)
        _ => ir_push(cx, ir_ret(lower_expr(cx, st.expr)))

fn lower_return_unit(cx: Cx) -> Int ! alloc
    d = fresh(cx)
    _p = push_const_int(cx, d, 0)
    ir_push(cx, ir_ret(d))

fn lower_stmts(cx: Cx, stmts: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        if st.kind == 1
            _x = lower_stmt_assign(cx, st)
            lower_stmts(cx, stmts, i + 1, n)
        elsif st.kind == 2
            _c = lower_stmt_return(cx, st)
            1
        else
            _v = lower_expr(cx, st.expr)
            lower_stmts(cx, stmts, i + 1, n)

# ---- struct drops ----
# ---- moved bindings: bare identifiers that escape (bound, returned, tail, or passed to a
# user fn parameter that takes ownership) ----
fn mv_add(names: Int, e: Expr) -> Int ! alloc
    match e
        XIdent(name) => assigned_add(names, str_as_int(name))
        _ => 0

fn mv_stmts(stmts: List[TStmt], i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        k = st.kind
        if k == 1
            _a = mv_add(names, st.expr)
        elsif k == 2
            _a = mv_add(names, st.expr)
        elsif k == 3
            _a = mv_add(names, st.expr)
        else
            _a = 0
        _b = mv_expr(st.expr, names, md)
        mv_stmts(stmts, i + 1, n, names, md)

fn mv_block(b: TBlock, names: Int, md: Int) -> Int ! alloc
    _a = mv_stmts(b.stmts, 0, list_len(b.stmts), names, md)
    _b = mv_add(names, b.tail)
    mv_expr(b.tail, names, md)

fn mv_args(args: List[Expr], i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = mv_expr(list_get(args, i), names, md)
        mv_args(args, i + 1, n, names, md)

# Arguments passed to a `take` parameter of a user fn are moved into the callee.
fn mv_take_args(params: Int, args: List[Expr], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    elsif i >= vec_len(params)
        0
    else
        if vec_get(params, i) == 2
            _a = mv_add(names, list_get(args, i))
        else
            _a = 0
        mv_take_args(params, args, i + 1, n, names)

# A builtin or a constructor keeps what it is given.
fn mv_all_args(args: List[Expr], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = mv_add(names, list_get(args, i))
        mv_all_args(args, i + 1, n, names)

fn mv_arms(arms: List[TElsif], i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = mv_expr(arm.cond, names, md)
        _b = mv_block(arm.body, names, md)
        mv_arms(arms, i + 1, n, names, md)

fn mv_match_arms(arms: List[TArm], i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = mv_expr(list_get(arms, i).body, names, md)
        mv_match_arms(arms, i + 1, n, names, md)

fn mv_call(name: String, args: List[Expr], names: Int, md: Int) -> Int ! alloc
    params = map_get(md, str_as_int("caller:" + name))
    if params != 0
        _t = mv_take_args(params, args, 0, list_len(args), names)
    else
        _t = mv_all_args(args, 0, list_len(args), names)
    mv_args(args, 0, list_len(args), names, md)

fn mv_pair(l: Expr, r: Expr, names: Int, md: Int) -> Int ! alloc
    _a = mv_expr(l, names, md)
    mv_expr(r, names, md)

fn mv_while(cond: Expr, body: TBlock, names: Int, md: Int) -> Int ! alloc
    _a = mv_expr(cond, names, md)
    mv_block(body, names, md)

fn mv_match(scrut: Expr, arms: List[TArm], names: Int, md: Int) -> Int ! alloc
    _a = mv_expr(scrut, names, md)
    mv_match_arms(arms, 0, list_len(arms), names, md)

fn mv_if(cond: Expr, then_b: TBlock, else_b: TBlock, arms: List[TElsif], names: Int, md: Int) -> Int ! alloc
    _a = mv_expr(cond, names, md)
    _b = mv_block(then_b, names, md)
    _c = mv_arms(arms, 0, list_len(arms), names, md)
    mv_block(else_b, names, md)

fn mv_expr(e: Expr, names: Int, md: Int) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => mv_call(name, args, names, md)
        XBin(op, l, r) => mv_pair(l, r, names, md)
        XUnary(op, inner) => mv_expr(inner, names, md)
        XTo(place, inner) => mv_expr(inner, names, md)
        XTry(inner) => mv_expr(inner, names, md)
        XField(base, field) => mv_expr(base, names, md)
        XOn(place, body, is_kern, has_index) => mv_block(body, names, md)
        XWhile(cond, body) => mv_while(cond, body, names, md)
        XMatch(scrut, arms) => mv_match(scrut, arms, names, md)
        XIf(cond, then_b, else_b, has_else, elsifs) => mv_if(cond, then_b, else_b, elsifs, names, md)
        _ => 0

# ---- drops ----
# 1 when `name` is a parameter whose mode is not `take`; `modes` holds the effective mode of
# each parameter.
fn param_not_taken(params: List[TParam], modes: Int, name: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(params, i).name, name) == 1
        if vec_get(modes, i) == 2
            0
        else
            1
    else
        param_not_taken(params, modes, name, i + 1, n)

# Distinct local names bound in the env, sorted, with struct types only.
fn drop_candidates(cx: Cx, params: List[TParam], modes: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        nm = list_get(cx.env.names, i)
        # A parameter is dropped here only when it takes ownership.
        if param_not_taken(params, modes, nm, 0, list_len(params)) == 0
            if assigned_has(out, str_as_int(nm), 0, vec_len(out)) == 0
                if tt_struct_find(cx_structs(cx), tenv_type(cx.env, nm)) >= 0
                    _p = vec_push(out, str_as_int(nm))
                    _s = names_bubble(out, vec_len(out) - 1)
                else
                    _s = 0
            else
                _s = 0
        else
            _s = 0
        drop_candidates(cx, params, modes, i + 1, n, out)

# ---- struct glue (`free_struct_strings`, `field_drop` in src/ir.rs) ----
# `g` says what the glue may release: bit 0 the structs held in fields, bit 1 the containers
# (`List` of flat values, `Bytes`, `Dict` of flat values). A field the glue releases is freed
# with the runtime function of its type; a one-field struct is transparent (the field is the value).

# The runtime release of a field of type `ty` under `g`, or "" when the glue leaves it alone.
fn drop_field_fn(structs: List[TStruct], ty: String, g: Int, depth: Int) -> String ! alloc
    t = trim_type_piece(ty)
    base = ty_base(t)
    if str_eq(t, "String") == 1
        d"sal_free"
    elsif g < 2
        drop_struct_fn(structs, t, g, depth)
    elsif str_eq(base, "Bytes") == 1
        d"sal_bytes_free"
    elsif str_eq(base, "List") == 1
        if flat_value_text(trim_spaces(tt_arg(t, 0))) == 1
            d"sal_list_free"
        else
            d""
    elsif str_eq(base, "Dict") == 1
        if dict_flat_text(t) == 1
            d"sal_dict_free"
        else
            d""
    else
        drop_struct_fn(structs, t, g, depth)

# "struct" when the field is a struct the glue releases into (it holds a String or a container).
fn drop_struct_fn(structs: List[TStruct], t: String, g: Int, depth: Int) -> String ! alloc
    si = tt_struct_find(structs, t)
    if g % 2 == 0
        d""
    elsif si < 0
        d""
    elsif depth >= 8
        d""
    elsif list_len(list_get(structs, si).tparams) > 0
        d""
    elsif struct_has_heap_t(structs, list_get(structs, si), depth + 1, g) == 0
        d""
    else
        d"struct"

# A Copy scalar type name (`Int`, `Float`, `Bool`).
fn flat_value_text(t: String) -> Int ! alloc
    if str_eq(t, "Int") == 1
        1
    elsif str_eq(t, "Float") == 1
        1
    elsif str_eq(t, "Bool") == 1
        1
    else
        0

# `Dict[K, V]` with K Int or String and V a Copy scalar.
fn dict_flat_text(t: String) -> Int ! alloc
    k = trim_spaces(tt_arg(t, 0))
    v = trim_spaces(tt_arg(t, 1))
    if str_eq(k, "Int") + str_eq(k, "String") == 0
        0
    else
        flat_value_text(v)

# Does the struct hold anything the glue releases, directly or in a nested struct?
fn struct_has_heap_t(structs: List[TStruct], sd: TStruct, depth: Int, g: Int) -> Int ! alloc
    struct_has_heap_fields(structs, sd.fields, 0, list_len(sd.fields), depth, g)

fn struct_has_heap_fields(structs: List[TStruct], fields: List[TField], i: Int, n: Int, depth: Int, g: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_len(drop_field_fn(structs, list_get(fields, i).ty, g, depth)) > 0
        1
    else
        struct_has_heap_fields(structs, fields, i + 1, n, depth, g)

# Frees the released fields of the struct value `base` (of type `sd`), in field order.
fn drop_fields(cx: Cx, base: Int, sd: TStruct, fields: List[TField], i: Int, n: Int, depth: Int, g: Int) -> Int ! alloc
    if i >= n
        0
    else
        fld = list_get(fields, i)
        fnm = drop_field_fn(cx_structs(cx), fld.ty, g, depth)
        if str_len(fnm) == 0
            _z = 0
        elsif str_eq(fnm, "struct") == 1
            _n = drop_nested(cx, base, sd, i, fld.ty, depth, g)
        else
            ssa = if list_len(sd.fields) == 1
                base
            else
                d = fresh(cx)
                _e = ir_push(cx, ir_extract(d, base, str_as_int(sd.name), i))
                d
            _c = ir_push(cx, ir_call_named(ssa, str_as_int(fnm)))
        drop_fields(cx, base, sd, fields, i + 1, n, depth, g)

# A nested struct field: its own released fields.
fn drop_nested(cx: Cx, base: Int, sd: TStruct, i: Int, fty: String, depth: Int, g: Int) -> Int ! alloc
    inner = list_get(cx_structs(cx), tt_struct_find(cx_structs(cx), trim_type_piece(fty)))
    ssa = if list_len(sd.fields) == 1
        base
    else
        d = fresh(cx)
        _e = ir_push(cx, ir_extract(d, base, str_as_int(sd.name), i))
        d
    drop_fields(cx, ssa, inner, inner.fields, 0, list_len(inner.fields), depth + 1, g)

# What the glue may release of the local `nm` (bit 0 nested structs, bit 1 containers).
fn drop_glue_bits(fr: FRC, nm: Int) -> Int ! alloc
    nested = if assigned_has(fr.sv, nm, 0, vec_len(fr.sv)) == 0
        1
    else
        0
    containers = if assigned_has(fr.hm, nm, 0, vec_len(fr.hm)) == 0
        2
    else
        0
    nested + containers

fn drop_struct_fields(cx: Cx, base: Int, sd: TStruct, g: Int) -> Int ! alloc
    drop_fields(cx, base, sd, sd.fields, 0, list_len(sd.fields), 0, g)

# ---- field reads (`field_reads` in src/ir.rs) ----
# `sv`: locals read whole through a field, a struct value (`q = w.p`); `hm`: locals whose
# List/Dict/Bytes field is handed on. Maps from the local's name to 1.
# The lists of the environment the walk needs, not the TEnv itself: a struct local's glue would
# release the flat lists of a TEnv it only borrows.
struct FRC
    structs: List[TStruct]
    enums: List[TEnum]
    names: List[String]
    tys: List[String]
    md: Int
    sv: Int
    hm: Int
    al: Int

fn fr_new(env: TEnv borrow, enums: List[TEnum] borrow, md: Int) -> FRC ! alloc
    FRC(env.structs, enums, env.names, env.tys, md, vec_new(), vec_new(), vec_new())

# A struct local bound to `list_get(xs, i)` whose struct is not describable: the list hands out
# its boxes, so the local is not released (`list_alias_locals` in src/ir.rs).
fn fr_alias(c: FRC, name: String, e: Expr) -> Int ! alloc
    match e
        XCall(fname, args, targs, xp) => fr_alias_call(c, name, fname)
        _ => 0

fn fr_alias_call(c: FRC, name: String, fname: String) -> Int ! alloc
    if str_eq(fname, "list_get") == 0
        0
    else
        t = trim_type_piece(fr_type(c, name))
        si = tt_struct_find(c.structs, t)
        if si < 0
            0
        elsif str_len(desc_struct_text(c.structs, c.enums, t, 0)) == 0
            fr_add(c.al, name)
        else
            0

# The type text of the local `name` (`tenv_type`).
fn fr_type(c: FRC, name: String) -> String ! alloc
    fr_type_go(c, name, list_len(c.names) - 1)

fn fr_type_go(c: FRC, name: String, i: Int) -> String ! alloc
    if i < 0
        d""
    elsif str_eq(list_get(c.names, i), name) == 1
        list_get(c.tys, i)
    else
        fr_type_go(c, name, i - 1)

# Adds the local `name` (a string handle) to the set `set` (a vec of handles) unless it is there.
fn fr_add(set: Int, name: String) -> Int ! alloc
    if assigned_has(set, str_as_int(name), 0, vec_len(set)) == 0
        vec_push(set, str_as_int(name))
    else
        0

fn fr_is_container(t: String) -> Int ! alloc
    base = ty_base(t)
    if str_eq(base, "Bytes") == 1
        1
    elsif str_eq(base, "List") == 1
        1
    elsif str_eq(base, "Dict") == 1
        1
    else
        0

# The root local of a field chain `a.f1.f2`, pushing the field names onto `fl`; "" when the
# expression is not such a chain.
fn fr_chain(e: Expr, fl: List[String]) -> String ! alloc
    match e
        XIdent(name) => name
        XField(base, field) => fr_chain_push(base, field, fl)
        _ => d""

fn fr_chain_push(base: Expr, field: String, fl: List[String]) -> String ! alloc
    root = fr_chain(base, fl)
    if str_len(root) == 0
        d""
    else
        _p = list_push(fl, field)
        root

fn fr_note(c: FRC, e: Expr, moving: Int) -> Int ! alloc
    fl = list_new[String]()
    root = fr_chain(e, fl)
    if str_len(root) == 0
        0
    else
        si = tt_struct_find(c.structs, fr_type(c, root))
        if si < 0
            0
        else
            fr_walk_fields(c, list_get(c.structs, si), root, fl, 0, list_len(fl), moving)

fn fr_walk_fields(c: FRC, cur: TStruct, root: String, fl: List[String], k: Int, n: Int, moving: Int) -> Int ! alloc
    if k >= n
        0
    else
        fname = list_get(fl, k)
        ty = fr_field_type(cur.fields, fname, 0, list_len(cur.fields))
        last = if k + 1 == n
            1
        else
            0
        if str_len(ty) == 0
            0
        else
            t = trim_type_piece(ty)
            _h = fr_mark_heap(c, root, t, last, moving)
            si = tt_struct_find(c.structs, t)
            if si < 0
                0
            elsif list_len(list_get(c.structs, si).tparams) > 0
                0
            else
                _s = fr_mark_struct(c, root, last)
                fr_walk_fields(c, list_get(c.structs, si), root, fl, k + 1, n, moving)

# A List/Dict/Bytes field handed on (the last link of a moving chain): the local is not released.
fn fr_mark_heap(c: FRC, root: String, t: String, last: Int, moving: Int) -> Int ! alloc
    if last == 1
        if moving == 1
            if fr_is_container(t) == 1
                fr_add(c.hm, root)
            else
                0
        else
            0
    else
        0

# A struct field read whole (the last link): its nested structs are left alone.
fn fr_mark_struct(c: FRC, root: String, last: Int) -> Int ! alloc
    if last == 1
        fr_add(c.sv, root)
    else
        0

fn fr_field_type(fields: List[TField], name: String, i: Int, n: Int) -> String ! alloc
    if i >= n
        d""
    elsif str_eq(list_get(fields, i).name, name) == 1
        list_get(fields, i).ty
    else
        fr_field_type(fields, name, i + 1, n)

fn fr_ex(c: FRC, e: Expr, moving: Int) -> Int ! alloc
    match e
        XField(base, field) => fr_field(c, e, base, moving)
        XCall(name, args, targs, xp) => fr_call(c, name, args, 0, list_len(args))
        XBin(op, l, r) => fr_pair(c, l, r)
        XUnary(op, inner) => fr_ex(c, inner, moving)
        XTo(place, inner) => fr_ex(c, inner, moving)
        XTry(inner) => fr_ex(c, inner, moving)
        XOn(place, body, is_kern, has_index) => fr_blk(c, body)
        XIf(cond, then_b, else_b, has_else, elsifs) => fr_if(c, cond, then_b, else_b, elsifs)
        XWhile(cond, body) => fr_while(c, cond, body)
        XMatch(scrut, arms) => fr_match(c, scrut, arms)
        XLambda(param, body) => fr_ex(c, body, 1)
        _ => 0

fn fr_field(c: FRC, e: Expr, base: Expr, moving: Int) -> Int ! alloc
    _n = fr_note(c, e, moving)
    inner = fr_innermost(base)
    match inner
        XIdent(name) => 0
        _ => fr_ex(c, inner, 0)

fn fr_innermost(e: Expr) -> Expr ! alloc
    match e
        XField(base, field) => fr_innermost(base)
        _ => e

fn fr_pair(c: FRC, l: Expr, r: Expr) -> Int ! alloc
    _a = fr_ex(c, l, 0)
    fr_ex(c, r, 0)

fn fr_call(c: FRC, name: String, args: List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        keeps = fr_keeps(c, name, i)
        _a = fr_ex(c, list_get(args, i), keeps)
        fr_call(c, name, args, i + 1, n)

# Whether argument i of the call to `name` may be kept (a `take` parameter, or a builtin that
# does not only read it): the caller then cannot keep the struct's fields.
fn fr_keeps(c: FRC, name: String, i: Int) -> Int ! alloc
    params = map_get(c.md, str_as_int("caller:" + name))
    if params != 0
        if i < vec_len(params)
            if vec_get(params, i) == 2
                1
            else
                0
        else
            0
    elsif dr_borrows(name) == 1
        0
    else
        1

fn fr_if(c: FRC, cond: Expr, then_b: TBlock, else_b: TBlock, elsifs: List[TElsif]) -> Int ! alloc
    _a = fr_ex(c, cond, 0)
    _b = fr_blk(c, then_b)
    _c = fr_elsifs(c, elsifs, 0, list_len(elsifs))
    fr_blk(c, else_b)

fn fr_elsifs(c: FRC, elsifs: List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(elsifs, i)
        _a = fr_ex(c, arm.cond, 0)
        _b = fr_blk(c, arm.body)
        fr_elsifs(c, elsifs, i + 1, n)

fn fr_while(c: FRC, cond: Expr, body: TBlock) -> Int ! alloc
    _a = fr_ex(c, cond, 0)
    fr_blk(c, body)

fn fr_match(c: FRC, scrut: Expr, arms: List[TArm]) -> Int ! alloc
    _a = fr_ex(c, scrut, 0)
    fr_arms(c, arms, 0, list_len(arms))

fn fr_arms(c: FRC, arms: List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = fr_ex(c, list_get(arms, i).body, 1)
        fr_arms(c, arms, i + 1, n)

fn fr_blk(c: FRC, b: TBlock) -> Int ! alloc
    _s = fr_stmts(c, b.stmts, 0, list_len(b.stmts))
    fr_ex(c, b.tail, 1)

fn fr_stmts(c: FRC, stmts: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        k = st.kind
        if k == 0
            _a = fr_ex(c, st.expr, 0)
        elsif k == 1
            _al = fr_alias(c, st.name, st.expr)
            _a = fr_ex(c, st.expr, 1)
        elsif k == 2
            _a = fr_ex(c, st.expr, 1)
        else
            _a = fr_ex(c, st.target, 0)
            _b = fr_ex(c, st.expr, 1)
        fr_stmts(c, stmts, i + 1, n)

fn drop_locals(cx: Cx, fr: FRC, names: Int, moved: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = vec_get(names, i)
        _a = drop_local_one(cx, fr, moved, nm)
        drop_locals(cx, fr, names, moved, i + 1, n)

# Releases the fields of the struct local `nm` when it is not moved and not an alias of a list element.
fn drop_local_one(cx: Cx, fr: FRC, moved: Int, nm: Int) -> Int ! alloc
    if assigned_has(moved, nm, 0, vec_len(moved)) == 1
        0
    elsif assigned_has(fr.al, nm, 0, vec_len(fr.al)) == 1
        0
    else
        b = cx_find(cx, nm)
        if b != 0
            si = tt_struct_find(cx_structs(cx), tenv_type(cx.env, str_from_int(nm)))
            drop_struct_fields(cx, bind_ssa(b), list_get(cx_structs(cx), si), drop_glue_bits(fr, nm))
        else
            0

fn fn_modes_of(md: Int, name: String) -> Int ! alloc
    ms = map_get(md, str_as_int(name))
    if ms == 0
        vec_new()
    else
        ms

fn emit_struct_drops(cx: Cx, f: TFn, body: TBlock, md: Int) -> Int ! alloc
    moved = vec_new()
    _m = mv_block(body, moved, md)
    fr = fr_new(cx.env, cx.enums, md)
    _r = fr_blk(fr, body)
    names = drop_candidates(cx, f.params, fn_modes_of(md, f.name), 0, tenv_len(cx.env), vec_new())
    drop_locals(cx, fr, names, moved, 0, vec_len(names))

# Instructions without a trailing Return, which is returned separately (0 when none).
fn pop_final_ret(cx: Cx) -> Int ! alloc
    insts = cx_insts(cx)
    n = vec_len(insts)
    if n == 0
        0
    elsif vec_get(vec_get(insts, n - 1), 0) == II_RET()
        keep = vec_new()
        _c = copy_insts(insts, keep, 0, n - 1)
        ret = vec_get(insts, n - 1)
        _s = cx_set_insts(cx, keep)
        ret
    else
        0

fn copy_insts(src: Int, dst: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        copy_insts(src, dst, i + 1, n)

# The IR keeps identifier and literal texts by handle until `ir_to_text`; `drops_body_t` returns
# a tree whose boxes do not own them, so releasing the body here leaves them intact.
fn lower_fn(f: TFn, fn_names: Int, fm: Int, env: TEnv, enums: List[TEnum], denv: Int) -> Int ! alloc
    _t = tenv_truncate(env, 0)
    cx = cx_new(fn_names, fm, env, enums)
    _a = lower_params(cx, f.params, 0, list_len(f.params))
    body = drops_body_t(f, denv)
    stopped = lower_stmts(cx, body.stmts, 0, list_len(body.stmts))
    if stopped == 0
        _c = lower_fn_tail(cx, body.tail)
    else
        _c = 0
    ret = pop_final_ret(cx)
    _dr = emit_struct_drops(cx, f, body, vec_get(denv, 1))
    if ret != 0
        _rr = ir_push(cx, ret)
    else
        _rr = 0
    out = vec_new()
    _d = vec_push(out, str_as_int(f.name))
    _e = vec_push(out, cx_dim_params(cx))
    _f = vec_push(out, cx_insts(cx))
    _g = vec_push(out, cx_regions(cx))
    _h = vec_push(out, cx_literals(cx))
    _z = cx_free(cx)
    _y = tp_free_block(body)
    out

fn lower_fn_tail(cx: Cx, tail: Expr) -> Int ! alloc
    match tail
        XNone => 0
        _ => ir_push(cx, ir_ret(lower_expr(cx, tail)))

fn try_lower_tensor_bin(cx: Cx, op: String, left_e: Expr, right_e: Expr, l: Int, r: Int, d: Int) -> Int ! alloc
    if expr_is_tensor(cx, left_e) == 0
        if expr_is_tensor(cx, right_e) == 0
            0
        else
            scalar_left_tensor_bin(cx, op, r, l, right_e, left_e, d)
    else
        try_lower_tensor_bin_go(cx, op, l, r, left_e, right_e, d)

# `s op t`: the kernel takes the scalar on the right. `s - t` is `(-t) + s`; a comparison flips;
# the other operators swap their operands (as `src/ir.rs` does).
fn scalar_left_tensor_bin(cx: Cx, op: String, tensor_ssa: Int, scalar_ssa: Int, tensor_e: Expr, scalar_e: Expr, d: Int) -> Int ! alloc
    if str_eq(op, "sub") == 1
        b = tensor_operand_bind(cx, tensor_e, tensor_ssa)
        len = tensor_len_operand(cx, b, tensor_ssa)
        elem = bind_elem(b)
        place = bind_place(b)
        neg = fresh(cx)
        _p = ir_push(cx, ir_tun(neg, str_as_int(d"neg"), elem, place, tensor_ssa, len))
        register_tensor_ssa(cx, neg, b)
        _q = ir_push(cx, ir_tbin(d, str_as_int(d"add"), elem, place, neg, scalar_ssa, len, 1))
        register_tensor_ssa(cx, d, b)
        1
    elsif str_eq(op, "lt") == 1
        try_lower_tensor_bin_go(cx, "gt", tensor_ssa, scalar_ssa, tensor_e, scalar_e, d)
    elsif str_eq(op, "le") == 1
        try_lower_tensor_bin_go(cx, "ge", tensor_ssa, scalar_ssa, tensor_e, scalar_e, d)
    elsif str_eq(op, "gt") == 1
        try_lower_tensor_bin_go(cx, "lt", tensor_ssa, scalar_ssa, tensor_e, scalar_e, d)
    elsif str_eq(op, "ge") == 1
        try_lower_tensor_bin_go(cx, "le", tensor_ssa, scalar_ssa, tensor_e, scalar_e, d)
    else
        try_lower_tensor_bin_go(cx, op, tensor_ssa, scalar_ssa, tensor_e, scalar_e, d)

# Element count operand: a 1-D tensor keeps its symbolic axis; otherwise the
# product of the extents as a constant (1 when an extent is unknown).
# A 1-D tensor with a known extent gets a constant; otherwise its symbolic axis.
fn tensor_len_axis0(cx: Cx, b: Int, tensor_ssa: Int) -> Int ! alloc
    conc = bind_concrete(b)
    if vec_len(conc) == 0
        tensor_len_ssa_name(tensor_ssa)
    elsif vec_get(conc, 0) < 0
        tensor_len_ssa_name(tensor_ssa)
    else
        d = fresh(cx)
        _p = push_const_int(cx, d, vec_get(conc, 0))
        d

fn tensor_len_operand(cx: Cx, b: Int, tensor_ssa: Int) -> Int ! alloc
    if bind_ndims(b) == 1
        tensor_len_axis0(cx, b, tensor_ssa)
    else
        conc = bind_concrete(b)
        prod = conc_product_go(conc, 0, vec_len(conc), 1)
        d = fresh(cx)
        if prod > 0
            _p = push_const_int(cx, d, prod)
        else
            _p = push_const_int(cx, d, 1)
        d

# The tensor bind of the operand `tensor_e`: its own when it is a tensor identifier, else the one
# holding its SSA value.
fn tensor_operand_bind(cx: Cx, tensor_e: Expr, tensor_ssa: Int) -> Int ! alloc
    match tensor_e
        XIdent(name) => tensor_ident_bind(cx, name, tensor_ssa)
        _ => find_tensor(cx, tensor_ssa)

fn tensor_ident_bind(cx: Cx, name: String, tensor_ssa: Int) -> Int ! alloc
    b = cx_find(cx, str_as_int(name))
    if b == 0
        find_tensor(cx, tensor_ssa)
    elsif bind_is_tensor(b) == 0
        find_tensor(cx, tensor_ssa)
    else
        b

fn try_lower_tensor_bin_go(cx: Cx, op: String, tensor_ssa: Int, other_ssa: Int, tensor_e: Expr, other_e: Expr, d: Int) -> Int ! alloc
    b = tensor_operand_bind(cx, tensor_e, tensor_ssa)
    if b == 0
        0
    elsif bind_is_tensor(b) == 0
        0
    else
        len = tensor_len_operand(cx, b, tensor_ssa)
        scalar = 0
        if expr_is_tensor(cx, other_e) == 0
            scalar = 1
        place = bind_place(b)
        elem = bind_elem(b)
        _p = ir_push(cx, ir_tbin(d, str_as_int(op), elem, place, tensor_ssa, other_ssa, len, scalar))
        src = b
        register_tensor_ssa(cx, d, src)
        1

# Lowers a module whose own structs and fn results are the only ones in scope.
fn lower_program_with_callables(tp: TProgram, extra: Int) -> Int ! alloc
    env = tenv_new(tp)
    ir = lower_program_typed(tp, extra, env, tp.enums)
    _a = tenv_free(env)
    ir

fn lower_program_typed(tp: TProgram, extra: Int, env: TEnv, em: List[TEnum]) -> Int ! alloc
    names = collect_fn_names_t(tp.fns, 0, list_len(tp.fns), vec_new())
    names = merge_callable_names(extra, names)
    fm = map_new()
    _i = fill_fn_map(fm, names, 0, vec_len(names))
    out = vec_new()
    denv = drop_env_t(tp, env.structs, em)
    lower_fns(tp.fns, names, fm, env, em, denv, 0, list_len(tp.fns), out)

# `[variants, modes, read-only params]`: the variant table, per fn name the effective mode of
# each parameter (0 copy, 1 borrow, 2 take), and the read-only flags.
# `structs`/`enums` are the whole module graph's (the imported ones included), as the drops pass
# of src/drops.rs sees them; the variants are the module's own.
fn drop_env_t(tp: TProgram, structs: List[TStruct] borrow, enums: List[TEnum] borrow) -> Int ! alloc
    denv = vec_new()
    _a = vec_push(denv, variant_map_t(tp, structs, enums))
    _o = owned_fns_put(vec_get(denv, 0), tp.fns, 0, list_len(tp.fns))
    modes = map_new()
    table = own_mode_table(tp)
    _m = modes_fill_t(modes, table, tp.fns, 0, list_len(tp.fns))
    _h = ht_free(table)
    _b = vec_push(denv, modes)
    _c = vec_push(denv, dr_read_only_t(tp, vec_get(denv, 0)))
    denv

fn modes_fill_t(m: Int, table: HT, fns: List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        ms = vec_new()
        _k = modes_vec(ms, ht_get(table, f.name), 0, list_len(f.params))
        _p = map_put(m, str_as_int(strdup(f.name)), ms)
        # The callers' view (`param_modes` in src/ir.rs): a parameter whose fields the fn releases is taken.
        caller = vec_new()
        _c = modes_vec(caller, ht_get(table, f.name), 0, list_len(f.params))
        _r = mark_released_params(caller, f, releases_param_names(f))
        _q = map_put(m, str_as_int("caller:" + f.name), caller)
        modes_fill_t(m, table, fns, i + 1, n)

# Sets to take (2) the modes of the parameters named in `names`.
fn mark_released_params(modes: Int, f: TFn, names: Int) -> Int ! alloc
    mark_released_go(modes, f.params, 0, list_len(f.params), names)

fn mark_released_go(modes: Int, params: List[TParam], i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _s = if assigned_has(names, str_as_int(list_get(params, i).name), 0, vec_len(names)) == 1
            vec_set(modes, i, 2)
        else
            0
        mark_released_go(modes, params, i + 1, n, names)

# The parameters of `f` whose fields it passes to a releasing builtin (`list_free(p.xs)`,
# `free(p.name)`, ...): `releases_param_fields` in src/ir.rs.
fn releases_param_names(f: TFn) -> Int ! alloc
    out = vec_new()
    _b = rel_block(f.body, out)
    out

fn rel_block(b: TBlock, out: Int) -> Int ! alloc
    _s = rel_stmts(b.stmts, 0, list_len(b.stmts), out)
    rel_expr(b.tail, out)

fn rel_stmts(stmts: List[TStmt], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(stmts, i)
        _a = rel_expr(st.expr, out)
        _b = rel_expr(st.target, out)
        rel_stmts(stmts, i + 1, n, out)

fn rel_releasing(name: String) -> Int ! alloc
    if str_eq(name, "free") == 1
        1
    elsif str_eq(name, "list_free") == 1
        1
    elsif str_eq(name, "dict_free") == 1
        1
    elsif str_eq(name, "bytes_free") == 1
        1
    elsif str_eq(name, "enum_free") == 1
        1
    else
        0

# The root local of a field chain `p.f.g` (`p`), or "".
fn rel_root(e: Expr) -> String ! alloc
    match e
        XField(base, field) => rel_root_of(base)
        _ => d""

fn rel_root_of(e: Expr) -> String ! alloc
    match e
        XIdent(name) => name
        XField(base, field) => rel_root_of(base)
        _ => d""

fn rel_args(args: List[Expr], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        root = rel_root(list_get(args, i))
        _a = if str_len(root) == 0
            0
        else
            vec_push(out, str_as_int(root))
        rel_args(args, i + 1, n, out)

fn rel_expr(e: Expr, out: Int) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => rel_call(name, args, out)
        XBin(op, l, r) => rel_pair(l, r, out)
        XUnary(op, inner) => rel_expr(inner, out)
        XTo(place, inner) => rel_expr(inner, out)
        XTry(inner) => rel_expr(inner, out)
        XField(base, field) => rel_expr(base, out)
        XOn(place, body, is_kern, has_index) => rel_block(body, out)
        XWhile(cond, body) => rel_while(cond, body, out)
        XIf(cond, then_b, else_b, has_else, elsifs) => rel_if(cond, then_b, else_b, elsifs, out)
        XMatch(scrut, arms) => rel_match(scrut, arms, out)
        XLambda(param, body) => rel_expr(body, out)
        _ => 0

fn rel_call(name: String, args: List[Expr], out: Int) -> Int ! alloc
    _a = if rel_releasing(name) == 1
        rel_args(args, 0, list_len(args), out)
    else
        0
    rel_all(args, 0, list_len(args), out)

fn rel_all(args: List[Expr], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = rel_expr(list_get(args, i), out)
        rel_all(args, i + 1, n, out)

fn rel_pair(l: Expr, r: Expr, out: Int) -> Int ! alloc
    _a = rel_expr(l, out)
    rel_expr(r, out)

fn rel_while(cond: Expr, body: TBlock, out: Int) -> Int ! alloc
    _a = rel_expr(cond, out)
    rel_block(body, out)

fn rel_if(cond: Expr, then_b: TBlock, else_b: TBlock, elsifs: List[TElsif], out: Int) -> Int ! alloc
    _a = rel_expr(cond, out)
    _b = rel_block(then_b, out)
    _c = rel_elsifs(elsifs, 0, list_len(elsifs), out)
    rel_block(else_b, out)

fn rel_elsifs(elsifs: List[TElsif], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(elsifs, i)
        _a = rel_expr(arm.cond, out)
        _b = rel_block(arm.body, out)
        rel_elsifs(elsifs, i + 1, n, out)

fn rel_match(scrut: Expr, arms: List[TArm], out: Int) -> Int ! alloc
    _a = rel_expr(scrut, out)
    rel_arms(arms, 0, list_len(arms), out)

fn rel_arms(arms: List[TArm], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = rel_expr(list_get(arms, i).body, out)
        rel_arms(arms, i + 1, n, out)

fn modes_vec(out: Int, text: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(out, own_mode_at(text, i))
        modes_vec(out, text, i + 1, n)

# Variant name -> [1 when it has fields or 2 when unit, per-field "may own heap" flags].
fn variant_map_t(tp: TProgram, structs: List[TStruct] borrow, enums: List[TEnum] borrow) -> Int ! alloc
    m = map_new()
    _a = variant_map_enums_t(m, tp.enums, 0, list_len(tp.enums))
    _k = enum_keys_t(m, enums, 0, list_len(enums))
    _b = flat_map_structs_t(m, structs, enums, 0, list_len(structs))
    m

# `enum:Name` for every enum of the module graph.
fn enum_keys_t(m: Int, enums: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = map_put(m, str_as_int("enum:" + list_get(enums, i).name), 1)
        enum_keys_t(m, enums, i + 1, n)

# Structs a list can own (see `desc_struct_text`) go in the same table under `struct:Name`, with
# the class of each field (`field_class_text`).
fn flat_map_structs_t(m: Int, sts: List[TStruct], enums: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        sd = list_get(sts, i)
        if str_len(desc_struct_text(sts, enums, sd.name, 0)) > 0
            flags = vec_new()
            _f = field_classes_t(flags, enums, sd.fields, 0, list_len(sd.fields))
            _p = map_put(m, str_as_int("struct:" + sd.name), flags)
            _d = map_put(m, str_as_int("desc:" + sd.name), str_as_int(desc_struct_text(sts, enums, sd.name, 0)))
            flat_map_structs_t(m, sts, enums, i + 1, n)
        else
            flat_map_structs_t(m, sts, enums, i + 1, n)

fn field_classes_t(out: Int, enums: List[TEnum], fields: List[TField], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(out, field_class_text(enums, list_get(fields, i).ty))
        field_classes_t(out, enums, fields, i + 1, n)

fn variant_map_enums_t(m: Int, enums: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        ed = list_get(enums, i)
        _k = map_put(m, str_as_int("enum:" + ed.name), 1)
        _a = variant_map_go_t(m, ed.variants, 0, list_len(ed.variants))
        variant_map_enums_t(m, enums, i + 1, n)

fn variant_map_go_t(m: Int, vs: List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = list_get(vs, i)
        rec = vec_new()
        if list_len(v.fields) == 0
            _k = vec_push(rec, 2)
        else
            _k = vec_push(rec, 1)
        flags = vec_new()
        _f = variant_field_flags_t(v.fields, 0, list_len(v.fields), flags)
        _g = vec_push(rec, flags)
        _p = map_put(m, str_as_int(strdup(v.name)), rec)
        variant_map_go_t(m, vs, i + 1, n)

fn variant_field_flags_t(fields: List[String], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(out, dr_field_owned_t(list_get(fields, i)))
        variant_field_flags_t(fields, i + 1, n, out)

fn lower_fns(fns: List[TFn], names: Int, fm: Int, env: TEnv, em: List[TEnum], denv: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        irf = lower_fn(list_get(fns, i), names, fm, env, em, denv)
        _p = vec_push(out, irf)
        lower_fns(fns, names, fm, env, em, denv, i + 1, n, out)
