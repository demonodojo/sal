# Fusion, peak_bytes, and the lowering that builds fused regions.
# lower_program calls fusion; fusion reads ir.sal. Keeping both here avoids an import cycle.
import ast
import ir

fn FO_MATMUL() -> Int
    0

fn FO_EPILOGUE() -> Int
    1

fn FO_SOFTMAX() -> Int
    2

fn FO_COLUMN() -> Int
    3

fn lower_args(cx: Int, args: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = vec_get(args, i)
        v = lower_expr(cx, a)
        _p = vec_push(out, v)
        lower_args(cx, args, i + 1, n, out)

fn collect_fused(e: Int, cx: Int, ops: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_CALL()
            args = vec_get(e, 2)
            _a = collect_fused_args(args, cx, ops, 0, vec_len(args))
            fname = vec_get(e, 1)
            collect_fused_call(e, cx, ops, fname, args)
        elsif k == EX_BINARY()
            _a = collect_fused(vec_get(e, 2), cx, ops)
            _b = collect_fused(vec_get(e, 3), cx, ops)
            collect_fused_binary(e, cx, ops)
        else
            0

fn collect_fused_args(args: Int, cx: Int, ops: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = collect_fused(vec_get(args, i), cx, ops)
        collect_fused_args(args, cx, ops, i + 1, n)

fn fo_new(kind: Int, a: Int, b: Int, c: Int) -> Int ! alloc
    o = vec_new()
    _a = vec_push(o, kind)
    _b = vec_push(o, a)
    _c = vec_push(o, b)
    _d = vec_push(o, c)
    o

fn fused_arg_name(cx: Int, a: Int) -> Int ! alloc
    if ex_kind(a) == EX_IDENT()
        cx_lookup(cx, vec_get(a, 1))
    else
        str_as_int(d"tmp")

fn fused_arg0_name(cx: Int, args: Int) -> Int ! alloc
    if vec_len(args) > 0
        fused_arg_name(cx, vec_get(args, 0))
    else
        str_as_int(d"tmp")

fn collect_fused_binary(e: Int, cx: Int, ops: Int) -> Int ! alloc
    left = vec_get(e, 2)
    right = vec_get(e, 3)
    op = vec_get(e, 1)
    lhs = fused_arg_name(cx, left)
    rhs = fused_arg_name(cx, right)
    dest = str_as_int(d"col")
    _p = vec_push(ops, fo_new(FO_COLUMN(), lhs, rhs, dest))
    0

fn collect_fused_call(e: Int, cx: Int, ops: Int, fname: Int, args: Int) -> Int ! alloc
    nops = vec_len(ops)
    if str_eq(fname, "relu") == 1
        if nops > 0
            last = vec_get(ops, nops - 1)
            if vec_get(last, 0) == FO_MATMUL()
                mmc = vec_get(last, 3)
                ep = d"_epilogue"
                dest = str_from_int(mmc) + ep
                _p = vec_push(ops, fo_new(FO_EPILOGUE(), fname, mmc, str_as_int(dest)))
                0
            else
                0
        else
            0
    elsif str_eq(fname, "map") == 1
        if nops > 0
            last = vec_get(ops, nops - 1)
            if vec_get(last, 0) == FO_MATMUL()
                mmc = vec_get(last, 3)
                ep = d"_epilogue"
                dest = str_from_int(mmc) + ep
                _p = vec_push(ops, fo_new(FO_EPILOGUE(), fname, mmc, str_as_int(dest)))
                0
            else
                0
        else
            0
    elsif str_eq(fname, "matmul") == 1
        if vec_len(args) == 2
            lhs = fused_arg_name(cx, vec_get(args, 0))
            rhs = fused_arg_name(cx, vec_get(args, 1))
            mm = str_as_int(d"mm")
            _p = vec_push(ops, fo_new(FO_MATMUL(), lhs, rhs, mm))
            0
        else
            0
    elsif str_eq(fname, "softmax") == 1
        inp = fused_arg0_name(cx, args)
        sm = str_as_int(d"sm")
        _p = vec_push(ops, fo_new(FO_SOFTMAX(), inp, 0, sm))
        0
    else
        0

fn estimate_peak(r: Int, cx: Int) -> Int ! alloc
    # Simplified peak matching salc_py for static tensors
    ops = vec_get(r, 1)
    estimate_peak_go(r, cx, ops, 0, vec_len(ops), 0, d"", 0)

fn estimate_peak_finish_sym(r: Int, static_total: Int, sym: String) -> Int ! alloc
    _a = vec_set(r, 4, 1)
    if static_total > 0
        pref = int_to_str(static_total)
        plus = d"+"
        s1 = pref + plus
        s2 = s1 + sym
        _b = vec_set(r, 6, str_as_int(s2))
    else
        _b = vec_set(r, 6, str_as_int(sym))
    _c = vec_set(r, 3, 1)
    _d = vec_set(r, 5, static_total)
    0

fn estimate_peak_finish_static(r: Int, static_total: Int, saw: Int) -> Int ! alloc
    if saw == 1
        _c = vec_set(r, 3, 1)
        _d = vec_set(r, 5, static_total)
        0
    elsif static_total > 0
        _c = vec_set(r, 3, 1)
        _d = vec_set(r, 5, static_total)
        0
    else
        0

fn estimate_peak_go(r: Int, cx: Int, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int) -> Int ! alloc
    if i >= n
        if str_len(sym) > 0
            estimate_peak_finish_sym(r, static_total, sym)
        else
            estimate_peak_finish_static(r, static_total, saw)
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_MATMUL()
            estimate_peak_mm(r, cx, ops, i, n, static_total, sym, saw, op)
        else
            estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)

fn append_sym_plus(sym: String, piece: String) -> Int ! alloc
    if str_len(sym) > 0
        plus = d"+"
        s1 = sym + plus
        str_as_int(s1 + piece)
    else
        str_as_int(sym + piece)

fn add_peak_piece(st: Int, sym: String, piece: Int) -> Int ! alloc
    out = vec_new()
    if vec_get(piece, 0) == 1
        _a = vec_push(out, st + vec_get(piece, 1))
        _b = vec_push(out, str_as_int(sym))
        out
    else
        s2 = append_sym_plus(sym, str_from_int(vec_get(piece, 2)))
        _a = vec_push(out, st)
        _b = vec_push(out, s2)
        out

fn estimate_peak_mm(r: Int, cx: Int, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    l = cx_find(cx, vec_get(op, 1))
    w = cx_find(cx, vec_get(op, 2))
    if l == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif w == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif bind_is_tensor(l) == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif bind_is_tensor(w) == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    else
        pa = peak_tensor_piece(l, d"act")
        a1 = add_peak_piece(static_total, sym, pa)
        pw = peak_tensor_piece(w, d"w")
        a2 = add_peak_piece(vec_get(a1, 0), str_from_int(vec_get(a1, 1)), pw)
        po = peak_out_piece(l, w)
        a3 = add_peak_piece(vec_get(a2, 0), str_from_int(vec_get(a2, 1)), po)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a3, 0), str_from_int(vec_get(a3, 1)), 1)

fn peak_tensor_piece(tens: Int, label: String) -> Int ! alloc
    # returns vec [is_static, static_bytes, sym_piece]
    res = vec_new()
    dims = bind_dims(tens)
    conc = bind_concrete(tens)
    nd = bind_ndims(tens)
    eb = bind_elem(tens)
    pr = peak_prod(dims, conc, 0, nd, 1, 0, d"")
    is_dyn = vec_get(pr, 0)
    prod = vec_get(pr, 1)
    parts = vec_get(pr, 2)
    if is_dyn == 1
        _a = vec_push(res, 0)
        _b = vec_push(res, 0)
        col = d":"
        s1 = label + col
        s2 = s1 + str_from_int(parts)
        star = d"*"
        s3 = s2 + star
        ebs = int_to_str(eb)
        s4 = s3 + ebs
        _c = vec_push(res, str_as_int(s4))
        res
    else
        _a = vec_push(res, 1)
        _b = vec_push(res, prod * eb)
        _c = vec_push(res, str_as_int(d""))
        res

fn peak_dyn_parts(parts: String) -> String ! alloc
    if str_len(parts) > 0
        parts + "*?"
    else
        d"?"

fn peak_static_prefix(parts: String) -> String ! alloc
    if str_len(parts) > 0
        parts + "*"
    else
        d""

fn peak_prod(dims: Int, conc: Int, d: Int, nd: Int, prod: Int, dyn: Int, parts: String) -> Int ! alloc
    if d >= nd
        r = vec_new()
        _a = vec_push(r, dyn)
        _b = vec_push(r, prod)
        _c = vec_push(r, str_as_int(parts))
        r
    else
        dv = dim_at(dims, d)
        cv = dim_at(conc, d)
        if dv < 0
            if cv < 0
                np = peak_dyn_parts(parts)
                peak_prod(dims, conc, d + 1, nd, prod, 1, np)
            else
                peak_prod_static(dims, conc, d, nd, prod, dyn, parts, cv)
        else
            peak_prod_static(dims, conc, d, nd, prod, dyn, parts, dv)

fn peak_prod_static(dims: Int, conc: Int, d: Int, nd: Int, prod: Int, dyn: Int, parts: String, v: Int) -> Int ! alloc
    np = peak_static_prefix(parts)
    vs = int_to_str(v)
    np2 = np + vs
    peak_prod(dims, conc, d + 1, nd, prod * v, dyn, np2)

fn peak_out_piece(l: Int, w: Int) -> Int ! alloc
    res = vec_new()
    ld = bind_dims(l)
    lc = bind_concrete(l)
    wd = bind_dims(w)
    wc = bind_concrete(w)
    lnd = bind_ndims(l)
    wnd = bind_ndims(w)
    eb = bind_elem(l)
    od = vec_new()
    oc = vec_new()
    _a = peak_out_fill(od, oc, ld, lc, 0, lnd - 1)
    widx = wnd - 1
    wdv = dim_at(wd, widx)
    wcv = dim_at(wc, widx)
    _b = vec_push(od, wdv)
    _c = vec_push(oc, wcv)
    pr = peak_prod(od, oc, 0, vec_len(od), 1, 0, d"")
    is_dyn = vec_get(pr, 0)
    prod = vec_get(pr, 1)
    parts = vec_get(pr, 2)
    if is_dyn == 1
        lab = d"out:"
        s2 = lab + str_from_int(parts)
        star = d"*"
        s3 = s2 + star
        ebs = int_to_str(eb)
        s4 = s3 + ebs
        _d = vec_push(res, 0)
        _e = vec_push(res, 0)
        _f = vec_push(res, str_as_int(s4))
        res
    else
        _d = vec_push(res, 1)
        _e = vec_push(res, prod * eb)
        _f = vec_push(res, str_as_int(d""))
        res

fn peak_out_fill(od: Int, oc: Int, ld: Int, lc: Int, d: Int, n: Int) -> Int ! alloc
    if d >= n
        0
    else
        dv = dim_at(ld, d)
        cv = dim_at(lc, d)
        _a = vec_push(od, dv)
        _b = vec_push(oc, cv)
        peak_out_fill(od, oc, ld, lc, d + 1, n)

fn str_add_name(e: Int, env: Int, into_acc: Int) -> Int ! alloc
    if into_acc == 1
        str_as_int(d"sal_str_append")
    elsif binary_add_uses_append(e, env) == 1
        str_as_int(d"sal_str_append")
    else
        str_as_int(d"sal_str_concat")

# `left` is the accumulator of an `x = x + ...` chain being lowered.
fn add_left_is_acc(left: Int, acc: Int) -> Int ! alloc
    if acc == 0
        0
    elsif ex_kind(left) == EX_IDENT()
        str_eq(vec_get(left, 1), acc)
    else
        0

fn spine_acc(left: Int, acc: Int) -> Int ! alloc
    if ex_kind(left) == EX_BINARY()
        acc
    else
        0

fn lower_str_add(cx: Int, e: Int) -> Int ! alloc
    # Only the left spine of the chain may see the accumulator.
    acc = cx_acc(cx)
    left = vec_get(e, 2)
    right = vec_get(e, 3)
    _s = cx_set_acc(cx, spine_acc(left, acc))
    l = lower_expr(cx, left)
    _z = cx_set_acc(cx, 0)
    r = lower_expr(cx, right)
    d = fresh(cx)
    args = vec_new()
    _a = vec_push(args, l)
    _b = vec_push(args, r)
    fnm = str_add_name(e, cx_strenv(cx), add_left_is_acc(left, acc))
    _p = ir_push(cx, ir_call(d, fnm, args, 1))
    if add_right_is_fresh_temp(right, cx_strenv(cx)) == 1
        fargs = vec_new()
        _f = vec_push(fargs, r)
        _q = ir_push(cx, ir_call(0, str_as_int(d"sal_free"), fargs, 0))
    else
        _q = 0
    d

fn lower_expr(cx: Int, e: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_INT()
            d = fresh(cx)
            _p = push_const_int(cx, d, vec_get(e, 1))
            d
        elsif k == EX_FLOAT()
            d = fresh(cx)
            _p = push_const_int(cx, d, 0)
            d
        elsif k == EX_STRING()
            d = fresh(cx)
            _p = ir_push(cx, ir_cs(d, vec_get(e, 1)))
            d
        elsif k == EX_IDENT()
            cx_lookup(cx, vec_get(e, 1))
        elsif k == EX_BINARY()
            if binary_add_is_string_concat(e, cx_strenv(cx)) == 1
                lower_str_add(cx, e)
            else
                l = lower_expr(cx, vec_get(e, 2))
                r = lower_expr(cx, vec_get(e, 3))
                d = fresh(cx)
                _p = ir_push(cx, ir_bin(d, vec_get(e, 1), l, r))
                d
        elsif k == EX_TENSOR()
            fresh(cx)
        elsif k == EX_TO()
            lower_to(cx, e)
        elsif k == EX_ON()
            lower_on(cx, e)
        elsif k == EX_CALL()
            lower_call(cx, e)
        elsif k == EX_FIELD()
            lower_field(cx, e)
        elsif k == EX_IF()
            lower_if(cx, e)
        else
            fresh(cx)

fn lower_field(cx: Int, e: Int) -> Int ! alloc
    lower_expr(cx, vec_get(e, 1))

fn lower_struct_ctor(cx: Int, fname: Int, args: Int) -> Int ! alloc
    if vec_len(args) == 0
        fresh(cx)
    else
        lower_expr(cx, vec_get(args, 0))

fn lower_to(cx: Int, e: Int) -> Int ! alloc
    src = lower_expr(cx, vec_get(e, 2))
    d = fresh(cx)
    _p = ir_push(cx, ir_place(d, src, vec_get(e, 1)))
    dropn = drop_name_for(vec_get(e, 2))
    _q = ir_push(cx, ir_drop(dropn))
    d

fn collect_on_ops(body: Int, cx: Int) -> Int ! alloc
    ops = vec_new()
    if body == 0
        ops
    else
        tail = block_tail(body)
        if tail == 0
            ops
        else
            _a = collect_fused(tail, cx, ops)
            ops

fn fused_flag(has_ep: Int, has_mm: Int, has_col: Int, nops: Int) -> Int ! alloc
    if has_ep == 1
        1
    elsif has_col == 1
        1
    elsif nops > 1
        1
    elsif has_mm == 1
        1
    else
        0

fn lower_on(cx: Int, e: Int) -> Int ! alloc
    ops = collect_on_ops(vec_get(e, 2), cx)
    has_ep = ops_has_kind(ops, FO_EPILOGUE(), 0, vec_len(ops))
    has_mm = ops_has_kind(ops, FO_MATMUL(), 0, vec_len(ops))
    has_col = ops_has_kind(ops, FO_COLUMN(), 0, vec_len(ops))
    fused = fused_flag(has_ep, has_mm, has_col, vec_len(ops))
    reg = region_new(vec_get(e, 1), ops, fused)
    _e = estimate_peak(reg, cx)
    d = fresh(cx)
    _m = lower_on_matmul(cx, ops, d, 0, vec_len(ops))
    _r = vec_push(cx_regions(cx), reg)
    d

fn ops_has_kind(ops: Int, kind: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif vec_get(vec_get(ops, i), 0) == kind
        1
    else
        ops_has_kind(ops, kind, i + 1, n)

fn lower_on_matmul(cx: Int, ops: Int, d: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_MATMUL()
            m = axis_len(cx, vec_get(op, 1), 1)
            k = axis_len(cx, vec_get(op, 1), 0)
            nn = axis_len(cx, vec_get(op, 2), 0)
            args = vec_new()
            _a = vec_push(args, vec_get(op, 1))
            _b = vec_push(args, vec_get(op, 2))
            _c = vec_push(args, m)
            _d = vec_push(args, k)
            _e = vec_push(args, nn)
            fnm = str_as_int(d"sal_matmul_f32")
            _p = ir_push(cx, ir_call(d, fnm, args, 1))
            0
        else
            lower_on_matmul(cx, ops, d, i + 1, n)

fn lower_call(cx: Int, e: Int) -> Int ! alloc
    fname = vec_get(e, 1)
    args = vec_get(e, 2)
    if is_transparent_struct_name(cx, fname) == 1
        lower_struct_ctor(cx, fname, args)
    else
        lower_call_runtime(cx, e, fname, args)

fn lower_call_runtime(cx: Int, e: Int, fname: Int, args: Int) -> Int ! alloc
    out = vec_new()
    arg_names = lower_args(cx, args, 0, vec_len(args), out)
    d = fresh(cx)
    if str_eq(str_from_int(fname), d"load") == 1
        if vec_len(args) > 0
            a0 = vec_get(args, 0)
            if ex_kind(a0) == EX_STRING()
                q1 = d"\""
                mid = str_from_int(vec_get(a0, 1))
                q2 = q1 + mid
                qe = d"\""
                q3 = q2 + qe
                argv = vec_new()
                _a = vec_push(argv, str_as_int(q3))
                _pl = vec_push(argv, str_as_int(d"cpu"))
                fnm = str_as_int(d"sal_load")
                _p = ir_push(cx, ir_call(d, fnm, argv, 1))
                d
            else
                rname = runtime_name(cx, fname)
                _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
                d
        else
            rname = runtime_name(cx, fname)
            _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
            d
    else
        rname = runtime_name(cx, fname)
        _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
        d

fn lower_call_normal(cx: Int, e: Int) -> Int ! alloc
    fname = vec_get(e, 1)
    args = vec_get(e, 2)
    out = vec_new()
    arg_names = lower_args(cx, args, 0, vec_len(args), out)
    d = fresh(cx)
    rname = runtime_name(cx, fname)
    _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
    d

fn lower_if(cx: Int, e: Int) -> Int ! alloc
    c = lower_expr(cx, vec_get(e, 1))
    saved = cx_insts(cx)
    then_env = cx_binds(cx)
    slen = strenv_len(cx_strenv(cx))
    _a = cx_set_insts(cx, vec_new())
    then_b = vec_get(e, 2)
    then_val = lower_block_value(cx, then_b)
    then_body = cx_insts(cx)
    _rs = strenv_set_len(cx_strenv(cx), slen)
    _b = cx_set_insts(cx, vec_new())
    # restore binds shallowly - binds mutated in place; for corpus if rare
    else_b = else_block_for_elsifs(vec_get(e, 3), vec_get(e, 4))
    else_val = lower_block_value(cx, else_b)
    else_body = cx_insts(cx)
    _rs2 = strenv_set_len(cx_strenv(cx), slen)
    _c = cx_set_insts(cx, saved)
    d = fresh(cx)
    inst = vec_new()
    _d = vec_push(inst, II_IF())
    _e = vec_push(inst, d)
    _f = vec_push(inst, c)
    _g = vec_push(inst, then_body)
    _h = vec_push(inst, else_body)
    _i = vec_push(inst, then_val)
    _j = vec_push(inst, else_val)
    _p = ir_push(cx, inst)
    d

fn lower_block_value(cx: Int, b: Int) -> Int ! alloc
    if b == 0
        d = fresh(cx)
        _p = push_const_int(cx, d, 0)
        d
    else
        stmts = block_stmts(b)
        _a = lower_stmts(cx, stmts, 0, vec_len(stmts))
        tail = block_tail(b)
        if tail == 0
            d = fresh(cx)
            _p = push_const_int(cx, d, 0)
            d
        else
            lower_expr(cx, tail)

fn lower_stmts(cx: Int, stmts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(stmts, i)
        is_as = vec_get(st, 0)
        if is_as == 1
            ex = vec_get(st, 2)
            if assign_accumulates_string(vec_get(st, 1), ex, cx_strenv(cx)) == 1
                _sa = cx_set_acc(cx, vec_get(st, 1))
            else
                _sa = cx_set_acc(cx, 0)
            v = lower_expr(cx, ex)
            _za = cx_set_acc(cx, 0)
            _b = cx_bind(cx, vec_get(st, 1), v)
            _ns = strenv_bind(cx_strenv(cx), vec_get(st, 1), expr_type(ex, cx_strenv(cx)))
            # tensor literal assign
            if ex_kind(ex) == EX_TENSOR()
                bb = cx_find(cx, vec_get(st, 1))
                if bb == 0
                    _x = 0
                else
                    _t = bind_set_tensor(bb, 1)
                    _n = bind_set_ndims(bb, 2)
                    dims = bind_dims(bb)
                    conc = bind_concrete(bb)
                    _p = vec_push(dims, vec_get(ex, 1))
                    _q = vec_push(dims, vec_get(ex, 2))
                    _r = vec_push(conc, vec_get(ex, 1))
                    _s = vec_push(conc, vec_get(ex, 2))
            else
                _x = 0
        else
            _v = lower_expr(cx, vec_get(st, 2))
        lower_stmts(cx, stmts, i + 1, n)

fn lower_fn(f: Int, fn_names: Int, fm: Int, struct_map: Int, fnrets: Int) -> Int ! alloc
    cx = cx_new(fn_names, fm, struct_map, fnrets)
    params = vec_get(f, 1)
    _a = lower_params(cx, params, 0, vec_len(params))
    body = vec_get(f, 2)
    stmts = block_stmts(body)
    _b = lower_stmts(cx, stmts, 0, vec_len(stmts))
    tail = block_tail(body)
    if tail == 0
        _c = 0
    else
        v = lower_expr(cx, tail)
        _c = ir_push(cx, ir_ret(v))
    out = vec_new()
    _d = vec_push(out, vec_get(f, 0))
    _e = vec_push(out, cx_dim_params(cx))
    _f = vec_push(out, cx_insts(cx))
    _g = vec_push(out, cx_regions(cx))
    out

fn lower_program(prog: Int) -> Int ! alloc
    lower_program_with_callables(prog, vec_new())

fn lower_program_with_callables(prog: Int, extra: Int) -> Int ! alloc
    lower_program_with_types(prog, extra, struct_map_from_prog(prog), fnret_map_from_prog(prog))

# `sm` and `fr` may cover the whole module graph, so `+` types imported
# struct fields and imported fn results the way the bootstrap does.
fn lower_program_with_types(prog: Int, extra: Int, sm: Int, fr: Int) -> Int ! alloc
    fns = prog_fns(prog)
    names = collect_fn_names(fns, 0, vec_len(fns), vec_new())
    names = merge_callable_names(extra, names)
    fm = map_new()
    _i = fill_fn_map(fm, names, 0, vec_len(names))
    out = vec_new()
    lower_fns(fns, names, fm, sm, fr, 0, vec_len(fns), out)

fn lower_fns(fns: Int, names: Int, fm: Int, sm: Int, fr: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        irf = lower_fn(vec_get(fns, i), names, fm, sm, fr)
        _p = vec_push(out, irf)
        lower_fns(fns, names, fm, sm, fr, i + 1, n, out)
