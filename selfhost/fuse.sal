# Fusion, peak_bytes, and the lowering that builds fused regions.
# lower_program calls fusion; fusion reads ir.sal. Keeping both here avoids an import cycle.
import ast
import ir
import tensorops
import drops
import ownership

fn FO_MATMUL() -> Int
    0

fn FO_EPILOGUE() -> Int
    1

fn FO_SOFTMAX() -> Int
    2

fn FO_COLUMN() -> Int
    3

fn lower_args(cx: Int, args: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = vec_get(args, i)
        v = lower_expr(cx, a)
        _p = vec_push(out, v)
        lower_args(cx, args, i + 1, n, out)

fn collect_fused(e: Int, cx: Int, ops: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_CALL()
            args = vec_get(e, 2)
            _a = collect_fused_args(args, cx, ops, 0, vec_len(args))
            fname = vec_get(e, 1)
            collect_fused_call(e, cx, ops, fname, args)
        elsif k == EX_BINARY()
            _a = collect_fused(vec_get(e, 2), cx, ops)
            _b = collect_fused(vec_get(e, 3), cx, ops)
            collect_fused_binary(e, cx, ops)
        else
            0

fn collect_fused_args(args: Int, cx: Int, ops: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = collect_fused(vec_get(args, i), cx, ops)
        collect_fused_args(args, cx, ops, i + 1, n)

fn fo_new(kind: Int, a: Int, b: Int, c: Int) -> Int ! alloc
    o = vec_new()
    _a = vec_push(o, kind)
    _b = vec_push(o, a)
    _c = vec_push(o, b)
    _d = vec_push(o, c)
    o

fn fo_column(op: Int, lhs: Int, rhs: Int, dest: Int, scalar: Int) -> Int ! alloc
    o = fo_new(FO_COLUMN(), op, lhs, rhs)
    _e = vec_push(o, dest)
    o

fn fused_rhs_is_scalar(right: Int) -> Int ! alloc
    k = ex_kind(right)
    if k == EX_INT()
        1
    elsif k == EX_FLOAT()
        1
    else
        0

fn fused_arg_name(cx: Int, a: Int) -> Int ! alloc
    if ex_kind(a) == EX_IDENT()
        cx_lookup(cx, vec_get(a, 1))
    else
        str_as_int(d"tmp")

fn fused_arg0_name(cx: Int, args: Int) -> Int ! alloc
    if vec_len(args) > 0
        fused_arg_name(cx, vec_get(args, 0))
    else
        str_as_int(d"tmp")

fn fused_op_is_matmul(op: Int) -> Int ! alloc
    if op == 0
        0
    elsif vec_len(op) < 4
        0
    elsif vec_get(op, 0) == FO_MATMUL()
        1
    else
        0

fn fused_ops_valid_count(ops: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_len(op) == 0
            fused_ops_valid_count(ops, i + 1, n)
        else
            rest = fused_ops_valid_count(ops, i + 1, n)
            1 + rest

fn collect_fused_binary(e: Int, cx: Int, ops: Int) -> Int ! alloc
    left = vec_get(e, 2)
    right = vec_get(e, 3)
    op = vec_get(e, 1)
    lhs = fused_arg_name(cx, left)
    rhs = fused_arg_name(cx, right)
    idx = fused_ops_valid_count(ops, 0, vec_len(ops))
    dest = str_as_int(d"col_" + int_to_str(idx))
    scal = 0
    if fused_rhs_is_scalar(right) == 1
        scal = str_as_int(d"tmp")
    else
        scal = 0
    oprec = fo_column(op, lhs, rhs, dest, scal)
    _p = vec_push(ops, oprec)
    0

fn collect_fused_call(e: Int, cx: Int, ops: Int, fname: Int, args: Int) -> Int ! alloc
    nops = vec_len(ops)
    if str_eq(fname, "relu") == 1
        if nops > 0
            last = vec_get(ops, nops - 1)
            if fused_op_is_matmul(last) == 1
                mmc = vec_get(last, 3)
                ep = d"_epilogue"
                dest = str_from_int(mmc) + ep
                _p = vec_push(ops, fo_new(FO_EPILOGUE(), fname, mmc, str_as_int(dest)))
                0
            else
                0
        else
            0
    elsif str_eq(fname, "map") == 1
        if nops > 0
            last = vec_get(ops, nops - 1)
            if fused_op_is_matmul(last) == 1
                mmc = vec_get(last, 3)
                ep = d"_epilogue"
                dest = str_from_int(mmc) + ep
                _p = vec_push(ops, fo_new(FO_EPILOGUE(), fname, mmc, str_as_int(dest)))
                0
            else
                0
        else
            0
    elsif str_eq(fname, "matmul") == 1
        if vec_len(args) == 2
            lhs = fused_arg_name(cx, vec_get(args, 0))
            rhs = fused_arg_name(cx, vec_get(args, 1))
            mm = str_as_int(d"mm")
            _p = vec_push(ops, fo_new(FO_MATMUL(), lhs, rhs, mm))
            0
        else
            0
    elsif str_eq(fname, "softmax") == 1
        inp = fused_arg0_name(cx, args)
        sm = str_as_int(d"sm")
        _p = vec_push(ops, fo_new(FO_SOFTMAX(), inp, 0, sm))
        0
    else
        0

fn estimate_peak(r: Int, cx: Int) -> Int ! alloc
    # Simplified peak matching salc_py for static tensors
    ops = vec_get(r, 1)
    estimate_peak_go(r, cx, ops, 0, vec_len(ops), 0, d"", 0)

fn estimate_peak_finish_sym(r: Int, static_total: Int, sym: String) -> Int ! alloc
    _a = vec_set(r, 4, 1)
    if static_total > 0
        pref = int_to_str(static_total)
        plus = d"+"
        s1 = pref + plus
        s2 = s1 + sym
        _b = vec_set(r, 6, str_as_int(s2))
    else
        _b = vec_set(r, 6, str_as_int(sym))
    _c = vec_set(r, 3, 1)
    _d = vec_set(r, 5, static_total)
    0

fn estimate_peak_finish_static(r: Int, static_total: Int, saw: Int) -> Int ! alloc
    if saw == 1
        _c = vec_set(r, 3, 1)
        _d = vec_set(r, 5, static_total)
        0
    elsif static_total > 0
        _c = vec_set(r, 3, 1)
        _d = vec_set(r, 5, static_total)
        0
    else
        0

fn estimate_peak_go(r: Int, cx: Int, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int) -> Int ! alloc
    if i >= n
        if str_len(sym) > 0
            estimate_peak_finish_sym(r, static_total, sym)
        else
            estimate_peak_finish_static(r, static_total, saw)
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_MATMUL()
            estimate_peak_mm(r, cx, ops, i, n, static_total, sym, saw, op)
        elsif vec_get(op, 0) == FO_COLUMN()
            estimate_peak_col(r, cx, ops, i, n, static_total, sym, saw, op)
        elsif vec_get(op, 0) == FO_SOFTMAX()
            estimate_peak_softmax(r, cx, ops, i, n, static_total, sym, saw, op)
        else
            estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)

# A binding by variable name, else by the SSA value it holds.
fn cx_find_any(cx: Int, name: Int) -> Int ! alloc
    b = cx_find(cx, name)
    if b == 0
        bind_for_ssa(cx, name)
    else
        b

fn estimate_peak_softmax(r: Int, cx: Int, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    inp = cx_find_any(cx, vec_get(op, 1))
    if inp == 0
        piece = "softmax(" + str_from_int(vec_get(op, 1)) + "):symbolic"
        s2 = append_sym_plus(sym, piece)
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    elsif bind_is_tensor(inp) == 0
        piece = "softmax(" + str_from_int(vec_get(op, 1)) + "):symbolic"
        s2 = append_sym_plus(sym, piece)
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    else
        pa = peak_tensor_piece(inp, d"softmax")
        a1 = add_peak_piece(static_total, sym, pa)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a1, 0), str_from_int(vec_get(a1, 1)), 1)

fn estimate_peak_col(r: Int, cx: Int, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    lhs = cx_find_any(cx, vec_get(op, 2))
    if lhs == 0
        piece = str_as_int(d"column_bin(tmp):symbolic")
        s2 = append_sym_plus(sym, str_from_int(piece))
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    elsif bind_is_tensor(lhs) == 0
        piece = str_as_int(d"column_bin(tmp):symbolic")
        s2 = append_sym_plus(sym, str_from_int(piece))
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, str_from_int(s2), saw)
    else
        pa = peak_tensor_piece(lhs, d"col")
        pa2 = peak_column_piece(pa)
        a1 = add_peak_piece(static_total, sym, pa2)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a1, 0), str_from_int(vec_get(a1, 1)), 1)

fn peak_column_piece(pa: Int) -> Int ! alloc
    res = vec_new()
    if vec_get(pa, 0) == 1
        _a = vec_push(res, 1)
        _b = vec_push(res, vec_get(pa, 1) * 2)
        _c = vec_push(res, vec_get(pa, 2))
        res
    else
        pa

fn append_sym_plus(sym: String, piece: String) -> Int ! alloc
    if str_len(sym) > 0
        plus = d"+"
        s1 = sym + plus
        str_as_int(s1 + piece)
    else
        str_as_int(sym + piece)

fn add_peak_piece(st: Int, sym: String, piece: Int) -> Int ! alloc
    out = vec_new()
    if vec_get(piece, 0) == 1
        _a = vec_push(out, st + vec_get(piece, 1))
        _b = vec_push(out, str_as_int(sym))
        out
    else
        s2 = append_sym_plus(sym, str_from_int(vec_get(piece, 2)))
        _a = vec_push(out, st)
        _b = vec_push(out, s2)
        out

fn estimate_peak_mm(r: Int, cx: Int, ops: Int, i: Int, n: Int, static_total: Int, sym: String, saw: Int, op: Int) -> Int ! alloc
    l = cx_find_any(cx, vec_get(op, 1))
    w = cx_find_any(cx, vec_get(op, 2))
    if l == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif w == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif bind_is_tensor(l) == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    elsif bind_is_tensor(w) == 0
        estimate_peak_go(r, cx, ops, i + 1, n, static_total, sym, saw)
    else
        pa = peak_tensor_piece(l, d"act")
        a1 = add_peak_piece(static_total, sym, pa)
        pw = peak_tensor_piece(w, d"w")
        a2 = add_peak_piece(vec_get(a1, 0), str_from_int(vec_get(a1, 1)), pw)
        po = peak_out_piece(l, w)
        a3 = add_peak_piece(vec_get(a2, 0), str_from_int(vec_get(a2, 1)), po)
        estimate_peak_go(r, cx, ops, i + 1, n, vec_get(a3, 0), str_from_int(vec_get(a3, 1)), 1)

fn peak_tensor_piece(tens: Int, label: String) -> Int ! alloc
    # returns vec [is_static, static_bytes, sym_piece]
    res = vec_new()
    dims = bind_dims(tens)
    conc = bind_concrete(tens)
    nd = bind_ndims(tens)
    eb = bind_elem(tens)
    pr = peak_prod(dims, conc, 0, nd, 1, 0, d"")
    is_dyn = vec_get(pr, 0)
    prod = vec_get(pr, 1)
    parts = vec_get(pr, 2)
    if is_dyn == 1
        _a = vec_push(res, 0)
        _b = vec_push(res, 0)
        col = d":"
        s1 = label + col
        s2 = s1 + str_from_int(parts)
        star = d"*"
        s3 = s2 + star
        ebs = int_to_str(eb)
        s4 = s3 + ebs
        _c = vec_push(res, str_as_int(s4))
        res
    else
        _a = vec_push(res, 1)
        _b = vec_push(res, prod * eb)
        _c = vec_push(res, str_as_int(d""))
        res

fn peak_dyn_parts(parts: String) -> String ! alloc
    if str_len(parts) > 0
        parts + "*?"
    else
        d"?"

fn peak_static_prefix(parts: String) -> String ! alloc
    if str_len(parts) > 0
        parts + "*"
    else
        d""

fn peak_prod(dims: Int, conc: Int, d: Int, nd: Int, prod: Int, dyn: Int, parts: String) -> Int ! alloc
    if d >= nd
        r = vec_new()
        _a = vec_push(r, dyn)
        _b = vec_push(r, prod)
        _c = vec_push(r, str_as_int(parts))
        r
    else
        dv = dim_at(dims, d)
        cv = dim_at(conc, d)
        if dv < 0
            if cv < 0
                np = peak_dyn_parts(parts)
                peak_prod(dims, conc, d + 1, nd, prod, 1, np)
            else
                peak_prod_static(dims, conc, d, nd, prod, dyn, parts, cv)
        else
            peak_prod_static(dims, conc, d, nd, prod, dyn, parts, dv)

fn peak_prod_static(dims: Int, conc: Int, d: Int, nd: Int, prod: Int, dyn: Int, parts: String, v: Int) -> Int ! alloc
    np = peak_static_prefix(parts)
    vs = int_to_str(v)
    np2 = np + vs
    peak_prod(dims, conc, d + 1, nd, prod * v, dyn, np2)

fn peak_out_piece(l: Int, w: Int) -> Int ! alloc
    res = vec_new()
    ld = bind_dims(l)
    lc = bind_concrete(l)
    wd = bind_dims(w)
    wc = bind_concrete(w)
    lnd = bind_ndims(l)
    wnd = bind_ndims(w)
    eb = bind_elem(l)
    od = vec_new()
    oc = vec_new()
    _a = peak_out_fill(od, oc, ld, lc, 0, lnd - 1)
    widx = wnd - 1
    wdv = dim_at(wd, widx)
    wcv = dim_at(wc, widx)
    _b = vec_push(od, wdv)
    _c = vec_push(oc, wcv)
    pr = peak_prod(od, oc, 0, vec_len(od), 1, 0, d"")
    is_dyn = vec_get(pr, 0)
    prod = vec_get(pr, 1)
    parts = vec_get(pr, 2)
    if is_dyn == 1
        lab = d"out:"
        s2 = lab + str_from_int(parts)
        star = d"*"
        s3 = s2 + star
        ebs = int_to_str(eb)
        s4 = s3 + ebs
        _d = vec_push(res, 0)
        _e = vec_push(res, 0)
        _f = vec_push(res, str_as_int(s4))
        res
    else
        _d = vec_push(res, 1)
        _e = vec_push(res, prod * eb)
        _f = vec_push(res, str_as_int(d""))
        res

fn peak_out_fill(od: Int, oc: Int, ld: Int, lc: Int, d: Int, n: Int) -> Int ! alloc
    if d >= n
        0
    else
        dv = dim_at(ld, d)
        cv = dim_at(lc, d)
        _a = vec_push(od, dv)
        _b = vec_push(oc, cv)
        peak_out_fill(od, oc, ld, lc, d + 1, n)

fn str_add_name(e: Int, env: Int, into_acc: Int) -> Int ! alloc
    if into_acc == 1
        str_as_int(d"sal_str_append")
    elsif binary_add_uses_append(e, env) == 1
        str_as_int(d"sal_str_append")
    else
        str_as_int(d"sal_str_concat")

# `left` is the accumulator of an `x = x + ...` chain being lowered.
fn add_left_is_acc(left: Int, acc: Int) -> Int ! alloc
    if acc == 0
        0
    elsif ex_kind(left) == EX_IDENT()
        str_eq(vec_get(left, 1), acc)
    else
        0

fn spine_acc(left: Int, acc: Int) -> Int ! alloc
    if ex_kind(left) == EX_BINARY()
        acc
    else
        0

fn lower_str_add(cx: Int, e: Int) -> Int ! alloc
    # Only the left spine of the chain may see the accumulator.
    acc = cx_acc(cx)
    left = vec_get(e, 2)
    right = vec_get(e, 3)
    _s = cx_set_acc(cx, spine_acc(left, acc))
    l = lower_expr(cx, left)
    _z = cx_set_acc(cx, 0)
    r = lower_expr(cx, right)
    d = fresh(cx)
    args = vec_new()
    _a = vec_push(args, l)
    _b = vec_push(args, r)
    fnm = str_add_name(e, cx_strenv(cx), add_left_is_acc(left, acc))
    _p = ir_push(cx, ir_call(d, fnm, args, 1))
    if add_right_is_fresh_temp(right, cx_strenv(cx)) == 1
        fargs = vec_new()
        _f = vec_push(fargs, r)
        _q = ir_push(cx, ir_call(0, str_as_int(d"sal_free"), fargs, 0))
    else
        _q = 0
    if str_eq(fnm, "sal_str_concat") == 1
        if add_left_is_fresh_call(left) == 1
            largs = vec_new()
            _g = vec_push(largs, l)
            _h = ir_push(cx, ir_call(0, str_as_int(d"sal_free"), largs, 0))
    d

fn lower_expr(cx: Int, e: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_INT()
            d = fresh(cx)
            _p = push_const_int(cx, d, vec_get(e, 1))
            d
        elsif k == EX_FLOAT()
            d = fresh(cx)
            bits = vec_get(e, 1)
            txt = vec_get(e, 2)
            _p = ir_push(cx, ir_cf(d, bits, txt))
            d
        elsif k == EX_STRING()
            d = fresh(cx)
            _p = ir_push(cx, ir_cs(d, vec_get(e, 1)))
            d
        elsif k == EX_IDENT()
            cx_lookup(cx, vec_get(e, 1))
        elsif k == EX_BINARY()
            if binary_add_is_string_concat(e, cx_strenv(cx)) == 1
                lower_str_add(cx, e)
            else
                l = lower_expr(cx, vec_get(e, 2))
                r = lower_expr(cx, vec_get(e, 3))
                d = fresh(cx)
                if try_lower_tensor_bin(cx, e, l, r, d) == 1
                    d
                else
                    _p = ir_push(cx, ir_bin(d, binary_ir_op(e, cx_strenv(cx)), l, r))
                    d
        elsif k == EX_TENSOR()
            d = fresh(cx)
            lit = vec_new()
            _l0 = vec_push(lit, d)
            _l1 = vec_push(lit, tensor_lit_data(e))
            _l2 = vec_push(cx_literals(cx), lit)
            d
        elsif k == EX_TO()
            lower_to(cx, e)
        elsif k == EX_ON()
            lower_on(cx, e)
        elsif k == EX_CALL()
            lower_call(cx, e)
        elsif k == EX_FIELD()
            lower_field(cx, e)
        elsif k == EX_IF()
            lower_if(cx, e)
        elsif k == EX_WHILE()
            lower_while(cx, e)
        elsif k == EX_BOOL()
            d = fresh(cx)
            _p = push_const_int(cx, d, vec_get(e, 1))
            d
        elsif k == EX_UNARY()
            inner = lower_expr(cx, vec_get(e, 2))
            d = fresh(cx)
            uop = if str_eq(vec_get(e, 1), "neg") == 1
                if expr_is_float(vec_get(e, 2), cx_strenv(cx)) == 1
                    str_as_int(d"fneg")
                else
                    vec_get(e, 1)
            else
                vec_get(e, 1)
            _p = ir_push(cx, ir_bin(d, uop, inner, str_as_int(d"0")))
            d
        else
            fresh(cx)

fn lower_field(cx: Int, e: Int) -> Int ! alloc
    base = lower_expr(cx, vec_get(e, 1))
    sname = expr_type(vec_get(e, 1), cx_strenv(cx))
    sd = struct_find(cx_struct_map(cx), sname)
    if sd == 0
        base
    elsif structdef_field_count(sd) == 1
        base
    else
        idx = field_index_go(structdef_fields(sd), vec_get(e, 2), 0, structdef_field_count(sd))
        if idx < 0
            base
        else
            d = fresh(cx)
            _p = ir_push(cx, ir_extract(d, base, structdef_name(sd), idx))
            d

# `S(a, b)`: a single field is the field itself (newtype); more become an Aggregate.
fn lower_struct_ctor(cx: Int, fname: Int, args: Int) -> Int ! alloc
    arg_names = lower_args(cx, args, 0, vec_len(args), vec_new())
    d = fresh(cx)
    if vec_len(arg_names) == 1
        vec_get(arg_names, 0)
    else
        _p = ir_push(cx, ir_agg(d, fname, arg_names))
        d

# The result of `to <place> x` is a tensor of x's shape on that place.
fn register_to_tensor(cx: Int, d: Int, src: Int, place: Int) -> Int ! alloc
    b = find_tensor(cx, src)
    if b == 0
        0
    else
        reg_tensor(cx, d, bind_elem(b), place, vec_copy(bind_dims(b)), vec_copy(bind_concrete(b)))

fn lower_to(cx: Int, e: Int) -> Int ! alloc
    src = lower_expr(cx, vec_get(e, 2))
    d = fresh(cx)
    _p = ir_push(cx, ir_place(d, src, vec_get(e, 1)))
    _t = register_to_tensor(cx, d, src, vec_get(e, 1))
    dropn = drop_name_for(vec_get(e, 2))
    _q = ir_push(cx, ir_drop(dropn))
    d

fn collect_on_ops(body: Int, cx: Int) -> Int ! alloc
    ops = vec_new()
    _seed = vec_push(ops, vec_new())
    if body == 0
        fused_ops_drop_empty(ops)
    else
        tail = block_tail(body)
        if tail == 0
            fused_ops_drop_empty(ops)
        else
            if ex_kind(tail) == EX_BINARY()
                bins = vec_new()
                _f = flatten_column_bins(tail, bins)
                _c = collect_column_bins(bins, cx, ops, 0, vec_len(bins))
            else
                _a = collect_fused(tail, cx, ops)
            fused_ops_drop_empty(ops)

fn flatten_column_bins(e: Int, out: Int) -> Int ! alloc
    if e == 0
        0
    elsif ex_kind(e) == EX_BINARY()
        _l = flatten_column_bins(vec_get(e, 2), out)
        _r = flatten_column_bins(vec_get(e, 3), out)
        _p = vec_push(out, e)
        0
    else
        0

fn collect_column_bins(bins: Int, cx: Int, ops: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _c = collect_fused_binary(vec_get(bins, i), cx, ops)
        collect_column_bins(bins, cx, ops, i + 1, n)

fn fused_ops_drop_empty(ops: Int) -> Int ! alloc
    out = vec_new()
    _c = fused_ops_drop_empty_go(ops, out, 0, vec_len(ops))
    out

fn fused_ops_drop_empty_go(ops: Int, out: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_len(op) > 0
            _p = vec_push(out, op)
        fused_ops_drop_empty_go(ops, out, i + 1, n)

fn fused_flag(has_ep: Int, has_mm: Int, has_col: Int, nops: Int) -> Int ! alloc
    if has_ep == 1
        1
    elsif has_col == 1
        1
    elsif nops > 1
        1
    elsif has_mm == 1
        1
    else
        0

fn lower_on(cx: Int, e: Int) -> Int ! alloc
    ops = collect_on_ops(vec_get(e, 2), cx)
    has_ep = ops_has_kind(ops, FO_EPILOGUE(), 0, vec_len(ops))
    has_mm = ops_has_kind(ops, FO_MATMUL(), 0, vec_len(ops))
    has_col = ops_has_kind(ops, FO_COLUMN(), 0, vec_len(ops))
    fused = fused_flag(has_ep, has_mm, has_col, vec_len(ops))
    reg = region_new(vec_get(e, 1), ops, fused)
    _e = estimate_peak(reg, cx)
    if has_col == 0
        if has_mm == 0
            _r = vec_push(cx_regions(cx), reg)
            lower_block_value(cx, vec_get(e, 2))
        else
            d = fresh(cx)
            _m = lower_on_matmul(cx, ops, d, 0, vec_len(ops))
            _r = vec_push(cx_regions(cx), reg)
            if has_ep == 1
                lower_fused_epilogue_out(cx, ops, d, 0, vec_len(ops))
            else
                d
    else
        _r = vec_push(cx_regions(cx), reg)
        lower_block_value(cx, vec_get(e, 2))

fn ops_has_kind(ops: Int, kind: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_len(op) == 0
            ops_has_kind(ops, kind, i + 1, n)
        elsif vec_get(op, 0) == kind
            1
        else
            ops_has_kind(ops, kind, i + 1, n)

fn lower_fused_epilogue_out(cx: Int, ops: Int, src: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        src
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_EPILOGUE()
            ir_call_unary(cx, runtime_name(cx, vec_get(op, 1)), src)
        else
            lower_fused_epilogue_out(cx, ops, src, i + 1, n)

fn lower_on_matmul(cx: Int, ops: Int, d: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        op = vec_get(ops, i)
        if vec_get(op, 0) == FO_MATMUL()
            m = axis_len(cx, vec_get(op, 1), 1)
            k = axis_len(cx, vec_get(op, 1), 0)
            nn = axis_len(cx, vec_get(op, 2), 0)
            args = vec_new()
            _a = vec_push(args, vec_get(op, 1))
            _b = vec_push(args, vec_get(op, 2))
            _c = vec_push(args, m)
            _d = vec_push(args, k)
            _e = vec_push(args, nn)
            fnm = str_as_int(d"sal_matmul_f32")
            _p = ir_push(cx, ir_call(d, fnm, args, 1))
            0
        else
            lower_on_matmul(cx, ops, d, i + 1, n)

fn is_struct_ctor_call(cx: Int, fname: Int, args: Int) -> Int ! alloc
    sd = struct_find(cx_struct_map(cx), fname)
    if sd == 0
        0
    elsif structdef_field_count(sd) == vec_len(args)
        1
    else
        0

fn lower_call(cx: Int, e: Int) -> Int ! alloc
    fname = vec_get(e, 1)
    args = vec_get(e, 2)
    if is_struct_ctor_call(cx, fname, args) == 1
        lower_struct_ctor(cx, fname, args)
    else
        lower_call_runtime(cx, e, fname, args)

# Runtime container kind: Int 0, Float 1, Bool 2, String 3.
fn scalar_kind_text(txt: String, i: Int, j: Int) -> Int ! alloc
    t = trim_type_piece(str_slice(txt, i, j))
    if str_eq(t, "Float") == 1
        1
    elsif str_eq(t, "Bool") == 1
        2
    elsif str_eq(t, "String") == 1
        3
    else
        0

fn trim_type_piece(t: String) -> String ! alloc
    n = str_len(t)
    if n > 0
        if str_char(t, n - 1) == 32
            trim_type_piece(str_slice(t, 0, n - 1))
        else
            t
    else
        t

# `list_new[T]()` passes the element kind; `dict_new[K, V]()` passes both.
fn lower_container_new(cx: Int, e: Int, d: Int, nkinds: Int) -> Int ! alloc
    ta = ex_call_type_args(e)
    txt = d""
    if ta != 0
        txt = str_from_int(ta)
    else
        txt = d""
    comma = find_char(txt, 44, 0, str_len(txt))
    k1 = 0
    k2 = 0
    if comma < 0
        k1 = scalar_kind_text(txt, 0, str_len(txt))
    else
        k1 = scalar_kind_text(txt, 0, comma)
        k2 = scalar_kind_text(txt, comma + 1, str_len(txt))
    argv = vec_new()
    k1d = fresh(cx)
    _a = push_const_int(cx, k1d, k1)
    _b = vec_push(argv, k1d)
    if nkinds == 2
        k2d = fresh(cx)
        _c = push_const_int(cx, k2d, k2)
        _e = vec_push(argv, k2d)
    else
        _e = 0
    _p = ir_push(cx, ir_call(d, str_as_int(d"sal_" + str_from_int(vec_get(e, 1))), argv, 1))
    d

fn lower_call_runtime(cx: Int, e: Int, fname: Int, args: Int) -> Int ! alloc
    out = vec_new()
    arg_names = lower_args(cx, args, 0, vec_len(args), out)
    src = map_lambda_source(cx, fname, args, arg_names)
    if src != 0
        lower_map_lambda(cx, src, vec_get(arg_names, 0), vec_get(args, 1))
    else
        lower_call_runtime_go(cx, e, fname, args, arg_names)

# `map(t, x => body)` over a tensor: the tensor bind it reads, or 0.
fn map_lambda_source(cx: Int, fname: Int, args: Int, arg_names: Int) -> Int ! alloc
    if str_eq(fname, "map") == 0
        0
    elsif vec_len(args) != 2
        0
    elsif ex_kind(vec_get(args, 1)) != EX_LAMBDA()
        0
    else
        find_tensor(cx, vec_get(arg_names, 0))

# The body is lowered with the parameter bound to the tensor, so its operators
# become tensor ops.
fn lower_map_lambda(cx: Int, src: Int, arg: Int, lam: Int) -> Int ! alloc
    param = vec_get(lam, 1)
    prev = cx_find(cx, param)
    b = bind_new(param, arg)
    _t = bind_set_tensor(b, 1)
    _e = bind_set_elem(b, bind_elem(src))
    _p = bind_set_place(b, bind_place(src))
    _n = bind_set_ndims(b, bind_ndims(src))
    _g = register_tensor_ssa_go(b, bind_dims(src), bind_concrete(src), 0, bind_ndims(src))
    _m = map_put(cx_bind_map(cx), param, b)
    r = lower_expr(cx, vec_get(lam, 2))
    _u = map_put(cx_bind_map(cx), param, prev)
    r

fn lower_call_runtime_go(cx: Int, e: Int, fname: Int, args: Int, arg_names: Int) -> Int ! alloc
    d = fresh(cx)
    if str_eq(str_from_int(fname), d"load") == 1
        if vec_len(args) > 0
            a0 = vec_get(args, 0)
            if ex_kind(a0) == EX_STRING()
                q1 = d"\""
                mid = str_from_int(vec_get(a0, 1))
                q2 = q1 + mid
                qe = d"\""
                q3 = q2 + qe
                argv = vec_new()
                _a = vec_push(argv, str_as_int(q3))
                _pl = vec_push(argv, str_as_int(d"cpu"))
                fnm = str_as_int(d"sal_load")
                _p = ir_push(cx, ir_call(d, fnm, argv, 1))
                d
            else
                rname = runtime_name(cx, fname)
                _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
                d
        else
            rname = runtime_name(cx, fname)
            _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
            d
    elsif str_eq(str_from_int(fname), d"where") == 1
        lower_where_call(cx, args, arg_names, d)
    elsif lower_tensor_builtin(cx, fname, args, arg_names, d) == 1
        d
    elsif str_eq(fname, "list_new") == 1
        lower_container_new(cx, e, d, 1)
    elsif str_eq(fname, "dict_new") == 1
        lower_container_new(cx, e, d, 2)
    else
        rname = runtime_name(cx, fname)
        _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
        _r = register_ret_tensor(cx, d, fname)
        d

# A user fn declared to return a tensor gives its result that shape.
fn register_ret_tensor(cx: Int, d: Int, fname: Int) -> Int ! alloc
    if is_user_fn(cx, fname) == 0
        0
    elsif strenv_fnrets(cx_strenv(cx)) == 0
        0
    else
        ret = map_get(strenv_fnrets(cx_strenv(cx)), fname)
        if ret == 0
            0
        elsif str_contains_tensor(str_from_int(ret)) == 0
            0
        else
            b = bind_new(d, d)
            _t = parse_tensor_type(str_from_int(ret), b)
            vec_push(cx_binds(cx), b)

fn frame_name_for_where(cx: Int, e: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_IDENT()
            ty = strenv_type(cx_strenv(cx), vec_get(e, 1))
            if struct_find(cx_struct_map(cx), ty) != 0
                ty
            else
                0
        elsif k == EX_CALL()
            callee = vec_get(e, 1)
            if struct_find(cx_struct_map(cx), callee) != 0
                callee
            else
                ty = expr_type(e, cx_strenv(cx))
                if struct_find(cx_struct_map(cx), ty) != 0
                    ty
                else
                    0
        else
            ty = expr_type(e, cx_strenv(cx))
            if struct_find(cx_struct_map(cx), ty) != 0
                ty
            else
                0

fn where_frame_lit(frame_ty: Int) -> Int ! alloc
    q1 = d"\""
    mid = str_from_int(frame_ty)
    q2 = q1 + mid
    qe = d"\""
    str_as_int(q2 + qe)

fn lower_where_call(cx: Int, args: Int, arg_names: Int, d: Int) -> Int ! alloc
    if vec_len(args) < 2
        _p = push_const_int(cx, d, 0)
        d
    else
        frame_e = vec_get(args, 0)
        mask_e = vec_get(args, 1)
        frame_ty = frame_name_for_where(cx, frame_e)
        if frame_ty == 0
            _p = push_const_int(cx, d, 0)
            d
        else
            frame_ssa = vec_get(arg_names, 0)
            mask_ssa = vec_get(arg_names, 1)
            len_ssa = tensor_row_len_for_expr(cx, mask_e, mask_ssa)
            argv = vec_new()
            _a = vec_push(argv, frame_ssa)
            _b = vec_push(argv, mask_ssa)
            _c = vec_push(argv, len_ssa)
            _d = vec_push(argv, where_frame_lit(frame_ty))
            fnm = str_as_int(d"sal_where")
            _p = ir_push(cx, ir_call(d, fnm, argv, 1))
            d

fn lower_call_normal(cx: Int, e: Int) -> Int ! alloc
    fname = vec_get(e, 1)
    args = vec_get(e, 2)
    out = vec_new()
    arg_names = lower_args(cx, args, 0, vec_len(args), out)
    d = fresh(cx)
    rname = runtime_name(cx, fname)
    _p = ir_push(cx, ir_call(d, rname, arg_names, 1))
    d

fn lower_if(cx: Int, e: Int) -> Int ! alloc
    c = lower_expr(cx, vec_get(e, 1))
    saved = cx_insts(cx)
    binds = cx_binds(cx)
    n0 = vec_len(binds)
    base_snap = snap_binds(binds, 0, n0, vec_new())
    slen = strenv_len(cx_strenv(cx))
    _a = cx_set_insts(cx, vec_new())
    then_b = vec_get(e, 2)
    then_val = lower_block_value(cx, then_b)
    then_body = cx_insts(cx)
    then_snap = snap_binds(binds, 0, n0, vec_new())
    _k1 = kill_new_binds(cx, n0)
    _r1 = restore_binds(binds, base_snap, 0, n0)
    _rs = strenv_set_len(cx_strenv(cx), slen)
    _b = cx_set_insts(cx, vec_new())
    else_b = else_block_for_elsifs(vec_get(e, 3), vec_get(e, 4))
    else_val = lower_block_value(cx, else_b)
    else_body = cx_insts(cx)
    else_snap = snap_binds(binds, 0, n0, vec_new())
    _k2 = kill_new_binds(cx, n0)
    _r2 = restore_binds(binds, base_snap, 0, n0)
    _rs2 = strenv_set_len(cx_strenv(cx), slen)
    _c = cx_set_insts(cx, saved)
    d = fresh(cx)
    order = sorted_live_binds(cx, n0)
    carried = merge_if_carries(cx, order, 0, base_snap, then_snap, else_snap, vec_new())
    inst = vec_new()
    _d = vec_push(inst, II_IF())
    _e = vec_push(inst, d)
    _f = vec_push(inst, c)
    _g = vec_push(inst, then_body)
    _h = vec_push(inst, else_body)
    _i = vec_push(inst, then_val)
    _j = vec_push(inst, else_val)
    _l = vec_push(inst, carried)
    _p = ir_push(cx, inst)
    d

fn snap_binds(binds: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        _p = vec_push(out, bind_ssa(vec_get(binds, i)))
        snap_binds(binds, i + 1, n, out)

fn restore_binds(binds: Int, snap: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _s = bind_set_ssa(vec_get(binds, i), vec_get(snap, i))
        restore_binds(binds, snap, i + 1, n)

# Bindings created inside a branch go out of scope with it.
fn kill_new_binds(cx: Int, n0: Int) -> Int ! alloc
    binds = cx_binds(cx)
    kill_new_binds_go(cx, binds, n0, vec_len(binds))

fn kill_new_binds_go(cx: Int, binds: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        b = vec_get(binds, i)
        if cx_find(cx, bind_name(b)) == b
            _m = map_put(cx_bind_map(cx), bind_name(b), 0)
        else
            _m = 0
        kill_new_binds_go(cx, binds, i + 1, n)

fn str_less_go(a: Int, b: Int, i: Int, na: Int, nb: Int) -> Int ! alloc
    if i >= na
        if i < nb
            1
        else
            0
    elsif i >= nb
        0
    elsif str_char(a, i) < str_char(b, i)
        1
    elsif str_char(a, i) > str_char(b, i)
        0
    else
        str_less_go(a, b, i + 1, na, nb)

fn str_less(a: Int, b: Int) -> Int ! alloc
    str_less_go(a, b, 0, str_len(a), str_len(b))

# Indices of the live bindings among the first n0, ordered by name.
fn sorted_live_binds(cx: Int, n0: Int) -> Int ! alloc
    sorted_live_binds_go(cx, cx_binds(cx), 0, n0, vec_new())

fn sorted_live_binds_go(cx: Int, binds: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        b = vec_get(binds, i)
        if cx_find(cx, bind_name(b)) == b
            _p = sorted_insert(binds, out, i, vec_len(out))
        else
            _p = 0
        sorted_live_binds_go(cx, binds, i + 1, n, out)

# Insert index `idx` into `out` keeping names ascending.
fn sorted_insert(binds: Int, out: Int, idx: Int, at: Int) -> Int ! alloc
    _p = vec_push(out, idx)
    sorted_bubble(binds, out, at)

fn sorted_bubble(binds: Int, out: Int, j: Int) -> Int ! alloc
    if j <= 0
        0
    else
        a = vec_get(out, j - 1)
        b = vec_get(out, j)
        if str_less(bind_name(vec_get(binds, b)), bind_name(vec_get(binds, a))) == 1
            _x = vec_set(out, j - 1, b)
            _y = vec_set(out, j, a)
            sorted_bubble(binds, out, j - 1)
        else
            0

fn merge_if_carries(cx: Int, order: Int, k: Int, base: Int, ts: Int, es: Int, out: Int) -> Int ! alloc
    if k >= vec_len(order)
        out
    else
        i = vec_get(order, k)
        b = vec_get(cx_binds(cx), i)
        base_v = vec_get(base, i)
        t = vec_get(ts, i)
        e = vec_get(es, i)
        if str_eq(t, base_v) == 1
            if str_eq(e, base_v) == 1
                _s = 0
            else
                _s = carry_one(cx, b, t, e, out)
        else
            _s = carry_one(cx, b, t, e, out)
        merge_if_carries(cx, order, k + 1, base, ts, es, out)

fn carry_one(cx: Int, b: Int, t: Int, e: Int, out: Int) -> Int ! alloc
    if str_eq(t, e) == 1
        bind_set_ssa(b, t)
    else
        dest = fresh(cx)
        _s = bind_set_ssa(b, dest)
        c = vec_new()
        _a = vec_push(c, dest)
        _b = vec_push(c, t)
        _c = vec_push(c, e)
        vec_push(out, c)

# ---- while ----
# Names assigned (not `let`) anywhere in a block, as the bootstrap's collect_assigned_*.
fn assigned_add(names: Int, name: Int) -> Int ! alloc
    if assigned_has(names, name, 0, vec_len(names)) == 0
        vec_push(names, name)
    else
        0

fn assigned_has(names: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(names, i), name) == 1
        1
    else
        assigned_has(names, name, i + 1, n)

fn assigned_stmts(stmts: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(stmts, i)
        if vec_get(st, 0) == 1
            if vec_get(st, 4) == 0
                _a = assigned_add(names, vec_get(st, 1))
            else
                _a = 0
        else
            _a = 0
        _b = assigned_expr(vec_get(st, 2), names)
        assigned_stmts(stmts, i + 1, n, names)

fn assigned_block(b: Int, names: Int) -> Int ! alloc
    if b == 0
        0
    else
        stmts = block_stmts(b)
        _a = assigned_stmts(stmts, 0, vec_len(stmts), names)
        assigned_expr(block_tail(b), names)

fn assigned_args(args: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = assigned_expr(vec_get(args, i), names)
        assigned_args(args, i + 1, n, names)

fn assigned_arms(arms: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = vec_get(arms, i)
        _a = assigned_expr(vec_get(arm, 0), names)
        _b = assigned_block(vec_get(arm, 1), names)
        assigned_arms(arms, i + 1, n, names)

fn assigned_expr(e: Int, names: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_IF()
            _a = assigned_expr(vec_get(e, 1), names)
            _b = assigned_block(vec_get(e, 2), names)
            arms = vec_get(e, 4)
            _c = assigned_arms(arms, 0, vec_len(arms), names)
            assigned_block(vec_get(e, 3), names)
        elsif k == EX_ON()
            assigned_block(vec_get(e, 2), names)
        elsif k == EX_WHILE()
            _a = assigned_expr(vec_get(e, 1), names)
            assigned_block(vec_get(e, 2), names)
        elsif k == EX_CALL()
            args = vec_get(e, 2)
            assigned_args(args, 0, vec_len(args), names)
        elsif k == EX_BINARY()
            _a = assigned_expr(vec_get(e, 2), names)
            assigned_expr(vec_get(e, 3), names)
        elsif k == EX_UNARY()
            assigned_expr(vec_get(e, 2), names)
        elsif k == EX_TO()
            assigned_expr(vec_get(e, 2), names)
        elsif k == EX_TRY()
            assigned_expr(vec_get(e, 1), names)
        else
            0

# Assigned names that are bound at the loop head, ordered by name.
fn while_carried_names(cx: Int, assigned: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        nm = vec_get(assigned, i)
        if cx_find(cx, nm) != 0
            _p = vec_push(out, nm)
            _s = names_bubble(out, vec_len(out) - 1)
        else
            _s = 0
        while_carried_names(cx, assigned, i + 1, n, out)

fn names_bubble(out: Int, j: Int) -> Int ! alloc
    if j <= 0
        0
    elsif str_less(vec_get(out, j), vec_get(out, j - 1)) == 1
        a = vec_get(out, j - 1)
        _x = vec_set(out, j - 1, vec_get(out, j))
        _y = vec_set(out, j, a)
        names_bubble(out, j - 1)
    else
        0

# [name, incoming, dest] per carried binding; dests are allocated in name order.
fn while_specs(cx: Int, names: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        nm = vec_get(names, i)
        b = cx_find(cx, nm)
        spec = vec_new()
        _a = vec_push(spec, nm)
        _b = vec_push(spec, bind_ssa(b))
        dest = fresh(cx)
        _c = vec_push(spec, dest)
        _d = bind_set_ssa(b, dest)
        _e = vec_push(out, spec)
        while_specs(cx, names, i + 1, n, out)

fn while_carries(cx: Int, specs: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        spec = vec_get(specs, i)
        b = cx_find(cx, vec_get(spec, 0))
        incoming = vec_get(spec, 1)
        dest = vec_get(spec, 2)
        updated = bind_ssa(b)
        if str_eq(updated, dest) == 1
            updated = incoming
        else
            updated = updated
        _s = bind_set_ssa(b, dest)
        c = vec_new()
        _a = vec_push(c, dest)
        _b = vec_push(c, incoming)
        _c = vec_push(c, updated)
        _d = vec_push(out, c)
        while_carries(cx, specs, i + 1, n, out)

fn lower_while(cx: Int, e: Int) -> Int ! alloc
    body = vec_get(e, 2)
    assigned = vec_new()
    _a = assigned_block(body, assigned)
    names = while_carried_names(cx, assigned, 0, vec_len(assigned), vec_new())
    specs = while_specs(cx, names, 0, vec_len(names), vec_new())
    saved = cx_insts(cx)
    binds = cx_binds(cx)
    n0 = vec_len(binds)
    slen = strenv_len(cx_strenv(cx))
    _b = cx_set_insts(cx, vec_new())
    c = lower_expr(cx, vec_get(e, 1))
    cond_insts = cx_insts(cx)
    _c = cx_set_insts(cx, vec_new())
    _v = lower_block_effects(cx, body)
    body_insts = cx_insts(cx)
    _k = kill_new_binds(cx, n0)
    _rs = strenv_set_len(cx_strenv(cx), slen)
    _d = cx_set_insts(cx, saved)
    carried = while_carries(cx, specs, 0, vec_len(specs), vec_new())
    inst = vec_new()
    _e = vec_push(inst, II_WHILE())
    _f = vec_push(inst, cond_insts)
    _g = vec_push(inst, c)
    _h = vec_push(inst, body_insts)
    _i = vec_push(inst, carried)
    _p = ir_push(cx, inst)
    0

# Statements and tail for effect only: no placeholder value when there is no tail.
fn lower_block_effects(cx: Int, b: Int) -> Int ! alloc
    if b == 0
        0
    else
        stmts = block_stmts(b)
        stopped = lower_stmts(cx, stmts, 0, vec_len(stmts))
        if stopped == 1
            0
        elsif block_tail(b) == 0
            0
        else
            lower_expr(cx, block_tail(b))

fn lower_block_value(cx: Int, b: Int) -> Int ! alloc
    if b == 0
        d = fresh(cx)
        _p = push_const_int(cx, d, 0)
        d
    else
        stmts = block_stmts(b)
        stopped = lower_stmts(cx, stmts, 0, vec_len(stmts))
        if stopped == 1
            d = fresh(cx)
            d
        else
            tail = block_tail(b)
            if tail == 0
                d = fresh(cx)
                _p = push_const_int(cx, d, 0)
                d
            else
                lower_expr(cx, tail)

# `x = load[Tensor[...] on p](path)` binds a tensor of the declared type; any other
# call result keeps the shape registered for its SSA value.
fn bind_load_tensor(cx: Int, name: Int, call: Int, v: Int) -> Int ! alloc
    ta = ex_call_type_args(call)
    if ta == 0
        0
    elsif str_eq(vec_get(call, 1), "load") == 0
        0
    else
        bb = cx_find(cx, name)
        if bb == 0
            0
        elsif str_contains_tensor(str_from_int(ta)) == 0
            0
        else
            parse_tensor_type(str_from_int(ta), bb)

# `let x: Tensor[...] on p = ...` binds a tensor of the declared type.
fn bind_declared_tensor(cx: Int, name: Int, ty: Int) -> Int ! alloc
    bb = cx_find(cx, name)
    if bb == 0
        0
    elsif str_contains_tensor(str_from_int(ty)) == 0
        0
    else
        parse_tensor_type(str_from_int(ty), bb)

# `y = to gpu x`: y is a tensor of x's shape on the new place.
fn bind_to_tensor(cx: Int, name: Int, e: Int) -> Int ! alloc
    inner = vec_get(e, 2)
    bb = cx_find(cx, name)
    if bb == 0
        0
    elsif ex_kind(inner) != EX_IDENT()
        0
    else
        src = cx_find(cx, vec_get(inner, 1))
        if src == 0
            0
        elsif src == bb
            bind_set_place(bb, vec_get(e, 1))
        elsif bind_is_tensor(src) == 0
            0
        else
            _a = bind_set_tensor(bb, 1)
            _b = bind_set_elem(bb, bind_elem(src))
            _c = bind_set_ndims(bb, bind_ndims(src))
            _d = bind_set_place(bb, vec_get(e, 1))
            _e = copy_dims(bind_dims(src), bind_dims(bb), 0, vec_len(bind_dims(src)))
            copy_dims(bind_concrete(src), bind_concrete(bb), 0, vec_len(bind_concrete(src)))

# `y = <tensor value>`: y takes the shape registered for that SSA value.
fn inherit_tensor(cx: Int, name: Int, v: Int) -> Int ! alloc
    bb = cx_find(cx, name)
    if bb == 0
        0
    elsif bind_is_tensor(bb) == 1
        0
    else
        src = bind_for_ssa(cx, v)
        if src == 0
            0
        elsif src == bb
            0
        elsif bind_is_tensor(src) == 0
            0
        else
            _a = bind_set_tensor(bb, 1)
            _b = bind_set_elem(bb, bind_elem(src))
            _c = bind_set_ndims(bb, bind_ndims(src))
            _d = bind_set_place(bb, bind_place(src))
            _e = copy_dims(bind_dims(src), bind_dims(bb), 0, vec_len(bind_dims(src)))
            copy_dims(bind_concrete(src), bind_concrete(bb), 0, vec_len(bind_concrete(src)))

fn copy_dims(src: Int, dst: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        copy_dims(src, dst, i + 1, n)

fn lower_stmts(cx: Int, stmts: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(stmts, i)
        is_as = vec_get(st, 0)
        if is_as == 1
            ex = vec_get(st, 2)
            if assign_accumulates_string(vec_get(st, 1), ex, cx_strenv(cx)) == 1
                _sa = cx_set_acc(cx, vec_get(st, 1))
            else
                _sa = cx_set_acc(cx, 0)
            v = lower_expr(cx, ex)
            _za = cx_set_acc(cx, 0)
            _b = cx_bind(cx, vec_get(st, 1), v)
            _ns = strenv_bind(cx_strenv(cx), vec_get(st, 1), expr_type(ex, cx_strenv(cx)))
            # tensor literal assign
            if ex_kind(ex) == EX_TENSOR()
                bb = cx_find(cx, vec_get(st, 1))
                if bb == 0
                    _x = 0
                else
                    _t = bind_set_tensor(bb, 1)
                    _n = bind_set_ndims(bb, 2)
                    dims = bind_dims(bb)
                    conc = bind_concrete(bb)
                    _p = vec_push(dims, vec_get(ex, 1))
                    _q = vec_push(dims, vec_get(ex, 2))
                    _r = vec_push(conc, vec_get(ex, 1))
                    _s = vec_push(conc, vec_get(ex, 2))
            elsif vec_get(st, 3) != 0
                _x = bind_declared_tensor(cx, vec_get(st, 1), vec_get(st, 3))
            elsif ex_kind(ex) == EX_CALL()
                _x = bind_load_tensor(cx, vec_get(st, 1), ex, v)
            elsif ex_kind(ex) == EX_TO()
                _x = 0
            else
                _x = 0
            lower_stmts(cx, stmts, i + 1, n)
        elsif is_as == 2
            ex = vec_get(st, 2)
            if ex == 0
                d = fresh(cx)
                _p = push_const_int(cx, d, 0)
                _c = ir_push(cx, ir_ret(d))
            else
                v0 = lower_expr(cx, ex)
                _c = ir_push(cx, ir_ret(v0))
            1
        else
            _v = lower_expr(cx, vec_get(st, 2))
            lower_stmts(cx, stmts, i + 1, n)

# ---- struct drops ----
# ---- moved bindings: bare identifiers that escape (bound, returned, tail, or passed to a
# user fn parameter that takes ownership) ----
fn mv_add(names: Int, e: Int) -> Int ! alloc
    if e == 0
        0
    elsif ex_kind(e) == EX_IDENT()
        assigned_add(names, vec_get(e, 1))
    else
        0

fn mv_stmts(stmts: Int, i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = vec_get(stmts, i)
        k = vec_get(st, 0)
        if k == 1
            _a = mv_add(names, vec_get(st, 2))
        elsif k == 2
            _a = mv_add(names, vec_get(st, 2))
        elsif k == 3
            _a = mv_add(names, vec_get(st, 2))
        else
            _a = 0
        _b = mv_expr(vec_get(st, 2), names, md)
        mv_stmts(stmts, i + 1, n, names, md)

fn mv_block(b: Int, names: Int, md: Int) -> Int ! alloc
    if b == 0
        0
    else
        stmts = block_stmts(b)
        _a = mv_stmts(stmts, 0, vec_len(stmts), names, md)
        _b = mv_add(names, block_tail(b))
        mv_expr(block_tail(b), names, md)

fn mv_args(args: Int, i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = mv_expr(vec_get(args, i), names, md)
        mv_args(args, i + 1, n, names, md)

# Arguments passed to a `take` parameter of a user fn are moved into the callee.
fn mv_take_args(params: Int, args: Int, i: Int, n: Int, names: Int) -> Int ! alloc
    if i >= n
        0
    elsif i >= vec_len(params)
        0
    else
        if param_mode(vec_get(params, i)) == 2
            _a = mv_add(names, vec_get(args, i))
        else
            _a = 0
        mv_take_args(params, args, i + 1, n, names)

fn mv_arms(arms: Int, i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = vec_get(arms, i)
        _a = mv_expr(vec_get(arm, 0), names, md)
        _b = mv_block(vec_get(arm, 1), names, md)
        mv_arms(arms, i + 1, n, names, md)

fn mv_match_arms(arms: Int, i: Int, n: Int, names: Int, md: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = mv_expr(vec_get(vec_get(arms, i), 1), names, md)
        mv_match_arms(arms, i + 1, n, names, md)

fn mv_expr(e: Int, names: Int, md: Int) -> Int ! alloc
    if e == 0
        0
    else
        k = ex_kind(e)
        if k == EX_CALL()
            args = vec_get(e, 2)
            params = map_get(md, vec_get(e, 1))
            if params != 0
                _t = mv_take_args(params, args, 0, vec_len(args), names)
            else
                _t = 0
            mv_args(args, 0, vec_len(args), names, md)
        elsif k == EX_BINARY()
            _a = mv_expr(vec_get(e, 2), names, md)
            mv_expr(vec_get(e, 3), names, md)
        elsif k == EX_UNARY()
            mv_expr(vec_get(e, 2), names, md)
        elsif k == EX_TO()
            mv_expr(vec_get(e, 2), names, md)
        elsif k == EX_TRY()
            mv_expr(vec_get(e, 1), names, md)
        elsif k == EX_FIELD()
            mv_expr(vec_get(e, 1), names, md)
        elsif k == EX_ON()
            mv_block(vec_get(e, 2), names, md)
        elsif k == EX_WHILE()
            _a = mv_expr(vec_get(e, 1), names, md)
            mv_block(vec_get(e, 2), names, md)
        elsif k == EX_MATCH()
            _a = mv_expr(vec_get(e, 1), names, md)
            arms = vec_get(e, 2)
            mv_match_arms(arms, 0, vec_len(arms), names, md)
        elsif k == EX_IF()
            _a = mv_expr(vec_get(e, 1), names, md)
            _b = mv_block(vec_get(e, 2), names, md)
            arms = vec_get(e, 4)
            _c = mv_arms(arms, 0, vec_len(arms), names, md)
            mv_block(vec_get(e, 3), names, md)
        else
            0

# ---- drops ----
fn fn_has_param(params: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(vec_get(params, i), 0), name) == 1
        1
    else
        fn_has_param(params, name, i + 1, n)

# 1 when `name` is a parameter whose mode is not `take`.
fn param_not_taken(params: Int, name: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(vec_get(vec_get(params, i), 0), name) == 1
        if param_mode(vec_get(params, i)) == 2
            0
        else
            1
    else
        param_not_taken(params, name, i + 1, n)

# Struct definition whose name the type text `ty` spells, or 0.
fn struct_for_type(structs: Int, ty: Int, i: Int, n: Int) -> Int ! alloc
    if ty == 0
        0
    elsif i >= n
        0
    else
        sd = vec_get(structs, i)
        if ty_text_matches(ty, structdef_name(sd)) == 1
            sd
        else
            struct_for_type(structs, ty, i + 1, n)

# Distinct local names bound in the strenv, sorted, with struct types only.
fn drop_candidates(cx: Int, env: Int, params: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        nm = vec_get(env, 3 + i * 2)
        # A parameter is dropped here only when it takes ownership.
        if param_not_taken(params, nm, 0, vec_len(params)) == 0
            if assigned_has(out, nm, 0, vec_len(out)) == 0
                ty = strenv_type(env, nm)
                structs = cx_struct_map(cx)
                if struct_for_type(structs, ty, 0, vec_len(structs)) != 0
                    _p = vec_push(out, nm)
                    _s = names_bubble(out, vec_len(out) - 1)
                else
                    _s = 0
            else
                _s = 0
        else
            _s = 0
        drop_candidates(cx, env, params, i + 1, n, out)

fn drop_fields(cx: Int, base: Int, sd: Int, fields: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        fld = vec_get(fields, i)
        if ty_handle_is_string(vec_get(fld, 1)) == 1
            if structdef_field_count(sd) == 1
                _a = ir_push(cx, ir_call_free(base))
            else
                d = fresh(cx)
                _b = ir_push(cx, ir_extract(d, base, structdef_name(sd), i))
                _c = ir_push(cx, ir_call_free(d))
        else
            _d = 0
        drop_fields(cx, base, sd, fields, i + 1, n)

fn drop_locals(cx: Int, names: Int, moved: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = vec_get(names, i)
        if assigned_has(moved, nm, 0, vec_len(moved)) == 0
            b = cx_find(cx, nm)
            if b != 0
                structs = cx_struct_map(cx)
                sd = struct_for_type(structs, strenv_type(cx_strenv(cx), nm), 0, vec_len(structs))
                _a = drop_fields(cx, bind_ssa(b), sd, structdef_fields(sd), 0, structdef_field_count(sd))
            else
                _a = 0
        else
            _a = 0
        drop_locals(cx, names, moved, i + 1, n)

fn emit_struct_drops(cx: Int, f: Int, md: Int) -> Int ! alloc
    moved = vec_new()
    _m = mv_block(vec_get(f, 2), moved, md)
    env = cx_strenv(cx)
    names = drop_candidates(cx, env, vec_get(f, 1), 0, strenv_len(env), vec_new())
    drop_locals(cx, names, moved, 0, vec_len(names))

# Instructions without a trailing Return, which is returned separately (0 when none).
fn pop_final_ret(cx: Int) -> Int ! alloc
    insts = cx_insts(cx)
    n = vec_len(insts)
    if n == 0
        0
    elsif vec_get(vec_get(insts, n - 1), 0) == II_RET()
        keep = vec_new()
        _c = copy_insts(insts, keep, 0, n - 1)
        ret = vec_get(insts, n - 1)
        _s = cx_set_insts(cx, keep)
        ret
    else
        0

fn copy_insts(src: Int, dst: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(dst, vec_get(src, i))
        copy_insts(src, dst, i + 1, n)

fn lower_fn(f: Int, fn_names: Int, fm: Int, struct_map: Int, fnrets: Int, denv: Int) -> Int ! alloc
    cx = cx_new(fn_names, fm, struct_map, fnrets)
    params = vec_get(f, 1)
    _a = lower_params(cx, params, 0, vec_len(params))
    body = drops_body(f, denv)
    stmts = block_stmts(body)
    stopped = lower_stmts(cx, stmts, 0, vec_len(stmts))
    if stopped == 0
        tail = block_tail(body)
        if tail == 0
            _c = 0
        else
            v1 = lower_expr(cx, tail)
            _c = ir_push(cx, ir_ret(v1))
    else
        _c = 0
    ret = pop_final_ret(cx)
    _dr = emit_struct_drops(cx, f, vec_get(denv, 1))
    if ret != 0
        _rr = ir_push(cx, ret)
    else
        _rr = 0
    out = vec_new()
    _d = vec_push(out, vec_get(f, 0))
    _e = vec_push(out, cx_dim_params(cx))
    _f = vec_push(out, cx_insts(cx))
    _g = vec_push(out, cx_regions(cx))
    _h = vec_push(out, cx_literals(cx))
    out

fn try_lower_tensor_bin(cx: Int, e: Int, l: Int, r: Int, d: Int) -> Int ! alloc
    left_e = vec_get(e, 2)
    right_e = vec_get(e, 3)
    if expr_is_tensor(cx, left_e) == 0
        if expr_is_tensor(cx, right_e) == 0
            0
        else
            try_lower_tensor_bin_go(cx, e, r, l, right_e, left_e, d)
    else
        try_lower_tensor_bin_go(cx, e, l, r, left_e, right_e, d)

# Element count operand: a 1-D tensor keeps its symbolic axis; otherwise the
# product of the extents as a constant (1 when an extent is unknown).
# A 1-D tensor with a known extent gets a constant; otherwise its symbolic axis.
fn tensor_len_axis0(cx: Int, b: Int, tensor_ssa: Int) -> Int ! alloc
    conc = bind_concrete(b)
    if vec_len(conc) == 0
        tensor_len_ssa_name(tensor_ssa)
    elsif vec_get(conc, 0) < 0
        tensor_len_ssa_name(tensor_ssa)
    else
        d = fresh(cx)
        _p = push_const_int(cx, d, vec_get(conc, 0))
        d

fn tensor_len_operand(cx: Int, b: Int, tensor_ssa: Int) -> Int ! alloc
    if bind_ndims(b) == 1
        tensor_len_axis0(cx, b, tensor_ssa)
    else
        conc = bind_concrete(b)
        prod = conc_product_go(conc, 0, vec_len(conc), 1)
        d = fresh(cx)
        if prod > 0
            _p = push_const_int(cx, d, prod)
        else
            _p = push_const_int(cx, d, 1)
        d

fn try_lower_tensor_bin_go(cx: Int, e: Int, tensor_ssa: Int, other_ssa: Int, tensor_e: Int, other_e: Int, d: Int) -> Int ! alloc
    b = 0
    if ex_kind(tensor_e) == EX_IDENT()
        b = cx_find(cx, vec_get(tensor_e, 1))
        if b == 0
            b = find_tensor(cx, tensor_ssa)
        elsif bind_is_tensor(b) == 0
            b = find_tensor(cx, tensor_ssa)
        else
            b = b
    else
        b = find_tensor(cx, tensor_ssa)
    if b == 0
        0
    elsif bind_is_tensor(b) == 0
        0
    else
        len = tensor_len_operand(cx, b, tensor_ssa)
        scalar = 0
        if expr_is_tensor(cx, other_e) == 0
            scalar = 1
        op = vec_get(e, 1)
        place = bind_place(b)
        elem = bind_elem(b)
        _p = ir_push(cx, ir_tbin(d, op, elem, place, tensor_ssa, other_ssa, len, scalar))
        src = b
        register_tensor_ssa(cx, d, src)
        1

fn lower_program(prog: Int) -> Int ! alloc
    lower_program_with_callables(prog, vec_new())

fn lower_program_with_callables(prog: Int, extra: Int) -> Int ! alloc
    lower_program_with_types(prog, extra, struct_map_from_prog(prog), fnret_map_from_prog(prog))

# `sm` and `fr` may cover the whole module graph, so `+` types imported
# struct fields and imported fn results the way the bootstrap does.
fn lower_program_with_types(prog: Int, extra: Int, sm: Int, fr: Int) -> Int ! alloc
    fns = prog_fns(prog)
    names = collect_fn_names(fns, 0, vec_len(fns), vec_new())
    names = merge_callable_names(extra, names)
    fm = map_new()
    _i = fill_fn_map(fm, names, 0, vec_len(names))
    out = vec_new()
    _im = infer_param_modes(prog)
    denv = drop_env_from_prog(prog)
    lower_fns(fns, names, fm, sm, fr, denv, 0, vec_len(fns), out)

# `[variants, modes]`: the variant table and, per fn name, its parameters (with their modes).
fn drop_env_from_prog(prog: Int) -> Int ! alloc
    denv = vec_new()
    _a = vec_push(denv, variant_map_from_prog(prog))
    modes = map_new()
    fns = prog_fns(prog)
    _m = modes_fill(modes, fns, 0, vec_len(fns))
    _b = vec_push(denv, modes)
    _c = vec_push(denv, dr_read_only(prog, vec_get(denv, 0)))
    denv

fn modes_fill(m: Int, fns: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = vec_get(fns, i)
        _p = map_put(m, vec_get(f, 0), vec_get(f, 1))
        modes_fill(m, fns, i + 1, n)

# Variant name -> [1 when it has fields or 2 when unit, per-field "may own heap" flags].
fn variant_map_from_prog(prog: Int) -> Int ! alloc
    m = map_new()
    enums = prog_enums(prog)
    _a = variant_map_enums(m, enums, 0, vec_len(enums))
    m

fn variant_map_enums(m: Int, enums: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        vs = vec_get(vec_get(enums, i), 1)
        _a = variant_map_go(m, vs, 0, vec_len(vs))
        variant_map_enums(m, enums, i + 1, n)

fn variant_map_go(m: Int, vs: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = vec_get(vs, i)
        rec = vec_new()
        if vec_len(vec_get(v, 1)) == 0
            _k = vec_push(rec, 2)
        else
            _k = vec_push(rec, 1)
        flags = vec_new()
        _f = variant_field_flags(vec_get(v, 1), 0, vec_len(vec_get(v, 1)), flags)
        _g = vec_push(rec, flags)
        _p = map_put(m, vec_get(v, 0), rec)
        variant_map_go(m, vs, i + 1, n)

fn variant_field_flags(fields: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = vec_push(out, dr_field_owned(vec_get(fields, i)))
        variant_field_flags(fields, i + 1, n, out)

fn lower_fns(fns: Int, names: Int, fm: Int, sm: Int, fr: Int, denv: Int, i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        irf = lower_fn(vec_get(fns, i), names, fm, sm, fr, denv)
        _p = vec_push(out, irf)
        lower_fns(fns, names, fm, sm, fr, denv, i + 1, n, out)
