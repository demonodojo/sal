# Monomorphization (SPEC «Genéricos»). Mirror of src/specialize.rs.
#
# A call to a generic `fn g[T, …]` whose arguments fix every type parameter to a concrete type calls
# its own copy `g__<tipos>`, with the types substituted. Copies may call other generics, so the pass
# repeats until no call changes; then the generic originals go. All or nothing per generic: a call
# that does not fix the types leaves that generic erased. A module also specializes the generics of
# other modules that it calls (`MonoCtx`).
#
# Inference records each generic call as `caller \t offset \t callee \t type…` (`ic_record_generic`).
# The calls are handled in the order of src/specialize.rs (caller name, then offset), so both
# compilers create the copies, and place them, in the same order.
import "../ast/tast.sal"
import "../ast/tygeneric.sal"
import "../ast/tytext.sal"
import "../pkg/result.sal"
import infer
import mono_ctx
import struct_mono

# Single program: the functions, then the structs.
fn monomorphize_all(tp: TProgram, errs: &mut List[String]) -> TProgram ! alloc
    cx = MonoCtx(sp_empty_program(), List.new[String](), List.new[String](), 1, List.new[String]())
    monomorphize_structs(monomorphize(tp, errs), &mut cx, errs)

# Single program: nothing from other modules, and the originals go at the end.
fn monomorphize(tp: TProgram, errs: &mut List[String]) -> TProgram ! alloc
    cx = MonoCtx(sp_empty_program(), List.new[String](), List.new[String](), 1, List.new[String]())
    monomorphize_ext(tp, &mut cx, errs)

fn sp_empty_program() -> TProgram ! alloc
    TProgram(List.new[TFn](), List.new[String](), List.new[TStruct](), List.new[String](), List.new[TEnum](), List.new[TProtocol](), List.new[TConst]())

# Specializes the generic calls of `tp`: its own generics and those of `cx.ext`. The copies made of
# its own generics go to `cx.made`. `tp` is consumed once on every path: a by-value program that
# only some branches move is not released on the others when the compiler builds the selfhost.
fn monomorphize_ext(tp: TProgram, cx: &mut MonoCtx, errs: &mut List[String]) -> TProgram ! alloc
    none = List.new[String]()
    if sp_count_generic(&tp.fns, &none, 0, tp.fns.len(), 0) == 0 && sp_calls_ext_generic(&tp, &cx.ext) == 0
        tp
    elsif errs.len() > 0
        tp
    elsif sp_infer_ok(&tp, &cx.ext) == 0
        # A program that does not type-check as written keeps its errors for the regular inference.
        tp
    else
        erased = sp_plan_erased(&tp, cx, errs)
        if errs.len() > 0
            tp
        else
            owns = sp_generic_names(&tp.fns, &erased)
            out = List.new[String]()
            copies = List.new[String]()
            r = sp_run(tp, cx, &erased, errs, &mut out, &mut copies)
            sp_own_copies(&copies, &owns, 0, &mut cx.made)
            r

# The generics that stay erased: trial runs on copies of `tp` (`sp_union`), each one adding the
# generic that had a call it could not specialize, until a run needs no more. The real run then
# goes on `tp` itself.
fn sp_plan_erased(tp: &TProgram, cx: &MonoCtx, errs: &mut List[String]) -> List[String] ! alloc
    erased = List.new[String]()
    sp_plan_go(tp, cx, &mut erased, errs, 0)
    erased

fn sp_plan_go(tp: &TProgram, cx: &MonoCtx, erased: &mut List[String], errs: &mut List[String], k: Int) -> Int ! alloc
    none = sp_empty_program()
    out = List.new[String]()
    copies = List.new[String]()
    trial = sp_run(sp_union(tp, &none), cx, erased, errs, &mut out, &mut copies)
    # The trial program only answers which generic to erase.
    n = trial.fns.len()
    if errs.len() > 0 || k > 64 || n < 0
        0
    elsif out.len() == 0
        0
    elsif sp_has(erased, &out.get(0)) == 1
        0
    else
        erased.push(out.get(0).dup())
        sp_plan_go(tp, cx, erased, errs, k + 1)

# Names of the generics of `fns` that are not erased.
fn sp_generic_names(fns: &List[TFn], erased: &List[String]) -> List[String] ! alloc
    out = List.new[String]()
    sp_generic_names_go(fns, erased, 0, &mut out)
    out

fn sp_generic_names_go(fns: &List[TFn], erased: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= fns.len()
        0
    else
        f = fns.get(i)
        if sp_is_generic(&f, erased) == 1
            out.push(f.name.dup())
        sp_generic_names_go(fns, erased, i + 1, out)

# The copies (`generic \t type… \t name`) whose generic is one of `owns`.
fn sp_own_copies(copies: &List[String], owns: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= copies.len()
        0
    else
        e = copies.get(i)
        fields = sp_split_tabs(&e)
        if sp_has(owns, &fields.get(0)) == 1
            out.push(e.dup())
        sp_own_copies(copies, owns, i + 1, out)

# Does `tp` call a generic of `ext`?
fn sp_calls_ext_generic(tp: &TProgram, ext: &TProgram) -> Int ! alloc
    names = List.new[String]()
    sp_called_names(&tp.fns, &mut names)
    none = List.new[String]()
    sp_any_generic_named(&ext.fns, &names, &none, 0)

fn sp_any_generic_named(fns: &List[TFn], names: &List[String], erased: &List[String], i: Int) -> Int ! alloc
    if i >= fns.len()
        0
    else
        f = fns.get(i)
        if sp_is_generic(&f, erased) == 1 && sp_has(names, &f.name) == 1
            1
        else
            sp_any_generic_named(fns, names, erased, i + 1)

fn sp_count_generic(fns: &List[TFn], erased: &List[String], i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    elsif sp_is_generic(&fns.get(i), erased) == 1
        sp_count_generic(fns, erased, i + 1, n, acc + 1)
    else
        sp_count_generic(fns, erased, i + 1, n, acc)

fn sp_is_generic(f: &TFn, erased: &List[String]) -> Int ! alloc
    tps = tg_type_params(&f.tparams)
    if tps.len() == 0
        0
    elsif sp_has(erased, &f.name) == 1
        0
    else
        1

fn sp_has(xs: &List[String], s: &String) -> Int ! alloc
    sp_has_go(xs, s, 0, xs.len())

fn sp_has_go(xs: &List[String], s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif xs.get(i).eq(s) == 1
        1
    else
        sp_has_go(xs, s, i + 1, n)

# ---- inference ----
# The program seen by inference: the other modules' items first, then this module's.
fn sp_union(tp: &TProgram, ext: &TProgram) -> TProgram ! alloc
    fns = ext.fns.clone()
    sp_append_fns(&mut fns, &tp.fns, 0, tp.fns.len())
    structs = ext.structs.clone()
    sp_append_structs(&mut structs, &tp.structs, 0, tp.structs.len())
    enums = ext.enums.clone()
    sp_append_enums(&mut enums, &tp.enums, 0, tp.enums.len())
    imports = ext.imports.clone()
    sp_append_strs(&mut imports, &tp.imports, 0, tp.imports.len())
    TProgram(fns, imports, structs, tp.aliases.clone(), enums, tp.protocols.clone(), tp.consts.clone())

fn sp_append_fns(dst: &mut List[TFn], src: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        x = src.get(i)
        dst.push(x.clone())
        sp_append_fns(dst, src, i + 1, n)

fn sp_append_structs(dst: &mut List[TStruct], src: &List[TStruct], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        x = src.get(i)
        dst.push(x.clone())
        sp_append_structs(dst, src, i + 1, n)

fn sp_append_enums(dst: &mut List[TEnum], src: &List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        x = src.get(i)
        dst.push(x.clone())
        sp_append_enums(dst, src, i + 1, n)

fn sp_append_strs(dst: &mut List[String], src: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        dst.push(src.get(i).dup())
        sp_append_strs(dst, src, i + 1, n)

fn sp_infer_ok(tp: &TProgram, ext: &TProgram) -> Int ! alloc
    u = sp_union(tp, ext)
    c = ic_build(&u, 0, 0)
    start = ext.fns.len()
    r = infer_program_go(&mut c, start, start + tp.fns.len())
    if result_is_err(&r) == 1
        0
    else
        1

# ---- one attempt ----
# Returns the specialized program, or puts in `erase` the generic that has to stay erased. `copies`
# gets `generic \t type… \t name` for each copy the run calls.
fn sp_run(tp: TProgram, cx: &MonoCtx, erased: &List[String], errs: &mut List[String], erase: &mut List[String], copies: &mut List[String]) -> TProgram ! alloc
    sp_rounds(tp, cx, erased, copies, errs, erase, 0)

fn sp_rounds(tp: TProgram, cx: &MonoCtx, erased: &List[String], copies: &mut List[String], errs: &mut List[String], erase: &mut List[String], k: Int) -> TProgram ! alloc
    if k > 256
        tp
    else
        u = sp_union(&tp, &cx.ext)
        c = ic_build(&u, 0, 0)
        start = cx.ext.fns.len()
        r = infer_program_go(&mut c, start, start + tp.fns.len())
        if result_is_err(&r) == 1
            # A copy that does not type-check is an error of that instantiation.
            errs.push(result_err_text(&r))
            tp
        else
            recs = sp_sorted(&c.gcalls)
            renames = List.new[String]()
            news = List.new[TFn]()
            bad = sp_collect(&tp, cx, erased, &recs, 0, recs.len(), copies, &mut renames, &mut news)
            if bad.len() > 0
                erase.push(bad)
                tp
            elsif renames.len() == 0 && news.len() == 0
                sp_finish(tp, cx.remove, erased)
            else
                tp2 = sp_rename_program(tp, &renames)
                tp3 = sp_place_copies(&tp2, &news)
                sp_rounds(tp3, cx, erased, copies, errs, erase, k + 1)

# The generic originals go here for a single file; a graph sweeps them once every module renamed
# its calls (`sp_sweep_generics`).
fn sp_finish(tp: TProgram, remove: Int, erased: &List[String]) -> TProgram ! alloc
    if remove == 1
        sp_drop_generics(tp, erased)
    else
        tp

fn result_err_text(r: &Res) -> String ! alloc
    r.err.dup()

# Goes through the records; returns the name of a generic with an unspecializable call, or "".
fn sp_collect(tp: &TProgram, cx: &MonoCtx, erased: &List[String], recs: &List[String], i: Int, n: Int, copies: &mut List[String], renames: &mut List[String], news: &mut List[TFn]) -> String ! alloc
    if i >= n
        ""
    else
        fields = sp_split_tabs(&recs.get(i))
        caller = fields.get(0)
        callee = fields.get(2)
        gi = sp_fn_index(&tp.fns, &callee, 0, tp.fns.len())
        ei = sp_fn_index(&cx.ext.fns, &callee, 0, cx.ext.fns.len())
        own = sp_generic_at(&tp.fns, gi, erased)
        ext = sp_generic_at(&cx.ext.fns, ei, erased)
        if own + ext == 0
            sp_collect(tp, cx, erased, recs, i + 1, n, copies, renames, news)
        elsif sp_caller_is_generic(tp, &caller, erased) == 1
            # Inside a generic original, which goes away.
            sp_collect(tp, cx, erased, recs, i + 1, n, copies, renames, news)
        else
            vals = sp_tail(&fields, 3)
            if sp_any_empty(&vals, 0) == 1
                callee.dup()
            else
                name = sp_copy_for_at(tp, cx, gi, ei, own, &vals, copies, news)
                renames.push(caller + "\t" + fields.get(1) + "\t" + callee + "\t" + name)
                sp_collect(tp, cx, erased, recs, i + 1, n, copies, renames, news)

fn sp_generic_at(fns: &List[TFn], i: Int, erased: &List[String]) -> Int ! alloc
    if i < 0
        0
    else
        sp_is_generic(&fns.get(i), erased)

fn sp_copy_for_at(tp: &TProgram, cx: &MonoCtx, gi: Int, ei: Int, own: Int, vals: &List[String], copies: &mut List[String], news: &mut List[TFn]) -> String ! alloc
    if own == 1
        g = tp.fns.get(gi)
        sp_copy_for(tp, cx, &g, 1, vals, copies, news)
    else
        g = cx.ext.fns.get(ei)
        sp_copy_for(tp, cx, &g, 0, vals, copies, news)

fn sp_caller_is_generic(tp: &TProgram, caller: &String, erased: &List[String]) -> Int ! alloc
    fi = sp_fn_index(&tp.fns, caller, 0, tp.fns.len())
    if fi < 0
        0
    else
        sp_is_generic(&tp.fns.get(fi), erased)

fn sp_fn_index(fns: &List[TFn], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif fns.get(i).name.eq(name) == 1
        i
    else
        sp_fn_index(fns, name, i + 1, n)

fn sp_any_empty(xs: &List[String], i: Int) -> Int ! alloc
    if i >= xs.len()
        0
    elsif xs.get(i).len() == 0
        1
    else
        sp_any_empty(xs, i + 1)

# The name of the copy of `g` for `vals`: one this run already uses, the one the module that
# defines `g` made (when `g` comes from another module), or a new one.
fn sp_copy_for(tp: &TProgram, cx: &MonoCtx, g: &TFn, own: Int, vals: &List[String], copies: &mut List[String], news: &mut List[TFn]) -> String ! alloc
    key = sp_join(vals, 0, g.name.dup())
    found = sp_copy_lookup(copies, &key, 0, copies.len())
    there = sp_existing(cx, &key, own)
    if found.len() > 0
        found
    elsif there.len() > 0
        copies.push(key + "\t" + there)
        there
    else
        name = sp_free_name(tp, cx, news, tg_copy_name(&g.name, vals))
        copies.push(key + "\t" + name)
        news.push(sp_instantiate(g, &name, vals))
        name

fn sp_existing(cx: &MonoCtx, key: &String, own: Int) -> String ! alloc
    if own == 1
        ""
    else
        sp_copy_lookup(&cx.existing, key, 0, cx.existing.len())

fn sp_join(xs: &List[String], i: Int, acc: String) -> String ! alloc
    if i >= xs.len()
        acc
    else
        sp_join(xs, i + 1, acc + "\t" + tg_mangle(&xs.get(i)))

fn sp_copy_lookup(copies: &List[String], key: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    else
        e = copies.get(i)
        k = key.len()
        head = e.slice(0, sp_min(k, e.len()))
        if e.len() > k && head.eq(key) == 1 && e.char(k) == 9
            e.slice(k + 1, e.len())
        else
            sp_copy_lookup(copies, key, i + 1, n)

# `name`, with `_` appended while some fn of the graph (or a copy about to be added) already has it.
fn sp_free_name(tp: &TProgram, cx: &MonoCtx, news: &List[TFn], name: String) -> String ! alloc
    if sp_fn_index(&tp.fns, &name, 0, tp.fns.len()) >= 0 || sp_fn_index(news, &name, 0, news.len()) >= 0 || sp_has(&cx.taken, &name) == 1
        sp_free_name(tp, cx, news, name + "_")
    else
        name

# ---- copies ----
fn sp_instantiate(g: &TFn, name: &String, vals: &List[String]) -> TFn ! alloc
    tps = tg_type_params(&g.tparams)
    TFn(name.dup(), sp_params(&g.params, &tps, vals), sp_block(&g.body, &tps, vals, 0, &"", &""), tg_subst(&g.ret, &tps, vals), g.no_heap, g.arena, g.fx.clone(), sp_lifetimes(&g.tparams), g.recv.dup(), g.mkind, g.deprecated.dup(), g.tyat.dup())

fn sp_lifetimes(tparams: &List[String]) -> List[String] ! alloc
    out = List.new[String]()
    sp_lifetimes_go(tparams, 0, &mut out)
    out

fn sp_lifetimes_go(xs: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        t = xs.get(i)
        if t.len() > 0 && t.char(0) == 39
            out.push(t.dup())
        sp_lifetimes_go(xs, i + 1, out)

fn sp_params(ps: &List[TParam], tps: &List[String], vals: &List[String]) -> List[TParam] ! alloc
    out = List.new[TParam]()
    sp_params_go(ps, 0, tps, vals, &mut out)
    out

fn sp_params_go(ps: &List[TParam], i: Int, tps: &List[String], vals: &List[String], out: &mut List[TParam]) -> Int ! alloc
    if i >= ps.len()
        0
    else
        p = ps.get(i)
        out.push(TParam(p.name.dup(), tg_subst(&p.ty, tps, vals), p.mode))
        sp_params_go(ps, i + 1, tps, vals, out)

# ---- the tree walk ----
# A deep copy of a body that substitutes the type parameters `tps` (in `let` types and type
# arguments) and renames the call at offset `at` from `from` to `to` (`at` 0: no rename).
fn sp_block(b: &TBlock, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String) -> TBlock ! alloc
    out = List.new[TStmt]()
    sp_stmts(&b.stmts, 0, tps, vals, at, from, dst, &mut out)
    TBlock(out, sp_expr(&b.tail, tps, vals, at, from, dst))

fn sp_stmts(xs: &List[TStmt], i: Int, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String, out: &mut List[TStmt]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        s = xs.get(i)
        out.push(TStmt(s.kind, s.name.dup(), sp_expr(&s.expr, tps, vals, at, from, dst), sp_ty(&s.ty, tps, vals), s.is_let, sp_expr(&s.target, tps, vals, at, from, dst), s.frozen, s.stack, s.id))
        sp_stmts(xs, i + 1, tps, vals, at, from, dst, out)

fn sp_ty(t: &String, tps: &List[String], vals: &List[String]) -> String ! alloc
    if tps.len() == 0 || t.len() == 0
        t.dup()
    else
        tg_subst(t, tps, vals)

fn sp_exprs(xs: &List[Expr], i: Int, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String, out: &mut List[Expr]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        out.push(sp_expr(&xs.get(i), tps, vals, at, from, dst))
        sp_exprs(xs, i + 1, tps, vals, at, from, dst, out)

fn sp_expr(e: &Expr, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String) -> Expr ! alloc
    match e
        XCall(name, args, targs, xp) => sp_call(&name, &args, &targs, xp, tps, vals, at, from, dst)
        XBin(op, l, r) => XBin(op.dup(), sp_expr(&l, tps, vals, at, from, dst), sp_expr(&r, tps, vals, at, from, dst))
        XTo(place, inner) => XTo(place.dup(), sp_expr(&inner, tps, vals, at, from, dst))
        XOn(place, body, kern, idx) => XOn(place.dup(), sp_block(&body, tps, vals, at, from, dst), kern, idx)
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(sp_expr(&cond, tps, vals, at, from, dst), sp_block(&then_b, tps, vals, at, from, dst), sp_block(&else_b, tps, vals, at, from, dst), has_else, sp_elsifs(&elsifs, tps, vals, at, from, dst))
        XWhile(cond, body) => XWhile(sp_expr(&cond, tps, vals, at, from, dst), sp_block(&body, tps, vals, at, from, dst))
        XField(base, field) => XField(sp_expr(&base, tps, vals, at, from, dst), field.dup())
        XLambda(param, body) => XLambda(param.dup(), sp_expr(&body, tps, vals, at, from, dst))
        XUnary(op, inner) => XUnary(op.dup(), sp_expr(&inner, tps, vals, at, from, dst))
        XMatch(scrut, arms) => XMatch(sp_expr(&scrut, tps, vals, at, from, dst), sp_arms(&arms, tps, vals, at, from, dst))
        XTry(inner) => XTry(sp_expr(&inner, tps, vals, at, from, dst))
        _ => tc_expr(e)

fn sp_call(name: &String, args: &List[Expr], targs: &String, xp: Int, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String) -> Expr ! alloc
    nargs = List.new[Expr]()
    sp_exprs(args, 0, tps, vals, at, from, dst, &mut nargs)
    if at > 0 && xp == at && name.eq(from) == 1
        XCall(dst.dup(), nargs, sp_ty(targs, tps, vals), xp)
    else
        XCall(name.dup(), nargs, sp_ty(targs, tps, vals), xp)

fn sp_elsifs(xs: &List[TElsif], tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String) -> List[TElsif] ! alloc
    out = List.new[TElsif]()
    sp_elsifs_go(xs, 0, tps, vals, at, from, dst, &mut out)
    out

fn sp_elsifs_go(xs: &List[TElsif], i: Int, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String, out: &mut List[TElsif]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        a = xs.get(i)
        out.push(TElsif(sp_expr(&a.cond, tps, vals, at, from, dst), sp_block(&a.body, tps, vals, at, from, dst)))
        sp_elsifs_go(xs, i + 1, tps, vals, at, from, dst, out)

fn sp_arms(xs: &List[TArm], tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String) -> List[TArm] ! alloc
    out = List.new[TArm]()
    sp_arms_go(xs, 0, tps, vals, at, from, dst, &mut out)
    out

fn sp_arms_go(xs: &List[TArm], i: Int, tps: &List[String], vals: &List[String], at: Int, from: &String, dst: &String, out: &mut List[TArm]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        a = xs.get(i)
        out.push(TArm(tc_pat(&a.pat), sp_expr(&a.body, tps, vals, at, from, dst), sp_block(&a.suite, tps, vals, at, from, dst), a.has_suite))
        sp_arms_go(xs, i + 1, tps, vals, at, from, dst, out)

# ---- renames and placement ----
# Each rename is `caller \t offset \t callee \t copy`; they apply one after the other.
fn sp_rename_program(tp: TProgram, renames: &List[String]) -> TProgram ! alloc
    fns = List.new[TFn]()
    sp_rename_fns(&tp.fns, 0, renames, &mut fns)
    TProgram(fns, tp.imports.clone(), tp.structs.clone(), tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone())

fn sp_rename_fns(xs: &List[TFn], i: Int, renames: &List[String], out: &mut List[TFn]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        x = xs.get(i)
        out.push(sp_rename_fn(&x, renames))
        sp_rename_fns(xs, i + 1, renames, out)

# A copy of `f` with the renames of its calls applied.
fn sp_rename_fn(f: &TFn, renames: &List[String]) -> TFn ! alloc
    body = sp_rename_body(&f.body, &f.name, renames, 0)
    TFn(f.name.dup(), f.params.clone(), body, f.ret.dup(), f.no_heap, f.arena, f.fx.clone(), f.tparams.clone(), f.recv.dup(), f.mkind, f.deprecated.dup(), f.tyat.dup())

fn sp_rename_body(b: &TBlock, fname: &String, renames: &List[String], k: Int) -> TBlock ! alloc
    none = List.new[String]()
    if k >= renames.len()
        sp_block(b, &none, &none, 0, &"", &"")
    else
        r = sp_split_tabs(&renames.get(k))
        if r.get(0).eq(fname) == 1
            nb = sp_block(b, &none, &none, sp_atoi(&r.get(1), 0, 0), &r.get(2), &r.get(3))
            sp_rename_body(&nb, fname, renames, k + 1)
        else
            sp_rename_body(b, fname, renames, k + 1)

# Each copy goes right after its generic and the copies of it made before.
fn sp_place_copies(tp: &TProgram, news: &List[TFn]) -> TProgram ! alloc
    fns = sp_place_go(&tp.fns, news, 0, news.len())
    TProgram(fns, tp.imports.clone(), tp.structs.clone(), tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone())

fn sp_place_go(fns: &List[TFn], news: &List[TFn], i: Int, n: Int) -> List[TFn] ! alloc
    if i >= n
        out = List.new[TFn]()
        sp_append_fns(&mut out, fns, 0, fns.len())
        out
    else
        nf = news.get(i)
        callee = sp_copy_base(&nf.name)
        pos = sp_last_of(fns, &callee, 0, fns.len(), 0 - 1)
        at = sp_after(pos, fns.len())
        next = List.new[TFn]()
        sp_insert(fns, 0, at, &nf, &mut next)
        sp_place_go(&next, news, i + 1, n)

fn sp_after(pos: Int, n: Int) -> Int ! alloc
    if pos < 0
        n
    else
        pos + 1

# The generic a copy comes from: its name up to the last `__`.
fn sp_copy_base(name: &String) -> String ! alloc
    sp_copy_base_go(name, name.len() - 2)

fn sp_copy_base_go(name: &String, i: Int) -> String ! alloc
    if i < 0
        name.dup()
    elsif name.char(i) == 95 && name.char(i + 1) == 95
        name.slice(0, i)
    else
        sp_copy_base_go(name, i - 1)

fn sp_last_of(fns: &List[TFn], callee: &String, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        nm = fns.get(i).name.dup()
        prefix = callee + "__"
        head = nm.slice(0, sp_min(prefix.len(), nm.len()))
        if nm.eq(callee) == 1 || (nm.len() > prefix.len() && head.eq(&prefix) == 1)
            sp_last_of(fns, callee, i + 1, n, i)
        else
            sp_last_of(fns, callee, i + 1, n, acc)

fn sp_insert(xs: &List[TFn], i: Int, at: Int, nf: &TFn, out: &mut List[TFn]) -> Int ! alloc
    if i == at
        out.push(nf.clone())
    if i >= xs.len()
        0
    else
        out.push(xs.get(i).clone())
        sp_insert(xs, i + 1, at, nf, out)

fn sp_drop_generics(tp: TProgram, erased: &List[String]) -> TProgram ! alloc
    fns = List.new[TFn]()
    sp_keep_fns(&tp.fns, 0, erased, &mut fns)
    TProgram(fns, tp.imports.clone(), tp.structs.clone(), tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone())

fn sp_keep_fns(xs: &List[TFn], i: Int, erased: &List[String], out: &mut List[TFn]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        f = xs.get(i)
        if sp_is_generic(&f, erased) == 0
            out.push(f.clone())
        sp_keep_fns(xs, i + 1, erased, out)

# ---- records ----
fn sp_split_tabs(s: &String) -> List[String] ! alloc
    out = List.new[String]()
    sp_split_go(s, 0, 0, &mut out)
    out

fn sp_split_go(s: &String, i: Int, start: Int, out: &mut List[String]) -> Int ! alloc
    if i >= s.len()
        out.push(s.slice(start, s.len()))
        0
    elsif s.char(i) == 9
        out.push(s.slice(start, i))
        sp_split_go(s, i + 1, i + 1, out)
    else
        sp_split_go(s, i + 1, start, out)

fn sp_tail(xs: &List[String], from: Int) -> List[String] ! alloc
    out = List.new[String]()
    sp_tail_go(xs, from, &mut out)
    out

fn sp_tail_go(xs: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        out.push(xs.get(i).dup())
        sp_tail_go(xs, i + 1, out)

# The records ordered by caller (bytewise) and then by offset, as src/specialize.rs orders its keys.
fn sp_sorted(recs: &List[String]) -> List[String] ! alloc
    out = List.new[String]()
    sp_sort_go(recs, 0, &mut out)
    out

fn sp_sort_go(recs: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= recs.len()
        0
    else
        r = recs.get(i).dup()
        pos = sp_sort_pos(out, &r, 0, out.len())
        rest = List.new[String]()
        sp_move_from(out, pos, &mut rest)
        out.push(r)
        sp_append_strs(out, &rest, 0, rest.len())
        sp_sort_go(recs, i + 1, out)

# The first position whose record goes after `r`.
fn sp_sort_pos(xs: &List[String], r: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        n
    elsif sp_rec_less(r, &xs.get(i)) == 1
        i
    else
        sp_sort_pos(xs, r, i + 1, n)

# Pops the records from `pos` on into `rest`, keeping their order.
fn sp_move_from(xs: &mut List[String], pos: Int, rest: &mut List[String]) -> Int ! alloc
    tmp = List.new[String]()
    sp_pop_into(xs, pos, &mut tmp)
    sp_reverse_into(&tmp, tmp.len() - 1, rest)

fn sp_pop_into(xs: &mut List[String], pos: Int, tmp: &mut List[String]) -> Int ! alloc
    if xs.len() <= pos
        0
    else
        tmp.push(xs.pop())
        sp_pop_into(xs, pos, tmp)

fn sp_reverse_into(tmp: &List[String], i: Int, rest: &mut List[String]) -> Int ! alloc
    if i < 0
        0
    else
        rest.push(tmp.get(i).dup())
        sp_reverse_into(tmp, i - 1, rest)

fn sp_rec_less(a: &String, b: &String) -> Int ! alloc
    fa = sp_split_tabs(a)
    fb = sp_split_tabs(b)
    c = sp_str_cmp(&fa.get(0), &fb.get(0), 0)
    if c != 0
        if c < 0
            1
        else
            0
    elsif sp_atoi(&fa.get(1), 0, 0) < sp_atoi(&fb.get(1), 0, 0)
        1
    else
        0

# Bytewise comparison: negative, zero or positive.
fn sp_str_cmp(a: &String, b: &String, i: Int) -> Int ! alloc
    if i >= a.len() && i >= b.len()
        0
    elsif i >= a.len()
        0 - 1
    elsif i >= b.len()
        1
    elsif a.char(i) != b.char(i)
        a.char(i) - b.char(i)
    else
        sp_str_cmp(a, b, i + 1)

# ---- module graph ----
# Names called directly anywhere in the functions `fns`.
fn sp_called_names(fns: &List[TFn], out: &mut List[String]) -> Int ! alloc
    sp_called_fns(fns, 0, out)

fn sp_called_fns(fns: &List[TFn], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= fns.len()
        0
    else
        sp_called_block(&fns.get(i).body, out)
        sp_called_fns(fns, i + 1, out)

fn sp_called_block(b: &TBlock, out: &mut List[String]) -> Int ! alloc
    sp_called_stmts(&b.stmts, 0, out)
    sp_called_expr(&b.tail, out)

fn sp_called_stmts(xs: &List[TStmt], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        st = xs.get(i)
        sp_called_expr(&st.expr, out)
        sp_called_expr(&st.target, out)
        sp_called_stmts(xs, i + 1, out)

fn sp_called_exprs(xs: &List[Expr], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_called_expr(&xs.get(i), out)
        sp_called_exprs(xs, i + 1, out)

fn sp_called_expr(e: &Expr, out: &mut List[String]) -> Int ! alloc
    match e
        XCall(name, args, _, _) => sp_called_call(&name, &args, out)
        XBin(_, l, r) => sp_called_pair(&l, &r, out)
        XTo(_, inner) => sp_called_expr(&inner, out)
        XOn(_, body, _, _) => sp_called_block(&body, out)
        XIf(cond, then_b, else_b, _, elsifs) => sp_called_if(&cond, &then_b, &else_b, &elsifs, out)
        XWhile(cond, body) => sp_called_while(&cond, &body, out)
        XField(base, _) => sp_called_expr(&base, out)
        XLambda(_, body) => sp_called_expr(&body, out)
        XUnary(_, inner) => sp_called_expr(&inner, out)
        XMatch(scrut, arms) => sp_called_match(&scrut, &arms, out)
        XTry(inner) => sp_called_expr(&inner, out)
        _ => 0

fn sp_called_call(name: &String, args: &List[Expr], out: &mut List[String]) -> Int ! alloc
    if sp_has(out, name) == 0
        out.push(name.dup())
    sp_called_exprs(args, 0, out)

fn sp_called_pair(l: &Expr, r: &Expr, out: &mut List[String]) -> Int ! alloc
    sp_called_expr(l, out)
    sp_called_expr(r, out)

fn sp_called_while(cond: &Expr, body: &TBlock, out: &mut List[String]) -> Int ! alloc
    sp_called_expr(cond, out)
    sp_called_block(body, out)

fn sp_called_if(cond: &Expr, then_b: &TBlock, else_b: &TBlock, elsifs: &List[TElsif], out: &mut List[String]) -> Int ! alloc
    sp_called_expr(cond, out)
    sp_called_block(then_b, out)
    sp_called_block(else_b, out)
    sp_called_elsifs(elsifs, 0, out)

fn sp_called_elsifs(xs: &List[TElsif], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        a = xs.get(i)
        sp_called_expr(&a.cond, out)
        sp_called_block(&a.body, out)
        sp_called_elsifs(xs, i + 1, out)

fn sp_called_match(scrut: &Expr, arms: &List[TArm], out: &mut List[String]) -> Int ! alloc
    sp_called_expr(scrut, out)
    sp_called_arms(arms, 0, out)

fn sp_called_arms(xs: &List[TArm], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        a = xs.get(i)
        sp_called_expr(&a.body, out)
        if a.has_suite == 1
            sp_called_block(&a.suite, out)
        sp_called_arms(xs, i + 1, out)

fn sp_min(a: Int, b: Int) -> Int ! alloc
    if a < b
        a
    else
        b

# Decimal digits of `s` from `i` on.
fn sp_atoi(s: &String, i: Int, acc: Int) -> Int ! alloc
    if i >= s.len()
        acc
    else
        sp_atoi(s, i + 1, acc * 10 + s.char(i) - 48)

# ---- module graph: the sweep ----
# Removes the generic originals that no module of the graph calls any more. Repeats until nothing
# changes: a removed original may have been the last caller of another one.
fn sp_sweep_generics(progs: &mut List[TProgram]) -> Int ! alloc
    called = List.new[String]()
    sp_called_progs(progs, 0, &mut called)
    if sp_uncalled_progs(progs, &called, 0) == 0
        0
    else
        sp_sweep_go(progs, &called, 0)
        sp_sweep_generics(progs)

fn sp_uncalled_progs(progs: &List[TProgram], called: &List[String], i: Int) -> Int ! alloc
    if i >= progs.len()
        0
    else
        tp = progs.get(i)
        if sp_count_uncalled(&tp.fns, called, 0) > 0
            1
        else
            sp_uncalled_progs(progs, called, i + 1)

fn sp_called_progs(progs: &List[TProgram], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= progs.len()
        0
    else
        tp = progs.get(i)
        sp_called_names(&tp.fns, out)
        sp_called_progs(progs, i + 1, out)

fn sp_sweep_go(progs: &mut List[TProgram], called: &List[String], i: Int) -> Int ! alloc
    if i >= progs.len()
        0
    else
        tp = progs.get(i)
        # Only a module with an original to remove gets a new program.
        if sp_count_uncalled(&tp.fns, called, 0) > 0
            fns = List.new[TFn]()
            sp_keep_called(&tp.fns, called, 0, &mut fns)
            progs.set(i, TProgram(fns, tp.imports.clone(), tp.structs.clone(), tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone()))
        sp_sweep_go(progs, called, i + 1)

fn sp_count_uncalled(fns: &List[TFn], called: &List[String], i: Int) -> Int ! alloc
    if i >= fns.len()
        0
    else
        f = fns.get(i)
        none = List.new[String]()
        if sp_is_generic(&f, &none) == 1 && sp_has(called, &f.name) == 0
            1
        else
            sp_count_uncalled(fns, called, i + 1)

fn sp_keep_called(fns: &List[TFn], called: &List[String], i: Int, out: &mut List[TFn]) -> Int ! alloc
    if i >= fns.len()
        0
    else
        f = fns.get(i)
        none = List.new[String]()
        if sp_is_generic(&f, &none) == 0 || sp_has(called, &f.name) == 1
            out.push(f.clone())
        sp_keep_called(fns, called, i + 1, out)

# ---- generic structs ----
# Every `G[tipos concretos]` of a generic struct `G` becomes the struct `G__tipos`, and `G(..)` built
# with those types calls its constructor (`StructMono`). Runs after the functions are monomorphized.
# Mirror of `monomorphize_structs` in src/specialize.rs; `tp` is consumed once on every path.
fn monomorphize_structs(tp: TProgram, cx: &mut MonoCtx, errs: &mut List[String]) -> TProgram ! alloc
    gens = List.new[TStruct]()
    sp_generic_structs(&tp.structs, &mut gens)
    nown = gens.len()
    sp_generic_structs(&cx.ext.structs, &mut gens)
    if gens.len() == 0 || errs.len() > 0
        tp
    elsif sp_infer_ok(&tp, &cx.ext) == 0
        tp
    else
        u = sp_union(&tp, &cx.ext)
        c = ic_build(&u, 0, 0)
        start = cx.ext.fns.len()
        infer_program_go(&mut c, start, start + tp.fns.len())
        recs = sp_sorted(&c.gctors)
        taken = tc_strs(&cx.taken)
        sp_type_names(&tp, &mut taken)
        sm = StructMono(gens, nown, List.new[String](), List.new[TStruct](), List.new[String](), taken, tc_strs(&cx.existing), List.new[String]())
        renames = List.new[String]()
        sp_ctor_renames(&mut sm, &recs, 0, &mut renames)
        tp2 = sp_rename_program(tp, &renames)
        tp3 = sm.rw_program(&tp2)
        tp4 = sp_place_structs(&tp3, &sm.news, &sm.news_from)
        sp_append_strs(&mut cx.made, &sm.made, 0, sm.made.len())
        cx.taken = sm.taken.clone()
        sp_finish_structs(tp4, cx.remove)

fn sp_generic_structs(xs: &List[TStruct], out: &mut List[TStruct]) -> Int ! alloc
    if xs.len() == 0
        0
    else
        sp_generic_structs_go(xs, 0, out)

fn sp_generic_structs_go(xs: &List[TStruct], i: Int, out: &mut List[TStruct]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        s = xs.get(i)
        if s.tparams.len() > 0
            out.push(s.clone())
        sp_generic_structs_go(xs, i + 1, out)

# The struct and enum names of `tp`.
fn sp_type_names(tp: &TProgram, out: &mut List[String]) -> Int ! alloc
    sp_struct_names(&tp.structs, 0, out)
    sp_enum_names(&tp.enums, 0, out)

fn sp_struct_names(xs: &List[TStruct], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        out.push(xs.get(i).name.dup())
        sp_struct_names(xs, i + 1, out)

fn sp_enum_names(xs: &List[TEnum], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        out.push(xs.get(i).name.dup())
        sp_enum_names(xs, i + 1, out)

# Each construction record (`caller \t offset \t G \t type…`) names its instance and renames the call.
fn sp_ctor_renames(sm: &mut StructMono, recs: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= recs.len()
        0
    else
        f = sp_split_tabs(&recs.get(i))
        gi = sm_struct_index(&sm.gens, &f.get(2), 0)
        vals = sp_tail(&f, 3)
        if gi >= 0 && sp_any_empty(&vals, 0) == 0
            name = sm.instance(gi, &vals)
            out.push(f.get(0) + "\t" + f.get(1) + "\t" + f.get(2) + "\t" + name)
        sp_ctor_renames(sm, recs, i + 1, out)

# Each instance goes right after its generic and the instances of it made before.
fn sp_place_structs(tp: &TProgram, news: &List[TStruct], from: &List[String]) -> TProgram ! alloc
    structs = sp_place_structs_go(&tp.structs, news, from, 0)
    TProgram(tp.fns.clone(), tp.imports.clone(), structs, tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone())

fn sp_place_structs_go(xs: &List[TStruct], news: &List[TStruct], from: &List[String], i: Int) -> List[TStruct] ! alloc
    if i >= news.len()
        out = List.new[TStruct]()
        sp_append_structs(&mut out, xs, 0, xs.len())
        out
    else
        g = from.get(i)
        pos = sp_last_struct_of(xs, &g, 0, 0 - 1)
        at = sp_after(pos, xs.len())
        next = List.new[TStruct]()
        sp_insert_struct(xs, 0, at, &news.get(i), &mut next)
        sp_place_structs_go(&next, news, from, i + 1)

fn sp_last_struct_of(xs: &List[TStruct], g: &String, i: Int, acc: Int) -> Int ! alloc
    if i >= xs.len()
        acc
    else
        nm = xs.get(i).name.dup()
        prefix = g + "__"
        head = nm.slice(0, sp_min(prefix.len(), nm.len()))
        if nm.eq(g) == 1 || (nm.len() > prefix.len() && head.eq(&prefix) == 1)
            sp_last_struct_of(xs, g, i + 1, i)
        else
            sp_last_struct_of(xs, g, i + 1, acc)

fn sp_insert_struct(xs: &List[TStruct], i: Int, at: Int, ns: &TStruct, out: &mut List[TStruct]) -> Int ! alloc
    if i == at
        out.push(ns.clone())
    if i >= xs.len()
        0
    else
        x = xs.get(i)
        out.push(x.clone())
        sp_insert_struct(xs, i + 1, at, ns, out)

fn sp_finish_structs(tp: TProgram, remove: Int) -> TProgram ! alloc
    if remove == 1
        progs = List.new[TProgram]()
        progs.push(tp)
        sp_sweep_structs(&mut progs)
        progs.pop()
    else
        tp

# Removes the generic structs that no type or call of the graph names any more.
fn sp_sweep_structs(progs: &mut List[TProgram]) -> Int ! alloc
    named = List.new[String]()
    sp_named_progs(progs, 0, &mut named)
    sp_sweep_structs_go(progs, &named, 0)

fn sp_named_progs(progs: &List[TProgram], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= progs.len()
        0
    else
        tp = progs.get(i)
        sp_named_in(&tp, out)
        sp_named_progs(progs, i + 1, out)

# The names the types of `tp` mention (outside the generic structs themselves) and the called names.
fn sp_named_in(tp: &TProgram, out: &mut List[String]) -> Int ! alloc
    sp_called_names(&tp.fns, out)
    sp_named_fns(&tp.fns, 0, out)
    sp_named_structs(&tp.structs, 0, out)
    sp_named_enums(&tp.enums, 0, out)
    sp_named_consts(&tp.consts, 0, out)

fn sp_named_fns(xs: &List[TFn], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        f = xs.get(i)
        sp_named_params(&f.params, 0, out)
        sp_idents(&f.ret, out)
        sp_named_block(&f.body, out)
        sp_named_fns(xs, i + 1, out)

fn sp_named_params(xs: &List[TParam], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_idents(&xs.get(i).ty, out)
        sp_named_params(xs, i + 1, out)

fn sp_named_structs(xs: &List[TStruct], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        s = xs.get(i)
        if s.tparams.len() == 0
            sp_named_fields(&s.fields, 0, out)
        sp_named_structs(xs, i + 1, out)

fn sp_named_fields(xs: &List[TField], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_idents(&xs.get(i).ty, out)
        sp_named_fields(xs, i + 1, out)

fn sp_named_enums(xs: &List[TEnum], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_named_variants(&xs.get(i).variants, 0, out)
        sp_named_enums(xs, i + 1, out)

fn sp_named_variants(xs: &List[TVariant], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        v = xs.get(i)
        sp_named_texts(&v.fields, 0, out)
        sp_named_variants(xs, i + 1, out)

fn sp_named_texts(xs: &List[String], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_idents(&xs.get(i), out)
        sp_named_texts(xs, i + 1, out)

fn sp_named_consts(xs: &List[TConst], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_idents(&xs.get(i).ty, out)
        sp_named_consts(xs, i + 1, out)

# `let` types and type arguments of a body.
fn sp_named_block(b: &TBlock, out: &mut List[String]) -> Int ! alloc
    sp_named_stmts(&b.stmts, 0, out)
    sp_named_expr(&b.tail, out)

fn sp_named_stmts(xs: &List[TStmt], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        st = xs.get(i)
        sp_idents(&st.ty, out)
        sp_named_expr(&st.expr, out)
        sp_named_expr(&st.target, out)
        sp_named_stmts(xs, i + 1, out)

fn sp_named_exprs(xs: &List[Expr], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        sp_named_expr(&xs.get(i), out)
        sp_named_exprs(xs, i + 1, out)

fn sp_named_expr(e: &Expr, out: &mut List[String]) -> Int ! alloc
    match e
        XCall(_, args, targs, _) => sp_named_call(&targs, &args, out)
        XBin(_, l, r) => sp_named_pair(&l, &r, out)
        XTo(_, inner) => sp_named_expr(&inner, out)
        XOn(_, body, _, _) => sp_named_block(&body, out)
        XIf(cond, then_b, else_b, _, elsifs) => sp_named_if(&cond, &then_b, &else_b, &elsifs, out)
        XWhile(cond, body) => sp_named_while(&cond, &body, out)
        XField(base, _) => sp_named_expr(&base, out)
        XLambda(_, body) => sp_named_expr(&body, out)
        XUnary(_, inner) => sp_named_expr(&inner, out)
        XMatch(scrut, arms) => sp_named_match(&scrut, &arms, out)
        XTry(inner) => sp_named_expr(&inner, out)
        _ => 0

fn sp_named_call(targs: &String, args: &List[Expr], out: &mut List[String]) -> Int ! alloc
    sp_idents(targs, out)
    sp_named_exprs(args, 0, out)

fn sp_named_pair(l: &Expr, r: &Expr, out: &mut List[String]) -> Int ! alloc
    sp_named_expr(l, out)
    sp_named_expr(r, out)

fn sp_named_while(cond: &Expr, body: &TBlock, out: &mut List[String]) -> Int ! alloc
    sp_named_expr(cond, out)
    sp_named_block(body, out)

fn sp_named_if(cond: &Expr, then_b: &TBlock, else_b: &TBlock, elsifs: &List[TElsif], out: &mut List[String]) -> Int ! alloc
    sp_named_expr(cond, out)
    sp_named_block(then_b, out)
    sp_named_block(else_b, out)
    sp_named_elsifs(elsifs, 0, out)

fn sp_named_elsifs(xs: &List[TElsif], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        a = xs.get(i)
        sp_named_expr(&a.cond, out)
        sp_named_block(&a.body, out)
        sp_named_elsifs(xs, i + 1, out)

fn sp_named_match(scrut: &Expr, arms: &List[TArm], out: &mut List[String]) -> Int ! alloc
    sp_named_expr(scrut, out)
    sp_named_arms(arms, 0, out)

fn sp_named_arms(xs: &List[TArm], i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        a = xs.get(i)
        sp_named_expr(&a.body, out)
        if a.has_suite == 1
            sp_named_block(&a.suite, out)
        sp_named_arms(xs, i + 1, out)

# The identifiers of a type text.
fn sp_idents(t: &String, out: &mut List[String]) -> Int ! alloc
    sp_idents_go(t, 0, out)

fn sp_idents_go(t: &String, i: Int, out: &mut List[String]) -> Int ! alloc
    if i >= t.len()
        0
    elsif tg_ident_char(t.char(i)) == 1
        j = tg_ident_end(t, i, t.len())
        w = t.slice(i, j)
        if sp_has(out, &w) == 0
            out.push(w)
        sp_idents_go(t, j, out)
    else
        sp_idents_go(t, i + 1, out)

fn sp_sweep_structs_go(progs: &mut List[TProgram], named: &List[String], i: Int) -> Int ! alloc
    if i >= progs.len()
        0
    else
        tp = progs.get(i)
        # Only a module with a generic struct to remove gets a new program.
        if sp_unnamed_structs(&tp.structs, named, 0) > 0
            structs = List.new[TStruct]()
            sp_keep_named(&tp.structs, named, 0, &mut structs)
            progs.set(i, TProgram(tp.fns.clone(), tp.imports.clone(), structs, tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone()))
        sp_sweep_structs_go(progs, named, i + 1)

fn sp_unnamed_structs(xs: &List[TStruct], named: &List[String], i: Int) -> Int ! alloc
    if i >= xs.len()
        0
    else
        s = xs.get(i)
        if s.tparams.len() > 0 && sp_has(named, &s.name) == 0
            1
        else
            sp_unnamed_structs(xs, named, i + 1)

fn sp_keep_named(xs: &List[TStruct], named: &List[String], i: Int, out: &mut List[TStruct]) -> Int ! alloc
    if i >= xs.len()
        0
    else
        s = xs.get(i)
        if s.tparams.len() == 0 || sp_has(named, &s.name) == 1
            out.push(s.clone())
        sp_keep_named(xs, named, i + 1, out)
