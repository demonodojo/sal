# Ownership pass, the mirror of check_ownership in src/ownership.rs: a unique
# value (String, tensor, struct) moves when it is bound, returned, passed to a
# move fn or sent with `to`; using it afterwards is E_MOVED. It reads the typed AST
# (`tast.sal`) and types names with the typed environment (`ttypes.sal`).
import "../pkg/result.sal"
import "../ast/tast.sal"
import "../ast/tytext.sal"
import "../ast/ttypes.sal"
import "../ast/thash.sal"

# `moved` is the set of moved names and `name.field` keys; `err` is empty or holds the first
# message; `params` are the names of the function's parameters, `taken` those moved out of and
# `used` those read (for the parameter modes); `table` maps a fn name to "m" + one digit per
# parameter mode and `ctors` holds the struct and enum-variant constructor names, whose
# arguments move into the value.
struct OC
    moved: List[String]
    err: List[String]
    env: TEnv
    params: List[String]
    taken: List[String]
    used: List[String]
    table: HT
    ctors: List[String]

fn oc_new(tp: &TProgram, table: HT) -> OC ! alloc
    ctors = list_new[String]()
    _a = own_ctor_structs(&mut ctors, &tp.structs, 0, list_len(&tp.structs))
    _b = own_ctor_enums(&mut ctors, &tp.enums, 0, list_len(&tp.enums))
    OC(list_new[String](), list_new[String](), tenv_new(tp), list_new[String](), list_new[String](), list_new[String](), table, ctors)

# `drop.OC` releases direct lists and nested `TEnv` fields. Manual `tenv_free` here
# would double-free with that glue; keep this a no-op.
fn oc_free(c: &OC) -> Int ! alloc
    0

# Clears what a fn leaves behind, so the context serves the next one.
fn oc_reset(c: &mut OC) -> Int ! alloc
    _a = own_clear(&mut c.moved)
    _b = own_clear(&mut c.err)
    _c = own_clear(&mut c.params)
    _d = own_clear(&mut c.taken)
    _e = own_clear(&mut c.used)
    tenv_truncate(&mut c.env, 0)

fn own_ctor_structs(out: &mut List[String], structs: &List[TStruct], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        sd = list_get(structs, i)
        if sd.is_frame == 0
            _a = list_push(out, strdup(sd.name))
            own_ctor_structs(out, structs, i + 1, n)
        else
            own_ctor_structs(out, structs, i + 1, n)

fn own_ctor_enums(out: &mut List[String], enums: &List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        e = list_get(enums, i)
        _a = own_ctor_variants(out, &e.variants, 0, list_len(&e.variants))
        own_ctor_enums(out, enums, i + 1, n)

fn own_ctor_variants(out: &mut List[String], vs: &List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        v = list_get(vs, i)
        if list_len(&v.fields) == 0
            own_ctor_variants(out, vs, i + 1, n)
        else
            _a = list_push(out, strdup(v.name))
            own_ctor_variants(out, vs, i + 1, n)

# Adds `name` to `set` when it is a parameter and is not there yet.
fn own_note_param(c: &OC, set: &mut List[String], name: &String) -> Int ! alloc
    if own_has(&c.params, name, 0, list_len(&c.params)) == 1
        if own_has(set, name, 0, list_len(set)) == 0
            _a = list_push(set, strdup(name))
            0
        else
            0
    else
        0

fn oc_fail(c: &mut OC, msg: &String) -> Int ! alloc
    if list_len(&c.err) == 0
        _a = list_push(&mut c.err, strdup(msg))
        0
    else
        0

fn oc_failed(c: &OC) -> Int ! alloc
    if list_len(&c.err) == 0
        0
    else
        1

# ---- name sets ----
fn own_copy(src: &List[String]) -> List[String] ! alloc
    out = list_new[String]()
    _a = own_append(&mut out, src, 0, list_len(src))
    out

fn own_append(dst: &mut List[String], src: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _p = list_push(dst, strdup(list_get(src, i)))
        own_append(dst, src, i + 1, n)

fn own_clear(xs: &mut List[String]) -> Int ! alloc
    if list_len(xs) > 0
        _a = list_pop(xs)
        own_clear(xs)
    else
        0

# `c.moved` becomes a copy of `src`.
fn oc_set_moved(c: &mut OC, src: &List[String]) -> Int ! alloc
    _a = own_clear(&mut c.moved)
    own_append(&mut c.moved, src, 0, list_len(src))

fn own_has(set: &List[String], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(set, i), name) == 1
        1
    else
        own_has(set, name, i + 1, n)

fn is_moved(c: &OC, name: &String) -> Int ! alloc
    own_has(&c.moved, name, 0, list_len(&c.moved))

fn mark_moved(c: &mut OC, name: &String) -> Int ! alloc
    if is_moved(c, name) == 0
        _a = list_push(&mut c.moved, strdup(name))
        0
    else
        0

# Elements of `src` other than `name`, copied into `dst`.
fn own_remove_go(src: &List[String], name: &String, dst: &mut List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(src, i), name) == 1
        own_remove_go(src, name, dst, i + 1, n)
    else
        _p = list_push(dst, strdup(list_get(src, i)))
        own_remove_go(src, name, dst, i + 1, n)

# `m` is `name.field`: a field of `name` that moved out.
fn own_is_field_of(m: &String, name: &String) -> Int ! alloc
    nl = str_len(name)
    if str_len(m) <= nl
        0
    elsif str_char(m, nl) != 46
        0
    else
        str_eq(str_slice(m, 0, nl), name)

fn own_any_field_go(set: &List[String], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif own_is_field_of(&list_get(set, i), name) == 1
        1
    else
        own_any_field_go(set, name, i + 1, n)

# The value, or any field of it, moved out.
fn is_moved_any(c: &OC, name: &String) -> Int ! alloc
    if is_moved(c, name) == 1
        1
    else
        own_any_field_go(&c.moved, name, 0, list_len(&c.moved))

fn own_revive_go(src: &List[String], name: &String, dst: &mut List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(src, i), name) == 1
        own_revive_go(src, name, dst, i + 1, n)
    elsif own_is_field_of(&list_get(src, i), name) == 1
        own_revive_go(src, name, dst, i + 1, n)
    else
        _p = list_push(dst, strdup(list_get(src, i)))
        own_revive_go(src, name, dst, i + 1, n)

fn unmove(c: &mut OC, name: &String) -> Int ! alloc
    if is_moved_any(c, name) == 1
        kept = list_new[String]()
        _a = own_revive_go(&c.moved, name, &mut kept, 0, list_len(&c.moved))
        _b = oc_set_moved(c, &kept)
        list_free(kept)
    else
        0

fn own_unmove_key(c: &mut OC, key: &String) -> Int ! alloc
    kept = list_new[String]()
    _a = own_remove_go(&c.moved, key, &mut kept, 0, list_len(&c.moved))
    _b = oc_set_moved(c, &kept)
    list_free(kept)

# Adds the elements of `src` that `dst` lacks.
fn own_union(dst: &mut List[String], src: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = list_get(src, i)
        if own_has(dst, &nm, 0, list_len(dst)) == 0
            _p = list_push(dst, strdup(nm))
            own_union(dst, src, i + 1, n)
        else
            own_union(dst, src, i + 1, n)

# `base.field` with a plain local as base: the moved-set key, else "".
fn own_field_key(e: &Expr) -> String ! alloc
    match e
        XField(base, field) => own_field_key_of(&base, &field)
        _ => ""

fn own_field_key_of(base: &Expr, field: &String) -> String ! alloc
    match base
        XIdent(name) => own_join(&name, field)
        _ => ""

fn own_join(a: &String, b: &String) -> String ! alloc
    a + "." + b

# The local a field expression reads from, "" when its base is not a plain local.
fn own_field_base(e: &Expr) -> String ! alloc
    match e
        XField(base, field) => own_ident_name(&base)
        _ => ""

fn own_ident_name(e: &Expr) -> String ! alloc
    match e
        XIdent(name) => name.dup()
        _ => ""

# ---- types: only what moves care about ----
fn own_is_copy(ty: &String) -> Int ! alloc
    if str_len(ty) == 0
        1
    elsif tt_matches(ty, &"Int") == 1
        1
    elsif tt_matches(ty, &"Float") == 1
        1
    elsif tt_matches(ty, &"Bool") == 1
        1
    elsif tt_matches(ty, &"Unit") == 1
        1
    elsif tt_matches(ty, &"Unknown") == 1
        1
    else
        0

# A type is Copy when it is Int, Float, Bool, Unit or Unknown, or a struct whose fields all are.
fn own_is_copy_ext(ty: &String, structs: &List[TStruct], depth: Int) -> Int ! alloc
    if own_is_copy(ty) == 1
        1
    elsif depth > 8
        0
    else
        si = tt_struct_find(structs, &ty_base_name(ty))
        if si < 0
            0
        else
            fields = list_get(structs, si).fields
            own_fields_copy(&fields, 0, list_len(&fields), structs, depth + 1)

fn own_fields_copy(fields: &List[TField], i: Int, n: Int, structs: &List[TStruct], depth: Int) -> Int ! alloc
    if i >= n
        1
    elsif own_is_copy_ext(&list_get(fields, i).ty, structs, depth) == 0
        0
    else
        own_fields_copy(fields, i + 1, n, structs, depth)

# The leading identifier of a type text (a generic type yields its bare name).
fn ty_base_name(ty: &String) -> String ! alloc
    n = str_len(ty)
    trim_spaces(str_slice(ty, 0, ty_name_end(ty, 0, n)))

fn ty_name_end(s: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        n
    elsif str_char(s, i) == 91
        i
    else
        ty_name_end(s, i + 1, n)

fn own_expr_ty(c: &OC, e: &Expr) -> String ! alloc
    match e
        XInt(v) => "Int"
        XFloat(bits, txt) => "Float"
        XBool(v) => "Bool"
        XStr(s) => "String"
        XIdent(name) => own_ident_ty(c, &name)
        XBin(op, l, r) => own_binary_ty(c, &op, &l)
        XUnary(op, inner) => own_expr_ty(c, &inner)
        XTo(place, inner) => own_expr_ty(c, &inner)
        XTensor(nr, nc, data) => "Tensor"
        XIf(cond, then_b, else_b, has_else, elsifs) => "Int"
        _ => "Unknown"

fn own_ident_ty(c: &OC, name: &String) -> String ! alloc
    t = tenv_type(&c.env, name)
    if str_len(t) == 0
        "Unknown"
    else
        t

fn own_binary_ty(c: &OC, op: &String, l: &Expr) -> String ! alloc
    if str_eq(op, "add") == 1
        if tt_is_string(&own_expr_ty(c, l)) == 1
            "String"
        else
            "Int"
    else
        "Int"

# ---- consuming ----
fn consume_if_unique(c: &mut OC, e: &Expr, ty: &String) -> Int ! alloc
    match e
        XNone => 0
        XField(base, field) => consume_field(c, e)
        XIdent(name) => consume_ident(c, &name, ty)
        _ => 0

fn consume_ident(c: &mut OC, name: &String, ty: &String) -> Int ! alloc
    if own_is_copy_ext(ty, &c.env.structs, 0) == 1
        0
    else
        _t = own_note_param(c, &mut c.taken, name)
        mark_moved(c, name)

# Moving `p.f` out of `p` when the field is not Copy.
# A field of a reference is still a copy of the handle.
fn consume_field(c: &mut OC, e: &Expr) -> Int ! alloc
    key = own_field_key(e)
    if str_len(key) == 0
        0
    elsif own_base_is_ref(c, e) == 1
        0
    elsif own_is_copy_ext(&texpr_type(&c.env, e), &c.env.structs, 0) == 1
        0
    else
        _t = own_note_param(c, &mut c.taken, &own_field_base(e))
        mark_moved(c, &key)

fn own_base_is_ref(c: &OC, e: &Expr) -> Int ! alloc
    base = own_field_base(e)
    if str_len(&base) == 0
        0
    else
        own_ty_is_ref(&tenv_type(&c.env, &base))

fn own_ty_is_ref(ty: &String) -> Int ! alloc
    if str_len(ty) == 0
        0
    elsif str_eq(str_slice(ty, 0, 1), "&") == 1
        1
    else
        0

fn is_move_fn(name: &String) -> Int ! alloc
    if str_eq(name, "save") == 1
        1
    elsif str_eq(name, "reshape") == 1
        1
    elsif str_eq(name, "transpose") == 1
        1
    elsif str_eq(name, "to_cpu") == 1
        1
    elsif str_eq(name, "to_gpu") == 1
        1
    else
        0

# ---- expressions ----
fn track_args(c: &mut OC, args: &List[Expr], i: Int, n: Int, tys: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        _t = list_push(tys, strdup(track_expr(c, &list_get(args, i))))
        track_args(c, args, i + 1, n, tys)

fn consume_args(c: &mut OC, args: &List[Expr], tys: &List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = consume_if_unique(c, &list_get(args, i), &list_get(tys, i))
        consume_args(c, args, tys, i + 1, n)

# Runs `b` from the moved set `base` and the env scope, then restores both. What a branch that
# falls through moved is added to `acc`; the caller applies it after the whole `if` (later
# conditions must not see it).
fn track_branch_block(c: &mut OC, b: &TBlock, base: &List[String], acc: &mut List[String]) -> Int ! alloc
    saved = own_copy(&c.moved)
    _s = oc_set_moved(c, base)
    mark = tenv_len(&c.env)
    div = track_block_tail(c, b, 0)
    _m = tenv_truncate(&mut c.env, mark)
    after = own_copy(&c.moved)
    _r = oc_set_moved(c, &saved)
    _fs = list_free(saved)
    if div == 1
        list_free(after)
    else
        _u = own_union(acc, &after, 0, list_len(&after))
        list_free(after)

# Statements and tail of a block, with its bindings dropped at the end.
fn track_block_scoped(c: &mut OC, b: &TBlock) -> Int ! alloc
    mark = tenv_len(&c.env)
    r = track_block(c, b)
    _s = tenv_truncate(&mut c.env, mark)
    r

fn track_elsifs(c: &mut OC, arms: &List[TElsif], i: Int, n: Int, base: &List[String], acc: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        _a = track_expr(c, &arm.cond)
        _b = track_branch_block(c, &arm.body, base, acc)
        track_elsifs(c, arms, i + 1, n, base, acc)

fn track_if(c: &mut OC, cond: &Expr, then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif]) -> String ! alloc
    _a = track_expr(c, cond)
    base = own_copy(&c.moved)
    acc = list_new[String]()
    _b = track_branch_block(c, then_b, &base, &mut acc)
    _c = track_elsifs(c, elsifs, 0, list_len(elsifs), &base, &mut acc)
    _d = track_else(c, else_b, has_else, &base, &mut acc)
    _u = own_union(&mut c.moved, &acc, 0, list_len(&acc))
    _f1 = list_free(base)
    _f2 = list_free(acc)
    "Int"

fn track_else(c: &mut OC, else_b: &TBlock, has_else: Int, base: &List[String], acc: &mut List[String]) -> Int ! alloc
    if has_else != 0
        track_branch_block(c, else_b, base, acc)
    else
        0

fn track_call(c: &mut OC, name: &String, args: &List[Expr], e: &Expr) -> String ! alloc
    tys = list_new[String]()
    _a = track_args(c, args, 0, list_len(args), &mut tys)
    modes = c.table.get(name)
    if is_move_fn(name) == 1
        _b = consume_args(c, args, &tys, 0, list_len(args))
    else
        _b = consume_moved_args(c, name, args, &tys, 0, list_len(args), &modes)
    _f = list_free(tys)
    if returns_owned_string(name) == 1
        "String"
    else
        own_call_ret(c, e)

# Declared result type of a constructor or user fn call, Unknown otherwise.
fn own_call_ret(c: &OC, e: &Expr) -> String ! alloc
    t = texpr_type(&c.env, e)
    if str_len(t) == 0
        "Unknown"
    else
        t

# Parameter mode `i` out of a table entry ("m" + digits): 0 when out of range.
fn own_mode_at(modes: &String, i: Int) -> Int ! alloc
    if i + 1 < str_len(modes)
        str_char(modes, i + 1) - 48
    else
        0

# 1 when the call moves its argument at position `i`: the value stored by `list_push`,
# `list_set` and `dict_put`, any constructor argument, or an argument at a `take` parameter.
fn call_moves_arg(c: &OC, name: &String, i: Int, modes: &String) -> Int ! alloc
    if str_eq(name, "list_push") == 1
        if i == 1
            1
        else
            0
    elsif str_eq(name, "list_set") == 1
        if i == 2
            1
        else
            0
    elsif str_eq(name, "dict_put") == 1
        if i == 2
            1
        else
            0
    elsif str_eq(name, "list_free_shell") + str_eq(name, "enum_free_shell") == 1
        if i == 0
            1
        else
            0
    elsif own_has(&c.ctors, name, 0, list_len(&c.ctors)) == 1
        1
    elsif own_mode_at(modes, i) == 2
        1
    else
        0

fn consume_moved_args(c: &mut OC, name: &String, args: &List[Expr], tys: &List[String], i: Int, n: Int, modes: &String) -> Int ! alloc
    if i >= n
        0
    else
        if call_moves_arg(c, name, i, modes) == 1
            _a = consume_if_unique(c, &list_get(args, i), &list_get(tys, i))
            consume_moved_args(c, name, args, tys, i + 1, n, modes)
        else
            consume_moved_args(c, name, args, tys, i + 1, n, modes)

# Builtins whose result is a fresh heap String (moved on use).
fn returns_owned_string(name: &String) -> Int ! alloc
    if str_eq(name, "strdup") == 1
        1
    elsif str_eq(name, "str_concat") == 1
        1
    elsif str_eq(name, "int_to_str") == 1
        1
    elsif str_eq(name, "char_to_str") == 1
        1
    elsif str_eq(name, "str_slice") == 1
        1
    elsif str_eq(name, "read_file") == 1
        1
    else
        0

fn track_use(c: &mut OC, e: &Expr, name: &String) -> String ! alloc
    if is_moved_any(c, name) == 1
        _f = oc_fail(c, &("use of moved value `" + name + "`"))
        "Unknown"
    else
        _u = own_note_param(c, &mut c.used, name)
        own_expr_ty(c, e)

# Reading `p.f`: fine unless `p` or that field moved out.
fn track_field(c: &mut OC, e: &Expr, base: &Expr) -> String ! alloc
    key = own_field_key(e)
    if str_len(key) == 0
        _t = track_expr(c, base)
        "Unknown"
    else
        who = own_ident_name(base)
        if is_moved(c, &who) + is_moved(c, &key) > 0
            _f = oc_fail(c, &("use of moved value `" + who + "`"))
            "Unknown"
        else
            _u = own_note_param(c, &mut c.used, &who)
            "Unknown"

fn track_expr(c: &mut OC, e: &Expr) -> String ! alloc
    match e
        XNone => "Unit"
        _ => track_expr_live(c, e)

fn track_expr_live(c: &mut OC, e: &Expr) -> String ! alloc
    if oc_failed(c) == 1
        "Unknown"
    else
        track_expr_go(c, e)

fn track_expr_go(c: &mut OC, e: &Expr) -> String ! alloc
    match e
        XIdent(name) => track_use(c, e, &name)
        XCall(name, args, targs, xp) => track_call(c, &name, &args, e)
        XBin(op, l, r) => track_binary(c, &op, &l, &r)
        XUnary(op, inner) => track_expr(c, &inner)
        XTry(inner) => track_expr(c, &inner)
        XTo(place, inner) => track_to(c, &inner)
        XOn(place, body, is_kern, has_index) => track_on(c, &body)
        XField(base, field) => track_field(c, e, &base)
        XIf(cond, then_b, else_b, has_else, elsifs) => track_if(c, &cond, &then_b, &else_b, has_else, &elsifs)
        XMatch(scrut, arms) => track_match(c, &scrut, &arms)
        XWhile(cond, body) => track_while(c, &cond, &body)
        XLambda(param, body) => track_lambda(c, &param, &body)
        _ => own_expr_ty(c, e)

fn track_binary(c: &mut OC, op: &String, l: &Expr, r: &Expr) -> String ! alloc
    lt = track_expr(c, l)
    _r = track_expr(c, r)
    if str_eq(op, "add") == 1
        if tt_is_string(&lt) == 1
            "String"
        else
            "Int"
    else
        "Int"

fn track_to(c: &mut OC, inner: &Expr) -> String ! alloc
    ty = track_expr(c, inner)
    _m = consume_if_unique(c, inner, &ty)
    ty

fn track_on(c: &mut OC, body: &TBlock) -> String ! alloc
    _t = track_block_scoped(c, body)
    "Unit"

fn track_lambda(c: &mut OC, param: &String, body: &Expr) -> String ! alloc
    mark = tenv_len(&c.env)
    _b = tenv_bind(&mut c.env, param, &"Float")
    _t = track_expr(c, body)
    _s = tenv_truncate(&mut c.env, mark)
    "Unknown"

# `match x`: the scrutinee is read. Each arm starts from that moved set; a move in
# one arm does not move the value in another. What falls through is the union.
fn track_match(c: &mut OC, scrut: &Expr, arms: &List[TArm]) -> String ! alloc
    _s = track_expr(c, scrut)
    base = own_copy(&c.moved)
    acc = list_new[String]()
    _a = track_match_arms(c, arms, 0, list_len(arms), &base, &mut acc)
    _u = own_union(&mut c.moved, &acc, 0, list_len(&acc))
    _f1 = list_free(base)
    _f2 = list_free(acc)
    "Unknown"

fn track_match_arms(c: &mut OC, arms: &List[TArm], i: Int, n: Int, base: &List[String], acc: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        _a = track_match_arm(c, &list_get(arms, i), base, acc)
        track_match_arms(c, arms, i + 1, n, base, acc)

fn track_match_arm(c: &mut OC, arm: &TArm, base: &List[String], acc: &mut List[String]) -> Int ! alloc
    saved = own_copy(&c.moved)
    _s = oc_set_moved(c, base)
    mark = tenv_len(&c.env)
    _b = own_bind_pattern(c, &arm.pat)
    div = track_match_arm_body(c, arm)
    _r = tenv_truncate(&mut c.env, mark)
    after = own_copy(&c.moved)
    _t = oc_set_moved(c, &saved)
    _fs = list_free(saved)
    if div == 1
        list_free(after)
    else
        _u = own_union(acc, &after, 0, list_len(&after))
        list_free(after)

fn track_match_arm_body(c: &mut OC, arm: &TArm) -> Int ! alloc
    if arm.has_suite == 1
        track_block_scoped(c, &arm.suite)
    else
        _t = track_expr(c, &arm.body)
        0

fn own_bind_pattern(c: &mut OC, p: &TPat) -> Int ! alloc
    if p.kind == 1
        tenv_bind(&mut c.env, &p.name, &"Unknown")
    elsif p.kind == 3
        own_bind_patterns(c, &p.args, 0, list_len(&p.args))
    else
        0

fn own_bind_patterns(c: &mut OC, ps: &List[TPat], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = own_bind_pattern(c, &list_get(ps, i))
        own_bind_patterns(c, ps, i + 1, n)

# The body moves persist when it does not diverge. A value still live on the
# back edge is moved again on the next iteration: that use is E_MOVED.
fn track_while(c: &mut OC, cond: &Expr, body: &TBlock) -> String ! alloc
    _a = track_expr(c, cond)
    saved = own_copy(&c.moved)
    div = track_block_scoped(c, body)
    if div == 1
        _r = oc_set_moved(c, &saved)
        _f = list_free(saved)
        "Unit"
    else
        _g = track_while_again(c, cond, body)
        _f = list_free(saved)
        "Unit"

fn track_while_again(c: &mut OC, cond: &Expr, body: &TBlock) -> Int ! alloc
    body_moved = own_copy(&c.moved)
    _c = track_expr(c, cond)
    _b = track_block_scoped(c, body)
    _r = oc_set_moved(c, &body_moved)
    list_free(body_moved)

# ---- statements ----
# `name = name + ...` with a string chain starting at `name`.
fn own_accumulates(value: &Expr, name: &String) -> Int ! alloc
    match value
        XBin(op, l, r) => own_accumulates_bin(&op, value, name)
        _ => 0

fn own_accumulates_bin(op: &String, value: &Expr, name: &String) -> Int ! alloc
    if str_eq(op, "add") == 1
        str_eq(own_leftmost(value), name)
    else
        0

# Name at the left end of a `+` chain, "" when it is not a plain local.
fn own_leftmost(e: &Expr) -> String ! alloc
    match e
        XBin(op, l, r) => own_leftmost_add(&op, &l)
        XIdent(name) => name.dup()
        _ => ""

fn own_leftmost_add(op: &String, l: &Expr) -> String ! alloc
    if str_eq(op, "add") == 1
        own_leftmost(l)
    else
        ""

# Consumes the left end of a chain when it is a plain local.
fn own_consume_leftmost(c: &mut OC, e: &Expr, ty: &String) -> Int ! alloc
    match e
        XBin(op, l, r) => own_consume_leftmost_add(c, &op, &l, ty)
        XIdent(name) => consume_ident(c, &name, ty)
        _ => 0

fn own_consume_leftmost_add(c: &mut OC, op: &String, l: &Expr, ty: &String) -> Int ! alloc
    if str_eq(op, "add") == 1
        own_consume_leftmost(c, l, ty)
    else
        0

# Returns 1 when the statement diverges (return).
fn track_stmt(c: &mut OC, st: &TStmt) -> Int ! alloc
    if st.kind == 2
        track_return(c, &st.expr)
    elsif st.kind == 1
        track_binding(c, st)
    elsif st.kind == 3
        track_field_assign(c, st)
    else
        _a = track_expr(c, &st.expr)
        0

fn track_return(c: &mut OC, ex: &Expr) -> Int ! alloc
    ty = track_expr(c, ex)
    _m = consume_if_unique(c, ex, &ty)
    1

fn track_binding(c: &mut OC, st: &TStmt) -> Int ! alloc
    ty = track_expr(c, &st.expr)
    _m = consume_if_unique(c, &st.expr, &ty)
    _x = track_accumulate(c, st, &ty)
    bound = if str_len(st.ty) > 0
        st.ty.clone()
    else
        ty
    _b = tenv_bind(&mut c.env, &st.name, &bound)
    _u = unmove(c, &st.name)
    0

fn track_accumulate(c: &mut OC, st: &TStmt, ty: &String) -> Int ! alloc
    if tt_is_string(ty) == 1
        if own_accumulates(&st.expr, &st.name) == 1
            own_consume_leftmost(c, &st.expr, ty)
        else
            0
    else
        0

fn track_field_assign(c: &mut OC, st: &TStmt) -> Int ! alloc
    ty = track_expr(c, &st.expr)
    _m = consume_if_unique(c, &st.expr, &ty)
    _b = track_assign_target(c, &st.target)
    0

# `p.f = v` puts a moved field back; any other target is read as usual.
fn track_assign_target(c: &mut OC, t: &Expr) -> Int ! alloc
    key = own_field_key(t)
    if str_len(key) == 0
        _a = track_expr(c, t)
        0
    else
        who = own_field_base(t)
        if is_moved(c, &who) == 1
            oc_fail(c, &("use of moved value `" + who + "`"))
        else
            own_unmove_key(c, &key)

fn track_stmts(c: &mut OC, stmts: &List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif oc_failed(c) == 1
        0
    else
        if track_stmt(c, &list_get(stmts, i)) == 1
            1
        else
            track_stmts(c, stmts, i + 1, n)

# Returns 1 when the block diverges.
fn track_block(c: &mut OC, b: &TBlock) -> Int ! alloc
    track_block_tail(c, b, 1)

# `consume` is 0 for the arm of an `if`, whose tail value is not moved (as in Rust).
fn track_block_tail(c: &mut OC, b: &TBlock, consume: Int) -> Int ! alloc
    if track_stmts(c, &b.stmts, 0, list_len(&b.stmts)) == 1
        1
    else
        track_tail(c, &b.tail, consume)

# One match: a later use of `tail` would see a moved expression.
fn track_tail(c: &mut OC, tail: &Expr, consume: Int) -> Int ! alloc
    match tail
        XNone => 0
        XIdent(name) => track_tail_name(c, &name, consume)
        _ => track_tail_other(c, tail, consume)

# `return t` moves that parameter. `own_param_mode` still leaves a Copy type inferred.
fn track_tail_name(c: &mut OC, name: &String, consume: Int) -> Int ! alloc
    _u = own_note_param(c, &mut c.used, name)
    if consume == 1
        own_note_param(c, &mut c.taken, name)
    else
        0

fn track_tail_other(c: &mut OC, tail: &Expr, consume: Int) -> Int ! alloc
    ty = track_expr(c, tail)
    if consume == 1
        consume_if_unique(c, tail, &ty)
    else
        0

fn own_seed_params(c: &mut OC, params: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(params, i)
        _b = tenv_bind(&mut c.env, &pm.name, &pm.ty)
        own_seed_params(c, params, i + 1, n)

fn own_seed_names(c: &mut OC, params: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = list_push(&mut c.params, strdup(list_get(params, i).name))
        own_seed_names(c, params, i + 1, n)

# ---- checking ----
fn check_fn_moves(c: &mut OC, f: &TFn) -> Res ! alloc
    _r = oc_reset(c)
    _s = own_seed_params(c, &f.params, 0, list_len(&f.params))
    _t = track_block(c, &f.body)
    own_fn_result(c)

fn own_fn_result(c: &OC) -> Res ! alloc
    if oc_failed(c) == 1
        result_err_str(&list_get(&c.err, 0))
    else
        result_ok(0)

fn check_ownership_go(c: &mut OC, fns: &List[TFn], i: Int, n: Int) -> Res ! alloc
    if i >= n
        result_ok(0)
    else
        r = check_fn_moves(c, &list_get(fns, i))
        if result_is_err(&r) == 1
            r
        else
            check_ownership_go(c, fns, i + 1, n)

# Ok(0), or Err(message) for the first use of a moved value.
fn check_ownership(tp: &TProgram) -> Res ! alloc
    table = own_mode_table(tp)
    c = oc_new(tp, table)
    r = check_ownership_go(&mut c, &tp.fns, 0, list_len(&tp.fns))
    r2 = if result_is_err(&r) == 1
        r
    else
        check_arena(tp, &c.table)
    _f = oc_free(&c)
    r2

# ---- parameter modes (the mirror of `infer_param_modes` in src/ownership.rs) ----

# The mode of parameter `pm` once the body has been tracked in `c` (as `infer_fn_modes` in Rust).
# A reference parameter (`&T`, `&mut T`) is never taken: passing it does not move the caller's value.
# Any other parameter of a type that is not `Copy` takes its argument (a move, as in Rust), whether
# the callee reads it or not; in an `@arena` fn parameters are read-only.
fn own_param_mode(c: &OC, pm: &TParam, arena: Int) -> Int ! alloc
    if pm.mode != 0
        pm.mode
    elsif str_len(&pm.ty) > 0 && pm.ty.char(0) == 38
        0
    elsif own_is_copy_ext(&pm.ty, &c.env.structs, 0) == 1
        0
    elsif arena == 1
        1
    else
        2

fn own_mode_text(c: &OC, params: &List[TParam], i: Int, n: Int, acc: String, arena: Int) -> String ! alloc
    if i >= n
        acc
    else
        m = own_param_mode(c, &list_get(params, i), arena)
        own_mode_text(c, params, i + 1, n, (acc + int_to_str(m)), arena)

# "m" + the modes of `f` given the callee modes in `table`.
fn infer_fn_modes(c: &mut OC, f: &TFn) -> String ! alloc
    _r = oc_reset(c)
    _s = own_seed_params(c, &f.params, 0, list_len(&f.params))
    _n = own_seed_names(c, &f.params, 0, list_len(&f.params))
    _t = track_block(c, &f.body)
    _k = own_pin_tail(c, &f.body.tail)
    own_mode_text(c, &f.params, 0, list_len(&f.params), "m", f.arena)

# `return t` takes that parameter. Pushed here, after the walk, so a moved tail match cannot drop it.
fn own_pin_tail(c: &mut OC, tail: &Expr) -> Int ! alloc
    match tail
        XIdent(name) => own_pin_name(c, &name)
        _ => 0

fn own_pin_name(c: &mut OC, name: &String) -> Int ! alloc
    _p = list_push(&mut c.taken, name.dup())
    0

fn own_explicit_text(params: &List[TParam], i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        own_explicit_text(params, i + 1, n, (acc + int_to_str(list_get(params, i).mode)))

fn own_table_explicit(table: &mut HT, fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        _a = table.put(&f.name, &own_explicit_text(&f.params, 0, list_len(&f.params), "m"))
        own_table_explicit(table, fns, i + 1, n)

# One round over every fn; returns 1 when some fn's modes differ from `table`.
fn own_table_round(c: &mut OC, fns: &List[TFn], next: &mut HT, i: Int, n: Int, changed: Int) -> Int ! alloc
    if i >= n
        changed
    else
        f = list_get(fns, i)
        v = infer_fn_modes(c, &f)
        _p = next.put(&f.name, &v)
        same = str_eq(v, c.table.get(&f.name))
        any = if same == 1
            changed
        else
            1
        own_table_round(c, fns, next, i + 1, n, any)

fn own_table_fix(tp: &TProgram, table: HT, round: Int) -> HT ! alloc
    if round >= 16
        table
    else
        c = oc_new(tp, table)
        next = HT.new(list_len(&tp.fns))
        ch = own_table_round(&mut c, &tp.fns, &mut next, 0, list_len(&tp.fns), 0)
        _f = oc_free(&c)
        if ch == 0
            next
        else
            own_table_fix(tp, next, round + 1)

# Fn name -> "m" + parameter modes (0 inferred/copy, 1 borrow, 2 take), as a fixpoint: a fn that
# hands a parameter to a `take` position of another fn takes it too.
fn own_mode_table(tp: &TProgram) -> HT ! alloc
    table = HT.new(list_len(&tp.fns))
    _a = own_table_explicit(&mut table, &tp.fns, 0, list_len(&tp.fns))
    own_table_fix(tp, table, 0)

# ---- @arena: parameters are read-only, except `keep` ----

fn ar_zeros(n: Int, acc: String) -> String ! alloc
    if n <= 0
        acc
    else
        ar_zeros(n - 1, (acc + "0"))

fn ar_seed(fns: &List[TFn], i: Int, n: Int, muts: &mut HT) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(fns, i)
        _p = muts.put(&f.name, &ar_zeros(list_len(&f.params), ""))
        ar_seed(fns, i + 1, n, muts)

fn ar_bit(text: &String, i: Int) -> Int ! alloc
    if i < 0
        0
    elsif i >= str_len(text)
        0
    elsif str_char(text, i) == 49
        1
    else
        0

fn ar_set_bit_go(text: &String, i: Int, at: Int, n: Int, acc: String) -> String ! alloc
    if at >= n
        acc
    elsif at == i
        ar_set_bit_go(text, i, at + 1, n, (acc + "1"))
    else
        ar_set_bit_go(text, i, at + 1, n, (acc + char_to_str(str_char(text, at))))

fn ar_mark(text: &String, i: Int) -> String ! alloc
    if ar_bit(text, i) == 1
        text.dup()
    elsif i < 0
        text.dup()
    else
        ar_set_bit_go(text, i, 0, str_len(text), "")

fn ar_mode_at(table: &HT, fname: &String, i: Int) -> Int ! alloc
    text = table.get(fname)
    if i + 1 >= str_len(text)
        0
    else
        str_char(text, i + 1) - 48

fn ar_mut_at(muts: &HT, fname: &String, i: Int) -> Int ! alloc
    ar_bit(&muts.get(fname), i)

fn ar_idx(params: &List[TParam], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        -1
    elsif str_eq(list_get(params, i).name, name) == 1
        i
    else
        ar_idx(params, name, i + 1, n)

fn ar_root(names: &List[String], roots: &List[String], name: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    elsif str_eq(list_get(names, i), name) == 1
        list_get(roots, i).clone()
    else
        ar_root(names, roots, name, i + 1, n)

fn ar_param_of(f: &TFn, names: &List[String], roots: &List[String], e: &Expr) -> Int ! alloc
    match e
        XIdent(name) =>
            root = ar_root(names, roots, &name, 0, list_len(names))
            if str_len(root) == 0
                -1
            else
                ar_idx(&f.params, &root, 0, list_len(&f.params))
        _ => -1

fn ar_mut_builtin(name: &String) -> Int ! alloc
    if str_eq(name, "list_push") == 1
        1
    elsif str_eq(name, "list_set") == 1
        1
    elsif str_eq(name, "list_pop") == 1
        1
    elsif str_eq(name, "dict_put") == 1
        1
    elsif str_eq(name, "dict_remove") == 1
        1
    elsif str_eq(name, "bytes_set_u8") == 1
        1
    elsif str_eq(name, "bytes_set_u32") == 1
        1
    elsif str_eq(name, "bytes_fill") == 1
        1
    elsif str_eq(name, "bytes_fill_u32") == 1
        1
    elsif str_eq(name, "bytes_copy") == 1
        1
    else
        0

fn ar_apply(name: &String, args: &List[Expr], f: &TFn, names: &List[String], roots: &List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    flags1 = if ar_mut_builtin(name) == 1
        if list_len(args) == 0
            flags.dup()
        else
            ar_mark(flags, ar_param_of(f, names, roots, &list_get(args, 0)))
    else
        flags.dup()
    if str_len(table.get(name)) == 0
        flags1
    else
        ar_apply_args(name, args, 0, list_len(args), f, names, roots, table, muts, &flags1)

fn ar_apply_args(name: &String, args: &List[Expr], i: Int, n: Int, f: &TFn, names: &List[String], roots: &List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    if i >= n
        flags.dup()
    else
        src = ar_param_of(f, names, roots, &list_get(args, i))
        mode = ar_mode_at(table, name, i)
        dest_mut = ar_mut_at(muts, name, i)
        flags2 = if src < 0
            flags.dup()
        elsif mode == 2
            ar_mark(flags, src)
        elsif mode == 3
            ar_mark(flags, src)
        elsif dest_mut == 1
            ar_mark(flags, src)
        else
            flags.dup()
        ar_apply_args(name, args, i + 1, n, f, names, roots, table, muts, &flags2)

fn ar_args(args: &List[Expr], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    if i >= n
        flags.dup()
    else
        flags2 = ar_expr(&list_get(args, i), f, names, roots, table, muts, flags)
        ar_args(args, i + 1, n, f, names, roots, table, muts, &flags2)

fn ar_elsifs(xs: &List[TElsif], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    if i >= n
        flags.dup()
    else
        el = list_get(xs, i)
        flags2 = ar_expr(&el.cond, f, names, roots, table, muts, flags)
        flags3 = ar_block(&el.body, f, names, roots, table, muts, &flags2)
        ar_elsifs(xs, i + 1, n, f, names, roots, table, muts, &flags3)

fn ar_arms(xs: &List[TArm], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    if i >= n
        flags.dup()
    else
        arm = list_get(xs, i)
        flags2 = ar_expr(&arm.body, f, names, roots, table, muts, flags)
        flags3 = if arm.has_suite == 1
            ar_block(&arm.suite, f, names, roots, table, muts, &flags2)
        else
            flags2
        ar_arms(xs, i + 1, n, f, names, roots, table, muts, &flags3)

fn ar_expr(e: &Expr, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    match e
        XCall(name, args, _t, _p) =>
            flags2 = ar_args(&args, 0, list_len(&args), f, names, roots, table, muts, flags)
            ar_apply(&name, &args, f, names, roots, table, muts, &flags2)
        XBin(_op, l, r) =>
            flags2 = ar_expr(&l, f, names, roots, table, muts, flags)
            ar_expr(&r, f, names, roots, table, muts, &flags2)
        XUnary(_op, inner) => ar_expr(&inner, f, names, roots, table, muts, flags)
        XTo(_p, inner) => ar_expr(&inner, f, names, roots, table, muts, flags)
        XTry(inner) => ar_expr(&inner, f, names, roots, table, muts, flags)
        XField(base, _field) => ar_expr(&base, f, names, roots, table, muts, flags)
        XLambda(_param, body) => ar_expr(&body, f, names, roots, table, muts, flags)
        XIf(cond, th, el, _h, els) =>
            flags2 = ar_expr(&cond, f, names, roots, table, muts, flags)
            flags3 = ar_block(&th, f, names, roots, table, muts, &flags2)
            flags4 = ar_block(&el, f, names, roots, table, muts, &flags3)
            ar_elsifs(&els, 0, list_len(&els), f, names, roots, table, muts, &flags4)
        XWhile(cond, body) =>
            flags2 = ar_expr(&cond, f, names, roots, table, muts, flags)
            ar_block(&body, f, names, roots, table, muts, &flags2)
        XOn(_place, body, _k, _i) => ar_block(&body, f, names, roots, table, muts, flags)
        XMatch(sc, arms) =>
            flags2 = ar_expr(&sc, f, names, roots, table, muts, flags)
            ar_arms(&arms, 0, list_len(&arms), f, names, roots, table, muts, &flags2)
        _ => flags

fn ar_note(st: &TStmt, names: &mut List[String], roots: &mut List[String]) -> Int ! alloc
    if st.kind != 1
        0
    else
        match st.expr
            XIdent(rhs) =>
                root = ar_root(names, roots, &rhs, 0, list_len(names))
                if str_len(root) == 0
                    0
                else
                    _a = list_push(names, st.name.clone())
                    _b = list_push(roots, root)
                    0
            _ => 0

fn ar_stmts(xs: &List[TStmt], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    if i >= n
        flags.dup()
    else
        st = list_get(xs, i)
        _n = ar_note(&st, names, roots)
        flags2 = ar_expr(&st.expr, f, names, roots, table, muts, flags)
        flags3 = if st.kind == 3
            ar_expr(&st.target, f, names, roots, table, muts, &flags2)
        else
            flags2
        ar_stmts(xs, i + 1, n, f, names, roots, table, muts, &flags3)

fn ar_block(b: &TBlock, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT, flags: &String) -> String ! alloc
    flags2 = ar_stmts(&b.stmts, 0, list_len(&b.stmts), f, names, roots, table, muts, flags)
    ar_expr(&b.tail, f, names, roots, table, muts, &flags2)

fn ar_seed_alias(params: &List[TParam], i: Int, n: Int, names: &mut List[String], roots: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(params, i)
        _a = list_push(names, strdup(pm.name))
        _b = list_push(roots, strdup(pm.name))
        ar_seed_alias(params, i + 1, n, names, roots)

fn ar_fn_flags(f: &TFn, table: &HT, muts: &HT) -> String ! alloc
    names = list_new[String]()
    roots = list_new[String]()
    _s = ar_seed_alias(&f.params, 0, list_len(&f.params), &mut names, &mut roots)
    flags = ar_block(&f.body, f, &mut names, &mut roots, table, muts, &ar_zeros(list_len(&f.params), ""))
    _a = list_free(names)
    _b = list_free(roots)
    flags

fn ar_round(fns: &List[TFn], i: Int, n: Int, table: &HT, muts: &mut HT, changed: Int) -> Int ! alloc
    if i >= n
        changed
    else
        f = list_get(fns, i)
        text = ar_fn_flags(&f, table, muts)
        old = muts.get(&f.name)
        ch = if str_eq(old, text) == 1
            changed
        else
            _p = muts.put(&f.name, &text)
            1
        ar_round(fns, i + 1, n, table, muts, ch)

fn ar_fix(tp: &TProgram, table: &HT, muts: &mut HT, nleft: Int) -> Int ! alloc
    if nleft <= 0
        0
    else
        changed = ar_round(&tp.fns, 0, list_len(&tp.fns), table, muts, 0)
        if changed == 0
            0
        else
            ar_fix(tp, table, muts, nleft - 1)

fn ar_keep_bad(name: &String, args: &List[Expr], f: &TFn, names: &List[String], roots: &List[String], table: &HT, muts: &HT) -> String ! alloc
    if str_len(table.get(name)) == 0
        ""
    else
        ar_keep_args(name, args, 0, list_len(args), f, names, roots, table, muts)

fn ar_keep_args(name: &String, args: &List[Expr], i: Int, n: Int, f: &TFn, names: &List[String], roots: &List[String], table: &HT, muts: &HT) -> String ! alloc
    if i >= n
        ""
    else
        src = ar_param_of(f, names, roots, &list_get(args, i))
        mode = ar_mode_at(table, name, i)
        dest_mut = ar_mut_at(muts, name, i)
        if src < 0
            ar_keep_args(name, args, i + 1, n, f, names, roots, table, muts)
        elsif list_get(&f.params, src).mode != 3
            ar_keep_args(name, args, i + 1, n, f, names, roots, table, muts)
        elsif mode == 2
            "keep parameter `" + list_get(&f.params, src).name + "` cannot be passed here"
        elsif dest_mut == 1
            if mode == 3
                ar_keep_args(name, args, i + 1, n, f, names, roots, table, muts)
            else
                "keep parameter `" + list_get(&f.params, src).name + "` cannot be passed here"
        else
            ar_keep_args(name, args, i + 1, n, f, names, roots, table, muts)

fn ar_store_bad(name: &String, args: &List[Expr], f: &TFn, names: &List[String], roots: &List[String]) -> String ! alloc
    if str_eq(name, "list_push") + str_eq(name, "list_set") + str_eq(name, "dict_put") == 0
        ""
    elsif list_len(args) == 0
        ""
    else
        src = ar_param_of(f, names, roots, &list_get(args, 0))
        if src < 0
            ""
        elsif list_get(&f.params, src).mode != 3
            ""
        else
            ar_store_args(args, 1, list_len(args))

fn ar_store_args(args: &List[Expr], i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    else
        e = list_get(args, i)
        match e
            XTensor(_r, _c, _d) => "@arena keep cannot store this value"
            XCall(name, _a, _t, _p) =>
                if str_eq(name, "load") == 1
                    "@arena keep cannot store this value"
                else
                    ar_store_args(args, i + 1, n)
            _ => ar_store_args(args, i + 1, n)

fn ar_err_expr(e: &Expr, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT) -> String ! alloc
    match e
        XCall(name, args, _t, _p) =>
            msg = ar_err_args(&args, 0, list_len(&args), f, names, roots, table, muts)
            if str_len(msg) > 0
                msg
            else
                bad = ar_keep_bad(&name, &args, f, names, roots, table, muts)
                if str_len(bad) > 0
                    bad
                else
                    ar_store_bad(&name, &args, f, names, roots)
        XBin(_op, l, r) =>
            msg = ar_err_expr(&l, f, names, roots, table, muts)
            if str_len(msg) > 0
                msg
            else
                ar_err_expr(&r, f, names, roots, table, muts)
        XUnary(_op, inner) => ar_err_expr(&inner, f, names, roots, table, muts)
        XTo(_p, inner) => ar_err_expr(&inner, f, names, roots, table, muts)
        XTry(inner) => ar_err_expr(&inner, f, names, roots, table, muts)
        XField(base, _field) => ar_err_expr(&base, f, names, roots, table, muts)
        XLambda(_param, body) => ar_err_expr(&body, f, names, roots, table, muts)
        XIf(cond, th, el, _h, els) =>
            msg = ar_err_expr(&cond, f, names, roots, table, muts)
            if str_len(msg) > 0
                msg
            else
                msg2 = ar_err_block(&th, f, names, roots, table, muts)
                if str_len(msg2) > 0
                    msg2
                else
                    msg3 = ar_err_block(&el, f, names, roots, table, muts)
                    if str_len(msg3) > 0
                        msg3
                    else
                        ar_err_elsifs(&els, 0, list_len(&els), f, names, roots, table, muts)
        XWhile(cond, body) =>
            msg = ar_err_expr(&cond, f, names, roots, table, muts)
            if str_len(msg) > 0
                msg
            else
                ar_err_block(&body, f, names, roots, table, muts)
        XOn(_place, body, _k, _i) => ar_err_block(&body, f, names, roots, table, muts)
        XMatch(sc, arms) =>
            msg = ar_err_expr(&sc, f, names, roots, table, muts)
            if str_len(msg) > 0
                msg
            else
                ar_err_arms(&arms, 0, list_len(&arms), f, names, roots, table, muts)
        _ => ""

fn ar_err_args(args: &List[Expr], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT) -> String ! alloc
    if i >= n
        ""
    else
        msg = ar_err_expr(&list_get(args, i), f, names, roots, table, muts)
        if str_len(msg) > 0
            msg
        else
            ar_err_args(args, i + 1, n, f, names, roots, table, muts)

fn ar_err_elsifs(xs: &List[TElsif], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT) -> String ! alloc
    if i >= n
        ""
    else
        el = list_get(xs, i)
        msg = ar_err_expr(&el.cond, f, names, roots, table, muts)
        if str_len(msg) > 0
            msg
        else
            msg2 = ar_err_block(&el.body, f, names, roots, table, muts)
            if str_len(msg2) > 0
                msg2
            else
                ar_err_elsifs(xs, i + 1, n, f, names, roots, table, muts)

fn ar_err_arms(xs: &List[TArm], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT) -> String ! alloc
    if i >= n
        ""
    else
        arm = list_get(xs, i)
        msg = ar_err_expr(&arm.body, f, names, roots, table, muts)
        if str_len(msg) > 0
            msg
        else
            msg2 = if arm.has_suite == 1
                ar_err_block(&arm.suite, f, names, roots, table, muts)
            else
                ""
            if str_len(msg2) > 0
                msg2
            else
                ar_err_arms(xs, i + 1, n, f, names, roots, table, muts)

fn ar_err_stmts(xs: &List[TStmt], i: Int, n: Int, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT) -> String ! alloc
    if i >= n
        ""
    else
        st = list_get(xs, i)
        _n = ar_note(&st, names, roots)
        msg = ar_err_expr(&st.expr, f, names, roots, table, muts)
        if str_len(msg) > 0
            msg
        else
            msg2 = if st.kind == 3
                ar_err_expr(&st.target, f, names, roots, table, muts)
            else
                ""
            if str_len(msg2) > 0
                msg2
            else
                ar_err_stmts(xs, i + 1, n, f, names, roots, table, muts)

fn ar_err_block(b: &TBlock, f: &TFn, names: &mut List[String], roots: &mut List[String], table: &HT, muts: &HT) -> String ! alloc
    msg = ar_err_stmts(&b.stmts, 0, list_len(&b.stmts), f, names, roots, table, muts)
    if str_len(msg) > 0
        msg
    else
        ar_err_expr(&b.tail, f, names, roots, table, muts)

fn ar_fn_err(f: &TFn, table: &HT, muts: &HT) -> String ! alloc
    msg = ar_param_err(f, table, &muts.get(&f.name), 0, list_len(&f.params))
    if str_len(msg) > 0
        msg
    else
        names = list_new[String]()
        roots = list_new[String]()
        _s = ar_seed_alias(&f.params, 0, list_len(&f.params), &mut names, &mut roots)
        bad = ar_err_block(&f.body, f, &mut names, &mut roots, table, muts)
        _a = list_free(names)
        _b = list_free(roots)
        bad

fn ar_param_err(f: &TFn, table: &HT, flags: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    else
        pm = list_get(&f.params, i)
        mode = ar_mode_at(table, &f.name, i)
        if pm.mode == 3
            ar_param_err(f, table, flags, i + 1, n)
        elsif ar_bit(flags, i) == 1
            "@arena parameter `" + pm.name + "` is read-only"
        elsif mode == 2
            "@arena parameter `" + pm.name + "` is read-only"
        else
            ar_param_err(f, table, flags, i + 1, n)

fn ar_report(fns: &List[TFn], i: Int, n: Int, table: &HT, muts: &HT) -> Res ! alloc
    if i >= n
        result_ok(0)
    else
        f = list_get(fns, i)
        if f.arena == 0
            ar_report(fns, i + 1, n, table, muts)
        else
            msg = ar_fn_err(&f, table, muts)
            if str_len(msg) > 0
                result_err_str(&msg)
            else
                ar_report(fns, i + 1, n, table, muts)

# The mutates fixpoint copies nothing it needs when no function is `@arena`.
# Running it on the compiler itself (thousands of functions) exhausts memory.
fn ar_any(fns: &List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(fns, i).arena == 1
        1
    else
        ar_any(fns, i + 1, n)

fn check_arena(tp: &TProgram, table: &HT) -> Res ! alloc
    if ar_any(&tp.fns, 0, list_len(&tp.fns)) == 0
        result_ok(0)
    else
        check_arena_go(tp, table)

fn check_arena_go(tp: &TProgram, table: &HT) -> Res ! alloc
    muts = HT.new(list_len(&tp.fns))
    _z = ar_seed(&tp.fns, 0, list_len(&tp.fns), &mut muts)
    _r = ar_fix(tp, table, &mut muts, list_len(&tp.fns) + 1)
    r = ar_report(&tp.fns, 0, list_len(&tp.fns), table, &muts)
    _f = muts.free()
    r
