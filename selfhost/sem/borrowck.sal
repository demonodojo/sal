# Borrow checker, the mirror of check_borrows in src/borrowck.rs.
# Moves stay in ownership.sal (E_MOVED). This pass adds E_BORROW: a loan that
# overlaps a mutation or another exclusive loan, a reference that outlives its
# referent, and moving a non-Copy value out of a reference (`*r`).
import "../pkg/result.sal"
import "../ast/tast.sal"
import "../ast/ttypes.sal"
import "../ast/tytext.sal"
import ownership

# Positions are a counter shared by the scan (last use of each loan) and the
# walk (the loans and the moves). `cells[0]` is that counter.
struct BK
    env: TEnv
    err: List[String]
    l_place: List[String]
    l_mut: List[Int]
    l_start: List[Int]
    l_end: List[Int]
    m_place: List[String]
    m_at: List[Int]
    ne_at: List[Int]
    ne_end: List[Int]
    o_name: List[String]
    o_kind: List[Int]
    o_place: List[String]
    o_at: List[Int]
    scope_o: List[Int]
    scope_t: List[Int]
    w_start: List[Int]
    w_end: List[Int]
    cells: List[Int]
    # The local whose uses keep each loan alive (its binding position), or -1 for a loan
    # that ends where its range does (`Loan.uses` in src/borrowck.rs).
    l_key: List[Int]
    # Every use the scan noted: the binding position and the use.
    ue_at: List[Int]
    ue_pos: List[Int]
    # The branches of each `if` / `match` (positions after `g_s`, up to `g_e`), by group.
    g_id: List[Int]
    g_s: List[Int]
    g_e: List[Int]
    # The parameter modes and constructors of the program: which call arguments move.
    table: HT
    ctors: List[String]
    # `r = &b` writing an outer `r` with a `b` of the inner scope: the binding position of that
    # `r` (whose later uses keep the loan), `b`, and the scope depth that ends `b`.
    sc_key: List[Int]
    sc_place: List[String]
    sc_depth: List[Int]
    # The fns that return a reference, the argument it borrows from (by elision or by its
    # lifetime) and whether it is `&mut`.
    rf_name: List[String]
    rf_arg: List[Int]
    rf_mut: List[Int]

fn bk_new(tp: &TProgram) -> BK ! alloc
    cells = list_new[Int]()
    _c = list_push(&mut cells, 0)
    _g = list_push(&mut cells, 0)
    BK(tenv_new(tp), List.new[String](), List.new[String](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[String](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[String](), List.new[Int](), List.new[String](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), cells, List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), List.new[Int](), own_mode_table(tp), own_ctor_names(tp), List.new[Int](), List.new[String](), List.new[Int](), List.new[String](), List.new[Int](), List.new[Int]())

fn bk_clock(c: &BK) -> Int ! alloc
    list_get(&c.cells, 0)

fn bk_tick(c: &mut BK) -> Int ! alloc
    n = list_get(&c.cells, 0) + 1
    _s = list_set(&mut c.cells, 0, n)
    n

fn bk_reset_clock(c: &mut BK) -> Int ! alloc
    _s = list_set(&mut c.cells, 0, 0)
    0

# Records each fn of `fns` whose result is a reference and the parameter it borrows from: the
# one whose lifetime the result names, else `&self`, else the only reference parameter.
fn bk_ref_fns(c: &mut BK, fns: &List[TFn]) -> Int ! alloc
    i = 0
    while i < fns.len()
        f = fns.get(i)
        if own_ty_is_ref(&f.ret) == 1
            k = bk_ref_source(&f.params, &bk_life_of(&f.ret))
            if k >= 0
                c.rf_name.push(f.name.clone())
                c.rf_arg.push(k)
                c.rf_mut.push(ty_is_mut_ref(&f.ret))
        i = i + 1
    0

# The lifetime `'a` of a reference type `&'a T`, or "".
fn bk_life_of(ty: &String) -> String ! alloc
    if ty.len() > 2 && ty.char(0) == 38 && ty.char(1) == 39
        ty.slice(1, bk_life_end(ty, 2))
    else
        ""

fn bk_life_end(ty: &String, i: Int) -> Int ! alloc
    if i >= ty.len() || ty.char(i) == 32
        i
    else
        bk_life_end(ty, i + 1)

fn bk_ref_source(ps: &List[TParam], life: &String) -> Int ! alloc
    i = 0
    found = 0 - 1
    refs = 0
    only = 0 - 1
    while i < ps.len()
        t = ps.get(i).ty.clone()
        if own_ty_is_ref(&t) == 1
            refs = refs + 1
            only = i
            if life.len() > 0 && found < 0 && bk_life_of(&t).eq(life) == 1
                found = i
            if life.len() == 0 && found < 0 && i == 0 && ps.get(i).name.eq("self") == 1
                found = i
        i = i + 1
    if found >= 0
        found
    elsif life.len() == 0 && refs == 1
        only
    else
        0 - 1

fn bk_rf_find(c: &BK, name: &String) -> Int ! alloc
    i = 0
    found = 0 - 1
    while i < c.rf_name.len() && found < 0
        if c.rf_name.get(i).eq(name) == 1
            found = i
        i = i + 1
    found

# The place a call that returns a reference borrows (`name(&p)` borrows `p`), or "".
fn bk_call_ref_place(c: &BK, e: &Expr) -> String ! alloc
    match e
        XCall(name, args, targs, xp) => bk_call_ref_place_go(c, &name, &args)
        _ => ""

fn bk_call_ref_place_go(c: &BK, name: &String, args: &List[Expr]) -> String ! alloc
    k = bk_rf_find(c, name)
    if k < 0 || c.rf_arg.get(k) >= args.len()
        ""
    else
        a = args.get(c.rf_arg.get(k))
        place = bk_ref_place(&a)
        if place.len() > 0
            place
        else
            match a
                XIdent(n) => bk_origin_place(c, &n)
                _ => ""

fn bk_call_ref_mut(c: &BK, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => bk_call_ref_mut_go(c, &name)
        _ => 0

fn bk_call_ref_mut_go(c: &BK, name: &String) -> Int ! alloc
    k = bk_rf_find(c, name)
    if k < 0
        0
    else
        c.rf_mut.get(k)

fn bk_failed(c: &BK) -> Int ! alloc
    if list_len(&c.err) == 0
        0
    else
        1

fn bk_fail(c: &mut BK, msg: &String) -> Int ! alloc
    if list_len(&c.err) == 0
        _a = list_push(&mut c.err, strdup(msg))
        0
    else
        0

fn bk_push(c: &mut BK) -> Int ! alloc
    _a = list_push(&mut c.scope_o, list_len(&c.o_name))
    _b = list_push(&mut c.scope_t, tenv_len(&c.env))
    0

fn bk_trunc(c: &mut BK, n: Int) -> Int ! alloc
    if list_len(&c.o_name) <= n
        0
    else
        _a = list_pop(&mut c.o_name)
        _b = list_pop(&mut c.o_kind)
        _c = list_pop(&mut c.o_place)
        _d = list_pop(&mut c.o_at)
        bk_trunc(c, n)

fn bk_pop(c: &mut BK) -> Int ! alloc
    bk_scope_ends(c, c.scope_o.len(), bk_clock(c))
    _a = bk_trunc(c, list_pop(&mut c.scope_o))
    tenv_truncate(&mut c.env, list_pop(&mut c.scope_t))

# The scope at `depth` ends at `end`: a reference into one of its locals that an outer local
# holds must not be used after it (`referent_end` in src/borrowck.rs).
fn bk_scope_ends(c: &mut BK, depth: Int, end: Int) -> Int ! alloc
    while c.sc_depth.len() > 0 && c.sc_depth.get(c.sc_depth.len() - 1) >= depth
        key = c.sc_key.pop()
        place = c.sc_place.pop()
        c.sc_depth.pop()
        if bk_used_after(c, key, end) == 1
            bk_fail(c, &("E_BORROW: `" + place + "` does not live long enough: a reference to it is used after its scope"))
    0

fn bk_used_after(c: &BK, key: Int, end: Int) -> Int ! alloc
    i = 0
    found = 0
    while i < c.ue_at.len() && found == 0
        if c.ue_at.get(i) == key && c.ue_pos.get(i) > end
            found = 1
        i = i + 1
    found

# `name = &place` writes a local of an outer scope with a loan of a local of this one.
fn bk_note_scoped_ref(c: &mut BK, st: &TStmt, place: &String) -> Int ! alloc
    here = c.scope_o.get(c.scope_o.len() - 1)
    oi = bk_idx(c, &st.name)
    ri = bk_idx(c, &bk_root(place))
    key = bk_at(c, &st.name)
    if st.is_let == 0 && oi >= 0 && oi < here && ri >= here && key >= 0
        c.sc_key.push(key)
        c.sc_place.push(place.clone())
        c.sc_depth.push(c.scope_o.len())
    0

fn bk_find(c: &BK, name: &String, i: Int) -> Int ! alloc
    if i < 0
        0 - 1
    elsif str_eq(&list_get(&c.o_name, i), name) == 1
        i
    else
        bk_find(c, name, i - 1)

fn bk_idx(c: &BK, name: &String) -> Int ! alloc
    bk_find(c, name, list_len(&c.o_name) - 1)

fn bk_bind(c: &mut BK, name: &String, ty: &String, kind: Int, place: &String, at: Int) -> Int ! alloc
    _a = list_push(&mut c.o_name, strdup(name))
    _b = list_push(&mut c.o_kind, kind)
    _c = list_push(&mut c.o_place, strdup(place))
    _d = list_push(&mut c.o_at, at)
    tenv_bind(&mut c.env, name, ty)

fn bk_kind(c: &BK, name: &String) -> Int ! alloc
    i = bk_idx(c, name)
    if i < 0
        0 - 1
    else
        list_get(&c.o_kind, i)

fn bk_at(c: &BK, name: &String) -> Int ! alloc
    i = bk_idx(c, name)
    if i < 0
        0 - 1
    elsif c.o_kind.get(i) == 2 || c.o_kind.get(i) == 4
        list_get(&c.o_at, i)
    else
        0 - 1

fn bk_origin_place(c: &BK, name: &String) -> String ! alloc
    i = bk_idx(c, name)
    if i < 0
        ""
    else
        list_get(&c.o_place, i).clone()

fn bk_ne_find(c: &BK, at: Int, i: Int) -> Int ! alloc
    if i >= list_len(&c.ne_at)
        0 - 1
    elsif list_get(&c.ne_at, i) == at
        i
    else
        bk_ne_find(c, at, i + 1)

fn bk_ne_set(c: &mut BK, at: Int, end: Int) -> Int ! alloc
    i = bk_ne_find(c, at, 0)
    if i < 0
        _a = list_push(&mut c.ne_at, at)
        _b = list_push(&mut c.ne_end, end)
        0
    elsif list_get(&c.ne_end, i) < end
        _s = list_set(&mut c.ne_end, i, end)
        0
    else
        0

fn bk_ne_get(c: &BK, at: Int) -> Int ! alloc
    i = bk_ne_find(c, at, 0)
    if i < 0
        at
    else
        list_get(&c.ne_end, i)

fn bk_note(c: &mut BK, name: &String, end: Int) -> Int ! alloc
    at = bk_at(c, name)
    if at < 0
        0
    else
        c.ue_at.push(at)
        c.ue_pos.push(end)
        bk_ne_set(c, at, end)

fn bk_copy(c: &BK, ty: &String) -> Int ! alloc
    if str_len(ty) == 0
        1
    elsif own_ty_is_ref(ty) == 1
        if bk_mut_ref(ty) == 1
            0
        else
            1
    else
        own_is_copy_ext(ty, &c.env.structs, 0)

fn bk_mut_ref(ty: &String) -> Int ! alloc
    if str_len(ty) >= 5
        str_eq(&str_slice(ty, 0, 5), &"&mut ")
    else
        0

fn bk_peel(ty: &String) -> String ! alloc
    if bk_mut_ref(ty) == 1
        str_slice(ty, 5, str_len(ty))
    elsif str_len(ty) >= 1
        if str_eq(&str_slice(ty, 0, 1), &"&") == 1
            bk_after_amp(&str_slice(ty, 1, str_len(ty)))
        else
            strdup(ty)
    else
        strdup(ty)

fn bk_after_amp(rest: &String) -> String ! alloc
    if str_len(rest) >= 1
        if str_char(rest, 0) == 39
            bk_after_life(rest, 1, str_len(rest))
        else
            strdup(rest)
    else
        strdup(rest)

fn bk_after_life(rest: &String, i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    elsif str_char(rest, i) == 32
        bk_skip_mut(&str_slice(rest, i + 1, n))
    else
        bk_after_life(rest, i + 1, n)

fn bk_skip_mut(rest: &String) -> String ! alloc
    if str_len(rest) >= 4
        if str_eq(&str_slice(rest, 0, 4), &"mut ") == 1
            str_slice(rest, 4, str_len(rest))
        else
            strdup(rest)
    else
        strdup(rest)

fn bk_place(e: &Expr) -> String ! alloc
    match e
        XIdent(name) => strdup(name)
        XField(base, field) => bk_place_field(&base, &field)
        _ => ""

fn bk_place_field(base: &Expr, field: &String) -> String ! alloc
    p = bk_place(base)
    if str_len(&p) == 0
        ""
    else
        p + "." + field

fn bk_ref_place(e: &Expr) -> String ! alloc
    match e
        XUnary(op, inner) => bk_ref_place_op(&op, &inner)
        _ => ""

fn bk_ref_place_op(op: &String, inner: &Expr) -> String ! alloc
    if str_eq(op, &"ref") + str_eq(op, &"refmut") == 1
        bk_place(inner)
    else
        ""

fn bk_ref_mut(e: &Expr) -> Int ! alloc
    match e
        XUnary(op, inner) => str_eq(&op, &"refmut")
        _ => 0

fn bk_bound_ty(c: &BK, st: &TStmt) -> String ! alloc
    if str_len(&st.ty) > 0
        strdup(st.ty)
    elsif bk_is_ref_expr(&st.expr) == 1
        # `texpr_type` erases the reference of `&x` (the C emitter does not need it).
        bk_expr_ty(c, &st.expr)
    else
        known = texpr_type(&c.env, &st.expr)
        if str_len(&known) > 0
            known
        else
            bk_expr_ty(c, &st.expr)

fn bk_is_ref_expr(e: &Expr) -> Int ! alloc
    match e
        XUnary(op, inner) => op.eq("ref") + op.eq("refmut")
        _ => 0

fn bk_expr_ty(c: &BK, e: &Expr) -> String ! alloc
    match e
        XIdent(name) => tenv_type(&c.env, &name)
        XUnary(op, inner) => bk_guess_unary(c, &op, &inner)
        XStr(s) => "String"
        XInt(v) => "Int"
        XBool(v) => "Bool"
        XFloat(bits, txt) => "Float"
        _ => ""

fn bk_guess_unary(c: &BK, op: &String, inner: &Expr) -> String ! alloc
    u = bk_expr_ty(c, inner)
    if str_eq(op, &"ref") == 1
        "&" + u
    elsif str_eq(op, &"refmut") == 1
        "&mut " + u
    elsif str_eq(op, &"deref") == 1
        bk_peel(&u)
    else
        u

fn bk_root(place: &String) -> String ! alloc
    i = bk_dot(place, 0, str_len(place))
    if i < 0
        strdup(place)
    else
        str_slice(place, 0, i)

fn bk_dot(place: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_char(place, i) == 46
        i
    else
        bk_dot(place, i + 1, n)

fn bk_root_param(c: &BK, place: &String) -> Int ! alloc
    root = bk_root(place)
    if bk_kind(c, &root) == 1
        1
    else
        0

fn bk_overlaps(a: &String, b: &String) -> Int ! alloc
    if str_eq(a, b) == 1
        1
    elsif bk_prefix(a, b) == 1
        1
    elsif bk_prefix(b, a) == 1
        1
    else
        0

fn bk_prefix(longer: &String, shorter: &String) -> Int ! alloc
    n = str_len(shorter)
    if str_len(longer) <= n
        0
    elsif str_eq(&str_slice(longer, 0, n), shorter) == 0
        0
    elsif str_char(longer, n) == 46
        1
    else
        0

fn bk_ranges(a0: Int, a1: Int, b0: Int, b1: Int) -> Int ! alloc
    if a0 < b1
        if b0 < a1
            1
        else
            0
    else
        0

fn bk_loan(c: &mut BK, place: &String, mutable: Int, start: Int, end: Int) -> Int ! alloc
    bk_loan_key(c, place, mutable, start, end, 0 - 1)

# A loan that a local holds: the uses of the local bound at `key` keep it alive.
fn bk_loan_key(c: &mut BK, place: &String, mutable: Int, start: Int, end: Int, key: Int) -> Int ! alloc
    if str_len(place) == 0
        0
    else
        _a = list_push(&mut c.l_place, strdup(place))
        _b = list_push(&mut c.l_mut, mutable)
        _c = list_push(&mut c.l_start, start)
        _d = list_push(&mut c.l_end, end)
        c.l_key.push(key)
        0

fn bk_move(c: &mut BK, place: &String, at: Int) -> Int ! alloc
    if str_len(place) == 0
        0
    else
        _a = list_push(&mut c.m_place, strdup(place))
        _b = list_push(&mut c.m_at, at)
        0

fn bk_maybe_move(c: &mut BK, name: &String, at: Int) -> Int ! alloc
    ty = tenv_type(&c.env, name)
    if bk_copy(c, &ty) == 1
        0
    else
        bk_move(c, name, at)

fn bk_check_deref(c: &mut BK, inner: &Expr) -> Int ! alloc
    ty = bk_deref_ty(c, inner)
    if own_ty_is_ref(&ty) == 0
        0
    elsif bk_copy(c, &bk_peel(&ty)) == 1
        0
    else
        bk_fail(c, &"E_BORROW: cannot move a non-Copy value out of a reference")

fn bk_deref_ty(c: &BK, inner: &Expr) -> String ! alloc
    known = texpr_type(&c.env, inner)
    if str_len(&known) > 0
        known
    else
        bk_expr_ty(c, inner)

fn bk_params(c: &mut BK, ps: &List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(ps, i)
        kind = if own_ty_is_ref(&pm.ty) == 1
            1
        else
            0
        _b = bk_bind(c, &pm.name, &pm.ty, kind, &"", 0)
        bk_params(c, ps, i + 1, n)

# mode 0 scans (notes last uses and bindings). mode 1 reads. mode 2 moves.
fn bk_child(mode: Int) -> Int ! alloc
    if mode == 0
        0
    else
        1

fn bk_visit(c: &mut BK, e: &Expr, mode: Int) -> Int ! alloc
    pos = bk_tick(c)
    _g = bk_visit_go(c, e, mode, pos)
    pos

fn bk_visit_go(c: &mut BK, e: &Expr, mode: Int, pos: Int) -> Int ! alloc
    match e
        XIdent(name) => bk_visit_ident(c, &name, mode, pos)
        XUnary(op, inner) => bk_visit_unary(c, &op, &inner, mode)
        XCall(name, args, targs, xp) => bk_visit_call(c, &name, &args, mode)
        XField(base, field) => bk_visit_field(c, e, &base, mode, pos)
        XBin(op, l, r) => bk_visit_bin(c, &l, &r, mode)
        XIf(cond, then_b, else_b, has_else, elsifs) => bk_visit_if(c, &cond, &then_b, &else_b, has_else, &elsifs, mode)
        XWhile(cond, body) => bk_visit_while(c, &cond, &body, mode, pos)
        XMatch(scrut, arms) => bk_visit_match(c, &scrut, &arms, mode)
        XTo(place, inner) => bk_visit(c, &inner, bk_move_mode(mode))
        XTry(inner) => bk_visit(c, &inner, bk_move_mode(mode))
        XLambda(param, body) => bk_visit(c, &body, bk_child(mode))
        XOn(place, body, is_kern, has_index) => bk_block(c, &body, 0, mode)
        _ => 0

fn bk_move_mode(mode: Int) -> Int ! alloc
    if mode == 0
        0
    else
        2

fn bk_visit_ident(c: &mut BK, name: &String, mode: Int, pos: Int) -> Int ! alloc
    if mode == 0
        bk_note(c, name, pos)
    elsif mode == 2
        bk_maybe_move(c, name, pos)
    else
        0

fn bk_visit_unary(c: &mut BK, op: &String, inner: &Expr, mode: Int) -> Int ! alloc
    # Only a use by value moves out of the reference: `*r + "x"` and `(*r).len()` read it.
    if str_eq(op, &"deref") == 1
        if mode == 2
            _d = bk_check_deref(c, inner)
            bk_visit(c, inner, bk_child(mode))
        else
            bk_visit(c, inner, 0)
    else
        bk_visit(c, inner, bk_child(mode))

fn bk_visit_field(c: &mut BK, e: &Expr, base: &Expr, mode: Int, pos: Int) -> Int ! alloc
    if mode == 2
        ty = texpr_type(&c.env, e)
        if bk_copy(c, &ty) == 0
            # SPEC «Memoria»: a non-`Copy` value does not move out of a reference.
            if ty.len() > 0 && tt_matches(&ty, &"Unknown") == 0 && own_ty_is_ref(&ty) == 0 && bk_behind_ref(c, base) == 1
                _f = bk_fail(c, &("E_BORROW: cannot move `" + bk_place(e) + "` out of a reference: use `.clone()`"))
            _m = bk_move(c, &bk_place(e), pos)
            bk_visit(c, base, bk_child(mode))
        else
            bk_visit(c, base, bk_child(mode))
    else
        bk_visit(c, base, bk_child(mode))

# `e` is reached through a reference (`r.f` with `r: &T`, or deeper): `behind_ref` in Rust.
fn bk_behind_ref(c: &BK, e: &Expr) -> Int ! alloc
    match e
        XIdent(name) => own_ty_is_ref(&tenv_type(&c.env, &name))
        XField(base, field) => bk_behind_ref(c, &base)
        XUnary(op, inner) => op.eq("ref") + op.eq("refmut")
        _ => 0

# Writing through `e` goes through a shared reference: `behind_shared` in Rust.
fn bk_behind_shared(c: &BK, e: &Expr) -> Int ! alloc
    match e
        XIdent(name) => bk_shared_ty(&tenv_type(&c.env, &name))
        XField(base, field) => bk_behind_shared(c, &base)
        XUnary(op, inner) => bk_behind_shared_deref(c, &op, &inner)
        _ => 0

fn bk_behind_shared_deref(c: &BK, op: &String, inner: &Expr) -> Int ! alloc
    if op.eq("deref") == 1
        bk_behind_shared(c, inner)
    else
        0

fn bk_shared_ty(ty: &String) -> Int ! alloc
    if own_ty_is_ref(ty) == 1 && ty_is_mut_ref(ty) == 0
        1
    else
        0

fn bk_visit_bin(c: &mut BK, l: &Expr, r: &Expr, mode: Int) -> Int ! alloc
    _a = bk_visit(c, l, bk_child(mode))
    bk_visit(c, r, bk_child(mode))

fn bk_visit_if(c: &mut BK, cond: &Expr, then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif], mode: Int) -> Int ! alloc
    _a = bk_visit(c, cond, bk_child(mode))
    gid = bk_group(c)
    s = bk_clock(c)
    _b = bk_block(c, then_b, 0, mode)
    bk_branch(c, mode, gid, s)
    _e = bk_elsifs(c, elsifs, 0, list_len(elsifs), mode, gid)
    if has_else == 1
        s2 = bk_clock(c)
        bk_block(c, else_b, 0, mode)
        bk_branch(c, mode, gid, s2)
    0

# A new group of sibling branches (`groups` in src/borrowck.rs).
fn bk_group(c: &mut BK) -> Int ! alloc
    g = c.cells.get(1) + 1
    c.cells.set(1, g)
    g

# The scan records the branch that began after `s` and ends now.
fn bk_branch(c: &mut BK, mode: Int, gid: Int, s: Int) -> Int ! alloc
    if mode == 0
        c.g_id.push(gid)
        c.g_s.push(s)
        c.g_e.push(bk_clock(c))
    0

fn bk_elsifs(c: &mut BK, elsifs: &List[TElsif], i: Int, n: Int, mode: Int, gid: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(elsifs, i)
        _a = bk_visit(c, &arm.cond, bk_child(mode))
        s = bk_clock(c)
        _b = bk_block(c, &arm.body, 0, mode)
        bk_branch(c, mode, gid, s)
        bk_elsifs(c, elsifs, i + 1, n, mode, gid)

fn bk_visit_while(c: &mut BK, cond: &Expr, body: &TBlock, mode: Int, pos: Int) -> Int ! alloc
    if mode == 0
        _w = list_push(&mut c.w_start, pos)
        _a = bk_visit(c, cond, 0)
        _b = bk_block(c, body, 0, 0)
        h466_0 = bk_clock(c)
        _e = list_push(&mut c.w_end, h466_0)
        0
    else
        _a = bk_visit(c, cond, 1)
        bk_block(c, body, 0, mode)

fn bk_visit_match(c: &mut BK, scrut: &Expr, arms: &List[TArm], mode: Int) -> Int ! alloc
    _a = bk_visit(c, scrut, bk_child(mode))
    bk_arms(c, arms, 0, list_len(arms), mode, bk_group(c))

fn bk_arms(c: &mut BK, arms: &List[TArm], i: Int, n: Int, mode: Int, gid: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(arms, i)
        s = bk_clock(c)
        _a = bk_arm(c, &arm, mode)
        bk_branch(c, mode, gid, s)
        bk_arms(c, arms, i + 1, n, mode, gid)

fn bk_arm(c: &mut BK, arm: &TArm, mode: Int) -> Int ! alloc
    if arm.has_suite == 1
        bk_block(c, &arm.suite, 0, mode)
    else
        bk_visit(c, &arm.body, mode)

fn bk_visit_call(c: &mut BK, name: &String, args: &List[Expr], mode: Int) -> Int ! alloc
    n0 = c.l_place.len()
    bk_call_args(c, name, args, 0, args.len(), mode)
    bk_recv_loan(c, name, args, mode, bk_tick(c))
    if mode == 0
        0
    else
        bk_extend_loans(c, n0, list_len(&c.l_place), bk_clock(c))

fn bk_call_args(c: &mut BK, name: &String, args: &List[Expr], i: Int, n: Int, mode: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(args, i)
        apos = bk_visit(c, &a, bk_arg_mode(c, name, &a, i, mode))
        _l = bk_call_arg_loan(c, &a, mode, apos)
        bk_call_args(c, name, args, i + 1, n, mode)

# An argument the call moves (a `take` parameter, a constructor, the value `push` stores) is a
# use by value; any other is read. A `&x` argument lends instead.
fn bk_arg_mode(c: &BK, name: &String, a: &Expr, i: Int, mode: Int) -> Int ! alloc
    if mode == 0 || bk_is_ref_expr(a) == 1
        bk_child(mode)
    elsif own_call_moves_arg(&c.ctors, name, i, &c.table.get(name)) == 1
        2
    else
        bk_child(mode)

# The receiver of a builtin method lent by autoref (`xs.push(v)` is `list_push(xs, v)`): a
# mutating one takes `&mut` (`mutates_container` in src/ownership.rs), a thread primitive `&`.
# Like Rust's two-phase borrow, the loan starts when the call runs, after its arguments
# (`xs.set(i, xs.get(i) + 1)` is valid), and lasts one position.
fn bk_recv_loan(c: &mut BK, name: &String, args: &List[Expr], mode: Int, at: Int) -> Int ! alloc
    if mode == 0 || args.len() == 0
        0
    else
        place = bk_place(&args.get(0))
        if place.len() == 0
            0
        elsif bk_mutates_container(name) == 1
            if bk_behind_shared(c, &args.get(0)) == 1
                _f = bk_fail(c, &("E_BORROW: cannot mutate `" + place + "` through a `&` reference: it must be `&mut`"))
            bk_loan(c, &place, 1, at, at + 1)
        elsif bk_sync_shared(name) == 1
            bk_loan(c, &place, 0, at, at + 1)
        else
            0

fn bk_mutates_container(name: &String) -> Int ! alloc
    match name
        "list_push" => 1
        "list_set" => 1
        "list_pop" => 1
        "dict_put" => 1
        "dict_remove" => 1
        "bytes_set_u8" => 1
        "bytes_set_u32" => 1
        "bytes_fill" => 1
        "bytes_fill_u32" => 1
        "bytes_copy" => 1
        _ => 0

fn bk_sync_shared(name: &String) -> Int ! alloc
    match name
        "mutex_leave" => 1
        "sem_acquire" => 1
        "sem_try_acquire" => 1
        "sem_release" => 1
        "chan_send" => 1
        "chan_recv" => 1
        "chan_close" => 1
        _ => 0

# The loan of a `&x` argument lasts until its own call returns: it is created open (end -1) and
# `bk_extend_loans` closes it there. A nested call closed its loans before, so
# `f(g(&mut x), &x)` does not overlap.
fn bk_call_arg_loan(c: &mut BK, a: &Expr, mode: Int, apos: Int) -> Int ! alloc
    if mode == 0
        0
    else
        place = bk_ref_place(a)
        if str_len(&place) == 0
            0
        else
            bk_loan(c, &place, bk_ref_mut(a), apos, 0 - 1)

fn bk_extend_loans(c: &mut BK, i: Int, n: Int, end: Int) -> Int ! alloc
    if i >= n
        0
    elsif list_get(&c.l_end, i) < 0
        _s = list_set(&mut c.l_end, i, end)
        bk_extend_loans(c, i + 1, n, end)
    else
        bk_extend_loans(c, i + 1, n, end)

fn bk_block(c: &mut BK, b: &TBlock, fn_tail: Int, mode: Int) -> Int ! alloc
    _p = bk_push(c)
    _s = bk_stmts(c, &b.stmts, 0, list_len(&b.stmts), mode)
    _t = bk_tail(c, &b.tail, fn_tail, mode)
    if mode == 0
        bk_keep_threads(c, b, c.scope_o.get(c.scope_o.len() - 1))
    bk_pop(c)

fn bk_tail(c: &mut BK, e: &Expr, fn_tail: Int, mode: Int) -> Int ! alloc
    match e
        XNone => 0
        _ => bk_tail_go(c, e, fn_tail, mode)

fn bk_tail_go(c: &mut BK, e: &Expr, fn_tail: Int, mode: Int) -> Int ! alloc
    if fn_tail == 1
        if mode != 0
            _r = bk_returned(c, e)
            bk_visit(c, e, 2)
        else
            bk_visit(c, e, 0)
    else
        bk_visit(c, e, bk_child(mode))

fn bk_stmts(c: &mut BK, xs: &List[TStmt], i: Int, n: Int, mode: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(xs, i)
        _a = bk_stmt(c, &st, mode)
        bk_stmts(c, xs, i + 1, n, mode)

fn bk_stmt(c: &mut BK, st: &TStmt, mode: Int) -> Int ! alloc
    _t = bk_tick(c)
    if st.kind == 2
        bk_stmt_return(c, &st.expr, mode)
    elsif st.kind == 1
        bk_stmt_bind(c, st, mode)
    elsif st.kind == 3
        bk_stmt_field(c, st, mode)
    elsif st.kind == 0
        bk_visit(c, &st.expr, bk_child(mode))
    else
        0

fn bk_stmt_return(c: &mut BK, e: &Expr, mode: Int) -> Int ! alloc
    match e
        XNone => 0
        _ => bk_stmt_return_go(c, e, mode)

fn bk_stmt_return_go(c: &mut BK, e: &Expr, mode: Int) -> Int ! alloc
    if mode != 0
        _r = bk_returned(c, e)
        bk_visit(c, e, 2)
    else
        bk_visit(c, e, 0)

fn bk_stmt_bind(c: &mut BK, st: &TStmt, mode: Int) -> Int ! alloc
    # Rebinding an existing local writes its place, even when its type is Copy.
    # A `let` introduces a new binding instead of writing an outer one.
    if mode != 0 && st.is_let == 0 && bk_idx(c, &st.name) >= 0
        bk_move(c, &st.name, bk_clock(c))
    place = bk_ref_place(&st.expr)
    cplace = bk_call_ref_place(c, &st.expr)
    if str_len(&place) > 0
        epos = bk_visit(c, &st.expr, bk_child(mode))
        _n = bk_bind_ref(c, st, &place, epos, mode)
        0
    elsif cplace.len() > 0
        # The reference a call returns keeps the loan of the argument it borrows from.
        epos = bk_visit(c, &st.expr, bk_child(mode))
        if mode == 0
            bk_ne_set(c, epos, epos)
        else
            bk_loan_key(c, &cplace, bk_call_ref_mut(c, &st.expr), epos, bk_ne_get(c, epos), epos)
        ty = bk_bound_ty(c, st)
        bk_bind(c, &st.name, &ty, 2, &cplace, epos)
    elsif bk_is_call(&st.expr, &"thread_spawn") == 1
        bk_bind_thread(c, st, mode)
    elsif bk_is_call(&st.expr, &"mutex_enter") + bk_is_get_mut(&st.expr) + bk_is_get_ref(c, st) > 0
        # `m.enter()` and `xs.get_mut(i)` lend in exclusive while their `&mut T` lives, and
        # `xs.get(i)` of a non-`Copy` element shared while its `&T` does (SPEC «Hilos»,
        # «Memoria»). That loan covers the call's own `&mut xs`, which is dropped.
        n0 = c.l_place.len()
        epos = bk_visit(c, &st.expr, bk_child(mode))
        mplace = bk_enter_place(&st.expr)
        if mode == 0
            bk_ne_set(c, epos, epos)
            ty = bk_bound_ty(c, st)
            bk_bind(c, &st.name, &ty, 2, &mplace, epos)
        else
            bk_void_loans(c, n0, &mplace)
            bk_loan_key(c, &mplace, 1 - bk_is_get_ref(c, st), epos, bk_ne_get(c, epos), epos)
            ty = bk_bound_ty(c, st)
            bk_bind(c, &st.name, &ty, 2, &mplace, epos)
    else
        _v = bk_visit(c, &st.expr, bk_move_mode(mode))
        ty = bk_bound_ty(c, st)
        bk_bind(c, &st.name, &ty, 0, &"", 0)

fn bk_bind_ref(c: &mut BK, st: &TStmt, place: &String, epos: Int, mode: Int) -> Int ! alloc
    if mode == 0
        _n = bk_ne_set(c, epos, epos)
        ty = bk_bound_ty(c, st)
        bk_bind(c, &st.name, &ty, 2, place, epos)
    else
        bk_note_scoped_ref(c, st, place)
        _l = bk_loan_key(c, place, bk_ref_mut(&st.expr), epos, bk_ne_get(c, epos), epos)
        ty = bk_bound_ty(c, st)
        bk_bind(c, &st.name, &ty, 2, place, epos)

fn bk_stmt_field(c: &mut BK, st: &TStmt, mode: Int) -> Int ! alloc
    _v = bk_visit(c, &st.expr, bk_move_mode(mode))
    # The target only reads its root (`*v = x`, `p.f = x`): it is scanned for last uses.
    bk_visit(c, &st.target, 0)
    if mode == 0
        0
    else
        bk_move(c, &bk_place(&st.target), bk_clock(c))

fn bk_returned(c: &mut BK, e: &Expr) -> Int ! alloc
    if bk_escapes(c, e) == 1
        bk_fail(c, &"E_BORROW: returning a reference to a local")
    else
        0

fn bk_escapes(c: &BK, e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => bk_escapes_spawn(c, e)
        XUnary(op, inner) => bk_escapes_ref(c, &op, &inner)
        XIdent(name) => bk_escapes_ident(c, &name)
        XField(base, field) => bk_escapes_field(c, e, &base)
        XIf(cond, then_b, else_b, has_else, elsifs) => bk_escapes_if(c, &then_b, &else_b, has_else, &elsifs)
        _ => 0

fn bk_escapes_ref(c: &BK, op: &String, inner: &Expr) -> Int ! alloc
    if str_eq(op, &"ref") + str_eq(op, &"refmut") == 0
        0
    else
        place = bk_place(inner)
        if str_len(&place) == 0
            0
        elsif bk_root_param(c, &place) == 1
            0
        else
            1

fn bk_escapes_ident(c: &BK, name: &String) -> Int ! alloc
    k = bk_kind(c, name)
    if k == 1
        0
    elsif k == 2
        if bk_root_param(c, &bk_origin_place(c, name)) == 1
            0
        else
            1
    elsif k == 4
        lent = bk_origin_place(c, name)
        if lent.len() == 0 || bk_root_param(c, &lent) == 1
            0
        else
            1
    elsif k == 0
        own_ty_is_ref(&tenv_type(&c.env, name))
    else
        0

fn bk_escapes_field(c: &BK, e: &Expr, base: &Expr) -> Int ! alloc
    ty = texpr_type(&c.env, e)
    if own_ty_is_ref(&ty) == 0
        0
    else
        bk_escapes(c, base)

fn bk_escapes_if(c: &BK, then_b: &TBlock, else_b: &TBlock, has_else: Int, elsifs: &List[TElsif]) -> Int ! alloc
    if bk_escapes(c, &then_b.tail) == 1
        1
    elsif bk_escapes_elsifs(c, elsifs, 0, list_len(elsifs)) == 1
        1
    elsif has_else == 1
        bk_escapes(c, &else_b.tail)
    else
        0

fn bk_escapes_elsifs(c: &BK, elsifs: &List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        arm = list_get(elsifs, i)
        if bk_escapes(c, &arm.body.tail) == 1
            1
        else
            bk_escapes_elsifs(c, elsifs, i + 1, n)

fn bk_fn(c: &mut BK, f: &TFn) -> Int ! alloc
    _p = bk_params(c, &f.params, 0, list_len(&f.params))
    _s = bk_block(c, &f.body, 1, 0)
    _r = bk_reset_clock(c)
    _w = bk_block(c, &f.body, 1, 1)
    bk_finish(c)

fn bk_fns(c: &mut BK, fns: &List[TFn], i: Int, n: Int) -> Res ! alloc
    if i >= n
        result_ok(0)
    elsif bk_failed(c) == 1
        result_err_str(&list_get(&c.err, 0))
    else
        _a = bk_fn(c, &list_get(fns, i))
        if bk_failed(c) == 1
            result_err_str(&list_get(&c.err, 0))
        else
            bk_clear_fn(c)
            bk_fns(c, fns, i + 1, n)

fn bk_clear_fn(c: &mut BK) -> Int ! alloc
    _a = bk_clear_str(&mut c.l_place)
    _b = bk_clear_int(&mut c.l_mut)
    _c = bk_clear_int(&mut c.l_start)
    _d = bk_clear_int(&mut c.l_end)
    _e = bk_clear_str(&mut c.m_place)
    _f = bk_clear_int(&mut c.m_at)
    _g = bk_clear_int(&mut c.ne_at)
    _h = bk_clear_int(&mut c.ne_end)
    _i = bk_clear_str(&mut c.o_name)
    _j = bk_clear_int(&mut c.o_kind)
    _k = bk_clear_str(&mut c.o_place)
    _l = bk_clear_int(&mut c.o_at)
    _m = bk_clear_int(&mut c.w_start)
    _n = bk_clear_int(&mut c.w_end)
    bk_clear_int(&mut c.l_key)
    bk_clear_int(&mut c.ue_at)
    bk_clear_int(&mut c.ue_pos)
    bk_clear_int(&mut c.g_id)
    bk_clear_int(&mut c.g_s)
    bk_clear_int(&mut c.g_e)
    c.cells.set(1, 0)
    _t = tenv_truncate(&mut c.env, 0)
    bk_reset_clock(c)

fn bk_clear_str(xs: &mut List[String]) -> Int ! alloc
    if list_len(xs) == 0
        0
    else
        _a = list_pop(xs)
        bk_clear_str(xs)

fn bk_clear_int(xs: &mut List[Int]) -> Int ! alloc
    if list_len(xs) == 0
        0
    else
        _a = list_pop(xs)
        bk_clear_int(xs)

fn bk_finish(c: &mut BK) -> Int ! alloc
    _w = bk_widen(c, 0, list_len(&c.l_place))
    _a = bk_conf(c, 0, list_len(&c.l_place))
    bk_moved(c, 0, list_len(&c.m_place))

fn bk_widen(c: &mut BK, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = bk_widen_one(c, i, 0, list_len(&c.w_start))
        bk_widen(c, i + 1, n)

fn bk_widen_one(c: &mut BK, i: Int, j: Int, n: Int) -> Int ! alloc
    if j >= n
        0
    else
        start = list_get(&c.l_start, i)
        end = list_get(&c.l_end, i)
        ws = list_get(&c.w_start, j)
        we = list_get(&c.w_end, j)
        if start < ws
            if end >= ws
                if end <= we
                    _s = list_set(&mut c.l_end, i, we)
                    bk_widen_one(c, i, j + 1, n)
                else
                    bk_widen_one(c, i, j + 1, n)
            else
                bk_widen_one(c, i, j + 1, n)
        else
            bk_widen_one(c, i, j + 1, n)

fn bk_conf(c: &mut BK, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif bk_failed(c) == 1
        0
    else
        _a = bk_conf_j(c, i, i + 1, n)
        bk_conf(c, i + 1, n)

fn bk_conf_j(c: &mut BK, i: Int, j: Int, n: Int) -> Int ! alloc
    if j >= n
        0
    elsif bk_failed(c) == 1
        0
    else
        _a = bk_conf_pair(c, i, j)
        bk_conf_j(c, i, j + 1, n)

fn bk_conf_pair(c: &mut BK, i: Int, j: Int) -> Int ! alloc
    pi = list_get(&c.l_place, i)
    pj = list_get(&c.l_place, j)
    if bk_overlaps(&pi, &pj) == 0
        0
    elsif bk_ranges(list_get(&c.l_start, i), list_get(&c.l_end, i), list_get(&c.l_start, j), list_get(&c.l_end, j)) == 0
        0
    elsif list_get(&c.l_mut, i) + list_get(&c.l_mut, j) == 0
        0
    elsif bk_pair_live(c, i, j) == 0
        0
    else
        bk_fail(c, &("E_BORROW: `" + bk_shorter(&pi, &pj) + "` is already borrowed"))

fn bk_shorter(a: &String, b: &String) -> String ! alloc
    if str_len(a) <= str_len(b)
        strdup(a)
    else
        strdup(b)

fn bk_moved(c: &mut BK, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif bk_failed(c) == 1
        0
    else
        _a = bk_moved_loans(c, i, 0, list_len(&c.l_place))
        bk_moved(c, i + 1, n)

fn bk_moved_loans(c: &mut BK, i: Int, j: Int, n: Int) -> Int ! alloc
    if j >= n
        0
    elsif bk_failed(c) == 1
        0
    else
        place = list_get(&c.m_place, i)
        lp = list_get(&c.l_place, j)
        at = list_get(&c.m_at, i)
        if bk_overlaps(&place, &lp) == 0
            bk_moved_loans(c, i, j + 1, n)
        elsif at >= list_get(&c.l_start, j)
            if at < list_get(&c.l_end, j) && bk_live_after(c, j, at) == 1
                bk_fail(c, &("E_BORROW: `" + place + "` is already borrowed"))
            else
                bk_moved_loans(c, i, j + 1, n)
        else
            bk_moved_loans(c, i, j + 1, n)

fn check_borrows(tp: &TProgram) -> Res ! alloc
    c = bk_new(tp)
    bk_ref_fns(&mut c, &tp.fns)
    bk_fns(&mut c, &tp.fns, 0, list_len(&tp.fns))

# ---- Threads (SPEC «Hilos», `keep_threads_to_drop` in src/borrowck.rs) ----

# `e` is a call of `name` with one argument (`thread_spawn(f(a…))`, `mutex_enter(m)`).
fn bk_is_call(e: &Expr, name: &String) -> Int ! alloc
    match e
        XCall(f, args, targs, xp) =>
            if f.eq(name) == 1 && args.len() == 1
                1
            else
                0
        _ => 0

# The first place that `thread_spawn(f(a…))` lends whose root is not a parameter, or "".
fn bk_spawn_lent(c: &BK, e: &Expr) -> String ! alloc
    match e
        XCall(name, args, targs, xp) =>
            if name.eq("thread_spawn") == 1 && args.len() == 1
                bk_inner_lent(c, &args.get(0))
            else
                ""
        _ => ""

fn bk_inner_lent(c: &BK, e: &Expr) -> String ! alloc
    match e
        XCall(name, args, targs, xp) => bk_spawn_local(c, &args, 0)
        _ => ""

# What `mutex_enter(m)` or `list_get(&mut xs, i)` (`xs.get_mut(i)`) lends in exclusive, or "".
fn bk_enter_place(e: &Expr) -> String ! alloc
    match e
        XCall(name, args, targs, xp) =>
            if name.eq("mutex_enter") == 1 && args.len() == 1
                bk_place(&args.get(0))
            elsif name.eq("list_get") == 1 && args.len() == 2
                bk_list_place(&args.get(0))
            else
                ""
        _ => ""

# The loans from `n0` on `place` cover no position: they move before the first one.
fn bk_void_loans(c: &mut BK, n0: Int, place: &String) -> Int ! alloc
    i = n0
    while i < c.l_place.len()
        if c.l_place.get(i).eq(place) == 1
            c.l_start.set(i, 0 - 2)
            c.l_end.set(i, 0 - 2)
        i = i + 1
    0

# The list of a `list_get`: `xs`, `&xs` or `&mut xs`.
fn bk_list_place(e: &Expr) -> String ! alloc
    place = bk_ref_place(e)
    if place.len() > 0
        place
    else
        bk_place(e)

# `q = xs.get(i)` of an element that is not `Copy`: `q` is a `&T` into the list.
fn bk_is_get_ref(c: &BK, st: &TStmt) -> Int ! alloc
    match st.expr
        XCall(name, args, targs, xp) =>
            if name.eq("list_get") == 0 || args.len() != 2 || bk_ref_mut(&args.get(0)) == 1
                0
            else
                ty = bk_bound_ty(c, st)
                if ty.len() == 0 || ty.eq("Unknown") == 1 || bk_copy(c, &ty) == 1
                    0
                else
                    1
        _ => 0

fn bk_is_get_mut(e: &Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) =>
            if name.eq("list_get") == 1 && args.len() == 2 && bk_ref_mut(&args.get(0)) == 1
                1
            else
                0
        _ => 0

# The first place lent to the thread whose root is not a parameter, or "".
fn bk_spawn_local(c: &BK, args: &List[Expr], i: Int) -> String ! alloc
    if i >= args.len()
        ""
    else
        place = bk_ref_place(&args.get(i))
        if place.len() > 0 && bk_root_param(c, &place) == 0
            place
        else
            bk_spawn_local(c, args, i + 1)

# `t = Thread.spawn(f, &x…)`: the loans of the arguments live as long as `t` (kind 4).
fn bk_bind_thread(c: &mut BK, st: &TStmt, mode: Int) -> Int ! alloc
    n0 = c.l_place.len()
    epos = bk_visit(c, &st.expr, bk_move_mode(mode))
    lent = bk_spawn_lent(c, &st.expr)
    ty = bk_bound_ty(c, st)
    if mode == 0
        bk_ne_set(c, epos, epos)
        bk_bind(c, &st.name, &ty, 4, &lent, epos)
    else
        bk_extend_to(c, n0, c.l_place.len(), bk_ne_get(c, epos))
        bk_bind(c, &st.name, &ty, 4, &lent, epos)

fn bk_extend_to(c: &mut BK, i: Int, n: Int, end: Int) -> Int ! alloc
    while i < n
        if c.l_end.get(i) < end
            c.l_end.set(i, end)
        i = i + 1
    0

# A Thread of this block that the block does not join at its top level is joined by its glue at
# the end of the block: its loans last until then.
fn bk_keep_threads(c: &mut BK, b: &TBlock, i: Int) -> Int ! alloc
    if i >= c.o_name.len()
        0
    else
        name = c.o_name.get(i)
        if c.o_kind.get(i) == 4 && bk_joined(b, &name) == 0
            bk_note(c, &name, bk_clock(c))
        bk_keep_threads(c, b, i + 1)

fn bk_joined(b: &TBlock, name: &String) -> Int ! alloc
    if bk_joins_stmts(&b.stmts, name, 0) == 1
        1
    else
        bk_joins(&b.tail, name)

fn bk_joins_stmts(xs: &List[TStmt], name: &String, i: Int) -> Int ! alloc
    if i >= xs.len()
        0
    elsif xs.get(i).kind != 3 && bk_joins(&xs.get(i).expr, name) == 1
        1
    else
        bk_joins_stmts(xs, name, i + 1)

# `thread_join(name)` in `e` outside any branch, loop or nested block.
fn bk_joins(e: &Expr, name: &String) -> Int ! alloc
    match e
        XCall(f, args, targs, xp) =>
            if f.eq("thread_join") == 1 && args.len() == 1 && bk_place(&args.get(0)).eq(name) == 1
                1
            else
                bk_joins_list(&args, name, 0)
        XBin(op, l, r) =>
            if bk_joins(&l, name) == 1
                1
            else
                bk_joins(&r, name)
        XUnary(op, inner) => bk_joins(&inner, name)
        XField(base, field) => bk_joins(&base, name)
        _ => 0

fn bk_joins_list(xs: &List[Expr], name: &String, i: Int) -> Int ! alloc
    if i >= xs.len()
        0
    elsif bk_joins(&xs.get(i), name) == 1
        1
    else
        bk_joins_list(xs, name, i + 1)

# `Thread.spawn(f, &x)` as a returned value lends a local to a thread that outlives it.
fn bk_escapes_spawn(c: &BK, e: &Expr) -> Int ! alloc
    lent = bk_spawn_lent(c, e)
    if lent.len() > 0
        1
    else
        0

# ---- Reachability (`reachable` / `live_after` in src/borrowck.rs) ----

# Loans `i` and `j` overlap in range: the earlier one is still live where the later one starts.
fn bk_pair_live(c: &BK, i: Int, j: Int) -> Int ! alloc
    if c.l_start.get(i) <= c.l_start.get(j)
        bk_live_after(c, i, c.l_start.get(j))
    else
        bk_live_after(c, j, c.l_start.get(i))

# A keyed loan is live after `at` when a use of its local after `at` is reachable from there;
# a use inside a loop that began after the loan counts again at the loop's end.
fn bk_live_after(c: &BK, k: Int, at: Int) -> Int ! alloc
    key = c.l_key.get(k)
    if key < 0
        1
    else
        start = c.l_start.get(k)
        i = 0
        live = 0
        while i < c.ue_at.len() && live == 0
            if c.ue_at.get(i) == key
                u = c.ue_pos.get(i)
                if u > at && bk_reachable(c, at, u, start) == 1
                    live = 1
                elsif bk_loop_end_after(c, u, start, at) == 1
                    live = 1
            i = i + 1
        live

# `u` is in a loop that began after `start` and ends after `at`, reachable from `at`.
fn bk_loop_end_after(c: &BK, u: Int, start: Int, at: Int) -> Int ! alloc
    j = 0
    found = 0
    while j < c.w_start.len() && found == 0
        ws = c.w_start.get(j)
        we = c.w_end.get(j)
        if start < ws && u >= ws && u <= we && we > at && bk_reachable(c, at, we, start) == 1
            found = 1
        j = j + 1
    found

# Sibling branches do not reach each other, unless a loop that began after the loan (at
# `start`) brings the next iteration back.
fn bk_reachable(c: &BK, at: Int, u: Int, start: Int) -> Int ! alloc
    a = 0
    ok = 1
    while a < c.g_id.len() && ok == 1
        if bk_within(c, a, at) == 1
            b = 0
            while b < c.g_id.len() && ok == 1
                if b != a && c.g_id.get(b) == c.g_id.get(a) && bk_within(c, b, u) == 1 && bk_looped(c, a, start) == 0
                    ok = 0
                b = b + 1
        a = a + 1
    ok

fn bk_within(c: &BK, g: Int, x: Int) -> Int ! alloc
    if x > c.g_s.get(g) && x <= c.g_e.get(g)
        1
    else
        0

fn bk_looped(c: &BK, g: Int, start: Int) -> Int ! alloc
    j = 0
    found = 0
    while j < c.w_start.len() && found == 0
        ws = c.w_start.get(j)
        if ws > start && ws <= c.g_s.get(g) && c.g_e.get(g) <= c.w_end.get(j)
            found = 1
        j = j + 1
    found
