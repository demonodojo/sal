# Compile-time values of module constants (SPEC «Constantes»).
# `kind`: 0 Int, 1 Bool, 2 Float, 3 String. A Bool lowers as the integer 0 or 1.
import "../pkg/result.sal"
import "../ast/tast.sal"

struct CVal
    name: String
    kind: Int
    ival: Int
    text: String

struct Ev
    ok: Int
    val: CVal
    err: String

fn ce_none() -> CVal ! alloc
    CVal("", 0, 0, "")

fn ce_ok(v: CVal) -> Ev ! alloc
    Ev(1, v, "")

fn ce_bad(msg: String) -> Ev ! alloc
    Ev(0, ce_none(), msg)

fn ce_ty(v: &CVal) -> String ! alloc
    match v.kind
        1 => "Bool"
        2 => "Float"
        3 => "String"
        _ => "Int"

# Own constants of `cs`, looked up in `env` (already evaluated) and appended to `out`.
# "" when it succeeds.
fn ce_eval(cs: &List[TConst], env: &List[CVal], out: &mut List[CVal]) -> String ! alloc
    dup = ce_dup_name(cs, 0, cs.len())
    if dup.len() > 0
        dup
    else
        work = List.new[CVal]()
        base = env.len()
        ce_copy(env, 0, base, &mut work)
        err = ce_resolve(cs, &mut work)
        if err.len() == 0
            _a = ce_copy(&work, base, work.len(), out)
            0
        list_free(work)
        err

fn ce_eval_all(progs: &List[TProgram], out: &mut List[CVal]) -> String ! alloc
    ce_eval_all_go(progs, 0, progs.len(), out)

fn ce_eval_all_go(progs: &List[TProgram], i: Int, n: Int, out: &mut List[CVal]) -> String ! alloc
    if i >= n
        ""
    else
        err = ce_eval(&progs.get(i).consts, out, out)
        if err.len() > 0
            err
        else
            ce_eval_all_go(progs, i + 1, n, out)

fn ce_dup_name(cs: &List[TConst], i: Int, n: Int) -> String ! alloc
    if i >= n
        ""
    else
        name = cs.get(i).name
        if ce_named(cs, &name, i + 1, n) == 1
            "name `" + name + "` already defined"
        else
            ce_dup_name(cs, i + 1, n)

fn ce_named(cs: &List[TConst], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif cs.get(i).name.eq(name) == 1
        1
    else
        ce_named(cs, name, i + 1, n)

fn ce_copy(src: &List[CVal], i: Int, n: Int, out: &mut List[CVal]) -> Int ! alloc
    if i >= n
        0
    else
        v = src.get(i)
        out.push(CVal(v.name.dup(), v.kind, v.ival, v.text.dup()))
        ce_copy(src, i + 1, n, out)

fn ce_resolve(cs: &List[TConst], work: &mut List[CVal]) -> String ! alloc
    pending = List.new[Int]()
    ce_pending(cs, 0, cs.len(), &mut pending)
    ce_passes(cs, &pending, work, pending.len())

fn ce_pending(cs: &List[TConst], i: Int, n: Int, out: &mut List[Int]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(i)
        ce_pending(cs, i + 1, n, out)

# `pending` and `nxt` are dropped with the local that owns them.
fn ce_passes(cs: &List[TConst], pending: &List[Int], work: &mut List[CVal], left: Int) -> String ! alloc
    if left == 0
        ""
    else
        nxt = List.new[Int]()
        step = ce_one_pass(cs, pending, 0, pending.len(), work, &mut nxt)
        if step.len() > 0
            step
        elsif nxt.len() == left
            c = cs.get(nxt.get(0))
            "constant cycle involving `" + c.name + "`"
        else
            ce_passes(cs, &nxt, work, nxt.len())

fn ce_one_pass(cs: &List[TConst], pending: &List[Int], i: Int, n: Int, work: &mut List[CVal], nxt: &mut List[Int]) -> String ! alloc
    if i >= n
        ""
    else
        c = cs.get(pending.get(i))
        if ce_waiting(&c.expr, cs, work) == 1
            _p = nxt.push(pending.get(i))
            ce_one_pass(cs, pending, i + 1, n, work, nxt)
        else
            ev = ce_expr(&c.expr, work)
            if ev.ok == 0
                ev.err
            elsif c.ty.len() > 0
                if c.ty.eq(ce_ty(&ev.val)) == 0
                    "constant `" + c.name + "` has type " + ce_ty(&ev.val) + ", annotation is " + c.ty
                else
                    _p = work.push(CVal(c.name.dup(), ev.val.kind, ev.val.ival, ev.val.text.dup()))
                    ce_one_pass(cs, pending, i + 1, n, work, nxt)
            else
                _p = work.push(CVal(c.name.dup(), ev.val.kind, ev.val.ival, ev.val.text.dup()))
                ce_one_pass(cs, pending, i + 1, n, work, nxt)

fn ce_waiting(e: &Expr, cs: &List[TConst], work: &List[CVal]) -> Int ! alloc
    match e
        XIdent(s) => ce_waiting_ident(&s, cs, work)
        XBin(op, l, r) => ce_waiting_bin(&l, &r, cs, work)
        XUnary(op, inner) => ce_waiting(&inner, cs, work)
        _ => 0

fn ce_waiting_ident(s: &String, cs: &List[TConst], work: &List[CVal]) -> Int ! alloc
    if ce_named(cs, s, 0, cs.len()) == 0
        0
    elsif ce_find(work, s) >= 0
        0
    else
        1

fn ce_waiting_bin(l: &Expr, r: &Expr, cs: &List[TConst], work: &List[CVal]) -> Int ! alloc
    if ce_waiting(l, cs, work) == 1
        1
    else
        ce_waiting(r, cs, work)

fn ce_find(xs: &List[CVal], name: &String) -> Int ! alloc
    ce_find_go(xs, name, xs.len() - 1)

fn ce_find_go(xs: &List[CVal], name: &String, i: Int) -> Int ! alloc
    if i < 0
        -1
    elsif xs.get(i).name.eq(name) == 1
        i
    else
        ce_find_go(xs, name, i - 1)

fn ce_expr(e: &Expr, work: &List[CVal]) -> Ev ! alloc
    match e
        XInt(n) => ce_ok(CVal("", 0, n, ""))
        XBool(n) => ce_ok(CVal("", 1, n, ""))
        XFloat(bits, txt) => ce_ok(CVal("", 2, bits, txt.dup()))
        XStr(s) => ce_ok(CVal("", 3, 0, s.dup()))
        XIdent(s) => ce_ident(&s, work)
        XUnary(op, inner) => ce_unary(&op, &inner, work)
        XBin(op, l, r) => ce_bin(&op, &l, &r, work)
        _ => ce_bad("not a constant expression")

fn ce_ident(name: &String, work: &List[CVal]) -> Ev ! alloc
    i = ce_find(work, name)
    if i < 0
        ce_bad("not a constant expression")
    else
        v = work.get(i)
        ce_ok(CVal("", v.kind, v.ival, v.text.dup()))

fn ce_unary(op: &String, inner: &Expr, work: &List[CVal]) -> Ev ! alloc
    ev = ce_expr(inner, work)
    if ev.ok == 0
        ev
    elsif op.eq("neg") == 1
        ce_neg(&ev.val)
    elsif op.eq("not") == 1
        if ev.val.kind == 1
            ce_ok(CVal("", 1, 1 - ev.val.ival, ""))
        else
            ce_bad("not a constant expression")
    else
        ce_bad("not a constant expression")

fn ce_neg(v: &CVal) -> Ev ! alloc
    match v.kind
        0 => ce_ok(CVal("", 0, 0 - v.ival, ""))
        2 =>
            txt = ce_neg_text(v.text.dup())
            ce_ok(CVal("", 2, str_to_f64_bits(&txt), txt))
        _ => ce_bad("not a constant expression")

fn ce_neg_text(txt: String) -> String ! alloc
    if txt.len() == 0
        txt
    elsif txt.char(0) == 45
        txt.slice(1, txt.len())
    else
        "-" + txt

fn ce_bin(op: &String, l: &Expr, r: &Expr, work: &List[CVal]) -> Ev ! alloc
    if op.eq("and") == 1
        ce_and(l, r, work)
    elsif op.eq("or") == 1
        ce_or(l, r, work)
    else
        lv = ce_expr(l, work)
        if lv.ok == 0
            lv
        else
            rv = ce_expr(r, work)
            if rv.ok == 0
                rv
            else
                ce_bin_vals(op, &lv.val, &rv.val)

fn ce_truth(v: &CVal) -> Int ! alloc
    if v.kind == 1
        v.ival
    elsif v.kind == 0
        if v.ival != 0
            1
        else
            0
    else
        -1

fn ce_and(l: &Expr, r: &Expr, work: &List[CVal]) -> Ev ! alloc
    lv = ce_expr(l, work)
    if lv.ok == 0
        lv
    else
        t = ce_truth(&lv.val)
        if t < 0
            ce_bad("not a constant expression")
        elsif t == 0
            ce_ok(CVal("", 1, 0, ""))
        else
            rv = ce_expr(r, work)
            if rv.ok == 0
                rv
            else
                rt = ce_truth(&rv.val)
                if rt < 0
                    ce_bad("not a constant expression")
                else
                    ce_ok(CVal("", 1, rt, ""))

fn ce_or(l: &Expr, r: &Expr, work: &List[CVal]) -> Ev ! alloc
    lv = ce_expr(l, work)
    if lv.ok == 0
        lv
    else
        t = ce_truth(&lv.val)
        if t < 0
            ce_bad("not a constant expression")
        elsif t == 1
            ce_ok(CVal("", 1, 1, ""))
        else
            rv = ce_expr(r, work)
            if rv.ok == 0
                rv
            else
                rt = ce_truth(&rv.val)
                if rt < 0
                    ce_bad("not a constant expression")
                else
                    ce_ok(CVal("", 1, rt, ""))

fn ce_bin_vals(op: &String, l: &CVal, r: &CVal) -> Ev ! alloc
    match op
        "add" => ce_add(l, r)
        "sub" => ce_iop(l, r, 0)
        "mul" => ce_iop(l, r, 1)
        "div" => ce_div(l, r, 0)
        "mod" => ce_div(l, r, 1)
        "eq" => ce_cmp(l, r, 0)
        "ne" => ce_cmp(l, r, 1)
        "lt" => ce_cmp(l, r, 2)
        "le" => ce_cmp(l, r, 3)
        "gt" => ce_cmp(l, r, 4)
        "ge" => ce_cmp(l, r, 5)
        _ => ce_bad("not a constant expression")

fn ce_add(l: &CVal, r: &CVal) -> Ev ! alloc
    if l.kind == 0
        if r.kind == 0
            ce_ok(CVal("", 0, l.ival + r.ival, ""))
        else
            ce_bad("not a constant expression")
    elsif l.kind == 3
        if r.kind == 3
            ce_ok(CVal("", 3, 0, l.text + r.text))
        else
            ce_bad("not a constant expression")
    else
        ce_bad("not a constant expression")

fn ce_iop(l: &CVal, r: &CVal, which: Int) -> Ev ! alloc
    if l.kind == 0 && r.kind == 0
        if which == 0
            ce_ok(CVal("", 0, l.ival - r.ival, ""))
        else
            ce_ok(CVal("", 0, l.ival * r.ival, ""))
    else
        ce_bad("not a constant expression")

fn ce_div(l: &CVal, r: &CVal, which: Int) -> Ev ! alloc
    if l.kind == 0 && r.kind == 0
        if r.ival == 0
            ce_bad("division by zero")
        elsif which == 0
            ce_ok(CVal("", 0, l.ival / r.ival, ""))
        else
            ce_ok(CVal("", 0, l.ival % r.ival, ""))
    else
        ce_bad("not a constant expression")

fn ce_cmp(l: &CVal, r: &CVal, which: Int) -> Ev ! alloc
    if l.kind == 0 && r.kind == 0
        ce_ok(CVal("", 0, ce_cmp_bit(l.ival, r.ival, which), ""))
    else
        ce_bad("not a constant expression")

fn ce_cmp_bit(a: Int, b: Int, which: Int) -> Int ! alloc
    if which == 0
        if a == b
            1
        else
            0
    elsif which == 1
        if a != b
            1
        else
            0
    elsif which == 2
        if a < b
            1
        else
            0
    elsif which == 3
        if a <= b
            1
        else
            0
    elsif which == 4
        if a > b
            1
        else
            0
    elsif a >= b
        1
    else
        0

fn ce_has(xs: &List[CVal], name: &String) -> Int ! alloc
    if ce_find(xs, name) >= 0
        1
    else
        0

fn ce_type_of(xs: &List[CVal], name: &String) -> String ! alloc
    i = ce_find(xs, name)
    if i < 0
        ""
    else
        ce_ty(&xs.get(i))

# Replace a use that is not shadowed by a local with the literal it names.
fn ce_fold_fns(fns: &mut List[TFn], i: Int, n: Int, vals: &List[CVal]) -> Int ! alloc
    if vals.len() == 0
        0
    elsif i >= n
        0
    else
        f = fns.get(i)
        bound = List.new[String]()
        ce_bind_params(&f.params, 0, f.params.len(), &mut bound)
        body = ce_fold_block(&f.body, vals, &mut bound)
        fns.set(i, TFn(f.name.clone(), f.params.clone(), body, f.ret.clone(), f.no_heap, f.arena, f.fx.clone(), f.tparams.clone(), f.recv.clone(), f.mkind, f.deprecated.clone(), f.tyat.clone()))
        _f = list_free(bound)
        ce_fold_fns(fns, i + 1, n, vals)

fn ce_fold_progs(progs: &mut List[TProgram], i: Int, n: Int, vals: &List[CVal]) -> Int ! alloc
    if i >= n
        0
    else
        tp = progs.get_mut(i)
        nfns = tp.fns.len()
        ce_fold_fns(&mut tp.fns, 0, nfns, vals)
        ce_fold_progs(progs, i + 1, n, vals)

fn ce_bind_params(ps: &List[TParam], i: Int, n: Int, bound: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        bound.push(ps.get(i).name.dup())
        ce_bind_params(ps, i + 1, n, bound)

fn ce_bound(bound: &List[String], name: &String) -> Int ! alloc
    ce_bound_go(bound, name, 0, bound.len())

fn ce_bound_go(bound: &List[String], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif bound.get(i).eq(name) == 1
        1
    else
        ce_bound_go(bound, name, i + 1, n)

fn ce_fold_block(b: &TBlock, vals: &List[CVal], bound: &mut List[String]) -> TBlock ! alloc
    out = List.new[TStmt]()
    ce_fold_stmts(&b.stmts, 0, b.stmts.len(), vals, bound, &mut out)
    TBlock(out, ce_fold_expr(b.tail.clone(), vals, bound))

fn ce_fold_stmts(xs: &List[TStmt], i: Int, n: Int, vals: &List[CVal], bound: &mut List[String], out: &mut List[TStmt]) -> Int ! alloc
    if i >= n
        0
    else
        st = xs.get(i)
        if st.kind == 1 && st.is_let == 1
            _p = out.push(TStmt(st.kind, st.name.clone(), ce_fold_expr(st.expr.clone(), vals, bound), st.ty.clone(), st.is_let, st.target.clone(), st.frozen, st.stack, st.id))
            bound.push(st.name.dup())
            ce_fold_stmts(xs, i + 1, n, vals, bound, out)
        else
            _p = out.push(TStmt(st.kind, st.name.clone(), ce_fold_expr(st.expr.clone(), vals, bound), st.ty.clone(), st.is_let, ce_fold_expr(st.target.clone(), vals, bound), st.frozen, st.stack, st.id))
            ce_fold_stmts(xs, i + 1, n, vals, bound, out)

fn ce_fold_expr(e: Expr, vals: &List[CVal], bound: &mut List[String]) -> Expr ! alloc
    match e
        XIdent(s) => ce_fold_ident(s, vals, bound)
        XBin(op, l, r) => XBin(op, ce_fold_expr(l, vals, bound), ce_fold_expr(r, vals, bound))
        XUnary(op, inner) => XUnary(op, ce_fold_expr(inner, vals, bound))
        XCall(nm, args, targs, xp) => XCall(nm, ce_fold_exprs(&args, vals, bound), targs, xp)
        XTo(place, inner) => XTo(place, ce_fold_expr(inner, vals, bound))
        XField(base, fld) => XField(ce_fold_expr(base, vals, bound), fld)
        XIf(cond, then_b, else_b, has_else, elsifs) => XIf(ce_fold_expr(cond, vals, bound), ce_fold_block(&then_b, vals, bound), ce_fold_block(&else_b, vals, bound), has_else, ce_fold_elsifs(&elsifs, vals, bound))
        XMatch(scrut, arms) => XMatch(ce_fold_expr(scrut, vals, bound), ce_fold_arms(&arms, vals, bound))
        XOn(place, body, kern, idx) => XOn(place, ce_fold_block(&body, vals, bound), kern, idx)
        XWhile(cond, body) => XWhile(ce_fold_expr(cond, vals, bound), ce_fold_block(&body, vals, bound))
        XTry(inner) => XTry(ce_fold_expr(inner, vals, bound))
        XLambda(nm, body) => ce_fold_lambda(&nm, body, vals, bound)
        _ => e

fn ce_fold_elsifs(xs: &List[TElsif], vals: &List[CVal], bound: &mut List[String]) -> List[TElsif] ! alloc
    out = List.new[TElsif]()
    ce_fold_elsifs_go(xs, 0, xs.len(), vals, bound, &mut out)
    out

fn ce_fold_elsifs_go(xs: &List[TElsif], i: Int, n: Int, vals: &List[CVal], bound: &mut List[String], out: &mut List[TElsif]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        out.push(TElsif(ce_fold_expr(a.cond.clone(), vals, bound), ce_fold_block(&a.body, vals, bound)))
        ce_fold_elsifs_go(xs, i + 1, n, vals, bound, out)

# A name a pattern binds shadows a constant in its arm.
fn ce_fold_arms(xs: &List[TArm], vals: &List[CVal], bound: &mut List[String]) -> List[TArm] ! alloc
    out = List.new[TArm]()
    ce_fold_arms_go(xs, 0, xs.len(), vals, bound, &mut out)
    out

fn ce_fold_arms_go(xs: &List[TArm], i: Int, n: Int, vals: &List[CVal], bound: &mut List[String], out: &mut List[TArm]) -> Int ! alloc
    if i >= n
        0
    else
        a = xs.get(i)
        ce_pat_bind(&a.pat, bound)
        out.push(TArm(a.pat.clone(), ce_fold_expr(a.body.clone(), vals, bound), ce_fold_block(&a.suite, vals, bound), a.has_suite))
        ce_fold_arms_go(xs, i + 1, n, vals, bound, out)

fn ce_pat_bind(p: &TPat, bound: &mut List[String]) -> Int ! alloc
    if p.kind == 1
        bound.push(p.name.dup())
    ce_pat_bind_args(&p.args, 0, p.args.len(), bound)

fn ce_pat_bind_args(xs: &List[TPat], i: Int, n: Int, bound: &mut List[String]) -> Int ! alloc
    if i >= n
        0
    else
        ce_pat_bind(&xs.get(i), bound)
        ce_pat_bind_args(xs, i + 1, n, bound)

fn ce_fold_exprs(xs: &List[Expr], vals: &List[CVal], bound: &mut List[String]) -> List[Expr] ! alloc
    out = List.new[Expr]()
    ce_fold_exprs_go(xs, 0, xs.len(), vals, bound, &mut out)
    out

fn ce_fold_exprs_go(xs: &List[Expr], i: Int, n: Int, vals: &List[CVal], bound: &mut List[String], out: &mut List[Expr]) -> Int ! alloc
    if i >= n
        0
    else
        out.push(ce_fold_expr(xs.get(i).clone(), vals, bound))
        ce_fold_exprs_go(xs, i + 1, n, vals, bound, out)

fn ce_fold_lambda(nm: &String, body: Expr, vals: &List[CVal], bound: &mut List[String]) -> Expr ! alloc
    bound.push(nm.dup())
    XLambda(nm.dup(), ce_fold_expr(body, vals, bound))

fn ce_fold_ident(name: String, vals: &List[CVal], bound: &List[String]) -> Expr ! alloc
    if ce_bound(bound, &name) == 1
        XIdent(name)
    elsif ce_find(vals, &name) < 0
        XIdent(name)
    else
        ce_literal(&vals.get(ce_find(vals, &name)))

fn ce_literal(v: &CVal) -> Expr ! alloc
    match v.kind
        1 => XBool(v.ival)
        2 => XFloat(v.ival, v.text.dup())
        3 => XStr(v.text.dup())
        _ => XInt(v.ival)
