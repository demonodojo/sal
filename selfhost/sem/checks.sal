# Semantic passes in the bootstrap's order: types, effects, ownership, devices.
import "../pkg/result.sal"
import infer
import effects
import attrs
import ownership
import borrowck
import device
import "../ast/tast.sal"
import consteval

# Ok(0), or Err(message) for the first violation in `prog`.
fn check_program(tp: &TProgram) -> Res ! alloc
    none = List.new[TProgram]()
    check_program_in(tp, &none)

# `progs`: every program of the module graph (empty when single-file).
fn check_program_in(tp: &TProgram, progs: &List[TProgram]) -> Res ! alloc
    if list_len(progs) == 0
        check_after_infer(tp, progs, infer_program(tp))
    else
        vals = list_new[CVal]()
        err = ce_eval_all(progs, &mut vals)
        if str_len(err) > 0
            _f = list_free(vals)
            result_err_str(&err)
        elsif tp.impls.len() > 0
            view = check_impl_view(tp, progs)
            check_after_infer(tp, progs, infer_with_vals(&view, vals))
        else
            check_after_infer(tp, progs, infer_with_vals(tp, vals))

# Add imported types named by this module's standalone impls to the inference view.
fn check_impl_view(tp: &TProgram, progs: &List[TProgram]) -> TProgram ! alloc
    view = TProgram(tp.fns.clone(), tp.imports.clone(), tp.structs.clone(), tp.aliases.clone(), tp.enums.clone(), tp.protocols.clone(), tp.consts.clone(), tp.impls.clone())
    check_impl_imports(&mut view, progs, 0)
    attach_local_impls(&mut view, 0)
    view

fn check_impl_imports(view: &mut TProgram, progs: &List[TProgram], i: Int) -> Int ! alloc
    if i >= view.impls.len()
        0
    else
        imp = view.impls.get(i)
        # Bound: a temporary used as a receiver is not released.
        targs = tg_args(&imp.target)
        if targs.len() == 0 && tt_struct_find(&view.structs, &imp.target) < 0 && enum_find(&view.enums, &imp.target, 0, view.enums.len()) < 0
            _a = check_impl_find_type(view, progs, &imp.target, 0)
        check_impl_imports(view, progs, i + 1)

fn check_impl_find_type(view: &mut TProgram, progs: &List[TProgram], name: &String, i: Int) -> Int ! alloc
    if i >= progs.len()
        0
    else
        tp = progs.get(i)
        si = tt_struct_find(&tp.structs, name)
        ei = enum_find(&tp.enums, name, 0, tp.enums.len())
        if si >= 0
            view.structs.push(tp.structs.get(si).clone())
            0
        elsif ei >= 0
            view.enums.push(tp.enums.get(ei).clone())
            0
        else
            check_impl_find_type(view, progs, name, i + 1)

fn check_after_infer(tp: &TProgram, progs: &List[TProgram], ty: Res) -> Res ! alloc
    if result_is_err(&ty) == 1
        ty
    else
        check_typed(tp, progs)

fn check_typed(tp: &TProgram, progs: &List[TProgram]) -> Res ! alloc
    at = check_attrs(tp)
    if result_is_err(&at) == 1
        at
    else
        fx = check_effects_with(tp, progs)
        if result_is_err(&fx) == 1
            fx
        else
            own = check_ownership(tp)
            if result_is_err(&own) == 1
                own
            else
                br = check_borrows(tp)
                if result_is_err(&br) == 1
                    br
                else
                    check_devices(tp)
