# Semantic passes in the bootstrap's order: types, effects, ownership, devices.
import "../pkg/result.sal"
import infer
import effects
import attrs
import ownership
import borrowck
import device
import "../ast/tast.sal"
import consteval

# Ok(0), or Err(message) for the first violation in `prog`.
fn check_program(tp: &TProgram) -> Int ! alloc
    none = List.new[TProgram]()
    check_program_in(tp, &none)

# `progs`: every program of the module graph (empty when single-file).
fn check_program_in(tp: &TProgram, progs: &List[TProgram]) -> Int ! alloc
    if list_len(progs) == 0
        check_after_infer(tp, progs, infer_program(tp))
    else
        vals = list_new[CVal]()
        err = ce_eval_all(progs, &mut vals)
        if str_len(err) > 0
            _f = list_free(vals)
            result_err_str(&err)
        else
            check_after_infer(tp, progs, infer_with_vals(tp, vals))

fn check_after_infer(tp: &TProgram, progs: &List[TProgram], ty: Int) -> Int ! alloc
    if result_is_err(ty) == 1
        ty
    else
        check_typed(tp, progs)

fn check_typed(tp: &TProgram, progs: &List[TProgram]) -> Int ! alloc
    at = check_attrs(tp)
    if result_is_err(at) == 1
        at
    else
        fx = check_effects_with(tp, progs)
        if result_is_err(fx) == 1
            fx
        else
            own = check_ownership(tp)
            if result_is_err(own) == 1
                own
            else
                br = check_borrows(tp)
                if result_is_err(br) == 1
                    br
                else
                    check_devices(tp)
