# Lexer: tokens, indentation, and source scan.

fn TK_EOF() -> Int
    0

fn TK_NL() -> Int
    1

fn TK_INDENT() -> Int
    2

fn TK_DEDENT() -> Int
    3

fn TK_IDENT() -> Int
    4

fn TK_INT() -> Int
    5

fn TK_FLOAT() -> Int
    6

fn TK_STRING() -> Int
    7

fn TK_FN() -> Int
    8

fn TK_ON() -> Int
    9

fn TK_TO() -> Int
    10

fn TK_ARROW() -> Int
    11

fn TK_BANG() -> Int
    12

fn TK_LPAREN() -> Int
    13

fn TK_RPAREN() -> Int
    14

fn TK_LBRACK() -> Int
    15

fn TK_RBRACK() -> Int
    16

fn TK_COMMA() -> Int
    17

fn TK_COLON() -> Int
    18

fn TK_EQ() -> Int
    19

fn TK_PLUS() -> Int
    20

fn TK_MINUS() -> Int
    21

fn TK_STAR() -> Int
    22

fn TK_SLASH() -> Int
    23

fn TK_EQEQ() -> Int
    24

fn TK_NE() -> Int
    25

fn TK_LT() -> Int
    26

fn TK_LE() -> Int
    27

fn TK_GT() -> Int
    28

fn TK_GE() -> Int
    29

fn TK_IF() -> Int
    30

fn TK_ELSIF() -> Int
    35

fn TK_ELSE() -> Int
    31

fn TK_WHILE() -> Int
    32

fn TK_IMPORT() -> Int
    33

fn TK_DOT() -> Int
    34

fn TK_DSTRING() -> Int
    36

fn TK_STRUCT() -> Int
    37

fn TK_AT() -> Int
    38

fn TK_RETURN() -> Int
    39

fn TK_LET() -> Int
    40

fn TK_MATCH() -> Int
    41

fn TK_TRY() -> Int
    42

fn TK_TRUE() -> Int
    43

fn TK_FALSE() -> Int
    44

fn TK_ENUM() -> Int
    45

fn TK_FRAME() -> Int
    46

fn TK_KERNEL() -> Int
    47

fn TK_IN() -> Int
    48

fn TK_PERCENT() -> Int
    49

fn TK_AMP() -> Int
    50

fn TK_PIPE() -> Int
    51

fn TK_CARET() -> Int
    52

fn TK_SHL() -> Int
    53

fn TK_SHR() -> Int
    54

fn TK_FATARROW() -> Int
    55

fn is_digit(c: Int) -> Int
    if c < 48
        0
    elsif c > 57
        0
    else
        1

fn is_alpha(c: Int) -> Int
    if c >= 65
        if c <= 90
            1
        elsif c >= 97
            if c <= 122
                1
            else
                0
        else
            0
    else
        0

fn is_ident_start(c: Int) -> Int
    if is_alpha(c) == 1
        1
    elsif c == 95
        1
    else
        0

fn is_ident_char(c: Int) -> Int
    if is_ident_start(c) == 1
        1
    else
        is_digit(c)

# Tokens as parallel lists: `kinds[i]`, `texts[i]`, `ivals[i]` describe token `i`.
struct Toks
    kinds: List[Int]
    texts: List[String]
    ivals: List[Int]

fn toks_new() -> Toks ! alloc
    Toks(list_new[Int](), list_new[String](), list_new[Int]())

# Appends a token; the text is copied, so the caller keeps its own.
fn tok_push(out: Toks, kind: Int, text: String, ival: Int) -> Int ! alloc
    _a = list_push(out.kinds, kind)
    _b = list_push(out.texts, strdup(text))
    _c = list_push(out.ivals, ival)
    0

fn kw_kind(text: String) -> Int ! alloc
    if str_eq(text, "fn") == 1
        TK_FN()
    elsif str_eq(text, "on") == 1
        TK_ON()
    elsif str_eq(text, "to") == 1
        TK_TO()
    elsif str_eq(text, "if") == 1
        TK_IF()
    elsif str_eq(text, "elsif") == 1
        TK_ELSIF()
    elsif str_eq(text, "else") == 1
        TK_ELSE()
    elsif str_eq(text, "while") == 1
        TK_WHILE()
    elsif str_eq(text, "import") == 1
        TK_IMPORT()
    elsif str_eq(text, "struct") == 1
        TK_STRUCT()
    elsif str_eq(text, "return") == 1
        TK_RETURN()
    elsif str_eq(text, "let") == 1
        TK_LET()
    elsif str_eq(text, "match") == 1
        TK_MATCH()
    elsif str_eq(text, "try") == 1
        TK_TRY()
    elsif str_eq(text, "true") == 1
        TK_TRUE()
    elsif str_eq(text, "false") == 1
        TK_FALSE()
    elsif str_eq(text, "enum") == 1
        TK_ENUM()
    elsif str_eq(text, "frame") == 1
        TK_FRAME()
    elsif str_eq(text, "kernel") == 1
        TK_KERNEL()
    elsif str_eq(text, "in") == 1
        TK_IN()
    else
        TK_IDENT()

fn indent_stack_new() -> List[Int] ! alloc
    v = list_new[Int]()
    _d = list_push(v, 0 - 2)
    _p = list_push(v, 0)
    v

fn group_depth(st: List[Int]) -> Int ! alloc
    v = list_get(st, 0)
    0 - v - 2

fn group_set(st: List[Int], d: Int) -> Int ! alloc
    _p = list_set(st, 0, 0 - d - 2)
    0

fn group_enter(st: List[Int]) -> Int ! alloc
    group_set(st, group_depth(st) + 1)

fn group_leave(st: List[Int]) -> Int ! alloc
    d = group_depth(st)
    if d > 0
        group_set(st, d - 1)
    else
        0

fn indent_top_at(st: List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = list_get(st, i)
        if v < 0
            indent_top_at(st, i - 1)
        else
            v

fn indent_top(st: List[Int]) -> Int ! alloc
    n = list_len(st)
    indent_top_at(st, n - 1)

fn indent_push(st: List[Int], col: Int) -> Int ! alloc
    _p = list_push(st, col)
    0

fn indent_tombstone_at(st: List[Int], i: Int) -> Int ! alloc
    if i < 0
        0
    else
        v = list_get(st, i)
        if v < 0
            indent_tombstone_at(st, i - 1)
        else
            _p = list_set(st, i, 0 - 1)
            0

fn indent_pop(st: List[Int]) -> Int ! alloc
    n = list_len(st)
    _t = indent_tombstone_at(st, n - 1)
    0

fn count_live_indent(st: List[Int], i: Int, acc: Int) -> Int ! alloc
    n = list_len(st)
    if i >= n
        acc
    else
        v = list_get(st, i)
        if v < 0
            count_live_indent(st, i + 1, acc)
        else
            count_live_indent(st, i + 1, acc + 1)

fn skip_line_comment(src: String, i: Int, n: Int) -> Int ! alloc
    _n = n
    str_skip(src, i, 4, 0)

fn count_spaces(src: String, i: Int, n: Int, acc: Int) -> Int ! alloc
    _n = n
    _a = acc
    end = str_skip(src, i, 1, 0)
    end - i

fn read_ident(src: String, i: Int, n: Int) -> Int ! alloc
    _n = n
    str_skip(src, i, 2, 0)

fn read_digits(src: String, i: Int, n: Int) -> Int ! alloc
    _n = n
    str_skip(src, i, 3, 0)

fn read_number(src: String, i: Int, n: Int) -> Int ! alloc
    end = read_digits(src, i, n)
    if end < n
        if str_char(src, end) == 46
            read_digits(src, end + 1, n)
        else
            end
    else
        end

fn slice_has_dot(src: String, i: Int, end: Int) -> Int ! alloc
    if i >= end
        0
    elsif str_char(src, i) == 46
        1
    else
        slice_has_dot(src, i + 1, end)

fn push_number_tok(out: Toks, src: String, i: Int, end: Int, neg: Int) -> Int ! alloc
    if slice_has_dot(src, i, end) == 1
        txt = str_slice(src, i, end)
        if neg == 1
            ntxt = "-" + txt
            free(txt)
            bits = str_to_f64_bits(ntxt)
            _p = tok_push(out, TK_FLOAT(), ntxt, bits)
            free(ntxt)
            _q = 0
        else
            bits = str_to_f64_bits(txt)
            _p = tok_push(out, TK_FLOAT(), txt, bits)
    else
        ival = parse_int_digits(src, i, end, 0)
        if neg == 1
            ival = 0 - ival
            _p = tok_push(out, TK_INT(), d"", ival)
        else
            _p = tok_push(out, TK_INT(), d"", ival)
    0

fn parse_int_digits(src: String, i: Int, end: Int, acc: Int) -> Int ! alloc
    if i >= end
        acc
    else
        c = str_char(src, i)
        parse_int_digits(src, i + 1, end, acc * 10 + (c - 48))

fn unescape_char(e: Int) -> Int ! alloc
    if e == 110
        10
    elsif e == 116
        9
    elsif e == 114
        13
    else
        e

fn read_string_chars(src: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(src, i)
        if c == 34
            acc
        elsif c == 92
            if i + 1 >= n
                acc
            else
                e = str_char(src, i + 1)
                ch = unescape_char(e)
                piece = char_to_str(ch)
                read_string_chars(src, i + 2, n, acc + piece)
        else
            piece = char_to_str(c)
            read_string_chars(src, i + 1, n, acc + piece)

fn string_end(src: String, i: Int, n: Int) -> Int ! alloc
    _n = n
    str_skip(src, i, 7, 0)

fn unescape_braces(s: String, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == 123
            if i + 1 < n
                c2 = str_char(s, i + 1)
                if c2 == 123
                    piece = char_to_str(123)
                    acc2 = acc + piece
                    free(piece)
                    unescape_braces(s, i + 2, n, acc2)
                else
                    piece = char_to_str(c)
                    acc2 = acc + piece
                    free(piece)
                    unescape_braces(s, i + 1, n, acc2)
            else
                piece = char_to_str(c)
                acc2 = acc + piece
                free(piece)
                unescape_braces(s, i + 1, n, acc2)
        elsif c == 125
            if i + 1 < n
                c2 = str_char(s, i + 1)
                if c2 == 125
                    piece = char_to_str(125)
                    acc2 = acc + piece
                    free(piece)
                    unescape_braces(s, i + 2, n, acc2)
                else
                    piece = char_to_str(c)
                    acc2 = acc + piece
                    free(piece)
                    unescape_braces(s, i + 1, n, acc2)
            else
                piece = char_to_str(c)
                acc2 = acc + piece
                free(piece)
                unescape_braces(s, i + 1, n, acc2)
        else
            piece = char_to_str(c)
            acc2 = acc + piece
            free(piece)
            unescape_braces(s, i + 1, n, acc2)

fn dedent_to_col(out: Toks, st: List[Int], col: Int) -> Int ! alloc
    top = indent_top(st)
    if col < top
        _t = indent_pop(st)
        _p = tok_push(out, TK_DEDENT(), d"", 0)
        dedent_to_col(out, st, col)
    else
        0

fn lex_go(src: String, i: Int, n: Int, out: Toks, st: List[Int], at_start: Int) -> Int ! alloc
    if i >= n
        dedent_to_col(out, st, 0)
        _p = tok_push(out, TK_EOF(), d"", 0)
        0
    else
        c = str_char(src, i)
        if c == 35
            j = skip_line_comment(src, i + 1, n)
            lex_go(src, j, n, out, st, at_start)
        elsif at_start == 1
            sp = count_spaces(src, i, n, 0)
            j = i + sp
            if j < n
                cj = str_char(src, j)
                if cj == 9
                    sp = sp + 4
                    j = j + 1
                else
                    sp = sp
            else
                sp = sp
            if j >= n
                lex_go(src, j, n, out, st, 1)
            else
                cj = str_char(src, j)
                if cj == 10
                    lex_go(src, j + 1, n, out, st, 1)
                elsif cj == 35
                    j2 = skip_line_comment(src, j + 1, n)
                    if j2 < n
                        c3 = str_char(src, j2)
                        if c3 == 10
                            lex_go(src, j2 + 1, n, out, st, 1)
                        else
                            lex_go(src, j2, n, out, st, 1)
                    else
                        lex_go(src, j2, n, out, st, 1)
                else
                    top = indent_top(st)
                    if sp > top
                        _p = indent_push(st, sp)
                        _p = tok_push(out, TK_INDENT(), d"", 0)
                        lex_go(src, j, n, out, st, 0)
                    else
                        _d = dedent_to_col(out, st, sp)
                        lex_go(src, j, n, out, st, 0)
        elsif c == 10
            _p = tok_push(out, TK_NL(), d"", 0)
            if group_depth(st) > 0
                lex_go(src, i + 1, n, out, st, 0)
            else
                lex_go(src, i + 1, n, out, st, 1)
        else
            j = str_skip(src, i, 8, 0)
            if j == i
                lex_tok(src, i, n, out, st)
            else
                lex_go(src, j, n, out, st, 0)

fn lex_tok(src: String, i: Int, n: Int, out: Toks, st: List[Int]) -> Int ! alloc
    c = str_char(src, i)
    if c == 45
        if i + 1 < n
            c2 = str_char(src, i + 1)
            if c2 == 62
                _p = tok_push(out, TK_ARROW(), d"", 0)
                lex_go(src, i + 2, n, out, st, 0)
            else
                lex_tok_rest(src, i, n, out, st, c)
        else
            lex_tok_rest(src, i, n, out, st, c)
    else
        lex_tok_rest(src, i, n, out, st, c)

fn lex_tok_rest(src: String, i: Int, n: Int, out: Toks, st: List[Int], c: Int) -> Int ! alloc
    if c == 40
        _p = tok_push(out, TK_LPAREN(), d"", 0)
        _g = group_enter(st)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 41
        _p = tok_push(out, TK_RPAREN(), d"", 0)
        _g = group_leave(st)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 91
        _p = tok_push(out, TK_LBRACK(), d"", 0)
        _g = group_enter(st)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 93
        _p = tok_push(out, TK_RBRACK(), d"", 0)
        _g = group_leave(st)
        lex_go(src, i + 1, n, out, st, 0)
    else
        lex_tok_rest2(src, i, n, out, st, c)

fn lex_tok_rest2(src: String, i: Int, n: Int, out: Toks, st: List[Int], c: Int) -> Int ! alloc
    if c == 44
        _p = tok_push(out, TK_COMMA(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 58
        _p = tok_push(out, TK_COLON(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 61
        if i + 1 < n
            if str_char(src, i + 1) == 62
                lex_simple(src, i, n, out, st, TK_FATARROW(), 2)
            else
                lex_pair(src, i, n, out, st, 61, TK_EQ(), TK_EQEQ())
        else
            lex_simple(src, i, n, out, st, TK_EQ(), 1)
    else
        lex_tok_rest3(src, i, n, out, st, c)

fn lex_tok_rest3(src: String, i: Int, n: Int, out: Toks, st: List[Int], c: Int) -> Int ! alloc
    if c == 33
        if i + 1 < n
            c2 = str_char(src, i + 1)
            if c2 == 61
                _p = tok_push(out, TK_NE(), d"", 0)
                lex_go(src, i + 2, n, out, st, 0)
            else
                _p = tok_push(out, TK_BANG(), d"", 0)
                lex_go(src, i + 1, n, out, st, 0)
        else
            _p = tok_push(out, TK_BANG(), d"", 0)
            lex_go(src, i + 1, n, out, st, 0)
    elsif c == 60
        if i + 1 < n
            if str_char(src, i + 1) == 60
                lex_simple(src, i, n, out, st, TK_SHL(), 2)
            else
                lex_pair(src, i, n, out, st, 61, TK_LT(), TK_LE())
        else
            lex_simple(src, i, n, out, st, TK_LT(), 1)
    else
        lex_tok_rest4(src, i, n, out, st, c)

fn lex_tok_rest4(src: String, i: Int, n: Int, out: Toks, st: List[Int], c: Int) -> Int ! alloc
    if c == 62
        if i + 1 < n
            if str_char(src, i + 1) == 62
                lex_simple(src, i, n, out, st, TK_SHR(), 2)
            else
                lex_pair(src, i, n, out, st, 61, TK_GT(), TK_GE())
        else
            lex_simple(src, i, n, out, st, TK_GT(), 1)
    elsif c == 43
        _p = tok_push(out, TK_PLUS(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 42
        _p = tok_push(out, TK_STAR(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 47
        _p = tok_push(out, TK_SLASH(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    else
        lex_tok_rest5(src, i, n, out, st, c)

fn lex_simple(src: String, i: Int, n: Int, out: Toks, st: List[Int], kind: Int, width: Int) -> Int ! alloc
    _p = tok_push(out, kind, d"", 0)
    lex_go(src, i + width, n, out, st, 0)

# Operator that is `kind1` alone or `kind2` when followed by `next`.
fn lex_pair(src: String, i: Int, n: Int, out: Toks, st: List[Int], next: Int, kind1: Int, kind2: Int) -> Int ! alloc
    if i + 1 < n
        if str_char(src, i + 1) == next
            lex_simple(src, i, n, out, st, kind2, 2)
        else
            lex_simple(src, i, n, out, st, kind1, 1)
    else
        lex_simple(src, i, n, out, st, kind1, 1)

# `{{`/`}}` are literal braces; `{name}` needs an identifier. Anything else is
# an invalid interpolation (returns 0).
fn interp_ok(s: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        1
    else
        c = str_char(s, i)
        if c == 123
            if i + 1 < n
                if str_char(s, i + 1) == 123
                    interp_ok(s, i + 2, n)
                else
                    interp_name(s, i + 1, n)
            else
                0
        elsif c == 125
            if i + 1 < n
                if str_char(s, i + 1) == 125
                    interp_ok(s, i + 2, n)
                else
                    0
            else
                0
        else
            interp_ok(s, i + 1, n)

# 1 when the text has a `{name}` interpolation (not `{{`).
fn has_interp(s: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        c = str_char(s, i)
        if c == 123
            if i + 1 < n
                if str_char(s, i + 1) == 123
                    has_interp(s, i + 2, n)
                else
                    1
            else
                0
        elsif c == 125
            if i + 1 < n
                if str_char(s, i + 1) == 125
                    has_interp(s, i + 2, n)
                else
                    has_interp(s, i + 1, n)
            else
                has_interp(s, i + 1, n)
        else
            has_interp(s, i + 1, n)

fn interp_name(s: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif is_ident_start(str_char(s, i)) == 0
        0
    else
        interp_name_rest(s, i + 1, n)

fn interp_name_rest(s: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        c = str_char(s, i)
        if c == 125
            interp_ok(s, i + 1, n)
        elsif is_ident_char(c) == 1
            interp_name_rest(s, i + 1, n)
        else
            0

fn lex_quoted(src: String, i: Int, n: Int, out: Toks, st: List[Int], kind: Int) -> Int ! alloc
    raw = d""
    raw2 = read_string_chars(src, i + 1, n, raw)
    end = string_end(src, i + 1, n)
    nraw = str_len(raw2)
    empty = d""
    un = unescape_braces(raw2, 0, nraw, empty)
    bad = 1 - interp_ok(raw2, 0, nraw)
    # ival: 1 invalid interpolation, 2 interpolated (text stays raw), 0 plain.
    ival = if bad == 1
        1
    elsif has_interp(raw2, 0, nraw) == 1
        2
    else
        0
    text = if ival == 2
        raw2
    else
        un
    _p = tok_push(out, kind, text, ival)
    j = end
    if end < n
        j = end + 1
    else
        j = end
    lex_go(src, j, n, out, st, 0)

fn lex_tok_rest5(src: String, i: Int, n: Int, out: Toks, st: List[Int], c: Int) -> Int ! alloc
    if c == 34
        lex_quoted(src, i, n, out, st, TK_STRING())
    elsif is_digit(c) == 1
        end = read_number(src, i, n)
        _t = push_number_tok(out, src, i, end, 0)
        lex_go(src, end, n, out, st, 0)
    elsif c == 45
        lex_simple(src, i, n, out, st, TK_MINUS(), 1)
    elsif c == 46
        _p = tok_push(out, TK_DOT(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif c == 37
        lex_simple(src, i, n, out, st, TK_PERCENT(), 1)
    elsif c == 38
        lex_simple(src, i, n, out, st, TK_AMP(), 1)
    elsif c == 124
        lex_simple(src, i, n, out, st, TK_PIPE(), 1)
    elsif c == 94
        lex_simple(src, i, n, out, st, TK_CARET(), 1)
    elsif c == 64
        _p = tok_push(out, TK_AT(), d"", 0)
        lex_go(src, i + 1, n, out, st, 0)
    elsif is_ident_start(c) == 1
        end = read_ident(src, i, n)
        text = str_slice(src, i, end)
        if str_eq(text, "d") == 1
            if end < n
                if str_char(src, end) == 34
                    free(text)
                    lex_quoted(src, end, n, out, st, TK_DSTRING())
                else
                    kind = kw_kind(text)
                    _p = tok_push(out, kind, text, 0)
                    lex_go(src, end, n, out, st, 0)
            else
                kind = kw_kind(text)
                _p = tok_push(out, kind, text, 0)
                lex_go(src, end, n, out, st, 0)
        else
            kind = kw_kind(text)
            _p = tok_push(out, kind, text, 0)
            lex_go(src, end, n, out, st, 0)
    else
        lex_go(src, i + 1, n, out, st, 0)

fn lex(src: String) -> Toks ! alloc
    out = toks_new()
    st = indent_stack_new()
    _a = lex_go(src, 0, str_len(src), out, st, 1)
    _f = list_free(st)
    out

fn preprocess_scan(src: String, i: Int, n: Int, limit: Int) -> Int ! alloc
    if i >= n
        n
    else
        str_skip(src, i, 5, limit)

fn preprocess_scan_str(src: String, i: Int, n: Int, limit: Int) -> Int ! alloc
    if i >= n
        n
    else
        str_skip(src, i, 6, limit)

fn preprocess_go(src: String, i: Int, n: Int, acc: String, in_str: Int) -> String ! alloc
    if i >= n
        acc
    elsif in_str == 1
        j = preprocess_scan_str(src, i, n, 256)
        if j >= n
            piece = str_slice(src, i, n)
            str_append(acc, piece)
        elsif str_char(src, j) == 34
            piece = str_slice(src, i, j + 1)
            acc2 = str_append(acc, piece)
            preprocess_go(src, j + 1, n, acc2, 0)
        else
            piece = str_slice(src, i, j)
            acc2 = str_append(acc, piece)
            preprocess_go(src, j, n, acc2, 1)
    else
        j = preprocess_scan(src, i, n, 256)
        if j > i
            piece = str_slice(src, i, j)
            acc2 = str_append(acc, piece)
            preprocess_go(src, j, n, acc2, 0)
        else
            c = str_char(src, i)
            if c == 34
                piece = char_to_str(c)
                acc2 = str_append(acc, piece)
                preprocess_go(src, i + 1, n, acc2, 1)
            elsif c == 63
                prev_ok = preprocess_qdyn_ok(src, i)
                if prev_ok == 1
                    acc2 = str_append(acc, "QDYN")
                    preprocess_go(src, i + 1, n, acc2, 0)
                else
                    piece = char_to_str(c)
                    acc2 = str_append(acc, piece)
                    preprocess_go(src, i + 1, n, acc2, 0)
            else
                piece = char_to_str(c)
                acc2 = str_append(acc, piece)
                preprocess_go(src, i + 1, n, acc2, 0)

fn preprocess_qdyn_ok(src: String, i: Int) -> Int ! alloc
    if i == 0
        1
    else
        prev = str_char(src, i - 1)
        1 - is_ident_char(prev)

fn preprocess(src: String) -> String ! alloc
    n = str_len(src)
    acc = d""
    with_prelude_enums(preprocess_go(src, 0, n, acc, 0))

# `Option` / `Result` are part of the language: append the standard enums when
# a program uses them without declaring them.
fn with_prelude_enums(src: String) -> String ! alloc
    r = if str_contains(src, d"Result[") == 1
        if str_contains(src, d"enum Result") == 0
            d"\nenum Result[T, E]\n    Ok(T)\n    Err(E)\n"
        else
            d""
    else
        d""
    o = if str_contains(src, d"Option[") == 1
        if str_contains(src, d"enum Option") == 0
            d"\nenum Option[T]\n    None\n    Some(T)\n"
        else
            d""
    else
        d""
    if str_len(r) + str_len(o) == 0
        src
    else
        src + d"\n" + r + o

fn find_char(s: String, ch: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0 - 1
    elsif str_char(s, i) == ch
        i
    else
        find_char(s, ch, i + 1, n)
