# `W_DEPRECATED`: a warning at each use of an item marked `@deprecated("…")`. Mirror of `src/deprecation.rs`.
# The selfhost has no spans, so a warning names the file but not the line and column.
import tast
import modules
import lexer

# A file being checked: its path and the preprocessed text its offsets refer to.
struct Where
    path: String
    pre: String

# The deprecated items: names[i] has the message msgs[i] (the "d:" marker is dropped).
struct DepSet
    names: List[String]
    msgs: List[String]

fn dep_message(dep: String) -> String ! alloc
    dep.slice(2, dep.len())

fn dep_collect_fns(fns: List[TFn], i: Int, n: Int, ds: DepSet) -> Int ! alloc
    if i >= n
        0
    else
        f = fns.get(i)
        if f.deprecated.len() > 0
            ds.names.push(f.name)
            _b = ds.msgs.push(dep_message(f.deprecated))
        dep_collect_fns(fns, i + 1, n, ds)

fn dep_collect_structs(sts: List[TStruct], i: Int, n: Int, ds: DepSet) -> Int ! alloc
    if i >= n
        0
    else
        s = list_get(sts, i)
        if str_len(s.deprecated) > 0
            _a = list_push(ds.names, s.name)
            _b = list_push(ds.msgs, dep_message(s.deprecated))
        dep_collect_structs(sts, i + 1, n, ds)

fn dep_collect_enums(es: List[TEnum], i: Int, n: Int, ds: DepSet) -> Int ! alloc
    if i >= n
        0
    else
        e = list_get(es, i)
        if str_len(e.deprecated) > 0
            _a = list_push(ds.names, e.name)
            _b = list_push(ds.msgs, dep_message(e.deprecated))
        dep_collect_enums(es, i + 1, n, ds)

fn dep_collect(tp: TProgram, ds: DepSet) -> Int ! alloc
    _a = dep_collect_fns(tp.fns, 0, list_len(tp.fns), ds)
    _b = dep_collect_structs(tp.structs, 0, list_len(tp.structs), ds)
    dep_collect_enums(tp.enums, 0, list_len(tp.enums), ds)

fn dep_index(ds: DepSet, name: String, i: Int) -> Int ! alloc
    if i >= list_len(ds.names)
        0 - 1
    elsif str_eq(list_get(ds.names, i), name) == 1
        i
    else
        dep_index(ds, name, i + 1)

# A use of `name` in file `w` at byte offset `xp` (0 when the use has no position): one warning line
# in `out` (a vector of string handles).
fn dep_hit(ds: DepSet, w: Where, out: Int, name: String, xp: Int) -> Int ! alloc
    i = dep_index(ds, name, 0)
    if i < 0
        0
    else
        line = "warning[W_DEPRECATED]: `" + name + "` is deprecated: " + list_get(ds.msgs, i) + " (" + where_text(w, xp) + ")"
        vec_push(out, str_as_int(line))

# `path:line:column` of offset `xp` in the file, or the path alone when there is no position.
fn where_text(w: Where, xp: Int) -> String ! alloc
    if xp <= 0
        w.path
    else
        w.path + ":" + int_to_str(loc_line(w.pre, xp, 0, 1)) + ":" + int_to_str(loc_col(w.pre, xp))

# The line (1-based) of offset `off`: one more than the newlines before it.
fn loc_line(pre: String, off: Int, i: Int, line: Int) -> Int ! alloc
    if i >= off
        line
    elsif str_char(pre, i) == 10
        loc_line(pre, off, i + 1, line + 1)
    else
        loc_line(pre, off, i + 1, line)

# The column (1-based) of offset `off`. The preprocessor writes `?` as QDYN (four bytes), so each
# QDYN on the same line before the offset is three bytes that the source does not have.
fn loc_col(pre: String, off: Int) -> Int ! alloc
    start = loc_line_start(pre, off, 0, 0)
    off - start + 1 - 3 * qdyn_count(pre, start, off, 0)

fn loc_line_start(pre: String, off: Int, i: Int, start: Int) -> Int ! alloc
    if i >= off
        start
    elsif str_char(pre, i) == 10
        loc_line_start(pre, off, i + 1, i + 1)
    else
        loc_line_start(pre, off, i + 1, start)

fn qdyn_count(pre: String, lo: Int, hi: Int, acc: Int) -> Int ! alloc
    if lo + 4 > hi
        acc
    elsif str_eq(str_slice(pre, lo, lo + 4), "QDYN") == 1
        qdyn_count(pre, lo + 4, hi, acc + 1)
    else
        qdyn_count(pre, lo + 1, hi, acc)

# The cursor over the byte offsets of one item's types (`TFn.tyat`): a vector of handles whose slot 0
# is the next index and whose other slots are the offsets (a vector, so no drop glue frees them).
fn tycur_new(at: String) -> Int ! alloc
    tc = vec_new()
    _a = vec_push(tc, 0)
    _b = tycur_scan(at, 0, str_len(at), 0, tc)
    tc

# Reads "o1,o2,..." (each offset ends with a comma) into the cursor's vector.
fn tycur_scan(at: String, i: Int, n: Int, acc: Int, tc: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_char(at, i) == 44
        _a = vec_push(tc, acc)
        tycur_scan(at, i + 1, n, 0, tc)
    else
        tycur_scan(at, i + 1, n, acc * 10 + str_char(at, i) - 48, tc)

fn tycur_take(tc: Int) -> Int ! alloc
    k = vec_get(tc, 0)
    _b = vec_set(tc, 0, k + 1)
    if k + 1 < vec_len(tc)
        vec_get(tc, k + 1)
    else
        0

# Every identifier of a type text is a use of its name; the qualifier before a `.` is not (its name
# after the dot is). Each name takes the next recorded offset.
fn dep_type_text(ds: DepSet, w: Where, out: Int, tc: Int, ty: String) -> Int ! alloc
    dep_type_go(ds, w, out, tc, ty, 0, str_len(ty))

fn dep_type_go(ds: DepSet, w: Where, out: Int, tc: Int, ty: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif ident_char(str_char(ty, i), 1) == 0
        dep_type_go(ds, w, out, tc, ty, i + 1, n)
    else
        j = ident_end(ty, i, n)
        if j < n
            if str_char(ty, j) == 46
                dep_type_go(ds, w, out, tc, ty, j, n)
            else
                _h = dep_hit(ds, w, out, str_slice(ty, i, j), tycur_take(tc))
                dep_type_go(ds, w, out, tc, ty, j, n)
        else
            _h = dep_hit(ds, w, out, str_slice(ty, i, j), tycur_take(tc))
            dep_type_go(ds, w, out, tc, ty, j, n)

fn ident_char(c: Int, first: Int) -> Int ! alloc
    if c == 95
        1
    elsif char_in(c, 65, 90) == 1
        1
    elsif char_in(c, 97, 122) == 1
        1
    elsif first == 0
        char_in(c, 48, 57)
    else
        0

fn char_in(c: Int, lo: Int, hi: Int) -> Int ! alloc
    if c < lo
        0
    elsif c > hi
        0
    else
        1

fn ident_end(ty: String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        n
    elsif ident_char(str_char(ty, i), 0) == 1
        ident_end(ty, i + 1, n)
    else
        i

fn dep_fn(ds: DepSet, w: Where, out: Int, f: TFn) -> Int ! alloc
    tc = tycur_new(f.tyat)
    _a = dep_params(ds, w, out, tc, f.params, 0, list_len(f.params))
    _b = dep_type_text(ds, w, out, tc, f.ret)
    _c = dep_block(ds, w, out, tc, f.body)
    vec_free(tc)

fn dep_params(ds: DepSet, w: Where, out: Int, tc: Int, ps: List[TParam], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_type_text(ds, w, out, tc, list_get(ps, i).ty)
        dep_params(ds, w, out, tc, ps, i + 1, n)

fn dep_block(ds: DepSet, w: Where, out: Int, tc: Int, b: TBlock) -> Int ! alloc
    _a = dep_stmts(ds, w, out, tc, b.stmts, 0, list_len(b.stmts))
    dep_expr(ds, w, out, tc, b.tail)

# A `let` reads its type, then its value; an assignment reads its target, then its value.
fn dep_stmts(ds: DepSet, w: Where, out: Int, tc: Int, xs: List[TStmt], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(xs, i)
        _a = dep_type_text(ds, w, out, tc, st.ty)
        _b = dep_expr(ds, w, out, tc, st.target)
        _c = dep_expr(ds, w, out, tc, st.expr)
        dep_stmts(ds, w, out, tc, xs, i + 1, n)

fn dep_args(ds: DepSet, w: Where, out: Int, tc: Int, xs: List[Expr], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_expr(ds, w, out, tc, list_get(xs, i))
        dep_args(ds, w, out, tc, xs, i + 1, n)

fn dep_arms(ds: DepSet, w: Where, out: Int, tc: Int, xs: List[TArm], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_expr(ds, w, out, tc, list_get(xs, i).body)
        dep_arms(ds, w, out, tc, xs, i + 1, n)

fn dep_elsifs(ds: DepSet, w: Where, out: Int, tc: Int, xs: List[TElsif], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(xs, i)
        _a = dep_expr(ds, w, out, tc, a.cond)
        _b = dep_block(ds, w, out, tc, a.body)
        dep_elsifs(ds, w, out, tc, xs, i + 1, n)

fn dep_expr(ds: DepSet, w: Where, out: Int, tc: Int, e: Expr) -> Int ! alloc
    match e
        XCall(name, args, targs, xp) => dep_call(ds, w, out, tc, name, args, targs, xp)
        XBin(op, l, r) => dep_pair(ds, w, out, tc, l, r)
        XTo(place, inner) => dep_expr(ds, w, out, tc, inner)
        XOn(place, body, kern, idx) => dep_block(ds, w, out, tc, body)
        XIf(c, t, el, has_else, elsifs) => dep_if(ds, w, out, tc, c, t, el, elsifs)
        XWhile(c, body) => dep_while(ds, w, out, tc, c, body)
        XField(base, fld) => dep_expr(ds, w, out, tc, base)
        XLambda(param, body) => dep_expr(ds, w, out, tc, body)
        XUnary(op, inner) => dep_expr(ds, w, out, tc, inner)
        XMatch(scrut, arms) => dep_match(ds, w, out, tc, scrut, arms)
        XTry(inner) => dep_expr(ds, w, out, tc, inner)
        _ => 0

# The callee's name is a use at the call's position; its type arguments come before its arguments.
fn dep_call(ds: DepSet, w: Where, out: Int, tc: Int, name: String, args: List[Expr], targs: String, xp: Int) -> Int ! alloc
    _h = dep_hit(ds, w, out, name, xp)
    _t = dep_type_text(ds, w, out, tc, targs)
    dep_args(ds, w, out, tc, args, 0, list_len(args))

fn dep_pair(ds: DepSet, w: Where, out: Int, tc: Int, l: Expr, r: Expr) -> Int ! alloc
    _a = dep_expr(ds, w, out, tc, l)
    dep_expr(ds, w, out, tc, r)

# `if` reads its condition, its then-block, the elsif arms, then the else-block.
fn dep_if(ds: DepSet, w: Where, out: Int, tc: Int, c: Expr, t: TBlock, el: TBlock, elsifs: List[TElsif]) -> Int ! alloc
    _a = dep_expr(ds, w, out, tc, c)
    _b = dep_block(ds, w, out, tc, t)
    _c = dep_elsifs(ds, w, out, tc, elsifs, 0, list_len(elsifs))
    dep_block(ds, w, out, tc, el)

fn dep_while(ds: DepSet, w: Where, out: Int, tc: Int, c: Expr, body: TBlock) -> Int ! alloc
    _a = dep_expr(ds, w, out, tc, c)
    dep_block(ds, w, out, tc, body)

fn dep_match(ds: DepSet, w: Where, out: Int, tc: Int, scrut: Expr, arms: List[TArm]) -> Int ! alloc
    _a = dep_expr(ds, w, out, tc, scrut)
    dep_arms(ds, w, out, tc, arms, 0, list_len(arms))

# Warnings of one program; each is appended to `out`. Every item reads its own recorded offsets.
fn dep_program(ds: DepSet, w: Where, out: Int, tp: TProgram) -> Int ! alloc
    _a = dep_fns(ds, w, out, tp.fns, 0, list_len(tp.fns))
    _b = dep_fields(ds, w, out, tp.structs, 0, list_len(tp.structs))
    dep_variants(ds, w, out, tp.enums, 0, list_len(tp.enums))

fn dep_fns(ds: DepSet, w: Where, out: Int, fns: List[TFn], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_fn(ds, w, out, list_get(fns, i))
        dep_fns(ds, w, out, fns, i + 1, n)

fn dep_fields(ds: DepSet, w: Where, out: Int, sts: List[TStruct], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        st = list_get(sts, i)
        tc = tycur_new(st.tyat)
        _a = dep_field_list(ds, w, out, tc, st.fields, 0, list_len(st.fields))
        vec_free(tc)
        dep_fields(ds, w, out, sts, i + 1, n)

fn dep_field_list(ds: DepSet, w: Where, out: Int, tc: Int, fs: List[TField], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_type_text(ds, w, out, tc, list_get(fs, i).ty)
        dep_field_list(ds, w, out, tc, fs, i + 1, n)

fn dep_variants(ds: DepSet, w: Where, out: Int, es: List[TEnum], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        e = list_get(es, i)
        tc = tycur_new(e.tyat)
        _a = dep_variant_list(ds, w, out, tc, e.variants, 0, list_len(e.variants))
        vec_free(tc)
        dep_variants(ds, w, out, es, i + 1, n)

fn dep_variant_list(ds: DepSet, w: Where, out: Int, tc: Int, vs: List[TVariant], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_type_list(ds, w, out, tc, list_get(vs, i).fields, 0, list_len(list_get(vs, i).fields))
        dep_variant_list(ds, w, out, tc, vs, i + 1, n)

fn dep_type_list(ds: DepSet, w: Where, out: Int, tc: Int, tys: List[String], i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_type_text(ds, w, out, tc, list_get(tys, i))
        dep_type_list(ds, w, out, tc, tys, i + 1, n)

# Warnings of the qualified modules of a graph, printed to stderr in module order; 0 when none.
fn dep_warnings_graph(order: Graph) -> Int ! io, alloc
    ds = DepSet(list_new[String](), list_new[String]())
    _c = dep_collect_all(order, 0, list_len(order.progs), ds)
    out = vec_new()
    _d = dep_scan_all(order, 0, list_len(order.progs), ds, out)
    dep_print(out, 0, vec_len(out))

fn dep_collect_all(order: Graph, i: Int, n: Int, ds: DepSet) -> Int ! alloc
    if i >= n
        0
    else
        _a = dep_collect(list_get(order.progs, i), ds)
        dep_collect_all(order, i + 1, n, ds)

fn dep_scan_all(order: Graph, i: Int, n: Int, ds: DepSet, out: Int) -> Int ! io, alloc
    if i >= n
        0
    else
        path = mod_path_at(order, i)
        pre = preprocess(read_file(path))
        _a = dep_program(ds, Where(path, pre), out, list_get(order.progs, i))
        dep_scan_all(order, i + 1, n, ds, out)

fn dep_print(out: Int, i: Int, n: Int) -> Int ! io, alloc
    if i >= n
        0
    else
        _e = eprint_str(str_from_int(vec_get(out, i)) + "\n")
        dep_print(out, i + 1, n)

# The warnings of one file that compiles without imports; `label` names it and `pre` is its
# preprocessed text.
fn dep_warnings_single(label: String, pre: String, tp: TProgram) -> Int ! io, alloc
    ds = DepSet(list_new[String](), list_new[String]())
    _c = dep_collect(tp, ds)
    out = vec_new()
    _d = dep_program(ds, Where(label, pre), out, tp)
    dep_print(out, 0, vec_len(out))
