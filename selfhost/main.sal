fn II_CI() -> Int
    0
fn II_CS() -> Int
    1
fn II_BIN() -> Int
    2
fn II_CALL() -> Int
    3
fn II_PLACE() -> Int
    4
fn II_RET() -> Int
    5
fn II_DROP() -> Int
    6
fn II_IF() -> Int
