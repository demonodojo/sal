# NATIVE_SELFHOST_COMPILER
# Pure SAL: lexer, parser, lower, ir_to_text, emit_c. No embedded C. No exec helper.

# Result — same surface as std/prelude; encoded as Int vec [tag, payload]
# tag 0 = Ok(T), tag 1 = Err(E). Used on the emit/compile error path.
enum Result[T, E]
    Ok(T)
    Err(E)

fn result_ok(v: Int) -> Int ! alloc
    r = vec_new()
    _a = vec_push(r, 0)
    _b = vec_push(r, v)
    r

fn result_err(e: Int) -> Int ! alloc
    r = vec_new()
    _a = vec_push(r, 1)
    _b = vec_push(r, e)
    r

fn result_is_err(r: Int) -> Int ! alloc
    if vec_get(r, 0) == 1
        1
    else
        0

fn result_unwrap(r: Int) -> Int ! alloc
    vec_get(r, 1)

fn result_format_err(r: Int) -> Int ! alloc
    msg = result_unwrap(r)
    acc = strdup("Err(")
    acc = str_append(acc, msg)
    acc = str_append(acc, strdup(")\n"))
    acc

fn TK_EOF() -> Int
    0
fn TK_NL() -> Int
    1
fn TK_INDENT() -> Int
    2
fn TK_DEDENT() -> Int
    3
fn TK_IDENT() -> Int
    4
fn TK_INT() -> Int
    5
fn TK_FLOAT() -> Int
    6
fn TK_STRING() -> Int
    7
fn TK_FN() -> Int
    8
fn TK_ON() -> Int
    9
fn TK_TO() -> Int
    10
fn TK_ARROW() -> Int
    11
fn TK_BANG() -> Int
    12
fn TK_LPAREN() -> Int
    13
fn TK_RPAREN() -> Int
    14
fn TK_LBRACK() -> Int
    15
fn TK_RBRACK() -> Int
    16
fn TK_COMMA() -> Int
    17
fn TK_COLON() -> Int
    18
fn TK_EQ() -> Int
    19
fn TK_PLUS() -> Int
    20
fn TK_MINUS() -> Int
    21
fn TK_STAR() -> Int
    22
fn TK_SLASH() -> Int
    23
fn TK_EQEQ() -> Int
    24
fn TK_NE() -> Int
    25
fn TK_LT() -> Int
    26
fn TK_LE() -> Int
    27
fn TK_GT() -> Int
    28
fn TK_GE() -> Int
    29
