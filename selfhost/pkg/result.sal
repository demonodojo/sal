# Compile/emit error path. Oleada G: typed Ok/Err with a String message on Err
# (no `str_as_int` on the error). A flat `struct Res` crosses modules; the language
# `enum Result[T, E]` does not unify when imported (each module gets its own
# `Mod__Result` identity → `E_TYPE`). Prelude `Result` stays for user programs.
struct Res
    tag: Int
    val: Int
    err: String

fn result_ok(v: Int) -> Res ! alloc
    Res(0, v, "".dup())

fn result_ok_str(v: String) -> Res ! alloc
    Res(0, v.to_int(), "".dup())

fn result_err(e: Int) -> Res ! alloc
    Res(1, 0, str_from_int(e).dup())

fn result_err_str(e: &String) -> Res ! alloc
    Res(1, 0, e.dup())

fn result_is_err(r: &Res) -> Int
    r.tag

fn result_unwrap(r: &Res) -> Int
    r.val

fn result_format_err(r: &Res) -> String ! alloc
    acc = "Err("
    acc = acc + r.err + ")\n"
    acc
