import handles

fn source_hash(src: &String) -> String ! io, alloc
    h = src.hash(5381)
    self = argv(0)
    h = self.hash(h)
    if h < 0
        h = 0 - h
    else
        h = h
    h.to_str()

fn cache_dir() -> StrPath ! io, alloc
    e = getenv(&"SAL_SELFHOST_CACHE")
    if e.len() == 0
        StrPath("target/selfhost-cache")
    else
        StrPath(e)

fn cache_ir_path_raw(dir: &StrPath, key: &String) -> String ! alloc
    dir.raw + "/" + key + ".ir"

fn cache_meta_path_raw(dir: &StrPath, key: &String) -> String ! alloc
    dir.raw + "/" + key + ".meta"

fn cache_mkdir(dir: &StrPath) -> Int ! io, alloc
    mkdir_p(&dir.raw)

fn cache_key_for_graph_path(src: &String, source_path: &String) -> String ! io, alloc
    base = source_hash(src)
    p = realpath(source_path)
    h = src.hash(p.hash(5381))
    piece = h.to_str()
    base + ":" + piece
