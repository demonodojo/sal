# Import qualifiers and export link names (mirror of src/qualify.rs).
import result
import modules
import "../front/lexer.sal"
import "../ast/tshape.sal"
import "../ast/tast.sal"

# One export of a dependency module: which dep, the export name, the link name used in IR/C.
struct Link
    dep: String
    export: String
    link: String

# An import qualifier (explicit alias or implicit basename) bound to a dependency key.
struct Qual
    alias: String
    dep: String

# A local name renamed because of a clash across modules (`T` -> `mod__T`).
struct Rename
    src: String
    dst: String

# Per-module qualification context. `errs`/`own`/`alias_deps`/`flat` stay Int vecs for now
# (heterogeneous scratch); links and renames are typed Lists.
struct QualCtx
    explicit: List[Qual]
    implicit: List[Qual]
    renames: List[Rename]
    errs: Int
    own: Int
    alias_deps: Int
    flat: Int

fn str_replace_chr(s: &String, ch: Int, rep: &String) -> String ! alloc
    str_replace_chr_go(s, 0, str_len(s), ch, rep, "")

fn str_replace_chr_go(s: &String, i: Int, n: Int, ch: Int, rep: &String, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        c = str_char(s, i)
        if c == ch
            str_replace_chr_go(s, i + 1, n, ch, rep, (acc + rep))
        else
            str_replace_chr_go(s, i + 1, n, ch, rep, (acc + char_to_str(c)))

fn implicit_qualifier(import_path: String) -> String ! alloc
    base = import_path
    if str_len(base) >= 4
        if str_eq(str_slice(base, str_len(base) - 4, str_len(base)), ".sal") == 1
            base = str_slice(base, 0, str_len(base) - 4)
        else
            base = base
    else
        base = base
    seg = basename_path(&base)
    if str_len(seg) == 0
        ""
    else
        seg

fn modid_from_path(path: &String, proot: &String) -> String ! alloc
    pl = str_len(proot)
    n = str_len(path)
    rel = modid_rel_path(path, proot, n, pl)
    s = str_replace_chr(&rel, 47, &"__")
    if str_len(s) >= 4
        if str_eq(str_slice(s, str_len(s) - 4, str_len(s)), ".sal") == 1
            s = str_slice(s, 0, str_len(s) - 4)
        else
            s = s
    else
        s = s
    s2 = str_replace_chr(&s, 46, &"_")
    if str_len(s2) == 0
        "root"
    else
        s2

fn modid_rel_path(path: &String, proot: &String, n: Int, pl: Int) -> String ! alloc
    if pl == 0
        path.dup()
    elsif n <= pl + 1
        path.dup()
    elsif substr_eq_at(path, 0, proot, 0, pl) == 0
        path.dup()
    elsif str_char(path, pl) != 47
        path.dup()
    else
        str_slice(path, pl + 1, n)

fn link_name(modid: &String, name: &String, clashing: Int) -> String ! alloc
    if clashing == 1
        modid + "__" + name
    else
        name.dup()

fn name_clash_count(order: &Graph, n: Int, name: Int) -> Int ! alloc
    name_clash_count_go(order, 0, n, name, 0)

fn name_clash_count_go(order: &Graph, i: Int, n: Int, name: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        if module_defines(&list_get(&order.progs, i), &str_from_int(name)) == 1
            name_clash_count_go(order, i + 1, n, name, acc + 1)
        else
            name_clash_count_go(order, i + 1, n, name, acc)

# 1 when the module defines a fn or a struct called `name`.
fn module_defines(tp: &TProgram, name: &String) -> Int ! alloc
    if tt_fn_index(&tp.fns, name, 0) >= 0
        1
    elsif tt_struct_find(&tp.structs, name) >= 0
        1
    elsif const_defined(&tp.consts, name, 0, list_len(&tp.consts)) == 1
        1
    else
        0

fn const_defined(cs: &List[TConst], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(list_get(cs, i).name, name) == 1
        1
    else
        const_defined(cs, name, i + 1, n)

fn name_is_clashing(order: &Graph, n: Int, name: Int) -> Int ! alloc
    if name_clash_count(order, n, name) > 1
        1
    else
        0

fn graph_has_any_clash(order: &Graph, n: Int) -> Int ! alloc
    graph_has_any_clash_go(order, 0, n)

fn graph_has_any_clash_go(order: &Graph, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        tp = list_get(&order.progs, i)
        if fn_list_has_clash(order, n, &tp.fns, 0, list_len(&tp.fns)) == 1
            1
        elsif struct_list_has_clash(order, n, &tp.structs, 0, list_len(&tp.structs)) == 1
            1
        elsif const_list_has_clash(order, n, &tp.consts, 0, list_len(&tp.consts)) == 1
            1
        else
            graph_has_any_clash_go(order, i + 1, n)

fn const_list_has_clash(order: &Graph, n: Int, cs: &List[TConst], i: Int, cn: Int) -> Int ! alloc
    if i >= cn
        0
    elsif name_is_clashing(order, n, str_as_int(&list_get(cs, i).name)) == 1
        1
    else
        const_list_has_clash(order, n, cs, i + 1, cn)

fn fn_list_has_clash(order: &Graph, n: Int, fns: &List[TFn], i: Int, fn_n: Int) -> Int ! alloc
    if i >= fn_n
        0
    elsif name_is_clashing(order, n, str_as_int(&list_get(fns, i).name)) == 1
        1
    else
        fn_list_has_clash(order, n, fns, i + 1, fn_n)

fn struct_list_has_clash(order: &Graph, n: Int, sts: &List[TStruct], i: Int, sn: Int) -> Int ! alloc
    if i >= sn
        0
    elsif name_is_clashing(order, n, str_as_int(&list_get(sts, i).name)) == 1
        1
    else
        struct_list_has_clash(order, n, sts, i + 1, sn)

# Any import: bare and qualified calls are checked against what each module can see
# (`needs_qualify` in src/qualify.rs). An alias is one kind of import.
fn graph_has_import(order: &Graph, n: Int) -> Int ! alloc
    graph_has_import_go(order, 0, n)

fn graph_has_import_go(order: &Graph, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif order.progs.get(i).imports.len() > 0
        1
    else
        graph_has_import_go(order, i + 1, n)

fn needs_qualify(order: &Graph, n: Int) -> Int ! alloc
    if graph_has_import(order, n) == 1
        1
    else
        graph_has_any_clash(order, n)

fn links_push(links: List[Link], dep: &String, export: &String, link: &String) -> List[Link] ! alloc
    links.push(Link(dep.dup(), export.dup(), link.dup()))
    links

fn build_export_links(order: &Graph, n: Int, proot: &String) -> List[Link] ! alloc
    links = List.new[Link]()
    build_export_links_go(order, 0, n, proot, links)

fn build_export_links_go(order: &Graph, i: Int, n: Int, proot: &String, links: List[Link]) -> List[Link] ! alloc
    if i >= n
        links
    else
        key = mod_key_at(order, i)
        path = mod_path_at(order, i)
        mid = modid_from_path(&path, proot)
        tp = list_get(&order.progs, i)
        links2 = push_fn_links_go(order, n, &key, &mid, &tp.fns, 0, list_len(&tp.fns), links)
        links3 = push_struct_links_go(order, n, &key, &mid, &tp.structs, 0, list_len(&tp.structs), links2)
        links4 = push_const_links_go(order, n, &key, &mid, &tp.consts, 0, list_len(&tp.consts), links3)
        links5 = push_variant_links_go(&key, &tp.enums, 0, list_len(&tp.enums), links4)
        build_export_links_go(order, i + 1, n, proot, links5)

fn push_const_links_go(order: &Graph, n: Int, key: &String, mid: &String, cs: &List[TConst], i: Int, cn: Int, links: List[Link]) -> List[Link] ! alloc
    if i >= cn
        links
    else
        nm = list_get(cs, i).name
        clash = name_is_clashing(order, n, str_as_int(&nm))
        lk = link_name(mid, &nm, clash)
        links2 = links_push(links, key, &nm, &lk)
        push_const_links_go(order, n, key, mid, cs, i + 1, cn, links2)

# `alias.Variante` names a variant of the module (SPEC: enums are not exports). Variants keep their
# names in the selfhost, so the link is the name itself.
fn push_variant_links_go(key: &String, enums: &List[TEnum], i: Int, en: Int, links: List[Link]) -> List[Link] ! alloc
    if i >= en
        links
    else
        links2 = push_one_enum_variants(key, &list_get(enums, i).variants, 0, list_len(&list_get(enums, i).variants), links)
        push_variant_links_go(key, enums, i + 1, en, links2)

fn push_one_enum_variants(key: &String, vs: &List[TVariant], j: Int, vn: Int, links: List[Link]) -> List[Link] ! alloc
    if j >= vn
        links
    else
        nm = list_get(vs, j).name
        links2 = links_push(links, key, &nm, &nm)
        push_one_enum_variants(key, vs, j + 1, vn, links2)

fn push_fn_links_go(order: &Graph, n: Int, key: &String, mid: &String, fns: &List[TFn], i: Int, fn_n: Int, links: List[Link]) -> List[Link] ! alloc
    if i >= fn_n
        links
    else
        nm = list_get(fns, i).name
        clash = name_is_clashing(order, n, str_as_int(&nm))
        lk = link_name(mid, &nm, clash)
        links2 = links_push(links, key, &nm, &lk)
        push_fn_links_go(order, n, key, mid, fns, i + 1, fn_n, links2)

fn push_struct_links_go(order: &Graph, n: Int, key: &String, mid: &String, sts: &List[TStruct], i: Int, sn: Int, links: List[Link]) -> List[Link] ! alloc
    if i >= sn
        links
    else
        nm = list_get(sts, i).name
        clash = name_is_clashing(order, n, str_as_int(&nm))
        lk = link_name(mid, &nm, clash)
        links2 = links_push(links, key, &nm, &lk)
        push_struct_links_go(order, n, key, mid, sts, i + 1, sn, links2)

# Empty string when missing.
fn export_link_lookup(links: &List[Link], dep: &String, item: &String) -> String ! alloc
    export_link_lookup_go(links, 0, links.len(), dep, item)

fn export_link_lookup_go(links: &List[Link], i: Int, n: Int, dep: &String, item: &String) -> String ! alloc
    if i >= n
        ""
    else
        row = links.get(i)
        if row.dep.eq(dep) == 1
            if row.export.eq(item) == 1
                row.link.dup()
            else
                export_link_lookup_go(links, i + 1, n, dep, item)
        else
            export_link_lookup_go(links, i + 1, n, dep, item)

fn quals_push(quals: List[Qual], alias: &String, dep: &String) -> List[Qual] ! alloc
    quals.push(Qual(alias.dup(), dep.dup()))
    quals

# Empty string when the qualifier is unknown.
fn qualifier_dep(explicit: &List[Qual], implicit: &List[Qual], alias: &String) -> String ! alloc
    k = qualifier_dep_in(explicit, alias)
    if k.len() != 0
        k
    else
        qualifier_dep_in(implicit, alias)

fn qualifier_dep_in(quals: &List[Qual], alias: &String) -> String ! alloc
    qualifier_dep_in_go(quals, 0, quals.len(), alias)

fn qualifier_dep_in_go(quals: &List[Qual], i: Int, n: Int, alias: &String) -> String ! alloc
    if i >= n
        ""
    else
        row = quals.get(i)
        if row.alias.eq(alias) == 1
            row.dep.dup()
        else
            qualifier_dep_in_go(quals, i + 1, n, alias)

fn rename_lookup(rs: &List[Rename], name: &String) -> String ! alloc
    rename_lookup_go(rs, 0, rs.len(), name)

fn rename_lookup_go(rs: &List[Rename], i: Int, n: Int, name: &String) -> String ! alloc
    if i >= n
        ""
    else
        row = rs.get(i)
        if row.src.eq(name) == 1
            row.dst.dup()
        else
            rename_lookup_go(rs, i + 1, n, name)

fn rename_put(rs: List[Rename], src: &String, dst: &String) -> List[Rename] ! alloc
    rs.push(Rename(src.dup(), dst.dup()))
    rs

fn local_fn_name(tp: &TProgram, name: &String) -> Int ! alloc
    if tt_fn_index(&tp.fns, name, 0) >= 0
        1
    else
        0

fn local_struct_name(tp: &TProgram, name: &String) -> Int ! alloc
    if tt_struct_find(&tp.structs, name) >= 0
        1
    else
        0

# On success pushes one QualCtx into `out` and returns result_ok(0). On failure, result_err.
fn module_qualifiers(order: &Graph, mi: Int, proot: &String, out: &mut List[QualCtx]) -> Res ! io, alloc
    explicit = List.new[Qual]()
    implicit = List.new[Qual]()
    tp = list_get(&order.progs, mi)
    mpath = mod_path_at(order, mi)
    module_qualifiers_go(&tp, 0, list_len(&tp.imports), &mpath, proot, explicit, implicit, out)

fn module_qualifiers_go(tp: &TProgram, i: Int, n: Int, mpath: &String, proot: &String, explicit: List[Qual], implicit: List[Qual], out: &mut List[QualCtx]) -> Res ! io, alloc
    if i >= n
        out.push(QualCtx(explicit, implicit, List.new[Rename](), vec_new(), vec_new(), vec_new(), vec_new()))
        result_ok(0)
    else
        imp = list_get(&tp.imports, i)
        alias = list_get(&tp.aliases, i)
        dep_path = resolve_import_path_with_manifest(&imp, mpath, proot)
        if str_len(dep_path) == 0
            module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit, out)
        else
            dep_key = path_key(&dep_path)
            if str_len(alias) != 0
                if local_fn_name(tp, &alias) == 1
                    result_err_str(&"import alias conflicts with a local item")
                elsif local_struct_name(tp, &alias) == 1
                    result_err_str(&"import alias conflicts with a local item")
                elsif qualifier_dep_in(&explicit, &alias).len() != 0
                    result_err_str(&"duplicate import alias")
                else
                    ex2 = quals_push(explicit, &alias, &dep_key)
                    module_qualifiers_go(tp, i + 1, n, mpath, proot, ex2, implicit, out)
            else
                iq = implicit_qualifier(imp.clone())
                if str_len(iq) == 0
                    module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit, out)
                else
                    if local_fn_name(tp, &iq) == 1
                        module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit, out)
                    elsif local_struct_name(tp, &iq) == 1
                        module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, implicit, out)
                    elsif qualifier_dep_in(&implicit, &iq).len() != 0
                        result_err_str(&"ambiguous implicit qualifier")
                    else
                        im2 = quals_push(implicit, &iq, &dep_key)
                        module_qualifiers_go(tp, i + 1, n, mpath, proot, explicit, im2, out)

fn split_qual_member(name: &String) -> Int ! alloc
    dot = find_char(name, 46, 0, str_len(name))
    if dot < 0
        0
    else
        pair = vec_new()
        _a = vec_push(pair, str_as_int(&str_slice(name, 0, dot)))
        _b = vec_push(pair, str_as_int(&str_slice(name, dot + 1, str_len(name))))
        pair

fn resolve_qualified_item(ctx: &QualCtx, links: &List[Link], qual: &String, member: &String) -> String ! alloc
    dep = qualifier_dep(&ctx.explicit, &ctx.implicit, qual)
    if dep.len() == 0
        ""
    else
        export_link_lookup(links, &dep, member)

fn qualify_type_handle(ty: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if ty == 0
        0
    else
        s = ts_trim(&str_from_int(ty))
        pair = split_qual_member(&s)
        if pair == 0
            renamed = rename_lookup(&ctx.renames, &ty_trim_go(s))
            if renamed.len() != 0
                str_as_int(&renamed)
            else
                ty
        else
            qual = str_from_int(vec_get(pair, 0))
            member = str_from_int(vec_get(pair, 1))
            lk = resolve_qualified_item(ctx, links, &qual, &member)
            if lk.len() == 0
                ty
            else
                str_as_int(&lk)

# The body is qualified in place. A node stays in its box. A name is replaced only when the
# link map renames it, and `M.campo` becomes an identifier. The same nodes the copy used to
# leave untouched (`lambda`, unary, `try`, a tensor) are still not walked.
fn qx_ident_link(ctx: &QualCtx, links: &List[Link], qual: &String, member: &String) -> String ! alloc
    resolve_qualified_item(ctx, links, qual, member)

# 1 when `neu` is a different box. Two unit tags both report id 0.
fn qx_moved(old: &Expr, neu: &Expr) -> Int ! alloc
    ob = enum_box_id(old)
    nb = enum_box_id(neu)
    if ob == nb
        0
    else
        1

# The same pointer. `*e` would move a non-Copy value out of the reference.
# An owned copy of `e` (`clone`): a list that carried an alias released the caller's tree.
fn qx_same(e: &Expr) -> Expr ! alloc
    tc_expr(e)

# A copy of the list: a shared alias left in a temporary box would be released with the box.
fn qx_share_list(xs: &List[Expr]) -> List[Expr] ! alloc
    out = List.new[Expr]()
    _c = tc_exprs(xs, 0, xs.len(), &mut out)
    out

fn qx_share_str(s: &String) -> String ! alloc
    s.dup()

fn qx_field(e: &Expr, base: &Expr, fld: &String, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    match base
        XIdent(qual) => qx_field_ident(e, base, &qual, fld, ctx, links)
        _ =>
            nb = qx(base, ctx, links)
            if qx_moved(base, &nb) == 1
                _s = enum_set(e, 0, nb)
            qx_same(e)

# `M.campo` linked to an export becomes an identifier. The old field box is only a shell.
fn qx_field_ident(e: &Expr, base: &Expr, qual: &String, fld: &String, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    lk = qx_ident_link(ctx, links, qual, fld)
    if lk.len() != 0
        # `e` and its parts are borrowed here: the shell is left to the caller (never freed twice).
        XIdent(lk)
    else
        qx_same(e)

# The string to store as the callee. The same pointer when the name does not change.
fn qx_call_name(nm: &String, ctx: &QualCtx, links: &List[Link]) -> String ! alloc
    pair = split_qual_member(nm)
    if pair == 0
        renamed = rename_lookup(&ctx.renames, nm)
        if renamed.len() != 0
            renamed
        else
            nm.dup()
    else
        q = str_from_int(vec_get(pair, 0))
        m = str_from_int(vec_get(pair, 1))
        lk = resolve_qualified_item(ctx, links, &q, &m)
        if lk.len() == 0
            # `T.f(..)` on a local type renamed by a clash (`T` -> `mod__T`): the qualifier follows.
            renamed = rename_lookup(&ctx.renames, &q)
            if renamed.len() != 0
                renamed + "." + m
            else
                nm.dup()
        else
            lk

fn qx_args(xs: &mut List[Expr], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        cur = list_get(xs, i)
        neu = qx(&cur, ctx, links)
        if qx_moved(&cur, &neu) == 1
            _s = list_set(xs, i, neu)
        qx_args(xs, i + 1, n, ctx, links)

# A renamed callee is a new call: the constructor takes the string. The argument list and the
# type arguments stay the ones this call already had. An unchanged name keeps the box.
fn qx_call(e: &Expr, nm: &String, args: &mut List[Expr], targs: &String, xp: Int, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    pos = qx_call_pos(nm, xp, ctx)
    _a = qx_args(args, 0, list_len(args), ctx, links)
    neu = qx_call_name(nm, ctx, links)
    if str_as_int(&neu) != str_as_int(nm)
        built = XCall(neu, qx_share_list(args), qx_share_str(targs), pos)
        built
    elsif pos != xp
        _p = enum_set(e, 3, pos)
        qx_same(e)
    else
        qx_same(e)

# A call through a module qualifier is placed at its qualifier (the start of `alias.f`), as the
# bootstrap reports it; the position of any other call is kept.
fn qx_call_pos(nm: &String, xp: Int, ctx: &QualCtx) -> Int ! alloc
    pair = split_qual_member(nm)
    if pair == 0
        xp
    elsif xp <= 0
        xp
    elsif qualifier_dep(&ctx.explicit, &ctx.implicit, &str_from_int(vec_get(pair, 0))).len() == 0
        xp
    else
        xp - str_len(nm)

fn qx_elsifs(xs: &mut List[TElsif], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(&mut xs, i)
        _c = qx_bind(&mut a, ctx, links)
        qx_elsifs(xs, i + 1, n, ctx, links)

# The condition stays in its box unless it was `M.campo`. The body is the same block.
fn qx_bind(a: &mut TElsif, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    neu = qx(&a.cond, ctx, links)
    if qx_moved(&a.cond, &neu) == 1
        a.cond = neu
    a.body = qx_block(&mut a.body, ctx, links)
    0

fn qx_expr_slot(e: &Expr, i: Int, child: &Expr, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    neu = qx(child, ctx, links)
    if qx_moved(child, &neu) == 1
        _s = enum_set(e, i, neu)
        0
    else
        0

fn qx(e: &Expr, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    match e
        XField(base, fld) => qx_field(e, &base, &fld, ctx, links)
        XCall(nm, args, targs, xp) => qx_call(e, &nm, &mut args, &targs, xp, ctx, links)
        XBin(_, l, r) => qx_bin(e, &l, &r, ctx, links)
        XIf(cond, then_b, else_b, has_else, elsifs) => qx_if(e, &cond, &mut then_b, &mut else_b, has_else, &mut elsifs, ctx, links)
        XWhile(cond, body) => qx_while(e, &cond, &mut body, ctx, links)
        XTo(_, inner) => qx_one(e, 1, &inner, ctx, links)
        XOn(_, body, _, _) => qx_on(e, &mut body, ctx, links)
        XMatch(scrut, arms) => qx_match(e, &scrut, &mut arms, ctx, links)
        _ => qx_same(e)

fn qx_bin(e: &Expr, l: &Expr, r: &Expr, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    _l = qx_expr_slot(e, 1, l, ctx, links)
    _r = qx_expr_slot(e, 2, r, ctx, links)
    qx_same(e)

fn qx_one(e: &Expr, i: Int, child: &Expr, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    _c = qx_expr_slot(e, i, child, ctx, links)
    qx_same(e)

fn qx_if(e: &Expr, cond: &Expr, then_b: &mut TBlock, else_b: &mut TBlock, has_else: Int, elsifs: &mut List[TElsif], ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    _c = qx_expr_slot(e, 0, cond, ctx, links)
    _t = enum_set(e, 1, qx_block(then_b, ctx, links))
    if has_else == 1
        _e = enum_set(e, 2, qx_block(else_b, ctx, links))
    _a = qx_elsifs(elsifs, 0, list_len(elsifs), ctx, links)
    qx_same(e)

fn qx_while(e: &Expr, cond: &Expr, body: &mut TBlock, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    _c = qx_expr_slot(e, 0, cond, ctx, links)
    _b = enum_set(e, 1, qx_block(body, ctx, links))
    qx_same(e)

fn qx_on(e: &Expr, body: &mut TBlock, ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    _b = enum_set(e, 1, qx_block(body, ctx, links))
    qx_same(e)

fn qx_match(e: &Expr, scrut: &Expr, arms: &mut List[TArm], ctx: &QualCtx, links: &List[Link]) -> Expr ! alloc
    _s = qx_expr_slot(e, 0, scrut, ctx, links)
    _a = qx_arms(arms, 0, list_len(arms), ctx, links)
    qx_same(e)

fn qx_arms(xs: &mut List[TArm], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        a = list_get(&mut xs, i)
        _p = qx_pat(&a.pat, ctx, links)
        neu = qx(&a.body, ctx, links)
        if qx_moved(&a.body, &neu) == 1
            a.body = neu
        a.suite = qx_block(&mut a.suite, ctx, links)
        qx_arms(xs, i + 1, n, ctx, links)

# Variant patterns of an arm. `alias.V` needs an alias whose module has `V`; a bare `V` must be a
# variant of this module or of a module that is not reached only through an alias (SPEC, Módulos).
# The errors go to the list in `ctx[3]`. The pattern box stays.
fn qx_pat(p: &TPat, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if p.kind == 3
        _c = qx_variant_check(p, ctx, links)
    qx_pat_list(&p.args, 0, list_len(&p.args), ctx, links)

fn qx_pat_list(xs: &List[TPat], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        _a = qx_pat(&list_get(xs, i), ctx, links)
        qx_pat_list(xs, i + 1, n, ctx, links)

fn qx_variant_check(p: &TPat, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if str_len(p.qual) > 0
        dep = qualifier_dep(&ctx.explicit, &ctx.implicit, &p.qual)
        if dep.len() == 0
            qx_err(ctx, &("unknown qualifier `" + p.qual + "`"))
        elsif export_link_lookup(links, &dep, &p.name).len() == 0
            qx_err(ctx, &("no variant `" + p.name + "` in that module"))
        else
            0
    elsif vec_has_name(ctx.own, &p.name, 0, vec_len(ctx.own)) == 1
        0
    elsif alias_only_variant(ctx.alias_deps, links, &p.name, 0, vec_len(ctx.alias_deps)) == 1
        if alias_only_variant(ctx.flat, links, &p.name, 0, vec_len(ctx.flat)) == 1
            0
        else
            qx_err(ctx, &("variant `" + p.name + "` is only reachable through its import alias"))
    else
        0

# The modules a module sees flat (imports without `as`, transitively; SPEC, Módulos), as keys in
# `seen`. Their variants are in scope unqualified.
fn flat_keys(order: &Graph, mi: Int, proot: &String, seen: Int) -> Res ! io, alloc
    tp = list_get(&order.progs, mi)
    box = List.new[QualCtx]()
    step = module_qualifiers(order, mi, proot, &mut box)
    if result_is_err(&step) == 1
        step
    else
        ctx = box.pop()
        _f = flat_keys_go(order, proot, &tp, &ctx, 0, list_len(&tp.imports), seen)
        result_ok(0)

fn flat_keys_go(order: &Graph, proot: &String, tp: &TProgram, ctx: &QualCtx, i: Int, n: Int, seen: Int) -> Int ! io, alloc
    if i >= n
        0
    elsif str_len(list_get(&tp.aliases, i)) != 0
        flat_keys_go(order, proot, tp, ctx, i + 1, n, seen)
    else
        _a = flat_add_import(order, proot, ctx, &implicit_qualifier(list_get(&tp.imports, i).clone()), seen)
        flat_keys_go(order, proot, tp, ctx, i + 1, n, seen)

# The module a plain import names is flat; so are the modules it imports flat.
fn flat_add_import(order: &Graph, proot: &String, ctx: &QualCtx, qual: &String, seen: Int) -> Res ! io, alloc
    k = qualifier_dep(&ctx.explicit, &ctx.implicit, qual)
    if k.len() == 0
        result_ok(0)
    elsif vec_has_key(seen, str_as_int(&k), 0, vec_len(seen)) == 1
        result_ok(0)
    else
        _p = vec_push(seen, str_as_int(&k))
        j = graph_find_by_key(order, &k, 0, list_len(&order.mods))
        if j >= 0
            flat_keys(order, j, proot, seen)
        else
            result_ok(0)

fn vec_has_key(v: Int, k: Int, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif vec_get(v, i) == k
        1
    else
        vec_has_key(v, k, i + 1, n)

fn qx_err(ctx: &QualCtx, msg: &String) -> Int ! alloc
    vec_push(ctx.errs, str_as_int(msg))

fn vec_has_name(v: Int, name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif str_eq(str_from_int(vec_get(v, i)), name) == 1
        1
    else
        vec_has_name(v, name, i + 1, n)

fn alias_only_variant(deps: Int, links: &List[Link], name: &String, i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    elsif export_link_lookup(links, &str_from_int(vec_get(deps, i)), name).len() != 0
        1
    else
        alias_only_variant(deps, links, name, i + 1, n)

fn own_variant_names(enums: &List[TEnum], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        0
    else
        own_one_enum(&list_get(enums, i).variants, 0, list_len(&list_get(enums, i).variants), out)
        own_variant_names(enums, i + 1, n, out)

fn own_one_enum(vs: &List[TVariant], j: Int, n: Int, out: Int) -> Int ! alloc
    if j >= n
        0
    else
        _a = vec_push(out, str_as_int(&strdup(list_get(vs, j).name)))
        own_one_enum(vs, j + 1, n, out)

fn qx_stmt(st: &mut TStmt, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    neu = qx(&st.expr, ctx, links)
    if qx_moved(&st.expr, &neu) == 1
        st.expr = neu
    0

fn qx_stmts(xs: &mut List[TStmt], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        _a = qx_stmt(&mut list_get(&mut xs, i), ctx, links)
        qx_stmts(xs, i + 1, n, ctx, links)

fn qx_block(b: &mut TBlock, ctx: &QualCtx, links: &List[Link]) -> TBlock ! alloc
    h689_0 = list_len(&b.stmts)
    _a = qx_stmts(&mut b.stmts, 0, h689_0, ctx, links)
    neu = qx(&b.tail, ctx, links)
    if qx_moved(&b.tail, &neu) == 1
        TBlock(b.stmts.clone(), neu)
    else
        TBlock(b.stmts.clone(), b.tail.clone())

# A type string changes only when the handle says so. The same pointer stays otherwise.
fn qx_apply_ty(cur: &String, ctx: &QualCtx, links: &List[Link]) -> String ! alloc
    if str_len(cur) == 0
        cur.dup()
    else
        neu = qualify_type_handle(str_as_int(cur), ctx, links)
        if neu == 0 || neu == str_as_int(cur)
            cur.dup()
        else
            _f = free(cur)
            strdup(str_from_int(neu))

fn qx_params(ps: &mut List[TParam], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        pm = list_get(&mut ps, i)
        pm.ty = qx_apply_ty(&pm.ty, ctx, links)
        qx_params(ps, i + 1, n, ctx, links)

# The rename map keeps the original name as its key, so the previous text is left in place.
fn qx_new_name(cur: &String, r: &List[Rename]) -> String ! alloc
    rename_lookup(r, cur)

fn qx_fns(fns: &mut List[TFn], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(&mut fns, i)
        n_params = list_len(&f.params)
        _p = qx_params(&mut f.params, 0, n_params, ctx, links)
        f.body = qx_block(&mut f.body, ctx, links)
        f.ret = qx_apply_ty(&f.ret, ctx, links)
        qx_fns(fns, i + 1, n, ctx, links)

fn qx_rename_fns(fns: &mut List[TFn], i: Int, n: Int, r: &List[Rename]) -> Int ! alloc
    if i >= n
        0
    else
        f = list_get(&mut fns, i)
        neu = qx_new_name(&f.name, r)
        if str_len(neu) != 0
            f.name = neu
        qx_rename_fns(fns, i + 1, n, r)

fn qx_consts(cs: &mut List[TConst], i: Int, n: Int, ctx: &QualCtx, links: &List[Link]) -> Int ! alloc
    if i >= n
        0
    else
        c = list_get(&mut cs, i)
        neu = qx(&c.expr, ctx, links)
        if qx_moved(&c.expr, &neu) == 1
            c.expr = neu
        qx_consts(cs, i + 1, n, ctx, links)

fn qx_rename_consts(cs: &mut List[TConst], i: Int, n: Int, r: &List[Rename]) -> Int ! alloc
    if i >= n
        0
    else
        c = list_get(&mut cs, i)
        neu = qx_new_name(&c.name, r)
        if str_len(neu) != 0
            c.name = neu
        qx_rename_consts(cs, i + 1, n, r)

fn qx_rename_structs(sts: &mut List[TStruct], i: Int, n: Int, r: &List[Rename]) -> Int ! alloc
    if i >= n
        0
    else
        s = list_get(&mut sts, i)
        neu = qx_new_name(&s.name, r)
        if str_len(neu) != 0
            s.name = neu
        qx_rename_structs(sts, i + 1, n, r)

# Qualifies module `mi` where it already sits. Bodies are rewritten before names, so the
# rename map's keys stay alive for the lookups.
fn qualify_typed(order: &mut Graph, mi: Int, ctx: &QualCtx, links: &List[Link], r: &List[Rename]) -> Int ! alloc
    tp = list_get(&mut order.progs, mi)
    n_fns = list_len(&tp.fns)
    _a = qx_fns(&mut tp.fns, 0, n_fns, ctx, links)
    n_consts = list_len(&tp.consts)
    _k = qx_consts(&mut tp.consts, 0, n_consts, ctx, links)
    n_fns = list_len(&tp.fns)
    _f = qx_rename_fns(&mut tp.fns, 0, n_fns, r)
    n_structs = list_len(&tp.structs)
    _s = qx_rename_structs(&mut tp.structs, 0, n_structs, r)
    n_consts = list_len(&tp.consts)
    _c = qx_rename_consts(&mut tp.consts, 0, n_consts, r)
    0

fn flat_export_name_seen(seen: Int, name: Int) -> Int ! alloc
    vec_has_str(seen, name, 0, vec_len(seen))

fn check_flat_import_clashes(order: &Graph, mi: Int, proot: &String) -> Res ! io, alloc
    tp = list_get(&order.progs, mi)
    mpath = mod_path_at(order, mi)
    seen = vec_new()
    check_flat_go(&tp, 0, list_len(&tp.imports), &mpath, proot, order, seen)

fn check_flat_go(tp: &TProgram, i: Int, n: Int, mpath: &String, proot: &String, order: &Graph, seen: Int) -> Res ! io, alloc
    if i >= n
        result_ok(0)
    else
        if str_len(list_get(&tp.aliases, i)) != 0
            check_flat_go(tp, i + 1, n, mpath, proot, order, seen)
        else
            dep_path = resolve_import_path_with_manifest(&list_get(&tp.imports, i), mpath, proot)
            if str_len(dep_path) == 0
                check_flat_go(tp, i + 1, n, mpath, proot, order, seen)
            else
                dep_m = graph_find_by_key(order, &path_key(&dep_path), 0, list_len(&order.mods))
                if dep_m < 0
                    check_flat_go(tp, i + 1, n, mpath, proot, order, seen)
                else
                    step = check_flat_dep_exports(&list_get(&order.progs, dep_m), seen)
                    if result_is_err(&step) == 1
                        step
                    else
                        seen2 = result_unwrap(&step)
                        check_flat_go(tp, i + 1, n, mpath, proot, order, seen2)

fn check_flat_dep_exports(tp: &TProgram, seen: Int) -> Res ! alloc
    seen2 = merge_const_names_seen(&tp.consts, 0, list_len(&tp.consts), merge_struct_names_seen(&tp.structs, 0, list_len(&tp.structs), merge_fn_names_seen(&tp.fns, 0, list_len(&tp.fns), seen)))
    if seen2 == 0
        result_err_str(&"name defined in more than one imported module")
    else
        result_ok(seen2)

fn merge_fn_names_seen(fns: &List[TFn], i: Int, n: Int, seen: Int) -> Int ! alloc
    if seen == 0
        0
    elsif i >= n
        seen
    else
        nm = str_as_int(&list_get(fns, i).name)
        if flat_export_name_seen(seen, nm) == 1
            0
        else
            _p = vec_push(seen, nm)
            merge_fn_names_seen(fns, i + 1, n, seen)

fn merge_const_names_seen(cs: &List[TConst], i: Int, n: Int, seen: Int) -> Int ! alloc
    if seen == 0
        0
    elsif i >= n
        seen
    else
        nm = str_as_int(&list_get(cs, i).name)
        if flat_export_name_seen(seen, nm) == 1
            0
        else
            _p = vec_push(seen, nm)
            merge_const_names_seen(cs, i + 1, n, seen)

fn merge_struct_names_seen(sts: &List[TStruct], i: Int, n: Int, seen: Int) -> Int ! alloc
    if seen == 0
        0
    elsif i >= n
        seen
    else
        nm = str_as_int(&list_get(sts, i).name)
        if flat_export_name_seen(seen, nm) == 1
            0
        else
            _p = vec_push(seen, nm)
            merge_struct_names_seen(sts, i + 1, n, seen)

# Names defined in more than one module, judged before anything is renamed.
fn build_clash_map(order: &Graph, n: Int) -> Int ! alloc
    clash = map_new()
    _a = clash_map_modules(order, 0, n, n, clash)
    clash

fn clash_map_modules(order: &Graph, i: Int, n: Int, total: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        tp = list_get(&order.progs, i)
        _f = clash_map_fns(order, total, &tp.fns, 0, list_len(&tp.fns), clash)
        _s = clash_map_structs(order, total, &tp.structs, 0, list_len(&tp.structs), clash)
        _c = clash_map_consts(order, total, &tp.consts, 0, list_len(&tp.consts), clash)
        clash_map_modules(order, i + 1, n, total, clash)

fn clash_map_consts(order: &Graph, total: Int, cs: &List[TConst], i: Int, n: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(&list_get(cs, i).name)
        if name_is_clashing(order, total, nm) == 1
            _p = map_put(clash, nm, 1)
            clash_map_consts(order, total, cs, i + 1, n, clash)
        else
            clash_map_consts(order, total, cs, i + 1, n, clash)

fn clash_map_fns(order: &Graph, total: Int, fns: &List[TFn], i: Int, n: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(&list_get(fns, i).name)
        if name_is_clashing(order, total, nm) == 1
            _p = map_put(clash, nm, 1)
            clash_map_fns(order, total, fns, i + 1, n, clash)
        else
            clash_map_fns(order, total, fns, i + 1, n, clash)

fn clash_map_structs(order: &Graph, total: Int, sts: &List[TStruct], i: Int, n: Int, clash: Int) -> Int ! alloc
    if i >= n
        0
    else
        nm = str_as_int(&list_get(sts, i).name)
        if name_is_clashing(order, total, nm) == 1
            _p = map_put(clash, nm, 1)
            clash_map_structs(order, total, sts, i + 1, n, clash)
        else
            clash_map_structs(order, total, sts, i + 1, n, clash)

# name -> link name for the clashing definitions of one module.
fn local_renames(tp: &TProgram, clash: Int, modid: &String) -> List[Rename] ! alloc
    r = List.new[Rename]()
    r = local_renames_fns(&tp.fns, 0, list_len(&tp.fns), clash, modid, r)
    r = local_renames_structs(&tp.structs, 0, list_len(&tp.structs), clash, modid, r)
    r = local_renames_consts(&tp.consts, 0, list_len(&tp.consts), clash, modid, r)
    r = local_renames_methods(&tp.fns, 0, list_len(&tp.fns), r)
    r

fn local_renames_consts(cs: &List[TConst], i: Int, n: Int, clash: Int, modid: &String, r: List[Rename]) -> List[Rename] ! alloc
    if i >= n
        r
    else
        nm = list_get(cs, i).name
        if map_get(clash, str_as_int(&nm)) == 1
            r2 = rename_put(r, &nm, &link_name(modid, &nm, 1))
            local_renames_consts(cs, i + 1, n, clash, modid, r2)
        else
            local_renames_consts(cs, i + 1, n, clash, modid, r)

# A method or static of a renamed type follows its type: `T__m` -> `mod__T__m`.
fn local_renames_methods(fns: &List[TFn], i: Int, n: Int, r: List[Rename]) -> List[Rename] ! alloc
    if i >= n
        r
    else
        f = list_get(fns, i)
        rv = rename_lookup(&r, &f.recv)
        if str_len(f.recv) > 0
            if rv.len() != 0
                dst = rv + "__" + str_slice(f.name, str_len(f.recv) + 2, str_len(f.name))
                r2 = rename_put(r, &f.name, &dst)
                local_renames_methods(fns, i + 1, n, r2)
            else
                local_renames_methods(fns, i + 1, n, r)
        else
            local_renames_methods(fns, i + 1, n, r)

fn local_renames_fns(fns: &List[TFn], i: Int, n: Int, clash: Int, modid: &String, r: List[Rename]) -> List[Rename] ! alloc
    if i >= n
        r
    else
        nm = list_get(fns, i).name
        if map_get(clash, str_as_int(&nm)) != 0
            r2 = rename_put(r, &nm, &link_name(modid, &nm, 1))
            local_renames_fns(fns, i + 1, n, clash, modid, r2)
        else
            local_renames_fns(fns, i + 1, n, clash, modid, r)

fn local_renames_structs(sts: &List[TStruct], i: Int, n: Int, clash: Int, modid: &String, r: List[Rename]) -> List[Rename] ! alloc
    if i >= n
        r
    else
        nm = list_get(sts, i).name
        if map_get(clash, str_as_int(&nm)) != 0
            r2 = rename_put(r, &nm, &link_name(modid, &nm, 1))
            local_renames_structs(sts, i + 1, n, clash, modid, r2)
        else
            local_renames_structs(sts, i + 1, n, clash, modid, r)

fn qualify_one_module(order: &mut Graph, mi: Int, proot: &String, links: &List[Link], clash: Int) -> Res ! io, alloc
    box = List.new[QualCtx]()
    ctx_step = module_qualifiers(order, mi, proot, &mut box)
    if result_is_err(&ctx_step) == 1
        ctx_step
    else
        ctx = box.pop()
        path = mod_path_at(order, mi)
        mid = modid_from_path(&path, proot)
        tp = list_get(&order.progs, mi)
        ctx.renames = local_renames(&tp, clash, &mid)
        ctx.errs = vec_new()
        own = vec_new()
        _o = own_variant_names(&tp.enums, 0, list_len(&tp.enums), own)
        ctx.own = own
        ctx.alias_deps = alias_dep_keys(&ctx, &tp.aliases, 0, list_len(&tp.aliases), vec_new())
        flat = vec_new()
        _fl = flat_keys(order, mi, proot, flat)
        ctx.flat = flat
        _q = qualify_typed(order, mi, &ctx, links, &ctx.renames)
        if vec_len(ctx.errs) > 0
            result_err_str(&str_from_int(vec_get(ctx.errs, 0)))
        else
            result_ok(0)

# The keys of the modules imported under an alias of this module.
fn alias_dep_keys(ctx: &QualCtx, aliases: &List[String], i: Int, n: Int, out: Int) -> Int ! alloc
    if i >= n
        out
    else
        a = list_get(aliases, i)
        if str_len(a) > 0
            dep = qualifier_dep(&ctx.explicit, &ctx.implicit, &a)
            if dep.len() != 0
                _p = vec_push(out, str_as_int(&dep))
        alias_dep_keys(ctx, aliases, i + 1, n, out)

fn qualify_all_modules(order: &mut Graph, n: Int, proot: &String, links: &List[Link]) -> Res ! io, alloc
    clash = build_clash_map(order, n)
    qualify_all_go(order, 0, n, proot, links, clash)

fn qualify_all_go(order: &mut Graph, i: Int, n: Int, proot: &String, links: &List[Link], clash: Int) -> Res ! io, alloc
    if i >= n
        result_ok(0)
    else
        step2 = qualify_one_module(order, i, proot, links, clash)
        if result_is_err(&step2) == 1
            step2
        else
            qualify_all_go(order, i + 1, n, proot, links, clash)

# Flat-import clashes are judged on the original names, before any module is
# renamed (renaming makes the clashing exports distinct).
fn check_all_flat_clashes(order: &Graph, i: Int, n: Int, proot: &String) -> Res ! io, alloc
    if i >= n
        result_ok(0)
    else
        step = check_flat_import_clashes(order, i, proot)
        if result_is_err(&step) == 1
            step
        else
            check_all_flat_clashes(order, i + 1, n, proot)

fn qualify_module_graph(order: &mut Graph, proot: &String) -> Res ! io, alloc
    n = list_len(&order.mods)
    if needs_qualify(order, n) == 0
        result_ok(0)
    else
        clash = check_all_flat_clashes(order, 0, n, proot)
        if result_is_err(&clash) == 1
            clash
        else
            links = build_export_links(order, n, proot)
            step = qualify_all_modules(order, n, proot, &links)
            if result_is_err(&step) == 1
                step
            else
                result_ok(0)
