struct B
    xs: List[Int]
    n: Int

fn tp_free_shallow(b: B) -> Int ! alloc
    list_free(b.xs)
    0

fn tp_free_block(b: B) -> Int ! alloc
    tp_free_shallow(b)

fn emit_ir_cached(b: B) -> Int ! alloc
    tp_free_shallow(b)

fn emit_ir_single_file(b: B) -> Int ! alloc
    emit_ir_cached(b)
    tp_free_block(b)

fn mk() -> B ! alloc
    xs = List.new[Int]()
    xs.push(7)
    B(xs, 1)

fn main() -> Int ! alloc
    t = mk()
    emit_ir_single_file(t)
