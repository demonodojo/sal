import "std/crypto/sha3.sal"
import "support/assert.sal"
import "support/hex.sal"

fn s_to_bytes(s: &String) -> Bytes ! alloc
    b = Bytes.new(s.len())
    i = 0
    while i < s.len()
        b.set_u8(i, s.char(i))
        i = i + 1
    b

fn main() -> Int ! io, alloc
    empty = Bytes.new(0)
    a = s_to_bytes(&d"abc")
    rc = 0
    rc = rc + assert_str_eq(&bytes_to_hex(&sha3_256(&empty)), &d"a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", 1)
    rc = rc + assert_str_eq(&bytes_to_hex(&sha3_512(&empty)), &d"a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26", 2)
    rc = rc + assert_str_eq(&bytes_to_hex(&sha3_256(&a)), &d"3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", 3)
    rc = rc + assert_str_eq(&bytes_to_hex(&shake128(&a, 32)), &d"5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8", 4)
    rc = rc + assert_str_eq(&bytes_to_hex(&shake256(&a, 32)), &d"483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739", 5)
    rc
