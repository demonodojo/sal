fn hex_digit(v: Int) -> String ! alloc
    if v < 10
        String.from_char(48 + v)
    else
        String.from_char(87 + v)

fn hex_val(c: Int) -> Int
    if c >= 97
        c - 87
    elsif c >= 65
        c - 55
    else
        c - 48

fn hex_to_bytes(s: &String) -> Bytes ! alloc
    b = Bytes.new(s.len() / 2)
    i = 0
    while i < b.len()
        b.set_u8(i, hex_val(s.char(i * 2)) * 16 + hex_val(s.char(i * 2 + 1)))
        i = i + 1
    b

fn bytes_to_hex(b: &Bytes) -> String ! alloc
    s = d""
    i = 0
    while i < b.len()
        v = b.get_u8(i)
        s = s + hex_digit(v / 16) + hex_digit(v % 16)
        i = i + 1
    s
