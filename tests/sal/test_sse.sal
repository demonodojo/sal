import "std/http/sse.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    chunk = d"event: ping\ndata: hello\n\n"
    ev = Sse.new(chunk)
    a = assert_ne(ev.has_data(), 0, 1)
    if a != 0
        a
    else
        b = assert_str_eq(ev.payload(), d"hello", 2)
        if b != 0
            b
        else
            c = assert_zero(ev.is_done(), 3)
            if c != 0
                c
            else
                0
