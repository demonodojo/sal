import "std/http/client.sal"
import "std/json/build.sal"
import "std/io/env.sal"
import "support/assert.sal"

fn parse_dec(s: String, i: Int, n: Int, acc: Int) -> Int ! alloc
    if i >= n
        acc
    else
        parse_dec(s, i + 1, n, acc * 10 + str_char(s, i) - 48)

fn mock_port() -> Int ! io, alloc
    raw = getenv(d"OC_MOCK_PORT")
    if str_len(raw) <= 0
        7422
    else
        parse_dec(raw, 0, str_len(raw), 0)

fn main() -> Int ! io, alloc
    port = mock_port()
    body = chat_completion_body(d"mock", d"", d"ping")
    resp = http_post(port, d"/v1/chat/completions", body)
    a = assert_ne(str_len(resp), 0, 1)
    if a != 0
        a
    else
        assert_contains(resp, d"choices", 2)
