import "std/crypto/hkdf.sal"
import "std/crypto/sha256.sal"
import "support/assert.sal"
import "support/hex.sal"

# SHA-256 and HMAC-SHA256 against the known answers of FIPS 180-4 and RFC 4231,
# and HKDF-SHA256 against the three SHA-256 cases of RFC 5869. Salt-empty means
# the zero salt of the RFC, which HMAC already gives with an empty key.

fn bytes_of(s: &String) -> Bytes ! alloc
    out = Bytes.new(s.len())
    i = 0
    while i < s.len()
        out.set_u8(i, s.char(i))
        i = i + 1
    out

fn repeat(b: Int, n: Int) -> Bytes ! alloc
    out = Bytes.new(n)
    out.fill(0, n, b)
    out

fn range_bytes(lo: Int, hi: Int) -> Bytes ! alloc
    out = Bytes.new(hi - lo)
    i = 0
    while i < out.len()
        out.set_u8(i, lo + i)
        i = i + 1
    out

fn sha_case(data: &Bytes, want: &String, code: Int) -> Int ! io, alloc
    assert_str_eq(&bytes_to_hex(&sha256(data)), want, code)

fn hmac_case(key: &Bytes, data: &Bytes, want: &String, code: Int) -> Int ! io, alloc
    assert_str_eq(&bytes_to_hex(&hmac_sha256(key, data)), want, code)

fn sha_vectors() -> Int ! io, alloc
    rc = 0
    rc = rc + sha_case(&Bytes.new(0), &d"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", 101)
    rc = rc + sha_case(&bytes_of(&d"abc"), &d"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", 102)
    rc = rc + sha_case(&bytes_of(&d"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), &d"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", 103)
    rc = rc + sha_case(&repeat(97, 1000), &d"41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3", 104)
    pattern = Bytes.new(200)
    i = 0
    while i < 200
        pattern.set_u8(i, (i * 7) & 255)
        i = i + 1
    rc = rc + sha_case(&pattern, &d"b531abd8dae7232c861ac9f50aff9952d29c8d4c3772551cc5bce5d39d2cd08d", 105)
    rc

fn hmac_vectors() -> Int ! io, alloc
    rc = 0
    rc = rc + hmac_case(&repeat(11, 20), &bytes_of(&d"Hi There"), &d"b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", 201)
    rc = rc + hmac_case(&bytes_of(&d"Jefe"), &bytes_of(&d"what do ya want for nothing?"), &d"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", 202)
    rc = rc + hmac_case(&repeat(170, 20), &repeat(221, 50), &d"773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe", 203)
    rc = rc + hmac_case(&repeat(170, 131), &bytes_of(&d"Test Using Larger Than Block-Size Key - Hash Key First"), &d"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", 204)
    rc = rc + hmac_case(&repeat(170, 131), &bytes_of(&d"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."), &d"9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2", 205)
    rc

fn rfc_case1() -> Int ! io, alloc
    ikm = repeat(11, 22)
    salt = range_bytes(0, 13)
    info = range_bytes(240, 250)
    prk = hkdf_extract(&salt, &ikm)
    rc = assert_str_eq(&bytes_to_hex(&prk), &d"077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5", 301)
    okm = hkdf_expand(&prk, &info, 42)
    rc = rc + assert_str_eq(&bytes_to_hex(&okm), &d"3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865", 302)
    rc = rc + assert_str_eq(&bytes_to_hex(&hkdf_sha256(&salt, &ikm, &info, 42)), &bytes_to_hex(&okm), 303)
    rc

fn rfc_case2() -> Int ! io, alloc
    ikm = range_bytes(0, 80)
    salt = range_bytes(96, 176)
    info = range_bytes(176, 256)
    prk = hkdf_extract(&salt, &ikm)
    rc = assert_str_eq(&bytes_to_hex(&prk), &d"06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244", 401)
    okm = hkdf_expand(&prk, &info, 82)
    rc = rc + assert_str_eq(&bytes_to_hex(&okm), &d"b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87", 402)
    rc = rc + assert_str_eq(&bytes_to_hex(&hkdf_sha256(&salt, &ikm, &info, 82)), &bytes_to_hex(&okm), 403)
    rc

fn rfc_case3_empty_salt() -> Int ! io, alloc
    ikm = repeat(11, 22)
    salt = Bytes.new(0)
    info = Bytes.new(0)
    prk = hkdf_extract(&salt, &ikm)
    rc = assert_str_eq(&bytes_to_hex(&prk), &d"19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04", 501)
    okm = hkdf_expand(&prk, &info, 42)
    rc = rc + assert_str_eq(&bytes_to_hex(&okm), &d"8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8", 502)
    # The zero salt of the RFC is what HMAC gives with an empty key.
    rc = rc + assert_str_eq(&bytes_to_hex(&hkdf_extract(&Bytes.new(0), &ikm)), &bytes_to_hex(&prk), 503)
    rc

fn bad_lengths() -> Int ! io, alloc
    prk = repeat(0, 32)
    info = Bytes.new(0)
    rc = assert_zero(hkdf_expand(&prk, &info, 0).len(), 601)
    rc = rc + assert_zero(hkdf_expand(&prk, &info, 8161).len(), 602)
    rc = rc + assert_zero(hkdf_expand(&prk, &info, -1).len(), 603)
    rc = rc + assert_zero(hkdf_expand(&repeat(0, 31), &info, 32).len(), 604)
    rc = rc + assert_zero(hkdf_expand(&prk, &info, 8160).len() - 8160, 605)
    rc

fn main() -> Int ! io, alloc
    sha_vectors() + hmac_vectors() + rfc_case1() + rfc_case2() + rfc_case3_empty_salt() + bad_lengths()
