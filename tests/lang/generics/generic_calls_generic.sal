# exit: 7
# asan-xfail: String por valor a una función genérica (tipo borrado): ni el llamador ni la callee lo liberan; LSan lo ve desde que sal_strdup no deja el puntero en la pila
fn id[T](x: T) -> T
    x

fn twice[T](x: T) -> T
    id(id(x))

fn main() -> Int ! alloc
    s = twice(d"hello")
    s.len() + twice(2)
