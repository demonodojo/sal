# exit: 15
import "mods/generic_lib.sal"

# `wrap` and `bump` get their copies here; `twice(1)` calls the `twice__Int` that
# `generic_lib` already made for `local_use`.
fn main() -> Int ! alloc
    a = wrap(d"hey")
    b = wrap(5)
    a.get(0).len() + b.get(0) + twice(1) + bump(d"s", 2) + local_use()
