# asan-xfail: List[String] llenada con String recibidos por parámetro y devuelta no suelta sus elementos (fuga igual sin genéricos)
fn pair[T](a: T, b: T) -> List[T] ! alloc
    xs = List.new[T]()
    xs.push(a)
    xs.push(b)
    xs

fn main() -> Int ! alloc
    ys = pair(d"ab", d"cde")
    ns = pair(1, 10)
    ys.get(0).len() + ys.get(1).len() + ns.get(1)
