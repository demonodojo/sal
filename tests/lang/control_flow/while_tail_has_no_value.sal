# exit: 0
# A `while` at the end of a `Unit` fn, or of a branch whose `if` is bound, ends the block without
# a value.
fn spin(n: Int) -> Unit
    let i = 0
    while i < n
        i = i + 1

fn pick(n: Int) -> Int
    let i = 0
    let j = if n > 1
        while i < n
            i = i + 1
    else
        i = 2
    i

fn main() -> Int
    spin(3)
    pick(2) - 2
