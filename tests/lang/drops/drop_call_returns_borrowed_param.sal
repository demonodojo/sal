# exit: 3
# A call that returns one of its borrowed parameters hands back the caller's own value, so the
# caller must not release it. `lower_if` reads the field after the call; freeing the result
# would free the argument too.
struct B
    xs: List[Int]
    n: Int

fn elsifs_else_block(else_b: &B, n: Int) -> &B ! alloc
    if n == 0
        else_b
    else
        else_b

fn lower_if(else_b0: &B, n: Int) -> Int ! alloc
    r = elsifs_else_block(else_b0, n)
    r.n

fn main() -> Int ! alloc
    xs = List.new[Int]()
    xs.push(7)
    b = B(xs, 3)
    lower_if(&b, 0)
