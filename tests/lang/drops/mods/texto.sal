# Text helpers of another module for `drop_string_fn_imported.sal`.
fn lower(s: &String) -> String ! alloc
    out = d""
    i = 0
    while i < s.len()
        c = s.char(i)
        if c >= 65 && c <= 90
            c = c + 32
        out = out + String.from_char(c)
        i = i + 1
    out

# The digits `0..n` (n <= 10): each `+` concatenates the result of another fn of this module.
fn digits(n: Int) -> String ! alloc
    s = d""
    i = 0
    while i < n
        s = s + digit(i)
        i = i + 1
    s

fn digit(v: Int) -> String ! alloc
    String.from_char(48 + v)
