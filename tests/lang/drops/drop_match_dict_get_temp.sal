# exit: 5
# `match d.get(k)` without a local: the fresh `Option` (and the copy of the value inside) is
# released after the match, also when an arm binds the payload.
import "../../../std/prelude.sal"

fn look(d: &Dict[String, String], k: String) -> Int ! alloc
    match d.get(k)
        Some(s) => s.len()
        None => 0

fn main() -> Int ! alloc
    let d = Dict.new[String, String]()
    d.put(d"k".dup(), d"vvv".dup())
    d.put(d"j".dup(), d"ww".dup())
    look(&d, d"k".dup()) + look(&d, d"j".dup()) + look(&d, d"x".dup())
