# exit: 14
struct B
    xs: List[Int]
    raw: Bytes
    d: Dict[String, Int]
    n: Int

struct O
    b: B
    tag: String

fn items() -> List[Int] ! alloc
    xs = List.new[Int]()
    xs.push(5)
    b = B(xs, Bytes.new(4), Dict.new[String, Int](), 1)
    b.xs

fn round(i: Int) -> Int ! alloc
    xs = List.new[Int]()
    xs.push(i)
    d = Dict.new[String, Int]()
    d.put("k", i)
    o = O(B(xs, Bytes.new(8), d, 3), "t" + "u")
    o.b.n + o.b.raw.len() - 8

fn main() -> Int ! alloc
    total = 0
    i = 0
    while i < 3
        total = total + round(i)
        i = i + 1
    kept = items()
    total + kept.get(0)
