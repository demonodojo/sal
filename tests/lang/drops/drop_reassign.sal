# exit: 4
# Reasignar un local con dueño calcula el valor nuevo (que puede leer el viejo), libera el
# viejo y enlaza el nuevo (SPEC «Memoria»).
fn main() -> Int ! alloc
    s = int_to_str(7)
    s = int_to_str(s.len() + 99)
    xs = List.new[Int]()
    xs.push(1)
    xs = List.new[Int]()
    s.len() + xs.len() + 1
