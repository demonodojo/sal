# exit: 6
# `xs.push(v)` as the last line of a branch of an `if` statement only borrows `xs`: the list
# stays live on every path and is released once at the end of `main`. Pushes 1, 2, 0, 0;
# the `if` past 100 does not run. len 4 + xs.get(1) 2.
fn main() -> Int ! alloc
    xs = List.new[Int]()
    i = 0
    while i < 4
        if i == 0
            xs.push(1)
        elsif xs.len() == 1
            xs.push(2)
        else
            xs.push(0)
        i = i + 1
    if xs.len() > 100
        xs.push(9)
    xs.len() + xs.get(1)
