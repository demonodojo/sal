# exit: 8
# A `String` moved on only some paths is released behind its `__live` flag on the others (SPEC
# «Memoria»), also when an operator tail of a branch moves it (`keep(s) + 1`).
fn keep(s: String) -> Int ! alloc
    s.len()

fn call_tail(k: Int) -> Int ! alloc
    s = "ab".dup()
    if k > 1
        keep(s)
    else
        0

fn sum_tail(k: Int) -> Int ! alloc
    s = "ab".dup()
    if k > 1
        keep(s) + 1
    else
        0

fn stmt_move(k: Int) -> Int ! alloc
    s = "ab".dup()
    if k > 1
        n = keep(s)
        n + 1
    else
        0

fn main() -> Int ! alloc
    call_tail(2) + call_tail(0) + sum_tail(2) + sum_tail(0) + stmt_move(2) + stmt_move(0)
