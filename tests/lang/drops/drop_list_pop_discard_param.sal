# exit: 1
# `xs.pop()` as a statement drops the element it removes, also through a `&mut List`
# parameter: the `S` string goes with it.
enum E
    S(String)
    N(Int)

fn trim(xs: &mut List[E]) -> Int ! alloc
    xs.pop()
    xs.len()

fn main() -> Int ! alloc
    xs = List.new[E]()
    xs.push(S("a" + "b"))
    xs.push(S("c" + "d"))
    trim(&mut xs)
