# exit: 3
# The tail of each branch of an `if` statement is discarded like a statement of its own: the
# `Result` and the `String` it leaves are released there.
fn check(x: Int) -> Result[Unit, String] ! alloc
    if x > 1
        Ok(())
    else
        e = d"small"
        Err(e)

fn label(x: Int) -> String ! alloc
    x.to_str()

fn main() -> Int ! alloc
    i = 0
    while i < 3
        if i > 0
            check(i)
        if i > 1
            label(i)
        elsif i > 0
            if i == 1
                label(1)
        else
            label(0)
        i = i + 1
    i
