# selfhost-xfail: softmax over an axis needs the row length, which the selfhost tensor C path does not track (it has no dims)
# exit: 2
# each softmax row sums to 1 -> total 2
fn main() -> Int ! alloc
    a = tensor[[1.0, 2.0], [3.0, 4.0]]
    i = tensor[[1.0, 0.0], [0.0, 1.0]]
    e = tensor[[1.0, 0.0], [0.0, 0.0]]
    b = softmax(a, 1)
    on cpu
        matmul(b, i)
    0
