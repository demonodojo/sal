# exit: 18
# asan-xfail: el Option que devuelve Dict.get (sal_enum_new) no se libera tras el match
enum Option[T]
    None
    Some(T)

struct P
    x: Int
    y: Int

fn main() -> Int ! alloc
    names = dict_new[String, String]()
    _a = dict_put(&mut names, &"k", "abc")
    _b = dict_put(&mut names, &"k", "defg")
    ps = dict_new[String, P]()
    _c = dict_put(&mut ps, &"p", P(3, 4))
    n = match dict_get(&names, &"k")
        Some(s) => str_len(s)
        None => 0
    m = match dict_get(&names, &"zz")
        Some(s) => 100
        None => 1
    p = match dict_get(&ps, &"p")
        Some(q) => q.x * q.y
        None => 0
    has = if dict_has(ps, "p")
        1
    else
        0
    n + m + p + has
