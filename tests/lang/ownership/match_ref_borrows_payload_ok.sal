# exit: 4
# asan-xfail: temporal String (d"…", .dup()) pasado a un builtin o local de main: sal_strdup sin sal_free
enum Opt
    No
    Yes(String)

fn main() -> Int ! alloc
    o = Yes(d"77".dup())
    a = match &o
        Yes(s) => s.len()
        No => 0
    b = match &o
        Yes(s) => s.len()
        No => 0
    a + b
