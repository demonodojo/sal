# exit: 5
# xfail: una `&mut` a un valor sin bloque guardada en un local no pasa por una celda: `*r = 5` no llega a `a`
# selfhost-xfail: igual que el arranque, `*r = 5` con `r` un local no escribe en `a`
# As in Rust, writing through a `&mut` held in a local reaches its referent.
fn main() -> Int
    a = 1
    r = &mut a
    *r = 5
    a
