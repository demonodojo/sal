# asan-xfail: temporal String (d"…", .dup()) pasado a un builtin o local de main: sal_strdup sin sal_free
# A written `borrow` wins over inference: `skip` never reads `s` (inferred it would take it),
# so the caller may keep using `s`; `take` after the type is a mode, not part of the type.
fn skip(s: &String, k: Int) -> Int ! alloc
    k

fn eat(s: &String) -> Int ! alloc
    str_len(s)

fn main() -> Int ! alloc
    s = strdup(d"abc")
    a = skip(&s, 2)
    b = str_len(s)
    a + b
