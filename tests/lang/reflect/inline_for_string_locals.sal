# exit: 8
# Each copy of the body is a block of its own: `s` is a new local per field and is released at the
# end of its copy.
struct Nombre
    pila: String
    apellido: String

fn total(n: &Nombre) -> Int ! alloc
    t = 0
    inline for f in Nombre.fields
        s = n.[f].clone() + ""
        t = t + s.len()
    t

fn main() -> Int ! alloc
    n = Nombre(d"Ana", d"Perez")
    total(&n)
