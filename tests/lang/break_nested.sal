# exit: 12
# selfhost-xfail: break is Rust bootstrap only for now
fn main() -> Int
    # `break` leaves only the inner loop: 4 outer rounds, 3 inner steps each.
    n = 0
    i = 0
    while i < 4
        j = 0
        while true
            if j == 3
                break
            n = n + 1
            j = j + 1
        i = i + 1
    n
