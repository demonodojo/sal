# error: E_TYPE
# Como `dyn` en Rust: llamar por `any` un método que toma `self` por valor sacaría el valor de la caja.
protocol Show
    method show(self) -> String ! alloc

struct Point impl Show
    x: Int

method Point.show(self) -> String ! alloc
    self.x.to_str()

fn log(x: &any[Show]) -> String ! alloc
    x.show()

fn main() -> Int ! alloc
    p = Point(42)
    log(&p).len()
