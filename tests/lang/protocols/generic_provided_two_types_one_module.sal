# exit: 20
# Dos tipos del mismo módulo reclaman un protocolo genérico con métodos provistos, cada uno con
# su propio argumento: `twice` 6 + 6, `again().n` 4 + 4.
protocol Model[T]
    method id(&self) -> Int
    method build(&self, n: Int) -> T
    method twice(&self) -> Int
        self.id() * 2
    method again(&self) -> T
        self.build(self.id() + 1)

struct A impl Model[A]
    n: Int

struct B impl Model[B]
    n: Int
    m: Int

method A.id(&self) -> Int
    self.n

method A.build(&self, n: Int) -> A
    A(n)

method B.id(&self) -> Int
    self.n + self.m

method B.build(&self, n: Int) -> B
    B(n, 0)

fn main() -> Int
    a = A(3)
    b = B(1, 2)
    a.twice() + b.twice() + a.again().n + b.again().n
