# exit: 66
# Each trailing-lambda form takes an indented block as its body (SPEC `postfix`):
# apply(5): 5 * 2 + 1 = 11; pair: 3 * 4 - 2 = 10; twice: (1 + 3) * 2 = 8, (8 + 3) * 2 = 22;
# fold2(10): 10 * 1 + 1 = 11, 11 * 2 + 1 = 23. 11 + 10 + 22 + 23 = 66.
fn apply(n: Int, f: fn(Int) -> Int) -> Int
    f(n)

fn pair(f: fn(Int, Int) -> Int) -> Int
    f(3, 4)

fn twice(f: fn(Int) -> Int) -> Int
    f(f(1))

fn fold2(init: Int, f: fn(Int, Int) -> Int) -> Int
    f(f(init, 1), 2)

fn main() -> Int
    a = apply(5) x =>
        y = x * 2
        y + 1
    b = pair (p, q) =>
        s = p * q
        s - 2
    c = twice x =>
        z = x + 3
        z * 2
    d = fold2(10) (acc, x) =>
        t = acc * x
        t + 1
    a + b + c + d
