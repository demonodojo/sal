# exit: 0
# 10 000 rounds of alloc/free of owned strings: no growth, no double free.
fn round(i: Int) -> Int ! alloc
    s = int_to_str(i)
    t = s + "x"
    str_len(t)

fn main() -> Int ! alloc
    total = 0
    i = 0
    while i < 10000
        total = total + round(i)
        i = i + 1
    if total > 0
        0
    else
        1
