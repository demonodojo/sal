{
  "scopeName": "source.sal",
  "name": "sal",
  "patterns": [
    { "include": "#comment" },
    { "include": "#fstring" },
    { "include": "#dstring" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#function-def" },
    { "include": "#attribute" },
    { "include": "#type-builtin" },
    { "include": "#type-name" },
    { "include": "#tensor" },
    { "include": "#method" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#effect" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.sal",
      "match": "#.*$"
    },
    "string-escape": {
      "name": "constant.character.escape.sal",
      "match": "\\\\."
    },
    "fstring-content": {
      "patterns": [
        { "include": "#string-escape" },
        {
          "name": "constant.character.escape.sal",
          "match": "##\\{"
        },
        {
          "name": "meta.interpolation.sal",
          "match": "#\\{[A-Za-z_][A-Za-z0-9_]*\\}"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.sal",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#string-escape" }]
    },
    "dstring": {
      "name": "string.quoted.double.sal",
      "begin": "\\bd\"",
      "end": "\"",
      "patterns": [{ "include": "#string-escape" }]
    },
    "fstring": {
      "name": "string.quoted.double.interpolated.sal",
      "begin": "\\bf\"",
      "end": "\"",
      "patterns": [{ "include": "#fstring-content" }]
    },
    "number": {
      "name": "constant.numeric.sal",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "function-def": {
      "match": "^(fn)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.sal" },
        "2": { "name": "entity.name.function.sal" }
      }
    },
    "attribute": {
      "name": "storage.modifier.attribute.sal",
      "match": "@(?:frozen|stack|no_heap|layout|deprecated)\\b"
    },
    "tensor": {
      "name": "keyword.control.sal",
      "match": "\\btensor(?=\\s*\\[)"
    },
    "method": {
      "name": "keyword.control.sal",
      "match": "^\\s*\\b(?:(?:method|static)(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*\\.)|init(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*\\())"
    },
    "keyword": {
      "name": "keyword.control.sal",
      "match": "\\b(?:fn|let|if|elsif|else|match|on|to|kernel|return|import|try|while|break|struct|enum|frame|in|parallel)\\b"
    },
    "constant": {
      "name": "constant.language.sal",
      "match": "\\b(?:true|false|cpu|gpu|tpu)\\b"
    },
    "type-builtin": {
      "name": "storage.type.sal",
      "match": "\\b(?:Tensor|List|Dict|Int|Float|Bool|String|Bytes|Unit|BF16|F16|F32|I8)\\b"
    },
    "type-name": {
      "name": "entity.name.type.sal",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "effect": {
      "name": "keyword.other.effect.sal",
      "match": "\\b(?:alloc|io)\\b"
    }
  }
}
