{
  "name": "sal",
  "displayName": "sal",
  "description": "Editar programas sal: resaltado (method/static/init, @deprecated, break), diagnósticos E_* y W_DEPRECATED, avisos Style/*, formato e ir a definiciones.",
  "version": "0.2.4",
  "private": true,
  "publisher": "sal",
  "icon": "icons/sal.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sal",
    "workspaceContains:**/*.sal"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test out/test/sal.test.js",
    "watch": "tsc -p . --watch"
  },
  "contributes": {
    "languages": [
      {
        "id": "sal",
        "aliases": [
          "sal",
          "SAL"
        ],
        "extensions": [
          ".sal"
        ],
        "semanticHighlighting": true,
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sal.svg",
          "dark": "./icons/sal.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sal",
        "scopeName": "source.sal",
        "path": "./syntaxes/sal.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "sal",
      "properties": {
        "sal.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Ruta del binario sal. Vacio: target/debug/sal del workspace; luego PATH."
        },
        "sal.standardPath": {
          "type": "string",
          "default": "",
          "description": "Ruta del binario standard. Vacio: target/debug/standard del workspace; luego PATH."
        },
        "sal.syntaxDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Colorea tipos (verde), palabras clave (violeta) y efectos con decoraciones del editor (independiente del tema)."
        }
      }
    },
    "commands": [
      {
        "command": "sal.check",
        "title": "SAL: Check"
      },
      {
        "command": "sal.format",
        "title": "SAL: Format"
      },
      {
        "command": "sal.standardFix",
        "title": "SAL: Standard Fix"
      }
    ],
    "configurationDefaults": {
      "[sal]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "[sal]": {
          "enabled": true,
          "rules": {
            "type": {
              "foreground": "#89D185",
              "fontStyle": "bold"
            },
            "keyword": {
              "foreground": "#C586C0"
            },
            "effect": {
              "foreground": "#DCDCAA",
              "fontStyle": "italic"
            }
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "[sal]": {
          "textMateRules": [
            {
              "scope": "string.quoted.double.sal",
              "settings": {
                "foreground": "#CE9178"
              }
            }
          ]
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sal.check",
          "when": "editorLangId == sal"
        },
        {
          "command": "sal.format",
          "when": "editorLangId == sal"
        },
        {
          "command": "sal.standardFix",
          "when": "editorLangId == sal"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.0"
  }
}
